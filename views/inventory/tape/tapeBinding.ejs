<% layout('/layout/boilerplate') %>
    <style>
      .tape-id-success {
      border: 2px solid #28a745 !important;
      background-color: #f3fff6;
      color: #155724;
      font-weight: 600;
    }

    .tape-id-error {
      border: 2px solid #dc3545 !important;
      background-color: #fff5f5;
      color: #721c24;
      font-weight: 600;
    }
    </style>

      <!-- The main content -->
      <div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px;">
        <form action="/sachiko/form/tape-binding" method="post" onsubmit="return validateTapeBeforeSubmit()" class="needs-validation" autocomplete="off" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="span-full form-heading">
            <h1>Client Tape</h1>
          </div>

          <div class="span-full form-subheading">
            <h1>User Info</h1>
          </div>

          <div id="tape-id-div" class="span-seven">
            <label for="tape-id">Tape ID</label>
            <input type="text" id="tape-id" class="form-control" name="tapeProductId" placeholder="Will appear here" readonly required />
          </div>                  

          <div id="client-name-div" class="span-six">
            <div class="clientName-label"><label for="client-name">Client Name</label><span class="asterisk" style="font-size: 14px;"></span></div>
            <select name="clientName" id="client-name" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% for (let client of clients) { %>
              <option value="<%= client %>"><%= client %></option>
              <% } %>
            </select>
          </div>  

          <div id="user-name-div" class="span-six">
            <label>User Name</label>
            <select id="client-user-name" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
            </select>
          </div>
          <div id="user-name-contact-div" class="span-six">
            <label for="user-contact">User Contact</label>
            <input type="text" id="user-contact" class="form-control" name="userContact" placeholder="Enter User Contact" required />
          </div>
          <div id="client-location-div" class="span-seven">
            <label for="client-location">Location</label>
            <select name="location" id="client-location" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Select location</option>
            </select>
          </div>

          <div class="span-full form-subheading" style="display: flex; justify-content: space-between; align-items: center;">
            <h1>Tape Specifications</h1>
            <button type="button" id="reset-specs-btn" style="padding: 4px 12px; border-radius: 4px; background-color: #dc3545; color: white; border: none; cursor: pointer; font-size: 14px;">
              Reset
            </button>
          </div>

          <div class="span-five">
            <label>Paper Code</label>
            <select name="tapePaperCode" id="tape-paper-code" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% paperCodes?.forEach(pc => { %>
                <option value="<%= pc %>"><%= pc %></option>
              <% }) %>
            </select>
          </div>

          <div class="span-five">
            <label>Paper Type</label>
            <select name="tapePaperType" id="tape-paper-type" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% paperTypes?.forEach(pt => { %>
                <option value="<%= pt %>"><%= pt %></option>
              <% }) %>
            </select>
          </div>

          <div class="span-four">
            <label>GSM</label>
            <select name="tapeGsm" id="tape-gsm" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% gsms?.forEach(g => { %>
                <option value="<%= g %>"><%= g %></option>
              <% }) %>
            </select>
          </div>

          <div class="span-four">
            <label>Width</label>
            <select name="tapeWidth" id="tape-width" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% widths?.forEach(w => { %>
                <option value="<%= w %>"><%= w %></option>
              <% }) %>
            </select>
          </div>

          <div class="span-five">
            <label>MTRS</label>
            <select name="tapeMtrs" id="tape-mtrs" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% mtrsList?.forEach(m => { %>
                <option value="<%= m %>"><%= m %></option>
              <% }) %>
            </select>
          </div>

          <div class="span-five">
            <label for="tape-core-id">Core ID</label>
            <select name="tapeCoreId" id="tape-core-id" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% coreIds?.forEach(c => { %>
                <option value="<%= c %>"><%= c %></option>
              <% }) %>
            </select>
          </div>

          <div class="span-four">
            <label for="tape-finish">Finish</label>
            <select name="tapeFinish" id="tape-finish" class="form-control select-tag" required>
              <option value="" disabled selected hidden>Search</option>
              <% finishes?.forEach(f => { %>
                <option value="<%= f %>"><%= f %></option>
              <% }) %>
            </select>
          </div>

          <div class="span-full form-subheading">
            <h1>Client Overrides</h1>
          </div>
          
          <div class="span-five">
            <label for="tape-client-paper-code">Client Paper Code</label>
            <input type="text" id="tape-client-paper-code" class="form-control" name="tapeClientPaperCode" placeholder="Enter Client Paper Code" required />
          </div>
          <div class="span-five">
            <label for="tape-client-gsm">Client GSM</label>
            <input type="text" id="tape-client-gsm" class="form-control" name="clientTapeGsm" placeholder="Enter Client GSM" required />
          </div>
          <div class="span-five">
            <label for="item-client-item-type">Client Item Type</label>
            <input type="text" id="item-client-item-type" class="form-control" name="itemClientItemType" placeholder="Enter Client Item Type" required />
          </div>
          <div class="span-five">
            <label for="tape-mtrs-del">MTRS Delivered</label>
            <input type="text" id="tape-mtrs-del" class="form-control" name="tapeMtrsDel" placeholder="Enter MTRS Delivered" required />
          </div>          
          <div class="span-six">
            <label for="tape-rate-per-roll">Rate Per Roll</label>
            <input type="text" id="tape-rate-per-roll" class="form-control" name="tapeRatePerRoll" placeholder="Enter rate per roll" required />
          </div>            
          <div class="span-six">
            <label for="tape-sale-cost">Sales sq mtrs Cost</label>
            <input type="text" id="tape-sale-cost" class="form-control" name="tapeSaleCost" placeholder="Enter Sales Cost" tabindex="-1" required readonly />
          </div>           

          <div class="span-full form-subheading">
            <h1>Pricing & Order Terms</h1>
          </div>

          <div class="span-seven">
            <label for="tape-min-qty">Minimum Order QTY</label>
            <input type="text" id="tape-min-qty" class="form-control" name="tapeMinQty" placeholder="Enter minimum qty" required />
          </div>
          <div class="span-six">
            <label for="tape-odr-qty">Order QTY</label>
            <input type="text" id="tape-odr-qty" class="form-control" name="tapeOdrQty" placeholder="Enter order qty" required />
          </div>
          <div class="span-seven">
            <label for="tape-odr-freq">Repeat Order Freq</label>
            <input type="text" id="tape-odr-freq" class="form-control" name="tapeOdrFreq" placeholder="Enter repeat order frequency" required />
          </div>
          <div class="span-six">
            <label for="tape-credit-term">CR</label>
            <input type="text" id="tape-credit-term" class="form-control" name="tapeCreditTerm" placeholder="Enter credit term" required />
          </div>
          <div class="span-six">
            <label for="tape-billing-type">Billing Type</label>
            <select id="tape-billing-type" class="form-control select-tag" name="billingType" required>
              <option value="" disabled selected hidden>Select</option>
              <option value="ROLLS">Rolls</option>
              <option value="RUNNING MTRS">Running Mtrs</option>
            </select>
          </div>

          <input type="hidden" name="tapeId" id="resolved-tape-id">
          <input type="hidden" name="userId" id="user-id">

          <div class="btn-grp span-full">
            <button type="submit">Save tape</button>
          </div>          
        </form>
      </div>

<!-- ===== RATE CALCULATION ===== -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  /* ================= ELEMENTS ================= */
  const submitBtn = document.querySelector("button[type='submit']");

  const clientSelect = document.getElementById("client-name");
  const userSelect = document.getElementById("client-user-name");

  const userIdInput = document.getElementById("user-id");
  const userContactInput = document.getElementById("user-contact");
  const locationSelect = document.getElementById("client-location");
  const tapeMtrsInput = document.getElementById("tape-mtrs");
  const tapeMtrsDelInput = document.getElementById("tape-mtrs-del");

  const tapeIdInput = document.getElementById("resolved-tape-id");
  const tapeIdDisplay = document.getElementById("tape-id");

  const tapeFields = [
    "tape-paper-code",
    "tape-paper-type",
    "tape-gsm",
    "tape-width",
    "tape-mtrs",
    "tape-core-id",
    "tape-finish",
  ];

  // Map from element ID to the API response key
  const fieldToApiKey = {
    "tape-paper-code": "paperCodes",
    "tape-paper-type": "paperTypes",
    "tape-gsm": "gsms",
    "tape-width": "widths",
    "tape-mtrs": "mtrsList",
    "tape-core-id": "coreIds",
    "tape-finish": "finishes",
  };

  // Map from element ID to the query param name
  const fieldToParam = {
    "tape-paper-code": "tapePaperCode",
    "tape-paper-type": "tapePaperType",
    "tape-gsm": "tapeGsm",
    "tape-width": "tapeWidth",
    "tape-mtrs": "tapeMtrs",
    "tape-core-id": "tapeCoreId",
    "tape-finish": "tapeFinish",
  };

  submitBtn.disabled = true;

  /* ================= CHOICES INIT ================= */
  const clientChoices = new Choices(clientSelect, {
    searchEnabled: true,
    shouldSort: false,
    itemSelectText: "",
  });

  const userChoices = new Choices(userSelect, {
    searchEnabled: true,
    shouldSort: false,
    itemSelectText: "",
  });

  const locationChoices = new Choices(locationSelect, {
    searchEnabled: true,
    shouldSort: false,
    itemSelectText: "",
  });

  // Full user docs for the selected client (kept for locationDetails lookup)
  let currentUsers = [];

  // Store Choices instances for spec fields
  const specChoices = {};
  tapeFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      specChoices[id] = new Choices(el, {
        searchEnabled: true,
        shouldSort: false,
        itemSelectText: "",
      });
    }
  });

  /* ================= HELPERS ================= */
  function normalizeLocationName(value) {
    return String(value || "")
      .trim()
      .toUpperCase()
      .replace(/\s+/g, " ")
      .replace(/^[.,]+|[.,]+$/g, "");
  }

  function getUserLocationEntries(user) {
    const details = Array.isArray(user?.locationDetails) ? user.locationDetails : [];
    const entries = details
      .map((entry) => {
        const userLocation = normalizeLocationName(entry?.userLocation || entry?.location || "");
        if (!userLocation) return null;
        return { value: userLocation, label: userLocation };
      })
      .filter(Boolean);

    if (entries.length > 0) {
      // De-duplicate locations while preserving order
      const seen = new Set();
      return entries.filter((e) => (seen.has(e.value) ? false : seen.add(e.value)));
    }

    const fallbackLocation = normalizeLocationName(user?.userLocation || "");
    if (!fallbackLocation) return [];
    return [{ value: fallbackLocation, label: fallbackLocation }];
  }

  function clearLocationChoices() {
    locationChoices.clearStore();
    locationChoices.setChoices(
      [{ value: "", label: "Select location", disabled: true, selected: true }],
      "value",
      "label",
      true
    );
  }

  function populateLocationChoices(user) {
    const entries = getUserLocationEntries(user);
    if (entries.length === 0) {
      clearLocationChoices();
      return;
    }
    const autoSelect = entries.length === 1;
    locationChoices.clearStore();
    locationChoices.setChoices(
      [
        { value: "", label: "Select location", disabled: true, selected: !autoSelect, placeholder: true },
        ...entries.map((e, i) => ({ value: e.value, label: e.label, selected: autoSelect && i === 0 })),
      ],
      "value",
      "label",
      true
    );
  }

  function resetUserFields() {
    userIdInput.value = "";
    userContactInput.value = "";
    clearLocationChoices();
  }

  function hardResetUserSelection() {
    userChoices.removeActiveItems();
    userChoices.clearChoices();
    resetUserFields();
  }

  function resetResolvedTape() {
    tapeIdInput.value = "";
    tapeIdDisplay.value = "";
    submitBtn.disabled = true;
    tapeIdDisplay.classList.remove("tape-id-success", "tape-id-error");
  }

  function syncDeliveredMeters() {
    if (!tapeMtrsInput || !tapeMtrsDelInput) return;
    const currentMtrs = tapeMtrsInput.value;
    tapeMtrsDelInput.value = currentMtrs || "";
  }

  /* ================= SMART FILTER ================= */
  let filterTimeout = null;

  async function filterSpecs(changedFieldId) {
    // Build query params from all currently selected values
    const params = new URLSearchParams();
    tapeFields.forEach(id => {
      const el = document.getElementById(id);
      if (el && el.value) {
        params.set(fieldToParam[id], el.value);
      }
    });

    try {
      const res = await fetch(`/sachiko/form/tape-binding/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];

      // Update each dropdown with filtered options (except the one just changed)
      tapeFields.forEach(id => {
        if (id === changedFieldId) return; // skip the field that triggered the filter
        const choicesInstance = specChoices[id];
        if (!choicesInstance) return;

        const apiKey = fieldToApiKey[id];
        const filteredValues = data[apiKey] || [];
        const currentValue = document.getElementById(id)?.value || "";

        // Build new choices array
        const newChoices = filteredValues.map(v => ({
          value: String(v),
          label: String(v),
          selected: String(v) === currentValue,
        }));

        // Auto-select if exactly one option and nothing currently selected (and not resetting)
        if (changedFieldId !== "reset-all" && filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        // Clear and repopulate
        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: "Search", disabled: true, selected: !newChoices.some(c => c.selected) }, ...newChoices],
          "value",
          "label",
          true
        );
      });

      // If any fields were auto-selected, re-run filter to cascade
      if (autoSelected.length > 0) {
        await filterSpecs(autoSelected[0]);
        resolveTape();
      }
    } catch (err) {
      console.error("Filter specs error:", err);
    }
  }

  /* ================= CLIENT → USER ================= */
  clientSelect.addEventListener("change", async () => {
    const clientName = clientSelect.value;

    hardResetUserSelection();

    const res = await fetch(`/sachiko/form/tape-binding/client/${clientName}`);
    const clientData = await res.json();
    if (!clientData || !clientData.users) return;

    currentUsers = clientData.users;

    // ===== SINGLE USER =====
    if (clientData.users.length === 1) {
      const u = clientData.users[0];

      userChoices.setChoices(
        [{
          value: u._id,
          label: u.userName,
          selected: true,
          customProperties: {
            mobile: u.userContact || "",
            location: u.userLocation || ""
          }
        }],
        "value",
        "label",
        true
      );

      userIdInput.value = u._id;
      userContactInput.value = u.userContact || "";
      populateLocationChoices(u);
      return;
    }

    // ===== MULTIPLE USERS =====
    userChoices.setChoices(
      clientData.users.map(u => ({
        value: u._id,
        label: u.userName,
        customProperties: {
          mobile: u.userContact || "",
          location: u.userLocation || ""
        }
      })),
      "value",
      "label",
      true
    );

    resetUserFields();
  });

  /* ================= USER CHANGE ================= */
  userSelect.addEventListener("change", () => {
    const selectedId = userChoices.getValue(true);
    if (!selectedId) return;

    const choice = userChoices._store.choices.find(
      c => c.value === selectedId
    );
    if (!choice) return;

    userIdInput.value = choice.value;
    userContactInput.value = choice.customProperties?.mobile || "";

    const selectedUser = currentUsers.find(u => String(u._id) === String(selectedId));
    populateLocationChoices(selectedUser || { userLocation: choice.customProperties?.location || "" });
  });

  /* ================= TAPE RESOLVE ================= */
  async function resolveTape() {
    resetResolvedTape();
    syncDeliveredMeters();

    const values = {};
    for (let id of tapeFields) {
      const el = document.getElementById(id);
      if (!el || !el.value) return;
      values[id] = el.value;
    }

    const params = new URLSearchParams({
      tapePaperCode: values["tape-paper-code"],
      tapePaperType: values["tape-paper-type"],
      tapeGsm: values["tape-gsm"],
      tapeWidth: values["tape-width"],
      tapeMtrs: values["tape-mtrs"],
      tapeCoreId: values["tape-core-id"],
      tapeFinish: values["tape-finish"],
    });

    const res = await fetch(
      `/sachiko/form/tape-binding/resolve-tape?${params}`
    );

    if (!res.ok) {
      tapeIdDisplay.value = "No matching tape found";
      tapeIdDisplay.classList.add("tape-id-error");
      return;
    }

    const data = await res.json();

    tapeIdInput.value = data.tapeId;
    tapeIdDisplay.value = data.tapeProductId;
    tapeIdDisplay.classList.add("tape-id-success");
    submitBtn.disabled = false;

    document.getElementById("tape-client-paper-code").value =
      values["tape-paper-code"];
    document.getElementById("tape-client-gsm").value =
      values["tape-gsm"];
    document.getElementById("item-client-item-type").value =
      values["tape-paper-type"];
  }

  /* ================= SPEC CHANGE HANDLER ================= */
  tapeFields.forEach(id => {
    document.getElementById(id)?.addEventListener("change", async () => {
      await filterSpecs(id);
      resolveTape();
    });
  });

  /* ================= RESET SPECS ================= */
  const resetSpecsBtn = document.getElementById("reset-specs-btn");
  if (resetSpecsBtn) {
    resetSpecsBtn.addEventListener("click", async () => {
      // Clear underlying values for tape specs & reset their Choices UI
      tapeFields.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = "";
        
        // Also clear the Choices visible selection
        if (specChoices[id]) {
          specChoices[id].setChoiceByValue("");
        }
      });
      
      resetResolvedTape();

      // Clear the overrides if populated
      const clientPaperCode = document.getElementById("tape-client-paper-code");
      if (clientPaperCode) clientPaperCode.value = "";
      const clientGsm = document.getElementById("tape-client-gsm");
      if (clientGsm) clientGsm.value = "";

      // Clear all other text inputs
      const otherInputs = [
        "tape-mtrs-del",
        "tape-rate-per-roll",
        "tape-sale-cost",
        "tape-min-qty",
        "tape-odr-qty",
        "tape-odr-freq",
        "tape-credit-term",
        "tape-billing-type"
      ];
      otherInputs.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = "";
      });

      // Reset Client and User dropdowns
      if (typeof clientChoices !== "undefined") {
        clientChoices.setChoiceByValue("");
      }
      hardResetUserSelection();
      
      // Fetch fresh, unfiltered options and apply them to all fields
      await filterSpecs("reset-all");
    });
  }

  /* ================= RATE CALC ================= */
  const widthInput = document.getElementById("tape-width");
  const ratePerRollInput = document.getElementById("tape-rate-per-roll");
  const saleCostInput = document.getElementById("tape-sale-cost");

  function calcSaleCost() {
    if (!widthInput.value || !tapeMtrsInput.value || !ratePerRollInput.value) return;
    const area = (Number(widthInput.value) * Number(tapeMtrsInput.value)) / 1000;
    if (!area) return;
    saleCostInput.value =
      (Number(ratePerRollInput.value) / area).toFixed(4);
  }

  widthInput.addEventListener("input", calcSaleCost);
  tapeMtrsInput.addEventListener("input", () => {
    syncDeliveredMeters();
    calcSaleCost();
  });
  tapeMtrsInput.addEventListener("change", syncDeliveredMeters);
  tapeMtrsInput.addEventListener("addItem", syncDeliveredMeters);
  ratePerRollInput.addEventListener("input", calcSaleCost);
});

/* ================= CUSTOM TOAST ================= */
function showClientToast(message, isError = true) {
  // Check if existing toast exists, remove it
  const existingToast = document.getElementById("client-toast");
  if (existingToast) {
    existingToast.remove();
  }

  const toast = document.createElement("div");
  toast.id = "client-toast";
  toast.className = `toast-notification ${isError ? 'toast-error' : 'toast-success'}`;
  toast.innerHTML = `
    <span>${message}</span>
    <span class="toast-close" onclick="this.parentElement.remove()">×</span>
  `;

  document.body.appendChild(toast);

  // Auto remove
  setTimeout(() => {
    if (toast.parentElement) {
       toast.style.animation = "slideOut 0.5s forwards";
       setTimeout(() => toast.remove(), 500);
    }
  }, 5000);
}

/* ================= FORM GUARD ================= */
function validateTapeBeforeSubmit() {
  const tapeId = document.getElementById("resolved-tape-id").value;
  if (!tapeId) {
    showClientToast("Please select valid tape specifications.", true);
    return false;
  }

  const minQty = Number(document.getElementById("tape-min-qty").value);
  const odrQty = Number(document.getElementById("tape-odr-qty").value);

  if (minQty >= odrQty) {
    showClientToast("Order Quantity must be greater than Minimum Order Quantity", true);
    return false;
  }

  return true;
}
</script>
