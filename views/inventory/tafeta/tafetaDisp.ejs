<!-- Link to boilerplate.ejs -->
<% layout('/layout/boilerplate') -%>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />
</head>

<body>
  <style>
    #master-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
  </style>
  <div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
    <div class="indi-head">
      <h1>Tafeta</h1>
      <div class="download-btns">
        <div class="download-selector" id="downloadSelector">
          <button class="download-selector__trigger">
            <span>
              <i class="fa-solid fa-file-arrow-down"></i>
              <span class="download-typo">Download</span>
            </span>
            <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
          </button>
          <div class="download-selector__menu" id="downloads">
            <span class="download-selector__option" id="download-pdf">
              <i class="fas fa-file-pdf download-selector__option-icon"></i>
              <span>PDF</span>
            </span>
            <span class="download-selector__option" id="download-xlsx">
              <i class="fas fa-file-excel download-selector__option-icon"></i>
              <span>Excel</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="table-spinner"><div class="spinner-circle"></div></div>
    <div id="master-table" class="tabulator tabulator-modern"></div>
  </div>

  <!-- Tabulator JS -->
  <script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>
  <form id="deleteBindingForm" method="POST" style="display:none;"></form>
  <div class="logout-modal" id="deleteBindingModal" aria-hidden="true">
    <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteBindingTitle">
      <h2 class="logout-title" id="deleteBindingTitle">Remove binding?</h2>
      <p class="logout-text">This will permanently remove this client item binding.</p>
      <div class="logout-actions">
        <button class="logout-btn" type="button" id="deleteBindingCancel">Cancel</button>
        <button class="logout-btn primary" type="button" id="deleteBindingConfirm">Remove</button>
      </div>
    </div>
  </div>

  <div class="logout-modal" id="statusBindingModal" aria-hidden="true">
    <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="statusBindingTitle">
      <h2 class="logout-title" id="statusBindingTitle">Change binding status?</h2>
      <p class="logout-text" id="statusBindingText">This will change the binding status.</p>
      <div class="logout-actions">
        <button class="logout-btn" type="button" id="statusBindingCancel">Cancel</button>
        <button class="logout-btn primary" type="button" id="statusBindingConfirm">OK</button>
      </div>
    </div>
  </div>

  <script id="table-data" type="application/json"><%- safeJson(jsonData || []) %></script>
  <script>
    const rawData = JSON.parse(document.getElementById('table-data').textContent);

    // Flatten nested fields so Tabulator headerFilter works correctly
    const tableData = rawData.map(row => ({
      ...row,
      _userName: row.userId?.userName || "",
      _userContact: row.userId?.userContact || "",
      _userLocation: row.userId?.hoLocation || "",
      _clientName: row.userId?.clientName || "",
      _tafetaProductId: row.tafetaId?.tafetaProductId || "",
      _tafetaMaterialCode: row.tafetaId?.tafetaMaterialCode || "",
      _tafetaMaterialType: row.tafetaId?.tafetaMaterialType || "",
      _tafetaColor: row.tafetaId?.tafetaColor || "",
      _tafetaGsm: row.tafetaId?.tafetaGsm || "",
      _tafetaWidth: row.tafetaId?.tafetaWidth || "",
      _tafetaMtrs: row.tafetaId?.tafetaMtrs || "",
      _tafetaCoreLen: row.tafetaId?.tafetaCoreLen || "",
      _tafetaNotch: row.tafetaId?.tafetaNotch || "",
      _tafetaCoreId: row.tafetaId?.tafetaCoreId || "",
      _tafetaMasterId: row.tafetaId?._id || "",
    }));

    const withTextFilter = (column) => ({
      headerFilter: "input",
      headerFilterPlaceholder: "Search",
      ...column,
    });

    const table = new Tabulator("#master-table", {
      data: tableData,
      height: "100%",
      // layout: "fitColumns",
      responsiveLayout: false,
      movableColumns: true,
      placeholder: "No data to display",
      columns: [
        {
          title: "Actions",
          hozAlign: "center",
          headerHozAlign: "center",
          width: 132,
          minWidth: 132,
          widthGrow: 0,
          widthShrink: 0,
          formatter: function (cell) {
            const row = cell.getRow().getData();
            if (!row._id) return '';
            return `
              <div style="display:flex;align-items:center;justify-content:center;gap:6px;">
                <button
                  onclick="window.location.href='/sachiko/tafeta/compare/${row._id}'"
                  style="padding:2px 7px;background:#044A78;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                  title="View Binding">
                  <i class="fa-solid fa-eye"></i>
                </button>
                <button
                  onclick="window.location.href='/sachiko/tafeta-binding/edit/${row._id}'"
                  style="padding:2px 7px;background:#e67e22;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                  title="Edit Binding">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button
                  onclick="promptToggleStatus('${row._id}', '${row.status || 'ACTIVE'}')"
                  style="padding:2px 7px;background:${(row.status || 'ACTIVE') === 'ACTIVE' ? '#28a745' : '#6c757d'};color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                  title="${(row.status || 'ACTIVE') === 'ACTIVE' ? 'Set Inactive' : 'Set Active'}">
                  <i class="fa-solid ${(row.status || 'ACTIVE') === 'ACTIVE' ? 'fa-toggle-on' : 'fa-toggle-off'}"></i>
                </button>
                <button
                  onclick="promptDeleteBinding('${row._id}')"
                  style="padding:2px 7px;background:#d9534f;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                  title="Remove Binding">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            `;
          }
        },
        {
          title: "Status",
          field: "status",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Search",
          formatter: function (cell) {
            const val = cell.getValue() || "ACTIVE";
            const isActive = val === "ACTIVE";
            const bg = isActive ? "#28a745" : "#dc3545";
            return `<span style="background:${bg};color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;">${val}</span>`;
          }
        },
        {
          title: "Stock",
          field: "stock",
          hozAlign: "center",
          headerFilter: "input",
          headerFilterPlaceholder: "Search",
          formatter: (cell) => {
            const row = cell.getRow().getData();
            const stock = row.stock ?? "-";
            return `<span style="font-weight:600">${stock}</span>`;
          }
        },
        {
          title: "Order",
          hozAlign: "center",
          formatter: (cell) => {
            const row = cell.getRow().getData();
            return `
              <button 
                onclick="window.location.href='/sachiko/sales/order?type=TAFETA&client=${encodeURIComponent(row._clientName)}&user=${row.userId?._id || ""}&item=${row._id}'"
                style="padding:2px 10px;background:#044A78;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">
                <i class="fa-solid fa-cart-plus"></i>
              </button>
            `;
          }
        },
        withTextFilter({ title: "Client Name", field: "_clientName" }),
        withTextFilter({ title: "User Name", field: "_userName" }),
        withTextFilter({ title: "User Contact", field: "_userContact" }),
        withTextFilter({ title: "Location", field: "location" }),
        withTextFilter({ title: "Material Code", field: "_tafetaMaterialCode" }),
        withTextFilter({ title: "Material Type", field: "_tafetaMaterialType" }),
        withTextFilter({ title: "Color", field: "_tafetaColor" }),
        withTextFilter({ title: "GSM", field: "_tafetaGsm" }),
        withTextFilter({ title: "Width", field: "_tafetaWidth" }),
        withTextFilter({ title: "Mtrs", field: "_tafetaMtrs" }),
        withTextFilter({ title: "Core Length", field: "_tafetaCoreLen" }),
        withTextFilter({ title: "Notch", field: "_tafetaNotch" }),
        withTextFilter({ title: "Core ID", field: "_tafetaCoreId" }),
        withTextFilter({ title: "Client Material Code", field: "tafetaClientMaterialCode" }),
        withTextFilter({ title: "Client GSM", field: "clientTafetaGsm" }),
        withTextFilter({ title: "Mtrs Del", field: "tafetaMtrsDel" }),
        withTextFilter({ title: "Rate Per Roll", field: "tafetaRatePerRoll" }),
        withTextFilter({ title: "Sale Cost", field: "tafetaSaleCost" }),
        withTextFilter({ title: "Min Qty", field: "tafetaMinQty" }),
        withTextFilter({ title: "Order Qty", field: "tafetaOdrQty" }),
        withTextFilter({ title: "Order Freq", field: "tafetaOdrFreq" }),
        withTextFilter({ title: "Credit Term", field: "tafetaCreditTerm" }),
      ],
    });

    const selector = document.getElementById("downloadSelector");
    const trigger = selector.querySelector(".download-selector__trigger");

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      selector.classList.toggle("download-selector--active");
    });

    document.addEventListener("click", () => {
      selector.classList.remove("download-selector--active");
    });

    document.getElementById("download-pdf").addEventListener("click", () => {
      table.download("pdf", "tafeta.pdf", {
        orientation: "landscape",
        title: "Tafeta Data",
      });
      selector.classList.remove("download-selector--active");
    });

    document.getElementById("download-xlsx").addEventListener("click", () => {
      table.download("xlsx", "tafeta.xlsx", {
        sheetName: "Tafeta",
      });
      selector.classList.remove("download-selector--active");
    });

    let bindingToDelete = "";
    const deleteModal = document.getElementById("deleteBindingModal");
    const deleteForm = document.getElementById("deleteBindingForm");
    const deleteConfirmBtn = document.getElementById("deleteBindingConfirm");
    const deleteCancelBtn = document.getElementById("deleteBindingCancel");
    const getCsrfToken = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || "";

    window.promptDeleteBinding = function (bindingId) {
      bindingToDelete = String(bindingId || "");
      deleteModal.classList.add("show");
      deleteModal.setAttribute("aria-hidden", "false");
    };

    function closeDeleteModal() {
      deleteModal.classList.remove("show");
      deleteModal.setAttribute("aria-hidden", "true");
      bindingToDelete = "";
    }

    deleteCancelBtn.addEventListener("click", closeDeleteModal);
    deleteModal.addEventListener("click", (e) => {
      if (e.target === deleteModal) closeDeleteModal();
    });
    document.addEventListener("keydown", (e) => {
      if (!deleteModal.classList.contains("show")) return;
      if (e.key !== "Enter") return;
      if (e.target && ["INPUT", "TEXTAREA"].includes(e.target.tagName) && e.target !== deleteConfirmBtn) return;
      e.preventDefault();
      deleteConfirmBtn.click();
    });
    deleteConfirmBtn.addEventListener("click", () => {
      if (!bindingToDelete) return closeDeleteModal();
      let csrfInput = deleteForm.querySelector('input[name="_csrf"]');
      if (!csrfInput) {
        csrfInput = document.createElement("input");
        csrfInput.type = "hidden";
        csrfInput.name = "_csrf";
        deleteForm.appendChild(csrfInput);
      }
      csrfInput.value = getCsrfToken();
      deleteForm.action = `/sachiko/tafeta-binding/delete/${bindingToDelete}`;
      deleteForm.submit();
    });

    // Change status (confirm dialog)
    let statusBindingId = "";
    let statusTarget = "INACTIVE"; // status to apply on confirm (opposite of current)
    const statusModal = document.getElementById("statusBindingModal");
    const statusText = document.getElementById("statusBindingText");
    const statusConfirmBtn = document.getElementById("statusBindingConfirm");
    const statusCancelBtn = document.getElementById("statusBindingCancel");

    window.promptToggleStatus = function (bindingId, currentStatus) {
      statusBindingId = String(bindingId || "");
      const current = (currentStatus || "ACTIVE") === "INACTIVE" ? "INACTIVE" : "ACTIVE";
      statusTarget = current === "ACTIVE" ? "INACTIVE" : "ACTIVE";
      statusText.textContent = `This will mark the binding as ${statusTarget}.`;
      statusModal.classList.add("show");
      statusModal.setAttribute("aria-hidden", "false");
    };

    function closeStatusModal() {
      statusModal.classList.remove("show");
      statusModal.setAttribute("aria-hidden", "true");
      statusBindingId = "";
    }

    statusCancelBtn.addEventListener("click", closeStatusModal);
    statusModal.addEventListener("click", (e) => {
      if (e.target === statusModal) closeStatusModal();
    });

    statusConfirmBtn.addEventListener("click", async () => {
      if (!statusBindingId) return closeStatusModal();
      statusConfirmBtn.disabled = true;
      const endpoint = statusTarget === "ACTIVE" ? "set-active" : "set-inactive";
      try {
        const res = await fetch(`/sachiko/tafeta-binding/${endpoint}/${statusBindingId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json", "x-csrf-token": getCsrfToken() },
        });
        if (res.ok) {
          closeStatusModal();
          window.location.reload();
        }
      } finally {
        statusConfirmBtn.disabled = false;
      }
    });

    document.addEventListener("keydown", (e) => {
      if (!statusModal.classList.contains("show")) return;
      if (e.key !== "Enter") return;
      e.preventDefault();
      statusConfirmBtn.click();
    });
  </script>
</body>
