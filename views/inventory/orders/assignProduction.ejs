<% layout('/layout/boilerplate') -%>

<%
  const item = pp.itemId || {};
  const owner = pp.userId || {};
  const isEmpty = (v) => v === undefined || v === null || (typeof v === "string" && v.trim() === "");
  const dash = (v) => (isEmpty(v) ? "—" : v);
  const escHtml = (v) => String(v).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const fmtDate = (v) => {
    if (!v) return "—";
    const d = new Date(v);
    if (isNaN(d)) return "—";
    return String(d.getDate()).padStart(2, "0") + "/" + String(d.getMonth() + 1).padStart(2, "0") + "/" + d.getFullYear();
  };
  const balance = Math.max((Number(pp.quantity) || 0) - (Number(pp.dispatchedQuantity) || 0), 0);
  const fmtQty = (v) => (Number.isFinite(Number(v)) && v !== '' && v != null)
    ? Number(v).toLocaleString('en-IN')
    : (v || '—');

  // Every field POOL_MATCH_FIELDS (utils/labelStockProduction.js) actually
  // checks to decide a raw-material reel counts as this layer's material,
  // grouped into one card per physical layer -- Facestock / Adhesive /
  // Release Liner never share a box, so the spec reads as distinct materials
  // rather than one mixed list. Nothing else (Vendor Name, Size, Adhesive's
  // Viscosity/Cohesion/Shear/Density/GSM, Release's Size/GSM) is part of
  // that match, so it isn't shown here either -- same trim as this page's
  // own reelDetail()/specSummary() further down, keep all three in step.
  // Layer order and keys mirror LAYER_ORDER/LAYER_META in utils/
  // labelStockProduction.js (the same grouping the raw-material columns
  // further down this page use) -- keep the two in step.
  const gsm = (v) => (v !== undefined && v !== null && v !== "" ? v + " GSM" : null);
  const mic = (v) => (v !== undefined && v !== null && v !== "" ? v + " MIC" : null);
  const rollType = item.rollType || "NORMAL";

  const LAYER_ORDER = {
    NORMAL: ["facestock", "adhesive", "releaseLiner"],
    "DOUBLE RELEASE": ["facestock", "adhesive", "releaseLiner", "adhesive2", "releaseLiner2"],
    "DOUBLE FACESTOCK": ["facestock", "adhesive", "facestock2", "adhesive2", "releaseLiner"],
  };
  const LAYER_GROUPS = {
    facestock: {
      title: "Facestock", swatch: "facestock",
      fields: (s) => [
        ["Family", s?.facestockFamily], ["Make", s?.facestockMake],
        ["Vendor SKU Code", s?.facestockVendorSkuCode], ["Type", s?.facestockType],
        ["GSM", gsm(s?.facestockGsm)], ["Micron", mic(s?.facestockMicron)],
      ],
    },
    adhesive: {
      title: "Adhesive", swatch: "adhesive",
      fields: (s) => [
        ["Type", s?.adhesiveType], ["Make", s?.adhesiveMake],
        ["Vendor SKU Code", s?.adhesiveVendorSkuCode],
      ],
    },
    releaseLiner: {
      title: "Release Liner", swatch: "release",
      fields: (s) => [
        ["Type", s?.releaseLinerType], ["Make", s?.releaseLinerMake],
        ["Vendor SKU Code", s?.releaseLinerVendorSkuCode], ["Color", s?.releaseLinerColor],
      ],
    },
  };
  const specFieldFor = { facestock: "facestock", facestock2: "facestock2", adhesive: "adhesive", adhesive2: "adhesive2", releaseLiner: "releaseLiner", releaseLiner2: "releaseLiner2" };
  const baseKeyFor = (key) => key.replace(/2$/, "");

  const materialGroups = (LAYER_ORDER[rollType] || LAYER_ORDER.NORMAL).map((key) => {
    const base = LAYER_GROUPS[baseKeyFor(key)];
    const isLayer2 = key.endsWith("2");
    return {
      title: base.title + (isLayer2 ? " (Layer 2)" : ""),
      swatch: base.swatch,
      fields: base.fields(item[specFieldFor[key]]),
    };
  });
%>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 14px;">
  <style>
    .ap-head h1 { font-size: 20px; color: #fff; margin: 0; }
    .ap-head .ap-sub { font-size: 13px; color: rgba(255, 255, 255, 0.85); margin-top: 2px; }

    .ap-card {
      width: 100%;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      overflow: visible;
    }
    .ap-card-title {
      background: #044a78;
      color: #fff; font-size: 14px; font-weight: 600; letter-spacing: 0.2px;
      padding: 9px 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
      border-radius: 9px 9px 0 0;
    }
    .ap-card .choices__list--dropdown { z-index: 60; }

    .ap-table-wrap { overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px; }
    .ap-table { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: fixed; }
    .ap-table th, .ap-table td { padding: 8px 14px; border-bottom: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb; text-align: left; }
    .ap-table tr > *:last-child { border-right: none; }
    .ap-table th { background: #f8fafc; color: #044a78; font-weight: 700; white-space: nowrap; width: 10%; }
    .ap-table td { color: #1f2a44; font-weight: 600; word-break: break-word; }

    .ap-notice {
      background: #fff8e1; border: 1px solid #f0c36d; color: #7a5b00; border-radius: 8px;
      padding: 10px 14px; font-size: 13px; display: flex; align-items: center; gap: 8px;
    }

    /* ---- Material Details -- physical layer stack (top-to-bottom), same
       layer order/styling as the Sales Order item picker (views/inventory/
       orders/salesOrderForm.ejs renderOrderLabelStockLayerStack()), the Label
       Stock Binding form (views/sachiko/labelStockBindingForm.ejs) and the
       Label Stock View page (views/sachiko/labelStockView.ejs) -- kept in
       sync with all three so the same SKU always renders the same stack
       everywhere. Layer 2 blocks reuse their base material's colour but get
       a dashed border, marking them as the recipe's second pass of that
       material. ---- */
    .material-id-row {
      display: flex; flex-wrap: wrap; gap: 24px; padding: 10px 14px;
      border: 1px solid #e5e7eb; border-radius: 8px; background: #f8fafc; margin-bottom: 12px;
    }
    .material-id-row .mid-item { display: flex; flex-direction: column; gap: 2px; }
    .material-id-row .mid-label { font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #94a3b8; }
    .material-id-row .mid-value { font-size: 13px; font-weight: 700; color: #1f2a44; }

    .layer-stack { display: flex; flex-direction: column; gap: 2px; max-height: 340px; overflow-y: auto; padding: 2px; }
    .layer-block {
      background: var(--mg-bg); border: 1.5px solid var(--mg-border); border-radius: 6px;
      padding: 8px 14px; display: flex; justify-content: flex-start; align-items: center; gap: 10px;
    }
    .layer-block.is-layer2 { border-style: dashed; }
    .layer-block-label { font-size: 13px; font-weight: 800; letter-spacing: 0.04em; color: var(--mg-text); white-space: nowrap; width: 130px; flex: 0 0 auto; }
    .layer-block-sep { font-size: 13px; font-weight: 700; color: var(--mg-border); }
    .layer-block-detail { font-size: 13px; font-weight: 800; color: #334155; text-align: left; }
    /* Sized to content, not a fixed column width -- a fixed width here used
       to exist to cap Vendor Name (the one field long enough to need
       truncating), but that field's gone from this card now (see
       LAYER_GROUPS above -- only POOL_MATCH_FIELDS's own fields show here),
       and a fixed width too narrow for "Vendor SKU Code:" made its value
       overflow into the next pair (no visible gap) or get ellipsis-cut even
       when short. */
    .layer-block-detail .lbd-pair { display: inline-flex; align-items: baseline; vertical-align: top; margin-right: 14px; }
    .layer-block-detail .lbd-field { color: #000; font-weight: 600; white-space: nowrap; flex: 0 0 auto; margin-right: 4px; }
    .layer-block-detail .lbd-value { white-space: nowrap; }
    .layer-caret { display: flex; justify-content: center; margin: -2px 0; color: #cbd5e1; font-size: 11px; }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

    .material-group--facestock { --mg-border: #93c5fd; --mg-bg: #eff6ff; --mg-text: #1d4ed8; }
    .material-group--adhesive  { --mg-border: #fcd34d; --mg-bg: #fffbeb; --mg-text: #b45309; }
    .material-group--release   { --mg-border: #cbd5e1; --mg-bg: #f8fafc; --mg-text: #475569; }

    .material-wordfile { margin-top: 12px; }
    .material-wordfile a { display: inline-flex; align-items: center; gap: 6px; color: #044a78; font-weight: 600; text-decoration: none; font-size: 13px; }

    .ap-form-card {
      width: 100%; background: #fff; border-radius: 10px;
      border: 1px solid #e2e8f0; padding: 16px 18px; display: flex; flex-direction: column; gap: 14px;
    }
    .ap-submit-btn {
      background: #044a78; color: #fff; border: none; border-radius: 8px;
      padding: 10px 22px; font-size: 14.5px; font-weight: 600; cursor: pointer; transition: opacity 0.2s;
    }
    .ap-submit-btn:hover { opacity: 0.88; }
    /* .btn-grp (common.css) declares justify-content/align-items but never
       display:flex, so its buttons default to plain left-aligned block flow
       -- scope the fix to this page rather than the shared class. */
    #assign-form .btn-grp { display: flex; justify-content: center; }

    .jc-readonly {
      background: #f0f7ff !important;
      color: #044a78 !important;
      font-weight: 700 !important;
      cursor: default !important;
    }

    .span-three input.form-control, .span-four input.form-control, .span-five input.form-control,
    .span-six input.form-control, .span-dual input.form-control,
    .span-three select.form-control, .span-four select.form-control, .span-five select.form-control,
    .span-six select.form-control, .span-dual select.form-control {
      padding: 0.375rem 0.5rem !important;
      font-size: 1rem !important;
      height: auto !important;
      width: 100%;
    }
    .span-three .choices__inner, .span-four .choices__inner, .span-five .choices__inner,
    .span-six .choices__inner, .span-dual .choices__inner {
      min-height: 2.3rem;
      padding: 0.375rem 0.5rem !important;
      display: flex;
      align-items: center;
    }
    .span-three .choices__list--single, .span-four .choices__list--single,
    .span-five .choices__list--single, .span-six .choices__list--single,
    .span-dual .choices__list--single { padding: 0; }

    #assign-form {
      display: grid !important;
      grid-template-columns: repeat(32, 1fr);
      gap: 1rem;
    }

    .roll-table { table-layout: auto; }
    .roll-table th { width: auto; font-size: 12.5px; }
    .roll-table td { font-size: 13.5px; }
    .roll-table tbody tr { cursor: pointer; user-select: none; }
    .roll-table tbody tr:hover { background: #eff6ff; }
    .roll-table .roll-check-cell { width: 56px; text-align: center; }
    .roll-table th:not(.roll-fill), .roll-table td:not(.roll-fill) { white-space: nowrap; width: 1%; }
    .roll-table .roll-fill { width: 100%; border-right: none; }
    .roll-table input[type="checkbox"] {
      width: 20px; height: 20px; margin: 0; vertical-align: middle;
      cursor: pointer; accent-color: #044a78;
    }
    .roll-table tbody tr.roll-locked,
    .roll-table tbody tr.roll-locked:hover { background: #f8fafc; cursor: not-allowed; }
    .roll-table tbody tr.roll-locked td { color: #94a3b8; }
    .roll-table tbody tr.roll-locked input[type="checkbox"] { cursor: not-allowed; }

    /* ---- Raw Material Allotment -- one inline column per raw-material
       layer, styled like .roll-table above. NORMAL needs 3 (Facestock/
       Adhesive/Release Liner); DOUBLE RELEASE and DOUBLE FACESTOCK need 5 --
       the grid is auto-fit rather than a fixed 3 columns so those extra
       columns just wrap onto a second row instead of needing their own
       layout. ---- */
    #rawLayersGrid {
      grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px;
    }
    .raw-layer-col { min-width: 0; }
    .raw-layer-title { font-size: 13px; font-weight: 700; color: #044a78; margin-bottom: 2px; }
    .raw-layer-spec { font-size: 11.5px; color: #64748b; margin-bottom: 6px; }
    .raw-layer-table td, .raw-layer-table th { white-space: normal; }
    /* Vendor Name (plus whatever else reelDetail() joins alongside it) can
       run longer than this narrow column -- truncate with an ellipsis
       instead of wrapping/pushing the table wider; the row's title
       attribute carries the untruncated text as a hover tooltip. */
    .raw-layer-detail-cell {
      max-width: 140px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  </style>

  <div class="indi-head ap-head" style="display:flex; align-items:center; justify-content:space-between; gap:14px;">
    <div>
      <h1>Assign Production</h1>
      <div class="ap-sub">
        <%= dash(owner.clientName) %><% if (owner.userName) { %> / <%= owner.userName %><% } %>
      </div>
    </div>
    <div style="text-align:right; color:#fff; line-height:1.4;">
      <div style="font-size:17px; font-weight:600;">Date: <%= fmtDate(new Date()) %></div>
      <div style="font-size:22px; font-weight:700;">Lot No: <%= previewLotNo %></div>
    </div>
  </div>

  <div class="ap-card">
    <div class="ap-card-title"><span><i class="fa-solid fa-tag"></i> Order Details</span></div>
    <div class="ap-table-wrap">
      <table class="ap-table">
        <tbody>
          <tr>
            <th>PO Number</th><td><%= dash(pp.poNumber) %></td>
            <th>PO Date</th><td><%= fmtDate(poDate) %></td>
            <th>Est. Delivery</th><td><%= fmtDate(pp.estimatedDate) %></td>
          </tr>
          <tr>
            <th>Product Code</th><td><%= dash(item.productCode || item.skuCode) %></td>
            <th>Paper Size</th><td><%= dash(pp.paperSize) %></td>
            <th>No. of Rolls</th><td><%= dash(pp.noOfRolls) %></td>
          </tr>
          <tr>
            <th>Quantity</th><td><%= fmtQty(pp.quantity) %></td>
            <th>Dispatched</th><td><%= fmtQty(pp.dispatchedQuantity || 0) %></td>
            <th>Balance</th><td><%= fmtQty(balance) %></td>
          </tr>
          <tr>
            <th>Running Mtrs</th><td><%= fmtQty(pp.runningMeters) %></td>
            <th colspan="1">Remarks</th><td colspan="3"><%= dash(pp.remarks) %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="ap-card">
    <div class="ap-card-title"><span><i class="fa-solid fa-layer-group"></i> Material Details</span></div>
    <div style="padding: 14px;">
      <div class="material-id-row">
        <div class="mid-item"><span class="mid-label">Label Stock ID</span><span class="mid-value"><%= dash(item.labelStockId) %></span></div>
        <div class="mid-item"><span class="mid-label">SKU Code</span><span class="mid-value"><%= dash(item.skuCode) %></span></div>
        <div class="mid-item"><span class="mid-label">Roll Type</span><span class="mid-value"><%= dash(rollType) %></span></div>
      </div>

      <div class="layer-stack custom-scrollbar">
        <% materialGroups.forEach(function (g, idx) { %>
          <div class="layer-block material-group--<%= g.swatch %><%= g.title.indexOf('(Layer 2)') !== -1 ? ' is-layer2' : '' %>">
            <span class="layer-block-label"><%= g.title.toUpperCase() %></span>
            <span class="layer-block-sep">|</span>
            <%
              const detailParts = g.fields
                .filter(function (f) { return !isEmpty(f[1]); })
                .map(function (f) {
                  return '<span class="lbd-pair" title="' + escHtml(f[1]) + '">'
                    + '<span class="lbd-field">' + escHtml(f[0]) + ':</span>'
                    + '<span class="lbd-value">' + escHtml(f[1]) + '</span></span>';
                });
            %>
            <span class="layer-block-detail"><%- detailParts.length ? detailParts.join(" | ") : "—" %></span>
          </div>
          <% if (idx < materialGroups.length - 1) { %>
            <div class="layer-caret"><i class="fa-solid fa-caret-down"></i></div>
          <% } %>
        <% }) %>
      </div>

    </div>
  </div>

  <form id="assign-form" class="ap-form-card needs-validation" action="/sachiko/labels/production/assign/<%= pp._id %>" method="post" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="span-dual" style="grid-column: span 11;">
      <label for="machine-select">Machine</label>
      <select id="machine-select" name="machineId" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select Machine</option>
      </select>
    </div>

    <div class="span-dual" style="grid-column: span 11;">
      <label for="operator-select">Operator</label>
      <select id="operator-select" name="operatorId" class="form-control select-tag">
        <option value="" selected>Select Operator</option>
        <% operatorEmployees.forEach((emp) => { %>
          <option value="<%= emp._id %>" data-profilecode="<%= emp.empProfileCode || '' %>"><%= emp.empName %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-dual" style="grid-column: span 10;">
      <label for="helper-select">Helper</label>
      <select id="helper-select" name="helperId" class="form-control select-tag">
        <option value="" selected>Select Helper</option>
        <% helperEmployees.forEach((emp) => { %>
          <option value="<%= emp._id %>" data-profilecode="<%= emp.empProfileCode || '' %>"><%= emp.empName %></option>
        <% }) %>
      </select>
    </div>


    <!-- ============ RAW MATERIAL ALLOTMENT ============
         Lets a reel of each raw-material layer this item's recipe calls for
         (Facestock/Adhesive/Release Liner -- +2 more layers for DOUBLE
         FACESTOCK/DOUBLE RELEASE, see models/sachiko/sachikoLabelStock.js)
         be picked and reserved to this order (allottedLayers, via this same
         Assign & Continue submit). Select a machine first -- these columns
         are scoped to its location.
         No Kg-to-produce quantity is taken here for now -- reel picks are
         just recorded as allotted; producing an actual Deckle from them is a
         separate step, not part of this submit (the POST handler in
         fairdesk_route.js only calls produceDeckle() when rawProduceMtrs is
         submitted > 0, which nothing on this page does anymore). -->
    <div class="span-full form-subheading raw-produce-row" style="grid-column: 1 / -1; margin: 10px 0 0; display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 18px;">
      <h1>Raw Material Allotment</h1>
    </div>
    <div id="rawLayersGrid"></div>

    <div class="btn-grp span-full">
      <button type="button" id="assignSubmitBtn" class="ap-submit-btn">Assign &amp; Continue</button>
    </div>
  </form>
</div>

<script id="all-machines-data" type="application/json"><%- safeJson(allMachines) %></script>
<script id="item-data" type="application/json"><%- safeJson(item) %></script>
<script id="allotted-layers-data" type="application/json"><%- safeJson(pp.allottedLayers || {}) %></script>
<script id="order-id-data" type="application/json"><%- safeJson(String(pp._id)) %></script>
<script src="/js/choices.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const ALL_MACHINES = JSON.parse(document.getElementById("all-machines-data").textContent);

    const machineSelectEl = document.getElementById("machine-select");
    const operatorSelectEl = document.getElementById("operator-select");
    const helperSelectEl = document.getElementById("helper-select");
    const submitBtn = document.querySelector(".ap-submit-btn");

    const machineChoices = new Choices(machineSelectEl, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
    const operatorChoices = new Choices(operatorSelectEl, { searchEnabled: true, shouldSort: false, itemSelectText: "" });
    const helperChoices = new Choices(helperSelectEl, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    // Each Operator/Helper's Profile Code mirrors the Machine name they run
    // (e.g. Machine "R1" <-> Employee Profile Code "R1") -- picking a machine
    // auto-selects whichever operator/helper shares that code.
    function autoFillByMachineCode(machineName, selectEl, choicesInstance) {
      const wanted = (machineName || "").trim().toUpperCase();
      const match = wanted
        ? Array.from(selectEl.options).find(
            (o) => o.dataset.profilecode && o.dataset.profilecode.trim().toUpperCase() === wanted,
          )
        : null;
      choicesInstance.setChoiceByValue(match ? match.value : "");
    }

    machineSelectEl.addEventListener("change", function () {
      const machine = ALL_MACHINES.find((m) => String(m._id) === String(this.value));
      autoFillByMachineCode(machine?.machineName, operatorSelectEl, operatorChoices);
      autoFillByMachineCode(machine?.machineName, helperSelectEl, helperChoices);
    });

    const machineLabel = (m) => `${m.machineName} — ${m.location?.locationName || "?"}${m.machineType ? " (" + m.machineType + ")" : ""}`;
    const options = ALL_MACHINES.map((m) => ({ value: m._id, label: machineLabel(m) }));
    machineChoices.setChoices(
      [{ value: "", label: "Select Machine", disabled: true, selected: true }, ...options],
      "value", "label", true,
    );

    // What this order already had assigned, so re-opening it to edit shows
    // the previous machine/operator/helper instead of a blank form.
    const ASSIGNED = <%- safeJson({
      machineId: pp.assignedMachineId ? String(pp.assignedMachineId) : "",
      operatorId: pp.operatorId ? String(pp.operatorId) : "",
      helperId: pp.helperId ? String(pp.helperId) : "",
    }) %>;

    if (ASSIGNED.machineId) machineChoices.setChoiceByValue(String(ASSIGNED.machineId));
    if (ASSIGNED.operatorId) operatorChoices.setChoiceByValue(String(ASSIGNED.operatorId));
    if (ASSIGNED.helperId) helperChoices.setChoiceByValue(String(ASSIGNED.helperId));

    // ---- Raw Material Allotment ----
    // One inline column per raw-material layer this item's recipe calls
    // for -- Facestock/Adhesive/Release Liner reel picks travel straight in
    // the main form (checkbox inputs named rawLayers[<key>]; a layer can
    // have more than one checked at once, e.g. combining two undersized
    // reels onto one order) and are recorded server-side as allottedLayers,
    // as part of this same Assign & Continue submit -- no Deckle gets
    // laminated from this page for now (see the doc comment above
    // #rawLayersGrid). Columns are scoped to the selected machine's own
    // location, so nothing here is choosable until a machine is picked.
    //
    // LAYER_ORDER / LAYER_META mirror the server copy in
    // utils/labelStockProduction.js (and labelStockForm.ejs's
    // ROLL_TYPE_ORDER) -- keep all three in step.
    const LAYER_ORDER = {
      NORMAL: ["facestock", "adhesive", "releaseLiner"],
      "DOUBLE RELEASE": ["facestock", "adhesive", "releaseLiner", "adhesive2", "releaseLiner2"],
      "DOUBLE FACESTOCK": ["facestock", "adhesive", "facestock2", "adhesive2", "releaseLiner"],
    };
    const LAYER_META = {
      facestock: { pool: "facestock", label: "Facestock", specField: "facestock", typeField: "facestockType" },
      adhesive: { pool: "adhesive", label: "Adhesive", specField: "adhesive", typeField: "adhesiveType" },
      releaseLiner: { pool: "release", label: "Release Liner", specField: "releaseLiner", typeField: "releaseLinerType" },
      facestock2: { pool: "facestock", label: "Facestock (Layer 2)", specField: "facestock2", typeField: "facestockType" },
      adhesive2: { pool: "adhesive", label: "Adhesive (Layer 2)", specField: "adhesive2", typeField: "adhesiveType" },
      releaseLiner2: { pool: "release", label: "Release Liner (Layer 2)", specField: "releaseLiner2", typeField: "releaseLinerType" },
    };

    const ITEM = JSON.parse(document.getElementById("item-data").textContent);
    const requiredLayerKeys = () => LAYER_ORDER[ITEM.rollType] || LAYER_ORDER.NORMAL;
    const layerReelsCache = {}; // layerKey -> reels fetched for the current machine's location

    // What this order already had picked per raw-material layer (see
    // models/inventory/pendingProduction.js's allottedLayers) -- so
    // re-opening a partially-allocated order to top up one layer doesn't
    // silently drop what was already picked for the others. Only used as a
    // fallback default the first time a layer renders; once the checkbox
    // group exists in the DOM, renderLayerRows() carries the live DOM selection
    // forward instead (see previouslyChecked below), same as any other pick.
    const ALLOTTED_LAYERS = JSON.parse(document.getElementById("allotted-layers-data").textContent) || {};
    const ORDER_ID = JSON.parse(document.getElementById("order-id-data").textContent);

    // Shows exactly the fields reelMatchesLayer() (utils/labelStockProduction.js
    // POOL_MATCH_FIELDS) actually checks to decide a reel counts as this
    // layer's material -- Facestock: family/make/vendor SKU code/type/micron;
    // Adhesive: type alone; Release Liner: type/make/vendor SKU code/color.
    // Nothing else (Vendor Name, Size, Facestock's gsm, Adhesive's make/
    // vendor SKU code/shelf life/viscosity/cohesion/shear/density, Release's
    // size/gsm) is part of that match, so it isn't shown here either -- it
    // belongs in reelDetail() below instead. Keep all three in step.
    function specSummary(spec, layerKey) {
      if (!spec) return "—";
      const bits = [];
      if (layerKey.startsWith("facestock")) {
        if (spec.facestockFamily) bits.push(spec.facestockFamily);
        if (spec.facestockMake) bits.push(spec.facestockMake);
        if (spec.facestockVendorSkuCode) bits.push(spec.facestockVendorSkuCode);
        if (spec.facestockType) bits.push(spec.facestockType);
        if (spec.facestockMicron) bits.push(`${spec.facestockMicron} MIC`);
      } else if (layerKey.startsWith("adhesive")) {
        if (spec.adhesiveType) bits.push(spec.adhesiveType);
      } else {
        if (spec.releaseLinerType) bits.push(spec.releaseLinerType);
        if (spec.releaseLinerMake) bits.push(spec.releaseLinerMake);
        if (spec.releaseLinerVendorSkuCode) bits.push(spec.releaseLinerVendorSkuCode);
        if (spec.releaseLinerColor) bits.push(spec.releaseLinerColor);
      }
      return bits.join(" · ") || "—";
    }

    // Per-candidate-reel counterpart to specSummary() above: shows exactly
    // the fields specSummary DOESN'T (the ones POOL_MATCH_FIELDS no longer
    // narrows on) -- Facestock: Vendor Name/GSM/Size; Adhesive: Make/Vendor
    // SKU Code/Vendor Name/Shelf Life/Viscosity/Cohesion/Shear/Density;
    // Release Liner: Vendor Name/Size/GSM. Since those fields can now differ
    // between reels that still count as a match, this is what a picker
    // actually needs to tell candidates apart by -- replaces the system Roll
    // ID (still available as this cell's hover tooltip) in the roll table
    // below.
    function reelDetail(layerKey, r) {
      const bits = [];
      if (layerKey.startsWith("facestock")) {
        // Size has its own column for facestock reels (see layerColumnHtml/
        // renderLayerRows) -- not repeated here.
        if (r.vendorName) bits.push(r.vendorName);
        if (r.gsm) bits.push(`${r.gsm} GSM`);
      } else if (layerKey.startsWith("adhesive")) {
        if (r.make) bits.push(r.make);
        if (r.vendorSkuCode) bits.push(r.vendorSkuCode);
        if (r.vendorName) bits.push(r.vendorName);
        if (r.shelfLife) bits.push(`Shelf Life ${r.shelfLife}`);
        if (r.viscosity) bits.push(`Visc ${r.viscosity}`);
        if (r.cohesion) bits.push(`Coh ${r.cohesion}`);
        if (r.shear) bits.push(`Shear ${r.shear}`);
        if (r.density) bits.push(`Dens ${r.density}`);
      } else {
        if (r.vendorName) bits.push(r.vendorName);
        if (r.size) bits.push(`Size ${r.size}`);
        if (r.gsm) bits.push(`${r.gsm} GSM`);
      }
      return bits.join(" · ") || "—";
    }

    // Facestock reels get a dedicated Size column (produceDeckle doesn't
    // match on it -- POOL_MATCH_FIELDS leaves Size out on purpose, see
    // utils/labelStockProduction.js -- so it's the one field that can
    // legitimately differ between two otherwise-identical facestock reels
    // and is worth its own column rather than living inside the truncated
    // Details cell). Adhesive/Release Liner stay the plain 3 columns.
    function layerHasSizeColumn(layerKey) {
      return LAYER_META[layerKey].pool === "facestock";
    }
    function layerColCount(layerKey) {
      return layerHasSizeColumn(layerKey) ? 4 : 3;
    }

    function layerColumnHtml(layerKey, meta) {
      const sizeHeader = layerHasSizeColumn(layerKey) ? "<th>Size</th>" : "";
      return `
        <div class="raw-layer-col" data-layer="${layerKey}">
          <div class="raw-layer-title">${meta.label}</div>
          <div class="raw-layer-spec">${specSummary(ITEM[meta.specField], layerKey)}</div>
          <div class="ap-table-wrap"><table class="ap-table roll-table raw-layer-table">
            <thead><tr><th class="roll-check-cell"></th><th>Details</th>${sizeHeader}<th>Kg</th></tr></thead>
            <tbody data-body="${layerKey}"><tr><td colspan="${layerColCount(layerKey)}" style="color:#94a3b8; font-style:italic;">Select a machine first</td></tr></tbody>
          </table></div>
        </div>`;
    }

    // Renders (or re-renders) one layer column's rows from its cached reels.
    // Every reel is always selectable -- no quantity gates this anymore (no
    // "Kg to Produce" field: this page only records which reels are allotted
    // to the order, it doesn't laminate a Deckle -- see the doc comment above
    // #rawLayersGrid). Doesn't refetch, so re-renders don't hit the server.
    // layerReelsCache[key] is `null` until a location has actually been
    // fetched for it (distinct from `[]`, fetched-but-empty), so re-renders
    // before a machine is picked don't claim "no reels" when really nothing
    // has been looked up yet.
    function renderLayerRows(layerKey) {
      const tbody = document.querySelector(`#rawLayersGrid tbody[data-body="${layerKey}"]`);
      if (!tbody) return;
      const reels = layerReelsCache[layerKey];
      // Rebuilding the tbody below replaces every checkbox, which would
      // otherwise silently drop whatever was picked -- carry every
      // currently-checked id forward (a layer can hold more than one picked
      // reel at once, e.g. combining two undersized drums onto one order).
      // Before anything's been checked yet (this layer's first render since
      // page load), fall back to whatever was already allotted server-side
      // -- reads both the current `stockIds` array shape and the legacy
      // single `stockId` shape orders assigned before this changed still
      // have saved (see utils/labelStockProduction.js's pickStockIds).
      const checkedNow = Array.from(tbody.querySelectorAll("input[type='checkbox']:checked")).map((el) => el.value);
      const allotted = ALLOTTED_LAYERS[layerKey];
      const previouslyChecked = new Set(
        checkedNow.length ? checkedNow : allotted?.stockIds || (allotted?.stockId ? [allotted.stockId] : []),
      );

      if (!reels) {
        tbody.innerHTML = `<tr><td colspan="${layerColCount(layerKey)}" style="color:#94a3b8; font-style:italic;">Select a machine first</td></tr>`;
        return;
      }
      if (!reels.length) {
        tbody.innerHTML = `<tr><td colspan="${layerColCount(layerKey)}" style="color:#94a3b8; font-style:italic;">No reels in stock at this location</td></tr>`;
        return;
      }

      const sizeColumn = layerHasSizeColumn(layerKey);

      // Checkboxes -- a layer can hold more than one picked reel at once,
      // so every row is independently selectable with no single-select
      // enforcement (unlike a native radio group).
      tbody.innerHTML = reels.map((r) => {
        const checked = previouslyChecked.has(r._id);
        const detail = reelDetail(layerKey, r);
        const sizeCell = sizeColumn ? `<td>${r.size || "—"}</td>` : "";
        return `<tr>` +
          `<td class="roll-check-cell"><input type="checkbox" name="rawLayers[${layerKey}]" value="${r._id}"${checked ? " checked" : ""} /></td>` +
          `<td class="raw-layer-detail-cell" title="${r.rollId} -- ${detail}">${detail}</td>` +
          sizeCell +
          `<td>${r.reelMtrs}</td>` +
        `</tr>`;
      }).join("");
    }

    async function refreshLayerOptions(layerKey, location) {
      const meta = LAYER_META[layerKey];
      const spec = ITEM[meta.specField];
      const type = spec ? spec[meta.typeField] : "";
      const tbody = document.querySelector(`#rawLayersGrid tbody[data-body="${layerKey}"]`);
      if (!tbody) return;

      if (!location) {
        layerReelsCache[layerKey] = null;
        renderLayerRows(layerKey);
        return;
      }
      if (!type) {
        layerReelsCache[layerKey] = [];
        tbody.innerHTML = `<tr><td colspan="${layerColCount(layerKey)}" style="color:#ef4444;">Spec incomplete on this SKU</td></tr>`;
        return;
      }

      try {
        const res = await fetch(`/sachiko/labelstockproduction/raw-stock?layerKey=${encodeURIComponent(layerKey)}&itemId=${encodeURIComponent(ITEM._id)}&location=${encodeURIComponent(location)}&orderId=${encodeURIComponent(ORDER_ID)}`);
        const data = await res.json();
        layerReelsCache[layerKey] = data.reels || [];
      } catch {
        layerReelsCache[layerKey] = [];
      }
      renderLayerRows(layerKey);
    }

    function currentMachineLocation() {
      const machine = ALL_MACHINES.find((m) => String(m._id) === String(machineSelectEl.value));
      return machine?.location?.locationName || "";
    }

    function refreshAllLayerOptions() {
      const location = currentMachineLocation();
      requiredLayerKeys().forEach((key) => refreshLayerOptions(key, location));
    }

    // Checkbox rows are click-to-select on the whole row, matching the Rolls
    // table above. Each layer can hold more than one reel checked at once --
    // there's no single-select enforcement -- so this just toggles whichever
    // row was clicked, same as clicking its checkbox directly.
    document.getElementById("rawLayersGrid").addEventListener("click", (e) => {
      if (e.target.closest("input[type='checkbox']")) return; // browser toggles it natively
      const row = e.target.closest(".raw-layer-table tbody tr");
      const checkbox = row?.querySelector("input[type='checkbox']");
      if (checkbox) checkbox.checked = !checkbox.checked;
    });

    // Build the columns once -- they don't change shape after load, only
    // their reel options do, as the machine changes.
    document.getElementById("rawLayersGrid").innerHTML =
      requiredLayerKeys().map((key) => layerColumnHtml(key, LAYER_META[key])).join("");

    machineSelectEl.addEventListener("change", refreshAllLayerOptions);
    // Covers re-opening an order that already has a machine assigned --
    // Choices.js's setChoiceByValue() (used below to restore ASSIGNED.machineId)
    // isn't guaranteed to fire a "change" event the way a real user pick does,
    // so run this once unconditionally rather than depending on that.
    refreshAllLayerOptions();

    // Submits straight away -- no Kg-to-produce quantity or "some layers
    // unallocated" gate anymore, since this page only records which reels
    // are allotted (see the doc comment above #rawLayersGrid); a partial
    // pick, or none at all, is always a fine thing to submit.
    const assignForm = document.getElementById("assign-form");
    const assignSubmitBtn = document.getElementById("assignSubmitBtn");
    assignSubmitBtn.addEventListener("click", () => assignForm.requestSubmit());
  });
</script>
