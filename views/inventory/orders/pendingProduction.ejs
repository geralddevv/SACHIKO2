<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<style>
  @keyframes detailsPopIn {
    0% { transform: scale(0.96); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  @keyframes popIn {
    0% { transform: scale(0.9); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .tape-details-card {
    position: relative;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 18px 42px rgba(4, 74, 120, 0.14);
    border: none;
    overflow: hidden;
  }
  .details-scroll-area { max-height: calc(100vh - 48px); overflow-y: auto; padding-bottom: 20px; }
  .tape-details-header {
    display: flex; justify-content: space-between; gap: 16px; align-items: flex-start;
    padding: 26px 26px 24px;
    background:
      radial-gradient(circle at top right, rgba(255, 255, 255, 0.16), transparent 34%),
      linear-gradient(135deg, #044a78 0%, #03365a 100%);
    color: #fff;
  }
  .tape-details-header h1 { margin: 0; font-size: 27px; font-weight: 700; letter-spacing: 0.2px; line-height: 1.15; }
  .header-subtitle { margin-top: 10px; font-size: 14px; opacity: 0.92; line-height: 1.5; }
  .header-actions { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .header-action-link {
    display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.14); border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff; text-decoration: none; font-weight: 700; font-size: 13px; letter-spacing: 0.2px;
    backdrop-filter: blur(8px); transition: background 0.18s ease;
  }
  .tape-details-body { padding: 20px 26px; }
  .section-title { margin: 0 0 14px; color: #044a78; font-size: 17px; font-weight: 700; }
  .diff-table { width: 100%; border-collapse: collapse; border: 1px solid #e6eaf2; border-radius: 12px; overflow: hidden; }
  .diff-table th, .diff-table td { padding: 10px 12px; border-bottom: 1px solid #e6eaf2; text-align: left; font-size: 13px; vertical-align: top; }
  .diff-table .key-col { width: 32%; color: #5a6586; font-weight: 600; }
  .diff-table .resolved { font-weight: 700; color: #1f2a44; }
  /* The Live Status dialog's two logs are laid out on one grid
     (SETTING_COLGROUP / PROD_COLGROUP), so each Job Setting Log heading sits
     over its Production Log counterpart -- Start Time, End Time and the two
     right-hand columns line up exactly. Fixed layout is what makes the widths
     hold; below 860px the tables scroll sideways rather than squash, and a
     long id breaks inside its own cell instead of running into the next one.
     An empty value reads "None", never a dash. */
  .dlg-log-table { table-layout: fixed; min-width: 860px; }
  /* Separate borders, so the table's rounded corners are real (a collapsed
     border ignores border-radius and squares off under the clip). The last
     visible row then drops its own bottom line -- the table's border is the
     frame. */
  .dlg-log-table { border-collapse: separate; border-spacing: 0; }
  .dlg-log-table tbody tr:last-child td,
  .dlg-log-table tbody tr.dlg-status-row:has(+ tr.dlg-detail-row[hidden]) td { border-bottom: 0; }
  .dlg-log-table td { overflow-wrap: anywhere; }
  .dlg-log-table .dlg-none { color: #94a3b8; font-weight: 500; }
  .dlg-log-table .dlg-flag { color: #b45309; font-weight: 700; }
  /* Between two Production Log rows: the idle time from one deckle's End to
     the next one's Start. */
  .dlg-log-table tr.dlg-gap-row td { padding: 4px 12px; font-size: 11.5px; font-weight: 700; color: #c2410c; background: #fff7ed; }
  /* Current Status, the dialog's first section: where the job is now, as one
     row that looks exactly like a Production Log row -- same table, same
     plain cells, no tint. All that marks it as something to open is a small
     chevron at its right end (and a faint highlight under the pointer); the
     whole row opens the details underneath it (toggleLiveDetails). Its
     heading carries the operator app's chip on the right. */
  .dlg-section-head { display: flex; align-items: center; justify-content: space-between; gap: 10px 16px; flex-wrap: wrap; margin: 0 0 14px; }
  .dlg-section-head .section-title { margin: 0; }
  .dlg-status-wrap { overflow-x: auto; margin-bottom: 26px; }
  .dlg-device {
    display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;
    border: 1px solid; font-size: 12px; font-weight: 600; line-height: 1.4; white-space: nowrap;
  }
  .dlg-device::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .dlg-device.is-online { color: #15803d; background: #f0fdf4; border-color: #bbf7d0; }
  .dlg-device.is-stale { color: #a16207; background: #fefce8; border-color: #fde68a; }
  .dlg-log-table tr.dlg-status-row { cursor: pointer; }
  .dlg-log-table tr.dlg-status-row:hover td { background: #f8fafc; }
  .dlg-log-table tr.dlg-status-row.is-open td { border-bottom-color: transparent; }
  .dlg-status-text { font-weight: 600; color: #1f2a44; }
  .dlg-late { color: #b91c1c; font-weight: 700; }
  .dlg-sub { display: block; margin-top: 2px; font-size: 11.5px; }
  .dlg-badge {
    display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;
    border: 1px solid currentColor; background: #fff; white-space: nowrap;
    font-size: 12px; font-weight: 700; line-height: 1.4;
  }
  /* The row's last cell holds its value on the left and the chevron on the
     right: a bare icon -- no border, no fill -- in the logs' own muted grey,
     blue under the pointer, turned over while the details are open. It is a
     button only so the keyboard can reach it. */
  .dlg-row-end { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .dlg-row-end > :first-child { min-width: 0; }
  .dlg-toggle {
    flex-shrink: 0; align-self: center; display: inline-flex; align-items: center; justify-content: center;
    padding: 2px 4px; margin: -2px -4px -2px 0; border: 0; border-radius: 4px; background: none;
    color: #94a3b8; cursor: pointer; transition: color 0.15s ease;
  }
  .dlg-toggle i { font-size: 12px; transition: transform 0.2s ease; }
  .dlg-toggle[aria-expanded="true"] i { transform: rotate(180deg); }
  .dlg-status-row:hover .dlg-toggle,
  .dlg-toggle[aria-expanded="true"] { color: #044a78; }
  .dlg-toggle:focus-visible { outline: 2px solid #044a78; outline-offset: 1px; }
  @media (prefers-reduced-motion: reduce) {
    .dlg-toggle i { transition: none; }
  }
  .dlg-badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .dlg-badge.is-running, .dlg-badge.is-made { color: #15803d; }
  .dlg-badge.is-overdue { color: #b91c1c; }
  .dlg-badge.is-setting { color: #a16207; }
  .dlg-badge.is-idle { color: #c2410c; }
  .dlg-badge.is-started { color: #1d4ed8; }
  .dlg-badge.is-paused { color: #475569; }
  /* A deckle on the machine: its badge's dot blinks, like the Live cell. */
  @keyframes dlgDotBlink { 50% { opacity: 0.2; } }
  .dlg-badge.is-running::before, .dlg-badge.is-overdue::before { animation: dlgDotBlink 1.2s step-end infinite; }
  @media (prefers-reduced-motion: reduce) {
    .dlg-badge.is-running::before, .dlg-badge.is-overdue::before { animation: none; }
  }
  /* The details the status row opens: label over value, as many across as
     fit. */
  .dlg-log-table tr.dlg-detail-row td { padding: 0; background: #fbfdff; }
  /* Hairlines between the cells only: each cell draws its top and left edge,
     pulled 1px out so neighbours share one line; the overflow clips those
     edges, and the table's own border frames the whole. */
  .dlg-facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0; margin: 0; overflow: hidden; border-top: 1px solid #e2e8f0; }
  .dlg-facts > div { min-width: 0; margin: -1px 0 0 -1px; padding: 10px 16px; border-top: 1px solid #e2e8f0; border-left: 1px solid #e2e8f0; }
  .dlg-facts dt { margin: 0 0 2px; font-size: 11.5px; font-weight: 600; color: #64748b; }
  .dlg-facts dd { margin: 0; font-size: 12.5px; font-weight: 600; color: #1f2a44; line-height: 1.45; }

  .btn-action {
    height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
    font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
  }
  .btn-action:hover { opacity: 0.85; }
  #custom-dialog-no:hover { background: #f3f4f6; }
  #custom-dialog-yes:hover { opacity: 0.9; }

  /* The dialogs scroll with the app's own scrollbar -- the brand-blue thumb
     on a light track that the tables use (tableDisp.css's
     ".tabulator .tabulator-tableholder", common.css's .ap-table-wrap) -- not
     the browser default: the body and the log tables that scroll sideways
     inside it alike. The same declarations as those rules, Firefox block
     included, so the dialog's bar renders exactly like the table's behind it
     in every browser. */
  .details-scroll-area::-webkit-scrollbar, .dlg-scroll-x::-webkit-scrollbar { width: 10px; height: 10px; }
  .details-scroll-area::-webkit-scrollbar-track, .dlg-scroll-x::-webkit-scrollbar-track { background: #f0f2f5; }
  .details-scroll-area::-webkit-scrollbar-thumb, .dlg-scroll-x::-webkit-scrollbar-thumb { background: #044a78; border-radius: 6px; }
  .details-scroll-area::-webkit-scrollbar-thumb:hover, .dlg-scroll-x::-webkit-scrollbar-thumb:hover { background: #044a78; }
  .details-scroll-area::-webkit-scrollbar-corner, .dlg-scroll-x::-webkit-scrollbar-corner { background: #f0f2f5; }
  /* Live Production Status: the header stays put and only the body scrolls,
     so its scrollbar starts under the header and stops short of the card's
     rounded bottom corners instead of running the full height. */
  .details-scroll-area.is-pinned-head { display: flex; flex-direction: column; overflow: hidden; padding-bottom: 0; }
  .details-scroll-area.is-pinned-head > .tape-details-header { flex-shrink: 0; }
  .details-scroll-area.is-pinned-head > .tape-details-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
  .is-pinned-head > .tape-details-body::-webkit-scrollbar { width: 10px; height: 10px; }
  .is-pinned-head > .tape-details-body::-webkit-scrollbar-track { background: #f0f2f5; margin: 8px 0; border-radius: 6px; }
  .is-pinned-head > .tape-details-body::-webkit-scrollbar-thumb { background: #044a78; border-radius: 6px; }
  .is-pinned-head > .tape-details-body { scrollbar-width: thin; scrollbar-color: #044a78 #f0f2f5; }
  /* Firefox */
  .details-scroll-area, .dlg-scroll-x {
    scrollbar-width: thin;
    scrollbar-color: #044a78 #f0f2f5;
  }

  /* ----- WIP: Deckles / Finished / Live / Target / Status / Estimate -----
     One shape for every one of them: a figure on top, at most one quiet line
     under it. The columns speak in durations only -- times of day live in
     the Live Status dialog, which any of these cells opens. */
  .wip-cell {
    display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 3px;
    width: 100%; padding: 5px 2px; border: none; background: transparent; cursor: pointer;
    font: inherit; font-size: 12.5px; line-height: 1.25; color: #0f172a; text-align: left; white-space: nowrap;
  }
  /* Every one of these cells opens the Live Status dialog, so each carries
     one underlined headline (.wip-link) all the time -- that is what says
     "click here" -- and the underline firms up on hover. */
  .wip-cell .wip-link {
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px;
    text-decoration-color: currentColor;
  }
  .wip-cell:hover .wip-link { text-decoration-thickness: 2px; }
  .wip-line { display: flex; align-items: center; gap: 6px; }
  .wip-main { font-size: 13px; font-weight: 600; color: #0f172a; font-variant-numeric: tabular-nums; }
  .wip-sub { font-size: 11.5px; font-weight: 500; color: #64748b; font-variant-numeric: tabular-nums; }
  .wip-none { font-size: 12.5px; font-weight: 500; color: #94a3b8; }
  /* Live: what the machine is doing, as a dot and a word in its colour. */
  .wip-phase { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; }
  .wip-phase::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .wip-phase.is-green { color: #15803d; }
  .wip-phase.is-amber { color: #b45309; }
  .wip-phase.is-blue { color: #1d4ed8; }
  .wip-phase.is-orange { color: #c2410c; }
  .wip-phase.is-slate { color: #475569; }
  .wip-phase.is-pulse::before { box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2); }
  /* Deckles: made against planned. */
  .wip-bar { width: 72px; height: 4px; border-radius: 999px; background: #e2e8f0; overflow: hidden; flex-shrink: 0; }
  .wip-bar > span { display: block; height: 100%; border-radius: inherit; background: #16a34a; }
  /* Status, and the Facestock / Adhesive / Release allotment: a soft pill. */
  .wip-pill {
    display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px 2px 8px; border-radius: 999px;
    border: 1px solid transparent; font-size: 12px; font-weight: 600; line-height: 1.5; white-space: nowrap;
  }
  .wip-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .wip-pill.is-red { color: #b91c1c; background: #fef2f2; border-color: #fecaca; }
  .wip-pill.is-amber { color: #a16207; background: #fefce8; border-color: #fde68a; }
  .wip-pill.is-green { color: #15803d; background: #f0fdf4; border-color: #bbf7d0; }
  .wip-pill.is-blue { color: #1d4ed8; background: #eff6ff; border-color: #bfdbfe; }

  /* ----- The Live cell's state: running (green) or past its ETA (red) -----
     Both blink, on the same 1.2 s step-end rhythm, so a running row and an
     overdue one differ by colour alone. One function owns the cell's classes
     and its inline `animation` (wipSetLiveCell), because the fill, the green
     blink and the red blink all live in that one property -- two helpers
     setting it separately would wipe out each other's timing. Every
     animation is started at the point the wall clock is at, so the cells
     Tabulator rebuilds on each redraw land back in step. No cell rule in
     tableDisp.css paints a background, so the row's own colour (hover, an
     advance row's blue) shows wherever these don't. */

  /* RUNNING: the cell blinks green -- pale green / clear -- for as long as a
     deckle is on the machine and not past its ETA. Reduced motion holds the
     pale green still. */
  @keyframes wipLiveBlink {
    0%, 100% { background-color: #dcfce7; }
    50% { background-color: transparent; }
  }
  .tabulator .tabulator-row .tabulator-cell.wip-running { background-color: #dcfce7; }
  /* ...and, when the deckle has an ETA, its progress IS the cell's
     background: a stronger green fills it from the left, Start to ETA, with a
     dark leading edge -- stronger than the blink's pale green, so the fill
     reads at either step of the blink. Both layers share one background-size
     (a single value repeats for every layer), so the one animation moves the
     fill and its edge together; the inline background-size under it is the
     same figure held still, which is all reduced motion gets (redrawn every
     10 s). */
  @keyframes wipLoadFill {
    from { background-size: 0% 100%; }
    to { background-size: 100% 100%; }
  }
  .tabulator .tabulator-row .tabulator-cell.wip-loading {
    background-image:
      linear-gradient(to left, #15803d 0, #15803d 2px, transparent 2px),
      linear-gradient(90deg, #86efac, #4ade80);
    background-repeat: no-repeat;
    background-origin: border-box;
    background-position: left center;
  }
  /* Text that sits on the fill keeps its contrast. */
  .wip-running .wip-sub { color: #334155; }
  .wip-running .wip-phase.is-green { color: #14532d; }

  /* PAST ITS ETA: the cell blinks red. tableDisp.css sets the cell's colour
     with !important, which an animation can't override -- so the animation
     moves two registered custom properties and the !important declarations
     read them. step-end makes it a hard blink: red/white, then pale red/dark
     red, never a muddy in-between where the text would fade into the
     background. Reduced motion holds solid red (the properties' initial
     values). */
  @property --wip-alarm-bg { syntax: "<color>"; inherits: false; initial-value: #ef4444; }
  @property --wip-alarm-ink { syntax: "<color>"; inherits: false; initial-value: #ffffff; }
  @keyframes wipAlarmBlink {
    0%, 100% { --wip-alarm-bg: #ef4444; --wip-alarm-ink: #ffffff; }
    50% { --wip-alarm-bg: #fee2e2; --wip-alarm-ink: #991b1b; }
  }
  .tabulator .tabulator-row .tabulator-cell.wip-overdue {
    background-color: var(--wip-alarm-bg) !important;
    color: var(--wip-alarm-ink) !important;
  }
  .wip-overdue .wip-cell, .wip-overdue .wip-cell * { color: inherit !important; }
  .wip-overdue .wip-phase::before { background: currentColor !important; box-shadow: none !important; }

  /* ON HOLD: the operator paused the job in the app. Nothing moves -- no
     blink, no fill running on -- on a slate tint, and a deckle that was on the
     machine keeps the fill it had reached, gone grey, so how far it got is
     still there to read. The fill's width is set inline (wipSetLiveCell). */
  .tabulator .tabulator-row .tabulator-cell.wip-paused {
    background-color: #f1f5f9;
    background-image:
      linear-gradient(to left, #64748b 0, #64748b 2px, transparent 2px),
      linear-gradient(90deg, #e2e8f0, #cbd5e1);
    background-repeat: no-repeat;
    background-origin: border-box;
    background-position: left center;
  }
  .wip-paused .wip-sub { color: #334155; }

  /* The animations are set inline (wipSetLiveCell), so only !important
     stops them. */
  @media (prefers-reduced-motion: reduce) {
    .tabulator .tabulator-row .tabulator-cell.wip-running,
    .tabulator .tabulator-row .tabulator-cell.wip-overdue { animation: none !important; }
  }
</style>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <div class="indi-head">
    <h1><%= initialTab === 'wip' ? 'Work In Progress' : 'Pending Production' %></h1>
    <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
      <a
        href="/app/sales/order"
        style="padding: 6px 14px; background: #044a78; color: white; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;"
        onmouseover="this.style.opacity = '0.85'" onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-plus"></i><span>New Label Stock Order</span>
      </a>
      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span><i class="fa-solid fa-file-arrow-down"></i><span class="download-typo">Download</span></span>
          <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
        </button>
        <div class="download-selector__menu" id="downloads">
          <span class="download-selector__option" id="download-xlsx">
            <i class="fas fa-file-excel download-selector__option-icon"></i><span>Excel</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <% if (initialTab === 'wip') { %>
    <div id="wip-table" class="tabulator tabulator-modern"></div>
  <% } else { %>
    <div id="master-table" class="tabulator tabulator-modern"></div>
  <% } %>
</div>

<!-- Send back to Pending confirmation dialog -->
<div id="custom-confirm-dialog" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 9999; justify-content: center; align-items: center;">
  <div style="background: white; border-radius: 8px; width: 440px; max-width: 90%; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2); overflow: hidden; animation: popIn 0.2s ease-out;">
    <div style="padding: 25px 20px; text-align: center">
      <p id="custom-dialog-message" style="margin: 0; color: #333; font-size: 16px; line-height: 1.5">Are you sure?</p>
    </div>
    <div style="padding: 15px 20px; background: #f9fafb; display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #e5e7eb;">
      <button id="custom-dialog-no" onclick="closeCustomDialog()" style="padding: 8px 16px; border: 1px solid #d1d5db; background: white; color: #374151; border-radius: 6px; cursor: pointer; font-weight: 500;">Go Back</button>
      <button id="custom-dialog-yes" style="padding: 8px 16px; border: none; background: #ef4444; color: white; border-radius: 6px; cursor: pointer; font-weight: 500;">Yes, Send Back</button>
    </div>
  </div>
</div>

<!-- Details dialog -->
<div id="pending-order-details-dialog" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.54); z-index: 10000; justify-content: center; align-items: center; padding: 24px; backdrop-filter: blur(6px);">
  <div id="pending-order-details-body" style="width: min(1180px, 100%); animation: detailsPopIn 0.2s ease-out"></div>
</div>

<!-- Live Status production-log dialog -->
<div id="live-status-dialog" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.54); z-index: 10001; justify-content: center; align-items: center; padding: 24px; backdrop-filter: blur(6px);">
  <div id="live-status-dialog-body" style="width: min(1120px, 100%); animation: detailsPopIn 0.2s ease-out"></div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script id="order-data" type="application/json">
  <%- safeJson(orders || []) %>
</script>
<script id="wip-order-data" type="application/json">
  <%- safeJson(wipOrders || []) %>
</script>

<script>
  const orderData = JSON.parse(document.getElementById("order-data").textContent);
  const wipData = JSON.parse(document.getElementById("wip-order-data").textContent);
  const allOrderData = orderData.concat(wipData);
  // Pending vs WIP are separate side-nav destinations (?tab=wip) now, not
  // in-page tabs -- only the table for the page actually rendered gets built.
  const INITIAL_TAB = "<%= initialTab %>";

  /* ----- Details dialog ----- */
  window.viewProduction = function (orderId) {
    const order = allOrderData.find((row) => String(row._id) === String(orderId));
    if (!order) return;

    const qty = Number(order.quantity) || 0;
    const produced = Number(order.balance != null ? qty - order.balance : 0) || 0;
    const remaining = order.balance ?? qty;

    document.getElementById("pending-order-details-body").innerHTML = `
      <div class="tape-details-card">
        <div class="details-scroll-area">
          <div class="tape-details-header">
            <div class="header-copy">
              <h1>${order.productCode || "Label Stock"}</h1>
              <div class="header-subtitle">${order.clientName || "N/A"}${order.userName ? " | " + order.userName : ""}</div>
            </div>
            <div class="header-actions">
              <span class="header-action-link" style="pointer-events: none;"><i class="fa-solid fa-file-invoice"></i> PO: ${order.poNumber || "N/A"}</span>
              <button onclick="closeOrderDetailsDialog()" class="header-action-link" style="border: none; cursor: pointer;"><i class="fa-solid fa-xmark"></i></button>
            </div>
          </div>
          <div class="tape-details-body">
            <h3 class="section-title">Production Details</h3>
            <table class="diff-table">
              <tbody>
                <tr><td class="key-col">Client</td><td class="resolved">${order.clientName || "N/A"}</td></tr>
                <tr><td class="key-col">User</td><td class="resolved">${order.userName || "N/A"}</td></tr>
                <tr><td class="key-col">Product Code</td><td class="resolved">${order.productCode || "N/A"}</td></tr>
                <tr><td class="key-col">Paper Size</td><td class="resolved">${order.paperSize || "N/A"}</td></tr>
                <tr><td class="key-col">No. of Rolls</td><td class="resolved">${order.noOfRolls || "N/A"}</td></tr>
                <tr><td class="key-col">Order Quantity</td><td class="resolved">${qty}</td></tr>
                <tr><td class="key-col">Produced</td><td class="resolved">${produced}</td></tr>
                <tr><td class="key-col">Remaining</td><td class="resolved">${remaining}</td></tr>
                <tr><td class="key-col">PO Number</td><td class="resolved">${order.poNumber || "N/A"}</td></tr>
                <tr><td class="key-col">Estimated Delivery</td><td class="resolved">${order.estimatedDate ? new Date(order.estimatedDate).toLocaleDateString("en-IN") : "N/A"}</td></tr>
                <tr><td class="key-col">Remarks</td><td class="resolved">${order.remarks || "N/A"}</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    `;
    document.getElementById("pending-order-details-dialog").style.display = "flex";
  };
  window.closeOrderDetailsDialog = () => (document.getElementById("pending-order-details-dialog").style.display = "none");

  /* ----- WIP live-status log ----- */
  const liveStatusEscape = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
  })[char]);
  // A log cell's value, or "None" (muted) when there isn't one -- never a dash.
  const liveStatusValue = (value) => (value === undefined || value === null || String(value).trim() === ""
    ? `<span class="dlg-none">None</span>`
    : liveStatusEscape(value));
  const liveStatusMtrs = (value) => Number(value).toLocaleString("en-IN", { maximumFractionDigits: 2 });
  // A timestamp written the way the job card punches its times ("1:23 PM"),
  // so a fallback time reads the same as the punched ones around it.
  const liveStatusClock = (value) => {
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "";
    const h = d.getHours();
    return `${h % 12 || 12}:${String(d.getMinutes()).padStart(2, "0")} ${h >= 12 ? "PM" : "AM"}`;
  };
  // The same clock, with the day in front when it isn't today -- a job runs
  // through the night, and a bare "1:05 AM" would then read as the wrong day.
  const wipClock = (value) => {
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "";
    const time = liveStatusClock(d);
    return d.toDateString() === new Date().toDateString()
      ? time
      : `${d.toLocaleDateString("en-IN", { day: "numeric", month: "short" })}, ${time}`;
  };
  // An ETA to the NEAREST minute (1:07 PM + 66.7 min reads ~2:14, not 2:13).
  // Punched times stay cut to the minute, as the job card punches them.
  const wipEta = (ms) => wipClock(Math.round(ms / 60000) * 60000);
  // 67 -> "67 min", 267 -> "4 h 27 min"
  const wipDuration = (mins) => {
    const m = Math.max(Math.round(Number(mins) || 0), 0);
    if (m < 60) return `${m} min`;
    const h = Math.floor(m / 60);
    return m % 60 ? `${h} h ${m % 60} min` : `${h} h`;
  };
  // How far past its ETA the running deckle is, in minutes -- null until it
  // is a whole minute past (so it never reads "0 min over"). Worked out
  // against this browser's clock each time the row is drawn (the poll redraws
  // every row), so it moves on its own.
  const wipOverMins = (etaAt, now = Date.now()) => (etaAt != null && now - etaAt >= 60000 ? (now - etaAt) / 60000 : null);

  // The operator's "why was it late?" remark for the Deckle on the machine now
  // (entered in the app when it first ran over; optional, so often absent).
  const wipRemarkFor = (progress, cur) => (cur
    ? (progress?.overtimeRemarks || []).find((r) => r.runStartedAt != null && r.runStartedAt === cur.startedAt) || null
    : null);
  const wipShort = (text, n = 60) => (String(text).length > n ? `${String(text).slice(0, n - 1)}…` : String(text));
  // Every remark on this job, for the status dialog.
  const wipRemarksSection = (progress) => {
    const list = Array.isArray(progress?.overtimeRemarks) ? progress.overtimeRemarks : [];
    if (!list.length) return "";
    const rows = list.map((r) => `<tr><td>${r.deckleIndex ?? "—"}</td><td>${r.runStartedAt ? wipClock(r.runStartedAt) : "—"}</td><td>${r.at ? wipClock(r.at) : "—"}</td><td>${liveStatusEscape(r.byName || "—")}</td><td style="white-space:pre-wrap; word-break:break-word;">${liveStatusEscape(r.remark)}</td></tr>`).join("");
    return `<h3 class="section-title" style="margin-top:22px;">Delay Remarks</h3><div class="dlg-scroll-x" style="overflow-x:auto;"><table class="diff-table dlg-log-table"><colgroup><col style="width:8%"><col style="width:18%"><col style="width:18%"><col style="width:18%"><col style="width:38%"></colgroup><thead><tr><th>Deckle</th><th>Started</th><th>Reported</th><th>By</th><th>Why it ran late</th></tr></thead><tbody>${rows}</tbody></table></div>`;
  };
  const wipPlural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
  // The time a job's figures are read at: now -- or, for a job on hold, the
  // moment it went on hold (runPlan.clockAt, utils/productionEta.js), so its
  // deckle stops filling, nothing turns overdue and Status / Estimate stay
  // where they were until it resumes.
  const wipNow = (plan) => plan?.clockAt ?? Date.now();
  // Minutes from `at` up to the job's clock, less `heldMs` it spent on hold in
  // between (a hold is not idle or setting time).
  const wipElapsedMins = (plan, at, heldMs = 0) => Math.max(wipNow(plan) - at - (heldMs || 0), 0) / 60000;
  // How far the deckle on the machine has got, 0-100: from its Start moved
  // on by any time on hold (runFromAt) to its ETA, at the job's clock.
  const wipDecklePct = (plan, cur) => {
    const from = cur.runFromAt ?? cur.startedAt;
    return Math.min(Math.max(Math.floor(((wipNow(plan) - from) / (cur.etaAt - from)) * 100), 0), 100);
  };
  // What a job on hold was doing when it stopped -- the line under "Paused".
  const wipHeldWhat = (plan) => {
    const base = plan.basePhase || "started";
    const cur = plan.current;
    if (base === "running" && cur) return `Deckle ${cur.index}${cur.etaAt != null ? ` · ${wipDecklePct(plan, cur)}%` : ""}`;
    if (base === "setting") return "in Job Setting";
    if (base === "gap") return `after deckle ${plan.done}`;
    if (base === "made") return "all made";
    return "no deckle yet";
  };
  // When the whole job should be done. The server counts it from the running
  // deckle's ETA; once that deckle overruns, the deckles after it can't start
  // before now, so it is never earlier than now + their running time.
  const wipJobEta = (plan) => (plan.jobEtaAt == null
    ? null
    : Math.max(plan.jobEtaAt, wipNow(plan) + plan.afterCurrent * plan.minsPerDeckle * 60000));
  // A Finished / Live / Target / Status / Estimate cell: its lines stacked,
  // the whole cell opening the job's Live Production Status dialog.
  const wipCellBtn = (orderId, title, inner) => `<button type="button" class="wip-cell" onclick="openLiveStatus('${orderId}')" title="${liveStatusEscape(title)}">${inner}</button>`;
  // Which deckle is on the machine, against the plan. An operator can run one
  // beyond the planned count (all of them made, and another started) -- that
  // reads "Deckle 3 · 2 planned", never "Deckle 3 of 2".
  const wipExtraDeckle = (plan, cur) => !!(plan.target && cur.index > plan.target);
  const wipDeckleLabel = (plan, cur) => (wipExtraDeckle(plan, cur)
    ? `Deckle ${cur.index} · ${plan.target} planned`
    : `Deckle ${cur.index}${plan.target ? ` of ${plan.target}` : ""}`);
  // A thin bar, `frac` of it filled (0..1).
  const wipBar = (frac, title) => `<span class="wip-bar" title="${liveStatusEscape(title)}"><span style="width:${Math.round(Math.min(Math.max(frac, 0), 1) * 100)}%;"></span></span>`;

  // The Live cell's state -- "running" (blinks green; with an ETA, `fill`,
  // the green fill too), "overdue" (blinks red), "paused" (still, slate, the
  // fill held where it had got to at `fill.at`) or "" (none of them) -- and
  // the one place its classes and inline `animation` are set (see the CSS).
  // Every animation starts at the point the wall clock is at: the blinks at
  // their phase of WIP_BLINK_MS, the fill at the time gone since the Start.
  // A cell already in the same state (the poll updating it in place) is left
  // alone: re-setting a running animation's delay would count the time since
  // it began twice. A new deckle, or a change of state, starts it afresh.
  const WIP_BLINK_MS = 1200;
  const wipSetLiveCell = (cell, mode, fill) => {
    const el = cell.getElement();
    const hasFill = !!(fill && fill.startedAt != null && fill.durMs > 0);
    const filling = mode === "running" && hasFill;
    const held = mode === "paused";
    const at = held && fill?.at != null ? fill.at : Date.now();
    const elapsed = hasFill ? Math.min(Math.max(at - fill.startedAt, 0), fill.durMs) : 0;
    // The fill held still -- all that reduced motion gets, redrawn every 10 s,
    // and all a job on hold gets.
    el.style.backgroundSize = filling || (held && hasFill) ? `${(elapsed / fill.durMs) * 100}% 100%` : held ? "0% 100%" : "";
    const key = mode === "running" ? `running|${filling ? `${fill.startedAt}|${fill.durMs}` : "-"}` : mode;
    if ((el.dataset.wipLive || "") === key) return;
    el.classList.toggle("wip-running", mode === "running");
    el.classList.toggle("wip-loading", !!filling);
    el.classList.toggle("wip-overdue", mode === "overdue");
    el.classList.toggle("wip-paused", held);
    el.style.animation = "none";
    void el.offsetWidth; // let the "none" land, so what follows starts afresh
    const blink = (name) => `${name} ${WIP_BLINK_MS}ms step-end -${Date.now() % WIP_BLINK_MS}ms infinite`;
    if (mode === "overdue") {
      el.style.animation = blink("wipAlarmBlink");
    } else if (mode === "running") {
      el.style.animation = [
        filling ? `wipLoadFill ${Math.round(fill.durMs)}ms linear -${Math.round(elapsed)}ms 1 forwards` : "",
        blink("wipLiveBlink"),
      ].filter(Boolean).join(", ");
    } else {
      el.style.animation = "";
    }
    if (key) el.dataset.wipLive = key;
    else delete el.dataset.wipLive;
  };

  // ---- Target / Status / Estimate -- durations only, never times of day ----
  // Target   = how long the job takes run nonstop at speed: the deckles this
  //            run owes x one deckle's running time (runPlan.targetDeckles /
  //            minsPerDeckle, utils/productionEta.js).
  // Status   = the delay so far: when the job will finish counted from NOW
  //            (so every setting, gap and overrun is already in it) against
  //            when Target said it would (runPlan.targetAt) --
  //              a deckle running   -> the job ETA (wipJobEta)
  //              setting/gap/played -> now + the deckles still to make
  //              all made           -> when the last one came off (actual)
  //            Delayed / Ahead, or On time within WIP_ON_TIME_MINS.
  // Estimate = how long the job will have taken start to finish, i.e.
  //            Target + that delay. It is BUILT as that sum in whole minutes,
  //            so the three figures on a row always add up exactly as shown.
  // A job on hold reads all of this at the moment it went on hold (wipNow),
  // and the Target it is measured against has every earlier hold taken out
  // already (runPlan.targetAt) -- so a break is never counted as a delay.
  const WIP_ON_TIME_MINS = 5;
  const wipOutlook = (plan) => {
    if (!plan) return null;
    const now = wipNow(plan);
    const targetMins = plan.targetDeckles != null && plan.minsPerDeckle != null
      ? Math.round(plan.targetDeckles * plan.minsPerDeckle)
      : null;
    let finishAt = null;
    let finished = false;
    // What the job was doing, on hold or not: one paused with every deckle
    // already made is still finished.
    if ((plan.basePhase || plan.phase) === "made") {
      if (plan.lastDoneAt != null) {
        finishAt = plan.lastDoneAt;
        finished = true;
      }
    } else if (plan.current) {
      finishAt = wipJobEta(plan);
    } else if (plan.remainingMins != null) {
      finishAt = now + plan.remainingMins * 60000;
    }
    const delayMins = finishAt != null && plan.targetAt != null ? Math.round((finishAt - plan.targetAt) / 60000) : null;
    const estMins = targetMins != null && delayMins != null ? Math.max(targetMins + delayMins, 0) : null;
    const state = delayMins == null ? null
      : delayMins >= WIP_ON_TIME_MINS ? "late"
      : delayMins <= -WIP_ON_TIME_MINS ? "early"
      : "ontime";
    const leftMins = !finished && finishAt != null ? Math.max((finishAt - now) / 60000, 0) : null;
    return { targetMins, delayMins, estMins, state, finished, leftMins };
  };
  const WIP_STATE = {
    late: { cls: "is-red", label: "Delayed" },
    early: { cls: "is-blue", label: "Ahead" },
    ontime: { cls: "is-green", label: "On time" },
  };
  // "17 min late" / "23 min early" / "within 5 min"
  const wipDelayText = (look) => (look.state === "late"
    ? `${wipDuration(look.delayMins)} late`
    : look.state === "early"
      ? `${wipDuration(-look.delayMins)} early`
      : `within ${WIP_ON_TIME_MINS} min`);
  const wipStatusPill = (look) => `<span class="wip-pill ${WIP_STATE[look.state].cls}">${WIP_STATE[look.state].label}</span>`;
  // Time still to go. An overrun deckle puts the finish at now (it can't be
  // done before now), which would read "0 min left".
  const wipLeftText = (look) => (look.leftMins >= 1 ? `${wipDuration(look.leftMins)} left` : "due now");
  // Why a job has no Target / no Status or Estimate, in the words of what is
  // missing. Target needs only the deckle length and count; the other two
  // also need the moment the job was played.
  const wipNoTargetReason = (plan) => (plan.minsPerDeckle == null ? "Deckle R.M. not set"
    : plan.target == null ? "Deckle Qty not set"
    : "");
  const wipNoEstimateReason = (plan) => wipNoTargetReason(plan) || (plan.jobStartedAt == null ? "Start not recorded" : "");

  window.openLiveStatus = function (orderId) {
    const order = wipTable?.getRow(String(orderId))?.getData()
      || wipData.find((row) => String(row._id) === String(orderId));
    const progress = order?.liveUpdate;
    if (!order || !progress) return;

    const settings = Array.isArray(progress.settings) ? progress.settings : [];
    const production = Array.isArray(progress.production) ? progress.production : [];
    // The two logs on one grid (see .dlg-log-table):
    //   Job Setting Log  # | Mtrs                        | Start Time | End Time | Counter       | Status
    //   Production Log   # | Deckle ID | Made     | Date | Start Time | End Time | Face Joint | Release Joint
    // A setting row has no id or date of its own, so its Mtrs takes the width
    // of Date + Deckle ID + Made (10 + 22 + 9 = 41) and everything to its
    // right lines up. The widths below must add to 100 and keep those sums.
    const SETTING_COLGROUP = `<colgroup><col style="width:4%"><col style="width:41%"><col style="width:10%"><col style="width:11%"><col style="width:17%"><col style="width:17%"></colgroup>`;
    const PROD_COLGROUP = `<colgroup><col style="width:4%"><col style="width:22%"><col style="width:9%"><col style="width:10%"><col style="width:10%"><col style="width:11%"><col style="width:17%"><col style="width:17%"></colgroup>`;
    const PROD_COLS = 8;
    const none = `<span class="dlg-none">None</span>`;
    // A setting row is a run off the machine's counter, so its Mtrs is stop
    // reading - start reading (setup wastage -- nothing is "made"), shown only
    // once both readings are in; Counter keeps the two readings.
    const settingRun = (row) => (
      row.startMtrs != null && row.stopMtrs != null && Number(row.stopMtrs) >= Number(row.startMtrs)
        ? `${liveStatusMtrs(Math.round((Number(row.stopMtrs) - Number(row.startMtrs)) * 100) / 100)} mtrs`
        : none
    );
    // "0 → 35 mtrs" once both readings are in; before that the one there is
    // ("From 0 mtrs" / "To 35 mtrs"), or None.
    const settingCounter = (row) => {
      const start = row.startMtrs != null ? liveStatusMtrs(row.startMtrs) : null;
      const stop = row.stopMtrs != null ? liveStatusMtrs(row.stopMtrs) : null;
      if (start == null && stop == null) return none;
      if (start != null && stop != null) return `${start} → ${stop} mtrs`;
      return start != null ? `From ${start} mtrs` : `To ${stop} mtrs`;
    };
    const settingRows = settings.length
      ? settings.map((row) => `
          <tr><td>${row.index}</td>
          <td style="font-weight:700;">${settingRun(row)}</td>
          <td>${liveStatusValue(row.startTime)}</td><td>${liveStatusValue(row.stopTime)}</td>
          <td>${settingCounter(row)}</td>
          <td><span style="font-weight:700; color:${row.completed ? "#16a34a" : "#a16207"};">${row.completed ? "Completed" : "In progress"}</span></td></tr>`).join("")
      : `<tr><td colspan="6" style="color:#64748b; text-align:center;">No Job Setting entry recorded.</td></tr>`;
    // A row the operator has produced but not yet saved onto a Job Card comes
    // from the Deckle itself (MaterialStock.producedFor), and reads exactly
    // like a filed one -- no badge: made is made. Its Start / End and its
    // joints are the ones punched on the card row, stored on the Deckle at
    // Stop. A Deckle made before the times were stored has neither, and its
    // producedAt IS the Stop punch, so it stands in for the End time only --
    // the start of that row is not known anywhere.
    //
    // No Roll ID column: what a row makes is the Deckle, named in its own
    // column. (The card row's rollId is the facestock reel it ran off.)
    //
    // Each web's Joint / Wrinkle as the card records it -- the kind, and the
    // metre mark it was punched at: "Joint at 120 mtrs", or None on a clean
    // web.
    const jointCell = (kind, mtrs) => {
      const what = String(kind ?? "").trim();
      const at = mtrs != null && mtrs !== "" && Number.isFinite(Number(mtrs)) ? `${liveStatusMtrs(mtrs)} mtrs` : "";
      if (what && at) return `<span class="dlg-flag">${liveStatusEscape(what)}</span> at ${at}`;
      if (what) return `<span class="dlg-flag">${liveStatusEscape(what)}</span>`;
      if (at) return `At ${at}`;
      return none;
    };
    // An older live Deckle carries only one label merging both webs (its
    // sticker's), so it says that rather than file it under the wrong web.
    const jointCells = (row) => (row.jointsUnattributed
      ? `<td colspan="2"><span class="dlg-flag">${liveStatusEscape(row.jointsUnattributed)}</span> <span class="dlg-none">(facestock or release not recorded)</span></td>`
      : `<td>${jointCell(row.faceJoint, row.faceMtrs)}</td><td>${jointCell(row.releaseJoint, row.releaseMtrs)}</td>`);
    // The gap between deckles, from the card's own punches ("1:49 PM" End,
    // "1:55 PM" next Start): both ends come off the same tablet's clock, so
    // they agree with each other even where that clock is off. A gap across
    // midnight wraps; a negative one (an edited time) is no gap; a missing
    // punch (a Deckle from before its times were stored) shows none.
    const punchMins = (text) => {
      const m = String(text || "").trim().match(/^(\d{1,2}):(\d{2})\s*([AP]M)$/i);
      return m ? (Number(m[1]) % 12 + (m[3].toUpperCase() === "PM" ? 12 : 0)) * 60 + Number(m[2]) : null;
    };
    const punchGap = (endText, startText) => {
      const a = punchMins(endText);
      const b = punchMins(startText);
      if (a == null || b == null) return null;
      const d = b - a < -720 ? b - a + 1440 : b - a;
      return d >= 0 ? d : null;
    };
    const gapRow = (text) => `<tr class="dlg-gap-row"><td colspan="${PROD_COLS}"><i class="fa-solid fa-pause"></i>&nbsp; ${text}</td></tr>`;
    // A log date, in full: "17 Sept 2026".
    const dlgDate = (value) => {
      const d = new Date(value);
      return Number.isNaN(d.getTime()) ? "" : d.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
    };
    // The day a Production Log row ran on, and whether it ran past midnight.
    // Its Deckle's Stop (producedAt -- the server's clock) dates the End; the
    // Start is the day before when its punched Start is later in the day
    // than its punched End (11:30 PM -> 12:37 AM). A row whose Deckle was
    // never made has only its card's date to go on.
    const rowDay = (row) => {
      const start = punchMins(row.startTime);
      const stop = row.producedAt ? new Date(row.producedAt) : null;
      if (stop && !Number.isNaN(stop.getTime())) {
        const end = punchMins(row.endTime || liveStatusClock(stop));
        const overnight = start != null && end != null && start > end;
        const date = new Date(stop);
        if (overnight) date.setDate(date.getDate() - 1);
        return { date, overnight };
      }
      const card = row.cardDate ? new Date(row.cardDate) : null;
      if (!card || Number.isNaN(card.getTime())) return null;
      const end = punchMins(row.endTime);
      return { date: card, overnight: start != null && end != null && start > end };
    };
    const nextDay = ` <span class="dlg-none">next day</span>`;
    const productionRows = production.length
      ? production.map((row, i) => {
          const gap = i > 0 ? punchGap(production[i - 1].endTime, row.startTime) : null;
          const day = rowDay(row);
          return `${gap >= 1 ? gapRow(`Idle time &middot; ${wipDuration(gap)}`) : ""}
          <tr><td>${row.index}</td><td>${liveStatusValue(row.deckleId)}</td>
          <td style="font-weight:700;">${liveStatusMtrs(row.meters)} mtrs</td>
          <td>${day ? dlgDate(day.date) : none}</td>
          <td>${liveStatusValue(row.startTime)}</td>
          <td>${liveStatusValue(row.endTime || (row.live && row.producedAt ? liveStatusClock(row.producedAt) : ""))}${day?.overnight ? nextDay : ""}</td>
          ${jointCells(row)}</tr>`;
        }).join("")
      : "";
    // Whether the operator's app is on the job right this second -- a chip
    // beside the Current Status heading, and nothing else (reels mounted are
    // in the Live column's tooltip; every deckle made is in the log below).
    let deviceChip = "";
    if (progress.running) {
      deviceChip = `<span class="dlg-device is-online">Operator app online${progress.runningOn?.deviceLabel ? ` &middot; ${liveStatusEscape(progress.runningOn.deviceLabel)}` : ""}</span>`;
    } else if (progress.runningOn) {
      deviceChip = `<span class="dlg-device is-stale">${progress.runningOn.lastSeenAt ? `Operator app last seen ${new Date(progress.runningOn.lastSeenAt).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" })}` : "Operator app offline"}</span>`;
    }

    // Current Status, the dialog's first section: where the job is NOW, off
    // the server's clock, as one row in the Production Log's own columns --
    // the deckle on the machine (Running, or red once past its ETA), else one
    // line for a setting under way, the machine idle, every deckle made, or a
    // job started with none begun. Its badge (or anywhere on the row) opens
    // the details underneath: the deckle on the machine, and where the job
    // stands -- the Finished, Live, Target, Status and Estimate columns,
    // spelled out.
    const plan = order.runPlan || null;
    let statusRows = "";
    if (plan) {
      const cur = plan.current;
      const of = plan.target ? ` of ${plan.target}` : "";
      const facts = [];
      // How long a stretch has lasted, up to the job's clock (frozen while it
      // is on hold), less any time it spent on hold.
      const since = (at, heldMs = 0) => wipDuration(wipElapsedMins(plan, at, heldMs));
      const heldNote = (heldMs) => (heldMs >= 60000 ? ` <span class="dlg-none">(not counting ${wipDuration(heldMs / 60000)} on hold)</span>` : "");
      const stillToMake = () => {
        if (plan.toMake > 0 && plan.remainingMins != null) {
          facts.push(["Still to make", `${wipPlural(plan.toMake, "deckle")} &times; ${liveStatusMtrs(plan.deckleMtrs)} mtrs &middot; ${wipDuration(plan.remainingMins)} of running at ${plan.speedMpm} mtrs/min`]);
        }
      };
      // On hold: nothing is running late while it is held.
      const pausedNow = plan.phase === "paused" && plan.paused;
      const base = plan.basePhase || plan.phase;
      const over = cur && !pausedNow ? wipOverMins(cur.etaAt, wipNow(plan)) : null;
      if (pausedNow) {
        facts.push(["On hold", `<span style="color:#475569;">Since ${wipClock(plan.paused.since)} &middot; ${wipDuration((Date.now() - plan.paused.since) / 60000)} so far</span>`]);
        facts.push(["Reason", plan.paused.reason ? liveStatusEscape(plan.paused.reason) : `<span class="dlg-none">Not given</span>`]);
        if (plan.paused.deviceLabel) facts.push(["Paused on", liveStatusEscape(plan.paused.deviceLabel)]);
      }
      if (cur) {
        facts.push(["On the machine", wipDeckleLabel(plan, cur)]);
        facts.push(["Deckle started", `${wipClock(cur.startedAt)}${cur.startMtrs != null ? ` &middot; counter at ${liveStatusMtrs(cur.startMtrs)} mtrs` : ""}`]);
        if (plan.gapBeforeMins >= 1) {
          facts.push(["Idle before it", `${wipDuration(plan.gapBeforeMins)} &middot; deckle ${plan.done} came off at ${wipClock(plan.lastDoneAt)}`]);
        }
        facts.push(["To make", cur.mtrs
          ? `${liveStatusMtrs(cur.mtrs)} mtrs &middot; ${wipDuration(plan.minsPerDeckle)} at ${plan.speedMpm} mtrs/min${heldNote(cur.heldMs)}`
          : `<span style="color:#a16207;">Deckle R.M. not set on this job, so no ETA</span>`]);
        if (pausedNow && cur.etaAt != null) {
          facts.push(["Held at", `${wipDecklePct(plan, cur)}% &middot; ${wipDuration((cur.etaAt - wipNow(plan)) / 60000)} of it still to run once it resumes`]);
        }
        // No ETA fact: the Running row above already shows it, and how far over.
      } else if (base === "setting") {
        facts.push(["On the machine", "Job Setting"]);
        facts.push(["Setting since", `${wipClock(plan.setting.startedAt)} &middot; ${since(plan.setting.startedAt, plan.setting.heldMs)} so far${heldNote(plan.setting.heldMs)}${plan.setting.startMtrs != null ? ` &middot; counter at ${liveStatusMtrs(plan.setting.startMtrs)} mtrs` : ""}`]);
        stillToMake();
      } else if (base === "gap") {
        facts.push(["On the machine", `Idle, between deckle ${plan.done} and ${plan.done + 1}`]);
        if (plan.gapSince != null) facts.push(["Idle time", `<span style="color:#c2410c;">${since(plan.gapSince, plan.gapHeldMs)} so far &middot; since deckle ${plan.done} came off at ${wipClock(plan.gapSince)}</span>${heldNote(plan.gapHeldMs)}`]);
        stillToMake();
      } else if (base === "made") {
        facts.push(["On the machine", `All made: ${plan.done} of ${wipPlural(plan.target, "deckle")}`]);
      } else {
        facts.push(["On the machine", "Nothing yet: started, no deckle begun"]);
        stillToMake();
      }
      if (plan.jobStartedAt != null) {
        facts.push(["Job started", plan.startInferred
          ? `About ${wipClock(plan.jobStartedAt)} <span class="dlg-none">(not recorded; worked back from the first deckle)</span>`
          : wipClock(plan.jobStartedAt)]);
      }
      facts.push(["Finished", plan.done
        ? `${plan.done}${of} deckle${plan.done === 1 && !plan.target ? "" : "s"} &middot; ${liveStatusMtrs(progress.totalMeters)} mtrs${progress.lastDoneAt ? ` @ ${wipClock(progress.lastDoneAt)}` : ""}`
        : "Nothing made yet"]);
      // The Target / Status / Estimate columns, spelled out -- in durations,
      // the same figures the columns show.
      const look = wipOutlook(plan);
      facts.push(["Target", look.targetMins != null
        ? `${wipDuration(look.targetMins)} &middot; ${wipPlural(plan.targetDeckles, "deckle")} &times; ${liveStatusMtrs(plan.deckleMtrs)} mtrs, nonstop at ${plan.speedMpm} mtrs/min${plan.priorDone ? ` &middot; ${plan.priorDone} made on an earlier card` : ""}`
        : `<span style="color:#a16207;">${wipNoTargetReason(plan)}, so no Target</span>`]);
      if (look.state) {
        facts.push(["Status", `${wipStatusPill(look)} &nbsp;${look.finished && look.state !== "ontime" ? "finished " : ""}${wipDelayText(look)}`]);
      }
      // Holds the job has come out of: their time is taken out of the Target
      // and Estimate, so a break never reads as a delay.
      const pastHolds = Array.isArray(plan.pauses) ? plan.pauses : [];
      if (pastHolds.length) {
        facts.push(["Earlier holds", `${wipPlural(pastHolds.length, "hold")} &middot; ${wipDuration((plan.heldMs || 0) / 60000)} in all <span class="dlg-none">(not counted against the Target)</span>`]);
      }
      if (look.estMins != null) {
        let estText;
        if (look.finished) {
          estText = `${wipDuration(look.estMins)} &middot; actual, start to the last deckle${plan.heldMs >= 60000 ? `, less ${wipDuration(plan.heldMs / 60000)} on hold` : ""}`;
        } else if (pausedNow) {
          estText = `${wipDuration(look.estMins)} start to finish &middot; held where it was while the job is on hold`;
        } else if (cur) {
          estText = `${wipDuration(look.estMins)} start to finish &middot; ${wipExtraDeckle(plan, cur) || plan.afterCurrent === 0 ? "ends with this deckle" : `${wipPlural(plan.afterCurrent, "more deckle")} after this one`} &middot; ${wipLeftText(look)}`;
        } else {
          estText = `${wipDuration(look.estMins)} start to finish &middot; if the next deckle starts now &middot; ${wipLeftText(look)}`;
        }
        facts.push(["Estimate", estText]);
      } else if (look.targetMins != null) {
        facts.push(["Estimate", `<span style="color:#a16207;">${wipNoEstimateReason(plan) || "Not known yet"}</span>`]);
      }

      const detailRow = `<tr class="dlg-detail-row" hidden><td colspan="${PROD_COLS}"><dl class="dlg-facts">${facts.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join("")}</dl></td></tr>`;
      const badge = (cls, text) => `<span class="dlg-badge ${cls}">${text}</span>`;
      // The row's last cell: its value, and the dropdown arrow at the right.
      const rowEnd = (inner) => `<div class="dlg-row-end"><div>${inner}</div><button type="button" class="dlg-toggle" aria-expanded="false" aria-label="Show details" title="Show details"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button></div>`;
      const notYet = `<span class="dlg-none">Not yet</span>`;
      if (pausedNow) {
        // On hold: one line, like the other states with nothing moving --
        // since when, why, and what it was held at. The deckle on the machine
        // and everything else stay in the details underneath.
        const held = wipDuration((Date.now() - plan.paused.since) / 60000);
        const what = base === "running" && cur
          ? `${wipDeckleLabel(plan, cur)}${cur.etaAt != null ? ` held at ${wipDecklePct(plan, cur)}%` : " on the machine"}`
          : base === "setting" ? "held in Job Setting"
          : base === "gap" ? `held after deckle ${plan.done}${of}`
          : base === "made" ? `${plan.done}${of} made, Job Card not saved yet`
          : "no deckle begun yet";
        statusRows = `<tr class="dlg-status-row is-paused" onclick="toggleLiveDetails(this)">
            <td></td><td>${dlgDate(plan.paused.since)}</td>
            <td colspan="${PROD_COLS - 2}">${rowEnd(`${badge("is-paused", "Paused")} <span class="dlg-status-text">Since ${liveStatusClock(plan.paused.since)} &middot; ${held} on hold${plan.paused.reason ? ` &middot; ${liveStatusEscape(plan.paused.reason)}` : ""} &middot; ${what}</span>`)}</td>
          </tr>${detailRow}`;
      } else if (cur) {
        // The deckle on the machine, in the log's own columns. Its Deckle ID
        // and joints only exist once its Stop inwards it.
        const late = over != null;
        let made = none;
        if (cur.mtrs && !late && cur.etaAt != null) {
          const pct = wipDecklePct(plan, cur);
          made = `${pct}% <span class="dlg-none">of ${liveStatusMtrs(cur.mtrs)} mtrs</span>`;
        } else if (cur.mtrs) {
          made = `${liveStatusMtrs(cur.mtrs)} mtrs <span class="dlg-none">to make</span>`;
        }
        // ETA as a time of day, with "next day" when it falls after the
        // Start's day (the Date column is the Start's).
        let end = none;
        if (cur.etaAt != null) {
          const eta = new Date(Math.round(cur.etaAt / 60000) * 60000);
          const days = Math.round((new Date(eta).setHours(0, 0, 0, 0) - new Date(cur.startedAt).setHours(0, 0, 0, 0)) / 86400000);
          const when = `ETA ~${liveStatusClock(eta)}${days === 1 ? nextDay : days > 1 ? ` <span class="dlg-none">${dlgDate(eta)}</span>` : ""}`;
          end = late
            ? `<span class="dlg-late">${when}</span><span class="dlg-sub dlg-late">${wipDuration(over)} over</span>`
            : when;
        }
        statusRows = `<tr class="dlg-status-row ${late ? "is-overdue" : "is-running"}" onclick="toggleLiveDetails(this)">
            <td>${cur.index}</td>
            <td>${badge(late ? "is-overdue" : "is-running", "Running")}${wipExtraDeckle(plan, cur) ? ` <span class="dlg-none">extra deckle</span>` : ""}</td>
            <td style="font-weight:700;">${made}</td>
            <td>${dlgDate(cur.startedAt)}</td>
            <td>${liveStatusValue(cur.startTime || liveStatusClock(cur.startedAt))}</td>
            <td>${end}</td>
            <td>${notYet}</td><td>${rowEnd(notYet)}</td>
          </tr>${detailRow}`;
      } else {
        // Nothing on the machine: one line, dated by when that state began.
        let cls;
        let label;
        let text;
        let at;
        if (base === "setting") {
          cls = "is-setting"; label = "Job Setting"; at = plan.setting.startedAt;
          text = `Since ${liveStatusClock(at)} &middot; ${since(at, plan.setting.heldMs)} so far${plan.done ? ` &middot; after deckle ${plan.done}${of}` : ""}`;
        } else if (base === "gap") {
          cls = "is-idle"; label = "Idle"; at = plan.gapSince;
          text = at != null
            ? `${since(at, plan.gapHeldMs)} since deckle ${plan.done} came off at ${liveStatusClock(at)} &middot; deckle ${plan.done + 1} not started yet`
            : `Between deckle ${plan.done} and ${plan.done + 1}`;
        } else if (base === "made") {
          cls = "is-made"; label = "All made"; at = plan.lastDoneAt;
          text = `${plan.done} of ${wipPlural(plan.target, "deckle")} made &middot; Job Card not saved yet`;
        } else {
          cls = "is-started"; label = "Started"; at = plan.jobStartedAt;
          text = `${at != null ? `Started ${liveStatusClock(at)} &middot; ` : ""}no deckle begun yet`;
        }
        statusRows = `<tr class="dlg-status-row ${cls}" onclick="toggleLiveDetails(this)">
            <td></td><td>${at != null ? dlgDate(at) : none}</td>
            <td colspan="${PROD_COLS - 2}">${rowEnd(`${badge(cls, label)} <span class="dlg-status-text">${text}</span>`)}</td>
          </tr>${detailRow}`;
      }
    }
    const productionBody = productionRows
      || `<tr><td colspan="${PROD_COLS}" style="color:#64748b; text-align:center;">Nothing produced yet on this job.</td></tr>`;
    // One header for the Production Log and for a running deckle's row in
    // Current Status, which is laid out in the same columns. A one-line state
    // (setting, idle, all made, started) has no columns to head.
    const PROD_HEAD = `<thead><tr><th>#</th><th>Deckle ID</th><th>Made</th><th>Date</th><th>Start Time</th><th>End Time</th><th>Face Joint</th><th>Release Joint</th></tr></thead>`;
    const statusSection = statusRows
      ? `<div class="dlg-section-head"><h3 class="section-title">Current Status</h3>${deviceChip}</div>
          <div class="dlg-scroll-x dlg-status-wrap"><table class="diff-table dlg-log-table">${PROD_COLGROUP}${plan?.current && plan.phase !== "paused" ? PROD_HEAD : ""}<tbody>${statusRows}</tbody></table></div>`
      : deviceChip ? `<div class="dlg-section-head">${deviceChip}</div>` : "";

    // Hold Log: every time the operator paused this job in the app, oldest
    // first, the one it is on now last. Only there once it has been paused.
    const holds = [
      ...(Array.isArray(plan?.pauses) ? plan.pauses : []).map((p) => ({ ...p, open: false })),
      ...(plan?.paused ? [{ from: plan.paused.since, to: null, reason: plan.paused.reason, open: true }] : []),
    ];
    const holdSection = holds.length
      ? `<h3 class="section-title" style="margin-top:22px;">Hold Log</h3>
          <div class="dlg-scroll-x" style="overflow-x:auto;"><table class="diff-table dlg-log-table">
            <colgroup><col style="width:4%"><col style="width:22%"><col style="width:22%"><col style="width:17%"><col style="width:35%"></colgroup>
            <thead><tr><th>#</th><th>Paused</th><th>Resumed</th><th>On hold</th><th>Reason</th></tr></thead>
            <tbody>${holds.map((h, i) => `<tr><td>${i + 1}</td><td>${wipClock(h.from)}</td>
              <td>${h.open ? `<span class="dlg-badge is-paused">Still on hold</span>` : wipClock(h.to)}</td>
              <td style="font-weight:700;">${wipDuration(((h.open ? Date.now() : h.to) - h.from) / 60000)}</td>
              <td>${liveStatusValue(h.reason)}</td></tr>`).join("")}</tbody></table></div>`
      : "";

    document.getElementById("live-status-dialog-body").innerHTML = `
      <div class="tape-details-card"><div class="details-scroll-area is-pinned-head">
        <div class="tape-details-header"><div class="header-copy"><h1>Live Production Status</h1>
          <div class="header-subtitle">${liveStatusEscape(order.productCode || "Label Stock")} · ${progress.jobCardId ? `Job Card ${liveStatusEscape(progress.jobCardId)}` : "Job Card not saved yet"}</div></div>
          <div class="header-actions"><span class="header-action-link" style="pointer-events:none;"><i class="fa-solid fa-ruler-horizontal"></i> Total: ${liveStatusMtrs(progress.totalMeters)} mtrs</span>
          <button type="button" onclick="closeLiveStatusDialog()" class="header-action-link" style="border:none; cursor:pointer;"><i class="fa-solid fa-xmark"></i></button></div></div>
        <div class="tape-details-body">${statusSection}<h3 class="section-title">Job Setting Log</h3>
          <div class="dlg-scroll-x" style="overflow-x:auto; margin-bottom:22px;"><table class="diff-table dlg-log-table">${SETTING_COLGROUP}<thead><tr><th>#</th><th>Mtrs</th><th>Start Time</th><th>End Time</th><th>Counter</th><th>Status</th></tr></thead><tbody>${settingRows}</tbody></table></div>
          <h3 class="section-title">Production Log</h3>
          <div class="dlg-scroll-x" style="overflow-x:auto;"><table class="diff-table dlg-log-table">${PROD_COLGROUP}${PROD_HEAD}<tbody>${productionBody}</tbody></table></div>
          ${holdSection}
          ${wipRemarksSection(progress)}
        </div></div></div>`;
    document.getElementById("live-status-dialog").style.display = "flex";
  };
  // The Current Status row at the top of the dialog opens and closes the
  // details underneath it -- a click anywhere on the row, its dropdown arrow
  // included (the arrow is a button, so the keyboard reaches it too; its
  // click bubbles up to the row, so the row is the one place this runs).
  window.toggleLiveDetails = function (row) {
    const detail = row.nextElementSibling;
    if (!detail || !detail.classList.contains("dlg-detail-row")) return;
    const open = detail.hidden;
    detail.hidden = !open;
    row.classList.toggle("is-open", open);
    const arrow = row.querySelector(".dlg-toggle");
    if (arrow) {
      arrow.setAttribute("aria-expanded", String(open));
      arrow.setAttribute("aria-label", open ? "Hide details" : "Show details");
      arrow.title = open ? "Hide details" : "Show details";
    }
  };
  // Closed by its ✕ only. A click outside it does nothing, so a stray click
  // while reading the logs doesn't throw the dialog away -- the same as this
  // page's other dialogs.
  window.closeLiveStatusDialog = () => (document.getElementById("live-status-dialog").style.display = "none");

  /* ----- Assign Production -----
     Opens the assignment form -- machine, operator, helper and raw-material
     reels. It does NOT start anything: the job only runs once an operator
     punches Start on its card from the machine queue. Named for that, the
     same as the Deckle Queue's own button. */
  window.openAssignProduction = function (orderId) {
    window.location.href = `/app/labels/production/assign/${orderId}`;
  };

  window.closeCustomDialog = () => (document.getElementById("custom-confirm-dialog").style.display = "none");

  /* ----- Send back to Pending (undo Assign Production, WIP tab only) ----- */
  window.requestUnassign = function (orderId) {
    const dialog = document.getElementById("custom-confirm-dialog");
    const yesBtn = document.getElementById("custom-dialog-yes");
    const msg = document.getElementById("custom-dialog-message");
    msg.textContent = "Send this order back to Pending Production? It will be unassigned from its current machine, operator and helper, and will need to be assigned again.";
    yesBtn.textContent = "Yes, Send Back";
    dialog.style.display = "flex";
    yesBtn.onclick = () => submitUnassign(orderId);
  };

  function submitUnassign(orderId) {
    const form = document.createElement("form");
    form.method = "POST";
    form.action = `/app/labels/production/unassign/${orderId}`;
    const input = document.createElement("input");
    input.type = "hidden";
    input.name = "_csrf";
    input.value = "<%= csrfToken %>";
    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
  }

  // Advance rolls (no sales order yet) -- the row is washed cornflowerblue
  // and its Product Code tagged, the same flag every production page shows
  // until the real order takes the rolls over.
  const advRowFormatter = (row) => row.getElement().classList.toggle("adv-row", !!row.getData().advance);
  const advTag = (row) => (row.advance
    ? ` <span class="adv-tag" title="${row.advance.rolls} roll(s) set in advance — no sales order yet">ADVANCE${row.isDeckleBatch ? ` ${row.advance.rolls}` : ""}</span>`
    : "");

  /* ----- Table ----- */
  let table = null;
  if (INITIAL_TAB !== "wip") {
  table = new Tabulator("#master-table", {
    rowFormatter: advRowFormatter,
    data: orderData,
    placeholder: "No label stock pending production",
    initialSort: [{ column: "createdAt", dir: "asc" }],
    columns: [
      // getPosition(true) is the row's rank among currently sorted/filtered
      // rows, re-evaluated on every redraw -- stays correct after sorting or
      // filtering instead of a static index frozen at load time.
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `
            <div style="display:flex; gap:6px; justify-content:center; align-items:center;">
              <button onclick="viewProduction('${row._id}')" class="btn-action" style="background:#111827;" title="View Details"><i class="fa-solid fa-eye"></i></button>
              <button onclick="openAssignProduction('${row._id}')" class="btn-action" style="background:#10b981;" title="Assign Production — choose the machine, operator and raw material"><i class="fa-solid fa-clipboard-list"></i></button>
            </div>
          `;
        },
      },
      { title: "Date", field: "createdAt", headerFilter: "input", headerFilterPlaceholder: "Filter date...", formatter: (cell) => new Date(cell.getValue()).toLocaleDateString("en-IN") },
      { title: "Client", field: "clientName", headerFilter: "input", headerFilterPlaceholder: "Filter client...", formatter: (cell) => `<span style="font-weight:600; color:#044A78;">${cell.getValue() || "N/A"}</span>` },
      {
        title: "Client Type",
        field: "clientType",
        width: 110,
        hozAlign: "center",
        headerFilter: "list",
        headerFilterParams: { values: { "": "All", DEALER: "Dealer", CLIENT: "Client" } },
        headerFilterPlaceholder: "All",
        formatter: (cell) => {
          const val = String(cell.getValue() || "").toUpperCase();
          if (!val) return "";
          const isDealer = val === "DEALER";
          const color = isDealer ? "#dc2626" : "#059669";
          return `<span style="color:${color}; font-weight:700;">${val}</span>`;
        },
      },
      { title: "User", field: "userName", headerFilter: "input", headerFilterPlaceholder: "Filter user..." },
      { title: "Product Code", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Filter product...", formatter: (cell) => `<span style="font-weight:600; color:#044A78;">${cell.getValue() || "N/A"}</span>${advTag(cell.getRow().getData())}` },
      { title: "Paper Size", field: "paperSize", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "Size" },
      { title: "No. of Rolls", field: "noOfRolls", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#" },
      { title: "Qty", field: "quantity", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#" },
      {
        title: "Bal",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `<span style="font-weight:700; color:#044A78;">${row.balance ?? row.quantity}</span>`;
        },
      },
      { title: "PO Number", field: "poNumber", headerFilter: "input", headerFilterPlaceholder: "Filter PO..." },
      { title: "Est. Delivery", field: "estimatedDate", headerFilter: "input", headerFilterPlaceholder: "Filter date...", formatter: (cell) => (cell.getValue() ? new Date(cell.getValue()).toLocaleDateString("en-IN") : "—") },
      { title: "Remarks", field: "remarks", headerFilter: "input", headerFilterPlaceholder: "Filter remarks..." },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever's actually on
  // screen, top to bottom, is renumbered 1..n every time the table redraws.
  table.on("renderComplete", function () {
    document.querySelectorAll("#master-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });
  }

  /* ----- WIP Table (orders already sent through Assign Production) ----- */
  let wipTable = null;
  if (INITIAL_TAB === "wip") {
  wipTable = new Tabulator("#wip-table", {
    rowFormatter: advRowFormatter,
    data: wipData,
    index: "_id",
    // This tab lists jobs an operator has actually started, so an empty table
    // means nothing is running -- not that nothing is assigned.
    placeholder: "No job is running right now — an assigned job appears here once its operator starts it",
    initialSort: [{ column: "assignedAt", dir: "desc" }],
    // Every cell centred top to bottom, so a one-line cell sits level with the
    // two-line Deckles / Live / Target / Status / Estimate cells beside it.
    columnDefaults: { vertAlign: "middle" },
    columns: [
      // getPosition(true) is the row's rank among currently sorted/filtered
      // rows, re-evaluated on every redraw -- stays correct after sorting or
      // filtering instead of a static index frozen at load time.
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const queueBtn = row.assignedMachineId?._id
            ? `<button onclick="window.open('/app/machine/${row.assignedMachineId._id}/queue', '_blank')" class="btn-action" style="background:#044A78;" title="View Machine Queue"><i class="fa-solid fa-list-check"></i></button>`
            : "";
          // Disabled on what the server itself refuses (row.canSendBack), not
          // on "has this job started": a job started by mistake with nothing
          // produced can still be sent back, and the server allows it.
          const unassignBtn = row.canSendBack
            ? `<button onclick="requestUnassign('${row._id}')" class="btn-action" style="background:#b45309;" title="Send Back to Pending"><i class="fa-solid fa-rotate-left"></i></button>`
            : `<button class="btn-action" disabled style="background:#9ca3af;cursor:not-allowed;" title="Already produced on this job — it can't be sent back to Pending"><i class="fa-solid fa-rotate-left"></i></button>`;
          return `
            <div style="display:flex; gap:6px; justify-content:center; align-items:center;">
              <button onclick="viewProduction('${row._id}')" class="btn-action" style="background:#111827;" title="View Details"><i class="fa-solid fa-eye"></i></button>
              ${queueBtn}
              ${unassignBtn}
            </div>
          `;
        },
      },
      { title: "Machine", field: "machineName", headerFilter: "input", headerFilterPlaceholder: "Filter machine...", formatter: (cell) => cell.getValue() || "—" },
      { title: "Assigned", field: "assignedAt", headerFilter: "input", headerFilterPlaceholder: "Filter date...", formatter: (cell) => (cell.getValue() ? new Date(cell.getValue()).toLocaleDateString("en-IN") : "—") },
      { title: "Product Code", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Filter product...", formatter: (cell) => `${cell.getValue() || "—"}${advTag(cell.getRow().getData())}` },
      { title: "Paper Size", field: "paperSize", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "Size", formatter: (cell) => cell.getValue() || "—" },
      { title: "Total Mtrs Required", field: "totalRunningMeters", hozAlign: "right", headerFilter: "input", headerFilterPlaceholder: "Mtrs", formatter: (cell) => {
        const value = cell.getValue();
        return Number.isFinite(Number(value)) ? `${Number(value).toLocaleString("en-IN", { maximumFractionDigits: 2 })} mtrs` : "—";
      } },
      // Raw-material allocation, split per pool (Facestock/Adhesive/Release
      // Liner) instead of one collapsed "Stock" column -- not Deckle reels
      // produced vs. rolls ordered (rollsStatus): a single Assign & Continue
      // only ever laminates one Deckle, so an order needing 2+ rolls would
      // read "short" on rollsStatus right after its very first,
      // fully-allocated run. facestockStatus/adhesiveStatus/releaseStatus
      // are the real ready/not-ready signal (see routes/fairdesk_route.js).
      // Each is null (rollType doesn't use that pool), "none" (red, nothing
      // allotted), "partial" (yellow, DOUBLE FACESTOCK/DOUBLE RELEASE with
      // only one of its two same-pool layers allotted), or "full" (green).
      ...["facestock", "adhesive", "release"].map((pool) => ({
        title: pool === "facestock" ? "Facestock" : pool === "adhesive" ? "Adhesive" : "Release",
        field: `${pool}Status`,
        hozAlign: "center",
        headerFilter: "list",
        headerFilterParams: { values: { "": "All", none: "Not allotted", partial: "Partial", full: "Fully allotted" } },
        headerFilterPlaceholder: "All",
        formatter: (cell) => {
          const status = cell.getValue();
          if (status === "none") return `<span class="wip-pill is-red" title="Assign this layer before starting production">Not allotted</span>`;
          if (status === "partial") return `<span class="wip-pill is-amber" title="Only part of this layer is allotted">Partial</span>`;
          if (status === "full") return `<span class="wip-pill is-green">Allotted</span>`;
          return `<span class="wip-none">—</span>`;
        },
      })),
      { title: "Operator", field: "operatorName", headerFilter: "input", headerFilterPlaceholder: "Filter...", formatter: (cell) => cell.getValue() || "—" },
      { title: "Helper", field: "helperName", headerFilter: "input", headerFilterPlaceholder: "Filter...", formatter: (cell) => cell.getValue() || "—" },
      // Where each started job stands, left to right: deckles made, metres
      // made, what the machine is doing now, then the Target and how the job
      // is doing against it. Every row on this tab is a started job (see the
      // WIP filter in routes/fairdesk_route.js) and every one of these is live
      // -- a deckle counts the moment its Stop punch inwards it, long before
      // the Job Card is saved. Durations only: times of day are in the Live
      // Status dialog, which each of these cells opens.
      {
        title: "Deckles",
        field: "wipDeckles",
        headerSort: false,
        headerTooltip: "Deckles made, of the number planned for this job",
        minWidth: 110,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const plan = row.runPlan;
          if (!row.liveUpdate || !plan) return `<span class="wip-none">—</span>`;
          // runPlan.done is the larger of the de-duplicated production rows
          // and producedRolls (utils/productionEta.js), so it can't under-count.
          const done = plan.done;
          if (!plan.target) {
            return wipCellBtn(row._id, "No deckle target set on this job", `
              <span class="wip-line"><span class="wip-main wip-link">${done}</span></span>
              <span class="wip-line"><span class="wip-sub">made</span></span>`);
          }
          return wipCellBtn(row._id, `${done} of ${plan.target} deckles made`, `
            <span class="wip-line"><span class="wip-main wip-link">${done} / ${plan.target}</span></span>
            <span class="wip-line">${wipBar(done / plan.target, `${done} of ${plan.target} deckles made`)}</span>`);
        },
        accessorDownload: (value, data) => {
          const plan = data.runPlan;
          if (!data.liveUpdate || !plan) return "";
          return plan.target ? `${plan.done} / ${plan.target}` : `${plan.done}`;
        },
      },
      {
        title: "Finished",
        field: "liveUpdate",
        headerSort: false,
        headerTooltip: "Metres laminated so far",
        minWidth: 110,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const val = row.liveUpdate;
          const production = Array.isArray(val?.production) ? val.production : [];
          if (!val || !production.length) return `<span class="wip-none">Nothing yet</span>`;
          return wipCellBtn(row._id, "View production log",
            `<span class="wip-line"><span class="wip-main wip-link">${liveStatusMtrs(val.totalMeters)} mtrs</span></span>`);
        },
        accessorDownload: (value, data) => (data.liveUpdate?.production?.length ? `${data.liveUpdate.totalMeters} mtrs` : ""),
      },
      {
        title: "Live",
        field: "runPlan",
        headerSort: false,
        headerTooltip: "What the machine is doing now. While a deckle runs, the green fill is how far it has got. Paused: the operator has put the job on hold in the app",
        minWidth: 170,
        // The deckle on the machine right now, and how far it has got at the
        // laminator's speed -- counted on the server (utils/productionEta.js)
        // from the Start the card reports (PendingProduction.liveRun); only
        // "past its ETA" is decided here, against this browser's clock, so it
        // moves without a reload. A job on hold (PendingProduction.livePause)
        // stands still at the moment it was paused (wipNow).
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const val = row.liveUpdate;
          const plan = row.runPlan;
          const cur = plan?.current || null;
          const paused = plan?.phase === "paused" && plan.paused;
          // A deckle on the machine blinks the cell green, and fills it green
          // from its Start to its ETA. Past the ETA by a whole minute
          // (wipOverMins) -- the same test the "min over" text uses, so it
          // turns exactly when it says so -- the red blink takes over. On hold,
          // neither: the cell goes still and slate, the fill held where it got.
          const over = cur && !paused ? wipOverMins(cur.etaAt) : null;
          const fillFrom = cur ? cur.runFromAt ?? cur.startedAt : null;
          wipSetLiveCell(cell,
            !val || !plan ? "" : paused ? "paused" : !cur ? "" : over != null ? "overdue" : "running",
            cur && cur.etaAt != null ? { startedAt: fillFrom, durMs: cur.etaAt - fillFrom, at: plan.clockAt } : null);
          if (!val || !plan) return `<span class="wip-none">Not started</span>`;
          const phase = (cls, text) => `<span class="wip-phase wip-link ${cls}">${text}</span>`;
          const since = (at, heldMs) => wipDuration(wipElapsedMins(plan, at, heldMs));
          const mountedTip = val.mounted ? ` · ${wipPlural(val.mounted, "reel")} mounted` : "";
          let head;
          let sub;
          let tip;
          if (paused) {
            // On hold: what it was doing when it stopped, and for how long it
            // has been held -- that one keeps counting, it is real time.
            const heldFor = wipDuration((Date.now() - plan.paused.since) / 60000);
            head = `${phase("is-slate", "Paused")}<span class="wip-sub">${wipHeldWhat(plan)}</span>`;
            sub = `<span class="wip-main">${heldFor}</span><span class="wip-sub">on hold${plan.paused.reason ? ` · ${liveStatusEscape(plan.paused.reason)}` : ""}</span>`;
            tip = `On hold since ${wipClock(plan.paused.since)}${plan.paused.reason ? ` (${plan.paused.reason})` : ""}${plan.paused.deviceLabel ? ` · paused on ${plan.paused.deviceLabel}` : ""} · nothing here moves until it resumes`;
          } else if (cur) {
            // The count itself is the Deckles column's; here only which one.
            const which = wipExtraDeckle(plan, cur) ? `Deckle ${cur.index} · extra` : `Deckle ${cur.index}`;
            head = `${phase("is-green is-pulse", "Running")}<span class="wip-sub">${which}</span>`;
            if (over != null) {
              sub = `<span class="wip-main">${wipDuration(over)} over</span>`;
              tip = `${wipDeckleLabel(plan, cur)} has run ${wipDuration(over)} past its ~${wipDuration(plan.minsPerDeckle)}`;
              const why = wipRemarkFor(val, cur);
              if (why) { sub += `<span class="wip-sub">“${liveStatusEscape(wipShort(why.remark))}”</span>`; tip += ` · Operator: ${why.remark}`; }
            } else if (cur.etaAt != null) {
              const pct = wipDecklePct(plan, cur);
              sub = `<span class="wip-main">${pct}%</span><span class="wip-sub">${wipDuration((cur.etaAt - wipNow(plan)) / 60000)} left</span>`;
              tip = `${wipDeckleLabel(plan, cur)}: ${liveStatusMtrs(cur.mtrs)} mtrs, ~${wipDuration(plan.minsPerDeckle)} at ${plan.speedMpm} mtrs/min`;
              if (cur.heldMs >= 60000) tip += ` · ${wipDuration(cur.heldMs / 60000)} on hold added to its ETA`;
            } else {
              sub = `<span class="wip-sub">Deckle R.M. not set</span>`;
              tip = `${wipDeckleLabel(plan, cur)}: no Deckle R.M. on this job, so no ETA`;
            }
            if (plan.gapBeforeMins >= 1) tip += ` · after ${wipDuration(plan.gapBeforeMins)} idle`;
          } else {
            // No deckle on the machine. The phase comes from the server
            // (plan.phase, utils/productionEta.js); how long it has lasted is
            // counted to now -- less any time on hold -- so these rows are
            // redrawn on the clock too.
            if (plan.phase === "setting") {
              head = phase("is-amber", "Job Setting");
              sub = `<span class="wip-main">${since(plan.setting.startedAt, plan.setting.heldMs)}</span><span class="wip-sub">so far</span>`;
            } else if (plan.phase === "made") {
              head = phase("is-green", "All made");
              sub = `<span class="wip-sub">Job Card not saved</span>`;
            } else if (plan.phase === "gap") {
              // A deckle has come off and the next isn't started: the machine
              // is idle, counted from that deckle's Stop.
              head = `${phase("is-orange", "Idle")}<span class="wip-sub">after deckle ${plan.done}</span>`;
              sub = plan.gapSince != null
                ? `<span class="wip-main">${since(plan.gapSince, plan.gapHeldMs)}</span><span class="wip-sub">so far</span>`
                : `<span class="wip-sub">Between deckles</span>`;
            } else {
              // Played, nothing on the machine, nothing made yet.
              head = phase("is-blue", "Started");
              sub = `<span class="wip-sub">No deckle yet</span>`;
            }
            tip = val.running
              ? `An operator is on this job now${val.runningOn?.deviceLabel ? ` (${val.runningOn.deviceLabel})` : ""}`
              : "No deckle running";
          }
          return wipCellBtn(row._id, `${tip}${mountedTip}`, `<span class="wip-line">${head}</span><span class="wip-line">${sub}</span>`);
        },
        accessorDownload: (value, data) => {
          const plan = data.runPlan;
          if (!data.liveUpdate || !plan) return "";
          const cur = plan.current;
          const since = (at, heldMs) => wipDuration(wipElapsedMins(plan, at, heldMs));
          if (plan.phase === "paused" && plan.paused) {
            return `Paused · ${wipHeldWhat(plan)} · ${wipDuration((Date.now() - plan.paused.since) / 60000)} on hold${plan.paused.reason ? ` · ${plan.paused.reason}` : ""}`;
          }
          if (cur) {
            const over = wipOverMins(cur.etaAt);
            if (over != null) return `Running · Deckle ${cur.index} · ${wipDuration(over)} over`;
            if (cur.etaAt != null) return `Running · Deckle ${cur.index} · ${wipDuration((cur.etaAt - Date.now()) / 60000)} left`;
            return `Running · Deckle ${cur.index}`;
          }
          if (plan.phase === "setting") return `Job Setting · ${since(plan.setting.startedAt, plan.setting.heldMs)}`;
          if (plan.phase === "made") return "All made";
          if (plan.phase === "gap") return plan.gapSince != null ? `Idle · ${since(plan.gapSince, plan.gapHeldMs)}` : "Idle";
          return "Started";
        },
      },
      // How long the job should take: the deckles this run owes, run nonstop
      // at the laminator's speed. Fixed once the job starts.
      {
        title: "Target",
        field: "wipTarget",
        headerSort: false,
        headerTooltip: `How long the job takes run nonstop at the laminator's speed`,
        minWidth: 120,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const plan = row.runPlan;
          if (!row.liveUpdate || !plan) return `<span class="wip-none">—</span>`;
          const look = wipOutlook(plan);
          if (look.targetMins == null) {
            return wipCellBtn(row._id, "No Target for this job", `
              <span class="wip-line"><span class="wip-none">—</span></span>
              <span class="wip-line"><span class="wip-sub wip-link">${wipNoTargetReason(plan)}</span></span>`);
          }
          const prior = plan.priorDone ? ` · ${plan.priorDone} made on an earlier card` : "";
          return wipCellBtn(row._id,
            `${wipPlural(plan.targetDeckles, "deckle")} × ${liveStatusMtrs(plan.deckleMtrs)} mtrs, nonstop at ${plan.speedMpm} mtrs/min${prior}`, `
            <span class="wip-line"><span class="wip-main wip-link">${wipDuration(look.targetMins)}</span></span>
            <span class="wip-line"><span class="wip-sub">${liveStatusMtrs(plan.targetDeckles * plan.deckleMtrs)} mtrs</span></span>`);
        },
        accessorDownload: (value, data) => {
          const look = data.liveUpdate ? wipOutlook(data.runPlan) : null;
          return look?.targetMins != null ? wipDuration(look.targetMins) : "";
        },
      },
      // The delay so far, against Target: Delayed / Ahead / On time (within
      // WIP_ON_TIME_MINS). Decided against this browser's clock on every draw,
      // like the Live column's overrun, so it moves without a reload.
      {
        title: "Status",
        field: "wipStatus",
        headerSort: false,
        headerTooltip: `Against Target — on time is within ${WIP_ON_TIME_MINS} min`,
        minWidth: 120,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const plan = row.runPlan;
          const look = row.liveUpdate ? wipOutlook(plan) : null;
          if (!look?.state) {
            const why = look ? wipNoEstimateReason(plan) : "";
            return why
              ? wipCellBtn(row._id, "No Status for this job", `
                <span class="wip-line"><span class="wip-none">—</span></span>
                <span class="wip-line"><span class="wip-sub wip-link">${why}</span></span>`)
              : `<span class="wip-none">—</span>`;
          }
          const text = `${look.finished && look.state !== "ontime" ? "finished " : ""}${wipDelayText(look)}`;
          return wipCellBtn(row._id, `Estimate ${wipDuration(look.estMins)} against Target ${wipDuration(look.targetMins)}`, `
            <span class="wip-line">${wipStatusPill(look)}</span>
            <span class="wip-line"><span class="wip-sub wip-link">${text}</span></span>`);
        },
        accessorDownload: (value, data) => {
          const look = data.liveUpdate ? wipOutlook(data.runPlan) : null;
          return look?.state ? `${WIP_STATE[look.state].label} (${wipDelayText(look)})` : "";
        },
      },
      // How long the job will have taken start to finish: Target + the delay
      // so far, so every setting, gap and overrun it has had is already in it.
      // Once every deckle is made it is the actual figure, not an estimate.
      {
        title: "Estimate",
        field: "wipEstimate",
        headerSort: false,
        headerTooltip: "How long the job will take start to finish: Target + the delay so far",
        minWidth: 120,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const plan = row.runPlan;
          const look = row.liveUpdate ? wipOutlook(plan) : null;
          if (look?.estMins == null) {
            const why = look ? wipNoEstimateReason(plan) : "";
            return why
              ? wipCellBtn(row._id, "No Estimate for this job", `
                <span class="wip-line"><span class="wip-none">—</span></span>
                <span class="wip-line"><span class="wip-sub wip-link">${why}</span></span>`)
              : `<span class="wip-none">—</span>`;
          }
          if (look.finished) {
            return wipCellBtn(row._id, "Actual: from the job's start to its last deckle", `
              <span class="wip-line"><span class="wip-main wip-link">${wipDuration(look.estMins)}</span></span>
              <span class="wip-line"><span class="wip-sub">Done</span></span>`);
          }
          const how = plan.phase === "paused"
            ? "Held where it was: the job is on hold"
            : plan.current
            ? "If it keeps running at speed from the deckle on the machine"
            : "If the next deckle starts now and the rest run nonstop";
          return wipCellBtn(row._id, `${how} (${plan.speedMpm} mtrs/min)`, `
            <span class="wip-line"><span class="wip-main wip-link">${wipDuration(look.estMins)}</span></span>
            <span class="wip-line"><span class="wip-sub">${wipLeftText(look)}</span></span>`);
        },
        accessorDownload: (value, data) => {
          const look = data.liveUpdate ? wipOutlook(data.runPlan) : null;
          return look?.estMins != null ? wipDuration(look.estMins) : "";
        },
      },
      { title: "Remarks", field: "remarks", headerFilter: "input", headerFilterPlaceholder: "Filter remarks..." },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever's actually on
  // screen, top to bottom, is renumbered 1..n every time the table redraws.
  wipTable.on("renderComplete", function () {
    document.querySelectorAll("#wip-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  // This tab lists jobs that are actually running, so the poll reconciles the
  // whole list, not just the figures in it: a job JOINS when its operator
  // starts it and LEAVES when it is produced. The endpoint answers with the
  // full set (same query, mapper and filter as the page render), so whatever
  // is missing from that answer is no longer running and its row goes.
  //
  // Every WIP_POLL_MS while the page is in view -- short enough that a Pause
  // tapped on the floor shows here within seconds. A tab left open in the
  // background skips its polls (each one is a full WIP build on the server,
  // for nobody to read) and catches up the moment it is looked at again. One
  // poll at a time: a slow answer is never overtaken by the next one.
  const WIP_POLL_MS = 10000;
  let wipPolling = false;
  const refreshWip = async () => {
    if (wipPolling) return;
    wipPolling = true;
    try {
      const res = await fetch("/app/labels/production/wip-progress");
      if (!res.ok) return;
      const rows = await res.json();
      if (!Array.isArray(rows)) return;
      const live = new Set(rows.map((row) => String(row._id)));
      // Collected before deleting: deleting while walking getRows() would
      // skip rows as the list shifts under the loop.
      const gone = wipTable.getRows().filter((row) => !live.has(String(row.getData()._id)));
      // Tabulator's updateOrAddData never settles on an empty array -- and
      // an empty answer means everything has finished, which the deletes
      // below handle on their own.
      if (rows.length) await wipTable.updateOrAddData(rows);
      gone.forEach((row) => row.delete());
    } catch (err) {
      console.error("WIP live update poll failed:", err);
    } finally {
      wipPolling = false;
    }
  };
  setInterval(() => {
    if (!document.hidden) refreshWip();
  }, WIP_POLL_MS);
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) refreshWip();
  });

  // The Live column also depends on the time NOW -- how far through its
  // deckle a job is, whether it has run past its ETA (the red blink), how long
  // a setting, a gap or a hold has lasted -- and so do Status and Estimate for
  // any job not yet all made (with nothing running, the Estimate is now + what
  // is left). So those rows are redrawn on a clock of their own, not only when
  // the poll above brings new data (or fails to).
  const WIP_CLOCK_PHASES = new Set(["running", "setting", "gap", "started", "paused"]);
  setInterval(() => {
    wipTable.getRows().forEach((row) => {
      if (WIP_CLOCK_PHASES.has(row.getData().runPlan?.phase)) row.reformat();
    });
  }, 10000);
  }

  document.getElementById("download-xlsx").addEventListener("click", () => {
    if (wipTable) {
      wipTable.download("xlsx", "wip_production.xlsx", { sheetName: "WIP" });
    } else if (table) {
      table.download("xlsx", "pending_production.xlsx", { sheetName: "PendingProduction" });
    }
  });

  const selector = document.getElementById("downloadSelector");
  const trigger = selector.querySelector(".download-selector__trigger");
  trigger.addEventListener("click", (e) => { e.stopPropagation(); selector.classList.toggle("download-selector--active"); });
  document.addEventListener("click", () => selector.classList.remove("download-selector--active"));
</script>
