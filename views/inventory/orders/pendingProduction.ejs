<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<style>
  @keyframes detailsPopIn {
    0% { transform: scale(0.96); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  @keyframes popIn {
    0% { transform: scale(0.9); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .tape-details-card {
    position: relative;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 18px 42px rgba(4, 74, 120, 0.14);
    border: none;
    overflow: hidden;
  }
  .details-scroll-area { max-height: calc(100vh - 48px); overflow-y: auto; padding-bottom: 20px; }
  .tape-details-header {
    display: flex; justify-content: space-between; gap: 16px; align-items: flex-start;
    padding: 26px 26px 24px;
    background:
      radial-gradient(circle at top right, rgba(255, 255, 255, 0.16), transparent 34%),
      linear-gradient(135deg, #044a78 0%, #03365a 100%);
    color: #fff;
  }
  .tape-details-header h1 { margin: 0; font-size: 27px; font-weight: 700; letter-spacing: 0.2px; line-height: 1.15; }
  .header-subtitle { margin-top: 10px; font-size: 14px; opacity: 0.92; line-height: 1.5; }
  .header-actions { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .header-action-link {
    display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.14); border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff; text-decoration: none; font-weight: 700; font-size: 13px; letter-spacing: 0.2px;
    backdrop-filter: blur(8px); transition: background 0.18s ease;
  }
  .tape-details-body { padding: 20px 26px; }
  .section-title { margin: 0 0 14px; color: #044a78; font-size: 17px; font-weight: 700; }
  .diff-table { width: 100%; border-collapse: collapse; border: 1px solid #e6eaf2; border-radius: 12px; overflow: hidden; }
  .diff-table th, .diff-table td { padding: 10px 12px; border-bottom: 1px solid #e6eaf2; text-align: left; font-size: 13px; vertical-align: top; }
  .diff-table .key-col { width: 32%; color: #5a6586; font-weight: 600; }
  .diff-table .resolved { font-weight: 700; color: #1f2a44; }

  .btn-action {
    height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
    font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
  }
  .btn-action:hover { opacity: 0.85; }
  #custom-dialog-no:hover { background: #f3f4f6; }
  #custom-dialog-yes:hover { opacity: 0.9; }
</style>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <div class="indi-head">
    <h1><%= initialTab === 'wip' ? 'Work In Progress' : 'Pending Production' %></h1>
    <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
      <a
        href="/sachiko/sales/order"
        style="padding: 6px 14px; background: #044a78; color: white; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;"
        onmouseover="this.style.opacity = '0.85'" onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-plus"></i><span>New Label Stock Order</span>
      </a>
      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span><i class="fa-solid fa-file-arrow-down"></i><span class="download-typo">Download</span></span>
          <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
        </button>
        <div class="download-selector__menu" id="downloads">
          <span class="download-selector__option" id="download-xlsx">
            <i class="fas fa-file-excel download-selector__option-icon"></i><span>Excel</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <% if (initialTab === 'wip') { %>
    <div id="wip-table" class="tabulator tabulator-modern"></div>
  <% } else { %>
    <div id="master-table" class="tabulator tabulator-modern"></div>
  <% } %>
</div>

<!-- Send back to Pending confirmation dialog -->
<div id="custom-confirm-dialog" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 9999; justify-content: center; align-items: center;">
  <div style="background: white; border-radius: 8px; width: 440px; max-width: 90%; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2); overflow: hidden; animation: popIn 0.2s ease-out;">
    <div style="padding: 25px 20px; text-align: center">
      <p id="custom-dialog-message" style="margin: 0; color: #333; font-size: 16px; line-height: 1.5">Are you sure?</p>
    </div>
    <div style="padding: 15px 20px; background: #f9fafb; display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #e5e7eb;">
      <button id="custom-dialog-no" onclick="closeCustomDialog()" style="padding: 8px 16px; border: 1px solid #d1d5db; background: white; color: #374151; border-radius: 6px; cursor: pointer; font-weight: 500;">Go Back</button>
      <button id="custom-dialog-yes" style="padding: 8px 16px; border: none; background: #ef4444; color: white; border-radius: 6px; cursor: pointer; font-weight: 500;">Yes, Send Back</button>
    </div>
  </div>
</div>

<!-- Details dialog -->
<div id="pending-order-details-dialog" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.54); z-index: 10000; justify-content: center; align-items: center; padding: 24px; backdrop-filter: blur(6px);">
  <div id="pending-order-details-body" style="width: min(1180px, 100%); animation: detailsPopIn 0.2s ease-out"></div>
</div>

<!-- Live Status production-log dialog -->
<div id="live-status-dialog" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.54); z-index: 10001; justify-content: center; align-items: center; padding: 24px; backdrop-filter: blur(6px);">
  <div id="live-status-dialog-body" style="width: min(1120px, 100%); animation: detailsPopIn 0.2s ease-out"></div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script id="order-data" type="application/json">
  <%- safeJson(orders || []) %>
</script>
<script id="wip-order-data" type="application/json">
  <%- safeJson(wipOrders || []) %>
</script>

<script>
  const orderData = JSON.parse(document.getElementById("order-data").textContent);
  const wipData = JSON.parse(document.getElementById("wip-order-data").textContent);
  const allOrderData = orderData.concat(wipData);
  // Pending vs WIP are separate side-nav destinations (?tab=wip) now, not
  // in-page tabs -- only the table for the page actually rendered gets built.
  const INITIAL_TAB = "<%= initialTab %>";

  /* ----- Details dialog ----- */
  window.viewProduction = function (orderId) {
    const order = allOrderData.find((row) => String(row._id) === String(orderId));
    if (!order) return;

    const qty = Number(order.quantity) || 0;
    const produced = Number(order.balance != null ? qty - order.balance : 0) || 0;
    const remaining = order.balance ?? qty;

    document.getElementById("pending-order-details-body").innerHTML = `
      <div class="tape-details-card">
        <div class="details-scroll-area">
          <div class="tape-details-header">
            <div class="header-copy">
              <h1>${order.productCode || "Label Stock"}</h1>
              <div class="header-subtitle">${order.clientName || "N/A"}${order.userName ? " | " + order.userName : ""}</div>
            </div>
            <div class="header-actions">
              <span class="header-action-link" style="pointer-events: none;"><i class="fa-solid fa-file-invoice"></i> PO: ${order.poNumber || "N/A"}</span>
              <button onclick="closeOrderDetailsDialog()" class="header-action-link" style="border: none; cursor: pointer;"><i class="fa-solid fa-xmark"></i></button>
            </div>
          </div>
          <div class="tape-details-body">
            <h3 class="section-title">Production Details</h3>
            <table class="diff-table">
              <tbody>
                <tr><td class="key-col">Client</td><td class="resolved">${order.clientName || "N/A"}</td></tr>
                <tr><td class="key-col">User</td><td class="resolved">${order.userName || "N/A"}</td></tr>
                <tr><td class="key-col">Product Code</td><td class="resolved">${order.productCode || "N/A"}</td></tr>
                <tr><td class="key-col">Paper Size</td><td class="resolved">${order.paperSize || "N/A"}</td></tr>
                <tr><td class="key-col">No. of Rolls</td><td class="resolved">${order.noOfRolls || "N/A"}</td></tr>
                <tr><td class="key-col">Order Quantity</td><td class="resolved">${qty}</td></tr>
                <tr><td class="key-col">Produced</td><td class="resolved">${produced}</td></tr>
                <tr><td class="key-col">Remaining</td><td class="resolved">${remaining}</td></tr>
                <tr><td class="key-col">PO Number</td><td class="resolved">${order.poNumber || "N/A"}</td></tr>
                <tr><td class="key-col">Estimated Delivery</td><td class="resolved">${order.estimatedDate ? new Date(order.estimatedDate).toLocaleDateString("en-IN") : "N/A"}</td></tr>
                <tr><td class="key-col">Remarks</td><td class="resolved">${order.remarks || "N/A"}</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    `;
    document.getElementById("pending-order-details-dialog").style.display = "flex";
  };
  window.closeOrderDetailsDialog = () => (document.getElementById("pending-order-details-dialog").style.display = "none");

  /* ----- WIP live-status log ----- */
  const liveStatusEscape = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
  })[char]);
  const liveStatusValue = (value) => value === undefined || value === null || value === "" ? "—" : liveStatusEscape(value);
  const liveStatusMtrs = (value) => Number(value).toLocaleString("en-IN", { maximumFractionDigits: 2 });

  window.openLiveStatus = function (orderId) {
    const order = wipTable?.getRow(String(orderId))?.getData()
      || wipData.find((row) => String(row._id) === String(orderId));
    const progress = order?.liveUpdate;
    if (!order || !progress) return;

    const settings = Array.isArray(progress.settings) ? progress.settings : [];
    const production = Array.isArray(progress.production) ? progress.production : [];
    const settingRows = settings.length
      ? settings.map((row) => `
          <tr><td>${row.index}</td><td>${liveStatusValue(row.rollId)}</td>
          <td>${row.startMtrs != null ? `${liveStatusMtrs(row.startMtrs)} mtrs` : "—"}</td>
          <td>${row.stopMtrs != null ? `${liveStatusMtrs(row.stopMtrs)} mtrs` : "—"}</td>
          <td>${liveStatusValue(row.startTime)}</td><td>${liveStatusValue(row.stopTime)}</td>
          <td><span style="font-weight:700; color:${row.completed ? "#16a34a" : "#a16207"};">${row.completed ? "Completed" : "In progress"}</span></td></tr>`).join("")
      : `<tr><td colspan="7" style="color:#64748b; text-align:center;">No Job Setting entry recorded.</td></tr>`;
    const productionRows = production.length
      ? production.map((row) => `
          <tr><td>${row.index}</td><td>${liveStatusValue(row.deckleId)}</td><td>${liveStatusValue(row.rollId)}</td>
          <td style="font-weight:700;">${liveStatusMtrs(row.meters)} mtrs</td>
          <td>${liveStatusValue(row.startTime)}</td><td>${liveStatusValue(row.endTime)}</td>
          <td>${liveStatusValue(row.faceJoint)}${row.faceMtrs != null ? ` · ${liveStatusMtrs(row.faceMtrs)} mtrs` : ""}</td>
          <td>${liveStatusValue(row.releaseJoint)}${row.releaseMtrs != null ? ` · ${liveStatusMtrs(row.releaseMtrs)} mtrs` : ""}</td></tr>`).join("")
      : `<tr><td colspan="8" style="color:#64748b; text-align:center;">No completed Production Log row yet.</td></tr>`;

    document.getElementById("live-status-dialog-body").innerHTML = `
      <div class="tape-details-card"><div class="details-scroll-area">
        <div class="tape-details-header"><div class="header-copy"><h1>Live Production Status</h1>
          <div class="header-subtitle">${liveStatusEscape(order.productCode || "Label Stock")} · Job Card ${liveStatusValue(progress.jobCardId)}</div></div>
          <div class="header-actions"><span class="header-action-link" style="pointer-events:none;"><i class="fa-solid fa-ruler-horizontal"></i> Total: ${liveStatusMtrs(progress.totalMeters)} mtrs</span>
          <button type="button" onclick="closeLiveStatusDialog()" class="header-action-link" style="border:none; cursor:pointer;"><i class="fa-solid fa-xmark"></i></button></div></div>
        <div class="tape-details-body"><h3 class="section-title">Job Setting</h3>
          <div style="overflow-x:auto; margin-bottom:22px;"><table class="diff-table"><thead><tr><th>#</th><th>Roll ID</th><th>Start Meter</th><th>Stop Meter</th><th>Start Time</th><th>Stop Time</th><th>Status</th></tr></thead><tbody>${settingRows}</tbody></table></div>
          <h3 class="section-title">Production Log</h3>
          <div style="overflow-x:auto;"><table class="diff-table"><thead><tr><th>#</th><th>Deckle ID</th><th>Roll ID</th><th>Made</th><th>Start Time</th><th>End Time</th><th>Face</th><th>Release</th></tr></thead><tbody>${productionRows}</tbody></table></div>
        </div></div></div>`;
    document.getElementById("live-status-dialog").style.display = "flex";
  };
  window.closeLiveStatusDialog = () => (document.getElementById("live-status-dialog").style.display = "none");
  document.getElementById("live-status-dialog").addEventListener("click", function (event) {
    if (event.target === this) closeLiveStatusDialog();
  });

  /* ----- Assign/start production ----- */
  window.startProduction = function (orderId) {
    window.location.href = `/sachiko/labels/production/assign/${orderId}`;
  };

  window.closeCustomDialog = () => (document.getElementById("custom-confirm-dialog").style.display = "none");

  /* ----- Send back to Pending (undo Assign Production, WIP tab only) ----- */
  window.requestUnassign = function (orderId) {
    const dialog = document.getElementById("custom-confirm-dialog");
    const yesBtn = document.getElementById("custom-dialog-yes");
    const msg = document.getElementById("custom-dialog-message");
    msg.textContent = "Send this order back to Pending Production? It will be unassigned from its current machine, operator and helper, and will need to be assigned again.";
    yesBtn.textContent = "Yes, Send Back";
    dialog.style.display = "flex";
    yesBtn.onclick = () => submitUnassign(orderId);
  };

  function submitUnassign(orderId) {
    const form = document.createElement("form");
    form.method = "POST";
    form.action = `/sachiko/labels/production/unassign/${orderId}`;
    const input = document.createElement("input");
    input.type = "hidden";
    input.name = "_csrf";
    input.value = "<%= csrfToken %>";
    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
  }

  /* ----- Table ----- */
  let table = null;
  if (INITIAL_TAB !== "wip") {
  table = new Tabulator("#master-table", {
    data: orderData,
    placeholder: "No label stock pending production",
    initialSort: [{ column: "createdAt", dir: "asc" }],
    columns: [
      // getPosition(true) is the row's rank among currently sorted/filtered
      // rows, re-evaluated on every redraw -- stays correct after sorting or
      // filtering instead of a static index frozen at load time.
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `
            <div style="display:flex; gap:6px; justify-content:center; align-items:center;">
              <button onclick="viewProduction('${row._id}')" class="btn-action" style="background:#111827;" title="View Details"><i class="fa-solid fa-eye"></i></button>
              <button onclick="startProduction('${row._id}')" class="btn-action" style="background:#10b981;" title="Assign Production"><i class="fa-solid fa-play"></i></button>
            </div>
          `;
        },
      },
      { title: "Date", field: "createdAt", headerFilter: "input", headerFilterPlaceholder: "Filter date...", formatter: (cell) => new Date(cell.getValue()).toLocaleDateString("en-IN") },
      { title: "Client", field: "clientName", headerFilter: "input", headerFilterPlaceholder: "Filter client...", formatter: (cell) => `<span style="font-weight:600; color:#044A78;">${cell.getValue() || "N/A"}</span>` },
      {
        title: "Client Type",
        field: "clientType",
        width: 110,
        hozAlign: "center",
        headerFilter: "list",
        headerFilterParams: { values: { "": "All", DEALER: "Dealer", CLIENT: "Client" } },
        headerFilterPlaceholder: "All",
        formatter: (cell) => {
          const val = String(cell.getValue() || "").toUpperCase();
          if (!val) return "";
          const isDealer = val === "DEALER";
          const color = isDealer ? "#dc2626" : "#059669";
          return `<span style="color:${color}; font-weight:700;">${val}</span>`;
        },
      },
      { title: "User", field: "userName", headerFilter: "input", headerFilterPlaceholder: "Filter user..." },
      { title: "Product Code", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Filter product...", formatter: (cell) => `<span style="font-weight:600; color:#044A78;">${cell.getValue() || "N/A"}</span>` },
      { title: "Paper Size", field: "paperSize", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "Size" },
      { title: "No. of Rolls", field: "noOfRolls", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#" },
      { title: "Qty", field: "quantity", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#" },
      {
        title: "Bal",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `<span style="font-weight:700; color:#044A78;">${row.balance ?? row.quantity}</span>`;
        },
      },
      { title: "PO Number", field: "poNumber", headerFilter: "input", headerFilterPlaceholder: "Filter PO..." },
      { title: "Est. Delivery", field: "estimatedDate", headerFilter: "input", headerFilterPlaceholder: "Filter date...", formatter: (cell) => (cell.getValue() ? new Date(cell.getValue()).toLocaleDateString("en-IN") : "—") },
      { title: "Remarks", field: "remarks", headerFilter: "input", headerFilterPlaceholder: "Filter remarks..." },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever's actually on
  // screen, top to bottom, is renumbered 1..n every time the table redraws.
  table.on("renderComplete", function () {
    document.querySelectorAll("#master-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });
  }

  /* ----- WIP Table (orders already sent through Assign Production) ----- */
  let wipTable = null;
  if (INITIAL_TAB === "wip") {
  wipTable = new Tabulator("#wip-table", {
    data: wipData,
    index: "_id",
    placeholder: "No label stock currently in production",
    initialSort: [{ column: "assignedAt", dir: "desc" }],
    columns: [
      // getPosition(true) is the row's rank among currently sorted/filtered
      // rows, re-evaluated on every redraw -- stays correct after sorting or
      // filtering instead of a static index frozen at load time.
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const queueBtn = row.assignedMachineId?._id
            ? `<button onclick="window.open('/sachiko/machine/${row.assignedMachineId._id}/queue', '_blank')" class="btn-action" style="background:#044A78;" title="View Machine Queue"><i class="fa-solid fa-list-check"></i></button>`
            : "";
          const unassignBtn = row.liveUpdate
            ? `<button class="btn-action" disabled style="background:#9ca3af;cursor:not-allowed;" title="Job Card already filed — can't send back to Pending"><i class="fa-solid fa-rotate-left"></i></button>`
            : `<button onclick="requestUnassign('${row._id}')" class="btn-action" style="background:#b45309;" title="Send Back to Pending"><i class="fa-solid fa-rotate-left"></i></button>`;
          return `
            <div style="display:flex; gap:6px; justify-content:center; align-items:center;">
              <button onclick="viewProduction('${row._id}')" class="btn-action" style="background:#111827;" title="View Details"><i class="fa-solid fa-eye"></i></button>
              ${queueBtn}
              ${unassignBtn}
            </div>
          `;
        },
      },
      { title: "Assigned", field: "assignedAt", headerFilter: "input", headerFilterPlaceholder: "Filter date...", formatter: (cell) => (cell.getValue() ? new Date(cell.getValue()).toLocaleDateString("en-IN") : "—") },
      { title: "Client", field: "clientName", headerFilter: "input", headerFilterPlaceholder: "Filter client...", formatter: (cell) => `<span style="font-weight:600; color:#044A78;">${cell.getValue() || "N/A"}</span>` },
      {
        title: "Client Type",
        field: "clientType",
        width: 110,
        hozAlign: "center",
        headerFilter: "list",
        headerFilterParams: { values: { "": "All", DEALER: "Dealer", CLIENT: "Client" } },
        headerFilterPlaceholder: "All",
        formatter: (cell) => {
          const val = String(cell.getValue() || "").toUpperCase();
          if (!val) return "";
          const isDealer = val === "DEALER";
          const color = isDealer ? "#dc2626" : "#059669";
          return `<span style="color:${color}; font-weight:700;">${val}</span>`;
        },
      },
      { title: "User", field: "userName", headerFilter: "input", headerFilterPlaceholder: "Filter user..." },
      { title: "Product Code", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Filter product...", formatter: (cell) => cell.getValue() || "—" },
      { title: "Paper Size", field: "paperSize", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "Size", formatter: (cell) => cell.getValue() || "—" },
      { title: "Total Mtrs Required", field: "runningMeters", hozAlign: "right", headerFilter: "input", headerFilterPlaceholder: "Mtrs", formatter: (cell) => {
        const value = cell.getValue();
        return Number.isFinite(Number(value)) ? `${Number(value).toLocaleString("en-IN", { maximumFractionDigits: 2 })} mtrs` : "—";
      } },
      { title: "Qty", field: "quantity", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#" },
      {
        title: "Bal",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `<span style="font-weight:700; color:#044A78;">${row.balance ?? row.quantity}</span>`;
        },
      },
      { title: "Machine", field: "machineName", headerFilter: "input", headerFilterPlaceholder: "Filter machine...", formatter: (cell) => cell.getValue() || "—" },
      // Raw-material allocation, split per pool (Facestock/Adhesive/Release
      // Liner) instead of one collapsed "Stock" column -- not Deckle reels
      // produced vs. rolls ordered (rollsStatus): a single Assign & Continue
      // only ever laminates one Deckle, so an order needing 2+ rolls would
      // read "short" on rollsStatus right after its very first,
      // fully-allocated run. facestockStatus/adhesiveStatus/releaseStatus
      // are the real ready/not-ready signal (see routes/fairdesk_route.js).
      // Each is null (rollType doesn't use that pool), "none" (red, nothing
      // allotted), "partial" (yellow, DOUBLE FACESTOCK/DOUBLE RELEASE with
      // only one of its two same-pool layers allotted), or "full" (green).
      ...["facestock", "adhesive", "release"].map((pool) => ({
        title: pool === "facestock" ? "Facestock" : pool === "adhesive" ? "Adhesive" : "Release",
        field: `${pool}Status`,
        hozAlign: "center",
        headerFilter: "list",
        headerFilterParams: { values: { "": "All", none: "Not allotted", partial: "Partial", full: "Fully allotted" } },
        headerFilterPlaceholder: "All",
        formatter: (cell) => {
          const status = cell.getValue();
          if (status === "none") return `<span style="color:#dc2626; font-weight:700;" title="Assign this layer before starting production"><i class="fa-solid fa-triangle-exclamation"></i> Not allotted</span>`;
          if (status === "partial") return `<span style="color:#ca8a04; font-weight:700;" title="Only part of this layer is allotted"><i class="fa-solid fa-circle-half-stroke"></i> Partial</span>`;
          if (status === "full") return `<span style="color:#16a34a; font-weight:700;"><i class="fa-solid fa-check"></i> Allotted</span>`;
          return `<span style="color:#9ca3af;">—</span>`;
        },
      })),
      { title: "Operator", field: "operatorName", headerFilter: "input", headerFilterPlaceholder: "Filter...", formatter: (cell) => cell.getValue() || "—" },
      { title: "Helper", field: "helperName", headerFilter: "input", headerFilterPlaceholder: "Filter...", formatter: (cell) => cell.getValue() || "—" },
      {
        title: "Live Status",
        field: "liveUpdate",
        headerSort: false,
        formatter: (cell) => {
          const orderId = cell.getRow().getData()._id;
          const val = cell.getValue();
          if (!val) return `<span style="color:#9ca3af;">Not started</span>`;
          const fmtMtrs = (value) => Number(value).toLocaleString("en-IN", { maximumFractionDigits: 2 });
          const settings = Array.isArray(val.settings) ? val.settings : [];
          const production = Array.isArray(val.production) ? val.production : [];
          const when = val.updatedAt ? new Date(val.updatedAt).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" }) : "";
          if (!production.length && settings.length) {
            return `<button type="button" onclick="openLiveStatus('${orderId}')" title="View Job Setting log" style="display:inline-flex; align-items:center; gap:6px; padding:0; border:none; background:transparent; color:#a16207; font-weight:700; cursor:pointer;"><span style="width:7px; height:7px; border-radius:50%; background:#eab308; display:inline-block;"></span>In Setting</button>`;
          }
          if (!production.length) return `<span style="color:#9ca3af;">Not started</span>`;
          return `
            <button type="button" onclick="openLiveStatus('${orderId}')" title="View production log" style="display:inline-flex; align-items:center; gap:6px; white-space:nowrap; padding:0; border:none; background:transparent; cursor:pointer;">
              <span style="width:7px; height:7px; border-radius:50%; background:#16a34a; display:inline-block; flex-shrink:0;"></span>
              <span style="font-weight:700; color:#1f2a44; text-decoration:underline;">${fmtMtrs(val.totalMeters)} mtrs</span>
              ${when ? `<span style="color:#9ca3af; font-size:11px;">@ ${when}</span>` : ""}
            </button>
          `;
        },
      },
      { title: "Remarks", field: "remarks", headerFilter: "input", headerFilterPlaceholder: "Filter remarks..." },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever's actually on
  // screen, top to bottom, is renumbered 1..n every time the table redraws.
  wipTable.on("renderComplete", function () {
    document.querySelectorAll("#wip-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  // Job Cards are filed once from the shop floor, not streamed -- poll so a
  // freshly filed card's Setting and Production Log rows show up here
  // without the operator having to reload the page.
  setInterval(async () => {
    try {
      const res = await fetch("/sachiko/labels/production/wip-progress");
      if (!res.ok) return;
      const updates = await res.json();
      if (Array.isArray(updates) && updates.length) wipTable.updateData(updates);
    } catch (err) {
      console.error("WIP live update poll failed:", err);
    }
  }, 20000);
  }

  document.getElementById("download-xlsx").addEventListener("click", () => {
    if (wipTable) {
      wipTable.download("xlsx", "wip_production.xlsx", { sheetName: "WIP" });
    } else if (table) {
      table.download("xlsx", "pending_production.xlsx", { sheetName: "PendingProduction" });
    }
  });

  const selector = document.getElementById("downloadSelector");
  const trigger = selector.querySelector(".download-selector__trigger");
  trigger.addEventListener("click", (e) => { e.stopPropagation(); selector.classList.toggle("download-selector--active"); });
  document.addEventListener("click", () => selector.classList.remove("download-selector--active"));
</script>
