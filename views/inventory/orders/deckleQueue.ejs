<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<style>
  .btn-action {
    height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
    font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
  }
  .btn-action:hover { opacity: 0.85; }
</style>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <div class="indi-head">
    <h1>Deckle Queue</h1>
    <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
      <a
        href="/app/labels/production/deckle-set"
        style="padding: 6px 14px; background: #044a78; color: white; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;"
        onmouseover="this.style.opacity = '0.85'" onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-ruler-combined"></i><span>Deckle Sorting</span>
      </a>
    </div>
  </div>

  <div id="deckle-queue-table" class="tabulator tabulator-modern"></div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="deckle-queue-data" type="application/json"><%- safeJson(rows || []) %></script>

<script>
  const rowsData = JSON.parse(document.getElementById("deckle-queue-data").textContent);

  const fmtMtrs = (v) => (Number.isFinite(Number(v)) ? Number(v).toLocaleString("en-IN", { maximumFractionDigits: 2 }) : "—");

  const fmtDate = (v) => {
    if (!v) return "—";
    const d = new Date(v);
    if (isNaN(d)) return "—";
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
  };

  // 12-hour clock, e.g. "03:45 PM"
  const fmtTime = (v) => {
    if (!v) return "—";
    const d = new Date(v);
    if (isNaN(d)) return "—";
    return d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", hour12: true });
  };

  window.startProduction = function (orderId) {
    window.location.href = `/app/labels/production/assign/${orderId}`;
  };

  const table = new Tabulator("#deckle-queue-table", {
    data: rowsData,
    placeholder: "No deckles waiting to be made",
    initialSort: [{ column: "createdAt", dir: "asc" }],
    columns: [
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `<button onclick="startProduction('${row._id}')" class="btn-action" style="background:#10b981;" title="Assign Production"><i class="fa-solid fa-play"></i> Play</button>`;
        },
      },
      { title: "Client", field: "clientName", headerFilter: "input", headerFilterPlaceholder: "Filter client...",
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (row.isBatch) return `<span class="ds-count-badge" style="display:inline-block;font-size:11px;font-weight:800;color:#044a78;background:#e0ecf8;border-radius:999px;padding:1px 9px;">Batch · ${row.orderCount} order${row.orderCount === 1 ? "" : "s"}</span>`;
          return `<span style="font-weight:600; color:#044A78;">${cell.getValue() || "N/A"}</span>`;
        } },
      { title: "SKU", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Filter SKU...", formatter: (cell) => `<span style="font-weight:600; color:#044A78;">${cell.getValue() || "N/A"}</span>` },
      { title: "Paper Size", field: "paperSize", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "Size" },
      {
        title: "Deckle Size",
        field: "deckleSize",
        hozAlign: "center",
        headerFilter: "input",
        headerFilterPlaceholder: "Size",
        formatter: (cell) => (cell.getValue() != null ? `<span style="font-weight:700; color:#044A78;">${cell.getValue()}mm</span>` : `<span style="color:#9ca3af;">—</span>`),
      },
      { title: "Running Mtrs", field: "runningMeters", hozAlign: "right", headerFilter: "input", headerFilterPlaceholder: "Mtrs",
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return row.runningMetersText ? row.runningMetersText : fmtMtrs(cell.getValue());
        } },
      { title: "Deckle Qty", field: "deckleQty", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#",
        formatter: (cell) => {
          const v = cell.getValue();
          return v != null && v !== "" ? `<span style="font-weight:700; color:#044A78;">${v}</span>` : `<span style="color:#9ca3af;">—</span>`;
        } },
      { title: "Date", field: "createdAt", hozAlign: "center", sorter: "string",
        formatter: (cell) => fmtDate(cell.getValue()) },
      { title: "Time", field: "createdAt", hozAlign: "center", headerSort: false,
        formatter: (cell) => fmtTime(cell.getValue()) },
    ],
  });

  table.on("renderComplete", function () {
    document.querySelectorAll("#deckle-queue-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });
</script>
