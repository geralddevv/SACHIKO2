<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<style>
  .btn-action {
    height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
    font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
  }
  .btn-action:hover { opacity: 0.85; }
</style>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <div class="indi-head">
    <h1>Deckle Queue</h1>
    <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
      <a
        href="/app/labels/production/deckle-set"
        style="padding: 6px 14px; background: #044a78; color: white; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;"
        onmouseover="this.style.opacity = '0.85'" onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-ruler-combined"></i><span>Deckle Sorting</span>
      </a>
    </div>
  </div>

  <div id="deckle-queue-table" class="tabulator tabulator-modern"></div>
</div>

<!-- Dissolve batch (hidden form, submitted from the table Actions). A batch is
     un-made from here now -- Deckle Sorting lists only orders still waiting on
     a deckle size. -->
<form id="dq-dissolve-form" method="post" action="" style="display:none;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <input type="hidden" name="from" value="queue" />
</form>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="deckle-queue-data" type="application/json"><%- safeJson(rows || []) %></script>

<script>
  const rowsData = JSON.parse(document.getElementById("deckle-queue-data").textContent);

  const fmtMtrs = (v) => (Number.isFinite(Number(v)) ? Number(v).toLocaleString("en-IN", { maximumFractionDigits: 2 }) : "—");

  const fmtDate = (v) => {
    if (!v) return "—";
    const d = new Date(v);
    if (isNaN(d)) return "—";
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "2-digit" });
  };

  // 12-hour clock, e.g. "03:45 PM"
  const fmtTime = (v) => {
    if (!v) return "—";
    const d = new Date(v);
    if (isNaN(d)) return "—";
    return d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", hour12: true });
  };

  window.startProduction = function (orderId) {
    window.location.href = `/app/labels/production/assign/${orderId}`;
  };

  // Un-make a batch: its member orders drop back to loose on Deckle Sorting,
  // ready to be set again.
  window.dissolveBatch = function (batchId) {
    if (!confirm("Dissolve this deckle batch? Its orders go back to Deckle Sorting.")) return;
    const form = document.getElementById("dq-dissolve-form");
    form.action = `/app/labels/production/deckle-batch/${batchId}/dissolve`;
    form.submit();
  };

  const table = new Tabulator("#deckle-queue-table", {
    data: rowsData,
    placeholder: "No deckles waiting to be made",
    initialSort: [{ column: "createdAt", dir: "asc" }],
    columns: [
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        width: 190,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const play = `<button onclick="startProduction('${row._id}')" class="btn-action" style="background:#10b981;" title="Assign Production"><i class="fa-solid fa-play"></i> Play</button>`;
          const dissolve = row.canDissolve
            ? `<button onclick="dissolveBatch('${row._id}')" class="btn-action" style="background:#b91c1c;" title="Dissolve batch — its orders go back to Deckle Sorting"><i class="fa-solid fa-link-slash"></i> Dissolve</button>`
            : "";
          return `<div style="display:inline-flex; gap:6px;">${play}${dissolve}</div>`;
        },
      },
      { title: "Product Code", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Filter code...",
        formatter: (cell) => `<span style="font-weight:700; color:#044A78;">${cell.getValue() || "N/A"}</span>` },
      {
        title: "Deckle Size",
        field: "deckleSize",
        hozAlign: "center",
        headerFilter: "input",
        headerFilterPlaceholder: "Size",
        formatter: (cell) => (cell.getValue() != null ? `<span style="font-weight:700; color:#044A78;">${cell.getValue()}mm</span>` : `<span style="color:#9ca3af;">—</span>`),
      },
      { title: "Running Mtrs", field: "runningMeters", hozAlign: "right", headerFilter: "input", headerFilterPlaceholder: "Mtrs",
        headerTooltip: "Length of ONE deckle web",
        formatter: (cell) => {
          const v = cell.getValue();
          return v != null ? `${fmtMtrs(v)} m` : `<span style="color:#9ca3af;">—</span>`;
        } },
      { title: "Total Running Mtrs", field: "totalRunningMeters", hozAlign: "right", headerFilter: "input", headerFilterPlaceholder: "Mtrs",
        headerTooltip: "The whole job — every roll slit off this deckle",
        formatter: (cell) => {
          const v = cell.getValue();
          return v != null ? `<span style="font-weight:700; color:#044A78;">${fmtMtrs(v)} m</span>` : `<span style="color:#9ca3af;">—</span>`;
        } },
      { title: "Deckle Qty", field: "deckleQty", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#",
        formatter: (cell) => {
          const v = cell.getValue();
          return v != null && v !== "" ? `<span style="font-weight:700; color:#044A78;">${v}</span>` : `<span style="color:#9ca3af;">—</span>`;
        } },
      // How many sales orders this one deckle covers. A legacy per-order row
      // isn't a batch at all, so it carries nothing rather than a bare "1".
      { title: "Batch", field: "orderCount", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#",
        headerTooltip: "Orders covered by this deckle batch",
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return row.isBatch
            ? `<span style="font-weight:700; color:#044A78;">${cell.getValue()}</span>`
            : `<span style="color:#9ca3af;">—</span>`;
        } },
      { title: "Date", field: "createdAt", hozAlign: "center", sorter: "string",
        formatter: (cell) => fmtDate(cell.getValue()) },
      { title: "Time", field: "createdAt", hozAlign: "center", headerSort: false,
        formatter: (cell) => fmtTime(cell.getValue()) },
    ],
  });

  table.on("renderComplete", function () {
    document.querySelectorAll("#deckle-queue-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });
</script>
