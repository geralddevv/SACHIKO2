</div>

<% if (typeof orderToEdit !== 'undefined' && orderToEdit && !(typeof confirmMode !== 'undefined' && confirmMode)) { %>
<div id="cancel-order-dialog" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center;">
  <div style="background:#fff; border-radius:10px; width:440px; max-width:90%; box-shadow:0 4px 20px rgba(0,0,0,0.22); overflow:hidden;">
    <div style="padding:22px 22px 0;">
      <p style="margin:0; color:#111827; font-size:16px; font-weight:600; line-height:1.5;"><i class="fa-solid fa-triangle-exclamation" style="color:#ef4444; margin-right:6px;"></i>Cancel this order?</p>
      <p style="margin:8px 0 0; color:#6b7280; font-size:13px;">This cannot be undone.</p>
      <div style="margin-top:14px;">
        <label style="font-size:13px; font-weight:600; color:#374151; display:block; margin-bottom:5px;">Reason for Cancellation <span style="color:#ef4444">*</span></label>
        <textarea id="cancel-order-reason" rows="3" placeholder="Enter reason..." style="width:100%; padding:10px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; resize:none; font-family:inherit; box-sizing:border-box;"></textarea>
      </div>
    </div>
    <div style="padding:14px 22px 18px; display:flex; justify-content:flex-end; gap:10px; margin-top:8px;">
      <button type="button" onclick="closeCancelOrderDialog()" style="padding:9px 18px; border:1px solid #d1d5db; background:#fff; color:#374151; border-radius:6px; cursor:pointer; font-weight:600; font-size:13px;" onmouseover="this.style.background='#f3f4f6'" onmouseout="this.style.background='#fff'">Go Back</button>
      <button type="button" onclick="submitCancelOrder()" style="padding:9px 18px; border:none; background:#ef4444; color:#fff; border-radius:6px; cursor:pointer; font-weight:700; font-size:13px;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">Yes, Cancel Order</button>
    </div>
  </div>
</div>

<script>
  function openCancelOrderDialog() {
    document.getElementById("cancel-order-reason").value = "";
    document.getElementById("cancel-order-reason").style.borderColor = "#d1d5db";
    document.getElementById("cancel-order-dialog").style.display = "flex";
    setTimeout(() => document.getElementById("cancel-order-reason").focus(), 30);
  }
  function closeCancelOrderDialog() {
    document.getElementById("cancel-order-dialog").style.display = "none";
  }
  function submitCancelOrder() {
    const reason = document.getElementById("cancel-order-reason").value.trim();
    if (!reason) {
      document.getElementById("cancel-order-reason").style.borderColor = "#ef4444";
      document.getElementById("cancel-order-reason").focus();
      return;
    }
    const csrf = document.querySelector('meta[name="csrf-token"]')?.content || "";
    const form = document.createElement("form");
    form.method = "POST";
    form.action = "/sachiko/sales/order/status";
    [["orderId", "<%= orderToEdit._id %>"], ["status", "CANCELLED"], ["cancelReason", reason], ["_csrf", csrf]].forEach(([n, v]) => {
      const inp = document.createElement("input");
      inp.type = "hidden"; inp.name = n; inp.value = v;
      form.appendChild(inp);
    });
    document.body.appendChild(form);
    form.submit();
  }
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeCancelOrderDialog();
  });
</script>
<% } %>

<style>
  /* Stock-status bar (location selector + Total/Booked/Balance) hidden from
     the top of this form -- !important so it stays hidden even though the
     JS below still rebuilds/re-shows it (stockDisplay.style.display =
     "block") as the client/item/location selection changes; that JS is left
     running since it's also what keeps the hidden #source-location input in
     sync, which POST /sales/order still reads. */
  #stock-display {
    display: none !important;
  }

  .location-option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: 5px;
    cursor: pointer;
    padding: 5px 8px;
