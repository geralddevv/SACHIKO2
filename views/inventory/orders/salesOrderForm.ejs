  async function refreshLogsSection() {
    try {
      const res = await fetch(window.location.href);
      const html = await res.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      
      const currentLogs = document.getElementById('logs-wrapper');
      const newLogs = doc.getElementById('logs-wrapper');
      if (currentLogs && newLogs) {
        currentLogs.innerHTML = newLogs.innerHTML;
      }

      const currentConfirmQty = document.getElementById('confirm-quantity');
      const newConfirmQty = doc.getElementById('confirm-quantity');
      if (currentConfirmQty && newConfirmQty) {
        currentConfirmQty.value = newConfirmQty.value;
      }

      // Extract new stockInfo from the HTML script tags 
      const scripts = doc.getElementsByTagName('script');
      for (let s of scripts) {
        if (s.textContent.includes('const stockInfo =')) {
          const match = s.textContent.match(/const stockInfo = (.*?);/);
          if (match && match[1] && match[1] !== 'null') {
            try {
               const newStockData = JSON.parse(match[1]);
               const itemOpt = document.querySelector('#item-select option');
               if (itemOpt) {
                 itemOpt.dataset.stock = JSON.stringify(newStockData);
                 updateStockDisplay();
               }
            } catch(e) { console.error("Error parsing new stock info", e); }
            break;
          }
        }
      }
    } catch (err) {
      console.error("Failed to refresh logs smoothly", err);
      window.location.reload(); // Fallback
    }
  }

  async function submitEditLog() {
    const logId = document.getElementById('edit-log-id').value;
    const qty = parseInt(document.getElementById('edit-log-qty').value);
    const invoiceNumber = document.getElementById('edit-log-invoice').value.trim();
    const date = document.getElementById('edit-log-date').value;

    if (!qty || qty < 1) {
      showToast('Quantity must be at least 1.', 'error');
      return;
    }

    try {
      const res = await fetch(`/sachiko/sales/order/log/${logId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ quantity: qty, invoiceNumber, date })
      });
      const data = await res.json();
      if (data.success) {
        showToast('Log updated successfully!', false);
        await refreshLogsSection();
      } else {
        showToast(data.message || 'Failed to update log.', 'error');
      }
    } catch (err) {
      console.error('Edit log error:', err);
      showToast('Something went wrong.', 'error');
    }
    closeEditDialog();
  }

  async function submitDeleteLog() {
    const logId = document.getElementById('delete-log-id').value;

    try {
      const res = await fetch(`/sachiko/sales/order/log/${logId}`, {
        method: 'DELETE'
      });
      const data = await res.json();
      if (data.success) {
        showToast('Log deleted successfully!', false);
        await refreshLogsSection();
      } else {
        showToast(data.message || 'Failed to delete log.', 'error');
      }
    } catch (err) {
      console.error('Delete log error:', err);
      showToast('Something went wrong.', 'error');
    }
    closeDeleteDialog();
  }

  /* ================================================================
   *  MULTI-ITEM PO  --  the "Order Items" table (create mode only)
   *
   *  For a NEW Label Stock order the scattered single-item fields (Product
   *  Code picker, Paper Size, RM, No of Rolls, Rate) are hidden and every
   *  product line -- including the first -- lives as a row in this table.
   *  On submit all rows are sent as lines[0..N] so POST /sales/order takes
   *  its multi-line branch (one TapeSalesOrder per line, shared poNumber /
   *  poGroupId / header).
   *
   *  Editing an existing order, dispatch/confirm, and TAPE orders keep the
   *  original single-item fields and logic untouched.
   * ================================================================ */
  const aiChoices = new Map(); // <select>.ai-product  ->  Choices instance
  const aiPrefillItemId = new URLSearchParams(window.location.search).get("item") || "";
  let aiPrefillDone = false;

  // The single-item fields this table replaces while it's driving the form.
  const AI_LEGACY_FIELD_IDS = [
    "item-select-wrap", "label-stock-product-div", "paper-size-div",
    "running-meters-div", "no-of-rolls-div", "quantity-div",
    "item-rate-div", "order-rate-div", "selected-item-details",
  ];

  function aiBody() { return document.getElementById("additional-items-body"); }
  function aiRows() { return aiBody() ? [...aiBody().querySelectorAll(".ai-row")] : []; }
  function aiRowCount() { return aiRows().length; }

  // Table mode = new Label Stock order. When true, this table is the sole
  // item editor and every submit goes through the multi-line branch.
  function aiTableMode() {
    return !confirmMode && !orderToEdit && isLabelStockItemType(itemTypeSelect.value);
  }
  // Kept as the name the submit handler checks.
  function aiIsActive() { return aiTableMode() && aiRowCount() > 0; }

  // The Select Item / Product Code slot is gone in table mode, so stretch the
  // header fields to fill the 32-col row instead of leaving a trailing gap.
  const AI_HEADER_SPANS = {
    "deckle-option-div": 6,
    "item-type-div": 6,
    "client-name-div": 7,
    "user-name-div": 7,
    "user-location-div": 6,
  };

  function aiHideLegacyFields() {
    AI_LEGACY_FIELD_IDS.forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.style.display = "none";
    });
    if (itemSelect) itemSelect.required = false;
    if (quantityInput) quantityInput.required = false;
    const remarksWrap = document.getElementById("remarks-wrap");
    if (remarksWrap) remarksWrap.style.gridColumn = "span 20";
    Object.entries(AI_HEADER_SPANS).forEach(([id, n]) => {
      const el = document.getElementById(id);
      if (el) el.style.gridColumn = `span ${n}`;
    });
  }

  function aiApplyTableMode(on) {
    if (on) {
      aiHideLegacyFields();
      return;
    }
    AI_LEGACY_FIELD_IDS.forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.style.display = "";
    });
    Object.keys(AI_HEADER_SPANS).forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.style.gridColumn = "";
    });
    // Hand layout back to the normal single-item visibility logic.
    updateLabelStockFieldsVisibility();
    renderSelectedItemDetailsTable();
  }

  function aiSkuToProductMap() {
    const want = itemTypeSelect.value;
    const seen = new Map();
    (allLabelStockMasters || [])
      .filter((m) => !want || (m.rollOrSheet || "").toUpperCase() === want)
      .forEach((m) => {
        const sku = m.skuCode || "";
        if (sku && !seen.has(sku)) seen.set(sku, m.productCode || sku);
      });
    return seen;
  }

  function aiPopulateRowSelect(row, keepValue) {
    const sel = row.querySelector(".ai-product");
    const inst = aiChoices.get(sel);
    if (!inst) return;
    const cur = keepValue ? sel.value : "";
    const seen = aiSkuToProductMap();
    inst.clearStore();
    inst.setChoices(
      [
        { value: "", label: "Select Product Code", disabled: true, selected: !cur },
        ...[...seen].map(([v, l]) => ({ value: v, label: l, selected: v === cur })),
      ],
      "value", "label", true,
    );
  }

  // Row-scoped port of onLabelStockProductChange: resolve the picked SKU to an
  // existing binding for this client/location if one exists (fills Paper Size /
  // RM / Rate from it), otherwise fall back to the master id -- POST
  // /sales/order auto-creates the binding from the row's Rate + the header
  // location.
  function aiOnRowProductChange(row) {
    const sel = row.querySelector(".ai-product");
    const sku = sel.value || "";
    const itemIdInp = row.querySelector(".ai-item-id");
    const masterIdInp = row.querySelector(".ai-master-id");
    const rateInp = row.querySelector(".ai-rate");

    const match = sku
      ? (latestLabelStockItems || []).find((it) => (it.details?.skuCode || "") === sku)
      : null;

    if (match) {
      itemIdInp.value = match._id;
      masterIdInp.value = "";
      // Paper Size and RM are never auto-filled -- always entered by hand.
      if (!rateInp.dataset.userEdited) {
        const newRate = match.rate != null && match.rate !== "" ? String(match.rate) : "";
        if (newRate !== rateInp.value) {
          rateInp.value = newRate;
          // Auto-filled from the binding -- must be confirmed (click) before submit.
          rateInp.dataset.rateAutofilled = "1";
          aiSetRateAck(rateInp, false);
        }
      }
      return;
    }

    itemIdInp.value = "";
    const master = sku ? (allLabelStockMasters || []).find((m) => (m.skuCode || "") === sku) : null;
    masterIdInp.value = master?._id || "";
    // No binding -> Rate is entered by hand. Drop a stale auto-filled value so
    // the user types a fresh one; nothing to acknowledge.
    if (!rateInp.dataset.userEdited && rateInp.dataset.rateAutofilled === "1") rateInp.value = "";
    rateInp.dataset.rateAutofilled = "";
    aiSetRateAck(rateInp, true);
  }

  // Rate acknowledgement: an auto-filled Rate shows yellow until the user
  // clicks (focuses) or edits it; an unconfirmed Rate blocks add-row + submit.
  function aiSetRateAck(rateInp, acked) {
    if (!rateInp) return;
    rateInp.dataset.rateAck = acked ? "1" : "";
    rateInp.classList.toggle("ai-rate-unack", !acked);
  }

  function aiRenumber() {
    aiRows().forEach((row, i) => {
      const cell = row.querySelector(".ai-row-num");
      if (cell) cell.textContent = String(i + 1);
      // Row 1 is mandatory -- it can't be removed.
      const btn = row.querySelector(".ai-remove");
      if (btn) btn.style.visibility = i === 0 ? "hidden" : "visible";
    });
  }

  function aiDestroyRow(row) {
    const sel = row.querySelector(".ai-product");
    const inst = aiChoices.get(sel);
    if (inst) inst.destroy();
    aiChoices.delete(sel);
    row.remove();
  }

  // manual = a user click on "+ Add Item"; block it until the existing rows
  // are fully filled. Programmatic calls (first row, item-type switch) pass
  // manual = false.
  function aiAddRow(manual) {
    const tpl = document.getElementById("additional-item-row-tpl");
    if (!tpl) return;
    if (manual === true && aiRowCount() > 0) {
      const err = aiValidateRows();
      if (err) {
        if (typeof showToast === "function") showToast(`Fill the current item first — ${err}`, "error");
        return;
      }
    }
    const frag = tpl.content.cloneNode(true);
    const row = frag.querySelector(".ai-row");
    aiBody().appendChild(frag);

    const sel = row.querySelector(".ai-product");
    const inst = new Choices(sel, { searchEnabled: true, shouldSort: false, itemSelectText: "", searchPlaceholderValue: "Search product…" });
    aiChoices.set(sel, inst);
    aiPopulateRowSelect(row, false);

    // Choices renders its dropdown absolutely-positioned; the scroll wrapper
    // would clip it, so lift the wrapper's overflow (and this row) while open.
    const wrap = document.querySelector("#additional-items-wrap .ai-table-wrap");
    sel.addEventListener("showDropdown", () => {
      if (wrap) wrap.classList.add("dropdown-open");
      row.style.position = "relative";
      row.style.zIndex = "30";
    });
    sel.addEventListener("hideDropdown", () => {
      if (wrap) wrap.classList.remove("dropdown-open");
      row.style.zIndex = "";
    });

    sel.addEventListener("change", () => aiOnRowProductChange(row));
    [".ai-paper-size", ".ai-rm", ".ai-rate"].forEach((c) => {
      const el = row.querySelector(c);
      el.addEventListener("input", () => { el.dataset.userEdited = "1"; });
    });
    // Confirm the auto-filled Rate on click (focus) or manual edit.
    const rateEl = row.querySelector(".ai-rate");
    rateEl.addEventListener("focus", () => aiSetRateAck(rateEl, true));
    rateEl.addEventListener("input", () => aiSetRateAck(rateEl, true));
    row.querySelector(".ai-remove").addEventListener("click", () => {
      if (aiRowCount() <= 1) return; // keep at least one item
      aiDestroyRow(row);
      aiRenumber();
    });

    aiRenumber();
    return row;
  }

  function aiOnItemTypeChange() {
    const wrap = document.getElementById("additional-items-wrap");
    if (!wrap) return;
    const on = aiTableMode();
    wrap.style.display = on ? "" : "none";
    aiApplyTableMode(on);
    if (!on) {
      aiRows().forEach(aiDestroyRow);
      return;
    }
    if (aiRowCount() === 0) aiAddRow();
    aiRows().forEach((row) => { aiPopulateRowSelect(row, true); aiOnRowProductChange(row); });
    aiRenumber();
  }

  // Re-resolve every row against a freshly-loaded binding list (loadItems),
  // and honour a ?item= prefill (from the "order this binding" shortcuts).
  function aiSyncRows() {
    if (!document.getElementById("additional-items-wrap") || !aiTableMode()) return;
    if (aiPrefillItemId && !aiPrefillDone) {
      const row0 = aiRows()[0];
      const it = (latestLabelStockItems || []).find((x) => String(x._id) === String(aiPrefillItemId));
      if (row0 && it && it.details?.skuCode && !row0.querySelector(".ai-item-id").value) {
        const sel = row0.querySelector(".ai-product");
        const inst = aiChoices.get(sel);
        if (inst) inst.setChoiceByValue(it.details.skuCode);
        sel.value = it.details.skuCode;
        aiPrefillDone = true;
      }
    }
    aiRows().forEach((row) => { aiPopulateRowSelect(row, true); aiOnRowProductChange(row); });
  }

  function aiValidateRows() {
    const rows = aiRows();
    if (!rows.length) return "Add at least one item.";
    for (let i = 0; i < rows.length; i++) {
      const r = rows[i];
      const n = i + 1;
      if (!(r.querySelector(".ai-item-id").value || r.querySelector(".ai-master-id").value)) return `Item ${n}: select a Product Code.`;
      const ps = parseFloat(r.querySelector(".ai-paper-size").value);
      if (!(ps > 0)) return `Item ${n}: Paper Size is required.`;
      if (ps >= 1000) return `Item ${n}: Paper Size must be less than 1000.`;
      const rm = parseFloat(r.querySelector(".ai-rm").value);
      if (!(rm > 0)) return `Item ${n}: RM must be greater than 0.`;
      if (rm > 2000) return `Item ${n}: RM cannot exceed 2000.`;
      if (!(parseInt(r.querySelector(".ai-rolls").value, 10) > 0)) return `Item ${n}: No of Rolls must be greater than 0.`;
      const rateEl = r.querySelector(".ai-rate");
      if (!(parseFloat(rateEl.value) > 0)) return `Item ${n}: Rate must be greater than 0.`;
      if (rateEl.dataset.rateAutofilled === "1" && rateEl.dataset.rateAck !== "1") {
        return `Item ${n}: click the Rate field to confirm the auto-filled rate.`;
      }
    }
    return "";
  }

  function aiAppendLines(payload) {
    aiRows().forEach((r, i) => {
      const ln = {
        itemId: r.querySelector(".ai-item-id").value || "",
        labelStockMasterId: r.querySelector(".ai-master-id").value || "",
        paperSize: (r.querySelector(".ai-paper-size").value || "").trim(),
        runningMeters: (r.querySelector(".ai-rm").value || "").trim(),
        noOfRolls: (r.querySelector(".ai-rolls").value || "").trim(),
        itemRate: (r.querySelector(".ai-rate").value || "").trim(),
      };
      Object.entries(ln).forEach(([k, v]) => payload.append(`lines[${i}][${k}]`, v));
    });
  }

  // loadItems refreshes the binding list for the chosen user+location -- rerun
  // row resolution afterwards so rows pick up matching bindings too.
  if (typeof loadItems === "function") {
    const _aiOrigLoadItems = loadItems;
    loadItems = function (...args) {
      const ret = _aiOrigLoadItems.apply(this, args);
      Promise.resolve(ret).then(() => { try { aiSyncRows(); } catch (e) {} }).catch(() => {});
      return ret;
    };
  }

  window.addEventListener("load", () => {
    if (confirmMode || orderToEdit) return;
    const addBtn = document.getElementById("add-line-btn");
    if (!addBtn) return;
    addBtn.addEventListener("click", () => aiAddRow(true));
    aiOnItemTypeChange(); // Item Type defaults to ROLL -> table mode on, 1 row
  });
</script>
