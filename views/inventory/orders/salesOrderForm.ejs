<% layout('/layout/boilerplate') -%>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px;">
  <form id="sales-order-form" action="<%= typeof confirmMode !== 'undefined' && confirmMode ? '/sachiko/sales/order/status' : '/sachiko/sales/order' %>" method="post" class="needs-validation" autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="orderId" value="<%= typeof orderToEdit !== 'undefined' && orderToEdit ? orderToEdit._id : '' %>" />
    <input type="hidden" name="submissionToken" value="<%= typeof submissionToken !== 'undefined' && submissionToken ? submissionToken : '' %>" />
    <% if (typeof confirmMode !== 'undefined' && confirmMode) { %>
      <input type="hidden" name="status" value="CONFIRMED" />
    <% } %>
    <div class="span-full form-heading">
      <h1><%= typeof confirmMode !== 'undefined' && confirmMode ? 'Dispatch Order' : (typeof orderToEdit !== 'undefined' && orderToEdit ? 'Edit Sales Order' : 'Sales Order') %></h1>
      <% if (typeof orderToEdit !== 'undefined' && orderToEdit) {
           const _dispDate = orderToEdit.poDate || orderToEdit.createdAt;
           const _dispDateStr = _dispDate ? new Date(_dispDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: '2-digit' }) : null;
      %>
        <% if (_dispDateStr) { %>
          <span style="font-size:13px; font-weight:500; color:#6b7280; margin-left:10px;">
            <%= orderToEdit.poDate ? 'PO Date:' : 'Created:' %> <strong style="color:#044a78;"><%= _dispDateStr %></strong>
          </span>
        <% } %>
      <% } %>
    </div>

    <%
      const initialLocations = Array.isArray(locations) ? locations : [];
      const initialStock = typeof stockInfo !== 'undefined' && stockInfo ? stockInfo : null;
      const initialTotal = initialStock ? (initialStock.totalStock ?? '-') : '-';
      const initialBooked = initialStock ? (initialStock.booked ?? '-') : '-';
      const initialBalance = initialStock ? (initialStock.balance ?? '-') : '-';
      const initialLocationRows = initialLocations.map((locName) => {
        const normalizedLoc = String(locName || "").trim();
        const locKey = normalizedLoc.toUpperCase();
        const locStock = initialStock && Array.isArray(initialStock.locations)
          ? initialStock.locations.find((entry) => String(entry?.location || "").trim().toUpperCase() === locKey)
          : null;
        const locQty = locStock ? (locStock.qty ?? 0) : '-';
        const locBooked = locStock ? (locStock.booked ?? 0) : '-';
        const locBalance = locStock ? (locStock.balance ?? 0) : '-';
        return `
          <label class="location-option${normalizedLoc === 'ALL' ? ' selected' : ''}" data-location="${normalizedLoc}" data-qty="${locQty}" data-booked="${locBooked}" data-balance="${locBalance}">
            <input type="radio" name="locationRadio" class="location-radio" value="${normalizedLoc}" data-qty="${locQty}" data-booked="${locBooked}" data-balance="${locBalance}"${normalizedLoc === 'ALL' ? ' checked' : ''} />
            <span class="location-label">${normalizedLoc}:</span>
            <span class="location-qty">${locQty}</span>
          </label>`;
      }).join("");
    %>

    <!-- Stock Status Bar with Location Selection -->
    <div id="stock-display" class="span-full" style="display: flex; padding: 10px 15px; background: #fff; border: 1px solid #044A78; border-radius: 0.5rem; transition: all 0.3s ease; overflow-x: auto; overflow-y: hidden;">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 22px; flex-wrap: nowrap; width: max-content; min-width: 100%;">
        <div style="display: flex; flex-wrap: nowrap; align-items: center; white-space: nowrap;">
          <label class="location-option selected" data-location="ALL" data-qty="<%= initialTotal %>" data-booked="<%= initialBooked %>" data-balance="<%= initialBalance %>">
            <input type="radio" name="locationRadio" class="location-radio" value="ALL" data-qty="<%= initialTotal %>" data-booked="<%= initialBooked %>" data-balance="<%= initialBalance %>" checked />
            <span class="location-label">ALL:</span>
            <span class="location-qty"><%= initialTotal %></span>
          </label>
          <%- initialLocationRows %>
        </div>
        <div id="stock-stats" style="display: flex; gap: 14px; align-items: center; flex-wrap: nowrap; white-space: nowrap;">
          <div style="font-weight: 700; color: #044A78; font-size: 16px;">
            <i class="fa-solid fa-box-open"></i> Total: <span id="stat-total"><%= initialTotal %></span>
          </div>
          <div style="font-weight: 700; color: #d97706; font-size: 16px;" title="Pending Orders">
            <i class="fa-regular fa-clock"></i> Booked: <span id="stat-booked"><%= initialBooked %></span>
          </div>
          <div style="font-weight: 700; color: #059669; font-size: 16px;" title="Available for new orders">
            <i class="fa-solid fa-scale-balanced"></i> Balance: <span id="stat-balance"><%= initialBalance %></span>
          </div>
        </div>
      </div>
    </div>
    <input type="hidden" name="sourceLocation" id="source-location" />

    <!-- ================= ORDER TYPE ================= -->
    <div class="span-full form-subheading">
      <h1>Order Details</h1>
    </div>

    <div class="span-four" id="deckle-option-div">
      <label for="deckle-option">Deckle Option</label>
      <select name="deckleOption" id="deckle-option" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select Option</option>
        <option value="DECKLE_FREE">Deckle Free</option>
        <option value="DECKLE_SET">Deckle Set</option>
      </select>
    </div>

    <div class="span-four" id="item-type-div">
      <label for="item-type">Item Type</label>
      <select name="itemType" id="item-type" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select Item Type</option>
        <option value="ROLL">Roll</option>
        <option value="SHEET">Sheet</option>
      </select>
    </div>

    <div class="span-six" id="client-name-div">
      <label for="client-name">Client Name</label>
      <select name="clientName" id="client-name" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select Client</option>
        <% clients?.forEach(client => { %>
          <option value="<%= client %>"><%= client %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-six" id="user-name-div">
      <label for="user-name">User Name</label>
      <select name="userId" id="user-name" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select User</option>
      </select>
      <input type="hidden" name="userName" id="user-name-hidden" />
    </div>

    <div class="span-five" id="user-location-div">
      <label for="user-location">Location</label>
      <select id="user-location" name="userLocation" class="form-control select-tag">
        <option value="" disabled selected hidden>Location</option>
      </select>
    </div>

    <div class="span-seven" id="item-select-wrap">
      <label for="item-select">Select Item</label>
      <select name="itemId" id="item-select" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select Item</option>
      </select>
    </div>

    <!-- Label Stock items can share the same product code across several
         bindings that only differ by paper size / running meters, so a single
         "Select Item" dropdown (labelled just by product code) can't tell
         them apart. For LABEL_STOCK this select replaces it and resolves down
         to a matching binding (the first one found, if more than one shares
         the code), which then drives the same hidden #item-select (and
         therefore all the existing rate/stock/details logic) exactly as a
         direct pick would. -->
    <div class="span-three" id="label-stock-product-div" style="display:none;">
      <label for="label-stock-product-select">Product Code</label>
      <select id="label-stock-product-select" class="form-control select-tag">
        <option value="" disabled selected hidden>Select Product Code</option>
      </select>
      <!-- Set only when the picked product has no existing Label Stock
           Binding for this client/user -- POST /sales/order auto-creates one
           from this master id plus whatever's typed for Rate/Paper Size/RM,
           instead of requiring the binding to already exist (itemId stays
           empty in that case; see onLabelStockProductChange). -->
      <input type="hidden" name="labelStockMasterId" id="label-stock-master-id" />
    </div>

    <!-- Kept right next to Product Code (rather than down in Order Info with
         the rest of Label Stock's extra fields) since they describe the item
         being picked, not the order itself. -->
    <div class="span-three" id="paper-size-div" style="display:none;">
      <label for="paper-size">Paper Size</label>
      <input type="text" id="paper-size" name="paperSize" class="form-control" placeholder="Enter paper size" />
    </div>

    <div class="span-two" id="running-meters-div" style="display:none;">
      <label for="running-meters">RM</label>
      <input type="text" inputmode="numeric" id="running-meters" name="runningMeters" class="form-control" placeholder="Enter RM" />
    </div>

    <div id="selected-item-details" class="span-full" style="padding:0;background:#fff;border:1px solid #044A78;border-radius:4px;display:none;"></div>

    <!-- ================= QUANTITY & DATE ================= -->
    <div class="span-full form-subheading">
      <h1>Order Info</h1>
    </div>

    <div class="span-three">
      <label for="po-date">PO Date</label>
      <input type="date" id="po-date" name="poDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" />
    </div>

    <div class="span-four">
      <label for="po-number">PO Number</label>
      <input type="text" id="po-number" name="poNumber" class="form-control" placeholder="Enter PO number" required />
    </div>

    <div class="span-four" id="quantity-div">
      <label for="quantity">Order Quantity <span id="qty-unit-badge" style="display:none;font-size:11px;font-weight:600;color:#044A78;background:#eef0ff;padding:1px 8px;border-radius:20px;margin-left:4px;"></span></label>
      <input type="text" inputmode="numeric" id="quantity" name="quantity" class="form-control" placeholder="Enter quantity" required />
    </div>

    <div class="span-three" id="no-of-rolls-div" style="display:none;">
      <label for="no-of-rolls">No of Rolls</label>
      <input type="text" inputmode="numeric" id="no-of-rolls" name="noOfRolls" class="form-control" placeholder="Enter no of rolls" />
    </div>

    <div class="span-three" id="item-rate-div">
      <label for="item-rate">Rate</label>
      <input type="text" id="item-rate" name="itemRate" class="form-control" placeholder="Rate" inputmode="decimal" readonly />
    </div>

    <div class="span-three" id="order-rate-div">
      <label for="order-rate">Curr Rate</label>
      <input type="text" id="order-rate" name="orderRate" class="form-control" placeholder="Enter current rate" inputmode="decimal" />
    </div>

    <div class="span-five">
      <label for="estimated-date">Est Delivery Date</label>
      <input type="date" id="estimated-date" name="estimatedDate" class="form-control" required />
    </div>

    <div class="span-half" id="remarks-wrap" style="grid-column: span 10;">
      <label for="remarks">Remarks (Optional)</label>
      <input type="text" id="remarks" name="remarks" class="form-control" placeholder="Any special instructions..." />
    </div>

    <%
      // The line-items table is create-only: editing an existing order
      // (orderToEdit) and dispatch (confirmMode) stay strictly single-line.
      const showAdditionalItems = !(typeof confirmMode !== 'undefined' && confirmMode)
        && !(typeof orderToEdit !== 'undefined' && orderToEdit);
    %>
    <% if (showAdditionalItems) { %>
    <div id="additional-items-wrap" class="span-full" style="display:none;">
      <div class="form-subheading" style="margin-top:2px;"><h1>Order Items</h1></div>
      <div class="ai-table-wrap">
        <table class="ai-table" id="additional-items-table">
          <thead>
            <tr>
              <th style="width:34px;">#</th>
              <th style="min-width:190px;">Product Code</th>
              <th style="min-width:120px;">Paper Size</th>
              <th style="min-width:90px;">RM</th>
              <th style="min-width:96px;">No of Rolls</th>
              <th style="min-width:90px;">Rate</th>
              <th style="width:42px;"></th>
            </tr>
          </thead>
          <tbody id="additional-items-body"></tbody>
        </table>
      </div>
      <button type="button" id="add-line-btn" class="ai-add-btn">
        <i class="fa-solid fa-plus"></i> Add Item
      </button>
    </div>

    <template id="additional-item-row-tpl">
      <tr class="ai-row">
        <td class="ai-row-num"></td>
        <td>
          <select class="ai-product form-control select-tag">
            <option value="" disabled selected hidden>Select Product Code</option>
          </select>
          <input type="hidden" class="ai-item-id" />
          <input type="hidden" class="ai-master-id" />
        </td>
        <td><input type="text" class="ai-paper-size form-control" placeholder="Paper Size" /></td>
        <td><input type="text" inputmode="numeric" class="ai-rm form-control" placeholder="RM" /></td>
        <td><input type="text" inputmode="numeric" class="ai-rolls form-control" placeholder="Rolls" /></td>
        <td><input type="text" inputmode="decimal" class="ai-rate form-control" placeholder="Rate" /></td>
        <td style="text-align:center;">
          <button type="button" class="ai-remove" title="Remove item" style="background:none;border:none;color:#ef4444;cursor:pointer;font-size:15px;">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </td>
      </tr>
    </template>

    <style>
      /* Scrolls horizontally only when the columns don't fit; while a Product
         Code dropdown is open the JS adds .dropdown-open so the list isn't
         clipped by this container. */
      .ai-table-wrap { overflow-x: auto; }
      .ai-table-wrap.dropdown-open { overflow: visible; }
      .ai-table { width:100%; border-collapse:collapse; font-size:13px; }
      .ai-table th, .ai-table td { padding:5px 8px; border-bottom:1px solid #e5e7eb; border-right:1px solid #e5e7eb; text-align:left; vertical-align:top; }
      .ai-table tr > *:last-child { border-right:none; }
      .ai-table th { color:#044a78; font-weight:700; white-space:nowrap; background:#f0f7ff; }
      .ai-table .ai-row-num { color:#6b7280; font-weight:700; text-align:center; padding-top:12px; }
      .ai-table input.form-control { padding:7px 9px !important; font-size:13px !important; height:auto !important; }
      /* Auto-filled Rate awaiting confirmation -- subtle yellow until clicked. */
      .ai-table input.ai-rate.ai-rate-unack { background:#fef9c3 !important; }
      .ai-table input.ai-rate.ai-rate-unack:focus { background:#fff !important; }
      .ai-add-btn { margin-top:10px; background:#044a78; color:#fff; border:none; border-radius:6px; padding:8px 16px; font-weight:700; font-size:13px; cursor:pointer; display:inline-flex; align-items:center; gap:7px; }
      .ai-add-btn:hover { background:#03365a; }
      #additional-items-table .choices { margin-bottom:0; }
      #additional-items-table .choices__list--dropdown { z-index:99999; }
    </style>
    <% } %>

    <!-- Stock Warning -->
    <div id="stock-warning" class="span-full" style="display: none; padding: 8px 15px; background: #fef3c7; border: 1px solid #f59e0b; border-radius: 0.5rem; color: #92400e; font-size: 14px; font-weight: 500;">
      <i class="fa-solid fa-triangle-exclamation" style="margin-right: 6px;"></i>
      <span id="stock-warning-text"></span>
    </div>

    <!-- ================= CONFIRMATION DETAILS (only in confirm mode) ================= -->
    <% if (typeof confirmMode !== 'undefined' && confirmMode) { %>
    <div id="confirmation-section" class="span-full form-subheading">
      <h1>Confirmation Details</h1>
    </div>

    <div class="span-penta">
      <label for="confirm-date">Date</label>
      <input type="date" id="confirm-date" name="confirmDate" class="form-control" required />
    </div>

    <div class="span-hexa">
      <label for="invoice-number">Invoice Number</label>
      <input type="text" id="invoice-number" name="invoiceNumber" class="form-control" placeholder="Enter invoice number" required />
    </div>

    <div class="span-penta">
      <label for="confirm-quantity">Quantity</label>
      <input type="number" id="confirm-quantity" name="confirmQuantity" class="form-control" min="1" required />
    </div>
    
    <div id="logs-wrapper" style="grid-column: 1 / -1;">
    <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
      <div class="span-full" style="padding: 12px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 0.5rem; color: #0369a1; font-size: 14px; margin-top: 10px;">
        <% 
          let runningRemaining = orderToEdit.quantity - orderToEdit.dispatchedQuantity;
        %>
        
        <div style="display: flex; align-items: center; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid #e0f2fe;">
            <span><strong>Partial Dispatch:</strong> <%= orderToEdit.dispatchedQuantity %> sent / <%= orderToEdit.quantity - orderToEdit.dispatchedQuantity %> remaining</span>
        </div>

        <div class="logs-scroll" style="max-height: 120px; overflow-y: auto; padding-right: 5px; width: 100%;">
            <% logs.forEach((log, index) => { %>
            <div style="padding: 6px 0; border-bottom: 1px dashed #e0f2fe; font-size: 13px; display: flex; justify-content: space-between; align-items: center;">
                <span>
                    <span style="color: #64748b; font-size: 12px; margin-right: 5px;">
                        <%= new Date(log.performedAt).toLocaleDateString('en-IN', { month: 'short', day: '2-digit', year: 'numeric' }) %>
                    </span>
                    <% if (log.invoiceNumber) { %>
                    <span style="font-family: monospace; background: #e0f2fe; padding: 1px 6px; border-radius: 4px; font-size: 12px;">
                        <%= log.invoiceNumber %>
                    </span>
                    <% } %>
                <span style="margin-left: 6px;"><strong><%= log.quantity %></strong> sent</span>
                <span style="color: #64748b;">(Remaining: <%= runningRemaining %>)</span>
                </span>
                <span style="display: flex; gap: 6px; align-items: center; flex-shrink: 0;">
                    <button type="button" data-log-id="<%= log._id %>" data-log-qty="<%= log.quantity %>" data-log-invoice="<%= log.invoiceNumber || '' %>" data-log-date="<%= new Date(log.performedAt).toISOString().split('T')[0] %>"
                        onclick="openEditDialog(this.getAttribute('data-log-id'), parseInt(this.getAttribute('data-log-qty')), this.getAttribute('data-log-invoice'), this.getAttribute('data-log-date'))"
                        style="background: none; border: none; color: #3b82f6; cursor: pointer; padding: 2px 4px; font-size: 13px; border-radius: 4px; transition: background 0.2s;"
                        onmouseover="this.style.background='#e0f2fe'" onmouseout="this.style.background='none'"
                        title="Edit Log">
                        <i class="fa-solid fa-pencil"></i>
                    </button>
                    <button type="button" onclick="confirmDeleteLog('<%= log._id %>')"
                        style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 2px 4px; font-size: 13px; border-radius: 4px; transition: background 0.2s;"
                        onmouseover="this.style.background='#fee2e2'" onmouseout="this.style.background='none'"
                        title="Delete Log">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </span>
                
                <% 
                // For the next iteration (older log), the remaining amount was higher by this dispatched amount
                runningRemaining += log.quantity; 
                %>
            </div>
            <% }) %>
        </div>
      </div>
      
      <style>
        .logs-scroll::-webkit-scrollbar {
          width: 4px;
        }
        .logs-scroll::-webkit-scrollbar-track {
          background: transparent;
        }
        .logs-scroll::-webkit-scrollbar-thumb {
          background-color: rgba(26, 26, 46, 0.5);
          border-radius: 6px;
        }
        .logs-scroll::-webkit-scrollbar-thumb:hover {
          background-color: rgba(26, 26, 46, 0.75);
        }
      </style>
    <% } else if (typeof orderToEdit !== 'undefined' && orderToEdit && orderToEdit.dispatchedQuantity > 0) { %>
      <div class="span-full" style="padding: 10px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 0.5rem; color: #0369a1; font-size: 14px; margin-top: 10px;">
        <i class="fa-solid fa-circle-info" style="margin-right: 5px;"></i>
        <strong>Partial Dispatch:</strong> <%= orderToEdit.dispatchedQuantity %> sent. Remaining: <%= orderToEdit.quantity - orderToEdit.dispatchedQuantity %>
      </div>
    <% } %>
    </div>
    <% } %>

<!-- ================= EDIT LOG DIALOG ================= -->
<div id="edit-log-dialog" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center; transition:opacity 0.3s;">
  <div style="background:white; border-radius:8px; width:440px; max-width:90%; box-shadow:0 4px 15px rgba(0,0,0,0.2); overflow:hidden; animation:logDialogPopIn 0.2s ease-out;">
    <div style="padding:20px 20px 0; border-bottom: 1px solid #e5e7eb;">
      <h3 style="margin:0 0 15px; color:#044A78; font-size:17px;"><i class="fa-solid fa-pencil" style="margin-right:6px;"></i>Edit Dispatch Log</h3>
    </div>
    <div style="padding:20px;">
      <input type="hidden" id="edit-log-id" />
      <div style="margin-bottom:14px;">
        <label style="font-size:13px; font-weight:600; color:#374151; display:block; margin-bottom:4px;">Quantity <span style="color:#ef4444">*</span></label>
        <input type="number" id="edit-log-qty" min="1" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; box-sizing:border-box; transition:border-color 0.2s;" />
      </div>
      <div style="margin-bottom:14px;">
        <label style="font-size:13px; font-weight:600; color:#374151; display:block; margin-bottom:4px;">Invoice Number</label>
        <input type="text" id="edit-log-invoice" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; box-sizing:border-box; transition:border-color 0.2s;" />
      </div>
      <div style="margin-bottom:4px;">
        <label style="font-size:13px; font-weight:600; color:#374151; display:block; margin-bottom:4px;">Date</label>
        <input type="date" id="edit-log-date" style="width:100%; padding:8px 12px; border:1px solid #d1d5db; border-radius:6px; font-size:14px; box-sizing:border-box; transition:border-color 0.2s;" />
      </div>
    </div>
    <div style="padding:15px 20px; background:#f9fafb; display:flex; justify-content:flex-end; gap:10px; border-top:1px solid #e5e7eb;">
      <button type="button" onclick="closeEditDialog()" style="padding:8px 16px; border:1px solid #d1d5db; background:white; color:#374151; border-radius:6px; cursor:pointer; font-weight:500; transition:all 0.2s;" onmouseover="this.style.background='#f3f4f6'" onmouseout="this.style.background='white'">Cancel</button>
      <button type="button" onclick="submitEditLog()" style="padding:8px 16px; border:none; background:#044A78; color:white; border-radius:6px; cursor:pointer; font-weight:500; transition:all 0.2s;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">Save Changes</button>
    </div>
  </div>
</div>

<!-- ================= DELETE LOG DIALOG ================= -->
<div id="delete-log-dialog" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center; transition:opacity 0.3s;">
  <div style="background:white; border-radius:8px; width:400px; max-width:90%; box-shadow:0 4px 15px rgba(0,0,0,0.2); overflow:hidden; animation:logDialogPopIn 0.2s ease-out;">
    <div style="padding:25px 20px; text-align:center;">
      <i class="fa-solid fa-triangle-exclamation" style="font-size:28px; color:#ef4444; margin-bottom:12px;"></i>
      <p style="margin:0; color:#333; font-size:16px; line-height:1.5;">Are you sure you want to <strong>delete</strong> this dispatch log? Stock will be reversed.</p>
      <input type="hidden" id="delete-log-id" />
    </div>
    <div style="padding:15px 20px; background:#f9fafb; display:flex; justify-content:flex-end; gap:10px; border-top:1px solid #e5e7eb;">
      <button type="button" onclick="closeDeleteDialog()" style="padding:8px 16px; border:1px solid #d1d5db; background:white; color:#374151; border-radius:6px; cursor:pointer; font-weight:500; transition:all 0.2s;" onmouseover="this.style.background='#f3f4f6'" onmouseout="this.style.background='white'">Go Back</button>
      <button type="button" onclick="submitDeleteLog()" style="padding:8px 16px; border:none; background:#ef4444; color:white; border-radius:6px; cursor:pointer; font-weight:500; transition:all 0.2s;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">Yes, Delete</button>
    </div>
