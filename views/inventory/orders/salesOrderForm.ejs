  .ap-table-wrap { overflow-x: auto; }
  .ap-table { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: fixed; }
  .ap-table th, .ap-table td { padding: 5px 10px; border-bottom: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb; text-align: left; }
  .ap-table tr > *:last-child { border-right: none; }
  .ap-table tr:last-child th, .ap-table tr:last-child td { border-bottom: none; }
  .ap-table th { color: #044a78; font-weight: 700; white-space: nowrap; width: 10%; }
  .ap-table td { color: #1f2a44; font-weight: 600; word-break: break-word; }
  .ap-table th.ap-hl, .ap-table td.ap-hl { background: #dbeafe; }
  .ap-table th.ap-hl { color: #044a78; }
  .ap-table td.ap-hl { color: #044a78; font-weight: 700; }

  .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }
</style>

</script>

<script type="application/json" id="order-to-edit-data">
  <%- typeof orderToEdit !== 'undefined' && orderToEdit ? JSON.stringify(orderToEdit) : 'null' %>
</script>
<script type="application/json" id="stock-info-data">
  <%- typeof stockInfo !== 'undefined' && stockInfo ? JSON.stringify(stockInfo) : 'null' %>
</script>
<script type="application/json" id="label-stocks-data">
  <%- typeof labelStocks !== 'undefined' && labelStocks ? JSON.stringify(labelStocks) : '[]' %>
</script>

<script>
  // Safe JSON extraction
  const orderToEdit = JSON.parse(document.getElementById('order-to-edit-data')?.textContent || 'null');
  const stockInfo = JSON.parse(document.getElementById('stock-info-data')?.textContent || 'null');
  // Full Label Stock master catalog (/sachiko/label-stock/view) -- the
  // Product Code picker lists every master product, not just ones already
  // bound to the selected client (see populateProductChoices /
  // onLabelStockProductChange and the labelStockMasterId fallback below).
  const allLabelStockMasters = JSON.parse(document.getElementById('label-stocks-data')?.textContent || '[]');

  // Item Type offers Roll/Sheet -- Label Stock's own rollOrSheet split --
  // instead of a generic "Label Stock" choice (Tape order creation was
  // removed from this form entirely). Both values still drive exactly the
  // Label Stock code paths "LABEL_STOCK" used to (Product Code picker,
  // Paper Size/RM fields, ...) -- isLabelStockItemType is what every such
  // check now goes through. They only differ in filtering the Product Code
  // list to the matching SachikoLabelStock.rollOrSheet (see
  // populateProductChoices) -- the server itself still only knows
  // "LABEL_STOCK" (see POST /sales/order), so toServerItemType translates
  // back to that for every fetch/submit.
  function isLabelStockItemType(v) { return v === "ROLL" || v === "SHEET"; }
  function toServerItemType(v) { return isLabelStockItemType(v) ? "LABEL_STOCK" : v; }

  const confirmModeStr = `<%= typeof confirmMode !== 'undefined' && confirmMode ? 'true' : 'false' %>`;
  const confirmMode = confirmModeStr === 'true';

  const clientSelect = document.getElementById("client-name");
  const userSelect = document.getElementById("user-name");
  const userNameHidden = document.getElementById("user-name-hidden");
  const itemTypeSelect = document.getElementById("item-type");
  const itemSelect = document.getElementById("item-select");
  const sourceLocationInput = document.getElementById("source-location");
  const locationSelect = document.getElementById("user-location");
  const poDateInput = document.getElementById("po-date");
  const poNumberInput = document.getElementById("po-number");
  const rateDisplayInput = document.getElementById("item-rate");
  const orderRateInput = document.getElementById("order-rate");
  const quantityInput = document.getElementById("quantity");
  const estimatedDateInput = document.getElementById("estimated-date");
  const remarksInput = document.getElementById("remarks");
  const confirmQuantityInput = document.getElementById("confirm-quantity");
  const orderForm = document.getElementById("sales-order-form");
  const submitButton = orderForm?.querySelector('button[type="submit"]');

  // Est Delivery Date can't precede PO Date -- keep the date picker's `min` in
  // sync so the native control blocks it too (the submit handler double-checks).
  function syncEstDeliveryMin() {
    if (!poDateInput || !estimatedDateInput) return;
    estimatedDateInput.min = (poDateInput.value || "").trim();
  }
  if (poDateInput) poDateInput.addEventListener("change", syncEstDeliveryMin);
  syncEstDeliveryMin();

  // Order Quantity: show thousands separators (commas) while typing, but keep
  // the underlying value comma-free so it always saves as a plain number.
  function parseQty(el) {
    return parseInt(String(el?.value ?? "").replace(/,/g, ""), 10) || 0;
  }
  function formatQtyWithCommas(raw) {
    const digits = String(raw ?? "").replace(/[^\d]/g, "");
    return digits ? Number(digits).toLocaleString("en-US") : "";
  }
  function applyQtyCommaFormatting() {
    if (!quantityInput) return;
    const prev = quantityInput.value;
    const formatted = formatQtyWithCommas(prev);
    if (formatted === prev) return;
    const caret = quantityInput.selectionStart ?? prev.length;
    const digitsBeforeCaret = prev.slice(0, caret).replace(/[^\d]/g, "").length;
    quantityInput.value = formatted;
    if (document.activeElement === quantityInput) {
      let pos = 0, seen = 0;
      while (pos < formatted.length && seen < digitsBeforeCaret) {
        if (/\d/.test(formatted[pos])) seen++;
        pos++;
      }
      quantityInput.setSelectionRange(pos, pos);
    }
  }
  if (quantityInput) {
    quantityInput.addEventListener("input", applyQtyCommaFormatting);
    quantityInput.addEventListener("input", renderSelectedItemDetailsTable);
  }

  // Label Stock has no separate Order Quantity field (see
  // updateLabelStockFieldsVisibility) -- No of Rolls IS the quantity, kept
  // in sync here so balance/remaining/dispatch logic downstream still works.
  const noOfRollsInput = document.getElementById("no-of-rolls");
  if (noOfRollsInput && quantityInput) {
    noOfRollsInput.addEventListener("input", () => {
      if (!isLabelStockItemType(itemTypeSelect.value)) return;
      quantityInput.value = noOfRollsInput.value;
    });
  }

  if (confirmMode) {
    const style = document.createElement("style");
    style.textContent = `
      .dispatch-location-locked {
        opacity: 1;
      }
      .dispatch-location-locked .location-option {
        opacity: 0.82;
        filter: saturate(0.85);
      }
      .dispatch-location-locked .location-option.selected {
        opacity: 1;
        filter: none;
      }
      .dispatch-location-locked .location-option input {
        cursor: not-allowed;
      }
      .dispatch-location-locked .location-option.is-disabled {
        opacity: 0.7;
        filter: saturate(0.8);
      }
      .dispatch-location-locked .choices__inner,
      .dispatch-location-locked .choices__input,
      .dispatch-location-locked .choices__list--single {
        background: #f3f4f6 !important;
        color: #6b7280 !important;
        cursor: not-allowed !important;
      }
      .dispatch-location-locked .choices__placeholder {
        color: #6b7280 !important;
        opacity: 1 !important;
      }
    `;
    document.head.appendChild(style);
  }

  function normalizeLocationName(value) {
    return String(value || "")
      .trim()
      .toUpperCase()
      .replace(/\s+/g, " ")
      .replace(/^[.,]+|[.,]+$/g, "");
  }

  function normalizeLookupText(value) {
    return String(value || "")
      .trim()
      .replace(/\s+/g, " ");
  }

  // Item Type is now Roll/Sheet, not a generic "LABEL_STOCK" -- for an
  // existing order being edited/confirmed, that's the bound item's own
  // rollOrSheet (tapeId resolves to the SachikoLabelStock doc itself via its
  // refPath: "onModel", see models/inventory/TapeSalesOrder.js). Tape orders
  // can no longer be *created* from this form, but the TAPE check is kept
  // here defensively in case one was created elsewhere -- opening it here
  // just won't find a matching Item Type option to preselect.
  function inferSalesOrderType(order) {
    const model = String(order?.onModel || "").toUpperCase();
    const bindingModel = String(order?.onBindingModel || "").toUpperCase();

    if (model === "TAPE" || bindingModel.includes("TAPEBINDING")) return "TAPE";
    if (model === "SACHIKOLABELSTOCK" || bindingModel.includes("LABELSTOCKBINDING")) {
      return String(order?.tapeId?.rollOrSheet || "").toUpperCase();
    }

    return "";
  }

  function getUserLocationEntries(user) {
    const details = Array.isArray(user?.locationDetails) ? user.locationDetails : [];
    const entries = details
      .map((entry) => {
        const userLocation = normalizeLocationName(entry?.userLocation || entry?.location || "");
        if (!userLocation) return null;
        return {
          value: userLocation,
          label: userLocation,
        };
      })
      .filter(Boolean);

    if (entries.length > 0) return entries;

    const fallbackLocation = normalizeLocationName(user?.userLocation || "");
    if (!fallbackLocation) return [];

    return [
      {
        value: fallbackLocation,
        label: fallbackLocation,
      },
    ];
  }

  function resolveSelectValue(selectEl, rawValue) {
    const target = normalizeLookupText(rawValue);
    if (!target || !selectEl?.options) return target;

    const targetLower = target.toLowerCase();
    for (const option of Array.from(selectEl.options)) {
      const optionValue = normalizeLookupText(option.value);
      const optionLabel = normalizeLookupText(option.textContent);
      if (optionValue.toLowerCase() === targetLower || optionLabel.toLowerCase() === targetLower) {
        return option.value;
      }
    }

    return target;
  }

  function setChoiceValue(choicesInstance, selectEl, rawValue) {
    if (!choicesInstance) return false;
    const target = normalizeLookupText(rawValue);
    if (!target) return false;

    // Try setting by value directly first (best for IDs)
    try {
      choicesInstance.setChoiceByValue(target);
      if (selectEl) selectEl.value = target;
      if (choicesInstance.getValue(true) === target) return true;
    } catch (_) {}

    // Fallback to label/value resolution
    const resolvedValue = resolveSelectValue(selectEl, target);
    if (resolvedValue) {
      choicesInstance.setChoiceByValue(resolvedValue);
      if (selectEl) selectEl.value = resolvedValue;
      return true;
    }

    return false;
  }

  let currentSourceLocation = "";
  let lockedDispatchLocation = "";
  let dispatchLocationLocked = false;
  // True while we set the location dropdown programmatically, so the location
  // "change" handler doesn't treat it as a user pick and reload the item list.
  let programmaticLocationUpdate = false;
  // Same idea for the user dropdown: loadUsers() selects the user itself and then
  // loads its locations/items, so the user "change" handler must not also fire.
  let programmaticUserUpdate = false;

  function showDispatchLocationLockedToast() {
    showToast(
      "Location cannot be changed during dispatch because stock deduction and the dispatch log must stay tied to the original source location.",
      "error",
    );
  }

  function syncSourceLocation(value) {
    currentSourceLocation = normalizeLocationName(value);
    sourceLocationInput.value = currentSourceLocation;
  }

  function lockDispatchLocation(locationName) {
    lockedDispatchLocation = normalizeLocationName(locationName);
    dispatchLocationLocked = !!lockedDispatchLocation;
    syncSourceLocation(lockedDispatchLocation);
  }

  function enforceLockedDispatchLocation() {
    if (!dispatchLocationLocked || !lockedDispatchLocation) return;

    if (locationSelect) {
      locationSelect.value = lockedDispatchLocation;
      locationSelect.disabled = true;
      if (locationChoices?.setChoiceByValue) {
        locationChoices.setChoiceByValue(lockedDispatchLocation);
      }
      if (locationChoices?.disable) {
        locationChoices.disable();
      }
    }

    const stockDisplay = document.getElementById("stock-display");
    if (!stockDisplay) return;
    stockDisplay.classList.add("dispatch-location-locked");

    stockDisplay.querySelectorAll('input[name="locationRadio"]').forEach((radio) => {
      const isLocked = normalizeLocationName(radio.value) === lockedDispatchLocation;
      radio.checked = isLocked;
      radio.disabled = !isLocked;
      const row = radio.closest(".location-option");
      if (row) {
        row.classList.toggle("is-locked", isLocked);
        row.classList.toggle("is-disabled", !isLocked);
      }
      if (radio.value === "ALL") {
        radio.disabled = true;
        if (row) row.classList.add("is-disabled");
      }
    });
  }

  let clientChoices, userChoices, locationChoices, itemTypeChoices, itemChoices;
  let productChoicesInst;
  // Raw item list from the last /sales/items fetch -- the Product Code
  // picker filters this in-memory rather than re-fetching per pick.
  let latestLabelStockItems = [];


  // Reset all downstream fields
  function resetUsers() {
    userChoices.clearStore();
    userChoices.setChoices([{ value: "", label: "Select User", disabled: true, selected: true }], "value", "label", true);
    userNameHidden.value = "";
    resetLocation();
    resetItems();
  }
  function resetLocation() {
    locationChoices.clearStore();
    locationChoices.setChoices([{ value: "", label: "Location", disabled: true, selected: true }], "value", "label", true);
  }
  function resetItems() {
    if (!itemChoices) return;
    itemChoices.clearStore();
    itemChoices.setChoices([{ value: "", label: "Select Item", disabled: true, selected: true }], "value", "label", true);
    updateStockDisplay();
    syncSourceLocation("");
    if (rateDisplayInput) {
      rateDisplayInput.value = "";
      rateDisplayInput.readOnly = true;
    }
    if (orderRateInput) {
      orderRateInput.value = "";
      delete orderRateInput.dataset.userEdited;
      delete orderRateInput.dataset.fromOrder;
    }
    const labelStockMasterIdInput = document.getElementById("label-stock-master-id");
    if (labelStockMasterIdInput) labelStockMasterIdInput.value = "";
    latestLabelStockItems = [];
    resetLabelStockPicker();
  }

  // Load clients filtered by item type with an optional target to ensure it exists
  async function loadClients(itemType, targetToKeep = null) {
    if (!itemType) return;
    console.log(`DEBUG: loading clients for ${itemType}, keeping ${targetToKeep || "none"}`);
    
    clientChoices.clearStore();
    clientChoices.setChoices([{ value: "", label: "Loading...", disabled: true, selected: true }], "value", "label", true);
    resetUsers();
    
    try {
      const res = await fetch(`/sachiko/sales/clients/${toServerItemType(itemType)}`);
      const clientNames = await res.json();
      
      const finalNames = [...clientNames];
      if (targetToKeep && !finalNames.some(n => normalizeLookupText(n) === normalizeLookupText(targetToKeep))) {
         console.log(`DEBUG: Adding ${targetToKeep} to the filtered list.`);
         finalNames.push(targetToKeep);
      }
      finalNames.sort();

      clientChoices.clearStore();
      clientChoices.setChoices(
        [{ value: "", label: "Select Client", disabled: true, selected: !targetToKeep, placeholder: true },
         ...finalNames.map(name => ({ 
           value: name, 
           label: name, 
           selected: normalizeLookupText(name) === normalizeLookupText(targetToKeep) 
         }))],
        "value", "label", true
      );
    } catch (err) {
      console.error("Failed to load clients:", err);
      clientChoices.clearStore();
      clientChoices.setChoices([{ value: "", label: "Error loading clients", disabled: true, selected: true }], "value", "label", true);
    }
  }

  // Load users when client changes
  async function loadUsers(clientName, targetUserId = null, targetItemId = null) {
    if (!clientName) return;
    console.log(`DEBUG: loading users for ${clientName}, targetUser=${targetUserId}`);

    userChoices.clearStore();
    userChoices.setChoices([{ value: "", label: "Loading...", disabled: true, selected: true }], "value", "label", true);
    resetLocation();
    resetItems();

    try {
      const res = await fetch(`/sachiko/form/labels/${encodeURIComponent(clientName)}`);
      const clientData = await res.json();
      const users = clientData?.users || [];

      const choicesArray = users.map(user => ({
        value: String(user._id),
        label: user.userName,
        selected: String(user._id) === String(targetUserId) || (users.length === 1 && !targetUserId),
        customProperties: {
          name: user.userName,
          location: user.userLocation || "",
          locationDetails: Array.isArray(user.locationDetails) ? user.locationDetails : [],
        }
      }));

      // Selecting the user below fires a "change"; suppress the handler so it
      // doesn't launch a second, competing loadItems() alongside ours.
      programmaticUserUpdate = true;
      userChoices.clearStore();
      userChoices.setChoices(
        [{ value: "", label: "Select User", disabled: true, selected: !targetUserId && users.length !== 1 }, ...choicesArray],
        "value",
        "label",
        true
      );

      // Explicitly set value to trigger downstream
      let selectedUser = null;
      if (targetUserId) {
        selectedUser = users.find(u => String(u._id) === String(targetUserId));
      } else if (users.length === 1) {
        selectedUser = users[0];
      }

      if (selectedUser) {
        const uid = String(selectedUser._id);
        userChoices.setChoiceByValue(uid);
        if (userSelect) userSelect.value = uid;
        userNameHidden.value = selectedUser.userName || "";
        programmaticUserUpdate = false;
        setLocationFromUser(selectedUser);
        // Prefill by item → fetch unfiltered ("") so we can find it and adopt its
        // location; otherwise items wait for a chosen location (null).
        await loadItems(targetItemId, uid, targetItemId ? "" : null);
      } else {
        programmaticUserUpdate = false;
      }
    } catch (err) {
      console.error("Failed to load users:", err);
      userChoices.clearStore();
      userChoices.setChoices([{ value: "", label: "Error loading users", disabled: true, selected: true }], "value", "label", true);
    }
  }

  // Load items based on type, user and (now) location. Items are scoped to the
  // selected location; when prefilling by a specific item we don't yet know its
  // location, so we fetch unfiltered and then set the location from the item.
  async function loadItems(targetItemId = null, targetUserId = null, targetLocation = null) {
    const userId = targetUserId || userSelect.value || userChoices?.getValue(true);
    const itemType = itemTypeSelect.value;
    if (!userId || !itemType) return;

    const loc = normalizeLocationName(
      targetLocation != null ? targetLocation : (locationSelect.value || ""),
    );

    // Normal flow: a location must be chosen before items are shown. (When we're
    // prefilling a known item, we allow an unfiltered fetch to discover it.)
    if (!loc && !targetItemId) {
      itemChoices.clearStore();
      itemChoices.setChoices([{ value: "", label: "Select a location first", disabled: true, selected: true }], "value", "label", true);
      updateStockDisplay();
      latestLabelStockItems = [];
      resetLabelStockPicker();
      return;
    }

    itemChoices.clearStore();
    itemChoices.setChoices([{ value: "", label: "Loading...", disabled: true, selected: true }], "value", "label", true);

    try {
      const itemsUrl = `/sachiko/sales/items/${toServerItemType(itemType)}/${userId}` + (loc ? `?location=${encodeURIComponent(loc)}` : "");
      const res = await fetch(itemsUrl);
      const items = await res.json();

      latestLabelStockItems = isLabelStockItemType(itemType) ? items : [];

      itemChoices.clearStore();
      if (items.length === 0) {
        itemChoices.setChoices([{ value: "", label: "No items found", disabled: true, selected: true }], "value", "label", true);
        if (isLabelStockItemType(itemType)) resetLabelStockPicker();
        return;
      }

      if (isLabelStockItemType(itemType)) populateProductChoices();
      
      const itemChoicesArray = items.map(item => ({
        value: item._id,
        label: item.displayName,
        selected: String(item._id) === String(targetItemId) || (items.length === 1 && !targetItemId),
        customProperties: {
          stock: item.stock ? JSON.stringify(item.stock) : "",
          minQty: item.minOrderQty || 0,
          perRollQty: item.perRollQty || 0,
          rate: typeof item.rate !== "undefined" ? item.rate : null,
          details: JSON.stringify(item.details || {}),
          location: item.location || "",
          paperSize: item.paperSize || "",
          runningMeters: item.runningMeters != null ? item.runningMeters : "",
        }
      }));

      itemChoices.setChoices(
        [{ value: "", label: "Select Item", disabled: true, selected: !targetItemId && items.length !== 1 }, ...itemChoicesArray],
        "value",
        "label",
        true
      );

      if (targetItemId) {
        setChoiceValue(itemChoices, itemSelect, targetItemId);
        // Prefill by item: align the location dropdown with the chosen item's
        // own location (it may differ from whatever was auto-selected).
        const selectedItem = items.find((it) => String(it._id) === String(targetItemId));
        if (isLabelStockItemType(itemType)) syncLabelStockPickerFromItem(selectedItem);
        const itemLoc = normalizeLocationName(selectedItem?.location || "");
        if (itemLoc && itemLoc !== loc) {
          programmaticLocationUpdate = true;
          const hasOption = Array.from(locationSelect.options).some(
            (o) => normalizeLocationName(o.value) === itemLoc,
          );
          if (hasOption) {
            locationSelect.value = itemLoc;
            locationChoices.setChoiceByValue?.(itemLoc);
          } else {
            setLocationField(itemLoc);
          }
          syncSourceLocation(itemLoc);
          programmaticLocationUpdate = false;
        }
      } else if (items.length === 1) {
        setChoiceValue(itemChoices, itemSelect, items[0]._id);
        if (isLabelStockItemType(itemType)) syncLabelStockPickerFromItem(items[0]);
      }

      // Trigger change event to update stock display
      updateStockDisplay();
    } catch (err) {
      console.error("Failed to load items:", err);
      itemChoices.clearStore();
      itemChoices.setChoices([{ value: "", label: "Error loading items", disabled: true, selected: true }], "value", "label", true);
    }
  }

  // Labels and Color Labels are always MOQ'd in labels now (the Rolls option
  // was removed from their binding forms) -- ignore ROLLS stored on older
  // bindings; every item type just gets the plain "Enter quantity" prompt.
  function updateQtyUnitBadge(selectedOption) {
    const badge = document.getElementById("qty-unit-badge");
    const qtyInput = document.getElementById("quantity");
    if (badge) badge.style.display = "none";
    if (qtyInput) qtyInput.placeholder = "Enter quantity";
  }

  function updateRateDisplay(selectedOption) {
    if (!rateDisplayInput) return;
    const rate = selectedOption?.customProperties?.rate;
    const hasRate = rate === 0 || rate === "0" || (rate !== null && typeof rate !== "undefined" && rate !== "");
    rateDisplayInput.value = hasRate ? String(rate) : "";

    if (!orderRateInput) return;
    if (orderRateInput.dataset.userEdited === "true") return;
    if (orderRateInput.dataset.fromOrder === "true") return;
    orderRateInput.value = hasRate ? String(rate) : "";
  }

  // Renders label/value pairs as a real table, 4 pairs (8 cells) per row.
  // A 3rd tuple element (truthy) highlights that cell (used for the
  // Per Roll Qty / Per Roll Rate rows).
  function kvTable(pairs) {
    const perRow = 4;
    let rows = "";
    for (let i = 0; i < pairs.length; i += perRow) {
      const chunk = pairs.slice(i, i + perRow);
      while (chunk.length < perRow) chunk.push(["", ""]);
      rows += "<tr>" + chunk.map(([k, v, hl]) => (k === "" ? "<th></th><td></td>" : `<th${hl ? ' class="ap-hl"' : ""}>${k}</th><td${hl ? ' class="ap-hl"' : ""}>${v}</td>`)).join("") + "</tr>";
    }
    return `<table class="ap-table"><tbody>${rows}</tbody></table>`;
  }

  function escOrderLayer(v) {
    return String(v ?? "—").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  // ── Physical layer stack (top-to-bottom), same layer order/styling as the
  // Label Stock Binding form (views/sachiko/labelStockBindingForm.ejs) and
  // the Label Stock View page (views/sachiko/labelStockView.ejs) — kept in
  // sync with both so the same SKU always renders the same stack everywhere.
  const ORDER_LAYER_STYLE = {
    facestock: { bg: "#eff6ff", border: "#93c5fd", text: "#1d4ed8", label: "FACESTOCK" },
    adhesive:  { bg: "#fffbeb", border: "#fcd34d", text: "#b45309", label: "ADHESIVE" },
    release:   { bg: "#f8fafc", border: "#cbd5e1", text: "#475569", label: "RELEASE LINER" },
  };

  function orderLayerBlock(kind, title, parts) {
    const s = ORDER_LAYER_STYLE[kind];
    const detail = parts.filter(Boolean).join(" · ");
    return `
      <div style="background:${s.bg};border:1.5px solid ${s.border};border-radius:6px;padding:8px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px;">
        <span style="font-size:11px;font-weight:800;letter-spacing:0.04em;color:${s.text};">${s.label}</span>
        <span style="font-size:12px;font-weight:600;color:#334155;text-align:right;">${detail ? escOrderLayer(detail) : "—"}${title ? ` <span style="color:${s.text};font-weight:700;">(${escOrderLayer(title)})</span>` : ""}</span>
      </div>`;
  }

  function renderOrderLabelStockLayerStack(d) {
    const rollType = d.rollType || "NORMAL";
    let layers = [
      orderLayerBlock("facestock", null, [d.fsFamily, d.fsType, d.fsGsm != null && d.fsGsm !== "" ? d.fsGsm + " GSM" : null, d.fsMicron != null && d.fsMicron !== "" ? d.fsMicron + " MIC" : null]),
      orderLayerBlock("adhesive", null, [d.adType, d.adGsm != null && d.adGsm !== "" ? d.adGsm + " GSM" : null]),
    ];
    if (rollType === "DOUBLE FACESTOCK") {
      layers.push(
        orderLayerBlock("facestock", "Layer 2", [d.fs2Family, d.fs2Type, d.fs2Gsm != null && d.fs2Gsm !== "" ? d.fs2Gsm + " GSM" : null, d.fs2Micron != null && d.fs2Micron !== "" ? d.fs2Micron + " MIC" : null]),
        orderLayerBlock("adhesive", "Layer 2", [d.ad2Type, d.ad2Gsm != null && d.ad2Gsm !== "" ? d.ad2Gsm + " GSM" : null]),
        orderLayerBlock("release", null, [d.rlType, d.rlColor, d.rlGsm != null && d.rlGsm !== "" ? d.rlGsm + " GSM" : null]),
      );
    } else if (rollType === "DOUBLE RELEASE") {
      layers.push(
        orderLayerBlock("release", null, [d.rlType, d.rlColor, d.rlGsm != null && d.rlGsm !== "" ? d.rlGsm + " GSM" : null]),
        orderLayerBlock("adhesive", "Layer 2", [d.ad2Type, d.ad2Gsm != null && d.ad2Gsm !== "" ? d.ad2Gsm + " GSM" : null]),
        orderLayerBlock("release", "Layer 2", [d.rl2Type, d.rl2Color, d.rl2Gsm != null && d.rl2Gsm !== "" ? d.rl2Gsm + " GSM" : null]),
      );
    } else {
      layers.push(
        orderLayerBlock("release", null, [d.rlType, d.rlColor, d.rlGsm != null && d.rlGsm !== "" ? d.rlGsm + " GSM" : null]),
      );
    }

    return `
      <div style="padding:14px 16px;background:#f8fafc;max-width:600px;margin:0 auto;">
        <p style="margin:0 0 10px;font-size:13px;font-weight:700;color:#03365a;text-align:center;">${escOrderLayer(d.productCode)}${d.skuCode ? ` · ${escOrderLayer(d.skuCode)}` : ""}</p>
        <div class="custom-scrollbar" style="display:flex;flex-direction:column;gap:2px;max-height:320px;overflow-y:auto;padding:2px;">
          ${layers.join(`
          <div style="display:flex;justify-content:center;margin:-2px 0;"><i class="fa-solid fa-caret-down" style="color:#cbd5e1;font-size:11px;"></i></div>
          `)}
        </div>
      </div>`;
  }

  // Details of the currently selected item -- kept around so the details
  // table can be re-rendered when the quantity changes.
  let currentSelectedDetails = null;

  // No of Rolls (span 3) only shows for Label Stock items, and Order
  // Quantity (span 4) only shows for Tape (Label Stock has no separate
  // quantity field -- see updateLabelStockFieldsVisibility). Paper
  // Size/Running Meters live up in Order Details next to Product Code, not
  // in this row. Rate (span 3, read-only, auto-filled from the binding)
  // shows for both item types; Curr Rate (span 3, editable) is Tape-only.
  // Remarks grows to fill whichever columns are freed so the row still
  // totals 32 instead of leaving a trailing gap:
  //   Tape:        po-date(3) + po-number(4) + quantity(4) + item-rate(3) + order-rate(3) + est-date(5) + remarks(10) = 32
  //   Label Stock: po-date(3) + po-number(4) + no-of-rolls(3) + item-rate(3) + est-date(5) + remarks(14) = 32
  function syncRemarksWidth() {
    const remarksWrap = document.getElementById("remarks-wrap");
    if (!remarksWrap) return;
    const labelStockFieldsVisible = document.getElementById("no-of-rolls-div")?.style.display !== "none";
    remarksWrap.style.gridColumn = labelStockFieldsVisible ? "span 14" : "span 10";
  }

  // Show No of Rolls only for Label Stock (Paper Size/Running Meters are
  // toggled the same way, up next to Product Code -- see the ids array
  // below). Rate (read-only, auto-filled from the binding's own rate) shows
  // for both item types; Curr Rate (user-editable, what actually gets
  // submitted as orderRate) stays Tape-only -- Label Stock orders always
  // save at the binding's rate as-is (see the LABEL_STOCK branch of
  // POST /sales/order).
  //
  // Label Stock has no separate "Order Quantity" concept -- its quantity IS
  // the No of Rolls, so asking for both would just be double entry. The
  // Order Quantity field is hidden and no longer required for Label Stock;
  // its value is kept in sync with No of Rolls instead (see the "no-of-rolls"
  // input listener below), since `quantity` is still what every downstream
  // balance/remaining/dispatch calculation reads for every item type.
  function updateLabelStockFieldsVisibility() {
    const isLabelStock = isLabelStockItemType(itemTypeSelect.value);
    ["paper-size-div", "running-meters-div", "no-of-rolls-div"].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.style.display = isLabelStock ? "" : "none";
    });
    const orderRateDiv = document.getElementById("order-rate-div");
    if (orderRateDiv) orderRateDiv.style.display = isLabelStock ? "none" : "";
    const quantityDiv = document.getElementById("quantity-div");
    if (quantityDiv) quantityDiv.style.display = isLabelStock ? "none" : "";
    if (quantityInput) {
      quantityInput.required = !isLabelStock;
      if (isLabelStock) quantityInput.value = noOfRollsInput?.value || "";
    }

    // Label Stock replaces the single "Select Item" dropdown with the Product
    // Code picker (see onLabelStockProductChange etc.) -- except in
    // confirm/dispatch mode, where the item is already fixed and
    // #item-select itself is disabled rather than re-pickable.
    const showPicker = isLabelStock && typeof confirmMode !== "undefined" && !confirmMode;
    const itemSelectWrap = document.getElementById("item-select-wrap");
    if (itemSelectWrap) itemSelectWrap.style.display = showPicker ? "none" : "";
    // #item-select carries `required`, but hiding its wrapper isn't enough to
    // exempt it from :invalid -- Choices.js hides the original <select> via
    // absolute-positioned/clipped CSS rather than display:none, so the
    // browser still treats it as "rendered" and blocks submission with a
    // false "Select Item is required" error even though it's the Product
    // Code picker being used instead. Toggle required explicitly, same as
    // quantityInput above.
    if (itemSelect) itemSelect.required = !showPicker;
    const productDiv = document.getElementById("label-stock-product-div");
    if (productDiv) productDiv.style.display = showPicker ? "" : "none";

    // Item Type/Client/User/Location share this row with Deckle Option (a
    // fixed span-four that's always visible, never resized here) plus either
    // the Product Code picker (plus Paper Size/RM, so the whole Label Stock
    // identity row sits together) or the plain Select Item dropdown --
    // whichever of those two is actually visible, resize them to fill the
    // row instead of leaving a trailing gap or spilling onto a second line:
    //   Picker visible:      deckle(4) + item-type(4) + client(5) + user(5) + location(3) + product(4) + paper-size(4) + rm(3) = 32
    //   Select Item visible: deckle(4) + item-type(4) + client(6) + user(6) + location(5) + item-select(7) = 32 (their static CSS spans -- no resize needed)
    const itemTypeDiv = document.getElementById("item-type-div");
    const locationDiv = document.getElementById("user-location-div");
    const clientDiv = document.getElementById("client-name-div");
    const userDiv = document.getElementById("user-name-div");
    const paperSizeDiv = document.getElementById("paper-size-div");
    const runningMetersDiv = document.getElementById("running-meters-div");
    if (itemTypeDiv) itemTypeDiv.style.gridColumn = showPicker ? "span 4" : "";
    if (clientDiv) clientDiv.style.gridColumn = showPicker ? "span 5" : "";
    if (userDiv) userDiv.style.gridColumn = showPicker ? "span 5" : "";
    if (locationDiv) locationDiv.style.gridColumn = showPicker ? "span 3" : "";
    if (productDiv) productDiv.style.gridColumn = showPicker ? "span 4" : "";
    if (paperSizeDiv) paperSizeDiv.style.gridColumn = showPicker ? "span 4" : "";
    if (runningMetersDiv) runningMetersDiv.style.gridColumn = showPicker ? "span 3" : "";

    syncRemarksWidth();

    // New Label Stock order -> the "Order Items" table replaces the scattered
    // single-item fields; keep them hidden no matter who calls this.
    if (typeof aiTableMode === "function" && aiTableMode() && typeof aiHideLegacyFields === "function") {
      aiHideLegacyFields();
    }
  }

  function renderSelectedItemDetailsTable() {
    const detailsBox = document.getElementById("selected-item-details");
    if (!currentSelectedDetails) {
      detailsBox.style.display = "none";
      detailsBox.innerHTML = "";
      syncRemarksWidth();
      return;
    }

    if (String(currentSelectedDetails.type || "").toUpperCase() === "LABEL_STOCK") {
      detailsBox.innerHTML = renderOrderLabelStockLayerStack(currentSelectedDetails);
      detailsBox.style.display = "block";
      syncRemarksWidth();
      return;
    }

    const entries = getProfileDetailEntries(currentSelectedDetails);

    if (entries.length > 0) {
      detailsBox.innerHTML = `<div class="ap-table-wrap">${kvTable(entries)}</div>`;
      detailsBox.style.display = "block";
    } else {
      detailsBox.style.display = "none";
      detailsBox.innerHTML = "";
    }
    syncRemarksWidth();
  }

  function getProfileDetailEntries(details) {
    const d = details || {};
    const type = String(d.type || "").toUpperCase();
    const out = [];
    const pushIf = (label, value, highlight) => {
      if (value === null || value === undefined) return;
      const text = String(value).trim();
      if (!text) return;
      out.push(highlight ? [label, text, true] : [label, text]);
    };

    if (type === "TAPE") {
      pushIf("Product ID", d.productId);
      pushIf("Min Stock Qty", d.minQty);
      pushIf("Client Paper Code", d.clientPaperCode);
      pushIf("Paper Code", d.paperCode);
      pushIf("Client GSM", d.clientGsm);
      pushIf("GSM", d.gsm);
      pushIf("Paper Type", d.paperType);
      pushIf("Adhesive GSM", d.adhesiveGsm);
      pushIf("Width", d.width);
      pushIf("Meters", d.mtrs);
      pushIf("Core ID", d.coreId);
      pushIf("Finish", d.finish);
    }

    return out;
  }

  // Paper Size / Running Meters default from the client's Label Stock binding
  // (LabelStockBinding.paperSize/runningMeters) when an item is picked, but
  // are editable so an order can differ from the binding's stored spec.
  function updateLabelStockSpecFields(selectedOption) {
    const paperSizeInput = document.getElementById("paper-size");
    const runningMetersInput = document.getElementById("running-meters");
    const cp = selectedOption?.customProperties || {};
    if (paperSizeInput) paperSizeInput.value = cp.paperSize || "";
    if (runningMetersInput) runningMetersInput.value = cp.runningMeters != null && cp.runningMeters !== "" ? cp.runningMeters : "";
  }

  // ================= LABEL STOCK: PRODUCT CODE PICKER =================
  // Populates the Product Code select from the full Label Stock master
  // catalog (/sachiko/label-stock/view) -- every product, not just ones
  // already bound to the selected client/user -- narrowed to whichever of
  // Roll/Sheet is picked as Item Type (SachikoLabelStock.rollOrSheet).
  // Labelled by productCode; skuCode is still what's used internally to key
  // the picker. Picking a product with no existing binding for this client
  // falls through to the labelStockMasterId path in onLabelStockProductChange
  // below.
  function populateProductChoices(selected = "") {
    if (!productChoicesInst) return [];
    const wantedRollOrSheet = itemTypeSelect.value;
    const seen = new Map();
    allLabelStockMasters
      .filter((m) => !wantedRollOrSheet || (m.rollOrSheet || "").toUpperCase() === wantedRollOrSheet)
      .forEach((m) => {
        const sku = m.skuCode || "";
        if (sku && !seen.has(sku)) seen.set(sku, m.productCode || sku);
      });
    const values = [...seen.keys()];
    productChoicesInst.clearStore();
    productChoicesInst.setChoices(
      [
        { value: "", label: "Select Product Code", disabled: true, selected: !selected },
        ...values.map((value) => ({ value, label: seen.get(value), selected: value === selected })),
      ],
      "value", "label", true,
    );
    return values;
  }

  // Sets the picker to reflect an already-resolved item (edit mode, or the
  // "only one item exists" auto-select path).
  function syncLabelStockPickerFromItem(item) {
    if (!item) return;
    populateProductChoices(item.details?.skuCode || "");
  }

  function resetLabelStockPicker() {
    populateProductChoices("");
  }

  // Clears whatever item the picker had resolved (without touching the
  // picker's own selection) -- used when the Product Code selection can't be
  // resolved to a binding. Deselects only -- must NOT rebuild itemChoices'
  // option list down to a single placeholder, or a real item the picker
  // resolves to next would no longer exist as a choosable option.
  function clearResolvedLabelStockItem() {
    if (!itemChoices) return;
    itemChoices.removeActiveItems();
    if (itemSelect) itemSelect.value = "";
    updateStockDisplay();
  }

  // Multiple bindings can share the same product code (differing paper size
  // / running meters) -- the first match is used; Paper Size / RM stay
  // editable on the order itself if this one needs to differ.
  //
  // The picker now lists every Label Stock master product, not just ones
  // already bound to this client -- so a pick may not resolve to a binding
  // at all. When it doesn't, labelStockMasterId is set instead of itemId,
  // and POST /sales/order auto-creates the binding from labelStockMasterId +
  // whatever's typed for Rate/Paper Size/RM/Location. Rate stays editable
  // either way -- editing it for an already-bound product revises that
  // binding's rate for every future order too (see the LABEL_STOCK branch of
  // POST /sales/order), not just this one.
  function onLabelStockProductChange() {
    const sku = document.getElementById("label-stock-product-select")?.value || "";
    const masterIdInput = document.getElementById("label-stock-master-id");
    const match = sku ? latestLabelStockItems.find((it) => (it.details?.skuCode || "") === sku) : null;

    if (match) {
      if (masterIdInput) masterIdInput.value = "";
      if (rateDisplayInput) {
        rateDisplayInput.readOnly = false;
        rateDisplayInput.placeholder = "Rate (editing updates the client binding)";
      }
      setChoiceValue(itemChoices, itemSelect, match._id);
      updateStockDisplay();
      return;
    }

    clearResolvedLabelStockItem();
    const master = sku ? allLabelStockMasters.find((m) => (m.skuCode || "") === sku) : null;
    if (masterIdInput) masterIdInput.value = master?._id || "";
    if (rateDisplayInput) {
      rateDisplayInput.readOnly = !master;
      rateDisplayInput.placeholder = master ? "Enter rate (new client binding)" : "Rate";
    }
  }

  async function updateStockDisplay() {
    if (!itemChoices) return;
    const selectedOption = itemChoices.getValue(); // Choices.js object
    const stockDisplay = document.getElementById("stock-display");
    const detailsBox = document.getElementById("selected-item-details");
    updateRateDisplay(selectedOption);
    updateQtyUnitBadge(selectedOption);
    if (isLabelStockItemType(itemTypeSelect.value)) updateLabelStockSpecFields(selectedOption);
    
    // Reset location selection
    sourceLocationInput.value = "";
    hideStockWarning();

    // Label Stock has no real stock model -- but still show the same
    // stock-location bar Tape uses when it has no stock data yet: every
    // known location as a selectable radio (not locked to just the
    // binding's own one), Total/Booked/Balance shown as "-". The bound
    // item's own location is pre-checked, but the person can still pick a
    // different one.
    if (isLabelStockItemType(itemTypeSelect.value)) {
      if (selectedOption && selectedOption.customProperties) {
        try {
          currentSelectedDetails = JSON.parse(selectedOption.customProperties.details || "{}");
        } catch (_) {
          currentSelectedDetails = null;
        }
      } else {
        currentSelectedDetails = null;
      }
      renderSelectedItemDetailsTable();

      const itemLocation = normalizeLocationName(selectedOption?.customProperties?.location || "");

      try {
        const locRes = await fetch("/sachiko/api/locations");
        const allLocations = await locRes.json();

        const locationHtml = (Array.isArray(allLocations) ? allLocations : []).map((locName) => {
          const isSelected = normalizeLocationName(locName) === itemLocation;
          return `<label class="location-option${isSelected ? " selected" : ""}" data-location="${locName}" data-qty="-" data-booked="-" data-balance="-">
              <input type="radio" name="locationRadio" class="location-radio" value="${locName}" data-qty="-" data-booked="-" data-balance="-" ${isSelected ? "checked" : ""} />
              <span class="location-label">${locName}:</span>
              <span class="location-qty">-</span>
            </label>`;
        }).join("");

        stockDisplay.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 22px; flex-wrap: nowrap; width: max-content; min-width: 100%;">
            <div style="display: inline-flex; flex-wrap: nowrap; align-items: center; white-space: nowrap;">
              ${locationHtml}
            </div>
            <div id="stock-stats" style="display: inline-flex; gap: 14px; align-items: center; flex-wrap: nowrap; white-space: nowrap;">
              <div style="font-weight: 700; color: #044A78; font-size: 16px;">
                <i class="fa-solid fa-box-open"></i> Total: <span id="stat-total">-</span>
              </div>
              <div style="font-weight: 700; color: #d97706; font-size: 16px;" title="Pending Orders">
                <i class="fa-regular fa-clock"></i> Booked: <span id="stat-booked">-</span>
              </div>
              <div style="font-weight: 700; color: #059669; font-size: 16px;" title="Available for new orders">
                <i class="fa-solid fa-scale-balanced"></i> Balance: <span id="stat-balance">-</span>
              </div>
            </div>
          </div>
        `;
        stockDisplay.style.display = "block";

        stockDisplay.querySelectorAll('input[name="locationRadio"]').forEach((radio) => {
          radio.addEventListener("change", function () {
            syncSourceLocation(this.value);
            stockDisplay.querySelectorAll(".location-option").forEach((el) => el.classList.remove("selected"));
            this.closest(".location-option").classList.add("selected");
          });
        });

        syncSourceLocation(itemLocation);
      } catch (e) {
        console.error("Failed to build Label Stock location display", e);
      }

      return;
    }

    if (selectedOption && selectedOption.customProperties && selectedOption.customProperties.stock) {
      try {
        currentSelectedDetails = JSON.parse(selectedOption.customProperties.details || "{}");
        renderSelectedItemDetailsTable();
      } catch (_) {
        currentSelectedDetails = null;
        detailsBox.style.display = "none";
        detailsBox.innerHTML = "";
      }

      try {
        const stock = JSON.parse(selectedOption.customProperties.stock);
        
        const locRes = await fetch("/sachiko/api/locations");
        const allLocations = await locRes.json();

        // Build "ALL" option
        let locationHtml = `<label class="location-option selected" data-location="ALL" data-qty="${stock.totalStock}" data-booked="${stock.booked || 0}" data-balance="${stock.balance || 0}">
              <input type="radio" name="locationRadio" class="location-radio" value="ALL" data-qty="${stock.totalStock}" data-booked="${stock.booked || 0}" data-balance="${stock.balance || 0}" checked />
              <span class="location-label">ALL:</span>
              <span class="location-qty">${stock.totalStock}</span>
            </label>`;

        // Build per-location options
        locationHtml += allLocations.map(locName => {
          const locData = (stock.locations || []).find(l => l.location === locName);
          const qty = locData ? locData.qty : 0;
          const booked = locData ? (locData.booked || 0) : 0;
          const balance = locData ? (locData.balance || 0) : 0;
          return `<label class="location-option" data-location="${locName}" data-qty="${qty}" data-booked="${booked}" data-balance="${balance}">
              <input type="radio" name="locationRadio" class="location-radio" value="${locName}" data-qty="${qty}" data-booked="${booked}" data-balance="${balance}" />
              <span class="location-label">${locName}:</span>
              <span class="location-qty">${qty}</span>
            </label>`;
        }).join("");

        stockDisplay.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 22px; flex-wrap: nowrap; width: max-content; min-width: 100%;">
            <div style="display: flex; flex-wrap: nowrap; align-items: center;">${locationHtml}</div>
            <div id="stock-stats" style="display: flex; gap: 14px; align-items: center; flex-wrap: nowrap;">
              <div style="font-weight: 700; color: #044A78; font-size: 16px;">
                <i class="fa-solid fa-box-open"></i> Total: <span id="stat-total">${stock.totalStock || 0}</span>
              </div>
              <div style="font-weight: 700; color: #d97706; font-size: 16px;" title="Pending Orders">
                <i class="fa-regular fa-clock"></i> Booked: <span id="stat-booked">${stock.booked || 0}</span>
              </div>
              <div id="stat-balance-wrap" style="font-weight: 700; color: ${Number(stock.balance) < 0 ? '#ef4444' : '#059669'}; font-size: 16px;" title="Available for new orders">
                <i class="fa-solid fa-scale-balanced"></i> Balance: <span id="stat-balance">${stock.balance || 0}</span>
              </div>
            </div>
          </div>
        `;
        stockDisplay.style.display = "block";

        // Attach radio button listeners
        stockDisplay.querySelectorAll('input[name="locationRadio"]').forEach(radio => {
          radio.addEventListener("change", function () {
            if (dispatchLocationLocked && normalizeLocationName(this.value) !== lockedDispatchLocation) {
              showDispatchLocationLockedToast();
              enforceLockedDispatchLocation();
              return;
            }

            // Set source location (empty for ALL so validation catches it)
            syncSourceLocation(this.value === "ALL" ? "" : this.value);

            // Highlight selected
            stockDisplay.querySelectorAll('.location-option').forEach(el => el.classList.remove('selected'));
            this.closest('.location-option').classList.add('selected');

            // Update stats display
            document.getElementById("stat-total").textContent = this.dataset.qty;
            document.getElementById("stat-booked").textContent = this.dataset.booked;
            
            const bal = Number(this.dataset.balance) || 0;
            const balEl = document.getElementById("stat-balance");
            const balWrap = document.getElementById("stat-balance-wrap");
            balEl.textContent = bal;
            if (balWrap) {
              balWrap.style.color = bal < 0 ? "#ef4444" : "#059669";
            }

            // Check quantity warning
            checkStockWarning();
          });
        });

        if (dispatchLocationLocked) {
          enforceLockedDispatchLocation();
        }

        // ================= PRE-SELECT LOCATION =================
        // 1) Edit mode: prefer existing source location
        if (orderToEdit && orderToEdit.sourceLocation) {
          const editLocation = normalizeLocationName(orderToEdit.sourceLocation);
          const locRadio = stockDisplay.querySelector(`input[name="locationRadio"][value="${editLocation}"]`);
          if (locRadio) {
            locRadio.checked = true;
            locRadio.dispatchEvent(new Event('change'));
            if (confirmMode) lockDispatchLocation(editLocation);
          } else if (editLocation) {
            syncSourceLocation(editLocation);
            if (confirmMode) lockDispatchLocation(editLocation);
          }
        } else {
          // 2) Create mode: preselect user's location if available
          const userLocationValue = normalizeLocationName(locationSelect?.value || "");
          if (userLocationValue) {
            const userLocRadio = stockDisplay.querySelector(`input[name="locationRadio"][value="${userLocationValue}"]`);
            if (userLocRadio) {
              userLocRadio.checked = true;
              userLocRadio.dispatchEvent(new Event('change'));
              if (confirmMode) lockDispatchLocation(userLocationValue);
            } else {
              // Fallback if stock widget doesn't contain this location
              syncSourceLocation(userLocationValue);
              if (confirmMode) lockDispatchLocation(userLocationValue);
            }
          }
        }

      } catch (e) {
        console.error("Error parsing stock data", e);
        stockDisplay.style.display = "block";
      }
    } else {
      currentSelectedDetails = null;
      renderSelectedItemDetailsTable();
      try {
        const locRes = await fetch("/sachiko/api/locations");
        const allLocations = await locRes.json();

        const locationHtml = (Array.isArray(allLocations) ? allLocations : []).map((locName) => {
          return `<label class="location-option" data-location="${locName}" data-qty="-" data-booked="-" data-balance="-">
              <input type="radio" name="locationRadio" class="location-radio" value="${locName}" data-qty="-" data-booked="-" data-balance="-" />
              <span class="location-label">${locName}:</span>
              <span class="location-qty">-</span>
            </label>`;
        }).join("");

        stockDisplay.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 22px; flex-wrap: nowrap; width: max-content; min-width: 100%;">
            <div style="display: inline-flex; flex-wrap: nowrap; align-items: center; white-space: nowrap;">
              ${locationHtml}
            </div>
            <div id="stock-stats" style="display: inline-flex; gap: 14px; align-items: center; flex-wrap: nowrap; white-space: nowrap;">
              <div style="font-weight: 700; color: #044A78; font-size: 16px;">
                <i class="fa-solid fa-box-open"></i> Total: <span id="stat-total">-</span>
              </div>
              <div style="font-weight: 700; color: #d97706; font-size: 16px;" title="Pending Orders">
                <i class="fa-regular fa-clock"></i> Booked: <span id="stat-booked">-</span>
              </div>
              <div style="font-weight: 700; color: #059669; font-size: 16px;" title="Available for new orders">
                <i class="fa-solid fa-scale-balanced"></i> Balance: <span id="stat-balance">-</span>
              </div>
            </div>
          </div>
        `;
        stockDisplay.style.display = "block";

        stockDisplay.querySelectorAll('input[name="locationRadio"]').forEach((radio) => {
          radio.addEventListener("change", function () {
            if (dispatchLocationLocked && normalizeLocationName(this.value) !== lockedDispatchLocation) {
              showDispatchLocationLockedToast();
              enforceLockedDispatchLocation();
              return;
            }

            syncSourceLocation(this.value === "ALL" ? "" : this.value);
            stockDisplay.querySelectorAll('.location-option').forEach(el => el.classList.remove('selected'));
            this.closest('.location-option').classList.add('selected');
          });
        });
      } catch (e) {
        console.error("Failed to build placeholder stock display", e);
      }
      if (detailsBox) {
        detailsBox.style.display = "none";
        detailsBox.innerHTML = "";
      }
    }
  }

  function checkStockWarning() {
    const qty = parseQty(quantityInput);
    const selectedRadio = document.querySelector('input[name="locationRadio"]:checked');

    if (!selectedRadio || qty <= 0) {
      hideStockWarning();
      return;
    }

    const availableQty = parseInt(selectedRadio.dataset.qty) || 0;
    const warningDiv = document.getElementById("stock-warning");
    const warningText = document.getElementById("stock-warning-text");

    const isConfirmPage = window.location.pathname.includes('/sales/order/confirm');

    if (qty > availableQty && !isConfirmPage) {
      warningText.innerHTML = `Ordered quantity <b>${qty}</b> exceeds available stock <b>${availableQty}</b> at ${selectedRadio.value}. Order can still be created.`;
      warningDiv.style.display = "block";
    } else {
      hideStockWarning();
    }
  }

  function hideStockWarning() {
    document.getElementById("stock-warning").style.display = "none";
  }

  // Helper: set the Location choices field from a user object
  // Populate the location dropdown from the user's locations. A location is
  // auto-selected only when there is exactly one (or a preferred one is given);
  // when the user has several, we leave it on the placeholder so the operator
  // deliberately picks the location that scopes the item list.
  function setLocationFromUser(user, preferredLocation = "", { autoSelectFirst = false } = {}) {
    if (!locationChoices) return "";
    const entries = getUserLocationEntries(user);
    const preferred = normalizeLocationName(preferredLocation || "");
    if (preferred && !entries.some((entry) => normalizeLocationName(entry.value) === preferred)) {
      entries.unshift({ value: preferred, label: preferred });
    }

    let selectedEntry = null;
    if (preferred) {
      selectedEntry = entries.find((entry) => normalizeLocationName(entry.value) === preferred) || null;
    }
    if (!selectedEntry) {
      if (entries.length === 1) selectedEntry = entries[0];
      else if (autoSelectFirst) selectedEntry = entries[0] || null;
    }
    const loc = normalizeLocationName(selectedEntry?.value || "");

    programmaticLocationUpdate = true;
    locationChoices.clearStore();
    locationChoices.setChoices(
      entries.length > 0
        ? [
            { value: "", label: "Select Location", disabled: true, selected: !loc },
            ...entries.map((entry) => ({
              value: entry.value,
              label: entry.label,
              selected: normalizeLocationName(entry.value) === loc,
            })),
          ]
        : [{ value: "", label: "N/A", disabled: true, selected: true }],
      "value", "label", true
    );
    if (loc) {
      locationSelect.value = loc;
      syncSourceLocation(loc);
      locationChoices.setChoiceByValue?.(loc);
    } else {
      locationSelect.value = "";
      syncSourceLocation("");
    }
    programmaticLocationUpdate = false;
    return loc;
  }

  function setLocationField(value) {
    if (!locationChoices) return;
    const loc = normalizeLocationName(value || "");
    programmaticLocationUpdate = true;
    locationChoices.clearStore();
    locationChoices.setChoices(
      loc ? [{ value: loc, label: loc, selected: true }] : [{ value: "", label: "N/A", disabled: true, selected: true }],
      "value",
      "label",
      true,
    );
    locationSelect.value = loc;
    programmaticLocationUpdate = false;
  }

  // ======= EVENT LISTENERS (Smart Cascading Filter) =======

  // 1. Item Type → filter clients, reset everything downstream
  itemTypeSelect.addEventListener("change", () => {
    const itemType = itemTypeSelect.value;
    updateLabelStockFieldsVisibility();
    if (typeof aiOnItemTypeChange === "function") aiOnItemTypeChange();
    if (itemType) loadClients(itemType);
  });

  // 2. Client → load filtered users, reset user/location/item
  clientSelect.addEventListener("change", () => {
    resetUsers();
    loadUsers(clientSelect.value);
  });

  locationSelect.addEventListener("change", () => {
    if (confirmMode && dispatchLocationLocked) {
      showDispatchLocationLockedToast();
      enforceLockedDispatchLocation();
      return;
    }

    // Genuine location pick → reload the item list scoped to this location.
    // (Skip programmatic updates and confirm mode, which uses a fixed item.)
    // resetItems() clears the source location, so re-sync it afterwards.
    if (!programmaticLocationUpdate && !confirmMode) {
      resetItems();
      loadItems(null, null, locationSelect.value);
    }

    syncSourceLocation(locationSelect.value);
    const stockDisplay = document.getElementById("stock-display");
    if (stockDisplay && locationSelect.value) {
      const normalizedLocation = normalizeLocationName(locationSelect.value);
      const radio = stockDisplay.querySelector(`input[name="locationRadio"][value="${normalizedLocation}"]`);
      if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event("change", { bubbles: true }));
      }
    }
  });

  // 3. User → populate locations; items load once a location is chosen
  userSelect.addEventListener("change", () => {
    if (programmaticUserUpdate) return; // loadUsers() drives the programmatic path
    const selected = userChoices.getValue();
    userNameHidden.value = selected?.customProperties?.name || selected?.label || "";
    // resetItems() clears the source location, so populate the location AFTER it.
    resetItems();
    const loc = setLocationFromUser({
      userLocation: selected?.customProperties?.location || "",
      locationDetails: selected?.customProperties?.locationDetails || [],
    });
    // Single-location user → location auto-selected → load now. Multi-location →
    // loadItems shows "Select a location first" until the operator picks one.
    loadItems(null, null, loc || null);
  });

  // 4. Item → update stock display
  itemSelect.addEventListener("change", updateStockDisplay);
  quantityInput.addEventListener("input", checkStockWarning);
  if (orderRateInput) {
    orderRateInput.addEventListener("input", () => {
      orderRateInput.dataset.userEdited = "true";
    });
  }

  updateStockDisplay();

  function getFieldLabel(field) {
    if (!field?.id) return "This field";
    const label = document.querySelector(`label[for="${field.id}"]`);
    if (!label) return "This field";
    return label.textContent.replace(/\*/g, "").trim() || "This field";
  }

  function getValidationMessage(field) {
    if (!field?.validity) return "Please check required fields.";
    if (field.validity.valueMissing) return `${getFieldLabel(field)} is required.`;
    if (field.validity.typeMismatch) return `Please enter a valid ${getFieldLabel(field).toLowerCase()}.`;
    if (field.validity.rangeUnderflow) return `${getFieldLabel(field)} is below allowed minimum.`;
    if (field.validity.rangeOverflow) return `${getFieldLabel(field)} exceeds allowed maximum.`;
    if (field.validity.stepMismatch) return `${getFieldLabel(field)} has an invalid value.`;
    if (field.validity.patternMismatch) return `${getFieldLabel(field)} format is invalid.`;
    return field.validationMessage || `Please enter a valid ${getFieldLabel(field).toLowerCase()}.`;
  }

  function getSelectedStockLocation() {
    const selectedRadio = document.querySelector('input[name="locationRadio"]:checked');
    const selectedChipLocation = normalizeLocationName(document.querySelector(".location-option.selected")?.dataset?.location || "");
    const radioLocation = normalizeLocationName(selectedRadio?.value || "");
    const fallbackLocation = normalizeLocationName(currentSourceLocation || sourceLocationInput.value || locationSelect.value || selectedChipLocation || "");
    return {
      selectedRadio,
      radioLocation,
      selectedLocation: radioLocation && radioLocation !== "ALL" ? radioLocation : fallbackLocation,
    };
  }

  function getAvailableStockForSelectedLocation(selectedRadio) {
    if (!selectedRadio) return 0;
    const balance = Number.parseInt(selectedRadio.dataset.balance || "", 10);
    if (Number.isFinite(balance)) return balance;
    const qty = Number.parseInt(selectedRadio.dataset.qty || "", 10);
    return Number.isFinite(qty) ? qty : 0;
  }

  function getAvailableStockForLocation(locationName) {
    const normalizedLocation = normalizeLocationName(locationName);
    if (!normalizedLocation) return 0;

    if (normalizedLocation === "ALL") {
      const totalBalance = Number.parseInt(stockInfo?.balance ?? stockInfo?.totalStock ?? 0, 10);
      return Number.isFinite(totalBalance) ? totalBalance : 0;
    }

    const locationEntry = (stockInfo?.locations || []).find((entry) => normalizeLocationName(entry?.location) === normalizedLocation);
    if (locationEntry) {
      const balance = Number.parseInt(locationEntry.balance ?? locationEntry.qty ?? 0, 10);
      return Number.isFinite(balance) ? balance : 0;
    }

    const selectedRadio = document.querySelector(`input[name="locationRadio"][value="${normalizedLocation}"]`);
    return getAvailableStockForSelectedLocation(selectedRadio);
  }

  function getPhysicalStockForLocation(locationName) {
    const normalizedLocation = normalizeLocationName(locationName);
    if (!normalizedLocation) return 0;

    if (normalizedLocation === "ALL") {
      const totalStock = Number.parseInt(stockInfo?.totalStock ?? 0, 10);
      return Number.isFinite(totalStock) ? totalStock : 0;
    }

    const locationEntry = (stockInfo?.locations || []).find((entry) => normalizeLocationName(entry?.location) === normalizedLocation);
    if (locationEntry) {
      const qty = Number.parseInt(locationEntry.qty ?? 0, 10);
      return Number.isFinite(qty) ? qty : 0;
    }

    const selectedRadio = document.querySelector(`input[name="locationRadio"][value="${normalizedLocation}"]`);
    if (selectedRadio) {
      const qty = Number.parseInt(selectedRadio.dataset.qty || "0", 10);
      return Number.isFinite(qty) ? qty : 0;
    }
    return 0;
  }

  function selectStockLocation(locationName) {
    const normalizedLocation = normalizeLocationName(locationName);
    if (!normalizedLocation) return false;

    const stockDisplay = document.getElementById("stock-display");
    const radio = stockDisplay?.querySelector(`input[name="locationRadio"][value="${normalizedLocation}"]`);
    if (!radio) return false;

    radio.checked = true;
    radio.dispatchEvent(new Event("change", { bubbles: true }));
    return true;
  }

  function setSubmittingState(isSubmitting) {
    if (!orderForm) return;
    orderForm.dataset.submitting = isSubmitting ? "1" : "0";
    if (submitButton) submitButton.disabled = !!isSubmitting;
  }

  function isTemplateOnlyInvoice(invoice) {
    const value = String(invoice || "").trim();
    if (!value) return true;
    return /^TECH\|IN\|\d{2}-\d{2}\|[A-Z_]+\|$/i.test(value);
  }

  // Form validation — prevent submit on invalid fields, disallow ALL location, and enforce min qty
  orderForm.addEventListener("submit", async function (e) {
    e.preventDefault();
    e.stopImmediatePropagation();
    if (orderForm.dataset.submitting === "1") return false;
    setSubmittingState(true);

    // Est Delivery Date can't be earlier than PO Date (create/edit only --
    // dispatch doesn't touch these dates).
    const _poDateVal = (poDateInput?.value || "").trim();
    const _estDateVal = (estimatedDateInput?.value || "").trim();
    if (!confirmMode && _poDateVal && _estDateVal && _estDateVal < _poDateVal) {
      showToast("Est Delivery Date cannot be earlier than the PO Date.", "error");
      estimatedDateInput?.focus?.();
      setSubmittingState(false);
      return false;
    }

    const firstInvalid = orderForm.querySelector(":invalid");
    if (firstInvalid) {
      showToast(getValidationMessage(firstInvalid), "error");
      firstInvalid.focus?.();
      setSubmittingState(false);
      return false;
    }

    const poValue = (poNumberInput?.value || "").trim();
    if (!poValue) {
      showToast("PO Number is required.", "error");
      poNumberInput?.focus?.();
      setSubmittingState(false);
      return false;
    }

    if (confirmMode) {
      const invoiceValue = (document.getElementById("invoice-number")?.value || "").trim();
      if (!invoiceValue || isTemplateOnlyInvoice(invoiceValue)) {
        showToast("Please enter Invoice Number before submitting the form.", "error");
        document.getElementById("invoice-number")?.focus?.();
        setSubmittingState(false);
        return false;
      }
    }

    const itemType = itemTypeSelect.value;
    const qty = parseQty(quantityInput);
    const selectedOption = itemChoices.getValue();
    const { selectedRadio, radioLocation, selectedLocation } = getSelectedStockLocation();
    
    // Check Source Location - ALL is not allowed for stock-based items
    if (itemType === "TAPE") {
      const effectiveLocation = normalizeLocationName(
        selectedLocation || sourceLocationInput.value || currentSourceLocation || locationSelect.value || "",
      );

      if (!effectiveLocation || effectiveLocation === "ALL") {
        showToast("no location is selected", "error");
        setSubmittingState(false);
        return false;
      }

      if (radioLocation === "ALL") {
        const fallbackRadio = document.querySelector(`input[name="locationRadio"][value="${effectiveLocation}"]`);
        if (fallbackRadio) {
          fallbackRadio.checked = true;
          fallbackRadio.dispatchEvent(new Event("change", { bubbles: true }));
        }
      }

      sourceLocationInput.value = effectiveLocation;
    }

    const dispatchQty = confirmMode ? (parseInt(confirmQuantityInput?.value) || 0) : qty;
    // Only Tape has physical stock (matches the backend's onModel !== "SachikoLabelStock"
    // bypass in POST /sales/order/status) — skip the physical-stock check for Label Stock.
    if (confirmMode && itemType === "TAPE") {
      const confirmLocation = normalizeLocationName(sourceLocationInput.value || currentSourceLocation || selectedLocation || selectedRadio?.value || "");
      // Validate against physical stock (qty) instead of available balance during dispatch
      const physicalQty = getPhysicalStockForLocation(confirmLocation);
      if (physicalQty <= 0 || dispatchQty > physicalQty) {
        showToast("cannot dispatch, not enough stocks", "error");
        setSubmittingState(false);
        return;
      }
    }

    // Label Stock orders need Paper Size, RM, and No of Rolls filled in.
    if (isLabelStockItemType(itemType)) {
      const aiTableDriving = typeof aiIsActive === "function" && aiTableMode();

      if (aiTableDriving) {
        // New Label Stock order: the "Order Items" table is the sole editor.
        // A location is still needed so any new bindings can be auto-created.
        const tableLocation = normalizeLocationName(selectedLocation || sourceLocationInput.value || locationSelect.value || "");
        if (!tableLocation || tableLocation === "ALL") {
          showToast("Select a Location for this PO.", "error");
          setSubmittingState(false);
          return false;
        }
        sourceLocationInput.value = tableLocation;

        const aiErr = aiValidateRows();
        if (aiErr) {
          showToast(aiErr, "error");
          setSubmittingState(false);
          return false;
        }
      } else {
        // Single-item path (edit / non-table): Paper Size, RM, No of Rolls.
        const paperSizeVal = document.getElementById("paper-size")?.value.trim();
        const runningMetersVal = document.getElementById("running-meters")?.value;
        const noOfRollsVal = document.getElementById("no-of-rolls")?.value;
        if (!paperSizeVal || !runningMetersVal || !noOfRollsVal) {
          showToast("Paper Size, RM, and No of Rolls are required for Label Stock orders.", "error");
          setSubmittingState(false);
          return false;
        }
        if (!(parseFloat(paperSizeVal) < 1000)) {
          showToast("Paper Size must be a number less than 1000.", "error");
          setSubmittingState(false);
          return false;
        }
        if (parseFloat(runningMetersVal) > 2000) {
          showToast("RM cannot exceed 2000.", "error");
          setSubmittingState(false);
          return false;
        }

        // No existing Label Stock Binding was resolved for the picked product
        // (itemSelect stayed empty) -- POST /sales/order auto-creates one from
        // labelStockMasterId, which needs a Rate and a Location the same way a
        // manually-created binding would.
        if (!itemSelect.value) {
          const masterIdVal = document.getElementById("label-stock-master-id")?.value;
          if (!masterIdVal) {
            showToast("Select a Product Code.", "error");
            setSubmittingState(false);
            return false;
          }
          const rateVal = parseFloat(rateDisplayInput?.value);
          if (!Number.isFinite(rateVal) || rateVal <= 0) {
            showToast("Rate is required to bind this product to the client.", "error");
            setSubmittingState(false);
            return false;
          }
          const newBindingLocation = normalizeLocationName(selectedLocation || sourceLocationInput.value || locationSelect.value || "");
          if (!newBindingLocation || newBindingLocation === "ALL") {
            showToast("Select a location for this product.", "error");
            setSubmittingState(false);
            return false;
          }
          sourceLocationInput.value = newBindingLocation;
        }
      }
    }

    // Check Minimum Order Qty. Qty and MOQ are always in the same unit
    // (rolls vs rolls, labels vs labels) so no conversion needed. Skipped when
    // the Order Items table is driving (per-row No of Rolls, not this field).
    if (!(typeof aiIsActive === "function" && aiIsActive()) && selectedOption && selectedOption.customProperties) {
      const cp = selectedOption.customProperties;
      let cpDetails = {};
      try { cpDetails = JSON.parse(cp.details || "{}"); } catch (e) { cpDetails = {}; }
      const isLabel = cpDetails.type === "LABEL" || cpDetails.type === "COLOR_LABEL";
      const minQty = parseInt(cp.minQty) || 0;
      const effectiveMin = minQty;

      if (effectiveMin > 0 && qty < effectiveMin) {
        let moqText = String(minQty);
        if (isLabel) {
          // Labels and Color Labels are always MOQ'd in labels now,
          // regardless of what an older binding has stored for moqUnit.
          moqText = `${minQty} labels`;
        }
        showToast(`Order quantity (${qty}) is less than Minimum Order Quantity (${moqText}).`, "error");
        setSubmittingState(false);
        return;
      }
    }

    // Normalize the displayed quantity (strip commas) so it submits as a plain number
    quantityInput.value = String(qty);

    // For create/update sales order, submit via AJAX so backend JSON errors show as toast
    const actionPath = orderForm.getAttribute("action") || "";
    if (actionPath === "/sachiko/sales/order" || actionPath === "/sachiko/sales/order/status") {
      try {
        const formData = new FormData(orderForm);
        const payload = new URLSearchParams();
        for (const [key, value] of formData.entries()) {
          // The server only ever knows "LABEL_STOCK" (see POST /sales/order) --
          // Roll/Sheet is purely this form's own Item Type split, translated
          // back here rather than taught to the backend.
          payload.append(key, key === "itemType" ? toServerItemType(value) : value);
        }

        // New Label Stock order: append lines[0..N] from the Order Items table
        // so POST /sales/order takes its multi-line branch.
        if (actionPath === "/sachiko/sales/order" && typeof aiIsActive === "function" && aiIsActive()) {
          aiAppendLines(payload);
        }

        const res = await fetch(actionPath, {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
            "Accept": "application/json"
          },
          body: payload.toString()
        });

        let data = null;
        try {
          data = await res.json();
        } catch (_) {
          data = null;
        }

        if (!res.ok || (data && data.success === false)) {
          showToast(data?.message || "Failed to submit order", "error");
          setSubmittingState(false);
          return false;
        }

        if (data?.redirect) {
          window.location.href = data.redirect;
          return true;
        }

        if (actionPath === "/sachiko/sales/order/status") {
          showToast("Order dispatched successfully", "success");
        } else {
          showToast("Sales order submitted successfully", "success");
        }
        window.location.reload();
        return true;
      } catch (err) {
        console.error("Sales order submit error:", err);
        showToast("Network error while submitting order", "error");
        setSubmittingState(false);
        return false;
      }
    }

    orderForm.submit();
    return true;
  });



