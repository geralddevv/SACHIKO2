<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<style>
  @keyframes popIn {
    0% { transform: scale(0.94); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .btn-action {
    height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
    font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
  }
  .btn-action:hover { opacity: 0.85; }

  /* ============ Set Deckle dialog ============
     .logout-modal is global (boilerplate.ejs, handles the fade backdrop);
     .ds-dialog replaces .logout-dialog's own sizing/padding so the header/
     body/footer can each own their own chrome -- overflow:hidden here is
     safe (unlike the CLAUDE.md dialog rule against it) because nothing
     inside this dialog is a Choices.js dropdown that could get clipped. */
  .ds-dialog {
    width: min(1040px, 96vw);
    max-height: min(680px, 88vh);
    padding: 0;
    border: none;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    display: flex;
    flex-direction: column;
    box-shadow: 0 24px 60px rgba(4, 74, 120, 0.28);
    transform: scale(0.96);
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  #setDeckleDialog.show .ds-dialog { transform: scale(1); }

  .ds-dialog-header {
    flex: none;
    background: linear-gradient(135deg, #044a78 0%, #03365a 100%);
    padding: 14px 24px;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
  }
  .ds-dialog-header h2 { margin: 0; font-size: 17px; font-weight: 700; color: #fff; letter-spacing: 0.2px; }
  .ds-dialog-subtitle { margin: 4px 0 0; font-size: 12.5px; color: rgba(255, 255, 255, 0.75); }
  .ds-close-btn {
    flex: none; border: none; background: rgba(255, 255, 255, 0.14); color: #fff;
    width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-size: 13px;
    display: flex; align-items: center; justify-content: center; transition: background 0.15s ease;
  }
  .ds-close-btn:hover { background: rgba(255, 255, 255, 0.26); }

  /* #ds-dialog-form wraps the body + footer -- it has to be a flex column
     itself (matching .ds-dialog's own display:flex column), or the flex/
     overflow rules on its children below are no-ops (flex properties only
     do anything on children of a flex container). min-height:0 on both the
     form and the body is the other half of the classic flexbox-scroll
     gotcha: without it a flex item won't shrink below its content's natural
     height, so overflow-y:auto never actually engages -- the body just
     grows past .ds-dialog's max-height and the footer gets clipped by its
     overflow:hidden instead of staying visible with the body scrolling. */
  #ds-dialog-form { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
  .ds-dialog-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 14px 24px; }

  /* Two columns so the order/size decision (left) and the stock options
     that inform it (right) are both visible without scrolling -- the whole
     point being to compare them "in a single glance" rather than stacked. */
  .ds-dialog-columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 26px; align-items: stretch; }
  .ds-dialog-col-left { display: flex; flex-direction: column; min-width: 0; }
  .ds-dialog-col-right { display: flex; flex-direction: column; min-width: 0; border-left: 1px solid #e6eaf2; padding-left: 26px; }
  .ds-dialog-col-right .ds-size-list { flex: 1 1 auto; max-height: none; margin-bottom: 0; }
  @media (max-width: 720px) {
    .ds-dialog-columns { grid-template-columns: 1fr; }
    .ds-dialog-col-right { border-left: none; padding-left: 0; border-top: 1px dashed #e6eaf2; padding-top: 20px; margin-top: 4px; }
  }

  .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #044a78; border-radius: 10px; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

  .ds-dialog-summary {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px 16px;
    padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px dashed #e2e8f0;
  }
  .ds-summary-item { display: flex; flex-direction: column; gap: 6px; }
  .ds-summary-label { font-size: 12px; color: #5a6586; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; }
  /* Boxed to match the height of the Deckle Qty/Running Mtrs inputs beside
     it (same border/radius/padding/font-size as
     .ds-manual-field--grid .ds-input-wrap input below) -- it's read-only,
     not editable, but the row should still line up as one uniform height. */
  .ds-summary-value {
    display: block; font-size: 16px; color: #1f2a44; font-weight: 700;
    border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 9px 12px; background: #f8fafc;
  }

  .ds-section-label { font-size: 12px; font-weight: 700; color: #044a78; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 8px; }

  .ds-size-list { display: flex; flex-direction: column; gap: 6px; max-height: 220px; overflow-y: auto; padding: 2px 2px 2px 0; margin-bottom: 12px; }
  .ds-size-row {
    display: flex; align-items: center; gap: 12px; padding: 9px 14px;
    border-radius: 10px; border: 1.5px solid #e6eaf2; cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .ds-size-row:hover { border-color: #a9c8e8; background: #f7fbff; }
  .ds-size-row.is-selected { border-color: #044a78; background: #eef5ff; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.08); }

  .ds-size-radio {
    flex: none; width: 18px; height: 18px; border-radius: 50%; border: 2px solid #cbd5e1;
    display: flex; align-items: center; justify-content: center; transition: border-color 0.15s ease;
  }
  .ds-size-row.is-selected .ds-size-radio { border-color: #044a78; }
  .ds-size-radio::after { content: ""; width: 9px; height: 9px; border-radius: 50%; background: #044a78; transform: scale(0); transition: transform 0.15s ease; }
  .ds-size-row.is-selected .ds-size-radio::after { transform: scale(1); }

  .ds-size-info { flex: 1 1 auto; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ds-size-main-row { display: flex; align-items: center; gap: 8px; }
  .ds-size-main { font-size: 15px; font-weight: 800; color: #1f2a44; }
  .ds-size-badge {
    display: none; font-size: 9.5px; font-weight: 700; color: #fff; background: #059669;
    border-radius: 999px; padding: 2px 8px; letter-spacing: 0.3px;
  }
  .ds-size-row.is-suggested .ds-size-badge { display: inline-block; }
  .ds-size-meta { font-size: 12px; color: #64748b; }

  .ds-size-empty {
    display: flex; align-items: center; gap: 10px; padding: 14px 16px; margin-bottom: 16px;
    background: #fffaf0; border: 1px solid #fde8c9; border-radius: 10px; color: #92400e; font-size: 13px;
  }
  .ds-size-empty i { font-size: 16px; }

  .ds-manual-field { padding-bottom: 12px; }
  .ds-manual-field label {
    display: block; font-size: 12px; font-weight: 700; color: #5a6586;
    margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.3px;
  }
  /* Size/Running Mtrs sit as grid items inside .ds-dialog-summary, alongside
     the read-only Label Stock Code -- no bottom padding of their own (the
     grid row's own padding-bottom/margin-bottom already spaces it from the
     Deckle Size field below), and a shorter input to match that row's
     compact height. */
  .ds-manual-field--grid { padding-bottom: 0; }
  .ds-manual-field--grid .ds-input-wrap input { padding: 9px 12px !important; font-size: 16px !important; font-weight: 700; }
  .ds-input-wrap { position: relative; }
  .ds-input-wrap input { padding-right: 44px !important; }
  /* Deckle Size is the actual decision this dialog exists to make -- give it
     more visual weight than the supporting fields above it. */
  #ds-size-input { font-size: 22px !important; font-weight: 800 !important; color: #044a78; }
  .ds-input-suffix {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    font-size: 13px; font-weight: 700; color: #94a3b8; pointer-events: none;
  }
  .ds-error-text { color: #dc2626; font-size: 12px; margin-top: 8px; min-height: 16px; font-weight: 600; }

  .ds-dialog-footer {
    flex: none; display: flex; justify-content: flex-end; gap: 10px;
    padding: 12px 24px; border-top: 1px solid #e6eaf2; background: #fafbfd;
  }
  .ds-btn {
    border: none; border-radius: 9px; padding: 11px 20px; font-size: 14px; font-weight: 700; cursor: pointer;
    transition: opacity 0.18s ease, transform 0.1s ease; display: inline-flex; align-items: center; gap: 8px;
  }
  .ds-btn:active { transform: scale(0.98); }
  .ds-btn-ghost { background: #eef1f5; color: #475569; }
  .ds-btn-ghost:hover { background: #e2e6ec; }
  .ds-btn-primary { background: linear-gradient(135deg, #044a78 0%, #03365a 100%); color: #fff; }
  .ds-btn-primary:hover { opacity: 0.92; }
</style>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <div class="indi-head">
    <h1>Deckle Set</h1>
    <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
      <a
        href="/sachiko/labels/production/pending"
        style="padding: 6px 14px; background: #044a78; color: white; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;"
        onmouseover="this.style.opacity = '0.85'" onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-industry"></i><span>Pending Production</span>
      </a>
    </div>
  </div>

  <div id="deckle-set-table" class="tabulator tabulator-modern"></div>
</div>

<!-- Set Deckle dialog -->
<div class="logout-modal" id="setDeckleDialog" aria-hidden="true">
  <div class="ds-dialog" role="dialog" aria-modal="true" aria-labelledby="setDeckleDialogTitle">
    <div class="ds-dialog-header">
      <div>
        <h2 id="setDeckleDialogTitle">Set Deckle Size</h2>
        <p class="ds-dialog-subtitle" id="ds-dialog-subtitle"></p>
      </div>
      <button type="button" class="ds-close-btn" id="ds-close-btn" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <form id="ds-dialog-form" method="post" action="" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="ds-dialog-body custom-scrollbar">
        <div class="ds-dialog-columns">
          <div class="ds-dialog-col-left">
            <div class="ds-dialog-summary">
              <div class="ds-summary-item">
                <span class="ds-summary-label">Label Stock Code</span>
                <span class="ds-summary-value" id="ds-product-code">—</span>
              </div>
              <div class="ds-manual-field ds-manual-field--grid">
                <label for="ds-deckle-qty-input">Deckle Qty</label>
                <div class="ds-input-wrap">
                  <input type="number" step="1" min="1" id="ds-deckle-qty-input" name="noOfRolls" class="form-control premium-input" placeholder="Enter deckle qty" required />
                </div>
              </div>
              <div class="ds-manual-field ds-manual-field--grid">
                <label for="ds-running-mtrs-input">Running Mtrs</label>
                <div class="ds-input-wrap">
                  <input type="number" step="any" min="0" id="ds-running-mtrs-input" name="runningMeters" class="form-control premium-input" placeholder="Enter running mtrs" required />
                </div>
              </div>
            </div>

            <div class="ds-manual-field">
              <label for="ds-size-input">Deckle Size</label>
              <div class="ds-input-wrap">
                <input type="number" step="any" min="0" id="ds-size-input" name="deckleSize" class="form-control premium-input" placeholder="Enter deckle size" required />
                <span class="ds-input-suffix">mm</span>
              </div>
              <div id="ds-size-error" class="ds-error-text"></div>
            </div>
          </div>

          <div class="ds-dialog-col-right">
            <div class="ds-section-label">Available Facestock Sizes</div>
            <div id="ds-size-list" class="ds-size-list custom-scrollbar"></div>
            <div id="ds-size-empty" class="ds-size-empty" style="display: none;">
              <i class="fa-solid fa-triangle-exclamation"></i>
              <span>No matching Facestock in stock for this recipe &mdash; enter a size manually.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="ds-dialog-footer">
        <button type="button" class="ds-btn ds-btn-ghost" id="ds-cancel-btn">Cancel</button>
        <button type="submit" class="ds-btn ds-btn-primary"><i class="fa-solid fa-arrow-right-long"></i> Send to Pending Production</button>
      </div>
    </form>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="deckle-set-data" type="application/json"><%- safeJson(rows || []) %></script>

<script>
  const rowsData = JSON.parse(document.getElementById("deckle-set-data").textContent);

  const fmtMtrs = (v) => (Number.isFinite(Number(v)) ? Number(v).toLocaleString("en-IN", { maximumFractionDigits: 2 }) : "—");

  /* ----- Set Deckle dialog ----- */
  const setDeckleDialog = document.getElementById("setDeckleDialog");
  const dsDialogForm = document.getElementById("ds-dialog-form");
  const dsSizeInput = document.getElementById("ds-size-input");
  const dsSizeError = document.getElementById("ds-size-error");
  const dsDeckleQtyInput = document.getElementById("ds-deckle-qty-input");
  const dsRunningMtrsInput = document.getElementById("ds-running-mtrs-input");
  const dsSizeList = document.getElementById("ds-size-list");
  const dsSizeEmpty = document.getElementById("ds-size-empty");

  function closeSetDeckleDialog() {
    setDeckleDialog.classList.remove("show");
    setDeckleDialog.setAttribute("aria-hidden", "true");
  }
  document.getElementById("ds-cancel-btn").addEventListener("click", closeSetDeckleDialog);
  document.getElementById("ds-close-btn").addEventListener("click", closeSetDeckleDialog);
  setDeckleDialog.addEventListener("click", (e) => { if (e.target === setDeckleDialog) closeSetDeckleDialog(); });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && setDeckleDialog.classList.contains("show")) closeSetDeckleDialog();
  });

  /* ----- Cut Preview -- proportional bar for the currently-entered deckle
     size, re-rendered on every keystroke/candidate click so it always
     reflects whatever's in the input, not just the suggestion. ----- */
  let currentDialogRow = null;

  dsSizeInput.addEventListener("input", () => {
    // Typing a value that no longer matches any candidate row (or matches a
    // different one, e.g. after clicking a row then editing it) should drop
    // the stale highlight rather than leave an unrelated row looking picked.
    const typed = dsSizeInput.value;
    dsSizeList.querySelectorAll(".ds-size-row").forEach((r) => {
      r.classList.toggle("is-selected", r.dataset.size === typed);
    });
  });

  function renderSizeList(row) {
    const sizes = Array.isArray(row.candidateSizes) ? row.candidateSizes : [];
    dsSizeEmpty.style.display = sizes.length ? "none" : "flex";
    dsSizeList.style.display = sizes.length ? "flex" : "none";
    dsSizeList.innerHTML = sizes.map((s) => {
      const isSuggested = row.suggestedSize != null && s.size === row.suggestedSize;
      return `
        <div class="ds-size-row${isSuggested ? " is-selected is-suggested" : ""}" data-size="${s.size}">
          <span class="ds-size-radio"></span>
          <span class="ds-size-info">
            <span class="ds-size-main-row">
              <span class="ds-size-main">${s.size}mm</span>
              <span class="ds-size-badge">Best Fit</span>
            </span>
            <span class="ds-size-meta">${s.reelCount} reel${s.reelCount === 1 ? "" : "s"} in stock · ${fmtMtrs(s.totalKg)} kg available</span>
          </span>
        </div>
      `;
    }).join("");

    dsSizeList.querySelectorAll(".ds-size-row").forEach((el) => {
      el.addEventListener("click", () => {
        dsSizeList.querySelectorAll(".ds-size-row").forEach((r) => r.classList.remove("is-selected"));
        el.classList.add("is-selected");
        dsSizeInput.value = el.dataset.size;
        dsSizeError.textContent = "";
      });
    });
  }

  window.openSetDeckleDialog = function (orderId) {
    const row = rowsData.find((r) => String(r._id) === String(orderId));
    if (!row) return;
    currentDialogRow = row;

    document.getElementById("ds-dialog-subtitle").textContent =
      `${row.productCode || "Label Stock"} · ${row.clientName || "—"}`;

    // Label Stock Code is read-only (it's an identifier, not something to
    // edit here); Deckle Qty and Running Mtrs are real inputs -- prefilled
    // from the order, but the planner can correct them before sending this
    // order on to Pending Production.
    document.getElementById("ds-product-code").textContent = row.productCode || "—";
    dsDeckleQtyInput.value = row.noOfRolls != null && row.noOfRolls !== "—" ? row.noOfRolls : "";
    dsRunningMtrsInput.value = row.runningMeters != null ? row.runningMeters : "";

    renderSizeList(row);
    dsSizeInput.value = row.suggestedSize != null ? row.suggestedSize : "";
    dsSizeError.textContent = "";
    dsDialogForm.action = `/sachiko/labels/production/deckle-set/${row._id}`;

    setDeckleDialog.classList.add("show");
    setDeckleDialog.setAttribute("aria-hidden", "false");
  };

  dsDialogForm.addEventListener("submit", (e) => {
    const deckleQty = Number(dsDeckleQtyInput.value);
    if (!deckleQty || deckleQty <= 0) {
      e.preventDefault();
      dsDeckleQtyInput.focus();
      return;
    }
    const runningMtrs = Number(dsRunningMtrsInput.value);
    if (!runningMtrs || runningMtrs <= 0) {
      e.preventDefault();
      dsRunningMtrsInput.focus();
      return;
    }
    const deckleSize = Number(dsSizeInput.value);
    if (!deckleSize || deckleSize <= 0) {
      e.preventDefault();
      dsSizeError.textContent = "Enter a valid deckle size to continue.";
      dsSizeInput.focus();
    }
  });

  /* ----- Table ----- */
  const table = new Tabulator("#deckle-set-table", {
    data: rowsData,
    placeholder: "No orders waiting on a deckle size",
    initialSort: [{ column: "createdAt", dir: "asc" }],
    columns: [
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `<button onclick="openSetDeckleDialog('${row._id}')" class="btn-action" style="background:#10b981;" title="Set Deckle Size"><i class="fa-solid fa-ruler"></i> Set Deckle</button>`;
        },
      },
      { title: "Date", field: "createdAt", headerFilter: "input", headerFilterPlaceholder: "Filter date...", formatter: (cell) => new Date(cell.getValue()).toLocaleDateString("en-IN") },
      { title: "Client", field: "clientName", headerFilter: "input", headerFilterPlaceholder: "Filter client...", formatter: (cell) => `<span style="font-weight:600; color:#044A78;">${cell.getValue() || "N/A"}</span>` },
      { title: "Product Code", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Filter product...", formatter: (cell) => `<span style="font-weight:600; color:#044A78;">${cell.getValue() || "N/A"}</span>` },
      { title: "Paper Size", field: "paperSize", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "Size" },
      { title: "No. of Rolls", field: "noOfRolls", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#" },
      { title: "Needed Width", field: "neededWidth", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "mm",
        formatter: (cell) => (cell.getValue() != null ? `${cell.getValue()}mm` : "—") },
      {
        title: "Suggested Size",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (row.suggestedSize == null) return `<span style="color:#9ca3af;">—</span>`;
          const color = row.short ? "#dc2626" : "#059669";
          return `<span style="font-weight:700; color:${color};">${row.suggestedSize}mm${row.short ? " (short)" : ""}</span>`;
        },
      },
      { title: "Running Mtrs", field: "runningMeters", hozAlign: "right", headerFilter: "input", headerFilterPlaceholder: "Mtrs",
        formatter: (cell) => fmtMtrs(cell.getValue()) },
      { title: "Qty", field: "quantity", hozAlign: "center", headerFilter: "input", headerFilterPlaceholder: "#" },
      {
        title: "Bal",
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `<span style="font-weight:700; color:#044A78;">${row.balance ?? row.quantity}</span>`;
        },
      },
      { title: "PO Number", field: "poNumber", headerFilter: "input", headerFilterPlaceholder: "Filter PO..." },
      { title: "Est. Delivery", field: "estimatedDate", headerFilter: "input", headerFilterPlaceholder: "Filter date...", formatter: (cell) => (cell.getValue() ? new Date(cell.getValue()).toLocaleDateString("en-IN") : "—") },
      { title: "Remarks", field: "remarks", headerFilter: "input", headerFilterPlaceholder: "Filter remarks..." },
    ],
  });

  table.on("renderComplete", function () {
    document.querySelectorAll("#deckle-set-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });
</script>
