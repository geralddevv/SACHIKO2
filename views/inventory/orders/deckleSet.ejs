<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<style>
  .btn-action {
    height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
    font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
  }
  .btn-action:hover { opacity: 0.85; }

  /* SKU-group parent vs. member child rows in the dataTree table. */
  #deckle-set-table .tabulator-row[data-ds-child="true"] { background: #f8fafc; }
  #deckle-set-table .tabulator-row[data-ds-child="true"] .tabulator-cell { color: #475569; }

  /* ---- dataTree expand/collapse toggle (the "+" chip on each SKU row) ---- */
  #deckle-set-table .tabulator-data-tree-control {
    width: 22px !important;
    height: 22px !important;
    margin-right: 8px !important;
    border: none !important;
    border-radius: 6px !important;
    background: rgba(4, 74, 120, 0.09) !important;
    box-shadow: none !important;
    outline: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: background-color 0.15s ease, transform 0.12s ease !important;
  }
  #deckle-set-table .tabulator-data-tree-control:hover {
    background: rgba(4, 74, 120, 0.18) !important;
    transform: translateY(-1px);
  }
  #deckle-set-table .tabulator-data-tree-control:active { transform: translateY(0); }
  #deckle-set-table .tabulator-data-tree-control:focus,
  #deckle-set-table .tabulator-data-tree-control:focus-visible {
    outline: none !important;
    box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.14) !important;
  }
  #deckle-set-table .tabulator-data-tree-control-expand,
  #deckle-set-table .tabulator-data-tree-control-collapse {
    width: auto !important;
    height: auto !important;
    background: none !important;
    border: none !important;
  }
  #deckle-set-table .tabulator-data-tree-control-expand::before,
  #deckle-set-table .tabulator-data-tree-control-collapse::before {
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    content: "\f054"; /* chevron-right -- one glyph, rotated for the open state */
    font-size: 10px;
    line-height: 1;
    color: #044a78;
    display: inline-block;
    transition: transform 0.2s ease;
  }
  #deckle-set-table .tabulator-data-tree-control-collapse::before { transform: rotate(90deg); }
  #deckle-set-table .tabulator-data-tree-control-expand::after,
  #deckle-set-table .tabulator-data-tree-control-collapse::after {
    content: none !important;
    display: none !important;
  }
  #deckle-set-table .tabulator-data-tree-branch,
  #deckle-set-table .tabulator-data-tree-branch-empty {
    display: none !important;
  }
  #deckle-set-table .tabulator-row[data-ds-child="true"] .tabulator-cell:first-child { padding-left: 14px; }
  /* A child row that is an advance order (see .adv-row in common.css) keeps its
     wash over the plain child-row grey above. */
  #deckle-set-table .tabulator-row.adv-row[data-ds-child="true"] .tabulator-cell { color: #1e3a8a; }

  .ds-count-badge {
    display: inline-block; font-size: 11px; font-weight: 800; color: #044a78;
    background: #e0ecf8; border-radius: 999px; padding: 1px 9px;
  }
</style>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <div class="indi-head">
    <h1>Deckle Sorting</h1>
    <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
      <%# Opens Set Deckle in advance mode: pick the Product Code, type the order
          lines and set the deckle there (GET /labels/production/deckle-set/plan). %>
      <a
        href="/app/labels/production/deckle-set/plan"
        style="padding: 6px 14px; background: cornflowerblue; color: white; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;"
        title="Set a deckle for an order that hasn't been placed yet"
        onmouseover="this.style.opacity = '0.85'" onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-calendar-plus"></i><span>Advance Order</span>
      </a>
      <a
        href="/app/labels/production/deckle-queue"
        style="padding: 6px 14px; background: #044a78; color: white; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;"
        onmouseover="this.style.opacity = '0.85'" onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-layer-group"></i><span>Deckle Queue</span>
      </a>
      <a
        href="/app/labels/production/pending?tab=wip"
        style="padding: 6px 14px; background: #044a78; color: white; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;"
        onmouseover="this.style.opacity = '0.85'" onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-gears"></i><span>WIP</span>
      </a>
    </div>
  </div>

  <div id="deckle-set-table" class="tabulator tabulator-modern"></div>
</div>

<!-- Remove a loose advance order (hidden form, submitted from its row). -->
<form id="ds-adv-delete-form" method="post" action="" style="display:none;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
</form>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="deckle-set-data" type="application/json"><%- safeJson(rows || []) %></script>

<script>
  const rowsData = JSON.parse(document.getElementById("deckle-set-data").textContent);

  const fmtMtrs = (v) => (Number.isFinite(Number(v)) ? Number(v).toLocaleString("en-IN", { maximumFractionDigits: 2 }) : "—");
  const fmtInt = (v) => (Number.isFinite(Number(v)) ? Number(v).toLocaleString("en-IN") : "—");
  const fmtDate = (v) => (v ? new Date(v).toLocaleDateString("en-IN") : "—");
  const esc = (v) => String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  // Remove a loose advance order -- a forecast that isn't going to happen.
  window.deleteAdvance = function (id) {
    if (!confirm("Remove this advance order?")) return;
    const form = document.getElementById("ds-adv-delete-form");
    form.action = `/app/labels/production/deckle-set/advance/${encodeURIComponent(id)}/delete`;
    form.submit();
  };

  /* ----- Table (SKU groups as parent rows, member orders as children) ----- */
  const table = new Tabulator("#deckle-set-table", {
    data: rowsData,
    placeholder: "No orders waiting on a deckle",
    index: "_id",
    dataTree: true,
    dataTreeStartExpanded: false,
    dataTreeChildField: "_children",
    dataTreeElementColumn: "item",
    rowFormatter: (row) => {
      const d = row.getData();
      if (!d.isGroup) row.getElement().setAttribute("data-ds-child", "true");
      row.getElement().classList.toggle("adv-row", !d.isGroup && !!d.isAdvance);
    },
    columns: [
      {
        title: "Product Code / Client",
        field: "item",
        headerSort: false,
        widthGrow: 3,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          // Every group here is loose -- a formed batch has moved to the
          // Deckle Queue, so there is no BATCHED state left to tag.
          if (row.isGroup) {
            const adv = row.advanceCount
              ? ` <span class="adv-tag" title="${row.advanceCount} advance order(s) — not placed yet">ADVANCE ${row.advanceCount}</span>`
              : "";
            return `<span style="font-weight:800; color:#044A78;">${esc(row.productCode || "—")}</span>${adv}`;
          }
          if (row.isAdvance) {
            const note = row.remarks ? ` <span style="color:#64748b;">· ${esc(row.remarks)}</span>` : "";
            return `<span style="padding-left:6px;">↳ <span class="adv-tag" title="Added in advance — no sales order yet">ADVANCE</span>${note}</span>`;
          }
          return `<span style="padding-left:6px;">↳ ${esc(row.clientName || "—")}</span>`;
        },
      },
      { title: "PO Number", field: "poNumber", headerSort: false,
        formatter: (cell) => (cell.getRow().getData().isGroup ? "" : (cell.getValue() || "—")) },
      { title: "Orders", hozAlign: "center", headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return row.isGroup ? `<span class="ds-count-badge">${row.orderCount}</span>` : "";
        } },
      { title: "Paper Size", field: "paperSize", hozAlign: "center", headerSort: false,
        formatter: (cell) => (cell.getRow().getData().isGroup ? "" : (cell.getValue() || "—")) },
      { title: "Running Mtrs", hozAlign: "right", headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return fmtMtrs(row.isGroup ? row.sumRunningMeters : row.runningMeters);
        } },
      { title: "Roll Qty", hozAlign: "center", headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return fmtInt(row.isGroup ? row.sumQuantity : row.quantity);
        } },
      { title: "Sq Mtr", hozAlign: "right", headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          const v = row.isGroup ? row.sumSqMtr : row.sqMtr;
          return row.isGroup
            ? `<span style="font-weight:700; color:#044A78;">${fmtMtrs(v)}</span>`
            : fmtMtrs(v);
        } },
      { title: "Est. Delivery", hozAlign: "center", headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return row.isGroup ? "" : fmtDate(row.estimatedDate);
        } },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        width: 130,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isGroup) {
            return row.isAdvance
              ? `<button type="button" class="btn-action" style="background:#b91c1c;" data-id="${esc(row._id)}" onclick="deleteAdvance(this.dataset.id)" title="Remove this advance order"><i class="fa-solid fa-trash"></i> Remove</button>`
              : "";
          }
          return `<a href="/app/labels/production/deckle-set/plan/${encodeURIComponent(row.itemId)}" class="btn-action" style="background:#10b981; text-decoration:none;" title="Set Deckle"><i class="fa-solid fa-ruler"></i> Set Deckle</a>`;
        },
      },
    ],
  });
</script>
