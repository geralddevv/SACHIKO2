<% layout('/layout/boilerplate') %>

<%
  const isEmpty = (v) => v === undefined || v === null || (typeof v === "string" && v.trim() === "");
  const dash = (v) => (isEmpty(v) ? "—" : v);
  const sizes = Array.isArray(group.candidateSizes) ? group.candidateSizes : [];
  const kids = (Array.isArray(group._children) ? [...group._children] : [])
    .sort((a, b) => (Number(a.paperSize) || 0) - (Number(b.paperSize) || 0));
  const fmtN = (v) => (Number.isFinite(Number(v)) ? Number(v).toLocaleString("en-IN", { maximumFractionDigits: 2 }) : "—");
  const fmtD = (v) => (v ? new Date(v).toLocaleDateString("en-IN") : "—");
  // # + A..L + Deckle R.M. + R.Meter + Webs + remove -- the web-view sub-row
  // spans the lot.
  const subColspan = cutSlots.length + 5;
  // Default total edge trim (mm). Planner can edit it via the pencil.
  const trimDefault = 5;
%>

<style>
  .span-full { padding: 0 !important; }
  .span-full.form-heading, .span-full.form-subheading { padding: 10px !important; }
  .sl-panel { align-self: stretch; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .sl-sec-head { display: flex; flex-direction: row; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 10px; }
  .sl-sec-head h1 { margin: 0; }

  .sl-job-grid {
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); grid-template-rows: 1fr;
    overflow-x: auto;
  }
  .sl-job-cell {
    background: #f8fafc; padding: 11px 10px; display: flex; flex-direction: column; gap: 5px; min-width: 0;
    border-right: 1px solid #e2e8f0;
  }
  .sl-job-cell:last-child { border-right: none; }
  .sl-job-cell.is-input { background: #fff; }
  /* Product Code: compact. Available Sizes: wide. */
  .sl-job-grid .sl-job-cell.dsf-pc { grid-column: span 1; }
  .sl-job-grid .sl-job-cell.dsf-avail { grid-column: span 3; }
  .sl-job-label {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #7c8ba1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sl-job-label .req { color: #dc2626; }
  /* Every recipe fact -- value text and the Edge Trim input -- at one big size. */
  .sl-job-value { font-size: 20px; font-weight: 800; color: #1f2a44; line-height: 1.3; letter-spacing: 0.02em; overflow-wrap: anywhere; }
  .sl-job-value.sl-bad { color: #b91c1c; }
  .sl-job-cell.is-input input.form-control {
    height: 40px !important; font-size: 20px !important; font-weight: 800 !important; color: #1f2a44;
  }
  /* Edge Trim: value text with a pencil pinned top-right; the input shows on click. */
  .dsf-trim-cell { position: relative; }
  .dsf-edit-ic {
    position: absolute; top: 7px; right: 7px;
    border: none; background: rgba(4,74,120,0.09); color: #044a78; cursor: pointer;
    width: 24px; height: 24px; border-radius: 6px; font-size: 11px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .dsf-edit-ic:hover { background: rgba(4,74,120,0.18); }
  .dsf-edit-ic.is-on { background: #044a78; color: #fff; }

  /* Available Sizes: one "Available Sizes" heading, then the sizes in a single
     horizontal row -- each separated by a divider, the edit pencil at the end
     of the same row. Header + size font/weight unchanged (label + value styles). */
  .dsf-avail-cell { position: relative; }
  .dsf-size-line {
    display: flex; align-items: center; gap: 14px;
    border-top: 1px solid #e2e8f0; padding-top: 7px; margin-top: 2px;
  }
  .dsf-size-row { flex: 1 1 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .dsf-size-item { display: inline-flex; align-items: center; gap: 6px; }
  .dsf-size-item:not(:first-child) { border-left: 1.5px solid #cbd5e1; padding-left: 14px; }
  .dsf-size-item .x {
    border: none; background: none; color: #b91c1c; cursor: pointer;
    font-size: 15px; line-height: 1; padding: 0 2px; flex: none;
  }
  .dsf-size-item .x:hover { color: #7f1d1d; }
  .dsf-size-none { color: #94a3b8; }
  .dsf-edit-inline { position: static; flex: none; }
  .dsf-chip-add { display: flex; gap: 6px; margin-top: 8px; }
  .dsf-chip-add input {
    width: 100px; height: 30px; text-align: center; font-weight: 700; font-size: 14px;
    border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 2px 6px;
  }
  .dsf-chip-add input:focus { outline: none; border-color: #044a78; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .dsf-mini-btn {
    display: inline-flex; align-items: center; gap: 5px; border: 1.5px solid #044a78; background: #fff;
    color: #044a78; border-radius: 6px; padding: 3px 11px; font-size: 12px; font-weight: 700; cursor: pointer;
  }
  .dsf-mini-btn:hover { background: #f0f7ff; }
  #dsfTrim {
    height: 40px !important; font-size: 20px !important; font-weight: 800 !important; color: #1f2a44;
    width: 100%; padding: 4px 8px; border-radius: 6px; border: 1px solid #044a78; background: #f4f9ff;
  }
  #dsfTrim:focus { outline: none; box-shadow: 0 0 0 3px rgba(4,74,120,0.14); }

  .sl-table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; }
  .sl-table th {
    background: #044a78; color: #fff; font-size: 11.5px; font-weight: 600; padding: 7px 5px;
    text-align: center; letter-spacing: 0.02em; border-right: 1px solid rgba(255,255,255,0.22); white-space: nowrap;
  }
  .sl-table th:last-child { border-right: none; }
  .sl-table td {
    padding: 5px; border-bottom: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;
    vertical-align: middle; text-align: center; background: #fff;
  }
  .sl-table td:last-child { border-right: none; }
  .sl-table input.form-control {
    padding: 4px 6px !important; font-size: 12.5px !important; height: 30px !important;
    min-width: 0; width: 100%; text-align: center; border-radius: 6px !important;
    font-variant-numeric: tabular-nums; border: 1px solid #cbd5e1 !important; background-color: #fff;
    transition: border-color 0.15s, box-shadow 0.15s, background-color 0.15s;
  }
  .sl-table input.form-control:focus {
    outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.12);
  }
  .sl-table input[type="number"]::-webkit-outer-spin-button,
  .sl-table input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .sl-table input[type="number"] { -moz-appearance: textfield; }
  .sl-table tbody tr:hover > td { background: #fbfdff; }
  .sl-table td.dsf-rownum { font-size: 12.5px; font-weight: 800; color: #1f2a44; background: #f8fafc; }

  .sl-scroll { align-self: stretch; overflow-x: auto; }
  .sl-scroll::-webkit-scrollbar { height: 9px; }
  .sl-scroll::-webkit-scrollbar-thumb { background: #044a78; border-radius: 8px; }

  .sl-width-input.is-set { border-color: #044a78 !important; background-color: #f4f9ff !important; font-weight: 700; }

  /* Validation states */
  .sl-table input.form-control.is-bad,
  #dsfTrim.is-bad,
  .dsf-chip-add input.is-bad {
    border-color: #dc2626 !important; background-color: #fef2f2 !important;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12) !important;
  }
  .sl-table input.form-control:disabled {
    background-color: #f1f5f9 !important; border-color: #e2e8f0 !important;
    color: #cbd5e1; cursor: not-allowed;
  }
  #dsfIssuesBody.is-error { background: #fef2f2; border-color: #fca5a5; color: #991b1b; }
  #dsfIssuesBody ul { margin: 4px 0 0; padding-left: 18px; }
  #dsfIssuesBody li { margin: 2px 0; }
  #dsfIssuesBody .dsf-issue-head { font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; font-size: 11px; }
  /* Same look as the Slitting Queue's "Continue" button (sq-btn-primary). */
  .submit-btn {
    border: none; border-radius: 9px; padding: 11px 24px; font-size: 15px; font-weight: 700;
    color: #fff; background: linear-gradient(135deg, #044a78 0%, #03365a 100%);
    cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    transition: opacity 0.18s ease;
  }
  .submit-btn:hover { opacity: 0.92; }
  .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  /* Same separator as the Slitting Queue dialog's footer (sq-dialog-footer),
     just the top edge -- .span-full's own border is dropped so it doesn't
     also draw the other three sides. */
  /* Stacks: the reel list across the full width, then the figures and the
     Create button together on the line under it. */
  .dsf-submit-footer {
    margin-top: 10px !important; border: none !important; border-top: 1px solid #b6c0d1 !important;
    border-radius: 0 !important; background: #fafbfd; padding: 20px 24px 16px !important;
    display: flex !important; flex-direction: column !important; align-items: stretch; gap: 12px;
  }
  /* The figures and Create Deckle Batch share ONE card -- the button sits in the
     same white box as the stats rather than floating beside it, divided off by
     the same hairline that separates the figures from each other. */
  .dsf-footer-row {
    display: flex; flex-direction: row; align-items: stretch; gap: 0; flex-wrap: wrap;
    border: 1px solid #e6eaf2; border-radius: 10px; background: #fff; overflow: hidden;
  }
  .dsf-footer-row .sl-save-wrap {
    flex: none; margin-left: auto; align-self: stretch;
    display: flex; flex-direction: row; align-items: center; gap: 8px;
    padding: 10px 14px; border-left: 1px solid #eef1f6;
  }
  /* Alone in the card (nothing drawn yet) there is nothing to divide it from. */
  #dsfStatChips:empty ~ .sl-save-wrap { border-left: none; }
  /* Same stat-chip grid as the AI Deckle Set result (.dsa-result/.dsa-stat) --
     sits to the left of the submit button instead of boxed in its own panel. */
  /* Line 1 -- the reels to pull, with nothing beside it, so the list runs the
     whole width instead of stopping where the Create button starts. */
  .dsf-final-stats {
    min-width: 0; border: 1px solid #e6eaf2; border-radius: 10px;
    background: #fff; overflow: hidden;
  }
  .dsf-final-stats:empty { display: none; }
  /* "Deckle Webs Used" is a list of reels, not a single figure. Laid across
     rather than stacked, which is what keeps it to one line, and it is alone on
     its line so it grows to fill it. */
  .dsa-stat.dsf-stat-lead {
    flex: 1 1 auto; flex-direction: row; align-items: baseline; gap: 14px;
    padding: 12px 20px; border-right: none; border-bottom: none; min-width: 0;
  }
  .dsa-stat.dsf-stat-lead .v {
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;
  }
  /* Line 2 -- the figures. The card is .dsf-footer-row around them and the
     button, so this carries no border of its own. */
  .dsf-stat-row {
    flex: 1 1 auto; min-width: 0; border: none; background: transparent;
  }
  .dsf-stat-row:empty { display: none; }
  .dsf-chip-msg { font-size: 11.5px; font-weight: 700; color: #b91c1c; margin-top: 6px; }

  /* ---- Web view: A..L drawn to scale across the reel's web ---- */
  .sl-web {
    display: flex; align-items: stretch; height: 32px; width: 100%; max-width: 960px; margin: 0 auto;
    border: 1px solid #cbd5e1; border-radius: 7px; overflow: hidden; background: #fff;
  }
  .sl-web.is-over { border-color: #ef4444; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.15); }
  .sl-web-seg {
    flex-basis: 0; min-width: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 1px;
    border-right: 1px solid #fff; overflow: hidden; white-space: nowrap;
    background: #16a34a; color: #fff;
  }
  .sl-web-seg:nth-child(even) { background: #15803d; }
  .sl-web-seg:last-child { border-right: none; }
  .sl-web-seg .sl-seg-slot { font-size: 9px; font-weight: 700; opacity: 0.8; letter-spacing: 0.06em; }
  .sl-web-seg .sl-seg-w { font-size: 11.5px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .sl-web-seg.sl-web-edge { background: #111827; color: #fff; }
  .sl-web-seg.sl-web-trim { background: #dc2626; color: #fff; }
  .sl-web-empty {
    display: flex; align-items: center; justify-content: center; width: 100%;
    font-size: 11.5px; font-weight: 600; color: #94a3b8;
    background: repeating-linear-gradient(45deg, #f1f5f9, #f1f5f9 6px, #f8fafc 6px, #f8fafc 12px);
  }
  .dsf-sub-cell { background: #f8fafc !important; padding: 10px !important; text-align: left !important; }
  .sl-table tbody tr:hover > td.dsf-sub-cell { background: #f8fafc !important; }

  /* Per-layout table: deckle size | siderun | diagram + caption | pick.
     The table fills the available width; the diagram column keeps its own
     capped width (below) so widening the table never stretches the strip. */
  .dsf-web-table { width: 100%; border-collapse: separate; border-spacing: 0;
    background: #fff; border: 1.5px solid #e6eaf2; border-radius: 10px; overflow: hidden; }
  .dsf-web-table th {
    background: #044a78; color: #fff; font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; padding: 6px 10px; text-align: left; white-space: nowrap;
  }
  .dsf-web-table td { padding: 8px 10px; border-top: 1px solid #eef1f6; vertical-align: middle; }
  .dsf-web-tr { cursor: pointer; }
  .dsf-web-tr:hover td { background: #f7fbff; }
  .dsf-web-tr.is-chosen td { background: #eef5ff; }
  /* Deckle Size, Siderun, Across and Deckle Count all share one big value font. */
  .dsf-web-size, .dsf-web-rem, .dsf-web-dc, .dsf-web-across .flag {
    font-size: 22px; font-weight: 800; font-variant-numeric: tabular-nums;
  }
  .dsf-web-dc { width: 96px; text-align: center; color: #1f2a44; }
  .dsf-web-size {
    width: 120px; color: #1f2a44; white-space: nowrap; text-align: center;
  }
  .dsf-web-tr.is-chosen .dsf-web-size { color: #044a78; }
  .dsf-web-rem {
    width: 104px; text-align: center; color: #dc2626; white-space: nowrap;
  }
  .dsf-web-rem.sl-bad { color: #b91c1c; }
  /* "Across" column -- the "N rolls" line. */
  .dsf-web-across { width: 130px; }
  .dsf-web-across .flag { color: #475569; }
  .dsf-web-across .flag.sl-bad { color: #b91c1c; }
  .dsf-web-across .flag.sl-ok { color: #15803d; }
  .dsf-web-across .dsf-tag {
    display: inline-block; margin-top: 3px; font-size: 9.5px; font-weight: 800;
    color: #fff; background: #059669; border-radius: 999px; padding: 2px 8px; letter-spacing: 0.3px;
  }
  /* Diagram column soaks up the extra table width; its contents stay centered
     and the strip keeps its own capped width. */
  .dsf-web-diag { min-width: 0; text-align: center; }
  .dsf-web-diag .sl-web { margin: 0 auto; max-width: 880px; width: 100%; height: 36px; }
  /* Diagram segments show the width number only -- no A/B/C / EDGE / TRIM label. */
  .dsf-web-diag .sl-seg-slot { display: none; }
  .dsf-web-diag .sl-web-seg .sl-seg-w { font-size: 13px; }
  .dsf-web-pick { width: 48px; text-align: center; }
  .dsf-web-pick .dsf-radio {
    display: inline-flex; width: 20px; height: 20px; border-radius: 50%; border: 2px solid #cbd5e1;
    align-items: center; justify-content: center; background: #fff;
  }
  .dsf-web-tr.is-chosen .dsf-web-pick .dsf-radio { border-color: #044a78; }
  .dsf-web-tr.is-chosen .dsf-web-pick .dsf-radio::after {
    content: ""; width: 10px; height: 10px; border-radius: 50%; background: #044a78;
  }

  .sl-warn-note {
    align-self: stretch; background: #fff8e1; border: 1px solid #f0c36d; color: #7a5b00;
    border-radius: 8px; padding: 10px 14px; font-size: 12.5px; font-weight: 600; line-height: 1.5;
  }
  .sl-save-wrap { display: flex; flex-direction: column; align-items: center; gap: 7px; flex: none; margin-left: auto; }

  /* ---- Deckle-Set-form-only ---- */
  .dsf-add-btn {
    display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid #044a78; background: #fff;
    color: #044a78; border-radius: 7px; padding: 7px 14px; font-size: 12.5px; font-weight: 700; cursor: pointer;
  }
  .dsf-add-btn:hover { background: #f0f7ff; }
  .dsf-add-btn:disabled { opacity: 0.45; cursor: not-allowed; background: #fff; }
  .dsf-row-btn {
    width: 26px; height: 26px; padding: 0; border: 1px solid #e2e8f0; background: #fff;
    color: #b91c1c; border-radius: 5px; font-size: 11.5px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .dsf-row-btn:hover { background: #fef2f2; border-color: #fecaca; }
  .dsf-row-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  /* "Show all sizes" toggle under a layout's size table -- only rendered while
     the table is collapsed to the chosen size (after an AI Deckle Set run).
     A white pill rather than an underlined link: it sits on the sub-row's grey,
     where a bare text link reads as body copy instead of a control. The chevron
     rides in its own badge; hovering moves the border colour and nothing else. */
  .dsf-sizes-toggle {
    margin-top: 10px; cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 15px 6px 7px; border-radius: 999px;
    border: 1px solid #dbe6f2; background: #fff; color: #044a78;
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.01em;
    box-shadow: 0 1px 2px rgba(16, 37, 60, 0.05);
    transition: border-color 0.16s ease;
  }
  .dsf-sizes-toggle i {
    flex: none; width: 20px; height: 20px; border-radius: 50%; font-size: 9px;
    display: inline-flex; align-items: center; justify-content: center;
    background: #eef5ff; color: #044a78;
  }
  /* Hover moves the border and nothing else. */
  .dsf-sizes-toggle:hover { border-color: #044a78; }
  .dsf-sizes-toggle:focus-visible { outline: 2px solid #044a78; outline-offset: 2px; }
  .dsf-layout-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 10px 14px; }
  /* Holds the first blocking error and nothing else -- empty when the layout is
     sound, which leaves the toolbar to the Done button. */
  .dsf-layout-status { font-size: 12.5px; font-weight: 700; color: #b45309; }
  .dsf-order-check { width: 16px; height: 16px; accent-color: #044a78; cursor: pointer; }

  /* ---- "Deckle Set" recap -- the only view of the plan on the page ---- */
  /* align-self: .span-full is a column flex with align-items:flex-start, so a
     child that doesn't ask for the full width gets only as much as its content
     needs (which left the empty-state box as narrow as its own sentence). */
  .dsf-set-wrap { align-self: stretch; padding: 4px 14px 14px; }
  .dsf-set-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  /* Add Deckle Layout sits at the far end of the recap's header row -- with the
     layout table now in a dialog, this is the only way to start a new one.
     The whole row hides until something is drawn: with nothing in the recap
     the sub-line is empty too, and the empty state carries its own button. */
  .dsf-set-head[hidden] { display: none; }
  .dsf-set-head #dsfAddLayout { margin-left: auto; }
  .dsf-set-sub { font-size: 12px; font-weight: 700; color: #7c8ba1; }

  /* One scrollbar for every surface this page scrolls -- the Deckle Set recap,
     and inside the layout dialog both the body (vertical) and the layout table
     (sideways). Same tokens as every Tabulator table in the app
     (tableDisp.css's .tabulator-tableholder), restated because this page
     renders with CSS: false and inherits none of it.
     .sl-scroll's own rule is webkit-only, so without the longhands at the end
     Firefox draws the OS default on these. */
  #dsfSetBody::-webkit-scrollbar,
  .dsf-layout-modal .dialog-body::-webkit-scrollbar,
  .dsf-layout-modal .sl-scroll::-webkit-scrollbar { width: 10px; height: 10px; }
  #dsfSetBody::-webkit-scrollbar-track,
  .dsf-layout-modal .dialog-body::-webkit-scrollbar-track,
  .dsf-layout-modal .sl-scroll::-webkit-scrollbar-track { background: #f0f2f5; border-radius: 6px; }
  #dsfSetBody::-webkit-scrollbar-thumb,
  .dsf-layout-modal .dialog-body::-webkit-scrollbar-thumb,
  .dsf-layout-modal .sl-scroll::-webkit-scrollbar-thumb { background: #044a78; border-radius: 6px; }
  #dsfSetBody::-webkit-scrollbar-thumb:hover,
  .dsf-layout-modal .dialog-body::-webkit-scrollbar-thumb:hover,
  .dsf-layout-modal .sl-scroll::-webkit-scrollbar-thumb:hover { background: #06639f; }
  #dsfSetBody,
  .dsf-layout-modal .dialog-body,
  .dsf-layout-modal .sl-scroll { scrollbar-width: thin; scrollbar-color: #044a78 #f0f2f5; }

  .dsf-set-table {
    width: 100%; min-width: 1520px; border-collapse: separate; border-spacing: 0; background: #fff;
    border: 1.5px solid #e6eaf2; border-radius: 10px; overflow: hidden;
  }
  .dsf-set-table th {
    background: #eef3f9; color: #44566e; font-size: 10.5px; font-weight: 800; letter-spacing: 0.05em;
    text-transform: uppercase; padding: 7px 10px; text-align: center; white-space: nowrap;
  }
  .dsf-set-table td {
    padding: 8px 10px; border-top: 1px solid #eef1f6; text-align: center; vertical-align: middle;
    font-size: 13px; font-weight: 700; color: #1f2a44; font-variant-numeric: tabular-nums;
  }
  .dsf-set-table tbody tr:hover td { background: #f7fbff; }
  /* The whole row opens its layout, not just the pencil -- so only the rows
     that carry a layout take the pointer (never the no-match row). */
  .dsf-set-table tbody tr[data-edit-lid] { cursor: pointer; }
  .dsf-set-table .dsf-set-no { width: 40px; color: #7c8ba1; }

  /* Sortable headers + a search box under each one, the same interaction as the
     Tabulator tables elsewhere in the app -- restated here because this page
     renders with CSS: false and inherits none of tableDisp.css. */
  .dsf-set-table th.dsf-set-th { cursor: pointer; user-select: none; }
  .dsf-set-table th.dsf-set-th:hover { background: #e2ebf5; }
  .dsf-set-table th.dsf-set-th:focus-visible { outline: 2px solid #044a78; outline-offset: -2px; }
  .dsf-set-table th.dsf-set-th.is-sorted { background: #dbe7f4; color: #044a78; }
  .dsf-th-in { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .dsf-th-arrow { font-size: 9px; opacity: 0.3; }
  .dsf-set-table th.dsf-set-th.is-sorted .dsf-th-arrow { opacity: 1; }
  .dsf-set-table .dsf-set-filters th {
    background: #f6f9fc; padding: 5px 6px; border-top: 1px solid #dfe8f1; text-transform: none;
  }
  .dsf-set-filter {
    width: 100%; min-width: 0; height: 26px; padding: 2px 8px; text-align: left;
    border: 1px solid #d5dfea; border-radius: 5px; background: #fff;
    font-size: 11.5px; font-weight: 600; color: #1f2a44; font-variant-numeric: tabular-nums;
  }
  .dsf-set-filter::placeholder { color: #b6c2d0; font-weight: 600; }
  .dsf-set-filter:focus { outline: none; border-color: #044a78; box-shadow: 0 0 0 2px rgba(4, 74, 120, 0.14); }
  .dsf-set-filter.is-on { border-color: #044a78; background: #f4f9ff; }
  /* Filters hide rows but never change the footer -- what the batch makes does
     not depend on a search box -- so the count that is being held back is
     spelled out rather than left to be inferred from a shorter table. */
  .dsf-set-hid { font-weight: 700; color: #b45309; text-transform: none; letter-spacing: 0; }
  .dsf-set-clear {
    border: none; background: none; padding: 0 2px; cursor: pointer;
    font: inherit; font-weight: 800; color: #044a78; text-decoration: underline;
  }
  .dsf-set-clear:hover { color: #06639f; }
  .dsf-set-table .dsf-set-nomatch td {
    padding: 18px 10px; color: #7c8ba1; font-weight: 700; background: #fcfdfe;
  }
  .dsf-set-table .dsf-set-size { width: 112px; color: #044a78; font-weight: 800; font-size: 17px; }
  .dsf-set-table .dsf-set-cuts {
    text-align: left; font-weight: 600; color: #44566e; width: 185px; min-width: 185px; line-height: 1.5;
  }
  /* The web strip is the point of this table -- give it the bulk of the width
     and let the strip itself fill the cell rather than sitting capped in the
     middle of it. */
  .dsf-set-table .dsf-web-diag { width: 60%; min-width: 560px; padding-left: 14px; padding-right: 14px; }
  .dsf-set-table .dsf-web-diag .sl-web { max-width: none; height: 40px; }
  /* Each segment carries its roll width -- big enough to read off the screen. */
  .dsf-set-table .dsf-web-diag .sl-web-seg .sl-seg-w { font-size: 15px; }
  .dsf-set-table .dsf-set-cuts b { color: #1f2a44; font-weight: 800; }
  .dsf-set-table .dsf-set-trim { width: 130px; min-width: 130px; color: #b45309; }
  .dsf-set-table .dsf-set-rem { width: 96px; color: #15803d; }
  /* A constant part of the sum -- kept neutral so Total stays the
     figure the eye lands on. */
  .dsf-set-table .dsf-set-edge { width: 92px; color: #44566e; }
  /* Grace is width the rolls keep, not width thrown away -- teal, so it does
     not read as another scrap column beside the Siderun and Trim it sits
     with. */
  .dsf-set-table .dsf-set-grace { width: 92px; color: #0f766e; }
  .dsf-set-table .dsf-set-rem.sl-bad { color: #b91c1c; }
  .dsf-set-table .dsf-set-rolls { color: #15803d; font-weight: 800; }
  .dsf-set-table tfoot td {
    background: #f4f8fc; border-top: 1.5px solid #d8e3ef; font-weight: 800; color: #044a78;
  }
  /* Message and button on one line, centred together. Wraps rather than
     squeezes on a narrow viewport. */
  .dsf-set-empty {
    display: flex; flex-direction: row; flex-wrap: wrap;
    align-items: center; justify-content: center; gap: 16px;
    font-size: 13px; font-weight: 700; color: #7c8ba1; background: #fff;
    border: 1.5px dashed #dbe3ec; border-radius: 10px; padding: 18px 14px; text-align: center;
  }
  /* The only way into the first layout, so it reads as the page's next step
     rather than as a link in a sentence. */
  .dsf-set-empty-btn {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    border: 1.5px solid #044a78; background: #044a78; color: #fff;
    border-radius: 9px; padding: 11px 26px; font-size: 14.5px; font-weight: 800;
  }
  .dsf-set-empty-btn:hover { background: #06639f; border-color: #06639f; }
  /* Pencil at the end of every recap line -- opens that layout in the dialog. */
  .dsf-set-table .dsf-set-edit-cell { width: 54px; }
  .dsf-set-edit {
    width: 28px; height: 28px; padding: 0; border: 1px solid #cfe0f0; background: #f4f9ff;
    color: #044a78; border-radius: 6px; font-size: 11.5px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .dsf-set-edit:hover { background: #044a78; color: #fff; border-color: #044a78; }
  /* A layout with no roll widths yet. It has to be listed: it keeps Create
     Deckle Batch (and Add Deckle Layout) locked, and the recap is now the only
     route back into the layout it belongs to. */
  .dsf-set-table .dsf-set-pending td {
    background: #fcfdfe; color: #7c8ba1; font-weight: 700; font-style: italic;
  }
  .dsf-set-table tbody tr.dsf-set-pending:hover td { background: #f7fbff; }

  /* ---- Deckle Layout dialog ---- */
  .dialog-header {
    background: #044a78; padding: 14px 20px; border-radius: 14px 14px 0 0;
    display: flex; align-items: center; justify-content: space-between;
  }
  .dialog-header h2 { margin: 0; font-size: 1.02rem; font-weight: 700; color: #fff; }
  .dialog-close-btn {
    background: none; border: none; color: #fff; font-size: 26px; cursor: pointer; line-height: 1;
    width: 36px; height: 36px; border-radius: 8px; opacity: 0.85;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .dialog-close-btn:hover { opacity: 1; background: rgba(255, 255, 255, 0.18); }
  .dialog-body {
    padding: 16px; background: #fff; border-radius: 0 0 14px 14px;
    max-height: calc(100vh - 170px); overflow-y: auto;
  }
  /* The layout table is scoped to the one layout being edited. Every other row
     stays in the DOM -- the totals, the validation and the submit payload are
     all computed off them -- it is only hidden while the dialog is open. */
  #dsfLayoutTable.is-solo > tbody > tr:not(.is-editing) { display: none; }
  .dsf-done-btn { border-color: #044a78; background: #044a78; color: #fff; }
  .dsf-done-btn:hover { background: #06639f; border-color: #06639f; color: #fff; }
  .dsf-toolbar-btns { display: flex; align-items: center; gap: 10px; margin-left: auto; }
  /* Open reads as pressed -- a light fill, not the solid blue Done wears, so
     the two never look like rival primary actions. */
  #dsfGraceBtn.is-on { background: #eef5ff; border-color: #044a78; color: #044a78; }
  /* How much grace this layout is carrying, right on the button, so it is
     legible without opening the panel at all. */
  .dsf-btn-badge {
    margin-left: 2px; font-size: 10px; font-weight: 800; letter-spacing: 0.03em;
    color: #fff; background: #0f766e; border-radius: 999px; padding: 2px 7px; white-space: nowrap;
  }
  .dsf-grace-x {
    border: none; background: none; color: #7c8ba1; cursor: pointer; font-size: 22px; line-height: 1;
    width: 28px; height: 28px; border-radius: 7px; margin-left: -4px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .dsf-grace-x:hover { background: rgba(4, 74, 120, 0.1); color: #044a78; }

  /* ---- Grace panel ---- */
  .dsf-grace {
    margin-top: 12px; border: 1.5px solid #cfe0f0; border-radius: 10px;
    background: #f8fbff; overflow: hidden;
  }
  .dsf-grace[hidden] { display: none; }
  .dsf-grace-head {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    padding: 10px 14px; background: linear-gradient(180deg, #f2f8fd, #e9f2fa);
    border-bottom: 1px solid #dfeaf5;
  }
  .dsf-grace-head h3 {
    margin: 0; font-size: 12px; font-weight: 800; color: #1f2a44;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .dsf-grace-note { font-size: 11.5px; font-weight: 600; color: #5b6b80; }
  .dsf-grace-acts { display: flex; gap: 8px; margin-left: auto; }
  .dsf-grace-body { padding: 12px 14px; }
  .dsf-grace-table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff;
    border: 1px solid #e6eaf2; border-radius: 8px; overflow: hidden; }
  .dsf-grace-table th {
    background: #eef3f9; color: #44566e; font-size: 10px; font-weight: 800; letter-spacing: 0.05em;
    text-transform: uppercase; padding: 6px 10px; text-align: center; white-space: nowrap;
  }
  .dsf-grace-table td {
    padding: 6px 10px; border-top: 1px solid #eef1f6; text-align: center;
    font-size: 13px; font-weight: 700; color: #1f2a44; font-variant-numeric: tabular-nums;
  }
  .dsf-grace-table .dsf-g-slot { width: 44px; color: #7c8ba1; }
  .dsf-grace-table .dsf-g-cut { color: #044a78; font-weight: 800; }
  .dsf-grace-input {
    width: 92px; height: 28px; padding: 2px 8px; text-align: center;
    border: 1px solid #cbd5e1; border-radius: 6px; background: #fff;
    font-size: 12.5px; font-weight: 700; color: #1f2a44; font-variant-numeric: tabular-nums;
  }
  .dsf-grace-input:focus { outline: none; border-color: #044a78; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .dsf-grace-input.is-bad { border-color: #dc2626 !important; background: #fef2f2; }
  .dsf-grace-sums { display: flex; flex-wrap: wrap; gap: 0; margin-top: 10px;
    border: 1px solid #e6eaf2; border-radius: 8px; background: #fff; overflow: hidden; }
  .dsf-grace-sum { flex: 1 1 auto; min-width: max-content; padding: 8px 14px; border-right: 1px solid #eef1f6;
    display: flex; flex-direction: column; gap: 3px; }
  .dsf-grace-sum:last-child { border-right: none; }
  .dsf-grace-sum .k { font-size: 9.5px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #7c8ba1; white-space: nowrap; }
  .dsf-grace-sum .v { font-size: 16px; font-weight: 800; color: #1f2a44;
    font-variant-numeric: tabular-nums; white-space: nowrap; }
  .dsf-grace-sum .v.good { color: #15803d; }
  .dsf-grace-sum .v.warn { color: #b45309; }
  .dsf-grace-sum .v.bad { color: #b91c1c; }
  .dsf-grace-msg { margin-top: 9px; font-size: 11.5px; font-weight: 700; color: #b91c1c; }
  .dsf-grace-msg:empty { display: none; }
  /* A graced layout is flagged in the recap, where the widths shown are the
     ordered ones but the diagram beside them is what is actually cut. */
  .dsf-grace-tag {
    display: inline-block; margin-left: 6px; font-size: 9px; font-weight: 800; letter-spacing: 0.04em;
    color: #fff; background: #0f766e; border-radius: 999px; padding: 2px 7px; white-space: nowrap;
  }

  /* ---- AI Deckle Set (utils/deckleOptimizer) ---- */
  .dsa-panel { align-self: stretch; background: #fff; border: 1.5px solid #cfe0f0; border-radius: 10px; overflow: hidden; }
  .dsa-bar {
    display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap;
    padding: 11px 14px; background: linear-gradient(180deg, #f6fbff, #eef5fc);
    border-bottom: 1px solid #dfeaf5;
  }
  .dsa-field { display: flex; flex-direction: column; gap: 4px; }
  .dsa-field label {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #7c8ba1; white-space: nowrap;
  }
  .dsa-field input {
    width: 104px; height: 34px; padding: 4px 8px; text-align: center;
    font-size: 15px; font-weight: 800; color: #1f2a44;
    border: 1.5px solid #cbd5e1; border-radius: 7px; background: #fff;
    font-variant-numeric: tabular-nums;
  }
  .dsa-field input:focus { outline: none; border-color: #044a78; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .dsa-field input.is-bad { border-color: #dc2626 !important; background: #fef2f2; }
  .dsa-field.dsa-narrow input { width: 74px; }
  .dsa-spacer { flex: 1 1 auto; }
  .dsa-run {
    display: inline-flex; align-items: center; gap: 8px; border: none;
    background: #044a78; color: #fff; border-radius: 8px;
    padding: 9px 18px; font-size: 13px; font-weight: 800; cursor: pointer;
    letter-spacing: 0.02em; white-space: nowrap;
  }
  .dsa-run:hover { background: #06639f; }
  .dsa-run:disabled { opacity: 0.5; cursor: not-allowed; }
  .dsa-body { padding: 0; }
  .dsa-body:empty { display: none; }
  .dsa-result { display: flex; flex-wrap: wrap; gap: 0; border-bottom: 1px solid #eef1f6; }
  /* A chip is never narrower than its own contents (min-width: max-content) and
     its figure never wraps. Those two go together: on a fixed 130px basis a
     long figure like "0.71 % | 116 mm" broke onto a second line while "10" did
     not, so the chips ended up different heights and the row stopped reading
     across. Spare width is shared out between them instead. */
  .dsa-stat {
    flex: 1 1 auto; min-width: max-content; padding: 14px 20px;
    border-right: 1px solid #eef1f6; display: flex; flex-direction: column; gap: 6px;
  }
  .dsa-stat.dsa-stat-wide { flex-grow: 1.4; }
  .dsa-stat.dsa-stat-narrow { flex-grow: 0.6; padding: 14px 18px; }
  .dsa-stat:last-child { border-right: none; }
  .dsa-stat .k {
    font-size: 10px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #7c8ba1; white-space: nowrap;
  }
  .dsa-stat .v {
    font-size: 19px; font-weight: 800; color: #1f2a44;
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .dsa-stat .v.good { color: #15803d; }
  .dsa-stat .v.warn { color: #b45309; }
  .dsa-notes { padding: 9px 14px; font-size: 12px; line-height: 1.55; color: #5b6b80; }
  .dsa-notes ul { margin: 0; padding-left: 17px; }
  .dsa-notes li { margin: 2px 0; }
  .dsa-err {
    padding: 10px 14px; background: #fef2f2; color: #991b1b;
    font-size: 12.5px; font-weight: 700; line-height: 1.5;
  }
  .dsa-check {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    margin: 0; padding: 5px 10px 5px 8px; border: 1.5px solid #cbd5e1;
    border-radius: 8px; background: #fff; height: 34px;
  }
  .dsa-check:hover { border-color: #044a78; }
  .dsa-check input { width: 16px; height: 16px; accent-color: #044a78; cursor: pointer; flex: none; margin: 0; }
  .dsa-check span.t { display: block; font-size: 12px; font-weight: 700; color: #1f2a44; white-space: nowrap; }
  .dsa-check:has(input:checked) { border-color: #044a78; background: #f4f9ff; }
  /* Mixed webs on: each layout's size table is its own pick, so say which
     width the row is currently cut from right in the layout table. */
  .dsf-row-web {
    font-size: 10px; font-weight: 800; letter-spacing: 0.04em; color: #044a78;
    background: #eef5ff; border-radius: 999px; padding: 2px 7px; white-space: nowrap;
  }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px">
  <form id="dsfForm" method="post" action="/app/labels/production/deckle-set" autocomplete="off" novalidate
        style="display:flex; flex-direction:column; gap:10px;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="itemId" value="<%= group.itemId %>" />
    <input type="hidden" name="deckleSize" id="dsfDeckleSize" />
    <input type="hidden" name="noOfRolls" id="dsfNoOfRolls" />
    <input type="hidden" name="layoutsJson" id="dsfLayoutsJson" />

    <div class="span-full form-heading" style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
      <h1>Set Deckle</h1>
    </div>

    <!-- Recipe facts -->
    <div class="span-full" style="border:none !important;">
      <div class="sl-panel">
        <div class="sl-job-grid">
          <div class="sl-job-cell dsf-pc">
            <span class="sl-job-label">Product Code</span>
            <span class="sl-job-value"><%= dash(group.productCode) %></span>
          </div>
          <div class="sl-job-cell">
            <span class="sl-job-label">Roll Type</span>
            <span class="sl-job-value"><%= dash(group.rollType) %></span>
          </div>
          <div class="sl-job-cell dsf-trim-cell">
            <button type="button" id="dsfTrimEdit" class="dsf-edit-ic" title="Edit edge trim" aria-label="Edit edge trim">
              <i class="fa-solid fa-pen"></i>
            </button>
            <span class="sl-job-label">Edge Trim (total mm)</span>
            <span class="sl-job-value" id="dsfTrimText"><%= trimDefault %> mm</span>
            <input type="number" step="any" min="0" id="dsfTrim" name="deckleTrim"
                   value="<%= trimDefault %>"
                   class="form-control" title="Total edge trim across both edges, netted out of every web width." hidden />
          </div>
          <div class="sl-job-cell dsf-avail dsf-avail-cell">
            <span class="sl-job-label">Available Sizes</span>
            <div class="dsf-size-line">
              <div id="dsfSizeChips" class="dsf-size-row"></div>
              <button type="button" id="dsfSizeEdit" class="dsf-edit-ic dsf-edit-inline" title="Edit deckle sizes" aria-label="Edit deckle sizes">
                <i class="fa-solid fa-pen"></i>
              </button>
            </div>
            <div id="dsfSizeAdd" hidden>
              <div class="dsf-chip-add">
                <input type="number" step="any" min="0" id="dsfSizeInput" placeholder="mm" inputmode="decimal" />
                <button type="button" id="dsfSizeAddBtn" class="dsf-mini-btn"><i class="fa-solid fa-plus"></i> Add</button>
              </div>
              <div id="dsfSizeMsg" class="dsf-chip-msg" hidden></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Orders in this deckle -->
    <div class="span-full form-subheading sl-sec-head"><h1>Orders In This Deckle</h1></div>
    <div class="span-full" style="border:none !important;">
      <div class="sl-panel sl-scroll" style="display:inline-block; width:auto; max-width:100%;">
        <table class="sl-table" style="width:auto; min-width:0;">
          <thead>
            <tr>
              <th style="width:44px;"></th>
              <th style="width:126px;">Paper Size</th>
              <th style="width:138px;">Running Mtrs</th>
              <th style="width:104px;">Roll Qty</th>
              <th style="width:112px;">Rolls Set</th>
              <th style="width:108px;">Balance</th>
            </tr>
          </thead>
          <tbody id="dsfOrderBody">
            <% kids.forEach((m) => { %>
              <tr data-order-id="<%= m._id %>"
                  data-size="<%= Number(m.paperSize) || 0 %>" data-qty="<%= Number(m.quantity) || 0 %>">
                <td><input type="checkbox" class="dsf-order-check" name="orderIds" value="<%= m._id %>" checked /></td>
                <td><%= dash(m.paperSize) %></td>
                <td><%= fmtN(m.runningMeters) %></td>
                <td><%= fmtN(m.quantity) %></td>
                <td class="dsf-o-set" style="font-weight:800;">0</td>
                <td class="dsf-o-bal" style="font-weight:800;">—</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- AI Deckle Set -- utils/deckleOptimizer works out the least-waste layouts
         and drops them into the Deckle Set recap below for review. Read-only: it never
         creates the batch, the planner still presses Create Deckle Batch.
         Hidden entirely when DECKLE_AUTO_ENABLED=false. -->
    <% if (autoDeckle && autoDeckle.enabled) { %>
      <div class="span-full form-subheading sl-sec-head"><h1>AI Deckle Set</h1></div>
      <div class="span-full" style="border:none !important;">
        <div class="dsa-panel">
          <div class="dsa-bar">
            <div class="dsa-field">
              <label for="dsaDrm">Deckle R.M.</label>
              <input type="number" step="any" min="1" id="dsaDrm" inputmode="decimal"
                     value="<%= autoDeckle.defaultRunningMeters %>"
                     title="Length of one deckle web, in metres. Every layout is planned against this." />
            </div>
            <div class="dsa-field dsa-narrow">
              <label for="dsaOvPct">Max Overrun %</label>
              <input type="number" step="any" min="0" id="dsaOvPct" inputmode="decimal"
                     value="<%= Math.round(autoDeckle.overrun.pct * 100) %>"
                     title="Spare rolls allowed, as a % of what was ordered. 10% on a 30-roll order allows 3 spares. Extra rolls come off web width that would otherwise be trimmed away and scrapped. Set 0 for no spares at all." />
            </div>
            <div class="dsa-field dsa-narrow">
              <label for="dsaOvRolls">Max Extra Rolls</label>
              <input type="number" step="1" min="0" id="dsaOvRolls" inputmode="numeric"
                     value="<%= autoDeckle.overrun.maxExtraRolls %>"
                     title="Hard ceiling on spare rolls of any one width, whatever the percentage works out to. Stops a large order authorising a pile of spares. Whichever of the two limits is tighter applies. Set 0 for no spares at all." />
            </div>
            <!-- Hidden again at user request (2026-09-12). Stays checked by
                 default, so mixed webs remain on with no UI way to opt out --
                 the same tradeoff that caused the earlier incident (a batch
                 planned on 660 + 635 mm with nothing having offered that
                 choice). See the git history on this block if it needs to
                 come back. -->
            <label class="dsa-check" for="dsaMixed" style="display:none;"
                   title="Let each layout be cut from whichever deckle width suits it, instead of one width for the whole batch. Usually less trim, but more than one facestock size to pull for the job.">
              <input type="checkbox" id="dsaMixed" checked />
              <span class="t">Different web per layout</span>
            </label>
            <div class="dsa-spacer"></div>
            <button type="button" id="dsaRun" class="dsa-run">
              <i class="fa-solid fa-wand-magic-sparkles"></i> AI Deckle Set
            </button>
          </div>
          <div class="dsa-body" id="dsaBody"></div>
        </div>
      </div>
    <% } %>

    <!-- Deckle Set: the deckle as it currently stands, one line per layout,
         with the totals the batch will be created with. This is the only view
         of the plan on the page -- the knives themselves are drawn in the
         dialog behind each row's pencil (#dsfLayoutModal, below the form), so
         the page shows the result rather than the working. Redrawn by
         recalcAll(); nothing here is an input. -->
    <div class="span-full form-subheading sl-sec-head"><h1>Deckle Set</h1></div>
    <div class="span-full" style="border:none !important;">
      <div class="dsf-set-wrap">
        <div class="dsf-set-head" id="dsfSetHead">
          <span id="dsfSetSub" class="dsf-set-sub"></span>
          <button type="button" id="dsfAddLayout" class="dsf-add-btn"><i class="fa-solid fa-plus"></i> Add Deckle Layout</button>
        </div>
        <div class="sl-scroll" id="dsfSetBody"></div>
      </div>
    </div>

    <!-- Blocking issues, refreshed on every edit -->
    <div class="span-full" id="dsfIssues" hidden style="border:none !important;">
      <div class="sl-warn-note" id="dsfIssuesBody"></div>
    </div>

    <div class="span-full dsf-submit-footer">
      <!-- Live totals off the layout rows -- same figures + look as the
           AI Deckle Set result grid, but always on, mirroring whatever is
           currently drawn (hand-built or AI-planned).

           Two lines: the reels to pull is a list, so it gets the full width
           with nothing beside it; the figures then share the line below with
           Create Deckle Batch. -->
      <div class="dsa-result dsf-final-stats" id="dsfFinalStats"></div>
      <div class="dsf-footer-row">
        <div class="dsa-result dsf-stat-row" id="dsfStatChips"></div>
        <div class="sl-save-wrap">
          <button type="submit" id="dsfSubmit" class="submit-btn">Create Deckle Batch</button>
        </div>
      </div>
    </div>
  </form>
</div>

<!-- ============ DECKLE LAYOUT DIALOG ============ -->
<!-- The layout table lives here rather than on the page, but it is still the
     form's source of truth: readRow(), recalcAll() and the submit handler all
     read these rows, open or closed. The dialog only scopes the table to the
     one layout being edited -- the others keep their DOM (and so their values)
     and are hidden by #dsfLayoutTable.is-solo, never detached.

     Deliberately outside <form id="dsfForm">: none of these inputs carry a
     name (the plan posts as layoutsJson), and out here an Enter keystroke in
     the dialog cannot submit the batch. -->
<div class="logout-modal dsf-layout-modal" id="dsfLayoutModal" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="dsfLayoutModalTitle"
       style="width: min(1080px, 96vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="dsfLayoutModalTitle">Deckle Layout</h2>
      <button class="dialog-close-btn" type="button" id="dsfLayoutModalClose" aria-label="Close">&times;</button>
    </div>
    <div class="dialog-body">
      <div class="sl-panel sl-scroll">
        <table class="sl-table" id="dsfLayoutTable" style="min-width: 980px;">
          <thead>
            <tr>
              <th style="width:38px;">#</th>
              <% cutSlots.forEach((s) => { %><th style="width:46px;"><%= s %></th><% }) %>
              <th style="width:104px;">Deckle R.M.</th>
              <th style="width:88px;">R. Meter</th>
              <th style="width:96px;">Deckle Count</th>
              <th style="width:38px;"></th>
            </tr>
          </thead>
          <tbody id="dsfLayoutBody"></tbody>
        </table>
      </div>
      <!-- Grace: hand the web's leftover side trim to the rolls instead of
           scrapping it. Cuts wider, bills at the ordered width. -->
      <div id="dsfGracePanel" class="dsf-grace" hidden></div>
      <div class="dsf-layout-toolbar">
        <span id="dsfLayoutStatus" class="dsf-layout-status"></span>
        <div class="dsf-toolbar-btns">
          <button type="button" class="dsf-add-btn" id="dsfGraceBtn"
                  aria-expanded="false" aria-controls="dsfGracePanel"></button>
          <button type="button" class="dsf-add-btn dsf-done-btn" id="dsfLayoutModalDone">Done</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script id="dsf-group" type="application/json"><%- safeJson(group) %></script>
<script id="dsf-slots" type="application/json"><%- safeJson(cutSlots) %></script>
<script id="dsf-cfg" type="application/json"><%- safeJson({ edge: edgeTrimPerSide, subColspan }) %></script>

<script>
  const GROUP = JSON.parse(document.getElementById("dsf-group").textContent);
  const SLOTS = JSON.parse(document.getElementById("dsf-slots").textContent);
  const CFG = JSON.parse(document.getElementById("dsf-cfg").textContent);
  const SUB_COLSPAN = Number(CFG.subColspan) || (SLOTS.length + 4);
  const dsfTrim = document.getElementById("dsfTrim");
  const dsfTrimText = document.getElementById("dsfTrimText");
  const DEFAULT_TRIM = 5;
  // Per-side edge trim, live from the editable "Edge Trim (total mm)" field.
  let EDGE = DEFAULT_TRIM / 2;
  function readTrim() {
    const t = Number(dsfTrim && dsfTrim.value);
    EDGE = (Number.isFinite(t) && t >= 0 ? t : DEFAULT_TRIM) / 2;
  }
  // Edge Trim shows as text; the pencil (top-right) swaps in the input.
  function showTrimText() {
    const t = Number(dsfTrim.value);
    if (!(Number.isFinite(t) && t >= 0)) dsfTrim.value = DEFAULT_TRIM;
    dsfTrimText.textContent = round2(Number(dsfTrim.value)).toLocaleString("en-IN") + " mm";
    dsfTrim.hidden = true;
    dsfTrimText.hidden = false;
  }
  function editTrim() {
    dsfTrimText.hidden = true;
    dsfTrim.hidden = false;
    dsfTrim.focus();
    dsfTrim.select();
  }
  const SIZES = Array.isArray(GROUP.candidateSizes) ? GROUP.candidateSizes : [];
  const KIDS = Array.isArray(GROUP._children) ? GROUP._children : [];

  // Sane bounds -- a deckle web is a label reel, never a few mm and never metres
  // wide; roll R.Meter figures are lengths, not widths. Used only to catch
  // fat-finger input, not to model the real machine limits.
  const MIN_DECKLE_MM = 25;
  const MAX_DECKLE_MM = 2000;
  const MIN_WIDTH_MM = 1;
  const MAX_RM = 1000000;

  const round2 = (n) => Math.round(n * 100) / 100;
  const fmt = (n) => (Number.isFinite(n) ? round2(n).toLocaleString("en-IN") : "—");
  const fmtI = (n) => (Number.isFinite(n) ? Math.round(n).toLocaleString("en-IN") : "—");
  const esc = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  // Renders one .dsa-stat chip for the summary bar by the submit button --
  // top-level (rather than inside the Auto Deckle block below) since it must
  // render whether or not Auto Deckle is enabled.
  const finalStat = (k, v, cls, wrapCls, title) =>
    `<div class="dsa-stat${wrapCls ? " " + wrapCls : ""}"${title ? ` title="${esc(title)}"` : ""}>`
    + `<span class="k">${esc(k)}</span><span class="v${cls ? " " + cls : ""}">${esc(v)}</span></div>`;

  const dsfDeckleSize = document.getElementById("dsfDeckleSize");
  const dsfNoOfRolls = document.getElementById("dsfNoOfRolls");
  const dsfLayoutsJson = document.getElementById("dsfLayoutsJson");
  const layoutBody = document.getElementById("dsfLayoutBody");
  const layoutStatus = document.getElementById("dsfLayoutStatus");
  const layoutTable = document.getElementById("dsfLayoutTable");
  const layoutModal = document.getElementById("dsfLayoutModal");
  const layoutModalTitle = document.getElementById("dsfLayoutModalTitle");
  const dsfAddLayout = document.getElementById("dsfAddLayout");
  const dsfSetBody = document.getElementById("dsfSetBody");
  const dsfSetSub = document.getElementById("dsfSetSub");
  const dsfSetHead = document.getElementById("dsfSetHead");
  const dsfFinalStats = document.getElementById("dsfFinalStats");
  const dsfStatChips = document.getElementById("dsfStatChips");
  const orderBody = document.getElementById("dsfOrderBody");
  const sizeChipsEl = document.getElementById("dsfSizeChips");
  const sizeAddEl = document.getElementById("dsfSizeAdd");
  const sizeInputEl = document.getElementById("dsfSizeInput");
  const dsfSubmit = document.getElementById("dsfSubmit");
  const dsfIssues = document.getElementById("dsfIssues");
  const dsfIssuesBody = document.getElementById("dsfIssuesBody");
  // Last computed validation state -- recalcAll() refreshes it, submit reads it.
  let ISSUES = { errors: [], notReady: false };

  // The available deckle sizes -- seeded from in-stock facestock, then the
  // planner can add/remove (pencil = edit). Kept ascending + deduped. The web
  // is chosen automatically: smallest that fits the widest layout (least trim).
  let SIZE_LIST = SIZES.map((s) => Number(s.size)).filter((n) => n > 0);
  let sizesEditing = false;
  function normSizeList() {
    SIZE_LIST = [...new Set(SIZE_LIST.map((n) => round2(Number(n))).filter((n) => Number.isFinite(n) && n > 0))]
      .sort((a, b) => a - b);
  }
  normSizeList();
  let selectedSize = null;
  let userPickedSize = false;

  function renderSizeChips() {
    document.getElementById("dsfSizeEdit").classList.toggle("is-on", sizesEditing);
    sizeAddEl.hidden = !sizesEditing;
    sizeChipsEl.innerHTML = SIZE_LIST.length
      ? SIZE_LIST.map((sz, i) =>
          `<span class="sl-job-value dsf-size-item"><span>${esc(fmt(sz))} mm</span>`
          + `${sizesEditing ? `<button type="button" class="x" data-i="${i}" title="Remove">&times;</button>` : ""}</span>`
        ).join("")
      : `<span class="sl-job-value dsf-size-none">${sizesEditing ? "add a size below" : "none — click the pencil to add"}</span>`;
    sizeChipsEl.querySelectorAll(".x").forEach((b) => b.addEventListener("click", (e) => {
      e.stopPropagation();
      SIZE_LIST.splice(Number(b.dataset.i), 1);
      renderSizeChips();
      recalcAll();
    }));
  }
  const sizeMsgEl = document.getElementById("dsfSizeMsg");
  function showSizeMsg(text) {
    if (!sizeMsgEl) return;
    sizeMsgEl.textContent = text || "";
    sizeMsgEl.hidden = !text;
    sizeInputEl.classList.toggle("is-bad", !!text);
  }
  function addSize() {
    const raw = String(sizeInputEl.value).trim();
    const v = round2(Number(raw));
    const trim = Number(dsfTrim && dsfTrim.value);
    if (raw === "" || !Number.isFinite(v)) { showSizeMsg("Enter a number in mm."); sizeInputEl.focus(); return; }
    if (v <= 0) { showSizeMsg("Deckle size must be greater than 0."); sizeInputEl.focus(); return; }
    if (v < MIN_DECKLE_MM || v > MAX_DECKLE_MM) {
      showSizeMsg(`Deckle size looks wrong — expected ${MIN_DECKLE_MM}–${MAX_DECKLE_MM} mm.`); sizeInputEl.focus(); return;
    }
    if (Number.isFinite(trim) && trim >= 0 && v <= trim) {
      showSizeMsg(`Deckle size must be more than the ${round2(trim)} mm edge trim.`); sizeInputEl.focus(); return;
    }
    if (SIZE_LIST.some((s) => round2(s) === v)) { showSizeMsg(`${fmt(v)} mm is already listed.`); sizeInputEl.focus(); return; }
    SIZE_LIST.push(v);
    normSizeList();
    sizeInputEl.value = "";
    showSizeMsg("");
    sizeInputEl.focus();
    renderSizeChips();
    recalcAll();
  }

  // ---- web-view segment builders ----
  function edgeSeg(side) {
    return `<div class="sl-web-seg sl-web-edge" style="flex-grow:${EDGE}" title="${side} edge trim — ${EDGE} mm">`
      + `<span class="sl-seg-slot">EDGE</span><span class="sl-seg-w">${EDGE}</span></div>`;
  }
  function cutSeg(slot, w) {
    return `<div class="sl-web-seg" style="flex-grow:${w}" title="${esc(slot)} — ${esc(fmt(w))} mm">`
      + `<span class="sl-seg-slot">${esc(slot)}</span><span class="sl-seg-w">${esc(fmt(w))}</span></div>`;
  }
  function trimSeg(w) {
    return `<div class="sl-web-seg sl-web-trim" style="flex-grow:${w}" title="Trim (uncut slack) — ${esc(fmt(w))} mm">`
      + `<span class="sl-seg-slot">TRIM</span><span class="sl-seg-w">${esc(fmt(w))}</span></div>`;
  }
  function webInnerHTML(cuts, webWidth) {
    const sum = round2(cuts.reduce((n, [, w]) => n + w, 0));
    const cuttable = round2(webWidth - 2 * EDGE);
    const over = webWidth > 0 && sum > cuttable;
    const slack = round2(cuttable - sum);
    if (!cuts.length) {
      return `${edgeSeg("Left")}<div class="sl-web-empty" style="flex-grow:${Math.max(cuttable, 1)};flex-basis:0;min-width:0;width:auto;">${webWidth > 0 ? esc(fmt(cuttable)) + " mm — no roll widths yet" : "enter roll widths"}</div>${edgeSeg("Right")}`;
    }
    const segs = cuts.map(([slot, w]) => cutSeg(slot, w));
    if (!over && slack > 0) segs.push(trimSeg(slack));
    return `${edgeSeg("Left")}${segs.join("")}${edgeSeg("Right")}`;
  }

  // ---- grace ---------------------------------------------------------------
  // Spare web that would be scrapped as side trim, shared out over a layout's
  // rolls so it is cut instead. A 30 mm siderun across 3 rolls makes each one
  // 10 mm wider. The knives are set to the WIDER figure; the client is still
  // billed the width they ordered, so the two numbers are different things and
  // both travel -- to PendingProduction.deckleLayout[].cuts[].orderedWidth, on
  // to the slitting card, and finally to the finished roll, which is priced and
  // sold at the ordered width (routes/system/slitting.js).
  //
  // The A..L inputs keep holding the ORDERED widths. That matters: the "Rolls
  // Set"/"Balance" columns match a layout's cuts against each order's paper
  // size, and matching on a graced width would find no order at all. Grace is
  // held beside them, per slot, on the row itself.
  const graceOf = (tr) => (tr.__grace ||= {});
  const graceFor = (tr, slot) => {
    const g = Number(graceOf(tr)[slot]);
    return Number.isFinite(g) && g > 0 ? round2(g) : 0;
  };
  const rowHasGrace = (tr) => SLOTS.some((s) => graceFor(tr, s) > 0);
  // Grace on a slot with no roll width is meaningless -- drop it, so clearing a
  // width can't leave width behind in the totals.
  function pruneGrace(tr) {
    const g = graceOf(tr);
    SLOTS.forEach((s) => {
      const el = tr.querySelector(`.sl-roll-width[data-slot="${s}"]`);
      if (!(Number(el && el.value) > 0)) delete g[s];
    });
  }

  // ---- layout rows ----
  // `cuts` are the ordered widths (what the order asked for, and what the
  // order-matching reads); `graced` are the widths the knives are actually set
  // to. They are the same list when no grace has been given, which is why
  // everything that draws or measures the web reads `graced`.
  function readRow(tr) {
    const cuts = SLOTS
      .map((s) => [s, Number(tr.querySelector(`.sl-roll-width[data-slot="${s}"]`).value)])
      .filter(([, w]) => Number.isFinite(w) && w > 0);
    const graced = cuts.map(([s, w]) => [s, round2(w + graceFor(tr, s))]);
    return {
      graced,
      cuts,
      drm: Number(tr.querySelector(".dsf-drm").value) || null,
      rm: Number(tr.querySelector(".dsf-rm").value) || null,
      webs: Math.max(0, Math.floor(Number(tr.querySelector(".dsf-webs").value) || 0)),
    };
  }

  // Raw per-slot state for validation -- keeps the blanks and bad values that
  // readRow() silently drops.
  function rowSlots(tr) {
    return SLOTS.map((s) => {
      const el = tr.querySelector(`.sl-roll-width[data-slot="${s}"]`);
      const raw = String(el.value).trim();
      return { slot: s, el, raw, num: raw === "" ? null : Number(raw) };
    });
  }
  const lastFilledIdx = (slots) => slots.reduce((idx, s, k) => (s.raw !== "" ? k : idx), -1);
  const trimmedVal = (el) => (el ? String(el.value).trim() : "");

  // Finished rolls per knife position from one deckle web = Deckle R.M. / roll
  // R. Meter (e.g. 900 / 300 = 3). Falls back to 1 when it can't be computed.
  function rollsPerWeb(r) {
    return r.drm > 0 && r.rm > 0 ? Math.max(1, Math.floor(round2(r.drm / r.rm))) : 1;
  }

  // Layout rows are addressed by a stable id rather than by position: the
  // Deckle Set recap sorts by Total and hands that id back when its pencil is
  // pressed, so a row that moved (or one added since the recap was drawn) still
  // opens the layout the planner clicked.
  let LID = 0;

  // True once AI Deckle Set has put a plan on the page. That plan is a complete
  // answer for every ticked order, so piling a hand-drawn layout on top of it is
  // almost always a mistake -- and a blank one silently locks Create Deckle
  // Batch until it is filled or removed. So Add Deckle Layout is closed off
  // while what is on screen is the AI's plan.
  //
  // Taking a layout out of it (or clearing the last one) means it is no longer
  // the AI's plan, and adding opens back up -- otherwise removing a layout would
  // be a one-way door with no way to draw its replacement.
  let AI_PLANNED = false;

  function addLayoutRow(preset) {
    const tr = document.createElement("tr");
    tr.className = "dsf-layout-row";
    tr.dataset.lid = String(++LID);
    tr.innerHTML = `
      <td class="dsf-rownum">1</td>
      ${SLOTS.map((s) => `<td><input type="number" step="any" min="0" inputmode="decimal" class="form-control sl-roll-width sl-width-input" data-slot="${s}" placeholder="${s}" title="Roll ${s} width in mm" /></td>`).join("")}
      <td><input type="number" step="any" min="0" inputmode="decimal" class="form-control dsf-drm" placeholder="Mtrs" title="Length of one deckle web" /></td>
      <td><input type="number" step="any" min="0" inputmode="decimal" class="form-control dsf-rm" placeholder="Mtrs" title="Length wound on each finished roll" /></td>
      <td><input type="number" step="1" min="1" inputmode="numeric" class="form-control dsf-webs" placeholder="Qty" value="1" title="How many deckle webs (reels) use this same layout" /></td>
      <td><button type="button" class="dsf-row-btn dsf-remove" title="Remove this layout" aria-label="Remove this layout"><i class="fa-solid fa-xmark"></i></button></td>`;

    const sub = document.createElement("tr");
    sub.className = "dsf-layout-sub";
    sub.innerHTML = `<td class="dsf-sub-cell" colspan="${SUB_COLSPAN}">
        <div class="dsf-webs-stack"></div>
      </td>`;
    tr.__sub = sub;

    if (preset) {
      if (preset.drm != null) tr.querySelector(".dsf-drm").value = preset.drm;
      if (preset.rm != null) tr.querySelector(".dsf-rm").value = preset.rm;
      if (preset.webs != null) tr.querySelector(".dsf-webs").value = preset.webs;
      // The deckle web this layout is cut from -- only meaningful while mixed
      // webs are on; rowSize() falls back to the batch pick otherwise.
      if (preset.size != null) tr.dataset.size = String(preset.size);
      (preset.cuts || []).forEach(([slot, w]) => {
        const el = tr.querySelector(`.sl-roll-width[data-slot="${slot}"]`);
        if (el) el.value = w;
      });
    }

    const widthInputs = [...tr.querySelectorAll(".sl-roll-width")];
    widthInputs.forEach((el, idx) => {
      el.addEventListener("keydown", (ev) => {
        if (ev.key !== "Enter") return;
        ev.preventDefault();
        (widthInputs[idx + 1] || widthInputs[idx]).focus();
      });
    });
    tr.querySelectorAll("input").forEach((el) => el.addEventListener("input", recalcAll));
    tr.querySelector(".dsf-remove").addEventListener("click", () => {
      AI_PLANNED = false;
      if (layoutBody.querySelectorAll(".dsf-layout-row").length > 1) {
        const wasEditing = tr.classList.contains("is-editing");
        sub.remove();
        tr.remove();
        // The dialog is scoped to this row -- with it gone there is nothing
        // left to edit, so close rather than leave an empty solo table.
        if (wasEditing) closeLayoutDialog();
        recalcAll();
        return;
      }
      // Last layout -- the × clears its values instead of removing the row.
      tr.querySelectorAll(".sl-roll-width").forEach((el) => { el.value = ""; });
      tr.querySelector(".dsf-drm").value = "";
      tr.querySelector(".dsf-rm").value = "";
      tr.querySelector(".dsf-webs").value = "1";
      recalcAll();
    });

    layoutBody.appendChild(tr);
    layoutBody.appendChild(sub);
    recalcAll();
    return tr;
  }

  function layoutRows() { return [...layoutBody.querySelectorAll(".dsf-layout-row")]; }

  // ---- layout dialog -----------------------------------------------------
  // Opens the layout table on one layout: that row and its size sub-row take
  // .is-editing and the rest are hidden by CSS (#dsfLayoutTable.is-solo).
  // Nothing is detached, so every other layout keeps counting towards the
  // totals, the validation and what Create Deckle Batch posts.
  function openLayoutDialog(lid) {
    const tr = layoutBody.querySelector(`.dsf-layout-row[data-lid="${lid}"]`);
    if (!tr) return;
    layoutBody.querySelectorAll("tr.is-editing").forEach((el) => el.classList.remove("is-editing"));
    tr.classList.add("is-editing");
    if (tr.__sub) tr.__sub.classList.add("is-editing");
    layoutTable.classList.add("is-solo");
    // The number every "Layout #N: ..." error uses -- the recap's own # column
    // is a row counter, so a layout is named here and on its pencil, not there.
    layoutModalTitle.textContent = `Deckle Layout #${layoutRows().indexOf(tr) + 1}`;
    layoutModal.classList.add("show");
    layoutModal.setAttribute("aria-hidden", "false");
    renderGracePanel();
    const first = tr.querySelector(".sl-roll-width:not(:disabled)");
    if (first) first.focus();
  }

  // ---- grace panel --------------------------------------------------------
  // Scoped to the layout the dialog currently has open. Editing here writes
  // straight onto that row's grace and re-runs recalcAll(), so the web diagram,
  // the Siderun, Grace and Total above all move as the numbers are typed --
  // which is the whole point: the planner watches the waste go to zero.
  const gracePanel = document.getElementById("dsfGracePanel");
  const graceBtn = document.getElementById("dsfGraceBtn");
  let graceOpen = false;

  function graceRows(tr) {
    return SLOTS
      .map((slot) => ({ slot, el: tr.querySelector(`.sl-roll-width[data-slot="${slot}"]`) }))
      .map((x) => ({ ...x, ordered: Number(x.el && x.el.value) }))
      .filter((x) => Number.isFinite(x.ordered) && x.ordered > 0);
  }

  // Spare usable web once the ordered widths and the grace already given are
  // taken off. Negative means the layout overflows -- recalcAll() is already
  // shouting about that, the panel just refuses to add more.
  function graceSpare(tr) {
    const size = rowSize(tr);
    if (!(size > 0)) return null;
    const cuttable = round2(size - 2 * EDGE);
    const cut = round2(readRow(tr).graced.reduce((n, [, w]) => n + w, 0));
    return round2(cuttable - cut);
  }

  // Share every last mm of the spare out over the rolls, in WHOLE
  // millimetres.
  //
  // It used to divide to 2 dp, which handed every roll the same decimal: a
  // 30 mm spare over 4 rolls made four 157.5 mm knives out of 150 mm orders.
  // Nobody sets a knife to half a millimetre by choice, and it put a decimal
  // through the cut widths, the web diagram, the job card and the slitting
  // card behind it. The same 30 mm now goes out as 8, 8, 7, 7 -- whole
  // numbers, never more than 1 mm apart, and the same 30 mm total.
  //
  // A spare that is not itself a whole number (a fractional edge trim or roll
  // width) cannot come out whole on every roll. The sub-millimetre remainder
  // then goes on ONE roll rather than being smeared across all of them, so
  // exactly one knife carries a decimal instead of every knife. It is not
  // dropped: the point of this button is that no width is left to be
  // scrapped, and a sliver of side trim is still a sliver of paper.
  function graceSpreadEvenly(tr) {
    const rows = graceRows(tr);
    if (!rows.length) return;
    const spare = graceSpare(tr);
    if (!(spare > 0)) return;
    const g = graceOf(tr);
    const n = rows.length;

    // Whole millimetres each...
    const base = Math.floor(spare / n);
    if (base > 0) rows.forEach((x) => { g[x.slot] = round2(graceFor(tr, x.slot) + base); });

    // ...then what is left over, a whole millimetre at a time, one roll each.
    let left = round2(spare - base * n);
    for (let i = 0; i < n && left >= 1; i += 1) {
      g[rows[i].slot] = round2(graceFor(tr, rows[i].slot) + 1);
      left = round2(left - 1);
    }

    // Under a millimetre: cannot be made whole, so it lands on one roll.
    if (left > 0) g[rows[0].slot] = round2(graceFor(tr, rows[0].slot) + left);
    recalcAll();
  }

  function graceClear(tr) {
    tr.__grace = {};
    recalcAll();
  }

  // The Grace button is the way in AND the way out, so it has to say which it
  // currently is: "Grace" to open, "Hide Grace" to close. It also carries the
  // mm this layout has already been given, so a graced layout is obvious with
  // the panel shut -- the old button read the same in every state.
  function renderGraceBtn() {
    const tr = layoutBody.querySelector(".dsf-layout-row.is-editing");
    const given = tr ? round2(SLOTS.reduce((n, sl) => n + graceFor(tr, sl), 0)) : 0;
    const badge = given > 0 ? `<span class="dsf-btn-badge">${esc(fmt(given))} mm</span>` : "";
    graceBtn.classList.toggle("is-on", graceOpen);
    graceBtn.setAttribute("aria-expanded", graceOpen ? "true" : "false");
    graceBtn.innerHTML = graceOpen
      ? `<i class="fa-solid fa-chevron-up"></i> Hide Grace${badge}`
      : `<i class="fa-solid fa-arrows-left-right-to-line"></i> Grace${badge}`;
    graceBtn.title = graceOpen
      ? "Hide the grace panel"
      : (given > 0
          ? `${fmt(given)} mm of side trim shared out over this layout's rolls — click to adjust`
          : "Share this layout's leftover side trim out over its rolls — cut wider, still billed at the ordered width");
  }

  function renderGracePanel() {
    renderGraceBtn();
    const tr = layoutBody.querySelector(".dsf-layout-row.is-editing");
    if (!graceOpen || !tr) { gracePanel.hidden = true; gracePanel.innerHTML = ""; return; }
    gracePanel.hidden = false;

    // recalcAll() redraws this panel on every keystroke, and innerHTML throws
    // away the very box being typed in -- which cost the field its focus, its
    // caret and its tab position after each character. Remember the box first
    // and put it back afterwards.
    //
    // Its RAW text is restored, not the rounded number: half-typed values like
    // "18." parse to 18, and writing that back mid-entry turns the next
    // keystroke into "183" instead of "18.3".
    const act = document.activeElement;
    const keep = act && act.classList && act.classList.contains("dsf-grace-input")
      ? { slot: act.dataset.graceSlot, raw: act.value, start: act.selectionStart, end: act.selectionEnd }
      : null;

    const rows = graceRows(tr);
    const size = rowSize(tr);
    const cuttable = size > 0 ? round2(size - 2 * EDGE) : null;
    const orderedSum = round2(rows.reduce((n, x) => n + x.ordered, 0));
    const graceSum = round2(rows.reduce((n, x) => n + graceFor(tr, x.slot), 0));
    const cutSum = round2(orderedSum + graceSum);
    const spare = cuttable == null ? null : round2(cuttable - cutSum);

    const msg = !rows.length
      ? "Enter this layout's roll widths first — grace shares out what is left over after them."
      : (cuttable == null ? "Pick a deckle size for this layout first." : "");
    const over = spare != null && spare < 0;

    const sum = (k, v, cls) =>
      `<div class="dsf-grace-sum"><span class="k">${esc(k)}</span>`
      + `<span class="v${cls ? " " + cls : ""}">${esc(v)}</span></div>`;

    gracePanel.innerHTML = `
      <div class="dsf-grace-head">
        <h3>Grace</h3>
        <button type="button" class="dsf-grace-x" data-grace-close="1"
                aria-label="Hide grace" title="Hide grace">&times;</button>
        <span class="dsf-grace-note">Cut wider than ordered so the side trim is used, not scrapped.
          The client is still billed the width they ordered.</span>
        <div class="dsf-grace-acts">
          <button type="button" class="dsf-mini-btn" data-grace-spread="1"
                  ${rows.length && spare > 0 ? "" : "disabled"}
                  title="Share the whole spare out evenly across these rolls">
            <i class="fa-solid fa-arrows-left-right"></i> Spread evenly
          </button>
          <button type="button" class="dsf-mini-btn" data-grace-clear="1"
                  ${graceSum > 0 ? "" : "disabled"}>Clear</button>
        </div>
      </div>
      <div class="dsf-grace-body">
        ${rows.length ? `
        <table class="dsf-grace-table">
          <thead>
            <tr>
              <th>Roll</th>
              <th title="The width the sales order asked for — what the client is billed">Ordered</th>
              <th title="Extra width handed to this roll out of the side trim">Grace (mm)</th>
              <th title="What the knife is actually set to">Cut width</th>
            </tr>
          </thead>
          <tbody>
            ${rows.map((x) => `
              <tr>
                <td class="dsf-g-slot">${esc(x.slot)}</td>
                <td>${esc(fmt(x.ordered))} mm</td>
                <td><input type="text" inputmode="decimal" autocomplete="off"
                           class="dsf-grace-input" data-grace-slot="${esc(x.slot)}"
                           value="${graceFor(tr, x.slot) > 0 ? esc(graceFor(tr, x.slot)) : ""}"
                           placeholder="0" aria-label="Grace for roll ${esc(x.slot)}" /></td>
                <td class="dsf-g-cut">${esc(fmt(round2(x.ordered + graceFor(tr, x.slot))))} mm</td>
              </tr>`).join("")}
          </tbody>
        </table>` : ""}
        <div class="dsf-grace-sums">
          ${sum("Usable web", cuttable != null ? `${fmt(cuttable)} mm` : "—")}
          ${sum("Ordered", `${fmt(orderedSum)} mm`)}
          ${sum("Grace given", `${fmt(graceSum)} mm`, graceSum > 0 ? "good" : "")}
          ${sum("Cut total", `${fmt(cutSum)} mm`, over ? "bad" : "")}
          ${sum("Still scrapped", spare != null ? `${fmt(spare)} mm` : "—",
                over ? "bad" : (spare === 0 ? "good" : "warn"))}
        </div>
        <div class="dsf-grace-msg">${esc(over
          ? `Over the web by ${fmt(-spare)} mm — take that much grace back off.`
          : msg)}</div>
      </div>`;

    if (!keep) return;
    const el = gracePanel.querySelector(`.dsf-grace-input[data-grace-slot="${keep.slot}"]`);
    if (!el) return;
    el.value = keep.raw;
    el.focus();
    try { el.setSelectionRange(keep.start, keep.end); } catch { /* nothing to place */ }
  }

  function closeLayoutDialog() {
    layoutModal.classList.remove("show");
    layoutModal.setAttribute("aria-hidden", "true");
    layoutTable.classList.remove("is-solo");
    layoutBody.querySelectorAll("tr.is-editing").forEach((el) => el.classList.remove("is-editing"));
    // The panel belongs to the layout that was open; it is not carried to the
    // next one. Grace already given stays on the row either way.
    graceOpen = false;
    renderGracePanel();
  }

  // Widest single layout drawn so far -- the chosen web must at least fit this.
  function maxLayoutSum() {
    return layoutRows().reduce((mx, tr) => {
      const s = round2(readRow(tr).graced.reduce((n, [, w]) => n + w, 0));
      return Math.max(mx, s);
    }, 0);
  }

  // The recommended web: smallest available size whose cuttable width covers the
  // widest layout (least trim); largest if none fits.
  function bestFitSize(widest) {
    if (!SIZE_LIST.length) return null;
    return widest > 0
      ? (SIZE_LIST.find((sz) => round2(sz - 2 * EDGE) >= widest) ?? SIZE_LIST[SIZE_LIST.length - 1])
      : SIZE_LIST[0];
  }

  // Resolve the size in play: the planner's pick if they ticked one, else the
  // best fit. Writes #dsfDeckleSize.
  function autoSize() {
    const widest = maxLayoutSum();
    const best = bestFitSize(widest);
    // Keep the planner's pick while it is still an available size; otherwise
    // follow the best fit.
    if (!(userPickedSize && SIZE_LIST.includes(selectedSize))) selectedSize = best;
    dsfDeckleSize.value = selectedSize != null ? selectedSize : "";
    return { widest, best, fits: selectedSize != null && round2(selectedSize - 2 * EDGE) >= widest };
  }

  // Mixed webs: each layout may be cut from a different deckle width instead of
  // one width serving the whole batch. Follows the AI Deckle Set panel's "Different
  // web per layout" toggle, which is on by default -- so it starts on whenever
  // that panel is rendered, and stays off when AI Deckle Set is disabled and
  // there is no toggle to turn it back off. While off, everything below
  // behaves exactly as it always has -- one `selectedSize` for every row.
  let MIXED_WEBS = false;

  // After an AI Deckle Set run the planner has already been told which web
  // each layout runs on, so every other size's diagram is noise -- each
  // layout's size table collapses to the chosen row until the planner asks to
  // see the rest again (per row, via "Show all sizes"). Hand-drawn planning is
  // unaffected: the full table is how you choose a size in the first place.
  let ONLY_CHOSEN = false;

  // The deckle width a given layout row is cut from: its own, when mixed webs
  // are on and one has been chosen for it, else the batch-wide pick.
  function rowSize(tr) {
    if (MIXED_WEBS) {
      const own = Number(tr.dataset.size);
      if (Number.isFinite(own) && own > 0 && SIZE_LIST.includes(own)) return own;
    }
    return selectedSize;
  }

  // The one width the BATCH is recorded at -- PendingProduction.deckleSize.
  // With mixed webs that is the width carrying the most webs (ties to the
  // wider), matching what utils/deckleOptimizer reports as its headline size.
  // Every layout still stores its own width alongside it.
  function headlineSize() {
    if (!MIXED_WEBS) return selectedSize;
    const byS = new Map();
    layoutRows().forEach((tr) => {
      const s = rowSize(tr);
      if (!(s > 0)) return;
      const webs = Math.max(0, Math.floor(Number(tr.querySelector(".dsf-webs").value) || 0));
      byS.set(s, (byS.get(s) || 0) + webs);
    });
    if (!byS.size) return selectedSize;
    return [...byS.entries()].sort((a, b) => b[1] - a[1] || b[0] - a[0])[0][0];
  }

  function selectSize(sz, tr) {
    const n = Number(sz);
    if (!Number.isFinite(n)) return;
    // With mixed webs on, picking a size in a layout's own table sets THAT
    // layout's web; otherwise it sets the batch's single web, as before.
    if (MIXED_WEBS && tr) {
      tr.dataset.size = String(n);
      recalcAll();
      return;
    }
    userPickedSize = true;
    selectedSize = n;
    dsfDeckleSize.value = n;
    recalcAll();
  }

  const WEB_TABLE_HEAD =
    `<thead><tr><th>Deckle Size</th><th>Siderun</th><th>Across</th><th>Deckle Count</th><th>Layout</th><th>Use</th></tr></thead>`;

  // One "deckle size | siderun | across | deckle count | diagram | pick" row.
  function webRowHTML(cuts, sz, chosen, isBest, webs) {
    const cutSum = round2(cuts.reduce((n, [, w]) => n + w, 0));
    const cuttable = round2(sz - 2 * EDGE);
    const remaining = round2(cuttable - cutSum);
    const over = cutSum > cuttable;
    const rollWord = `${cuts.length} roll${cuts.length === 1 ? "" : "s"}`;
    const cap = cuts.length ? rollWord : "—";
    return `
      <tr class="dsf-web-tr${chosen ? " is-chosen" : ""}" data-size="${sz}" role="radio" aria-checked="${chosen}" tabindex="0">
        <td class="dsf-web-size">${esc(fmt(sz))} mm</td>
        <td class="dsf-web-rem${over ? " sl-bad" : ""}">${cuts.length ? esc(fmt(remaining)) + " mm" : "—"}</td>
        <td class="dsf-web-across">
          <span class="flag ${over ? "sl-bad" : (cuts.length ? "sl-ok" : "")}">${cap}</span>
          ${isBest && !chosen ? `<span class="dsf-tag">best fit</span>` : ""}
        </td>
        <td class="dsf-web-dc">${esc(fmt(webs))}</td>
        <td class="dsf-web-diag">
          <div class="sl-web${over ? " is-over" : ""}">${webInnerHTML(cuts, sz)}</div>
        </td>
        <td class="dsf-web-pick"><span class="dsf-radio"></span></td>
      </tr>`;
  }

  // Renumber rows, redraw every row's webs (chosen + every other in-stock size),
  // update totals.
  function recalcAll() {
    readTrim();
    const rows = layoutRows();
    const { best } = autoSize();
    let totalWebs = 0;
    const errors = [];
    // Layout rows the planner hasn't started filling -- not an error, just
    // "not ready": these keep the form + the Add-layout button locked but never
    // show a red "fix this" line.
    let blankRows = 0;
    // Layout numbers (1-based) that currently carry a hard error -- gates the
    // "Add Deckle Layout" button so a new row can't be piled on a broken one.
    const brokenRows = new Set();
    // rolls "deckle set" per roll width = Σ over layouts (cuts of that width ×
    // Webs × Rolls-per-web), where Rolls-per-web = Deckle R.M. ÷ roll R. Meter.
    const setByWidth = new Map();
    // webs that carry each width -- Σ over layouts (layout has that width ? Webs : 0).

    rows.forEach((tr, i) => {
      // Row number, plus the web this row is cut from once the layouts can
      // differ -- otherwise the size only appears in the sub-table and it is
      // not obvious at a glance which row runs on what.
      const numCell = tr.querySelector(".dsf-rownum");
      const ownSize = rowSize(tr);
      numCell.innerHTML = MIXED_WEBS && ownSize > 0
        ? `${i + 1}<div class="dsf-row-web">${esc(fmt(ownSize))}</div>`
        : String(i + 1);
      tr.querySelectorAll(".sl-roll-width").forEach((el) => el.classList.toggle("is-set", el.value.trim() !== ""));
      const L = `Layout #${i + 1}: `;
      const errBefore = errors.length;
      // This row's own web. Identical to the batch's for every row unless
      // mixed webs are on, so all the checks below read the same either way.
      const rSz = rowSize(tr);
      const cuttable = rSz > 0 ? round2(rSz - 2 * EDGE) : 0;

      pruneGrace(tr);
      const slots = rowSlots(tr);
      const drmEl = tr.querySelector(".dsf-drm");
      const rmEl = tr.querySelector(".dsf-rm");
      const websEl = tr.querySelector(".dsf-webs");
      const drmRaw = trimmedVal(drmEl);
      const rmRaw = trimmedVal(rmEl);
      const websRaw = trimmedVal(websEl);
      const anyWidth = slots.some((s) => s.raw !== "");

      // A row the planner hasn't started -- no widths, no lengths, web count
      // still at its default. Counts as "not ready" (keeps the form + the
      // Add-layout button locked) but never raises a red error.
      const rowBlank = !anyWidth && drmRaw === "" && rmRaw === "" && (websRaw === "" || websRaw === "1");
      if (rowBlank) blankRows += 1;

      // --- roll widths: filled A -> L, in order, no gaps ---
      const lastIdx = lastFilledIdx(slots);
      let prevFilled = true;
      slots.forEach((s) => {
        // A slot opens once every slot before it holds a value; a slot that
        // already has a value stays open so it can be corrected.
        s.el.disabled = !(prevFilled || s.raw !== "");
        if (s.raw === "") prevFilled = false;
        const badNum = s.raw !== "" && (!Number.isFinite(s.num) || s.num < MIN_WIDTH_MM);
        // It is the width the knife is SET to that has to fit the web, so this
        // is checked after grace, not on the ordered figure typed in the box.
        const cutW = Number.isFinite(s.num) ? round2(s.num + graceFor(tr, s.slot)) : s.num;
        const wide = rSz > 0 && Number.isFinite(cutW) && cutW > cuttable;
        s.el.classList.toggle("is-bad", badNum || wide);
        if (wide) {
          errors.push(`${L}roll ${s.slot} (${fmt(cutW)} mm`
            + `${cutW !== s.num ? ` after grace, ordered ${fmt(s.num)} mm` : ""})`
            + ` is wider than the ${fmt(cuttable)} mm usable web`);
        }
      });
      const hasGap = slots.some((s, k) => k < lastIdx && s.raw === "");
      if (hasGap) errors.push(`${L}fill roll widths A→L in order — no blank slot between them`);
      if (slots.some((s) => s.raw !== "" && (!Number.isFinite(s.num) || s.num < MIN_WIDTH_MM)))
        errors.push(`${L}every roll width must be a number greater than 0`);

      const r = readRow(tr);
      const rpw = rollsPerWeb(r);

      // --- Deckle R.M. / Roll R. Meter: both or neither, roll <= web ---
      const drmN = Number(drmRaw);
      const rmN = Number(rmRaw);
      const drmBad = drmRaw !== "" && (!Number.isFinite(drmN) || drmN <= 0 || drmN > MAX_RM);
      const rmBad = rmRaw !== "" && (!Number.isFinite(rmN) || rmN <= 0 || rmN > MAX_RM);
      if (drmBad) errors.push(`${L}Deckle R.M. must be a length greater than 0`);
      if (rmBad) errors.push(`${L}Roll R. Meter must be a length greater than 0`);
      if ((drmRaw === "") !== (rmRaw === ""))
        errors.push(`${L}enter both Deckle R.M. and Roll R. Meter, or leave both blank`);
      let rmOverWeb = false;
      if (!drmBad && !rmBad && drmRaw !== "" && rmRaw !== "" && rmN > drmN) {
        rmOverWeb = true;
        errors.push(`${L}Roll R. Meter (${fmt(rmN)} m) can't be longer than the deckle web (${fmt(drmN)} m)`);
      }
      drmEl.classList.toggle("is-bad", drmBad);
      rmEl.classList.toggle("is-bad", rmBad || rmOverWeb);

      // --- Deckle Count (webs): whole number, 1 or more (skipped on a blank row) ---
      const websNum = Number(websRaw);
      const websBad = !rowBlank
        && (websRaw === "" || !Number.isFinite(websNum) || websNum < 1 || !Number.isInteger(websNum));
      if (websBad) errors.push(`${L}Deckle Count must be a whole number of 1 or more`);
      websEl.classList.toggle("is-bad", websBad);

      // The × removes the row; on the sole remaining row it just clears the
      // values, and is disabled while that row is already untouched.
      const rmBtn = tr.querySelector(".dsf-remove");
      const isLast = rows.length <= 1;
      rmBtn.disabled = isLast && rowBlank;
      rmBtn.title = isLast ? "Clear this layout" : "Remove this layout";
      totalWebs += r.webs;
      r.cuts.forEach(([, w]) => setByWidth.set(w, (setByWidth.get(w) || 0) + r.webs * rpw));
      // What the knives actually take off the web -- ordered width plus grace.
      const cutSum = round2(r.graced.reduce((n, [, w]) => n + w, 0));
      const over = rSz > 0 && cutSum > cuttable;

      // Table: one row per available deckle size -- size | remaining | diagram | pick.
      const stack = tr.__sub.querySelector(".dsf-webs-stack");
      // Collapsed (auto-planned) rows show only the size actually in use; the
      // chosen size must still be an available one, else fall back to the full
      // list rather than drawing an empty table.
      const collapsed = ONLY_CHOSEN && SIZE_LIST.length > 1
        && tr.dataset.showAll !== "1" && SIZE_LIST.includes(rSz);
      const sizesShown = collapsed ? [rSz] : SIZE_LIST;
      stack.innerHTML = SIZE_LIST.length
        ? `<table class="dsf-web-table">${WEB_TABLE_HEAD}<tbody>${sizesShown.map((s) => webRowHTML(r.graced, s, s === rSz, s === best, r.webs)).join("")}</tbody></table>`
          + (collapsed
              ? `<button type="button" class="dsf-sizes-toggle" title="Show every available deckle size for this layout"><i class="fa-solid fa-chevron-down"></i>Show all ${SIZE_LIST.length} sizes</button>`
              : (ONLY_CHOSEN && SIZE_LIST.length > 1
                  ? `<button type="button" class="dsf-sizes-toggle" data-hide="1" title="Show only the deckle size this layout uses"><i class="fa-solid fa-chevron-up"></i>Show only the selected size</button>`
                  : ""))
        : `<div style="font-size:12px;font-weight:700;color:#7c8ba1;padding:6px 2px;">Add a deckle size above (pencil next to “Available Sizes”).</div>`;
      stack.querySelectorAll(".dsf-web-tr").forEach((el) => {
        el.addEventListener("click", () => selectSize(el.dataset.size, tr));
        el.addEventListener("keydown", (ev) => {
          if (ev.key === " " || ev.key === "Enter") { ev.preventDefault(); selectSize(el.dataset.size, tr); }
        });
      });
      const sizesToggle = stack.querySelector(".dsf-sizes-toggle");
      if (sizesToggle) {
        sizesToggle.addEventListener("click", () => {
          if (sizesToggle.dataset.hide === "1") delete tr.dataset.showAll;
          else tr.dataset.showAll = "1";
          recalcAll();
        });
      }

      if (!rowBlank && !r.cuts.length && !hasGap)
        errors.push(`${L}enter at least one roll width`);
      if (over) errors.push(`${L}widths total ${fmt(cutSum)} mm — only ${fmt(cuttable)} mm of the ${fmt(rSz)} mm web is usable; split the layout or pick a bigger deckle size`);

      if (errors.length > errBefore) brokenRows.add(i + 1);
    });

    // "Rolls Set" / "Balance" per order -- rolls of an order's paper size that
    // the layouts cover. Orders sharing a paper size split the pool in
    // list order; the last one absorbs any overflow.
    // Only TICKED orders are in this deckle. An unticked one is not batched at
    // all -- it stays loose and goes back to the Deckle Sorting page -- so it
    // must not be handed any of the rolls these layouts produce either.
    const ordersByWidth = new Map();
    [...orderBody.querySelectorAll("tr")].forEach((otr) => {
      const picked = !!otr.querySelector('input[name="orderIds"]:checked');
      if (!picked) {
        otr.querySelector(".dsf-o-set").textContent = "—";
        const skipEl = otr.querySelector(".dsf-o-bal");
        skipEl.textContent = "Not in this deckle";
        skipEl.style.color = "#94a3b8";
        skipEl.style.fontSize = "11px";
        return;
      }
      const w = Number(otr.dataset.size) || 0;
      if (!ordersByWidth.has(w)) ordersByWidth.set(w, []);
      ordersByWidth.get(w).push(otr);
    });
    ordersByWidth.forEach((trs, w) => {
      let pool = setByWidth.get(w) || 0;
      trs.forEach((otr, idx) => {
        const qty = Number(otr.dataset.qty) || 0;
        const take = idx === trs.length - 1 ? pool : Math.min(pool, qty);
        pool = Math.max(0, pool - take);
        // Balance = rolls set − rolls ordered: negative = short, positive = extra made.
        const bal = round2(take - qty);
        otr.querySelector(".dsf-o-set").textContent = fmtI(take);
        const balEl = otr.querySelector(".dsf-o-bal");
        balEl.textContent = (bal > 0 ? "+" : "") + fmtI(bal);
        balEl.style.color = bal < 0 ? "#b45309" : "#15803d";
        balEl.style.fontSize = "";
        // A short order is only partly set: those rolls are split back onto
        // Deckle Sorting when the batch is created.
        balEl.title = bal < 0
          ? `${fmtI(-bal)} roll(s) short — they go back to Deckle Sorting when you create the batch`
          : (bal > 0 ? `${fmtI(bal)} spare roll(s) beyond what was ordered` : "Exactly covered");
      });
    });

    // ---- whole-form checks ----
    if (!SIZE_LIST.length) {
      errors.push("Add at least one deckle size — click the pencil next to “Available Sizes”.");
    }
    const trimRaw = trimmedVal(dsfTrim);
    const trimNum = Number(trimRaw);
    const trimInvalid = trimRaw === "" || !Number.isFinite(trimNum) || trimNum < 0;
    if (trimInvalid) {
      errors.push("Edge Trim must be 0 mm or more.");
    } else if (SIZE_LIST.length && trimNum >= SIZE_LIST[0]) {
      errors.push(`Edge Trim (${fmt(trimNum)} mm) leaves nothing to cut on the smallest deckle size (${fmt(SIZE_LIST[0])} mm).`);
    }
    if (dsfTrim) dsfTrim.classList.toggle("is-bad", trimInvalid || (SIZE_LIST.length && trimNum >= SIZE_LIST[0]));

    if (!checkedIds().length) errors.push("Tick at least one order to bundle into this deckle.");

    dsfNoOfRolls.value = String(totalWebs);
    // The batch is saved at ONE deckle size. With mixed webs that is whichever
    // width carries the most webs; each layout still posts its own alongside.
    const headline = headlineSize();
    dsfDeckleSize.value = headline != null ? headline : "";
    // A layout the planner hasn't started isn't an error -- it just keeps the
    // form + the Add-layout button locked, with no message.
    const notReady = blankRows > 0;
    ISSUES = { errors, notReady };
    renderIssues();
    dsfAddLayout.disabled = AI_PLANNED || blankRows > 0 || brokenRows.size > 0;
    dsfAddLayout.title = AI_PLANNED
      ? "AI Deckle Set planned these layouts — remove one to draw your own, or run it again to re-plan"
      : "";

    // Errors only. The plan's recap -- layouts, deckles, the widths in play --
    // is already on the page in the Deckle Set table and the stats bar, so
    // repeating it in the dialog said nothing new. An error still belongs here:
    // the issues panel is behind the dialog while the dialog is open, so this
    // is the only place a planner sees what they have just broken.
    layoutStatus.textContent = errors[0] || "";

    renderGracePanel();
    renderSetSummary();
  }

  // ---- "Deckle Set" recap ------------------------------------------------
  // A read-only picture of what pressing Create Deckle Batch would make: one
  // line per layout (web it runs on, the knives across it, what one web yields
  // and how many webs), then the batch totals. Purely derived from the layout
  // rows -- redrawn by recalcAll(), never edited here; each line's pencil opens
  // its layout in the dialog instead.
  // "100 mm x 3, 150 mm x 1" -- roll size then how many of it sit across the
  // web, the way the shopfloor calls a set out. The count is always shown,
  // single knives included, so every entry reads the same way.
  function cutsPairs(cuts) {
    const byW = new Map();
    cuts.forEach(([, w]) => byW.set(w, (byW.get(w) || 0) + 1));
    return [...byW.entries()].sort((a, b) => b[0] - a[0]);
  }
  const cutsHTML = (cuts) =>
    cutsPairs(cuts).map(([w, n]) => `<b>${esc(fmt(w))}</b> mm × <b>${esc(fmtI(n))}</b>`).join(", ");
  const cutsPlain = (cuts) => cutsPairs(cuts).map(([w, n]) => `${fmt(w)} mm × ${fmtI(n)}`).join(", ");
  const mmText = (v) => (v != null ? fmt(v) + " mm" : "—");
  const mText = (v) => (v > 0 ? fmt(v) + " m" : "—");

  // ---- Deckle Set recap: columns ------------------------------------------
  // One spec per column. The header, the filter row and every body cell are
  // generated from this list, so the three can't drift out of step -- a footer
  // whose colspans no longer add up to the header is how this table went ragged
  // the first time it grew a column.
  //   plain:  no sorting, no filter box (a counter or a button, not data).
  //   sort:   the value the column orders on.
  //   text:   what a filter matches against -- the same string the cell shows.
  const SET_COLS = [
    {
      // A row counter, not data: it always reads 1 down to the last row on
      // screen, so it renumbers itself whenever the table is sorted or
      // filtered. Nothing is identified by it -- a layout is named on its own
      // pencil and in the dialog's title -- so there is nothing to sort or
      // search it by.
      key: "sl", label: "#", cls: "dsf-set-no", plain: true,
      th: "Row number — always 1 down to the last row shown, whatever the sort or filter. The layout's own number (the one errors name it by) is on its pencil.",
      cell: (L, i) => String(i + 1),
    },
    {
      key: "size", label: "Deckle Size", cls: "dsf-set-size",
      th: "The web this layout is cut from.",
      sort: (L) => L.size, text: (L) => (L.size > 0 ? fmt(L.size) + " mm" : "—"),
      cell: (L) => (L.size > 0 ? esc(fmt(L.size)) + " mm" : "—"),
    },
    {
      // Ordered widths, not cut widths: this is what the order asked for and
      // what the client is billed. The diagram beside it is what is actually
      // run, so a graced layout says so rather than leaving the two to disagree
      // silently.
      key: "across", label: "Rolls Across", cls: "dsf-set-cuts",
      th: "The knives across the web — roll width × how many of it, at the width ordered. Sorts on how many knives.",
      sort: (L) => L.cuts.length,
      text: (L) => cutsPlain(L.cuts) + (L.grace > 0 ? ` +${fmt(L.grace)} grace` : ""),
      cell: (L) => cutsHTML(L.cuts) + (L.grace > 0
        ? `<span class="dsf-grace-tag" title="${esc(`${fmt(L.grace)} mm of side trim shared out over these rolls — they are cut wider, and billed at the widths shown here`)}">+${esc(fmt(L.grace))} GRACE</span>`
        : ""),
    },
    {
      key: "layout", label: "Layout", cls: "dsf-web-diag",
      th: "The web drawn to scale, at the widths actually cut (grace included). Sorts on the total width cut from it.",
      sort: (L) => L.cutSum, text: (L) => cutsPlain(L.graced),
      cell: (L) => `<div class="sl-web${L.remaining != null && L.remaining < 0 ? " is-over" : ""}">`
        + `${webInnerHTML(L.graced, L.size)}</div>`,
    },
    // Siderun + Trim + Grace = Total, in that order across the row, so the
    // headline figure can be checked against its three parts by eye.
    {
      key: "rem", label: "Siderun",
      th: "Uncut web left over after the knives, edge trim and grace already netted out. The scrapped slack in Total.",
      cls: (L) => "dsf-set-rem" + (L.remaining != null && L.remaining < 0 ? " sl-bad" : ""),
      sort: (L) => (L.remaining == null ? -Infinity : L.remaining), text: (L) => mmText(L.remaining),
      cell: (L) => (L.remaining != null ? esc(fmt(L.remaining)) + " mm" : "—"),
    },
    {
      key: "edge", label: "Trim", cls: "dsf-set-edge",
      th: "Edge trim scrapped off this web, both edges — the Edge Trim (total mm) set at the top of the page.",
      sort: (L) => (L.edge == null ? -1 : L.edge), text: (L) => mmText(L.edge),
      cell: (L) => (L.edge != null ? esc(fmt(L.edge)) + " mm" : "—"),
    },
    {
      // Grace is not scrap -- it is web the rolls actually carry -- but it is
      // still width the client did not order and is not billed for, so it
      // belongs beside the two that are scrapped and inside the Total with
      // them. A layout with no grace reads a plain 0 rather than a dash: 0 mm
      // of grace is a real and normal answer, unlike a web that has no size
      // set yet.
      key: "grace", label: "Grace", cls: "dsf-set-grace",
      th: "Side trim handed to the rolls instead of being scrapped — the knives are set this much wider in total, and the client is still billed the width ordered.",
      sort: (L) => (L.size > 0 ? L.grace : -1), text: (L) => (L.size > 0 ? mmText(L.grace) : "—"),
      cell: (L) => (L.size > 0 ? esc(fmt(L.grace)) + " mm" : "—"),
    },
    {
      key: "total", label: "Total", cls: "dsf-set-trim",
      th: "Everything this web gives up beyond the widths ordered — the Siderun, Trim and Grace beside it added together (i.e. deckle size minus the ordered roll widths). The table starts ranked by this, most first.",
      sort: (L) => (L.total == null ? -1 : L.total), text: (L) => mmText(L.total),
      cell: (L) => (L.total != null ? esc(fmt(L.total)) + " mm" : "—"),
    },
    {
      key: "drm", label: "Deckle R.M.", th: "Length of the web this layout runs on.",
      sort: (L) => L.drm || 0, text: (L) => mText(L.drm), cell: (L) => esc(mText(L.drm)),
    },
    {
      key: "rm", label: "Roll R.M.", th: "Length wound on each finished roll.",
      sort: (L) => L.rm || 0, text: (L) => mText(L.rm), cell: (L) => esc(mText(L.rm)),
    },
    {
      key: "rolls", label: "Rolls", cls: "dsf-set-rolls",
      th: "Finished rolls this layout yields — knives × webs × rolls per knife.",
      sort: (L) => L.rolls, text: (L) => fmtI(L.rolls), cell: (L) => esc(fmtI(L.rolls)),
    },
    {
      key: "webs", label: "Deckle", th: "How many deckle webs (reels) run this layout.",
      sort: (L) => L.webs, text: (L) => fmtI(L.webs), cell: (L) => esc(fmtI(L.webs)),
    },
    {
      key: "act", label: "", plain: true, cls: "dsf-set-edit-cell",
      cell: (L) => `<button type="button" class="dsf-set-edit" data-edit-lid="${esc(L.lid)}"`
        + ` title="Edit layout #${esc(L.no)}" aria-label="Edit layout #${esc(L.no)}">`
        + `<i class="fa-solid fa-pen"></i></button>`,
    },
  ];

  // ---- Deckle Set recap: sort + per-column filters -------------------------
  // Both outlive a redraw -- recalcAll() rebuilds this table on every keystroke
  // in the layout dialog -- so they live out here rather than inside the
  // renderer. The opening sort is the ranking the recap has always used.
  let SET_SORT = { key: "total", dir: "desc" };
  const SET_FILTERS = {};
  // What was last computed for the table, so a filter keystroke can repaint the
  // rows without re-deriving the whole plan.
  let SET_ROWS = [];
  let SET_PENDING = [];
  let SET_TOTALS = { totWebs: 0, totRolls: 0, sqm: 0 };

  // Filters match what the cell shows, with grouping commas ignored so "1250"
  // still finds a "1,250 mm" cell.
  const filterKey = (v) => String(v ?? "").toLowerCase().replace(/,/g, "").trim();

  const activeSetFilters = () => SET_COLS
    .filter((c) => !c.plain && filterKey(SET_FILTERS[c.key]) !== "")
    .map((c) => [c, filterKey(SET_FILTERS[c.key])]);

  // Rows as the table currently shows them: filtered, then sorted.
  function visibleSetRows() {
    const filters = activeSetFilters();
    const rows = SET_ROWS.filter((L) => filters.every(([c, q]) => filterKey(c.text(L)).includes(q)));
    const col = SET_COLS.find((c) => c.key === SET_SORT.key && !c.plain);
    if (!col) return rows;
    const dir = SET_SORT.dir === "asc" ? 1 : -1;
    return rows.sort((a, b) => {
      const av = col.sort(a);
      const bv = col.sort(b);
      const d = typeof av === "string" || typeof bv === "string"
        ? String(av).localeCompare(String(bv), undefined, { numeric: true })
        : av - bv;
      if (d) return d * dir;
      // Ties break the way this table always has, whichever way it is sorted:
      // the layout throwing away more in total leads, then layout order.
      const t = (b.total || 0) * b.webs - (a.total || 0) * a.webs;
      return t !== 0 ? t : a.no - b.no;
    });
  }

  function renderSetSummary() {
    const rows = layoutRows();
    // Only layouts that are actually drawn (at least one roll width) make it
    // into the recap proper -- a half-filled row would only show noise in the
    // figures. It still has to be listed, though (as a "not drawn yet" line
    // below the rest): a blank layout keeps Create Deckle Batch and Add Deckle
    // Layout locked, and this table is now the only route back into it.
    const pending = [];
    const set = rows
      .map((tr, i) => {
        const r = readRow(tr);
        const no = i + 1;
        const lid = tr.dataset.lid;
        if (!r.cuts.length) { pending.push({ no, lid }); return null; }
        const size = rowSize(tr) || 0;
        const cutSum = round2(r.graced.reduce((n, [, w]) => n + w, 0));
        const rpw = rollsPerWeb(r);
        // Width handed to the rolls rather than scrapped, this layout -- the
        // difference between what the knives are set to and what the client
        // ordered. Already netted out of `remaining` below (the slack is what
        // is left AFTER grace was shared out), so the three never double-count.
        const graceMm = round2(r.graced.reduce((n, [, w]) => n + w, 0)
          - r.cuts.reduce((n, [, w]) => n + w, 0));
        return {
          no,
          lid,
          size,
          cuts: r.cuts,
          graced: r.graced,
          grace: graceMm,
          cutSum,
          // Usable web left over after the knives -- negative means the layout
          // overflows the web.
          remaining: size > 0 ? round2(size - 2 * EDGE - cutSum) : null,
          // Edge trim netted off this web -- both edges. It is the same on every
          // row (it comes off one field at the top of the page), but it earns a
          // column of its own between Siderun and Grace so the four read
          // straight across as the sum they are.
          edge: size > 0 ? round2(2 * EDGE) : null,
          // Everything one web gives up beyond the widths that were ORDERED:
          // both edge trims and the uncut slack (scrapped), plus the grace
          // (cut, and run, but handed to the rolls instead of billed). It is
          // exactly `size - the ordered widths`, which is why the three parts
          // beside it add up to it on every row.
          total: size > 0
            ? round2(2 * EDGE + Math.max(0, round2(size - 2 * EDGE - cutSum)) + graceMm)
            : null,
          drm: r.drm,
          rm: r.rm,
          rpw,
          webs: r.webs,
          // Finished rolls this layout yields = knives × webs × rolls per knife.
          rolls: r.cuts.length * r.webs * rpw,
        };
      })
      .filter(Boolean);

    // Worst first: the layout that scraps the most width off its web leads,
    // down to the tightest one -- so the rows worth re-drawing are read first
    // and the recap ranks the set instead of echoing the order it was typed
    // in. `no` stays the planner's own layout number (errors name rows by it),
    // which is why the row counter on the left is a separate thing.
    set.sort((a, b) => {
      // A layout with no web yet has nothing to scrap off -- park it last.
      const at = a.total == null ? -1 : a.total;
      const bt = b.total == null ? -1 : b.total;
      if (bt !== at) return bt - at;
      // Same per web: the one running more webs gives up more in all.
      const bw = (b.total || 0) * b.webs;
      const aw = (a.total || 0) * a.webs;
      if (bw !== aw) return bw - aw;
      return a.no - b.no;
    });

    if (!set.length) {
      // Nothing drawn yet. The header row would be an empty strip with a second
      // Add button in it, so it stays hidden and the empty state is the single
      // way in. It opens the blank layout the form already holds rather than
      // adding another -- Add Deckle Layout is disabled while one is blank, so
      // a second would be unreachable anyway.
      dsfSetSub.textContent = "";
      dsfSetHead.hidden = true;
      SET_ROWS = [];
      SET_PENDING = pending;
      SET_TOTALS = { totWebs: 0, totRolls: 0, sqm: 0 };
      const first = pending[0];
      dsfSetBody.innerHTML =
        `<div class="dsf-set-empty">`
        + `<span>Nothing set yet — draw a layout (or run AI Deckle Set) and it appears here.</span>`
        + `<button type="button" class="dsf-set-empty-btn"`
        + (first ? ` data-edit-lid="${esc(first.lid)}"` : ` data-add-layout="1"`)
        + `><i class="fa-solid fa-plus"></i> Add Layout</button>`
        + `</div>`;
      dsfFinalStats.innerHTML = "";
      dsfStatChips.innerHTML = "";
      return;
    }
    dsfSetHead.hidden = false;

    const totWebs = set.reduce((n, L) => n + L.webs, 0);
    const totRolls = set.reduce((n, L) => n + L.rolls, 0);
    // Facestock the batch consumes: Σ web width × web length × webs, in m².
    const sqm = round2(set.reduce((n, L) => n + (L.size / 1000) * (L.drm || 0) * L.webs, 0));
    // Webs per distinct deckle width -- the reels to pull for this job.
    const byS = new Map();
    set.forEach((L) => { if (L.size > 0) byS.set(L.size, (byS.get(L.size) || 0) + L.webs); });
    const sizeLine = [...byS.entries()]
      .sort((a, b) => a[0] - b[0])
      .map(([sz2, w]) => `${fmt(sz2)} mm × ${fmtI(w)}`)
      .join("  ·  ");
    dsfSetSub.textContent = sizeLine ? `Deckle webs: ${sizeLine}` : "";

    SET_ROWS = set;
    SET_PENDING = pending;
    SET_TOTALS = { totWebs, totRolls, sqm };
    paintSetTable();

    renderFinalStats(set, totWebs, sqm, byS, sizeLine);
  }

  // Redraw the recap from SET_ROWS / SET_PENDING under the current sort and
  // filters. innerHTML replaces the filter boxes along with everything else, so
  // whichever one was being typed in is refocused with its caret where it was;
  // without that a filter would drop focus after every character.
  function paintSetTable() {
    const act = document.activeElement;
    const keep = act && act.classList && act.classList.contains("dsf-set-filter")
      ? { col: act.dataset.filterCol, start: act.selectionStart, end: act.selectionEnd }
      : null;
    dsfSetBody.innerHTML = setTableHTML();
    if (!keep) return;
    const el = dsfSetBody.querySelector(`.dsf-set-filter[data-filter-col="${keep.col}"]`);
    if (!el) return;
    el.focus();
    try { el.setSelectionRange(keep.start, keep.end); } catch { /* not a settable input */ }
  }

  function setTableHTML() {
    const rows = visibleSetRows();
    const hidden = SET_ROWS.length - rows.length;
    const span = SET_COLS.length;
    const { totWebs, totRolls, sqm } = SET_TOTALS;

    const head = SET_COLS.map((c) => {
      const title = c.th ? ` title="${esc(c.th)}"` : "";
      if (c.plain) return `<th${title}>${esc(c.label)}</th>`;
      const on = SET_SORT.key === c.key;
      const dirName = SET_SORT.dir === "asc" ? "ascending" : "descending";
      const arrow = on ? (SET_SORT.dir === "asc" ? "fa-arrow-up-long" : "fa-arrow-down-long") : "fa-sort";
      return `<th class="dsf-set-th${on ? " is-sorted" : ""}" data-sort-col="${esc(c.key)}"`
        + ` role="button" tabindex="0" aria-sort="${on ? dirName : "none"}"`
        + ` title="${esc(`${c.th ? c.th + " " : ""}Click to sort.`)}">`
        + `<span class="dsf-th-in">${esc(c.label)}<i class="dsf-th-arrow fa-solid ${arrow}"></i></span></th>`;
    }).join("");

    const filterRow = SET_COLS.map((c) => {
      if (c.plain) return `<th></th>`;
      const v = SET_FILTERS[c.key] || "";
      return `<th><input type="text" autocomplete="off" class="dsf-set-filter${v ? " is-on" : ""}"`
        + ` data-filter-col="${esc(c.key)}" value="${esc(v)}" placeholder="Search"`
        + ` aria-label="Search ${esc(c.label || "column")}" /></th>`;
    }).join("");

    const body = rows.map((L, i) =>
      `<tr data-edit-lid="${esc(L.lid)}" title="Click to edit layout #${esc(L.no)}">${SET_COLS.map((c) => {
        const cls = typeof c.cls === "function" ? c.cls(L) : c.cls;
        return `<td${cls ? ` class="${cls}"` : ""}>${c.cell(L, i)}</td>`;
      }).join("")}</tr>`).join("");

    // Layouts with nothing drawn on them yet are pinned under the rest and are
    // never filtered out: a blank layout keeps Create Deckle Batch locked, and
    // this table is the only handle on it. They carry on the same row counter.
    const pendingRows = SET_PENDING.map((L, j) => `
      <tr class="dsf-set-pending" data-edit-lid="${esc(L.lid)}" title="Click to draw layout #${esc(L.no)}">
        <td class="dsf-set-no">${rows.length + j + 1}</td>
        <td colspan="${span - 2}" style="text-align:left;">Not drawn yet — no roll widths on this layout. Draw it or remove it before saving.</td>
        <td class="dsf-set-edit-cell">
          <button type="button" class="dsf-set-edit" data-edit-lid="${esc(L.lid)}"
                  title="Draw layout #${esc(L.no)}" aria-label="Draw layout #${esc(L.no)}">
            <i class="fa-solid fa-pen"></i>
          </button>
        </td>
      </tr>`).join("");

    const noMatch = rows.length === 0 && hidden > 0
      ? `<tr class="dsf-set-nomatch"><td colspan="${span}">No layout matches these filters.`
        + ` <button type="button" class="dsf-set-clear" data-clear-filters="1">Clear filters</button></td></tr>`
      : "";

    // The totals are the batch's, not the filtered view's -- what gets made
    // doesn't change because someone typed in a search box -- so say plainly
    // when rows are being held back from a table whose footer still counts them.
    const hiddenNote = hidden > 0
      ? ` <span class="dsf-set-hid">${fmtI(hidden)} hidden by filter, still counted`
        + ` <button type="button" class="dsf-set-clear" data-clear-filters="1">Clear</button></span>`
      : "";

    return `
      <table class="dsf-set-table">
        <thead>
          <tr>${head}</tr>
          <tr class="dsf-set-filters">${filterRow}</tr>
        </thead>
        <tbody>${body}${noMatch}${pendingRows}</tbody>
        <tfoot>
          <tr>
            <td colspan="4" style="text-align:left;">Total — ${SET_ROWS.length} layout${SET_ROWS.length === 1 ? "" : "s"}${hiddenNote}</td>
            <td colspan="5" style="text-align:right;">${sqm > 0 ? `Facestock ${esc(fmt(sqm))} m²` : ""}</td>
            <td>${esc(fmtI(totRolls))}</td>
            <td>${esc(fmtI(totWebs))}</td>
            <td></td>
          </tr>
        </tfoot>
      </table>`;
  }

  // Click cycles a column the way a Tabulator header does: ascending, then
  // descending. Moving to another column starts it ascending.
  function sortSetBy(key) {
    SET_SORT = SET_SORT.key === key
      ? { key, dir: SET_SORT.dir === "asc" ? "desc" : "asc" }
      : { key, dir: "asc" };
    paintSetTable();
  }

  function clearSetFilters() {
    SET_COLS.forEach((c) => { delete SET_FILTERS[c.key]; });
    paintSetTable();
  }

  // The figures from the AI Deckle Set result grid, kept live off whatever is
  // currently drawn above (hand-built or AI-planned) so they read correctly
  // even when Auto Deckle was never run. Sits beside the submit button.
  //
  // Side Run, Grace and Total are whole-job totals, in mm as well as %, never
  // a per-web average -- so they reconcile by eye, which is the quickest check
  // the figures are sane:
  //
  //     Total = edge trim x webs + Side Run + Grace
  //
  // in mm and in % alike, matching the Siderun / Trim / Grace / Total columns
  // of the recap table above.
  function renderFinalStats(set, totWebs, sqm, byS, sizeLine) {
    // Extra Rolls: rolls produced per width beyond what ticked orders asked
    // for. Rolls-per-width comes off the layouts (same as setByWidth in
    // recalcAll); the area uses each width's rolls-weighted average Roll R.M.,
    // since two layouts of the same width can carry different roll lengths.
    const widthAgg = new Map();
    set.forEach((L) => {
      const perCut = L.webs * L.rpw;
      L.cuts.forEach(([, w]) => {
        const acc = widthAgg.get(w) || { rolls: 0, rmSum: 0 };
        acc.rolls += perCut;
        acc.rmSum += perCut * (L.rm || 0);
        widthAgg.set(w, acc);
      });
    });
    const qtyByWidth = new Map();
    [...orderBody.querySelectorAll("tr")].forEach((otr) => {
      if (!otr.querySelector('input[name="orderIds"]:checked')) return;
      const w = Number(otr.dataset.size) || 0;
      qtyByWidth.set(w, (qtyByWidth.get(w) || 0) + (Number(otr.dataset.qty) || 0));
    });
    let extraRolls = 0;
    let extraSqM = 0;
    widthAgg.forEach((agg, w) => {
      const extra = Math.max(0, agg.rolls - (qtyByWidth.get(w) || 0));
      if (extra > 0) {
        extraRolls += extra;
        extraSqM += extra * (w / 1000) * (agg.rolls > 0 ? agg.rmSum / agg.rolls : 0);
      }
    });
    extraSqM = round2(extraSqM);

    // Side Run: the uncut slack left on each web after its knives (edge trims
    // netted out already) -- the trim a different layout could still recover.
    let sideMm = 0;
    let avoidableSqM = 0;
    set.forEach((L) => {
      if (!(L.size > 0) || !(L.remaining > 0)) return;
      sideMm += L.remaining * L.webs;
      avoidableSqM += (L.remaining / 1000) * (L.drm || 0) * L.webs;
    });
    sideMm = round2(sideMm);
    avoidableSqM = round2(avoidableSqM);
    const avoidPct = sqm > 0 ? round2((avoidableSqM / sqm) * 100) : 0;

    // Grace: side trim handed to the rolls instead of being scrapped. Not
    // waste -- the web is cut and wound -- but not ordered or billed either,
    // so it is reported on its own and counted in Total below.
    let graceMm = 0;
    let graceSqM = 0;
    set.forEach((L) => {
      if (!(L.size > 0) || !(L.grace > 0)) return;
      graceMm += L.grace * L.webs;
      graceSqM += (L.grace / 1000) * (L.drm || 0) * L.webs;
    });
    graceMm = round2(graceMm);
    graceSqM = round2(graceSqM);
    const gracePct = sqm > 0 ? round2((graceSqM / sqm) * 100) : 0;

    // Total: everything the job gives up beyond the widths ORDERED -- edge
    // trim + Side Run (both scrapped) + Grace (cut, but not billed). Equal to
    // deckle size minus the ordered roll widths, over every web. Extra Rolls
    // are NOT in it: they are spare stock cut from width that would otherwise
    // have been trimmed away, not a second helping of loss (see the Auto
    // Deckle waste-accounting note).
    const edgeMm = round2(2 * EDGE * totWebs);
    const wasteMm = round2(edgeMm + sideMm + graceMm);
    let edgeSqM = 0;
    set.forEach((L) => { if (L.size > 0) edgeSqM += (2 * EDGE / 1000) * (L.drm || 0) * L.webs; });
    const wasteSqM = round2(edgeSqM + avoidableSqM + graceSqM);
    const wastePct = sqm > 0 ? round2((wasteSqM / sqm) * 100) : 0;

    const distinctSizes = byS.size;
    // The reels to pull is a list, not a number, so it gets the full width of
    // its own line above the rest of the chips and stays on that one line
    // rather than being wrapped into a 130px column with them. Which of the two
    // figures fills that line is unchanged -- only where it sits.
    const lead = distinctSizes > 1
      ? finalStat("Deckle Webs Used", sizeLine, "", "dsf-stat-lead", sizeLine)
      : finalStat("Deckle Size", `${fmt(Number(dsfDeckleSize.value) || 0)} mm`, "", "dsf-stat-lead");
    dsfFinalStats.innerHTML = lead;
    dsfStatChips.innerHTML = [
      finalStat("Layouts", `${set.length}`, "", "dsa-stat-narrow"),
      finalStat("Deckle Count", `${fmtI(totWebs)}`, "", "dsa-stat-narrow"),
      finalStat("Facestock Used", `${fmt(sqm)} m²`),
      finalStat(
        "Extra Rolls",
        extraRolls ? `${fmtI(extraRolls)} · ${fmt(extraSqM)} m²` : "0",
        extraRolls ? "warn" : "good",
      ),
      finalStat(
        "Side Run",
        `${fmt(avoidPct)} % | ${fmt(sideMm)} mm`,
        avoidPct <= 2 ? "good" : "warn",
        "",
        `Total uncut slack across all ${fmtI(totWebs)} webs (${fmt(avoidableSqM)} m²).`,
      ),
      finalStat(
        "Grace",
        `${fmt(gracePct)} % | ${fmt(graceMm)} mm`,
        graceMm > 0 ? "good" : "",
        "",
        graceMm > 0
          ? `Side trim shared out over the rolls across all ${fmtI(totWebs)} webs (${fmt(graceSqM)} m²) — cut and wound, but billed at the widths ordered.`
          : "No grace given: every roll is cut at the width ordered.",
      ),
      finalStat(
        "Total",
        `${fmt(wastePct)} % | ${fmt(wasteMm)} mm`,
        wastePct <= 10 ? "good" : "warn",
        "dsa-stat-wide",
        `Everything beyond the widths ordered: Edge trim ${fmt(edgeMm)} mm + Side Run ${fmt(sideMm)} mm`
          + ` + Grace ${fmt(graceMm)} mm = ${fmt(wasteSqM)} m². Of that, ${fmt(round2(wasteSqM - graceSqM))} m² is scrapped`
          + ` and ${fmt(graceSqM)} m² goes out on the rolls. Spare rolls are not counted here.`,
      ),
    ].join("");
  }

  // Paint the issues panel + gate the submit button from ISSUES.
  function renderIssues() {
    const { errors, notReady } = ISSUES;
    if (!errors.length) {
      dsfIssues.hidden = true;
      dsfIssuesBody.innerHTML = "";
    } else {
      dsfIssues.hidden = false;
      dsfIssuesBody.classList.add("is-error");
      dsfIssuesBody.innerHTML =
        `<div class="dsf-issue-head">Fix before saving</div><ul>${errors.map((t) => `<li>${esc(t)}</li>`).join("")}</ul>`;
    }
    dsfSubmit.disabled = errors.length > 0 || notReady;
  }

  function checkedIds() {
    return [...orderBody.querySelectorAll('input[name="orderIds"]:checked')].map((c) => c.value);
  }

  // ---- wiring ----
  // A layout is added and drawn in one move -- there is no layout table on the
  // page to type into, so the new row opens straight away.
  dsfAddLayout.addEventListener("click", () => {
    if (dsfAddLayout.disabled) return;
    openLayoutDialog(addLayoutRow().dataset.lid);
  });
  // The recap is rebuilt on every keystroke, so its pencils are delegated
  // rather than re-bound each time.
  dsfSetBody.addEventListener("click", (ev) => {
    const edit = ev.target.closest("[data-edit-lid]");
    if (edit) { openLayoutDialog(edit.dataset.editLid); return; }
    // Empty state with no blank layout left to open -- make one and open it.
    if (ev.target.closest("[data-add-layout]")) { openLayoutDialog(addLayoutRow().dataset.lid); return; }
    if (ev.target.closest("[data-clear-filters]")) { clearSetFilters(); return; }
    // th[...] rather than [...]: the filter boxes carry data-filter-col, and a
    // click in one must not also sort the column it sits under.
    const th = ev.target.closest("th[data-sort-col]");
    if (th) sortSetBy(th.dataset.sortCol);
  });
  dsfSetBody.addEventListener("input", (ev) => {
    const f = ev.target.closest(".dsf-set-filter");
    if (!f) return;
    SET_FILTERS[f.dataset.filterCol] = f.value;
    paintSetTable();
  });
  dsfSetBody.addEventListener("keydown", (ev) => {
    const f = ev.target.closest(".dsf-set-filter");
    if (f) {
      // These boxes sit inside #dsfForm, where Enter would submit the batch.
      if (ev.key === "Enter") { ev.preventDefault(); return; }
      if (ev.key === "Escape") {
        ev.preventDefault();
        f.value = "";
        SET_FILTERS[f.dataset.filterCol] = "";
        paintSetTable();
      }
      return;
    }
    const th = ev.target.closest("th[data-sort-col]");
    if (th && (ev.key === "Enter" || ev.key === " ")) { ev.preventDefault(); sortSetBy(th.dataset.sortCol); }
  });
  graceBtn.addEventListener("click", () => {
    graceOpen = !graceOpen;
    renderGracePanel();
    if (graceOpen) gracePanel.scrollIntoView({ block: "nearest" });
  });
  // The panel is rebuilt on every recalc, so its controls are delegated.
  gracePanel.addEventListener("click", (ev) => {
    const tr = layoutBody.querySelector(".dsf-layout-row.is-editing");
    if (!tr) return;
    if (ev.target.closest("[data-grace-spread]")) { graceSpreadEvenly(tr); return; }
    if (ev.target.closest("[data-grace-clear]")) { graceClear(tr); return; }
    if (ev.target.closest("[data-grace-close]")) {
      graceOpen = false;
      renderGracePanel();
      graceBtn.focus();
    }
  });
  gracePanel.addEventListener("input", (ev) => {
    const el = ev.target.closest("[data-grace-slot]");
    if (!el) return;
    const tr = layoutBody.querySelector(".dsf-layout-row.is-editing");
    if (!tr) return;
    const raw = String(el.value).trim();
    // Plain decimal only -- a text box would otherwise accept "1e5" or "0x10",
    // both of which Number() happily turns into a width. A lone "." or a
    // trailing one is mid-entry, not an error: it reads as 0 for now and the
    // box keeps the text so the next digit lands where the planner expects.
    const partial = raw === "" || raw === ".";
    const bad = !partial && !/^\d*(\.\d*)?$/.test(raw);
    el.classList.toggle("is-bad", bad);
    if (bad) return;
    const n = partial ? 0 : Number(raw);
    if (!Number.isFinite(n) || n < 0) return;
    // Zero and blank are the same thing -- no grace on that roll -- and neither
    // is stored, so a row with nothing given stays plainly ungraced.
    if (n === 0) delete graceOf(tr)[el.dataset.graceSlot];
    else graceOf(tr)[el.dataset.graceSlot] = round2(n);
    recalcAll();
  });
  gracePanel.addEventListener("keydown", (ev) => {
    // The panel sits inside #dsfForm, where Enter would create the batch.
    if (ev.target.closest("[data-grace-slot]") && ev.key === "Enter") ev.preventDefault();
  });
  document.getElementById("dsfLayoutModalClose").addEventListener("click", closeLayoutDialog);
  document.getElementById("dsfLayoutModalDone").addEventListener("click", closeLayoutDialog);
  layoutModal.addEventListener("click", (ev) => { if (ev.target === layoutModal) closeLayoutDialog(); });
  document.addEventListener("keydown", (ev) => {
    if (ev.key === "Escape" && layoutModal.classList.contains("show")) closeLayoutDialog();
  });
  document.getElementById("dsfSizeEdit").addEventListener("click", () => { sizesEditing = !sizesEditing; renderSizeChips(); });
  document.getElementById("dsfSizeAddBtn").addEventListener("click", addSize);
  sizeInputEl.addEventListener("keydown", (ev) => { if (ev.key === "Enter") { ev.preventDefault(); addSize(); } });
  if (dsfTrim) {
    dsfTrim.addEventListener("input", recalcAll);
    dsfTrim.addEventListener("blur", showTrimText);
    dsfTrim.addEventListener("keydown", (ev) => {
      if (ev.key === "Enter" || ev.key === "Escape") { ev.preventDefault(); dsfTrim.blur(); }
    });
    document.getElementById("dsfTrimEdit").addEventListener("click", editTrim);
    showTrimText();
  }
  orderBody.querySelectorAll('input[name="orderIds"]').forEach((c) => c.addEventListener("change", () => {
    const tr = c.closest("tr");
    if (tr) tr.style.opacity = c.checked ? "1" : "0.45";
    recalcAll();
  }));

  let dsfSubmitting = false;
  document.getElementById("dsfForm").addEventListener("submit", (e) => {
    recalcAll();
    if (ISSUES.errors.length) {
      e.preventDefault();
      showToast(ISSUES.errors[0], "error");
      dsfIssues.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }
    if (ISSUES.notReady) { e.preventDefault(); return; }
    if (dsfSubmitting) { e.preventDefault(); return; }

    const rows = layoutRows()
      .map((tr) => ({ ...readRow(tr), size: rowSize(tr) }))
      .filter((r) => r.cuts.length);
    dsfLayoutsJson.value = JSON.stringify(rows.map((r) => ({
      // width = what the knife is set to; orderedWidth = what the client
      // ordered and is billed at. Equal unless the layout was graced, and the
      // server drops the pair when they are.
      cuts: r.graced.map(([slot, width], i) => ({ slot, width, orderedWidth: r.cuts[i][1] })),
      // The web THIS layout is cut from. Always sent, so a batch records the
      // width behind every layout even when they all share one -- Slitting
      // Allocation pre-fills each row from it.
      size: r.size,
      drm: r.drm,
      rm: r.rm,
      webs: r.webs,
    })));
    dsfNoOfRolls.value = String(rows.reduce((n, r) => n + r.webs, 0));

    // Lock the button so a double-click can't create two batches.
    dsfSubmitting = true;
    dsfSubmit.disabled = true;
    dsfSubmit.textContent = "Creating…";
  });

  <% if (autoDeckle && autoDeckle.enabled) { %>
  // ---- AI Deckle Set --------------------------------------------------
  // Asks the server (utils/deckleOptimizer, behind DECKLE_AUTO_ENABLED) for the
  // least-waste set of layouts and writes them into the layout rows. Purely a
  // drafting aid: it replaces the layout rows and the chosen size, then hands
  // straight back to recalcAll() -- so every validation, every warning and the
  // Create Deckle Batch button behave exactly as they do for a hand-drawn plan.
  const dsaRun = document.getElementById("dsaRun");
  if (dsaRun) {
    const dsaBody = document.getElementById("dsaBody");
    const dsaDrm = document.getElementById("dsaDrm");
    const dsaOvPct = document.getElementById("dsaOvPct");
    const dsaOvRolls = document.getElementById("dsaOvRolls");
    const dsaMixed = document.getElementById("dsaMixed");
    // The toggle ships on, so the manual planner starts in per-layout mode too
    // -- picking a size inside a layout's table sets that layout's web.
    MIXED_WEBS = dsaMixed.checked;

    function dsaShowError(msg) {
      dsaBody.innerHTML = `<div class="dsa-err">${esc(msg)}</div>`;
    }

    // Replace every layout row with the planned ones. Deckle R.M. and R. Meter
    // go in together or not at all -- the form treats them as both-or-neither.
    function dsaApply(plan) {
      // Every layout row is about to be replaced -- close the dialog first so
      // it can't be left scoped to a row that no longer exists.
      closeLayoutDialog();
      layoutBody.innerHTML = "";
      // The optimizer has picked the web for every layout -- show just that
      // one diagram per layout instead of one per available size.
      ONLY_CHOSEN = true;
      // The batch's headline width first, while MIXED_WEBS is still whatever
      // it was -- with mixed on, selectSize() would otherwise write onto a row.
      MIXED_WEBS = false;
      selectSize(plan.deckleSize);
      // Mixed only stays on when the plan actually came back mixed; a plan that
      // settled on one width should not leave the form in per-row mode.
      MIXED_WEBS = !!plan.mixed;

      // Nothing came back to apply -- that is not an AI plan, so the page is
      // left hand-drawable with a blank row to start from.
      if (!plan.layouts.length) { AI_PLANNED = false; addLayoutRow(); return; }
      plan.layouts.forEach((L) => {
        const hasLen = L.rm != null && L.drm != null;
        addLayoutRow({
          cuts: L.cuts.map((c) => [c.slot, c.width]),
          drm: hasLen ? L.drm : null,
          rm: hasLen ? L.rm : null,
          webs: L.webs,
          // Each layout remembers the web it was planned for; rowSize() reads
          // it back and every check below runs against that width.
          size: L.size,
        });
      });
      AI_PLANNED = true;
      recalcAll();
    }

    async function dsaPlan() {
      const orderIds = checkedIds();
      if (!orderIds.length) { dsaShowError("Tick at least one order to plan."); return; }
      if (!SIZE_LIST.length) {
        dsaShowError("Add at least one deckle size first — the pencil next to “Available Sizes”.");
        return;
      }
      const drm = Number(dsaDrm.value);
      dsaDrm.classList.toggle("is-bad", !(Number.isFinite(drm) && drm > 0));
      if (!(Number.isFinite(drm) && drm > 0)) {
        dsaShowError("Deckle R.M. must be a length greater than 0.");
        return;
      }

      dsaRun.disabled = true;
      const label = dsaRun.innerHTML;
      dsaRun.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i> Planning…`;
      dsaBody.innerHTML = "";
      try {
        const res = await fetch(
          `/app/labels/production/deckle-set/plan/${encodeURIComponent(GROUP.itemId)}/auto`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              orderIds,
              sizes: SIZE_LIST,
              trim: Number(dsfTrim.value),
              drm,
              mixedSizes: !!dsaMixed.checked,
              overrunPct: Number(dsaOvPct.value) / 100,
              overrunRolls: Number(dsaOvRolls.value),
            }),
          },
        );
        let data = null;
        try { data = await res.json(); } catch { data = null; }
        if (!data) {
          dsaShowError(`AI Deckle Set failed (HTTP ${res.status}). Plan the layouts by hand — Add Deckle Layout, under Deckle Set.`);
          return;
        }
        if (!data.ok) {
          dsaShowError(data.error || "AI Deckle Set could not plan these orders.");
          if (Array.isArray(data.notes) && data.notes.length) {
            dsaBody.innerHTML +=
              `<div class="dsa-notes"><ul>${data.notes.map((t) => `<li>${esc(t)}</li>`).join("")}</ul></div>`;
          }
          return;
        }
        dsaApply(data.plan);
        // Numbers for the plan now live in the summary bar by the submit
        // button (it's driven off the layout table dsaApply just filled) --
        // nothing else to show here on a successful run.
        showToast(
          `AI Deckle Set: ${data.plan.layouts.length} layout(s), ${data.plan.webs} web(s), ${fmt(data.plan.waste.wastePct)}% waste — review and save.`,
          "success",
        );
      } catch (err) {
        dsaShowError("AI Deckle Set could not be reached. Plan the layouts by hand — Add Deckle Layout, under Deckle Set.");
      } finally {
        dsaRun.disabled = false;
        dsaRun.innerHTML = label;
      }
    }

    dsaRun.addEventListener("click", dsaPlan);

    // The toggle governs the manual planner too, not just the next auto run:
    // with it on, the size table inside each layout picks that layout's web.
    // Turning it off drops every per-row width so the batch goes back to one.
    dsaMixed.addEventListener("change", () => {
      MIXED_WEBS = dsaMixed.checked;
      if (!MIXED_WEBS) layoutRows().forEach((tr) => { delete tr.dataset.size; });
      recalcAll();
    });
  }
  <% } %>

  // ---- init ----
  renderSizeChips();
  addLayoutRow();
</script>
