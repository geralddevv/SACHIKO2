  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever's actually on
  // screen, top to bottom, is renumbered 1..n every time the table redraws.
  table.on("renderComplete", function () {
    document.querySelectorAll("#master-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  // Event delegation for action buttons (avoids inline onclick with dynamic data)
  document.getElementById("master-table").addEventListener("click", function (e) {
    const btn = e.target.closest("[data-action]");
    if (!btn) return;
    const action = btn.getAttribute("data-action");
    if (action === "view") {
      const id = decodeURIComponent(btn.getAttribute("data-id") || "");
      viewPendingOrder(id);
    } else if (action === "confirm") {
      const url = decodeURIComponent(btn.getAttribute("data-url") || "");
      checkCreateOrder(url);
    } else if (action === "cancel") {
      const id = decodeURIComponent(btn.getAttribute("data-id") || "");
      requestCancel(id);
    } else if (action === "edit") {
      const url = decodeURIComponent(btn.getAttribute("data-url") || "");
      window.location.href = url;
    }
  });


  // Pre-compute grand total from all rows (never changes)
  const tableTotal = enrichedOrderData.reduce((sum, row) => sum + (Number(row.valueAmount) || 0), 0);
  const lsTotal = enrichedOrderData.reduce((sum, row) => sum + (row.onModel === "SachikoLabelStock" ? (Number(row.valueAmount) || 0) : 0), 0);
  const tapeTotal = enrichedOrderData.reduce((sum, row) => sum + (row.onModel === "Tape" ? (Number(row.valueAmount) || 0) : 0), 0);

  function formatINR(value) {
    return "₹" + value.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Set the static totals on load
  const tableTotalDisplay = document.getElementById("table-total-display");
  if (tableTotalDisplay) tableTotalDisplay.textContent = "Pending Items: " + formatINR(tableTotal);
  const lsDisplay = document.getElementById("ls-value-display");
  if (lsDisplay) lsDisplay.textContent = "LS: " + formatINR(lsTotal);
  const tapeDisplay = document.getElementById("tape-value-display");
  if (tapeDisplay) tapeDisplay.textContent = "Tape: " + formatINR(tapeTotal);
  const totalDisplay = document.getElementById("total-value-display");
  if (totalDisplay) totalDisplay.textContent = "Total: " + formatINR(tableTotal);

  // Update filtered value whenever filters change
  // dataFiltered passes (filters, rows) where rows = currently visible row components
  table.on("dataFiltered", function (filters, rows) {
    const filteredEl = document.getElementById("filtered-value-display");
    if (!filteredEl) return;

    // Show filtered badge if any filters are active
    const isFiltered = filters && filters.length > 0;

    if (!isFiltered) {
      filteredEl.style.display = "none";
      return;
    }

    let filteredTotal = 0;
    rows.forEach((row) => {
      const data = row.getData();
      filteredTotal += Number(data.valueAmount) || 0;
    });

    filteredEl.textContent = "Filtered: " + formatINR(filteredTotal);
    filteredEl.style.display = "inline-block";
  });

  // Dropdown toggle
  const selector = document.getElementById("downloadSelector");
  const trigger = selector.querySelector(".download-selector__trigger");
  trigger.addEventListener("click", (e) => {
    e.stopPropagation();
    selector.classList.toggle("download-selector--active");
  });
  document.addEventListener("click", () => selector.classList.remove("download-selector--active"));

  // Downloads
  document.getElementById("download-pdf").addEventListener("click", () => {
    table.download("pdf", "pending_orders.pdf", { orientation: "landscape", title: "Pending Orders" });
    selector.classList.remove("download-selector--active");
  });
  document.getElementById("download-xlsx").addEventListener("click", () => {
    table.download("xlsx", "pending_orders.xlsx", { sheetName: "PendingOrders" });
    selector.classList.remove("download-selector--active");
  });

  /* ================= IMPORT PAPER RE-ORDER (FAIRTECH export) ================= */
  const importModal = document.getElementById("importOrdersModal");
  const importMetaEl = document.getElementById("import-meta");
  const importLinesEl = document.getElementById("import-lines");
  const importFileInput = document.getElementById("import-orders-file");
  const importConfirmBtn = document.getElementById("import-orders-confirm");
  const importTotalEl = document.getElementById("import-total");
  const importTotalLinesEl = document.getElementById("import-total-lines");
  const importTotalRollsEl = document.getElementById("import-total-rolls");
  let importToken = "";

  const getCsrfToken = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || "";

  const esc = (val) =>
    String(val ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");

  const num = (n) => (n === null || n === undefined || n === "" ? "—" : Number(n).toLocaleString("en-IN"));

  // Stored as the DECKLE_FREE / DECKLE_SET enum (TapeSalesOrder.deckleOption);
  // the underscore is a code detail, not something to read. Case is left as
  // it is so it sits with the other uppercase facts in this panel.
  const deckleLabel = (v) => String(v || "").trim().replace(/_/g, " ") || "—";

  const closeImportModal = () => {
    importModal.classList.remove("show");
    importModal.setAttribute("aria-hidden", "true");
    importTotalEl.hidden = true;
    importToken = "";
  };

  // Confirm is enabled only while at least one line is ticked and every ticked
  // line has a rate -- the server enforces the same thing, this just stops the
  // round trip.
  const syncImportConfirm = () => {
    const rows = [...importLinesEl.querySelectorAll(".import-line[data-index]")];
    let ticked = 0;
    let rolls = 0;
    let allRated = true;
    rows.forEach((r) => {
      const on = Boolean(r.querySelector(".import-include")?.checked);
      const rated = Number(r.querySelector(".import-rate")?.value) > 0;
      // Mark the row that is actually blocking the submit -- a greyed-out
      // button on its own doesn't say which line still needs a rate.
      r.classList.toggle("needs-rate", on && !rated);
      if (!on) return;
      ticked++;
      rolls += Number(r.dataset.rolls) || 0;
      if (!rated) allRated = false;
    });
    importConfirmBtn.disabled = !(ticked && allRated);

    if (!rows.length) {
      importTotalEl.hidden = true;
      return;
    }
    importTotalLinesEl.innerHTML = `<b>${ticked}</b> of ${rows.length} line${rows.length === 1 ? "" : "s"} selected`;
    importTotalRollsEl.innerHTML = `<b>${num(rolls)}</b> roll${rolls === 1 ? "" : "s"} to order`;
    importTotalEl.hidden = false;
  };

  const renderImportPreview = (data) => {
    const o = data.order || {};
    importMetaEl.innerHTML = [
      `<span>Client: <b>${esc(o.clientName)}</b>${o.userName ? ` / ${esc(o.userName)}` : ""}</span>`,
      `<span>PO Number: <b>${esc(o.poNumber)}</b></span>`,
      `<span>PO Date: <b>${esc(o.poDate || "—")}</b></span>`,
      `<span>Est Delivery: <b>${esc(o.estimatedDate || "—")}</b></span>`,
      `<span>Deckle: <b>${esc(deckleLabel(o.deckleOption))}</b></span>`,
      `<span>From: <b>${esc(o.vendorName || "FAIRTECH")}</b>${o.exportedBy ? ` (${esc(o.exportedBy)})` : ""}</span>`,
      data.userCount > 1
        ? `<span class="wide" style="color:#92400e;">${data.userCount} users on this client — ordering under <b>${esc(o.userName)}</b>.</span>`
        : "",
      o.remarks ? `<span class="wide">Remarks: <b>${esc(o.remarks)}</b></span>` : "",
    ]
      .filter(Boolean)
      .join("");

    const rows = data.rows || [];
    importLinesEl.innerHTML = rows.length
      ? `<div class="import-lines-head"><span></span><span>Product</span><span class="num">Rolls</span><span class="num">Rate</span></div>` +
        rows
          .map((r, i) => {
            const cls = r.error ? "invalid" : r.duplicate ? "duplicate" : "";
            // An unorderable line can't be ticked at all; a duplicate can, but
            // starts off so a second upload of the same file is a no-op unless
            // it's deliberately re-ticked.
            const checked = !r.error && !r.duplicate ? " checked" : "";
            const note = r.error
              ? esc(r.error)
              : r.duplicate
              ? `Already on this PO — ${esc(r.rateSource)}`
              : esc(r.rateSource);
            const spec =
              `<b>${esc(r.productCode)}</b>` +
              (r.skuCode ? ` <span class="sku">${esc(r.skuCode)}</span>` : "") +
              ` · ${esc(r.family || "—")} · Size ${esc(r.paperSize)} · RM ${num(r.runningMeters)}`;
            return `<div class="import-line ${cls}" data-index="${i}" data-rolls="${Number(r.noOfRolls) || 0}">
              <input type="checkbox" class="import-include"${checked}${r.error ? " disabled" : ""} />
              <div>
                <div class="spec" title="${esc(r.productCode)} · ${esc(r.family)} · Size ${esc(r.paperSize)} · RM ${esc(r.runningMeters)}">${spec}</div>
                <div class="note" title="${note}">${note}</div>
              </div>
              <span class="rolls"><b>${num(r.noOfRolls)}</b></span>
              <span class="import-rate-wrap">
                <input type="number" class="import-rate" min="0" step="0.01" value="${r.rate === "" || r.rate == null ? "" : r.rate}" placeholder="—"${r.error ? " disabled" : ""} />
              </span>
            </div>`;
          })
          .join("")
      : `<div class="import-empty">That file has no lines.</div>`;

    importLinesEl.querySelectorAll(".import-include, .import-rate").forEach((el) => {
      el.addEventListener("input", syncImportConfirm);
      el.addEventListener("change", syncImportConfirm);
    });
    syncImportConfirm();
  };

  document.getElementById("import-orders-btn").addEventListener("click", () => importFileInput.click());
  document.getElementById("import-orders-cancel").addEventListener("click", closeImportModal);
  importModal.addEventListener("click", (e) => {
    if (e.target === importModal) closeImportModal();
  });

  importFileInput.addEventListener("change", async () => {
    const file = importFileInput.files?.[0];
    if (!file) return;
    const form = new FormData();
    form.append("file", file);
    try {
      // Multipart, so the CSRF token can't ride in the body — csurf reads it
      // off this header instead.
      const res = await fetch("/app/sales/pending/import/preview", {
        method: "POST",
        headers: { "x-csrf-token": getCsrfToken() },
        body: form,
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message || "Failed to read that file");
      importToken = data.token;
      renderImportPreview(data);
      importModal.classList.add("show");
      importModal.setAttribute("aria-hidden", "false");
    } catch (err) {
      showToast(err.message || "Failed to read that file", "error");
    } finally {
      // Cleared so picking the same file again still fires a change event.
      importFileInput.value = "";
    }
  });

  importConfirmBtn.addEventListener("click", async () => {
    const lines = [...importLinesEl.querySelectorAll(".import-line[data-index]")].map((r) => ({
      index: Number(r.dataset.index),
      include: Boolean(r.querySelector(".import-include")?.checked),
      rate: r.querySelector(".import-rate")?.value || "",
    }));

    const confirmLabelEl = importConfirmBtn.querySelector("span");
    importConfirmBtn.disabled = true;
    const label = confirmLabelEl.textContent;
    confirmLabelEl.textContent = "Creating…";
    try {
      const res = await fetch("/app/sales/pending/import/commit", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": getCsrfToken() },
        body: JSON.stringify({ token: importToken, lines }),
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message || "Failed to create the orders");
      closeImportModal();
      window.location.href = data.redirect || "/app/sales/pending";
    } catch (err) {
      showToast(err.message || "Failed to create the orders", "error");
      confirmLabelEl.textContent = label;
      syncImportConfirm();
    }
  });
</script>

