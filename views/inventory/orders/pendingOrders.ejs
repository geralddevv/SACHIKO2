<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<style>
  .order-highlight {
    padding: 0.3rem 0.85rem;
    border-radius: 0.35rem;
    font-weight: 600;
    font-size: 1.15rem;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.12);
    margin-left: 8px;
    display: inline-block;
  }
  .order-highlight.active {
    background-color: rgba(255, 255, 255, 0.18);
  }
  .order-highlight.filtered {
    background-color: rgba(16, 185, 129, 0.22);
    border-color: rgba(255, 255, 255, 0.65);
  }

  /* ---- Import button (header bar) ----
     The bar itself is #044a78, so a #044a78 button on it is invisible -- this
     read as a bare icon + label, indistinguishable from the plain "View Logs"
     link beside it. Solid white makes it the one action on this bar that
     writes anything. Padding is kept tight: the bar already carries a title,
     four value badges and two other controls, so there is no room to spend. */
  #import-orders-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 13px;
    border: none;
    border-radius: 6px;
    background: #ffffff;
    color: #044a78;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.18);
  }
  #import-orders-btn i { font-size: 13px; opacity: 0.9; }
  #import-orders-btn:hover { background: #f4f8fc; }
  #import-orders-btn:active { background: #e6eef7; }
  #import-orders-btn:focus-visible { outline: 2px solid #ffffff; outline-offset: 2px; }

  /* ---- Paper re-order import dialog ----
     Shows every line the uploaded file would create, with the rate it would
     be placed at, before anything is written. Lines that can't be ordered are
     tinted and can't be ticked; the rest stay editable, since a new paper size
     still needs a rate agreeing before it becomes an order. */
  #importOrdersModal .logout-dialog { width: min(860px, 96vw); }
  #importOrdersModal .logout-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  #importOrdersModal .logout-title i {
    font-size: 1.05rem;
    color: #044a78;
    background: rgba(4, 74, 120, 0.1);
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Auto-fit columns rather than a fixed two, so the PO header facts pack
     into the width available instead of leaving half a row empty. */
  #importOrdersModal .import-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 6px 18px;
    font-size: 12.5px;
    color: #4b5563;
    background: #f8fafc;
    border: 1px solid #e0e6f0;
    border-radius: 9px;
    padding: 10px 14px;
    margin-bottom: 12px;
  }
  #importOrdersModal .import-meta b { color: #1f2a44; }
  #importOrdersModal .import-meta .wide { grid-column: 1 / -1; }

  /* Sized to what a rate is, not stretched -- a two-digit figure has no
     business filling a third of the dialog (which is what the flex row this
     replaced did, wrapping the product text to three lines to pay for it). */
  #importOrdersModal input.import-rate {
    height: 32px;
    border: 1px solid #d5dceb;
    border-radius: 7px;
    background: #fff;
    color: #1f2a44;
    font-size: 13px;
    font-family: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  #importOrdersModal input.import-rate:hover { border-color: #b9c5db; }
  #importOrdersModal input.import-rate:focus {
    outline: none;
    border-color: #044a78;
    box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.14);
  }

  #importOrdersModal .import-lines {
    border: 1px solid #e0e6f0;
    border-radius: 10px;
    max-height: 330px;
    overflow-y: auto;
    background: #fff;
  }
  #importOrdersModal .import-lines::-webkit-scrollbar { width: 9px; }
  #importOrdersModal .import-lines::-webkit-scrollbar-thumb {
    background: #cbd5e1; border-radius: 9px; border: 2px solid #fff;
  }

  /* One template shared by the header and every line, so the figures sit
     under their own headings. The rate column is sized to what a rate
     actually is -- the flex row this replaced let the input stretch to a
     third of the dialog and wrapped the product text to three lines to pay
     for it. */
  #importOrdersModal .import-lines-head,
  #importOrdersModal .import-line {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) 70px 104px;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
  }
  #importOrdersModal .import-lines-head {
    position: sticky;
    top: 0;
    z-index: 1;
    background: #eef2f7;
    border-bottom: 1px solid #e0e6f0;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #044a78;
  }
  #importOrdersModal .import-line {
    font-size: 13px;
    border-bottom: 1px solid #f1f5f9;
  }
  #importOrdersModal .import-line:last-child { border-bottom: none; }
  #importOrdersModal .import-line.invalid { background: #fef2f2; }
  #importOrdersModal .import-line.duplicate { background: #fffbeb; }

  #importOrdersModal .import-line input[type="checkbox"] {
    width: 15px; height: 15px; margin: 0; cursor: pointer; accent-color: #044a78;
  }
  #importOrdersModal .import-line input[type="checkbox"]:disabled { cursor: not-allowed; }

  /* Product cell: one line of identity, one of provenance. Both clipped
     rather than wrapped so every row stays the same height. */
  #importOrdersModal .import-line .spec {
    color: #1f2a44;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #importOrdersModal .import-line .spec .sku { color: #94a3b8; font-size: 11px; }
  #importOrdersModal .import-line .note {
    font-size: 11px;
    color: #6b7280;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #importOrdersModal .import-line.invalid .spec,
  #importOrdersModal .import-line.invalid .note { color: #b91c1c; }

  #importOrdersModal .import-line .rolls {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: #4b5563;
  }
  #importOrdersModal .import-line .rolls b { color: #1f2a44; }
  #importOrdersModal .import-lines-head .num { text-align: right; }

  /* Rate: a rupee prefix sits inside the box so the number needs no label of
     its own, and the field is only as wide as a rate. */
  #importOrdersModal .import-rate-wrap {
    position: relative;
    display: block;
  }
  #importOrdersModal .import-rate-wrap::before {
    content: "₹";
    position: absolute;
    left: 9px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    color: #94a3b8;
    pointer-events: none;
  }
  #importOrdersModal input.import-rate {
    width: 100%;
    padding: 0 9px 0 21px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  /* Spinners steal width and nobody steps a rate by 1. */
  #importOrdersModal input.import-rate::-webkit-outer-spin-button,
  #importOrdersModal input.import-rate::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  #importOrdersModal input.import-rate { -moz-appearance: textfield; }
  #importOrdersModal input.import-rate:disabled {
    background: #f8fafc;
    color: #cbd5e1;
    cursor: not-allowed;
  }
  /* A ticked line with no rate is what blocks the submit -- say so on the
     field itself rather than only by grey-ing out the button. */
  #importOrdersModal .import-line.needs-rate input.import-rate {
    border-color: #dc2626;
    background: #fff5f5;
  }

  #importOrdersModal .import-empty {
    padding: 20px 12px;
    text-align: center;
    color: #94a3b8;
    font-style: italic;
    font-size: 13px;
  }

  #importOrdersModal .import-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
    padding: 8px 14px;
    border-radius: 8px;
    background: #f1f6fb;
    border: 1px solid #dce6f2;
    font-size: 12.5px;
    color: #4b5563;
  }
  #importOrdersModal .import-total b { color: #044a78; }
  /* display:flex above outranks the UA's [hidden] { display: none }, so the
     bar has to be hidden explicitly or it survives with stale totals. */
  #importOrdersModal .import-total[hidden] { display: none; }

  #importOrdersModal .logout-btn {
    font-size: 0.92rem;
    padding: 0.55rem 1.35rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  #importOrdersModal .logout-btn:hover:not(:disabled) { opacity: 0.88; }
  #importOrdersModal .logout-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  @media (max-width: 640px) {
    #importOrdersModal .import-lines-head,
    #importOrdersModal .import-line {
      grid-template-columns: 22px minmax(0, 1fr) 58px 88px;
      gap: 8px;
      padding: 7px 9px;
    }
  }
</style>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <div class="indi-head">
    <h1>
      Pending Orders
      <span id="table-total-display" class="order-highlight active">Pending Items: ₹0.00</span>
      <span id="filtered-value-display" class="order-highlight filtered" style="display: none">Filtered: ₹0.00</span>
    </h1>
    <div class="download-btns" style="display: flex; gap: 10px; align-items: center">
      <span id="ls-value-display" class="order-highlight">LS: ₹0.00</span>
      <span id="tape-value-display" class="order-highlight">Tape: ₹0.00</span>
      <span id="total-value-display" class="order-highlight active">Total: ₹0.00</span>
      <a
        href="/app/sales/order/logs"
        style="
          padding: 6px 14px;
          background: #044a78;
          color: white;
          border-radius: 6px;
          text-decoration: none;
          font-size: 14px;
          font-weight: 500;
          display: inline-flex;
          align-items: center;
          gap: 6px;
          transition: opacity 0.2s;
        "
        onmouseover="this.style.opacity = '0.85'"
        onmouseout="this.style.opacity = '1'"
      >
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>View Logs</span>
      </a>
      <button
        type="button"
        id="import-orders-btn"
        title="Upload a paper re-order file exported from FAIRTECH"
      >
        <i class="fa-solid fa-file-import"></i>
        <span>Import</span>
      </button>
      <input type="file" id="import-orders-file" accept="application/json,.json" style="display: none" />
      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span>
            <i class="fa-solid fa-file-arrow-down"></i>
            <span class="download-typo">Download</span>
          </span>
          <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
        </button>
        <div class="download-selector__menu" id="downloads">
          <span class="download-selector__option" id="download-pdf">
            <i class="fas fa-file-pdf download-selector__option-icon"></i>
            <span>PDF</span>
          </span>
          <span class="download-selector__option" id="download-xlsx">
            <i class="fas fa-file-excel download-selector__option-icon"></i>
            <span>Excel</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table" class="tabulator tabulator-modern"></div>
</div>

<div class="logout-modal" id="importOrdersModal" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="importOrdersTitle">
    <h2 class="logout-title" id="importOrdersTitle">
      <i class="fa-solid fa-file-import"></i>
      <span>Import Paper Re-Order</span>
    </h2>
    <div class="import-meta" id="import-meta"></div>
    <div class="import-lines" id="import-lines"></div>
    <div class="import-total" id="import-total" hidden>
      <span id="import-total-lines"></span>
      <span id="import-total-rolls"></span>
    </div>
    <div class="logout-actions">
      <button class="logout-btn" type="button" id="import-orders-cancel">Cancel</button>
      <button class="logout-btn primary" type="button" id="import-orders-confirm" disabled>
        <i class="fa-solid fa-check"></i>
        <span>Create Orders</span>
      </button>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script id="order-data" type="application/json">
  <%- safeJson(orders || []) %>
</script>
<script>
  /* Safe JSON injection */
  const orderData = JSON.parse(document.getElementById("order-data").textContent);
  const enrichedOrderData = orderData.map((row) => {
    const rate = Number(row.orderRate) || 0;
    const noOfRolls = Number(row.noOfRolls) || 0;

    let width = 0;
    let mtrs = 0;
    if (row.onModel === "Tape") {
      width = Number(row.tapeId?.tapeWidth) || 0;
      mtrs = Number(row.tapeId?.tapeMtrs) || 0;
    } else if (row.onModel === "SachikoLabelStock") {
      width = Number(row.paperSize) || 0;
      mtrs = Number(row.runningMeters) || 0;
    }

    const valueAmount = (width * mtrs / 1000 * noOfRolls * rate) || 0;

    return {
      ...row,
      valueAmount,
    };
  });

  /* Dialog references */
  let customDialog, dialogMessage, dialogYes, dialogNo, cancelReasonWrap, cancelReasonInput;
  let detailsDialog, detailsBody, detailsCloseBtn;
  let currentConfirmCallback = null;

  document.addEventListener("DOMContentLoaded", () => {
    customDialog = document.getElementById("custom-confirm-dialog");
    dialogMessage = document.getElementById("custom-dialog-message");
    dialogYes = document.getElementById("custom-dialog-yes");
    dialogNo = document.getElementById("custom-dialog-no");
    cancelReasonWrap = document.getElementById("cancel-reason-wrap");
    cancelReasonInput = document.getElementById("cancel-reason-input");
    detailsDialog = document.getElementById("pending-order-details-dialog");
    detailsBody = document.getElementById("pending-order-details-body");
    detailsCloseBtn = document.getElementById("pending-order-details-close");
    dialogYes.addEventListener("click", () => {
      // Validate reason if cancelling
      if (cancelReasonWrap.style.display !== "none") {
        if (!cancelReasonInput.value.trim()) {
          cancelReasonInput.style.borderColor = "#ef4444";
          cancelReasonInput.placeholder = "Please provide a reason...";
          cancelReasonInput.focus();
          return;
        }
      }
      if (currentConfirmCallback) currentConfirmCallback();
      closeCustomDialog();
    });

    dialogNo.addEventListener("click", closeCustomDialog);
    if (detailsCloseBtn) {
      detailsCloseBtn.addEventListener("click", closeOrderDetailsDialog);
    }
    if (detailsDialog) {
      detailsDialog.addEventListener("click", (event) => {
        if (event.target === detailsDialog) {
          closeOrderDetailsDialog();
        }
      });
    }

    // Enter key support for confirmation
    document.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && customDialog.style.display === "flex") {
        // Prevent triggering if typing in the textarea
        if (e.target !== cancelReasonInput) {
          e.preventDefault();
          dialogYes.click();
        }
      }
    });
  });

  function showCustomConfirm(message, onConfirm, showReason = false) {
    dialogMessage.textContent = message;
    currentConfirmCallback = onConfirm;
    cancelReasonWrap.style.display = showReason ? "block" : "none";
    cancelReasonInput.value = "";
    cancelReasonInput.style.borderColor = "#d1d5db";
    customDialog.style.display = "flex";

    // Auto-focus appropriate element
    setTimeout(() => {
      if (showReason) {
        cancelReasonInput.focus();
      } else {
        dialogYes.focus();
      }
    }, 10);
  }

  function closeCustomDialog() {
    customDialog.style.display = "none";
    currentConfirmCallback = null;
    cancelReasonInput.value = "";
  }

  // Treats null/undefined/empty-string as "no data" -> "-", but preserves a
  // legitimate 0 (e.g. a real rate or quantity of zero isn't "missing").
  function orDash(value) {
    return (value === null || value === undefined || value === "") ? "-" : value;
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function formatDate(value) {
    if (!value) return "-";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "-";
    return date.toLocaleDateString("en-IN", { year: "numeric", month: "short", day: "2-digit" });
  }

  function getItemType(row) {
    let itemType = "TAPE";
    if (row.onModel === "SachikoLabelStock") itemType = "LABEL_STOCK";
    return itemType;
  }

  function getItemName(row) {
    const tape = row.tapeId;
    if (!tape) return "-";
    if (row.onModel === "Tape") {
      if (tape.tapePaperCode) return tape.tapePaperCode;
      if (tape.tapeProductId) return String(tape.tapeProductId);
    }
    if (row.onModel === "SachikoLabelStock") {
      if (tape.productCode) return tape.productCode;
    }
    return "Unknown Item";
  }

  // GSM is only meaningful for Tape rows — shown as its own column, "-" when not applicable.
  function getItemGsm(row) {
    const tape = row.tapeId;
    if (!tape) return "";
    if (row.onModel === "Tape") return tape.tapeGsm ?? "";
    return "";
  }

  // ROLL or SHEET, off the Label Stock item spec (sachikoLabelStock.rollOrSheet).
  // Tape has no such distinction, so those rows show "-".
  function getRollOrSheet(row) {
    if (row.onModel !== "SachikoLabelStock") return "";
    return String(row.tapeId?.rollOrSheet || "").toUpperCase();
  }

  // Width/Mtrs -- broken out of getItemName() into their own table columns
  // instead of a combined string. Tape rows carry these on the item spec
  // (tapeId.tapeWidth/tapeMtrs); Label Stock orders collect the equivalent
  // paperSize/runningMeters directly on the order itself instead (see the
  // LABEL_STOCK branch of POST /sales/order/create), so fall back to those.
  function getItemWidth(row) {
    if (row.onModel === "Tape") return row.tapeId?.tapeWidth || "";
    if (row.onModel === "SachikoLabelStock") return row.paperSize || "";
    return "";
  }

  function getItemMtrs(row) {
    if (row.onModel === "Tape") return row.tapeId?.tapeMtrs || "";
    if (row.onModel === "SachikoLabelStock") return row.runningMeters || "";
    return "";
  }

  // Per-field Fairtech vs Client comparison for the item bound to this order —
  // mirrors the item's own /tape|ttr/compare/:id page (itemCompare.ejs)
  // field-for-field, minus the Vendor column (this page never shows vendor data).
  // Fairtech values come from the item spec (row.tapeId); Client values come
  // from the client binding (row.tapeBinding) where one exists, otherwise they
  // fall back to the same item spec value (no separate client-negotiated spec).
  function getCompareRows(row) {
    const item = row.tapeId || {};
    const binding = row.tapeBinding || {};

    if (row.onModel === "Tape") {
      return [
        { field: "Paper Code", orgValue: orDash(item.tapePaperCode), clientValue: orDash(binding.tapeClientPaperCode) },
        { field: "GSM", orgValue: orDash(item.tapeGsm), clientValue: orDash(binding.clientTapeGsm) },
        { field: "Paper Type", orgValue: orDash(item.tapePaperType), clientValue: orDash(item.tapePaperType) },
        { field: "Width", orgValue: orDash(item.tapeWidth), clientValue: orDash(item.tapeWidth) },
        { field: "Meters", orgValue: orDash(item.tapeMtrs), clientValue: orDash(item.tapeMtrs) },
        { field: "Core ID", orgValue: orDash(item.tapeCoreId), clientValue: orDash(item.tapeCoreId) },
        { field: "Finish", orgValue: orDash(item.tapeFinish), clientValue: orDash(item.tapeFinish) },
        { field: "Adhesive GSM", orgValue: orDash(item.tapeAdhesiveGsm), clientValue: orDash(item.tapeAdhesiveGsm) },
        { field: "Minimum Qty", orgValue: "-", clientValue: orDash(binding.tapeMinQty) },
        { field: "Order Qty", orgValue: "-", clientValue: orDash(binding.tapeOdrQty) },
        { field: "Order Frequency", orgValue: "-", clientValue: orDash(binding.tapeOdrFreq) },
        { field: "Credit Term", orgValue: "-", clientValue: orDash(binding.tapeCreditTerm) },
        { field: "Rate Per Roll", orgValue: "-", clientValue: orDash(binding.tapeRatePerRoll) },
        { field: "Sale Cost", orgValue: "-", clientValue: orDash(binding.tapeSaleCost) },
        { field: "Meters Delivered", orgValue: "-", clientValue: orDash(binding.tapeMtrsDel) },
        { field: "Binding Status", orgValue: "-", clientValue: orDash(binding.status) },
      ];
    }
    if (row.onModel === "SachikoLabelStock") {
      return [
        { field: "SKU Code", orgValue: orDash(item.skuCode), clientValue: orDash(item.skuCode) },
        { field: "Product Code", orgValue: orDash(item.productCode), clientValue: orDash(item.productCode) },
        { field: "Facestock Family", orgValue: orDash(item.facestock?.facestockFamily), clientValue: orDash(item.facestock?.facestockFamily) },
        { field: "Facestock Type", orgValue: orDash(item.facestock?.facestockType), clientValue: orDash(item.facestock?.facestockType) },
        { field: "Facestock GSM", orgValue: orDash(item.facestock?.facestockGsm), clientValue: orDash(item.facestock?.facestockGsm) },
        { field: "Facestock Micron", orgValue: orDash(item.facestock?.facestockMicron), clientValue: orDash(item.facestock?.facestockMicron) },
        { field: "Adhesive Type", orgValue: orDash(item.adhesive?.adhesiveType), clientValue: orDash(item.adhesive?.adhesiveType) },
        { field: "Adhesive GSM", orgValue: orDash(item.adhesive?.adhesiveGsm), clientValue: orDash(item.adhesive?.adhesiveGsm) },
        { field: "Release Liner Type", orgValue: orDash(item.releaseLiner?.releaseLinerType), clientValue: orDash(item.releaseLiner?.releaseLinerType) },
        { field: "Release Liner Color", orgValue: orDash(item.releaseLiner?.releaseLinerColor), clientValue: orDash(item.releaseLiner?.releaseLinerColor) },
        { field: "Release Liner GSM", orgValue: orDash(item.releaseLiner?.releaseLinerGsm), clientValue: orDash(item.releaseLiner?.releaseLinerGsm) },
        { field: "Location", orgValue: "-", clientValue: orDash(binding.location) },
        { field: "Binding Status", orgValue: "-", clientValue: orDash(binding.status) },
      ];
    }
    return [];
  }

  function closeOrderDetailsDialog() {
    if (detailsDialog) detailsDialog.style.display = "none";
  }

  window.viewPendingOrder = function (orderId) {
    const order = orderData.find((row) => String(row._id) === String(orderId));
    if (!order || !detailsDialog || !detailsBody) return;

    const itemType = getItemType(order);
    const itemName = getItemName(order);
    const client = order.userId?.clientName || "-";
    const user = order.userId?.userName || "-";
    const sourceLocation = order.sourceLocation || "-";
    const poNumber = order.poNumber || "-";
    const remarks = order.remarks || "-";
    const orderRate = orDash(order.orderRate);
    const quantity = Number(order.quantity) || 0;
    const dispatched = Number(order.dispatchedQuantity) || 0;
    const remaining = Math.max(quantity - dispatched, 0);

    detailsBody.innerHTML = `
      <div class="tape-details-card">
        <div class="details-scroll-area">
          <div class="tape-details-header">
            <div class="header-copy">
              <h1>${escapeHtml(itemName)}</h1>
              <div class="header-subtitle">${escapeHtml(client)} | ${escapeHtml(user)}</div>
