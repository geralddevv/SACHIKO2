<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }
    #core-master-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    .dialog-header {
      background: #044A78;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .dialog-header h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }
    .dialog-close-btn {
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      padding: 0 2px;
      opacity: 0.8;
      transition: opacity 0.15s;
    }
    .dialog-close-btn:hover {
      opacity: 1;
    }
    .dialog-body {
      padding: 24px;
    }
    .dialog-field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 8px;
    }
    .dialog-error {
      color: #ef4444;
      font-size: 12px;
      margin-top: 5px;
      display: none;
    }
    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }
    .dialog-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 16px;
    }

    /* Match Choices.js selects to the .premium-input look used by the rest
       of this dialog's fields. */
    .dialog-body .choices__inner {
      padding: 11px 14px !important;
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      background-color: #f8fafc !important;
      font-size: 14px !important;
      min-height: 0 !important;
      transition: all 0.2s ease !important;
    }
    .dialog-body .choices__list--single {
      padding: 0 !important;
    }
    .dialog-body .choices.is-focused .choices__inner,
    .dialog-body .choices.is-open .choices__inner {
      border-color: #044a78 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 4px rgba(4, 74, 120, 0.1) !important;
    }
    .dialog-body .choices[data-type*="select-one"]::after {
      display: block !important;
      content: "" !important;
      width: 12px !important;
      height: 8px !important;
      border-style: none !important;
      border-width: 0 !important;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
      background-repeat: no-repeat !important;
      background-size: contain !important;
      position: absolute !important;
      right: 14px !important;
      top: 50% !important;
      margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    .dialog-body .choices[data-type*="select-one"].is-open::after {
      transform: translateY(-50%) rotate(180deg) !important;
    }
    /* Dropdown list must render above the dialog overlay (see CLAUDE.md
       "Dialog / modal pattern" -- Choices.js in dialogs). */
    .dialog-body .choices__list--dropdown {
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      z-index: 99999 !important;
    }
  </style>

  <div class="indi-head">
    <h1>Core Master</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <button class="header-action-btn" onclick="openAddDialog()">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> Core
      </button>

      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span>
            <i class="fa-solid fa-file-arrow-down"></i>
            <span class="download-typo">Download</span>
          </span>
          <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
        </button>
        <div class="download-selector__menu" id="downloads">
          <span class="download-selector__option" id="download-pdf">
            <i class="fas fa-file-pdf download-selector__option-icon"></i>
            <span>PDF</span>
          </span>
          <span class="download-selector__option" id="download-xlsx">
            <i class="fas fa-file-excel download-selector__option-icon"></i>
            <span>Excel</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="core-master-table" class="tabulator tabulator-modern"></div>
</div>

<!-- ============ ADD CORE DIALOG ============ -->
<div class="logout-modal" id="addDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="addDialogTitle"
    style="width: min(460px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="addDialogTitle">Add Core</h2>
      <button class="dialog-close-btn" type="button" onclick="closeAddDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="addSkuIdPreview">SKU ID</label>
          <input type="text" id="addSkuIdPreview" class="form-control premium-input" readonly style="background: #f1f5f9;" />
        </div>
        <div>
          <label class="dialog-field-label" for="addTypeSelect">Type</label>
          <select id="addTypeSelect">
            <option value="" disabled selected hidden>Select type</option>
            <option value="PAPER">PAPER</option>
            <option value="PLASTIC">PLASTIC</option>
          </select>
        </div>
      </div>

      <label class="dialog-field-label" for="addMakeInput">Make</label>
      <input type="text" id="addMakeInput" class="form-control premium-input" placeholder="Enter make" style="margin-bottom: 16px;" />

      <label class="dialog-field-label" for="addVendorSelect">Vendor Name</label>
      <select id="addVendorSelect" style="margin-bottom: 16px;">
        <option value="" disabled selected hidden>Select vendor</option>
        <% vendors?.forEach(v => { %>
          <option value="<%= v._id %>"><%= v.vendorName %></option>
        <% }) %>
      </select>

      <div class="dialog-field-row" style="grid-template-columns: 1fr 1fr 1fr;">
        <div>
          <label class="dialog-field-label" for="addPrintTypeSelect">Print Type</label>
          <select id="addPrintTypeSelect">
            <option value="" disabled selected hidden>Select print type</option>
            <option value="PRINTED">PRINTED</option>
            <option value="PLAIN">PLAIN</option>
          </select>
        </div>
        <div>
          <label class="dialog-field-label" for="addThicknessInput">Thickness (mm)</label>
          <input type="number" id="addThicknessInput" class="form-control premium-input" placeholder="Enter thickness" min="0" step="any" />
        </div>
        <div>
          <label class="dialog-field-label" for="addWidthInput">Width (inch)</label>
          <input type="number" id="addWidthInput" class="form-control premium-input" placeholder="Enter width" min="0" step="any" />
        </div>
      </div>

      <div id="addCoreError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeAddDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="addSubmitBtn" onclick="submitAdd()">Save Core</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ EDIT CORE DIALOG ============ -->
<div class="logout-modal" id="editDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="editDialogTitle"
    style="width: min(460px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="editDialogTitle">Edit Core</h2>
      <button class="dialog-close-btn" type="button" onclick="closeEditDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="editSkuIdDisplay">SKU ID</label>
          <input type="text" id="editSkuIdDisplay" class="form-control premium-input" readonly style="background: #f1f5f9;" />
        </div>
        <div>
          <label class="dialog-field-label" for="editTypeSelect">Type</label>
          <select id="editTypeSelect">
            <option value="" disabled hidden>Select type</option>
            <option value="PAPER">PAPER</option>
            <option value="PLASTIC">PLASTIC</option>
          </select>
        </div>
      </div>

      <label class="dialog-field-label" for="editVendorSelect">Vendor Name</label>
      <select id="editVendorSelect" style="margin-bottom: 16px;">
        <option value="" disabled hidden>Select vendor</option>
        <% vendors?.forEach(v => { %>
          <option value="<%= v._id %>"><%= v.vendorName %></option>
        <% }) %>
      </select>

      <label class="dialog-field-label" for="editMakeInput">Make</label>
      <input type="text" id="editMakeInput" class="form-control premium-input" placeholder="Enter make" style="margin-bottom: 16px;" />

      <div class="dialog-field-row" style="grid-template-columns: 1fr 1fr 1fr;">
        <div>
          <label class="dialog-field-label" for="editPrintTypeSelect">Print Type</label>
          <select id="editPrintTypeSelect">
            <option value="" disabled hidden>Select print type</option>
            <option value="PRINTED">PRINTED</option>
            <option value="PLAIN">PLAIN</option>
          </select>
        </div>
        <div>
          <label class="dialog-field-label" for="editThicknessInput">Thickness (mm)</label>
          <input type="number" id="editThicknessInput" class="form-control premium-input" placeholder="Enter thickness" min="0" step="any" />
        </div>
        <div>
          <label class="dialog-field-label" for="editWidthInput">Width (inch)</label>
          <input type="number" id="editWidthInput" class="form-control premium-input" placeholder="Enter width" min="0" step="any" />
        </div>
      </div>

      <div id="editCoreError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeEditDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="editSubmitBtn" onclick="submitEdit()">Update Core</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ VIEW CORE DIALOG ============ -->
<div class="logout-modal" id="viewDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="viewDialogTitle"
    style="width: min(460px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="viewDialogTitle">Core Details</h2>
      <button class="dialog-close-btn" type="button" onclick="closeViewDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div id="viewBody"></div>
    </div>
  </div>
</div>

<!-- ============ DELETE CONFIRMATION DIALOG ============ -->
<div class="logout-modal" id="deleteDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteDialogTitle"
    style="width: min(400px, 95vw);">
    <h2 class="logout-title" id="deleteDialogTitle">
      <i class="fa-solid fa-triangle-exclamation" style="color: #ef4444; margin-right: 8px;"></i>Delete Core?
    </h2>
    <p class="logout-text">
      Are you sure you want to delete <strong id="deleteSkuId"></strong>? This action cannot be undone.
    </p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" onclick="closeDeleteDialog()">Cancel</button>
      <button
        class="logout-btn"
        type="button"
        id="deleteConfirmBtn"
        onclick="submitDelete()"
        style="background: #ef4444; color: #fff; border-color: #ef4444;">
        Yes, Delete
      </button>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.20/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script id="cores-data" type="application/json"><%- safeJson(cores) %></script>
<script id="preview-skuid-data" type="application/json"><%- safeJson(previewSkuId) %></script>
<script>
  const coresData = JSON.parse(document.getElementById("cores-data").textContent);
  let previewSkuId = JSON.parse(document.getElementById("preview-skuid-data").textContent);

  let addTypeChoices = null, addPrintTypeChoices = null, addVendorChoices = null;
  let editTypeChoices = null, editPrintTypeChoices = null, editVendorChoices = null;

  // ---- Table ----
  const table = new Tabulator("#core-master-table", {
    data: coresData,
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No core masters added yet.",
    columns: [
      {
        title: "Actions",
        width: 140,
        hozAlign: "center",
        headerSort: false,
        formatter: function (cell) {
          const row = cell.getRow().getData();
          const wrap = document.createElement("div");
          wrap.style.cssText = "display:flex; gap:5px; justify-content:center;";

          const viewBtn = document.createElement("button");
          viewBtn.className = "loc-btn";
          viewBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#044a78;";
          viewBtn.title = "View Core";
          viewBtn.innerHTML = '<i class="fa-solid fa-eye"></i>';
          viewBtn.addEventListener("click", () => openViewDialog(row));

          const editBtn = document.createElement("button");
          editBtn.className = "loc-btn";
          editBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#e67e22;";
          editBtn.title = "Edit Core";
          editBtn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
          editBtn.addEventListener("click", () => openEditDialog(row));

          const deleteBtn = document.createElement("button");
          deleteBtn.className = "loc-btn";
          deleteBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#d9534f;";
          deleteBtn.title = "Delete Core";
          deleteBtn.innerHTML = '<i class="fa-solid fa-trash"></i>';
          deleteBtn.addEventListener("click", () => openDeleteDialog(row._id, row.skuId));

          wrap.appendChild(viewBtn);
          wrap.appendChild(editBtn);
          wrap.appendChild(deleteBtn);
          return wrap;
        },
      },
      { title: "SKU ID", field: "skuId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 160 },
      { title: "Vendor Name", field: "vendorName", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150 },
      { title: "Type", field: "type", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110 },
      { title: "Make", field: "make", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130, formatter: (cell) => cell.getValue() || "—" },
      { title: "Print Type", field: "printType", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110 },
      { title: "Thickness (mm)", field: "thickness", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 120, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Width (inch)", field: "width", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 120, formatter: (cell) => cell.getValue() ?? "—" },
    ],
  });

  // ---- Download dropdown ----
  const downloadSelector = document.getElementById("downloadSelector");
  const downloadTrigger = downloadSelector.querySelector(".download-selector__trigger");
  downloadTrigger.addEventListener("click", (e) => {
    e.stopPropagation();
    downloadSelector.classList.toggle("download-selector--active");
  });
  document.addEventListener("click", () => downloadSelector.classList.remove("download-selector--active"));
  downloadSelector.querySelector(".download-selector__menu").addEventListener("click", (e) => e.stopPropagation());

  document.getElementById("download-pdf").addEventListener("click", () => {
    table.download("pdf", "core-master.pdf", { orientation: "landscape", title: "Core Master" });
    downloadSelector.classList.remove("download-selector--active");
  });
  document.getElementById("download-xlsx").addEventListener("click", () => {
    table.download("xlsx", "core-master.xlsx", { sheetName: "Core Master" });
    downloadSelector.classList.remove("download-selector--active");
  });

  // ---- Helpers ----
  function openModal(id) {
    const d = document.getElementById(id);
    d.classList.add("show");
    d.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const d = document.getElementById(id);
    d.classList.remove("show");
    d.setAttribute("aria-hidden", "true");
  }
  function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.style.display = "block";
  }
  function hideError(elId) {
    document.getElementById(elId).style.display = "none";
  }
  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.disabled = loading;
    btn.style.opacity = loading ? "0.7" : "";
  }

  function detailRow(label, value) {
    return `
      <div style="display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid #f1f5f9;">
        <span style="color:#64748b; font-size:13px;">${label}</span>
        <span style="color:#0f172a; font-weight:600; font-size:13px;">${value}</span>
      </div>
    `;
  }

  // ---- VIEW ----
  function openViewDialog(row) {
    document.getElementById("viewBody").innerHTML = [
      detailRow("SKU ID", row.skuId),
      detailRow("Vendor Name", row.vendorName || "—"),
      detailRow("Type", row.type || "—"),
      detailRow("Make", row.make || "—"),
      detailRow("Print Type", row.printType || "—"),
      detailRow("Thickness (mm)", row.thickness ?? "—"),
      detailRow("Width (inch)", row.width ?? "—"),
    ].join("");
    openModal("viewDialog");
  }
  function closeViewDialog() {
    closeModal("viewDialog");
  }

  ["addDialog", "editDialog", "viewDialog", "deleteDialog"].forEach(id => {
    document.getElementById(id).addEventListener("click", function (e) {
      if (e.target === this) closeModal(id);
    });
  });

  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    ["addDialog", "editDialog", "viewDialog", "deleteDialog"].forEach(id => {
      if (document.getElementById(id).classList.contains("show")) closeModal(id);
    });
  });

  // ---- ADD ----
  function openAddDialog() {
    document.getElementById("addSkuIdPreview").value = previewSkuId;
    document.getElementById("addMakeInput").value = "";
    document.getElementById("addThicknessInput").value = "";
    document.getElementById("addWidthInput").value = "";

    if (addTypeChoices) { addTypeChoices.destroy(); addTypeChoices = null; }
    document.getElementById("addTypeSelect").value = "";
    addTypeChoices = new Choices("#addTypeSelect", { searchEnabled: false, shouldSort: false, itemSelectText: "" });

    if (addPrintTypeChoices) { addPrintTypeChoices.destroy(); addPrintTypeChoices = null; }
    document.getElementById("addPrintTypeSelect").value = "";
    addPrintTypeChoices = new Choices("#addPrintTypeSelect", { searchEnabled: false, shouldSort: false, itemSelectText: "" });

    if (addVendorChoices) { addVendorChoices.destroy(); addVendorChoices = null; }
    document.getElementById("addVendorSelect").value = "";
    addVendorChoices = new Choices("#addVendorSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    hideError("addCoreError");
    openModal("addDialog");
  }
  function closeAddDialog() {
    closeModal("addDialog");
  }

  async function submitAdd() {
    const vendorId = document.getElementById("addVendorSelect").value;
    const type = document.getElementById("addTypeSelect").value;
    const printType = document.getElementById("addPrintTypeSelect").value;
    const thickness = document.getElementById("addThicknessInput").value;
    const width = document.getElementById("addWidthInput").value;
    if (!vendorId) return showError("addCoreError", "Vendor Name is required.");
    if (!type) return showError("addCoreError", "Type is required.");
    if (!printType) return showError("addCoreError", "Print Type is required.");
    if (!thickness) return showError("addCoreError", "Thickness is required.");
    if (!width) return showError("addCoreError", "Width is required.");

    hideError("addCoreError");
    setLoading("addSubmitBtn", true);
    try {
      const res = await fetch("/sachiko/form/core", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          vendorId,
          type,
          make: document.getElementById("addMakeInput").value.trim(),
          printType,
          thickness,
          width,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/sachiko/form/core";
      } else {
        showError("addCoreError", data.message || "Failed to add core.");
      }
    } catch {
      showError("addCoreError", "Server error. Please try again.");
    } finally {
      setLoading("addSubmitBtn", false);
    }
  }

  // ---- EDIT ----
  let editId = null;

  function openEditDialog(row) {
    editId = row._id;
    document.getElementById("editSkuIdDisplay").value = row.skuId;
    document.getElementById("editMakeInput").value = row.make || "";
    document.getElementById("editThicknessInput").value = row.thickness ?? "";
    document.getElementById("editWidthInput").value = row.width ?? "";

    if (editTypeChoices) { editTypeChoices.destroy(); editTypeChoices = null; }
    document.getElementById("editTypeSelect").value = row.type || "";
    editTypeChoices = new Choices("#editTypeSelect", { searchEnabled: false, shouldSort: false, itemSelectText: "" });

    if (editPrintTypeChoices) { editPrintTypeChoices.destroy(); editPrintTypeChoices = null; }
    document.getElementById("editPrintTypeSelect").value = row.printType || "";
    editPrintTypeChoices = new Choices("#editPrintTypeSelect", { searchEnabled: false, shouldSort: false, itemSelectText: "" });

    if (editVendorChoices) { editVendorChoices.destroy(); editVendorChoices = null; }
    document.getElementById("editVendorSelect").value = row.vendorId || "";
    editVendorChoices = new Choices("#editVendorSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    hideError("editCoreError");
    openModal("editDialog");
  }
  function closeEditDialog() {
    closeModal("editDialog");
    editId = null;
  }

  async function submitEdit() {
    const vendorId = document.getElementById("editVendorSelect").value;
    const type = document.getElementById("editTypeSelect").value;
    const printType = document.getElementById("editPrintTypeSelect").value;
    const thickness = document.getElementById("editThicknessInput").value;
    const width = document.getElementById("editWidthInput").value;
    if (!vendorId) return showError("editCoreError", "Vendor Name is required.");
    if (!type) return showError("editCoreError", "Type is required.");
    if (!printType) return showError("editCoreError", "Print Type is required.");
    if (!thickness) return showError("editCoreError", "Thickness is required.");
    if (!width) return showError("editCoreError", "Width is required.");
    if (!editId) return;

    hideError("editCoreError");
    setLoading("editSubmitBtn", true);
    try {
      const res = await fetch(`/sachiko/api/core/${editId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          vendorId,
          type,
          make: document.getElementById("editMakeInput").value.trim(),
          printType,
          thickness,
          width,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showError("editCoreError", data.message || "Failed to update core.");
      }
    } catch {
      showError("editCoreError", "Server error. Please try again.");
    } finally {
      setLoading("editSubmitBtn", false);
    }
  }

  // ---- DELETE ----
  let deleteId = null;

  function openDeleteDialog(id, skuId) {
    deleteId = id;
    document.getElementById("deleteSkuId").textContent = skuId;
    openModal("deleteDialog");
  }
  function closeDeleteDialog() {
    closeModal("deleteDialog");
    deleteId = null;
  }

  async function submitDelete() {
    if (!deleteId) return;
    setLoading("deleteConfirmBtn", true);
    try {
      const res = await fetch(`/sachiko/api/core/${deleteId}`, { method: "DELETE" });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        closeDeleteDialog();
        alert(data.message || "Failed to delete core.");
      }
    } catch {
      closeDeleteDialog();
      alert("Error deleting core.");
    } finally {
      setLoading("deleteConfirmBtn", false);
    }
  }
</script>
