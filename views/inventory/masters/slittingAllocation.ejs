<% layout('/layout/boilerplate') %>

<%
  // Stage 1 of slitting, Deckle-scoped: the planner fixes one or more
  // Deckles' jobs before they reach the floor -- one shared machine,
  // operator and helper, and per cut layout its own A..L knife widths and a
  // "Deckle Rolls" count of how many of the ticked Deckles share it (below,
  // one row per layout rather than one row per Deckle -- Deckles bound for
  // the identical layout collapse into one row instead of repeating the same
  // widths over and over). Nothing moves in stock here; once saved, each
  // Deckle in a layout's count gets its own card, sitting on the machine's
  // queue for the operator to work on /sachiko/slitting/jobcard/:cardId.
  const isEmpty = (v) => v === undefined || v === null || (typeof v === "string" && v.trim() === "");
  const dash = (v) => (isEmpty(v) ? "—" : v);
  // Log columns that are not roll-width slots: #, Siderun, R. Meter,
  // Deckle Rolls, and the trailing remove-layout action. The web strip
  // spans the lot.
  const fixedCols = 5;
  const existingTargets = targetDeckles.filter((d) => d.existing);
  const curingTargets = targetDeckles.filter((d) => d.curing && d.curing.cured === false);
  // Each Deckle's own curing window (CHROMO 6 h, PP 8 h) -- "6" or "6 / 8".
  const curingHours = [...new Set(curingTargets.map((d) => Number(d.curing.hours)).filter((h) => h > 0))]
    .sort((a, b) => a - b)
    .join(" / ");
  // Every Deckle of this order's Product Code + Size, in stock right now --
  // the ones being allocated here (targetDeckles) plus the rest left
  // unticked on the Slitting Queue (groupDeckles, "Other Deckles in this
  // batch" below). Total is that whole pool; Available is what is left of it
  // once this allocation is saved.
  const deckleGroup = typeof groupDeckles !== "undefined" ? groupDeckles : [];
  const deckleTotal = targetDeckles.length + deckleGroup.length;
  const deckleAvailable = deckleGroup.length;
%>

<style>
  .span-full { padding: 0 !important; }
  .span-full.form-heading, .span-full.form-subheading { padding: 10px !important; }
  input.sl-qty.sl-qty-over,
  input.sl-qty.sl-qty-over:focus {
    border-color: #dc2626 !important; outline: none !important;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.3) !important;
  }
  .sl-panel { align-self: stretch; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .sl-sec-head { display: flex; flex-direction: row; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 10px; }
  .sl-sec-head h1 { margin: 0; }
  .sl-head-chip {
    background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.3); color: #fff;
    font-size: 12.5px; font-weight: 700; padding: 3px 11px; border-radius: 999px; white-space: nowrap;
  }
  .sl-mini-btn {
    display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.55);
    background: transparent; color: #fff; border-radius: 6px; padding: 5px 11px;
    font-size: 12.5px; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .sl-mini-btn:hover { background: rgba(255,255,255,0.14); }

  /* grid-auto-flow: column with a fixed row (rather than auto-fit wrapping)
     keeps every cell -- Product Code through Helper -- on one single row.
     grid-auto-columns: minmax(0, 1fr) (rather than a fixed min-width) lets
     every column shrink evenly to whatever the panel actually has, so all
     ten cells always fit on one row with no horizontal scrollbar; overflow-x
     stays on only as a safety net, never meant to trigger. The partition
     between columns is each cell's own border-right (dropped on the last
     cell), not a grid gap -- a gap's "background peeking through" trick
     washes out once cells sit flush against a scrolling container's edge. */
  .sl-job-grid {
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); grid-template-rows: 1fr;
    overflow-x: auto;
  }
  .sl-job-cell {
    background: #f8fafc; padding: 11px 10px; display: flex; flex-direction: column; gap: 5px; min-width: 0;
    border-right: 1px solid #e2e8f0;
  }
  .sl-job-cell:last-child { border-right: none; }
  .sl-job-cell.is-input { background: #fff; }
  .sl-job-cell.is-wide { grid-column: span 2; }
  .sl-job-label {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #7c8ba1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sl-job-label .req { color: #dc2626; }
  .sl-job-value {
    font-size: 20px; font-weight: 900; color: #1f2a44; line-height: 1.25;
    overflow-wrap: anywhere; font-variant-numeric: tabular-nums;
  }
  .sl-job-value.sl-bad { color: #b91c1c; }
  .sl-job-cell select.form-control {
    height: 34px !important; font-size: 13px !important; width: 100%;
    padding: 4px 24px 4px 8px !important; border-radius: 6px !important; border: 1px solid #cbd5e1 !important;
    background-position: right 7px center; background-size: 10px 7px;
  }
  .sl-job-cell select.form-control:focus { outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .sl-job-cell input.form-control {
    height: 34px !important; font-size: 13px !important; width: 100%;
    padding: 4px 8px !important; border-radius: 6px !important; border: 1px solid #cbd5e1 !important;
  }
  .sl-job-cell input.form-control:focus { outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .sl-job-cell input[type="number"]::-webkit-outer-spin-button,
  .sl-job-cell input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .sl-job-cell input[type="number"] { -moz-appearance: textfield; }

  .sl-table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; }
  .sl-table th {
    background: #044a78; color: #fff; font-size: 11.5px; font-weight: 600; padding: 7px 5px;
    text-align: center; letter-spacing: 0.02em; border-right: 1px solid rgba(255,255,255,0.22); white-space: nowrap;
  }
  .sl-table th:last-child { border-right: none; }
  .sl-table th.sl-sub-head { background: #055690; font-size: 11px; font-weight: 500; padding: 5px; }
  .sl-table td {
    padding: 5px; border-bottom: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;
    vertical-align: middle; text-align: center; background: #fff;
  }
  .sl-table td:last-child { border-right: none; }
  .sl-table input.form-control, .sl-table select.form-control {
    padding: 4px 6px !important; font-size: 12.5px !important; height: 30px !important;
    min-width: 0; width: 100%; text-align: center; border-radius: 6px !important;
    font-variant-numeric: tabular-nums; border: 1px solid #cbd5e1 !important; background-color: #fff;
    transition: border-color 0.15s, box-shadow 0.15s, background-color 0.15s;
  }
  .sl-table input.form-control:focus, .sl-table select.form-control:focus {
    outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.12);
  }
  /* The global `select` rule paints a dropdown arrow at `right 1rem`; without
     room reserved for it the option text runs underneath. */
  .sl-table select.form-control {
    text-align: left; padding: 4px 24px 4px 8px !important;
    background-position: right 7px center; background-size: 10px 7px;
  }
  .sl-table input[type="number"]::-webkit-outer-spin-button,
  .sl-table input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .sl-table input[type="number"] { -moz-appearance: textfield; }
  .sl-table td.sl-derived {
    font-size: 12.5px; font-weight: 800; color: #1f2a44; background: #f8fafc;
    white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .sl-table td.sl-derived.sl-bad { color: #b91c1c; background: #fef2f2; }
  .sl-table tbody tr:hover > td { background: #fbfdff; }
  .sl-table tbody tr:hover > td.sl-derived { background: #f2f7fc; }

  .sl-view-table td {
    font-size: 13px; font-weight: 700; color: #1f2a44; font-variant-numeric: tabular-nums;
    background: #f8fafc;
  }
  .sl-view-table tbody tr:hover > td { background: #f8fafc; }

  .sl-scroll { align-self: stretch; overflow-x: auto; }
  .sl-scroll::-webkit-scrollbar { height: 9px; }
  .sl-scroll::-webkit-scrollbar-thumb { background: #044a78; border-radius: 8px; }
  .sl-log-table { table-layout: fixed; min-width: 730px; }
  .sl-log-no-num { font-size: 12.5px; font-weight: 800; color: #1f2a44; }
  .sl-width-input.is-set { border-color: #044a78 !important; background-color: #f4f9ff !important; font-weight: 700; }
  .sl-width-remaining { font-size: 17px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .sl-width-remaining.sl-bad { color: #b91c1c; }

  .sl-row-btn {
    width: 26px; height: 26px; padding: 0; border: 1px solid #e2e8f0; background: #fff;
    color: #b91c1c; border-radius: 5px; font-size: 11.5px; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .sl-row-btn:hover { background: #fef2f2; border-color: #fecaca; }
  .sl-row-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .sl-row-btn:disabled:hover { background: #fff; border-color: #e2e8f0; }

  .sl-layout-toolbar {
    display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;
  }
  .sl-assign-status { font-size: 12.5px; font-weight: 700; color: #7c8ba1; }
  .sl-assign-status.is-ok { color: #15803d; }
  .sl-assign-status.is-bad { color: #b91c1c; }
  .sl-add-layout-btn {
    display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid #044a78; background: #fff;
    color: #044a78; border-radius: 7px; padding: 7px 14px; font-size: 12.5px; font-weight: 700; cursor: pointer;
  }
  .sl-add-layout-btn:hover { background: #f0f7ff; }
  .sl-add-layout-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .sl-add-layout-btn:disabled:hover { background: #fff; }

  /* Web view: A..L drawn to scale across the reel's web. Segments are sized
     by flex-grow, so they stay proportional at any table width. A layout
     wider than the web is drawn against the roll-width total instead (there
     is no room left to draw) and flagged red. */
  .sl-sub-cell {
    background: #f8fafc !important; padding: 8px 10px 10px !important;
    text-align: left !important; border-bottom: 2px solid #e2e8f0 !important;
  }
  .sl-table tbody tr:hover > td.sl-sub-cell { background: #f8fafc !important; }
  /* The drawing is a proportional diagram, not a data grid: stretched to the
     full width its segments are far wider than they need to be to read, so it
     is capped and centred, caption included. */
  .sl-web-caption {
    display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;
    max-width: 960px; margin: 0 auto 5px;
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #7c8ba1;
  }
  .sl-web-flag { text-transform: none; letter-spacing: 0; font-size: 11px; font-weight: 700; }
  .sl-web-flag.sl-bad { color: #b91c1c; }
  .sl-web-flag.sl-ok { color: #15803d; }
  .sl-web {
    display: flex; align-items: stretch; height: 32px; width: 100%; max-width: 960px; margin: 0 auto;
    border: 1px solid #cbd5e1; border-radius: 7px; overflow: hidden; background: #fff;
  }
  .sl-web.is-over { border-color: #ef4444; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.15); }
  /* Web view color key: cut rolls (the actual finished-roll widths) green,
     the fixed edge trim orange, and the uncut wastage left over inside the
     web (width - sum of cuts) red -- three different things, three different
     colors, so a glance at the strip alone says where every mm went. */
  .sl-web-seg {
    flex-basis: 0; min-width: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 1px;
    border-right: 1px solid #fff; overflow: hidden; white-space: nowrap;
    background: #16a34a; color: #fff;
  }
  .sl-web-seg:nth-child(even) { background: #15803d; }
  .sl-web-seg:last-child { border-right: none; }
  .sl-web-seg .sl-seg-slot { font-size: 9px; font-weight: 700; opacity: 0.8; letter-spacing: 0.06em; }
  .sl-web-seg .sl-seg-w { font-size: 11.5px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .sl-web-seg.sl-web-edge { background: #f97316; color: #fff; }
  .sl-web-seg.sl-web-trim { background: #dc2626; color: #fff; }
  .sl-web-empty {
    display: flex; align-items: center; justify-content: center; width: 100%;
    font-size: 11.5px; font-weight: 600; color: #94a3b8;
    background: repeating-linear-gradient(45deg, #f1f5f9, #f1f5f9 6px, #f8fafc 6px, #f8fafc 12px);
  }

  /* ---- Locked layout panel -------------------------------------------
     The Set Deckle plan's own summary table, reused verbatim so a layout
     reads identically on the page that fixed it and the page that cuts to it
     (views/inventory/orders/deckleSetForm.ejs .dsf-web-table). */
  .dsf-web-table { width: 100%; border-collapse: separate; border-spacing: 0;
    background: #fff; border: 1.5px solid #e6eaf2; border-radius: 10px; overflow: hidden; }
  .dsf-web-table th {
    background: #044a78; color: #fff; font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; padding: 6px 10px; text-align: left; white-space: nowrap;
  }
  .dsf-web-table td { padding: 8px 10px; border-top: 1px solid #eef1f6; vertical-align: middle; }
  /* Column separators, same rule the top header's cells use -- without them
     Deckle Size / Siderun / Across / Deckle Count run together as one line of
     big numbers. */
  .dsf-web-table th, .dsf-web-table td { border-right: 1px solid #e2e8f0; }
  .dsf-web-table th { border-right-color: rgba(255, 255, 255, 0.22); }
  .dsf-web-table th:last-child, .dsf-web-table td:last-child { border-right: none; }
  .dsf-web-size, .dsf-web-rem, .dsf-web-dc, .dsf-web-across .flag {
    font-size: 22px; font-weight: 800; font-variant-numeric: tabular-nums;
  }
  .dsf-web-size { width: 120px; color: #044a78; white-space: nowrap; text-align: center; }
  .dsf-web-rem { width: 104px; text-align: center; color: #dc2626; white-space: nowrap; }
  .dsf-web-rem.sl-bad { color: #b91c1c; }
  .dsf-web-across { width: 130px; }
  .dsf-web-across .flag { color: #475569; }
  .dsf-web-across .flag.sl-bad { color: #b91c1c; }
  .dsf-web-across .flag.sl-ok { color: #15803d; }
  .dsf-web-dc { width: 96px; text-align: center; color: #1f2a44; }
  .dsf-web-diag { min-width: 0; text-align: center; }
  .dsf-web-diag .sl-web { margin: 0 auto; max-width: 880px; width: 100%; height: 36px; }
  /* Diagram segments show the width number only -- no A/B/C / EDGE / TRIM label. */
  .dsf-web-diag .sl-seg-slot { display: none; }
  .dsf-web-diag .sl-web-seg .sl-seg-w { font-size: 13px; }
  /* `.span-full` is display:flex (common.css), which beats the `hidden`
     attribute's UA display:none -- without this both panels would show. */
  #slLockedPanel[hidden], #slEditablePanel[hidden] { display: none !important; }
  /* "Deckles Needed" reads short when fewer Deckles are ticked in than the
     layout still wants -- the run will not finish the job. */
  .sl-job-value.sl-short { color: #b45309; }
  .sl-job-of { font-size: 0.62em; font-weight: 700; color: #94a3b8; }
  .sl-warn-note {
    align-self: stretch; background: #fff8e1; border: 1px solid #f0c36d; color: #7a5b00;
    border-radius: 8px; padding: 10px 14px; font-size: 12.5px; font-weight: 600; line-height: 1.5;
  }
  .sl-done-note {
    align-self: stretch; background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46;
    border-radius: 8px; padding: 10px 14px; font-size: 12.5px; font-weight: 600; line-height: 1.5;
  }
  /* The submit button draws its own border; the shared .btn-grp container
     (common.css) boxes it in a second one, which here just reads as an empty
     frame around a single button. Only the top edge is kept, as a rule
     separating the form above from the action below. Scoped to this page --
     .btn-grp is used across the app. */
  .sl-save-grp {
    border: none !important;
    border-top: 1px solid #b8c4d4 !important;
    border-radius: 0 !important;
    padding: 16px 0 0 !important;
  }
  .sl-save-wrap { display: flex; flex-direction: column; align-items: center; gap: 7px; width: 100%; }
  #slSubmitBtn:disabled { opacity: 0.55; cursor: not-allowed; }
  #slSubmitBtn:disabled:hover { transform: none; box-shadow: none; }

  @media screen and (max-width: 768px) {
    .sl-job-cell { padding: 9px 6px; }
    .sl-job-label { font-size: 9.5px; }
    .sl-job-value { font-size: 16px; }
  }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px">
  <form id="slForm" autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="span-full form-heading" style="display:flex; flex-direction:row; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
      <h1>Slitting Allocation</h1>
      <span class="sl-head-chip">
        <% if (targetDeckles.length === 1) { %><%= typeof previewCardId !== "undefined" && previewCardId ? previewCardId : "" %>
        <% } else { %><%= targetDeckles.length %> Deckles<% } %>
      </span>
    </div>

    <!-- The order facts are read-only (they belong to the sales order); the
         machine, operator and helper are what this page is allocating. -->
    <div class="span-full" style="border:none !important;">
      <div class="sl-panel">
        <div class="sl-job-grid">
          <div class="sl-job-cell">
            <span class="sl-job-label">Product Code</span>
            <span class="sl-job-value"><%= dash(order.productCode) %></span>
          </div>
          <div class="sl-job-cell">
            <span class="sl-job-label">Size</span>
            <%# Every targetDeckle here was clubbed on the Slitting Queue by
                Product Code + Size + Running Meters (see "Other Deckles in
                this batch" note below), so they all share one size -- same
                as it reads targetDeckles[0].size there. %>
            <span class="sl-job-value"><%= dash(targetDeckles[0].size) %>mm</span>
          </div>
          <div class="sl-job-cell">
            <span class="sl-job-label">Running Meters</span>
            <%# The length wound onto each finished roll for this order --
                same field the Slitting Queue's clubbing (and this page's
                own group of Deckles below) already keys on alongside
                Product Code + Size. %>
            <span class="sl-job-value"><%= order.runningMeters != null ? `${order.runningMeters} mtrs` : "—" %></span>
          </div>
          <div class="sl-job-cell">
            <span class="sl-job-label">Selected Deckles</span>
            <span class="sl-job-value"><%= targetDeckles.length %></span>
          </div>
          <% if (typeof layoutNeed !== "undefined" && layoutNeed) {
               const stillNeeded = Math.max(0, layoutNeed - (layoutAllocated || 0)); %>
          <div class="sl-job-cell">
            <span class="sl-job-label">Deckles Needed</span>
            <%# What the planner's layout calls for, as opposed to "Total
                Deckles" / "Available" above, which are the webs in stock.
                Shown as "still needed of planned" once some are already on
                another card, so allocating fewer than the layout wants is
                visible here rather than only showing up as a short run
                later. %>
            <span class="sl-job-value<%= targetDeckles.length < stillNeeded ? " sl-short" : "" %>"
                  title="This layout calls for <%= layoutNeed %> Deckle web(s)<%= layoutAllocated ? ` — ${layoutAllocated} already on another slitting card, ${stillNeeded} still to allocate` : "" %>. <%= targetDeckles.length %> ticked in here.">
              <%= stillNeeded %><% if (layoutAllocated) { %><span class="sl-job-of"> of <%= layoutNeed %></span><% } %>
            </span>
          </div>
          <% } %>
          <%# Total edge trim netted out of the web width before cutting (split
              evenly across both edges) when defaulting a fresh layout row's
              width -- 10 mm by default.

              With the layout locked it is not an input at all: the cuts were
              fitted inside the trim the planner set on the Deckle Set plan, so
              changing it here could only make a layout that fits read as over
              the web. It stays in the DOM as a hidden field because the width
              maths reads its value (TOTAL_TRIM_MM). Editable otherwise -- for
              stock no deckle config claims, this is the only place to set it. %>
          <% if (typeof layoutLocked !== "undefined" && layoutLocked) { %>
          <div class="sl-job-cell">
            <span class="sl-job-label">Trim (mm)</span>
            <span class="sl-job-value" title="Total edge trim (both sides), set with the deckle layout on the Deckle Set plan."><%= typeof defaultTrim !== 'undefined' ? defaultTrim : 10 %></span>
            <input type="hidden" id="slTrim" value="<%= typeof defaultTrim !== 'undefined' ? defaultTrim : 10 %>" />
          </div>
          <% } else { %>
          <div class="sl-job-cell is-input">
            <span class="sl-job-label">Trim (mm)</span>
            <input type="number" id="slTrim" class="form-control" value="<%= typeof defaultTrim !== 'undefined' ? defaultTrim : 10 %>" min="0" step="any"
                   title="Total edge trim (both sides) netted out of the web width for new layouts. Default 10 mm." />
          </div>
          <% } %>
          <div class="sl-job-cell is-input">
            <span class="sl-job-label">Machine <span class="req">*</span></span>
            <%# Only slitting machines are offered (routes/system/slitting.js
                filters on machineType), so the type is not worth repeating on
                every option -- the location still is. %>
            <select id="slMachine" class="form-control">
              <option value="" disabled <%= crew.machineId ? "" : "selected" %> hidden>
                <%= machines.length ? "Select machine" : "No slitting machine set up" %>
              </option>
              <% machines.forEach((m) => { %>
                <option value="<%= m._id %>" data-operator-key="<%= m.operatorKey %>" <%= crew.machineId === m._id ? "selected" : "" %>><%= m.machineName %><%= m.locationName ? " · " + m.locationName : "" %></option>
              <% }) %>
            </select>
          </div>
          <div class="sl-job-cell is-input">
            <span class="sl-job-label">Operator <span class="req">*</span></span>
            <select id="slOperator" class="form-control">
              <option value="" disabled <%= crew.operatorId ? "" : "selected" %> hidden>Select operator</option>
              <% operators.forEach((e) => { %>
                <option value="<%= e._id %>" data-machine-key="<%= e.machineKey %>" <%= crew.operatorId === e._id ? "selected" : "" %>><%= e.empNickName || e.empName %></option>
              <% }) %>
            </select>
          </div>
          <div class="sl-job-cell is-input">
            <span class="sl-job-label">Helper</span>
            <select id="slHelper" class="form-control">
              <option value="">— none —</option>
              <% helpers.forEach((e) => { %>
                <option value="<%= e._id %>" <%= crew.helperId === e._id ? "selected" : "" %>><%= e.empNickName || e.empName %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- The Deckles this page is actually allocating -- what was ticked on
         the Slitting Queue's Choose Deckle dialog (or a single Deckle's own
         Allocate/Edit link). Shown for a single Deckle too, so the
         bar and the Add Deckles bar are always there; Remove needs two or more
         (the last one can't be taken off). -->
    <% if (targetDeckles.length > 0) { %>
    <div class="span-full" style="border:none !important;">
      <style>
        .sl-sel-panel > summary {
          list-style: none; cursor: pointer; display: flex; align-items: center; gap: 10px; padding: 11px 16px;
          background: linear-gradient(135deg, #e8f2fb 0%, #dbeafe 100%); color: #044a78;
          font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; user-select: none;
        }
        .sl-sel-panel > summary::-webkit-details-marker { display: none; }
        .sl-sel-panel > summary:hover { background: linear-gradient(135deg, #dcebf8 0%, #cfe0f5 100%); }
        .sl-sel-count { background: #044a78; color: #fff; border-radius: 999px; padding: 2px 10px; font-size: 12px; letter-spacing: 0; }
        .sl-sel-chev { margin-left: auto; font-size: 11px; transition: transform .2s ease; }
        .sl-sel-panel[open] > summary .sl-sel-chev { transform: rotate(180deg); }
        .sl-sel-panel[open] > summary { border-bottom: 1px solid #cfe0f5; }
        .sl-sel-cell { padding: 0 26px; border-left: 1px solid #cfe0f5; color: #475569; font-weight: 600; white-space: nowrap; }
        .sl-sel-cure { font-weight: 700; }
        .sl-sel-cure.is-cured { color: #15803d; }
        .sl-sel-cure.is-curing { color: #b45309; }
        .sl-sel-remove {
          display: inline-flex; align-items: center; gap: 5px; border: 1px solid #fecaca; background: #fff;
          color: #b91c1c; border-radius: 999px; padding: 2px 10px; font-size: 11px; font-weight: 700; cursor: pointer;
          transition: background .15s ease;
        }
        .sl-sel-remove:hover { background: #fef2f2; }
      </style>
      <details class="sl-panel sl-sel-panel">
        <summary>
          <i class="fa-solid fa-layer-group"></i> Selected Deckles
          <span class="sl-sel-count"><%= targetDeckles.length %></span>
          <i class="fa-solid fa-chevron-down sl-sel-chev"></i>
        </summary>
        <div style="padding: 12px 14px;">
        <div style="display:flex;flex-direction:column;gap:6px;">
          <% targetDeckles.forEach((d, idx) => { %>
            <div style="display:flex;align-items:center;flex-wrap:wrap;gap:10px;padding:8px 12px;border:1.5px solid #cfe0f5;background:#f7fbff;border-radius:8px;font-size:12.5px;">
              <span style="flex:none;width:22px;height:22px;border-radius:50%;background:#dbeafe;color:#044a78;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;"><%= idx + 1 %></span>
              <span style="font-weight:700;color:#044a78;min-width:150px;"><%= dash(d.rollId) %></span>
              <span class="sl-sel-cell"><%= dash(d.reelMtrs) %> mtrs</span>
              <span class="sl-sel-cell sl-sel-made" data-created="<%= d.createdAt ? new Date(d.createdAt).toISOString() : "" %>">—</span>
              <span class="sl-sel-cell sl-sel-cure" data-hotmelt="<%= d.curing && d.curing.hotMelt ? 1 : 0 %>" data-cured="<%= d.curing && d.curing.cured === false ? 0 : 1 %>" data-cured-at="<%= d.curing && d.curing.curedAt ? d.curing.curedAt : "" %>">—</span>
              <% if (d.existing) { %>
                <span style="font-size:10.5px;font-weight:700;color:#044a78;background:#e0ecf8;border-radius:999px;padding:2px 9px;">on <%= d.existing.slittingJobCardId %></span>
              <% } %>
              <span style="margin-left:auto;display:flex;align-items:center;gap:8px;">
                <% if (targetDeckles.length > 1) { %>
                <button type="button" class="sl-sel-remove" data-deckle-id="<%= d._id %>" title="Remove this Deckle from the allocation" aria-label="Remove <%= dash(d.rollId) %>">
                  <i class="fa-solid fa-xmark"></i> Remove
                </button>
                <% } %>
              </span>
            </div>
          <% }) %>
        </div>
        </div>
      </details>
    </div>
    <% } %>

    <!-- Deckles clubbed with these on the Slitting Queue (same Product Code
         + Size) but left unticked there -- context only, never edited from
         this page. One bar saying how many are free; clicking it opens them
         in a dialog. The ones being allocated here are never in that list. -->
    <% if (typeof groupDeckles !== "undefined" && groupDeckles.length > 0) { %>
    <style>
      .sl-avail-bar {
        width: 100%; display: flex; align-items: center; gap: 10px; padding: 11px 16px; cursor: pointer;
        background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 13px; color: #334155; text-align: left;
        transition: border-color .15s ease, background .15s ease;
      }
      .sl-avail-bar:hover { border-color: #a9c8e8; background: #f7fbff; }
      .sl-avail-count {
        flex: none; min-width: 28px; text-align: center; font-weight: 800; font-size: 13px; color: #fff;
        background: #044a78; border-radius: 999px; padding: 2px 10px;
      }
      .sl-avail-bar .sl-avail-go { margin-left: auto; color: #044a78; font-weight: 700; font-size: 12px; white-space: nowrap; }

    .sq-dialog {
      width: min(810px, 95vw); max-height: min(720px, 90vh); padding: 0; border: none;
      border-radius: 16px; overflow: hidden; background: #fff; display: flex; flex-direction: column;
      box-shadow: 0 24px 60px rgba(4, 74, 120, 0.28);
      transform: scale(0.96); transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    #chooseDeckleDialog.show .sq-dialog { transform: scale(1); }
    .sq-dialog-header {
      flex: none; background: linear-gradient(135deg, #044a78 0%, #03365a 100%); padding: 14px 24px;
      display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
    }
    .sq-dialog-header h2 { margin: 0; font-size: 17px; font-weight: 700; color: #fff; letter-spacing: 0.2px; }
    .sq-dialog-subtitle { margin: 4px 0 0; font-size: 12.5px; color: rgba(255, 255, 255, 0.75); }
    .sq-close-btn {
      flex: none; border: none; background: rgba(255, 255, 255, 0.14); color: #fff;
      width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-size: 13px;
      display: flex; align-items: center; justify-content: center; transition: background 0.15s ease;
    }
    .sq-close-btn:hover { background: rgba(255, 255, 255, 0.26); }
    #sq-dialog-form { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    .sq-dialog-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 14px 24px; }
    /* Same brand-blue scrollbar as the tables (tableDisp.css). */
    .sq-dialog-body::-webkit-scrollbar { width: 10px; height: 10px; }
    .sq-dialog-body::-webkit-scrollbar-track { background: #f0f2f5; }
    .sq-dialog-body::-webkit-scrollbar-thumb { background: #044A78; border-radius: 6px; }
    .sq-dialog-body::-webkit-scrollbar-thumb:hover { background: #044A78; }
    .sq-dialog-body { scrollbar-width: thin; scrollbar-color: #044A78 #f0f2f5; }

    .sq-section-label {
      font-size: 11px; font-weight: 700; color: #044a78; text-transform: uppercase;
      letter-spacing: 0.4px; margin-bottom: 8px;
    }

    .sq-deckle-list { display: flex; flex-direction: column; gap: 5px; margin-bottom: 4px; }
    .sq-deckle-row {
      display: flex; align-items: center; gap: 12px; padding: 6px 12px 6px 14px;
      border-radius: 999px; border: 1.5px solid #e6eaf2; cursor: pointer;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .sq-deckle-row:hover { border-color: #a9c8e8; background: #f7fbff; }
    .sq-deckle-row.is-off { background: #fafbfd; }
    .sq-deckle-row.is-off .sq-deckle-top { color: #64748b; }
    .sq-deckle-no {
      flex: none; width: 22px; height: 22px; border-radius: 50%; background: #eef3f9; color: #044a78;
      font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center;
    }
    .sq-deckle-head { display: flex; gap: 12px; padding: 0 13.5px 0 15.5px; font-size: 10px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.4px; }
    .sq-deckle-head-pad { flex: none; width: 16px; margin-right: 34px; }
    .sq-deckle-head .sq-deckle-line { flex: 1 1 auto; }
    .sq-deckle-head .sq-deckle-top { font-size: 10px; font-weight: 700; color: #94a3b8; }
    .sq-deckle-line { display: flex; align-items: center; gap: 0; }
    .sq-deckle-line .sq-deckle-top { flex: 1 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sq-fact-value { flex: none; font-size: 12.5px; font-weight: 600; color: #475569; white-space: nowrap; }
    .sq-fact-mtrs, .sq-fact-date, .sq-fact-cure { flex: none; box-sizing: content-box; padding: 3px 14px; border-left: 1px solid #dbe3ec; text-align: center; }
    .sq-deckle-head .sq-fact-mtrs, .sq-deckle-head .sq-fact-date, .sq-deckle-head .sq-fact-cure { border-left-color: transparent; }
    .sq-fact-mtrs { width: 92px; }
    .sq-fact-date { width: 128px; color: #64748b; }
    .sq-fact-cure { width: 104px; font-weight: 700; }
    .sq-fact-value.is-cured { color: #15803d; }
    .sq-fact-value.is-curing { color: #b45309; }
    .sq-deckle-note { font-size: 12px; margin-top: 5px; padding-top: 5px; border-top: 1px solid #e2e8f0; }
    .sq-deckle-row:has(.sq-deckle-note) { border-radius: 22px; }
    .sq-deckle-row.is-disabled { opacity: 0.5; cursor: not-allowed; }
    .sq-deckle-row input[type="checkbox"] { flex: none; width: 16px; height: 16px; accent-color: #044a78; }
    /* "2 of 2 needed" beside the picker heading -- green on the mark, amber
       under it, red over it. */
    .sq-deckle-count {
      float: right; font-size: 11.5px; font-weight: 700; letter-spacing: 0;
      text-transform: none; padding: 1px 9px; border-radius: 999px;
      border: 1px solid #dbe3ec; background: #f8fafc; color: #5b6b80;
    }
    .sq-deckle-count-head { float: none; flex: none; margin: 2px 8px 0 auto; font-size: 12px; padding: 3px 12px; white-space: nowrap; }
    .sq-deckle-count.is-ok { color: #15803d; background: #ecfdf5; border-color: #a7f3d0; }
    .sq-deckle-count.is-under { color: #b45309; background: #fff8e1; border-color: #f0c36d; }
    .sq-deckle-count.is-over { color: #b91c1c; background: #fef2f2; border-color: #fecaca; }
    .sq-deckle-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .sq-deckle-top { font-weight: 700; color: #1f2a44; font-size: 13.5px; }
    .sq-deckle-sub { color: #64748b; font-size: 12px; }
    .sq-deckle-curing {
      flex: none; font-size: 10.5px; font-weight: 700; color: #b45309; background: #fffaf0;
      border: 1px solid #fde8c9; border-radius: 999px; padding: 2px 9px;
    }
    .sq-error-text { color: #dc2626; font-size: 12px; font-weight: 600; min-height: 16px; margin-top: 6px; }

    .sq-dialog-footer {
      flex: none; display: flex; justify-content: flex-end; gap: 10px;
      padding: 12px 24px; border-top: 1px solid #e6eaf2; background: #fafbfd;
    }
    .sq-btn {
      border: none; border-radius: 9px; padding: 11px 20px; font-size: 14px; font-weight: 700; cursor: pointer;
      transition: opacity 0.18s ease; display: inline-flex; align-items: center; gap: 8px;
    }
    .sq-btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .sq-btn-ghost { background: #eef1f5; color: #475569; }
    .sq-btn-ghost:hover { background: #e2e6ec; }
    .sq-btn-primary { background: linear-gradient(135deg, #044a78 0%, #03365a 100%); color: #fff; }
    .sq-btn-primary:hover { opacity: 0.92; }
    </style>
    <div class="span-full" style="border:none !important;">
      <button type="button" class="sl-avail-bar" id="otherDecklesBtn" aria-haspopup="dialog">
        <% const freeCount = groupDeckles.filter((d) => d.selectable).length; %>
        <span class="sl-avail-count"><%= freeCount %></span>
        <span>more <strong><%= dash(order.productCode) %></strong> &middot; <%= dash(targetDeckles[0].size) %>mm Deckle<%= freeCount === 1 ? "" : "s" %> available<% if (groupDeckles.length > freeCount) { %> &middot; <%= groupDeckles.length - freeCount %> on other cards<% } %></span>
        <span class="sl-avail-go">Add Deckles <i class="fa-solid fa-chevron-right"></i></span>
      </button>
    </div>

    <!-- Same dialog as the Slitting Queue's Choose Deckles (slittingQueue.ejs),
         listing only the Deckles NOT already on this page. -->
    <div class="logout-modal" id="chooseDeckleDialog" aria-hidden="true">
      <div class="sq-dialog" role="dialog" aria-modal="true" aria-labelledby="chooseDeckleDialogTitle">
        <div class="sq-dialog-header">
          <div>
            <h2 id="chooseDeckleDialogTitle">Choose Deckles</h2>
            <p class="sq-dialog-subtitle"><%= dash(order.productCode) %> &middot; <%= dash(targetDeckles[0].size) %>mm &middot; <%= order.runningMeters != null ? `${order.runningMeters} mtrs` : "no running meters set" %> &middot; <%= groupDeckles.length %> Deckle<%= groupDeckles.length === 1 ? "" : "s" %></p>
          </div>
          <span id="sq-deckle-count" class="sq-deckle-count sq-deckle-count-head"></span>
          <button type="button" class="sq-close-btn" id="sq-close-btn" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div id="sq-dialog-form">
          <div class="sq-dialog-body">
            <div id="sq-deckle-list" class="sq-deckle-list"></div>
            <div id="sq-deckle-error" class="sq-error-text"></div>
          </div>
          <div class="sq-dialog-footer">
            <button type="button" class="sq-btn sq-btn-ghost" id="sq-cancel-btn">Cancel</button>
            <button type="button" class="sq-btn sq-btn-primary" id="sq-submit-btn">Add to allocation <i class="fa-solid fa-arrow-right-long"></i></button>
          </div>
        </div>
      </div>
    </div>
    <script id="sl-group-deckles" type="application/json"><%- safeJson(groupDeckles) %></script>
    <script>
      (function () {
        const dlg = document.getElementById("chooseDeckleDialog");
        const list = document.getElementById("sq-deckle-list");
        const errEl = document.getElementById("sq-deckle-error");
        const countEl = document.getElementById("sq-deckle-count");
        const DECKLES = JSON.parse(document.getElementById("sl-group-deckles").textContent);
        const esc = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        const fmtMtrs = (v) => (Number.isFinite(Number(v)) ? Number(v).toLocaleString("en-IN", { maximumFractionDigits: 2 }) : "—");
        const fmtDate = (v) => { const d = v ? new Date(v) : null; return d && !isNaN(d) ? d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "2-digit" }) : "—"; };
        const fmtTime = (v) => { const d = v ? new Date(v) : null; return d && !isNaN(d) ? d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", hour12: true }) : "—"; };
        function curingTimeLeft(iso) {
          if (!iso) return "";
          const ms = Date.parse(iso) - Date.now();
          if (!Number.isFinite(ms) || ms <= 0) return "";
          const mins = Math.ceil(ms / 60000);
          if (mins < 60) return `${mins}m`;
          const h = Math.floor(mins / 60), m = mins % 60;
          return m ? `${h}h ${m}m` : `${h}h`;
        }
        const checked = () => [...list.querySelectorAll('input[type="checkbox"]:checked')];

        function renderCount() {
          const n = checked().length;
          countEl.className = "sq-deckle-count sq-deckle-count-head" + (n ? " is-ok" : "");
          countEl.textContent = n ? `${n} Deckle${n === 1 ? "" : "s"} ticked` : "None ticked";
        }

        list.innerHTML = `<div class="sq-deckle-head"><span class="sq-deckle-head-pad"></span>`
          + `<span class="sq-deckle-line"><span class="sq-deckle-top">Deckle ID</span>`
          + `<span class="sq-fact-mtrs">Running Mtrs</span><span class="sq-fact-date">Made on</span><span class="sq-fact-cure">Curing</span></span></div>`
          + DECKLES.map((d, i) => {
            const curingLeft = curingTimeLeft(d.curingUntil);
            const disabled = !d.selectable;
            const curing = d.curing && d.curing.cured === false;
            const curingCls = d.hotMelt ? "is-cured" : (curing ? "is-curing" : "is-cured");
            const curingTxt = d.hotMelt ? "Hot melt" : curing ? `Curing${curingLeft ? ` · ${esc(curingLeft)} left` : ""}` : "Cured";
            const held = d.card;
            return `
        <label class="sq-deckle-row${disabled ? " is-disabled" : ""} is-off">
          <input type="checkbox" value="${esc(d._id)}" ${disabled ? "disabled" : ""} />
          <span class="sq-deckle-no">${i + 1}</span>
          <span class="sq-deckle-main">
            <span class="sq-deckle-line">
              <span class="sq-deckle-top" title="${esc(d.rollId)}">${esc(d.rollId)}</span>
              <span class="sq-fact-value sq-fact-mtrs">${fmtMtrs(d.reelMtrs)} mtrs</span>
              <span class="sq-fact-value sq-fact-date">${fmtDate(d.createdAt)}, ${fmtTime(d.createdAt)}</span>
              <span class="sq-fact-value sq-fact-cure ${curingCls}">${curingTxt}</span>
            </span>
            ${held ? `<span class="sq-deckle-note" style="color:#b45309;"><i class="fa-solid fa-lock"></i> Already on ${esc(held.slittingJobCardId)}${held.machineName && held.machineName !== "—" ? ` (${esc(held.machineName)})` : ""} — not run yet. Shown for reference; it can't be picked until that card is run.</span>` : (disabled ? `<span class="sq-deckle-note" style="color:#64748b;">Not linked to any pending order.</span>` : "")}
          </span>
        </label>`;
          }).join("");

        list.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
          cb.addEventListener("change", () => {
            cb.closest(".sq-deckle-row").classList.toggle("is-off", !cb.checked);
            if (checked().length) errEl.textContent = "";
            renderCount();
          });
        });
        renderCount();

        const open = () => { dlg.classList.add("show"); dlg.setAttribute("aria-hidden", "false"); };
        const close = () => { dlg.classList.remove("show"); dlg.setAttribute("aria-hidden", "true"); };
        document.getElementById("otherDecklesBtn").addEventListener("click", open);
        document.getElementById("sq-close-btn").addEventListener("click", close);
        document.getElementById("sq-cancel-btn").addEventListener("click", close);
        dlg.addEventListener("click", (e) => { if (e.target === dlg) close(); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && dlg.classList.contains("show")) close(); });

        // Same page, same layout, plus the extra Deckles -- everything already
        // in the URL (current Deckles, ?layout=) is kept.
        document.getElementById("sq-submit-btn").addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const picked = checked();
          if (!picked.length) { errEl.textContent = "Tick at least one Deckle to add."; return; }
          const params = new URLSearchParams(window.location.search);
          const have = new Set(params.getAll("deckle"));
          picked.filter((b) => !have.has(b.value)).forEach((b) => params.append("deckle", b.value));
          // Adding Deckles reloads the page; keep what has been filled in so the
          // layout, crew and trim are not lost (restored at the end of the page script).
          if (typeof window.slSaveFormState === "function") window.slSaveFormState();
          window.location.href = window.location.pathname + "?" + params.toString();
        });
      })();
    </script>
    <% } %>

    <% if (!machines.length) { %>
    <div class="span-full" style="border:none !important;">
      <div class="sl-warn-note">
        <i class="fa-solid fa-triangle-exclamation"></i>
        No machine is set up as a slitter yet. Add one on the Machine Master with its
        Machine Type set to SLITTING, then come back — this job cannot be allocated without one.
      </div>
    </div>
    <% } %>

    <% if (curingTargets.length) { %>
    <div class="span-full" style="border:none !important;">
      <div class="sl-warn-note">
        <i class="fa-solid fa-hourglass-half"></i>
        <% if (curingTargets.length === 1) { %>
          Deckle <strong><%= dash(curingTargets[0].rollId) %></strong> is still curing<%= curingTargets[0].curing.curedAtLabel ? ` — the adhesive is ready at ${curingTargets[0].curing.curedAtLabel}` : "" %><% if (curingHours) { %> (<%= curingHours %>&nbsp;h after lamination)<% } %>.
          You can allocate it now, but the operator won't be able to run it on the machine until curing is over.
        <% } else { %>
          <%= curingTargets.length %> of these Deckles are still curing<% if (curingHours) { %> (<%= curingHours %>&nbsp;h after lamination)<% } %>: <strong><%= curingTargets.map((d) => d.rollId).join(", ") %></strong>.
          You can allocate them now, but the operator won't be able to run them on the machine until curing is over.
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (existingTargets.length) { %>
    <div class="span-full" style="border:none !important;">
      <div class="sl-warn-note">
        <i class="fa-solid fa-pen"></i>
        <% if (existingTargets.length === 1) { %>
          Deckle <strong><%= dash(existingTargets[0].rollId) %></strong> is already allocated on
          <strong><%= existingTargets[0].existing.slittingJobCardId %></strong>. Saving updates that same card in place —
          it keeps its place on the machine queue.
        <% } else { %>
          <%= existingTargets.length %> of these Deckles are already allocated: <strong><%= existingTargets.map((d) => `${d.rollId} on ${d.existing.slittingJobCardId}`).join(", ") %></strong>.
          Saving updates those cards in place — they keep their place on the machine queue.
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- One row per cut layout, not per Deckle -- Deckles that will be cut
         to the identical A..L roll widths share one row, with "Deckle Rolls"
         saying how many of the ticked Deckles it covers. Saving expands each
         layout row back out into one SlittingJobCard per Deckle it covers,
         all sharing that row's widths. -->
    <div class="span-full form-subheading sl-sec-head">
      <h1><%= targetDeckles.length === 1 ? "Deckle Layout" : "Deckle Layouts" %></h1>
    </div>
    <!-- Read-only view, used when the Slitting Queue opened this page for a
         layout the planner already fixed on Set Deckle (layoutLocked). Same
         "Deckle Size | Siderun | Across | Deckle Count | Layout" table that
         page shows under its own Deckle Layout heading
         (views/inventory/orders/deckleSetForm.ejs WEB_TABLE_HEAD), minus its
         "Use" picker -- there is nothing to pick here, the layout is settled.
         The editable table below still exists, hidden, and is what recalc()
         and Save read: this panel only changes what the planner can touch. -->
    <div class="span-full" id="slLockedPanel" hidden style="border:none !important;">
      <table class="dsf-web-table">
        <thead>
          <tr>
            <th style="width:120px;">Deckle Size</th>
            <th style="width:104px;">Siderun</th>
            <th style="width:130px;">Across</th>
            <th style="width:96px;">Deckle Count</th>
            <th>Layout</th>
          </tr>
        </thead>
        <tbody id="slLockedBody"></tbody>
      </table>
    </div>

    <div class="span-full" id="slEditablePanel" style="border:none !important;">
      <div class="sl-panel sl-scroll">
        <table class="sl-table sl-log-table">
          <colgroup>
            <col style="width:40px" />
            <col style="width:78px" />
            <% cutSlots.forEach(() => { %><col style="width:54px" /><% }) %>
            <col style="width:82px" /><col style="width:90px" /><col style="width:40px" />
          </colgroup>
          <thead>
            <tr>
              <th rowspan="2" style="vertical-align:middle;">#</th>
              <th rowspan="2" style="vertical-align:middle;">Siderun</th>
              <th colspan="<%= cutSlots.length %>">Roll Widths (mm)</th>
              <th rowspan="2" style="vertical-align:middle;">R. Meter</th>
              <th rowspan="2" style="vertical-align:middle;">Deckle Rolls</th>
              <th rowspan="2" style="vertical-align:middle;"></th>
            </tr>
            <tr>
              <% cutSlots.forEach((slot) => { %><th class="sl-sub-head"><%= slot %></th><% }) %>
            </tr>
          </thead>
          <tbody id="slLogBody"></tbody>
        </table>
      </div>
      <div class="sl-layout-toolbar" style="padding: 10px 14px;">
        <span id="slAssignStatus" class="sl-assign-status"></span>
        <button type="button" id="slAddLayoutBtn" class="sl-add-layout-btn">
          <i class="fa-solid fa-plus"></i> Add Layout
        </button>
      </div>
    </div>

    <div class="span-full btn-grp sl-save-grp" style="margin-top: 10px;">
      <div class="sl-save-wrap">
        <button type="submit" id="slSubmitBtn" class="submit-btn">
          <%= existingTargets.length && existingTargets.length === targetDeckles.length ? "Update Allocation" : "Allocate to Machine" %>
        </button>
      </div>
    </div>
  </form>
</div>

<script id="sl-target-data" type="application/json"><%- safeJson(targetDeckles) %></script>
<script id="sl-order-data" type="application/json"><%- safeJson(order) %></script>
<script id="sl-batch-layout" type="application/json"><%- safeJson(typeof batchLayout !== "undefined" ? batchLayout : null) %></script>
<script id="sl-slots-data" type="application/json"><%- safeJson(cutSlots) %></script>
<script id="sl-config-data" type="application/json"><%- safeJson({ pendingId: order._id, submissionToken, fixedCols, layoutLocked: !!(typeof layoutLocked !== "undefined" && layoutLocked), layoutNeed: typeof layoutNeed !== "undefined" ? layoutNeed : null, layoutAllocated: typeof layoutAllocated !== "undefined" ? layoutAllocated : 0 }) %></script>

<script>
  const TARGETS = JSON.parse(document.getElementById("sl-target-data").textContent);
  const ORDER = JSON.parse(document.getElementById("sl-order-data").textContent);
  // The Set Deckle page's stored deckle layouts for this batch (array of
  // { cuts:{A:..}, width, plannedRunningMeter, count }), or []. `width` is the
  // deckle web that layout was planned for -- see BATCH_LAYOUT_FOR_WEB below.
  // safeJson turns null into {}, so normalise defensively.
  const _batchLayoutRaw = JSON.parse(document.getElementById("sl-batch-layout").textContent);
  const BATCH_LAYOUT = (Array.isArray(_batchLayoutRaw) ? _batchLayoutRaw : [])
    .filter((L) => L && L.cuts && Object.keys(L.cuts).length);
  const SLOTS = JSON.parse(document.getElementById("sl-slots-data").textContent);
  const CONFIG = JSON.parse(document.getElementById("sl-config-data").textContent);
  const SUB_COLSPAN = CONFIG.fixedCols + SLOTS.length;
  // Total Deckles in this batch (this page's ticked Deckles + the rest left
  // unticked on the Slitting Queue -- see routes/system/slitting.js). The
  // top grid's "Available" cell starts as Total minus every ticked Deckle
  // (all auto-assigned to a layout on load), then recalc() keeps it live as
  // "Deckle Rolls" counts change below.
  const BATCH_TOTAL = <%= deckleTotal %>;

  const num = (v) => { const s = String(v ?? "").trim(); if (s === "") return null; const n = Number(s); return Number.isFinite(n) ? n : null; };
  const round2 = (n) => Math.round(n * 100) / 100;
  const fmt = (n) => (Number.isFinite(n) ? round2(n).toLocaleString("en-IN") : "—");
  const esc = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  // A Deckle's stored web size is free text ("650", '26"'), so read the
  // leading number off it and leave the field blank when there isn't one.
  const sizeToWidth = (size) => { const m = /-?\d+(\.\d+)?/.exec(String(size ?? "")); return m ? Number(m[0]) : null; };

  // ---- Group the ticked Deckles by layout, not one row each --------------
  // Deckles already sharing an identical saved layout (or none yet, on a
  // fresh allocation) collapse into one row, so the planner is never asked
  // to retype the same A..L widths once per Deckle. SEQUENCED reorders
  // TARGETS so Deckles sharing a layout sit together -- the row built for
  // each group is filled from this exact same order when Save expands
  // "Deckle Rolls" counts back out into one entry per Deckle
  // (expandLayoutsToRows()), so the two must never drift apart.
  function presetSignature(t) {
    if (!t.existing) return "";
    const row = t.existing.row;
    const cutsKey = Object.entries(row.cuts || {})
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([k, v]) => `${k}:${v}`).join(",");
    return `${row.width ?? ""}|${row.plannedRunningMeter ?? ""}|${cutsKey}`;
  }
  const layoutGroups = new Map();
  TARGETS.forEach((t) => {
    const sig = presetSignature(t);
    if (!layoutGroups.has(sig)) layoutGroups.set(sig, []);
    layoutGroups.get(sig).push(t);
  });
  const SEQUENCED = [...layoutGroups.values()].flat();
  // Every target here was clubbed on the Slitting Queue by Product Code +
  // Size, so they all share one web width. The floor trims a bit off each
  // edge before cutting -- 10 mm total (5 mm/side) by default, editable via
  // the Trim field above -- reserved out of the default cuttable width here
  // so a fresh layout's "Remaining" and over-the-web check are correct
  // without the planner having to remember to leave it out themselves. Only
  // the default: a preset from an existing card (below) still wins with its
  // own saved width, edge trim included or not.
  const trimInput = document.getElementById("slTrim");
  const rawWebWidth = sizeToWidth(TARGETS[0]?.size);
  let TOTAL_TRIM_MM = num(trimInput.value) ?? 10;
  let EDGE_TRIM_MM = TOTAL_TRIM_MM / 2;
  let GROUP_WIDTH = rawWebWidth !== null ? round2(rawWebWidth - TOTAL_TRIM_MM) : null;

  function renumber(rowSel, cellSel) {
    document.querySelectorAll(rowSel).forEach((row, i) => {
      const cell = row.querySelector(cellSel);
      if (cell) cell.textContent = String(i + 1);
    });
  }

  // ---- One layout row ------------------------------------------------------
  // "Deckle Rolls" (qty) says how many Deckles this row's widths apply to --
  // not which specific ones. Which physical Deckle each unit of qty resolves
  // to is only decided at Save time (expandLayoutsToRows()), by walking
  // SEQUENCED in the same order the rows were built from.
  function addLayoutRow(qty, preset) {
    const tr = document.createElement("tr");
    tr.className = "sl-log-row";
    tr.innerHTML = `
      <td class="sl-derived sl-log-no">
        <span class="sl-log-no-num"></span>
      </td>
      <td class="sl-derived sl-width-cell" title="Siderun -- the cuttable web width still unallocated. Already nets out the default 5 mm edge trim on each side (10 mm total), and counts down further as roll widths (A–L) are entered">
        <input type="hidden" class="sl-width" />
        <span class="sl-width-remaining">—</span>
      </td>
      ${SLOTS.map((s) => `<td><input type="number" step="any" min="0" inputmode="decimal" class="form-control sl-roll-width sl-width-input" data-slot="${s}" placeholder="${s}" title="Roll ${s} width in mm" /></td>`).join("")}
      <td><input type="number" step="any" min="0" inputmode="decimal" class="form-control sl-rm" placeholder="Mtrs" /></td>
      <td><input type="text" inputmode="numeric" maxlength="4" autocomplete="off" class="form-control sl-qty" placeholder="Qty" title="How many Deckles use this same roll-width layout" /></td>
      <td style="background:#fff;">
        <button type="button" class="sl-row-btn sl-remove-layout" title="Remove this layout" aria-label="Remove this layout">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </td>`;

    // The web view lives in its own row so it can span the full table, linked
    // by a direct element reference rather than ids.
    const sub = document.createElement("tr");
    sub.className = "sl-log-sub";
    sub.innerHTML = `
      <td class="sl-sub-cell" colspan="${SUB_COLSPAN}">
        <div class="sl-web-caption"><span class="sl-web-flag"></span></div>
        <div class="sl-web"></div>
      </td>`;
    tr.__sub = sub;

    const widthEl = tr.querySelector(".sl-width");
    const rmEl = tr.querySelector(".sl-rm");
    const qtyEl = tr.querySelector(".sl-qty");
    if (GROUP_WIDTH !== null) widthEl.value = GROUP_WIDTH;
    qtyEl.value = qty;

    // "Deckle Rolls" going past the Deckles selected: the typed number is left
    // alone, the field (and the other layouts' counts it adds up with) gets a
    // red ring from recalc(), and a toast says why. Save stays blocked.
    // A plain text box (digits only) rather than type=number: a number box
    // can't be told where its caret is, and this one must always put it after
    // what is typed, wherever it is clicked.
    const caretToEnd = () => { const n = qtyEl.value.length; try { qtyEl.setSelectionRange(n, n); } catch (_) {} };
    qtyEl.addEventListener("focus", () => { caretToEnd(); setTimeout(caretToEnd, 0); });
    qtyEl.addEventListener("mouseup", () => setTimeout(caretToEnd, 0));
    qtyEl.addEventListener("input", () => {
      const clean = qtyEl.value.replace(/\D+/g, "");
      if (clean !== qtyEl.value) qtyEl.value = clean;
    });
    qtyEl.addEventListener("input", () => {
      const typed = Math.floor(Number(qtyEl.value));
      if (!Number.isFinite(typed) || typed < 1) return;
      const others = [...document.querySelectorAll("#slLogBody .sl-log-row .sl-qty")]
        .filter((el) => el !== qtyEl)
        .reduce((n, el) => n + Math.max(0, Math.floor(Number(el.value) || 0)), 0);
      const allowed = Math.max(0, SEQUENCED.length - others);
      if (typed <= allowed) return;
      if (typeof showToast === "function") {
        showToast(`Only ${SEQUENCED.length} Deckle Roll${SEQUENCED.length === 1 ? " is" : "s are"} allowed.`, "error");
      }
    });

    tr.querySelectorAll("input").forEach((el) => el.addEventListener("input", recalc));

    // Enter walks along A..L, so a layout can be typed straight through.
    const widthInputs = [...tr.querySelectorAll(".sl-roll-width")];
    // Roll widths are filled in order: B needs A, C needs A and B, and so on.
    // Landing on (or typing into) a slot with an earlier one still empty sends
    // you back to that earlier slot, quietly.
    const firstEmptyBefore = (idx) => widthInputs.slice(0, idx).find((x) => x.value.trim() === "");
    const sendBack = (empty) => empty.focus();
    widthInputs.forEach((el, idx) => {
      el.addEventListener("focus", () => {
        const empty = firstEmptyBefore(idx);
        if (empty) sendBack(empty);
      });
      el.addEventListener("input", () => {
        if (el.value.trim() === "") return;
        const empty = firstEmptyBefore(idx);
        if (!empty) return;
        el.value = "";
        sendBack(empty);
        recalc();
      });
    });
    widthInputs.forEach((el, idx) => {
      el.addEventListener("keydown", (ev) => {
        if (ev.key !== "Enter") return;
        ev.preventDefault();
        (widthInputs[idx + 1] || widthInputs[idx]).focus();
      });
    });

    tr.querySelector(".sl-remove-layout").addEventListener("click", () => {
      if (document.querySelectorAll("#slLogBody .sl-log-row").length <= 1) return;
      sub.remove();
      tr.remove();
      recalc();
    });

    if (preset) {
      if (preset.width != null) { widthEl.value = preset.width; tr.dataset.presetWidth = "1"; }
      if (preset.plannedRunningMeter != null) rmEl.value = preset.plannedRunningMeter;
      widthInputs.forEach((el) => {
        const v = preset.cuts?.[el.dataset.slot];
        if (v != null) el.value = v;
      });
    }

    const body = document.getElementById("slLogBody");
    body.appendChild(tr);
    body.appendChild(sub);
    recalc();
  }

  function readLayoutRow(tr) {
    // Keyed by slot letter -- the server reads req.body.rows[i].cuts.A ...
    const cuts = {};
    tr.querySelectorAll(".sl-roll-width").forEach((el) => {
      const v = num(el.value);
      if (v !== null) cuts[el.dataset.slot] = v;
    });
    return {
      width: num(tr.querySelector(".sl-width").value),
      cuts,
      plannedRunningMeter: num(tr.querySelector(".sl-rm").value),
      qty: Math.max(0, Math.floor(num(tr.querySelector(".sl-qty").value) || 0)),
    };
  }

  // Draw one layout's web to scale: the 5 mm edge trim on each side (r.width
  // is already the cuttable width net of both -- see EDGE_TRIM_MM), then a
  // segment per roll width, then whatever slack is left over uncut.
  function edgeTrimSeg(side) {
    return `
      <div class="sl-web-seg sl-web-edge" style="flex-grow:${EDGE_TRIM_MM}" title="${side} edge trim — ${EDGE_TRIM_MM} mm">
        <span class="sl-seg-slot">EDGE</span><span class="sl-seg-w">${EDGE_TRIM_MM}</span>
      </div>`;
  }

  function paintWeb(tr, r, widthTotal, over) {
    const sub = tr.__sub;
    if (!sub) return;
    const web = sub.querySelector(".sl-web");
    const flag = sub.querySelector(".sl-web-flag");
    const entries = Object.entries(r.cuts);

    web.classList.toggle("is-over", over);
    flag.className = "sl-web-flag" + (over ? " sl-bad" : (entries.length && r.width !== null) ? " sl-ok" : "");

    if (!entries.length) {
      if (r.width === null) {
        web.innerHTML = `<div class="sl-web-empty">Enter the roll widths (A–L)</div>`;
        flag.textContent = "";
        return;
      }
      // Nothing cut yet -- the two mandatory edge trims still show either
      // side of the empty cuttable width.
      web.innerHTML = `${edgeTrimSeg("Left")}`
        + `<div class="sl-web-empty" style="flex-grow:${r.width}; flex-basis:0; min-width:0; width:auto;">${esc(fmt(r.width))} mm web — no roll widths yet</div>`
        + edgeTrimSeg("Right");
      flag.textContent = "";
      return;
    }

    const trimW = r.width !== null ? round2(r.width - widthTotal) : 0;
    const segs = entries.map(([slot, w]) => `
      <div class="sl-web-seg" style="flex-grow:${w}" title="${esc(slot)} — ${esc(fmt(w))} mm">
        <span class="sl-seg-slot">${esc(slot)}</span><span class="sl-seg-w">${esc(fmt(w))}</span>
      </div>`);
    if (!over && trimW > 0) {
      segs.push(`
        <div class="sl-web-seg sl-web-trim" style="flex-grow:${trimW}" title="Trim (uncut slack) — ${esc(fmt(trimW))} mm">
          <span class="sl-seg-slot">TRIM</span><span class="sl-seg-w">${esc(fmt(trimW))}</span>
        </div>`);
    }
    web.innerHTML = r.width !== null ? `${edgeTrimSeg("Left")}${segs.join("")}${edgeTrimSeg("Right")}` : segs.join("");

    const rollWord = `${entries.length} roll${entries.length === 1 ? "" : "s"}`;
    if (r.width === null) {
      flag.textContent = `${rollWord} · ${fmt(widthTotal)} mm — enter the web width`;
    } else if (over) {
      flag.textContent = `Over the web by ${fmt(widthTotal - r.width)} mm`;
    } else {
      flag.textContent = `${rollWord} · ${fmt(widthTotal)} of ${fmt(r.width)} mm · ${fmt(trimW)} mm trim + ${EDGE_TRIM_MM * 2} mm edge`;
    }
  }

  // Why the plan can't be saved yet, or "" when it is ready. recalc() keeps it
  // current; the submit handler shows it as a toast instead of a fixed banner.
  let submitBlockReason = "";

  // Trim and validity per layout row, plus whether every ticked Deckle has
  // been assigned to exactly one layout's "Deckle Rolls" count.
  function recalc() {
    const rows = [...document.querySelectorAll("#slLogBody .sl-log-row")];
    renumber("#slLogBody .sl-log-row", ".sl-log-no-num");

    // Only the last remaining layout can't be removed -- there must always be
    // somewhere for every ticked Deckle to be assigned.
    rows.forEach((tr) => {
      const btn = tr.querySelector(".sl-remove-layout");
      if (btn) btn.disabled = rows.length <= 1;
    });

    const read = rows.map(readLayoutRow);
    let blocked = "";

    if (!document.getElementById("slMachine").value) blocked = "Select a slitting machine.";
    else if (!document.getElementById("slOperator").value) blocked = "Select an operator.";

    let totalQty = 0;
    rows.forEach((tr, i) => {
      const r = read[i];
      totalQty += r.qty;
      const widths = Object.values(r.cuts);
      const widthTotal = round2(widths.reduce((n, w) => n + w, 0));
      const over = r.width !== null && widthTotal > r.width;

      tr.querySelectorAll(".sl-roll-width").forEach((el) => el.classList.toggle("is-set", el.value.trim() !== ""));

      // Counts down from the web width as roll widths (A–L) are entered --
      // what's left to allocate, not what's already cut.
      const remainingEl = tr.querySelector(".sl-width-remaining");
      remainingEl.textContent = r.width === null ? "—" : fmt(r.width - widthTotal);
      remainingEl.classList.toggle("sl-bad", over);

      paintWeb(tr, r, widthTotal, over);

      // First thing standing between this plan and Save, named in the order it
      // is filled in -- otherwise the button just sits dead.
      // A filled slot after an empty one (A cleared while B is still set).
      const slotInputs = [...tr.querySelectorAll(".sl-roll-width")];
      const gapAt = slotInputs.findIndex((el, k) => el.value.trim() !== "" && slotInputs.slice(0, k).some((x) => x.value.trim() === ""));
      const why = !(r.qty >= 1) ? "enter how many Deckles use this layout"
        : !widths.length ? "enter at least one roll width (A–L)"
        : gapAt >= 0 ? `enter the roll widths in order — roll ${slotInputs.slice(0, gapAt).find((x) => x.value.trim() === "").dataset.slot} is empty before roll ${slotInputs[gapAt].dataset.slot}`
        : !widths.every((w) => w > 0) ? "roll widths must be more than zero"
        : over ? "the roll widths add up to more than the Deckle web"
        : !(r.plannedRunningMeter > 0) ? "enter the R. Meter"
        : "";
      if (why && !blocked) blocked = why.charAt(0).toUpperCase() + why.slice(1) + ".";
    });

    const statusEl = document.getElementById("slAssignStatus");
    const fullyAssigned = totalQty === SEQUENCED.length;
    document.querySelectorAll("#slLogBody .sl-log-row .sl-qty")
      .forEach((el) => el.classList.toggle("sl-qty-over", totalQty > SEQUENCED.length));
    if (statusEl) {
      statusEl.textContent = `${totalQty} of ${SEQUENCED.length} Deckle${SEQUENCED.length === 1 ? "" : "s"} assigned`;
      statusEl.classList.toggle("is-ok", fullyAssigned);
      statusEl.classList.toggle("is-bad", !fullyAssigned);
    }

    // Total minus every ticked Deckle currently assigned to a layout below
    // -- e.g. Total 6, one layout's Deckle Rolls dropped to 5, 1 still
    // available for another layout. Negative means too many are assigned
    // (over SEQUENCED.length), same case the "too many" blocked message
    // above already names.
    const unassigned = SEQUENCED.length - totalQty;
    const availableEl = document.getElementById("slAvailableValue");
    if (availableEl) {
      availableEl.textContent = String(BATCH_TOTAL - totalQty);
      availableEl.classList.toggle("sl-bad", unassigned < 0);
    }
    // Nothing left to give a new layout once every ticked Deckle is already
    // assigned (or over-assigned) -- Add Layout would otherwise default the
    // new row's qty to 1 and push Available further into the negative.
    const addLayoutBtn = document.getElementById("slAddLayoutBtn");
    if (addLayoutBtn) addLayoutBtn.disabled = unassigned <= 0;
    if (!blocked && !fullyAssigned) {
      blocked = totalQty < SEQUENCED.length
        ? `${SEQUENCED.length} Deckle Roll${SEQUENCED.length === 1 ? " is" : "s are"} required.`
        : `Only ${SEQUENCED.length} Deckle Roll${SEQUENCED.length === 1 ? " is" : "s are"} allowed.`;
    }

    if (!rows.length) blocked = "Add a Deckle layout.";
    submitBlockReason = blocked;
  }

  // Walks SEQUENCED in the same order the layout rows were built from,
  // handing each layout's next "Deckle Rolls" Deckles its shared width/cuts
  // -- one row per Deckle, back to exactly what the server expects (and one
  // SlittingJobCard per Deckle, per "One Deckle == one card" everywhere else
  // in slitting).
  function expandLayoutsToRows() {
    const layouts = [...document.querySelectorAll("#slLogBody .sl-log-row")].map(readLayoutRow);
    const expanded = [];
    let cursor = 0;
    for (const layout of layouts) {
      for (let i = 0; i < layout.qty && cursor < SEQUENCED.length; i++, cursor++) {
        const target = SEQUENCED[cursor];
        expanded.push({
          deckleStockId: target._id,
          // The metres drawn off each Deckle are always its own full
          // remaining length -- never user-editable, never shared across a
          // layout's Deckles (each reel has its own).
          plannedMeter: target.reelMtrs,
          width: layout.width,
          cuts: layout.cuts,
          plannedRunningMeter: layout.plannedRunningMeter,
        });
      }
    }
    return expanded;
  }

  document.getElementById("slAddLayoutBtn").addEventListener("click", () => {
    const assigned = [...document.querySelectorAll("#slLogBody .sl-log-row")]
      .reduce((n, tr) => n + (readLayoutRow(tr).qty || 0), 0);
    const remaining = SEQUENCED.length - assigned;
    // Belt-and-braces alongside recalc() disabling the button itself --
    // nothing left to give a new layout once every ticked Deckle is already
    // assigned (or over-assigned).
    if (remaining <= 0) return;
    addLayoutRow(remaining);
  });

  // Every save-time problem surfaces as a toast, not a fixed banner.
  function showError(msg) {
    if (msg && typeof showToast === "function") showToast(msg, "error");
  }

  // Picking a machine picks its operator: an operator's profile code is the
  // machine's name (same location), so the match is exact. No match leaves
  // the operator as it was. Only on a deliberate machine change -- a saved
  // card's crew on page load is never touched.
  document.getElementById("slMachine").addEventListener("change", (e) => {
    const key = e.target.selectedOptions[0]?.dataset.operatorKey;
    if (!key) return;
    const opSel = document.getElementById("slOperator");
    const match = [...opSel.options].find((o) => o.dataset.machineKey && o.dataset.machineKey === key);
    if (match) {
      opSel.value = match.value;
      opSel.dispatchEvent(new Event("change"));
    }
  });

  ["slMachine", "slOperator", "slHelper"].forEach((id) =>
    document.getElementById(id).addEventListener("change", recalc));

  // Changing the Trim field only re-defaults layout rows that haven't been
  // carried over from an already-allocated Deckle (see addLayoutRow's
  // dataset.presetWidth) -- an existing card's saved width is never
  // overwritten just because the planner tweaked trim for a new layout.
  trimInput.addEventListener("input", () => {
    TOTAL_TRIM_MM = num(trimInput.value) ?? 10;
    EDGE_TRIM_MM = TOTAL_TRIM_MM / 2;
    GROUP_WIDTH = rawWebWidth !== null ? round2(rawWebWidth - TOTAL_TRIM_MM) : null;
    document.querySelectorAll("#slLogBody .sl-log-row").forEach((tr) => {
      if (tr.dataset.presetWidth) return;
      const widthEl = tr.querySelector(".sl-width");
      if (GROUP_WIDTH !== null) widthEl.value = GROUP_WIDTH;
    });
    recalc();
  });

  document.getElementById("slForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = document.getElementById("slSubmitBtn");
    const label = btn.textContent;

    recalc();
    if (submitBlockReason) {
      // Short of the selected Deckles: ring the Deckle Rolls boxes too (the
      // next edit's recalc() clears it), as the over-count case does.
      const qtyEls = [...document.querySelectorAll("#slLogBody .sl-log-row .sl-qty")];
      const total = qtyEls.reduce((n, el) => n + Math.max(0, Math.floor(Number(el.value) || 0)), 0);
      if (total < SEQUENCED.length) qtyEls.forEach((el) => el.classList.add("sl-qty-over"));
      return showError(submitBlockReason);
    }

    const rows = expandLayoutsToRows();
    if (!rows.length) return showError("Add a Deckle layout.");

    btn.disabled = true;
    btn.textContent = "Saving…";
    try {
      const res = await fetch(`/app/slitting/allocate/${CONFIG.pendingId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          submissionToken: CONFIG.submissionToken,
          machineId: document.getElementById("slMachine").value,
          operatorId: document.getElementById("slOperator").value,
          helperId: document.getElementById("slHelper").value,
          clientOrderNo: ORDER.clientOrderNo,
          rows,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/app/slitting/queue";
        return;
      }
      showError(data.message || "Failed to save the allocation.");
    } catch {
      showError("Server error. Please try again.");
    }
    btn.disabled = false;
    btn.textContent = label;
    recalc();
  });

  // Swap the editable A..L grid for the Set Deckle plan's own read-only
  // summary -- "Deckle Size | Siderun | Across | Deckle Count | Layout", the
  // same table and the same web strip that page draws, so one layout reads
  // identically wherever it is shown. The editable table stays in the DOM but
  // hidden: recalc() and Save still read it, so nothing downstream changes --
  // this only takes the layout out of the planner's hands here.
  function lockLayout(L) {
    const cuts = Object.entries(L.cuts || {}).filter(([, w]) => Number(w) > 0);
    const cutSum = round2(cuts.reduce((n, [, w]) => n + Number(w), 0));
    // Cuttable width -- the web less both edge trims, exactly as GROUP_WIDTH.
    const web = rawWebWidth;
    const cuttable = web !== null ? round2(web - TOTAL_TRIM_MM) : null;
    const remaining = cuttable !== null ? round2(cuttable - cutSum) : null;
    const over = remaining !== null && remaining < 0;
    const rollWord = `${cuts.length} roll${cuts.length === 1 ? "" : "s"}`;

    // Deckle Count is what is being cut HERE; the layout may want more than is
    // ticked in (8 planned, 5 in hand), so the shortfall rides alongside
    // rather than the row quietly reading as the whole job.
    const stillNeeded = CONFIG.layoutNeed
      ? Math.max(0, CONFIG.layoutNeed - (CONFIG.layoutAllocated || 0))
      : null;
    const dcTitle = stillNeeded === null
      ? `${SEQUENCED.length} Deckle(s) cut to this layout`
      : `${SEQUENCED.length} of ${stillNeeded} Deckle web(s) this layout still needs`
        + ` (${CONFIG.layoutNeed} planned${CONFIG.layoutAllocated ? `, ${CONFIG.layoutAllocated} already on another card` : ""})`;

    document.getElementById("slLockedBody").innerHTML = `
      <tr>
        <td class="dsf-web-size">${web !== null ? esc(fmt(web)) + " mm" : "—"}</td>
        <td class="dsf-web-rem${over ? " sl-bad" : ""}">${remaining !== null ? esc(fmt(remaining)) + " mm" : "—"}</td>
        <td class="dsf-web-across"><span class="flag ${over ? "sl-bad" : "sl-ok"}">${rollWord}</span></td>
        <td class="dsf-web-dc" title="${esc(dcTitle)}">${SEQUENCED.length}${
          stillNeeded !== null && stillNeeded !== SEQUENCED.length
            ? `<span class="sl-job-of"> of ${stillNeeded}</span>` : ""
        }</td>
        <td class="dsf-web-diag">
          <div class="sl-web${over ? " is-over" : ""}">${lockedWebHTML(cuts, web)}</div>
        </td>
      </tr>`;

    document.getElementById("slLockedPanel").hidden = false;
    document.getElementById("slEditablePanel").hidden = true;
  }

  // The strip for the locked row: edge trim each side, a segment per roll
  // width, then whatever is left uncut -- same colour key as paintWeb().
  function lockedWebHTML(cuts, web) {
    const segs = cuts.map(([slot, w]) => `
      <div class="sl-web-seg" style="flex-grow:${w}" title="${esc(slot)} — ${esc(fmt(w))} mm">
        <span class="sl-seg-slot">${esc(slot)}</span><span class="sl-seg-w">${esc(fmt(w))}</span>
      </div>`);
    if (web === null) return segs.join("");
    const slack = round2(web - TOTAL_TRIM_MM - cuts.reduce((n, [, w]) => n + Number(w), 0));
    if (slack > 0) {
      segs.push(`
        <div class="sl-web-seg sl-web-trim" style="flex-grow:${slack}" title="Trim (uncut slack) — ${esc(fmt(slack))} mm">
          <span class="sl-seg-slot">TRIM</span><span class="sl-seg-w">${esc(fmt(slack))}</span>
        </div>`);
    }
    return `${edgeTrimSeg("Left")}${segs.join("")}${edgeTrimSeg("Right")}`;
  }

  // One row per layout group -- Deckles sharing an identical existing
  // allocation (or all blank, on a fresh one) start collapsed together;
  // qty is seeded from how many Deckles that group has.
  const anyExisting = [...layoutGroups.values()].some((g) => g[0].existing);

  // A batch may have been planned across SEVERAL deckle widths ("mixed webs" --
  // see PendingProduction.deckleLayout). This page allocates the Deckles of one
  // width at a time (routes/system/slitting.js groups them by reel size), so
  // only the layouts planned for this web belong here; the rest seed the
  // allocation of the reels made at their own width. A layout carrying no
  // planned width at all is from a batch saved before mixed webs existed and
  // always applies.
  const BATCH_LAYOUT_FOR_WEB = BATCH_LAYOUT.filter(
    (L) => !(L.width > 0) || rawWebWidth === null || round2(L.width) === round2(rawWebWidth),
  );

  // The Slitting Queue opened this page for ONE layout the planner already
  // fixed on Set Deckle. It is not this page's to change -- a different cut
  // pattern is a different job -- so every ticked Deckle goes on that layout
  // and the A..L grid is replaced by the read-only summary below.
  //
  // Note the qty: the planned web count is what the BATCH wants (8 webs), not
  // what is being allocated right now. Seeding that would leave recalc() with
  // more Deckles assigned than are ticked and block Save on "3 too many
  // Deckles assigned" until the planner hand-corrected a number they are not
  // allowed to choose. The ticked Deckles are the count.
  const LAYOUT_LOCKED = !!CONFIG.layoutLocked && !anyExisting && BATCH_LAYOUT_FOR_WEB.length === 1;

  if (LAYOUT_LOCKED) {
    const L = BATCH_LAYOUT_FOR_WEB[0];
    addLayoutRow(SEQUENCED.length, { plannedRunningMeter: L.plannedRunningMeter, cuts: L.cuts });
    lockLayout(L);
  } else if (!anyExisting && BATCH_LAYOUT_FOR_WEB.length) {
    // Fresh allocation of a batch the Set Deckle page planned: seed one row per
    // planned deckle layout, qty = its web count. Widths/R. Meter only -- never
    // a web width, so GROUP_WIDTH (size - Trim) still governs.
    BATCH_LAYOUT_FOR_WEB.forEach((L) => {
      addLayoutRow(Math.max(1, Math.floor(L.count || 1)), {
        plannedRunningMeter: L.plannedRunningMeter,
        cuts: L.cuts,
      });
    });
  } else {
    [...layoutGroups.values()].forEach((group) => {
      // An existing SlittingJobCard row wins; otherwise a single blank row.
      addLayoutRow(group.length, group[0].existing ? group[0].existing.row : undefined);
    });
  }

  // Selected Deckles list: made-on date/time and curing status, formatted in
  // the browser like the Choose Deckles dialog (dd/mm/yy, hh:mm AM).
  (function fillSelectedDeckles() {
    const timeLeft = (iso) => {
      const ms = Date.parse(iso) - Date.now();
      if (!Number.isFinite(ms) || ms <= 0) return "";
      const mins = Math.ceil(ms / 60000);
      if (mins < 60) return `${mins}m`;
      const h = Math.floor(mins / 60), m = mins % 60;
      return m ? `${h}h ${m}m` : `${h}h`;
    };
    document.querySelectorAll(".sl-sel-made").forEach((el) => {
      const d = el.dataset.created ? new Date(el.dataset.created) : null;
      if (!d || isNaN(d)) return;
      el.textContent = d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "2-digit" })
        + ", " + d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", hour12: true });
    });
    document.querySelectorAll(".sl-sel-cure").forEach((el) => {
      if (el.dataset.hotmelt === "1") { el.textContent = "Hot melt"; el.classList.add("is-cured"); }
      else if (el.dataset.cured === "0") {
        const left = timeLeft(el.dataset.curedAt);
        el.textContent = "Curing" + (left ? ` · ${left} left` : "");
        el.classList.add("is-curing");
      } else { el.textContent = "Cured"; el.classList.add("is-cured"); }
    });
  })();

  // Filled-in state kept across the reload that adding or removing a Deckle
  // causes; restoreAfterAdd() below reads it back.
  window.slSaveFormState = function () {
    try {
      const val = (id) => (document.getElementById(id) || {}).value || "";
      sessionStorage.setItem("slAddDeckles:" + CONFIG.pendingId, JSON.stringify({
        oldCount: SEQUENCED.length,
        machine: val("slMachine"), operator: val("slOperator"), helper: val("slHelper"), trim: val("slTrim"),
        rows: [...document.querySelectorAll("#slLogBody .sl-log-row")].map((tr) => {
          const cuts = {};
          tr.querySelectorAll(".sl-roll-width").forEach((el) => { if (el.value.trim() !== "") cuts[el.dataset.slot] = el.value; });
          return {
            width: tr.querySelector(".sl-width")?.value || "",
            rm: tr.querySelector(".sl-rm")?.value || "",
            qty: tr.querySelector(".sl-qty")?.value || "",
            cuts,
          };
        }),
      }));
    } catch (_) {}
  };

  // Remove (unselect) a Deckle: same page without that ?deckle=, filled-in
  // state kept. The Deckle goes back to the "more Deckles available" list.
  document.querySelectorAll(".sl-sel-remove").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.deckleId;
      const params = new URLSearchParams(window.location.search);
      const keep = params.getAll("deckle").filter((d) => d !== id);
      if (!keep.length) return;
      params.delete("deckle");
      keep.forEach((d) => params.append("deckle", d));
      window.slSaveFormState();
      window.location.href = window.location.pathname + "?" + params.toString();
    });
  });

  // Coming back from "Add Deckles": put back what was filled in before the
  // reload -- crew, trim and the layout rows -- instead of starting blank.
  // The rows are only restored for a fresh, editable layout (not a locked
  // planner layout, and not one seeded from existing cards).
  (function restoreAfterAdd() {
    const KEY = "slAddDeckles:" + CONFIG.pendingId;
    let saved = null;
    try { saved = JSON.parse(sessionStorage.getItem(KEY) || "null"); sessionStorage.removeItem(KEY); } catch (_) {}
    if (!saved) return;
    const setSel = (id, v) => {
      const el = document.getElementById(id);
      if (el && v && [...el.options].some((o) => o.value === v)) el.value = v;
    };
    setSel("slMachine", saved.machine);
    setSel("slOperator", saved.operator);
    setSel("slHelper", saved.helper);
    if (saved.trim !== "" && saved.trim != null) {
      trimInput.value = saved.trim;
      TOTAL_TRIM_MM = num(trimInput.value) ?? 10;
      EDGE_TRIM_MM = TOTAL_TRIM_MM / 2;
      GROUP_WIDTH = rawWebWidth !== null ? round2(rawWebWidth - TOTAL_TRIM_MM) : null;
    }
    if (!LAYOUT_LOCKED && !anyExisting && Array.isArray(saved.rows) && saved.rows.length) {
      document.querySelectorAll("#slLogBody tr").forEach((r) => r.remove());
      saved.rows.forEach((r) => {
        // One layout that covered every Deckle before still covers every Deckle now.
        const qty = saved.rows.length === 1 && Number(r.qty) === saved.oldCount ? SEQUENCED.length : (Number(r.qty) || 0);
        addLayoutRow(qty, { plannedRunningMeter: r.rm === "" ? undefined : Number(r.rm), cuts: r.cuts });
        const tr = document.querySelector("#slLogBody .sl-log-row:last-of-type") || [...document.querySelectorAll("#slLogBody .sl-log-row")].pop();
        const w = tr && tr.querySelector(".sl-width");
        if (w && r.width !== "" && Number(r.width) !== Number(w.value)) w.value = r.width;
      });
    }
    recalc();
  })();
</script>
