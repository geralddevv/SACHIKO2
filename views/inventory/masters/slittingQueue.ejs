<% layout('/layout/boilerplate') -%>

<!-- Entry point for the slitting step: every order that still has a Deckle
     web with metres on it. "Slit" opens the Slitting Job Card against that
     order (routes/system/slitting.js). Deliberately the same shape as the
     laminator's own Machine Queue (machineQueue.ejs), since it is the same
     move -- pick a job off a list, open its card. -->
<div class="contain sq-page" style="flex-direction: column; padding: 10px; gap: 14px;">
  <style>
    .sq-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .sq-head h1 { font-size: 20px; color: #fff; margin: 0; }
    .sq-head .sq-sub { font-size: 13px; color: rgba(255, 255, 255, 0.85); margin-top: 2px; }

    .ap-card { width: 100%; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
    .ap-card-title {
      background: #044a78; color: #fff; font-size: 14px; font-weight: 600; letter-spacing: 0.2px;
      padding: 9px 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px;
    }
    .ap-table { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: fixed; }
    .ap-table th, .ap-table td {
      padding: 8px 10px; border-bottom: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb;
      text-align: left; vertical-align: middle;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ap-table tr > *:last-child { border-right: none; }
    .ap-table th { background: #f8fafc; color: #044a78; font-weight: 700; }
    .ap-table td { color: #1f2a44; font-weight: 600; }
    .ap-table tbody tr:hover { background: #fbfdff; }
    .ap-notice {
      background: #fff8e1; border: 1px solid #f0c36d; color: #7a5b00; border-radius: 8px;
      padding: 10px 14px; font-size: 13px; display: flex; align-items: center; gap: 8px;
    }
    .sq-chip {
      display: inline-block; background: #f0f7ff; border: 1px solid #d7e6f5; color: #03365a;
      font-weight: 700; font-size: 12px; padding: 2px 9px; border-radius: 999px;
    }
    .sq-start-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px; background: #10b981; color: #fff;
      border: none; border-radius: 6px; padding: 6px 12px; font-size: 12.5px; font-weight: 600;
      cursor: pointer; text-decoration: none; white-space: nowrap; transition: opacity 0.2s;
    }
    .sq-start-btn:hover { opacity: 0.85; }
    /* An order already carrying an allocated card offers the card, not a
       second allocation. */
    .sq-start-btn.is-open { background: #044a78; }
    .sq-records-btn {
      display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.14);
      border: 1px solid rgba(255,255,255,0.35); color: #fff; border-radius: 6px; padding: 6px 12px;
      font-size: 12.5px; font-weight: 600; text-decoration: none; white-space: nowrap;
    }
    .sq-records-btn:hover { background: rgba(255,255,255,0.24); color: #fff; }
    .sq-alloc { font-size: 11.5px; font-weight: 600; color: #64748b; line-height: 1.5; }
    .sq-alloc strong { color: #044a78; }

    @media screen and (max-width: 768px) {
      .sq-page { height: auto; min-height: 100%; padding: 8px; gap: 10px; }
      .ap-table thead { display: none; }
      .ap-table, .ap-table tbody, .ap-table tr, .ap-table td { display: block; width: 100%; }
      .ap-table tbody tr {
        display: flex; flex-wrap: wrap; border: 1px solid #dbe3ec; border-radius: 8px;
        overflow: hidden; margin: 10px; width: auto;
      }
      .ap-table td {
        display: flex; align-items: center; gap: 10px; flex: 1 1 100%;
        padding: 7px 12px; border-right: none; white-space: normal; font-size: 13px;
      }
      .ap-table td::before { content: attr(data-label); flex: 0 0 40%; color: #5a6586; font-weight: 700; font-size: 12px; }
      .ap-table td:last-child { justify-content: center; }
      .ap-table td:last-child::before { content: none; }
      .sq-start-btn { width: 100%; justify-content: center; padding: 11px 12px; font-size: 14px; }
    }
  </style>

  <div class="indi-head sq-head">
    <div>
      <h1>Slitting Queue</h1>
      <div class="sq-sub">Orders with Deckle stock waiting to be cut into finished rolls</div>
    </div>
    <a href="/sachiko/slitting/jobcard/view" class="sq-records-btn">
      <i class="fa-solid fa-clipboard-check"></i> Slitting Records
    </a>
  </div>

  <div class="ap-card">
    <div class="ap-card-title">
      <span><i class="fa-solid fa-scissors"></i> Ready to Slit</span>
      <span><%= rows.length %> order<%= rows.length === 1 ? "" : "s" %></span>
    </div>

    <% if (rows.length === 0) { %>
      <div style="padding: 14px 16px;">
        <div class="ap-notice">
          <i class="fa-solid fa-circle-info"></i>
          No order currently has Deckle stock left to slit.
        </div>
      </div>
    <% } else { %>
      <div>
        <table class="ap-table">
          <colgroup>
            <col style="width: 11%" /><col style="width: 11%" /><col style="width: 13%" />
            <col style="width: 14%" /><col style="width: 8%" /><col style="width: 14%" />
            <col style="width: 18%" /><col style="width: 11%" />
          </colgroup>
          <thead>
            <tr>
              <th>Lot No</th>
              <th>Client Order No</th>
              <th>Product Code</th>
              <th>Client</th>
              <th>Roll Size</th>
              <th>Deckle Stock</th>
              <th>Allocation</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach((row) => { %>
              <tr>
                <td data-label="Lot No" title="<%= row.lotNo %>"><%= row.lotNo %></td>
                <td data-label="Client Order No" title="<%= row.clientOrderNo %>"><%= row.clientOrderNo %></td>
                <td data-label="Product Code" title="<%= row.productCode %>"><%= row.productCode %></td>
                <td data-label="Client" title="<%= row.clientName %>"><%= row.clientName %></td>
                <td data-label="Roll Size"><%= row.paperSize %></td>
                <td data-label="Deckle Stock">
                  <span class="sq-chip"><%= row.deckleCount %> reel<%= row.deckleCount === 1 ? "" : "s" %></span>
                  <span style="color:#64748b;font-weight:600;font-size:11.5px;"><%= row.deckleMtrs.toLocaleString("en-IN") %> mtrs</span>
                </td>
                <td data-label="Allocation">
                  <% if (row.openCard) { %>
                    <div class="sq-alloc">
                      <strong><%= row.openCard.slittingJobCardId %></strong><br />
                      <%= row.openCard.machineName %> · <%= row.openCard.operatorName %><br />
                      <%= row.openCard.deckleLeft %> of <%= row.openCard.deckleCount %> Deckle<%= row.openCard.deckleCount === 1 ? "" : "s" %> still to run
                    </div>
                  <% } else { %>
                    <span style="color:#9ca3af;font-weight:600;">Not allocated</span>
                    <% if (row.rollsSlit > 0) { %>
                      <div class="sq-alloc"><%= row.rollsSlit %> roll<%= row.rollsSlit === 1 ? "" : "s" %> slit so far<% if (row.noOfRolls != null) { %> of <%= row.noOfRolls %><% } %></div>
                    <% } %>
                  <% } %>
                </td>
                <td>
                  <% if (row.openCard) { %>
                    <a href="/sachiko/slitting/allocate/<%= row._id %>" class="sq-start-btn is-open" title="Edit this allocation">
                      <i class="fa-solid fa-pen"></i> Edit allocation
                    </a>
                  <% } else { %>
                    <a href="/sachiko/slitting/allocate/<%= row._id %>" class="sq-start-btn" title="Allocate machine, operator, Deckles and roll widths">
                      <i class="fa-solid fa-scissors"></i> Allocate
                    </a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
