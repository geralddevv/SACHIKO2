<% layout('/layout/boilerplate') -%>

<!-- The slitting entry point: Deckle webs still carrying metres, clubbed by
     Product Code + Size + Running Meters + Layout (interchangeable for
     slitting purposes only when all four match -- two Deckles of the same code
     and size wound to a different finished-roll length, or planned to a
     different A..L knife pattern, still need separate cut plans) into one row
     with one "Slit" action. One row is one cut job, identified by its Product
     Code and the Layout column. That opens a dialog where every Deckle in the
     group is ticked by default (untick the ones you don't want) -- Continue
     carries the ticked ones to the same Allocate page used for a single
     Deckle (routes/system/slitting.js GET "/slitting/allocate/:pendingId",
     one ?deckle= per ticked Deckle plus this row's ?layout=), which lists one
     row per Deckle with the machine/operator/helper and the A..L knife layout
     -- seeded from the planned layout this row names -- entered once for all
     of them. Same shell as the Slitting Logs list (slittingJobCardView.ejs)
     and the same clubbed-group + dialog pattern as Deckle Sorting
     (views/inventory/orders/deckleSet.ejs). -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #master-table { width: 100%; flex: 1 1 auto; min-height: 0; }
    .header-action-btn {
      background-color: #f0f0f0; color: #044a78;
      padding: 2px 14px; font-size: 14px; font-weight: 500;
      border: none; cursor: pointer; border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,.1);
      transition: all 0.2s ease-in-out;
      display: flex; align-items: center; justify-content: center;
    }
    .header-action-btn:hover { background-color: #e4e4e4; }
    .sq-act {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 6px; height: 26px; padding: 0 12px; border-radius: 6px;
      font-size: 12px; font-weight: 700; text-decoration: none; border: none; cursor: pointer;
      background: #10b981; color: #fff;
    }
    .sq-act:hover { opacity: 0.88; color: #fff; }
    .sq-act.is-disabled { background: #e2e8f0; color: #94a3b8; pointer-events: none; }

    /* Group parent vs. Deckle child rows in the dataTree table -- same
       visual language as #deckle-set-table (views/inventory/orders/deckleSet.ejs). */
    #master-table .tabulator-row[data-sq-child="true"] { background: #f8fafc; }
    #master-table .tabulator-row[data-sq-child="true"] .tabulator-cell { color: #475569; }
    #master-table .tabulator-data-tree-control {
      width: 22px !important; height: 22px !important; margin-right: 8px !important;
      border: none !important; border-radius: 6px !important;
      background: rgba(4, 74, 120, 0.09) !important; box-shadow: none !important; outline: none !important;
      display: inline-flex !important; align-items: center !important; justify-content: center !important;
      cursor: pointer !important; transition: background-color 0.15s ease, transform 0.12s ease !important;
    }
    #master-table .tabulator-data-tree-control:hover { background: rgba(4, 74, 120, 0.18) !important; transform: translateY(-1px); }
    #master-table .tabulator-data-tree-control-expand,
    #master-table .tabulator-data-tree-control-collapse { width: auto !important; height: auto !important; background: none !important; border: none !important; }
    #master-table .tabulator-data-tree-control-expand::before,
    #master-table .tabulator-data-tree-control-collapse::before {
      font-family: "Font Awesome 6 Free"; font-weight: 900; content: "\f054";
      font-size: 10px; line-height: 1; color: #044a78; display: inline-block; transition: transform 0.2s ease;
    }
    #master-table .tabulator-data-tree-control-collapse::before { transform: rotate(90deg); }
    #master-table .tabulator-data-tree-control-expand::after,
    #master-table .tabulator-data-tree-control-collapse::after { content: none !important; display: none !important; }
    #master-table .tabulator-data-tree-branch,
    #master-table .tabulator-data-tree-branch-empty { display: none !important; }
    #master-table .tabulator-row[data-sq-child="true"] .tabulator-cell:nth-child(2) { padding-left: 14px; }
    /* Layout cell: this row's web drawn to scale -- the same strip, colour key
       and class names as the Set Deckle planner and Slitting Allocation
       (.sl-web in views/inventory/orders/deckleSetForm.ejs and
       views/inventory/masters/slittingAllocation.ejs), shrunk to fit a table
       row. Cut rolls green, the fixed edge trim orange, uncut slack left
       inside the web red -- so a glance says where every mm of the deckle
       goes. Segment widths are flex-grow, so the strip is proportional at any
       column width. */
    .sq-web {
      display: flex; align-items: stretch; height: 24px; width: 100%;
      border: 1px solid #cbd5e1; border-radius: 6px; overflow: hidden; background: #fff;
    }
    .sq-web.is-over { border-color: #ef4444; box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.14); }
    .sq-web-seg {
      flex-basis: 0; min-width: 0; display: flex; align-items: center; justify-content: center;
      border-right: 1px solid #fff; overflow: hidden; white-space: nowrap;
      background: #16a34a; color: #fff;
      font-size: 10.5px; font-weight: 800; font-variant-numeric: tabular-nums;
    }
    .sq-web-seg:nth-child(even) { background: #15803d; }
    .sq-web-seg:last-child { border-right: none; }
    .sq-web-seg.sq-web-edge { background: #f97316; }
    .sq-web-seg.sq-web-trim { background: #dc2626; }
    .sq-cut-none { color: #cbd5e1; font-weight: 700; }
    .sq-count-badge {
      display: inline-block; font-size: 11px; font-weight: 800; color: #044a78;
      background: #e0ecf8; border-radius: 999px; padding: 1px 9px;
    }

    /* ---- Choose Deckle dialog ---- */
    .sq-dialog {
      width: min(620px, 95vw); max-height: min(600px, 88vh); padding: 0; border: none;
      border-radius: 16px; overflow: hidden; background: #fff; display: flex; flex-direction: column;
      box-shadow: 0 24px 60px rgba(4, 74, 120, 0.28);
      transform: scale(0.96); transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    #chooseDeckleDialog.show .sq-dialog { transform: scale(1); }
    .sq-dialog-header {
      flex: none; background: linear-gradient(135deg, #044a78 0%, #03365a 100%); padding: 14px 24px;
      display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
    }
    .sq-dialog-header h2 { margin: 0; font-size: 17px; font-weight: 700; color: #fff; letter-spacing: 0.2px; }
    .sq-dialog-subtitle { margin: 4px 0 0; font-size: 12.5px; color: rgba(255, 255, 255, 0.75); }
    .sq-close-btn {
      flex: none; border: none; background: rgba(255, 255, 255, 0.14); color: #fff;
      width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-size: 13px;
      display: flex; align-items: center; justify-content: center; transition: background 0.15s ease;
    }
    .sq-close-btn:hover { background: rgba(255, 255, 255, 0.26); }
    #sq-dialog-form { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    .sq-dialog-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 14px 24px; }
    .sq-dialog-body::-webkit-scrollbar { width: 6px; }
    .sq-dialog-body::-webkit-scrollbar-thumb { background: #044a78; border-radius: 10px; }

    .sq-section-label {
      font-size: 11px; font-weight: 700; color: #044a78; text-transform: uppercase;
      letter-spacing: 0.4px; margin-bottom: 8px;
    }

    .sq-deckle-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 4px; }
    .sq-deckle-row {
      display: flex; align-items: center; gap: 12px; padding: 10px 14px;
      border-radius: 10px; border: 1.5px solid #e6eaf2; cursor: pointer;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .sq-deckle-row:hover { border-color: #a9c8e8; background: #f7fbff; }
    .sq-deckle-row.is-off { opacity: 0.55; }
    .sq-deckle-row.is-disabled { opacity: 0.5; cursor: not-allowed; }
    .sq-deckle-row input[type="checkbox"] { flex: none; width: 17px; height: 17px; accent-color: #044a78; }
    .sq-deckle-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .sq-deckle-top { font-weight: 700; color: #1f2a44; font-size: 13.5px; }
    .sq-deckle-sub { color: #64748b; font-size: 12px; }
    .sq-deckle-curing {
      flex: none; font-size: 10.5px; font-weight: 700; color: #b45309; background: #fffaf0;
      border: 1px solid #fde8c9; border-radius: 999px; padding: 2px 9px;
    }
    .sq-error-text { color: #dc2626; font-size: 12px; font-weight: 600; min-height: 16px; margin-top: 6px; }

    .sq-dialog-footer {
      flex: none; display: flex; justify-content: flex-end; gap: 10px;
      padding: 12px 24px; border-top: 1px solid #e6eaf2; background: #fafbfd;
    }
    .sq-btn {
      border: none; border-radius: 9px; padding: 11px 20px; font-size: 14px; font-weight: 700; cursor: pointer;
      transition: opacity 0.18s ease; display: inline-flex; align-items: center; gap: 8px;
    }
    .sq-btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .sq-btn-ghost { background: #eef1f5; color: #475569; }
    .sq-btn-ghost:hover { background: #e2e6ec; }
    .sq-btn-primary { background: linear-gradient(135deg, #044a78 0%, #03365a 100%); color: #fff; }
    .sq-btn-primary:hover { opacity: 0.92; }
  </style>

  <div class="indi-head">
    <h1>Deckle Slitting</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <a href="/app/slitting/jobcard/view" class="header-action-btn" style="text-decoration:none;">
        <i class="fa-solid fa-clipboard-check"></i>&nbsp; Slitting Logs
      </a>
      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span><i class="fa-solid fa-file-arrow-down"></i> Download</span>
          <i class="fas fa-chevron-down"></i>
        </button>
        <div class="download-selector__menu">
          <div class="download-selector__option" id="download-xlsx"><i class="fas fa-file-excel"></i> Excel</div>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table"></div>
</div>

<!-- Choose Deckle dialog -->
<div class="logout-modal" id="chooseDeckleDialog" aria-hidden="true">
  <div class="sq-dialog" role="dialog" aria-modal="true" aria-labelledby="chooseDeckleDialogTitle">
    <div class="sq-dialog-header">
      <div>
        <h2 id="chooseDeckleDialogTitle">Choose Deckles</h2>
        <p class="sq-dialog-subtitle" id="sq-dialog-subtitle"></p>
      </div>
      <button type="button" class="sq-close-btn" id="sq-close-btn" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <form id="sq-dialog-form" novalidate>
      <div class="sq-dialog-body">
        <div class="sq-section-label">Deckles to allocate — untick any you don't want to include</div>
        <p id="sq-pool-note" style="margin:0 0 10px;font-size:12px;color:#64748b;"></p>
        <div id="sq-deckle-list" class="sq-deckle-list"></div>
        <div id="sq-deckle-error" class="sq-error-text"></div>
      </div>

      <div class="sq-dialog-footer">
        <button type="button" class="sq-btn sq-btn-ghost" id="sq-cancel-btn">Cancel</button>
        <button type="submit" class="sq-btn sq-btn-primary" id="sq-submit-btn">Continue <i class="fa-solid fa-arrow-right-long"></i></button>
      </div>
    </form>
  </div>
</div>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script id="sq-data" type="application/json"><%- safeJson(rows) %></script>
<script>
  const downloadSelector = document.getElementById("downloadSelector");
  downloadSelector.querySelector(".download-selector__trigger")
    .addEventListener("click", (e) => { e.stopPropagation(); downloadSelector.classList.toggle("download-selector--active"); });
  document.addEventListener("click", () => downloadSelector.classList.remove("download-selector--active"));

  const esc = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const fmtMtrs = (v) => (Number.isFinite(Number(v)) ? Number(v).toLocaleString("en-IN", { maximumFractionDigits: 2 }) : "—");

  // Same pair as the Deckle Queue: dd/mm/yy and a 12-hour clock.
  const fmtDate = (v) => {
    if (!v) return "—";
    const d = new Date(v);
    if (isNaN(d)) return "—";
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "2-digit" });
  };
  const fmtTime = (v) => {
    if (!v) return "—";
    const d = new Date(v);
    if (isNaN(d)) return "—";
    return d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", hour12: true });
  };

  // Where this job stands: nothing laminated yet, laminated but still inside
  // the curing window, or a Deckle is out of curing and can be cut. Only
  // "ready" opens the Slit dialog.
  const groupStatus = (row) => {
    if (!row.deckleCount) return "waiting";
    return row.readyCount ? "ready" : "curing";
  };

  // The A..L knife pattern a row's webs are queued to be cut to
  // (routes/system/slitting.js pendingLayouts). The cell draws it as the web
  // strip below; these build the plain-text forms of it -- one for the Excel
  // download, one for the tooltip, where the slot letters ride along.
  const layoutWidths = (cuts) => (Array.isArray(cuts) ? cuts : []).map((c) => fmtMtrs(c.width));
  const layoutLabelOf = (cuts) => (layoutWidths(cuts).length ? layoutWidths(cuts).join(" + ") : "—");
  const layoutTitleOf = (cuts) => (Array.isArray(cuts) ? cuts : [])
    .map((c) => `${c.slot || "?"} ${fmtMtrs(c.width)}`).join("  ·  ");

  // The layout drawn to scale across its deckle web, exactly as the Set Deckle
  // planner and Slitting Allocation draw it: half the batch's total edge trim
  // at each side, a segment per roll width in between, and whatever slack is
  // left over uncut. flex-grow carries the millimetres, so the strip stays
  // proportional at any column width.
  //
  // A batch that stored no edge trim draws none: that page's 10 mm input
  // default is not a fact about this batch, and assuming it would both invent
  // an edge and wrongly flag a layout that actually fits as over the web. The
  // unaccounted millimetres show as slack instead.
  const seg = (cls, grow, label, title) =>
    `<div class="sq-web-seg${cls ? " " + cls : ""}" style="flex-grow:${grow}" title="${esc(title)}">${esc(label)}</div>`;

  function layoutWebHtml(row) {
    const cuts = row.layoutCuts || [];
    if (!cuts.length) return "";

    const web = Number(row.size);
    // Note Number(null) is 0, so a missing trim has to be checked for itself.
    const knownTrim = row.layoutTrim != null && Number(row.layoutTrim) >= 0;
    const totalTrim = knownTrim ? Number(row.layoutTrim) : 0;
    const edge = Math.round((totalTrim / 2) * 100) / 100;
    const cutSum = cuts.reduce((n, c) => n + (Number(c.width) || 0), 0);
    const hasWeb = Number.isFinite(web) && web > 0;
    const slack = hasWeb ? Math.round((web - totalTrim - cutSum) * 100) / 100 : null;

    const segs = cuts.map((c) =>
      seg("", Number(c.width) || 0, fmtMtrs(c.width), `${c.slot || "?"} — ${fmtMtrs(c.width)} mm`));

    // Cuts that don't fit their web -- or no web width to fit them in -- can't
    // be drawn against it, so show the cuts alone (flagged when they overflow)
    // rather than a strip that silently misstates the trim.
    if (slack === null || slack < 0) {
      const why = slack === null
        ? `${cuts.length} roll(s) · ${layoutTitleOf(cuts)} · ${fmtMtrs(cutSum)} mm — no deckle width to draw against`
        : `${fmtMtrs(cutSum)} mm of rolls${totalTrim ? ` + ${fmtMtrs(totalTrim)} mm edge trim` : ""}`
          + ` is over the ${fmtMtrs(web)} mm web by ${fmtMtrs(Math.abs(slack))} mm`;
      return `<div class="sq-web${slack === null ? "" : " is-over"}" title="${esc(why)}">${segs.join("")}</div>`;
    }

    const edgeSeg = (side) => (edge > 0
      ? seg("sq-web-edge", edge, fmtMtrs(edge), `${side} edge trim — ${fmtMtrs(edge)} mm`)
      : "");
    const trimSeg = slack > 0
      ? seg("sq-web-trim", slack, fmtMtrs(slack),
          knownTrim ? `Trim (uncut slack) — ${fmtMtrs(slack)} mm` : `Uncut — ${fmtMtrs(slack)} mm (no edge trim recorded)`)
      : "";
    const title = `${fmtMtrs(web)} mm web · ${cuts.length} roll${cuts.length === 1 ? "" : "s"}`
      + ` · ${layoutTitleOf(cuts)} · ${fmtMtrs(slack)} mm uncut`
      + (knownTrim ? ` + ${fmtMtrs(totalTrim)} mm edge trim` : " · no edge trim recorded");
    return `<div class="sq-web" title="${esc(title)}">`
      + edgeSeg("Left") + segs.join("") + trimSeg + edgeSeg("Right")
      + "</div>";
  }

  const STATUS_TEXT = { waiting: "Waiting", curing: "Curing", ready: "Ready" };

  // Every column paints its own HTML from the row, so none of them read a
  // plain value -- which is exactly what a header filter needs to match on,
  // and what the Excel download writes out. So each row also carries the text
  // of what its cells say. Display still comes from the formatters; these are
  // what "Search" searches.
  const groupText = (g) => ({
    item: g.productCode,
    sizeText: g.size != null && g.size !== "" ? `${g.size} mm` : "—",
    rmText: g.runningMeters != null ? `${fmtMtrs(g.runningMeters)} mtrs` : "—",
    layoutLabel: layoutLabelOf(g.layoutCuts),
    stockText: g.expected ? `${g.deckleCount} of ${g.expected}` : String(g.deckleCount),
    statusText: STATUS_TEXT[groupStatus(g)],
    dateText: fmtDate(g.createdAt),
    timeText: fmtTime(g.createdAt),
  });

  const childText = (r) => ({
    item: r.rollId,
    sizeText: "",
    rmText: "",
    layoutLabel: "",
    stockText: `${fmtMtrs(r.mtrs)} mtrs`,
    statusText: r.hotMelt || !r.curing ? "Ready" : "Curing",
    dateText: fmtDate(r.createdAt),
    timeText: fmtTime(r.createdAt),
  });

  // Each top-level row is a Product Code + Size + Running Meters + Layout
  // group; _children are the physical Deckles clubbed into it
  // (routes/system/slitting.js).
  const rowsData = JSON.parse(document.getElementById("sq-data").textContent).map((g) => {
    const kids = (g._children || []).map((r) => ({
      ...r,
      isGroup: false,
      lotNo: r.order ? (r.order.lotNo || "-") : "-",
      curingLabel: r.hotMelt ? "Hot melt" : (r.curing ? (r.curingUntilLabel ? `Curing · ${r.curingUntilLabel}` : "Curing") : "Cured"),
      ...childText(r),
    }));
    return {
      ...g,
      ...groupText(g),
      // Tabulator's dataTree module treats a present (even empty) array as
      // "this row can expand" and still draws the caret -- omit the field
      // entirely for a group with nothing to show so no dropdown icon
      // appears for it.
      _children: kids.length ? kids : undefined,
    };
  });

  /* ----- Choose Deckle dialog: pick which Deckles to allocate (all ticked
     by default) -- Machine, Operator, Helper and the A..L knife layout are
     entered on the Allocate page it opens into (routes/system/slitting.js
     GET "/slitting/allocate/:pendingId"). ----- */
  const chooseDeckleDialog = document.getElementById("chooseDeckleDialog");
  const sqDeckleList = document.getElementById("sq-deckle-list");
  const sqDeckleError = document.getElementById("sq-deckle-error");
  const sqDialogForm = document.getElementById("sq-dialog-form");

  let currentGroup = null;

  function closeChooseDeckleDialog() {
    chooseDeckleDialog.classList.remove("show");
    chooseDeckleDialog.setAttribute("aria-hidden", "true");
  }
  document.getElementById("sq-close-btn").addEventListener("click", closeChooseDeckleDialog);
  document.getElementById("sq-cancel-btn").addEventListener("click", closeChooseDeckleDialog);
  chooseDeckleDialog.addEventListener("click", (e) => { if (e.target === chooseDeckleDialog) closeChooseDeckleDialog(); });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && chooseDeckleDialog.classList.contains("show")) closeChooseDeckleDialog();
  });

  function checkedDeckles() {
    return [...sqDeckleList.querySelectorAll('input[type="checkbox"]:checked')].map((cb) => {
      return (currentGroup._children || []).find((d) => String(d._id) === cb.value);
    }).filter(Boolean);
  }

  // The dialog lists every free Deckle of this Product Code + width -- the
  // shared pool -- but ticks only the ones this cut job's layout still wants
  // (routes/system/slitting.js `forThisLayout`). The rest are there to take if
  // the planner wants them; a job with no layout planned starts all ticked.
  function renderDeckleList(group) {
    // Defensive only: a "waiting" group has no Deckles to tick and its Slit
    // button is disabled, so this should not be reachable -- better an
    // explanation than an empty box if it ever is.
    if (!(group._children || []).length) {
      sqDeckleList.innerHTML = `<div class="sq-deckle-row is-disabled" style="cursor:default;">`
        + `<span class="sq-deckle-main"><span class="sq-deckle-top">No Deckle produced yet</span>`
        + `<span class="sq-deckle-sub">This layout is still waiting for its webs to come off the laminator.</span>`
        + `</span></div>`;
      return;
    }
    sqDeckleList.innerHTML = (group._children || []).map((d) => {
      const curingTag = d.curing ? `<span class="sq-deckle-curing"><i class="fa-solid fa-hourglass-half"></i> curing</span>` : "";
      const disabled = !d.allocateHref;
      const tick = !disabled && d.forThisLayout !== false;
      return `
        <label class="sq-deckle-row${disabled ? " is-disabled" : ""}${tick ? "" : " is-off"}">
          <input type="checkbox" value="${esc(d._id)}" ${disabled ? "disabled" : (tick ? "checked" : "")} />
          <span class="sq-deckle-main">
            <span class="sq-deckle-top">${esc(d.rollId)}</span>
            <span class="sq-deckle-sub">${fmtMtrs(d.mtrs)} mtrs &nbsp;·&nbsp; ${esc(d.location)} &nbsp;·&nbsp; lot ${esc(d.lotNo)}${disabled ? " &nbsp;·&nbsp; not linked to any pending order" : ""}</span>
          </span>
          ${curingTag}
        </label>`;
    }).join("");

    sqDeckleList.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
      cb.addEventListener("change", () => {
        cb.closest(".sq-deckle-row").classList.toggle("is-off", !cb.checked);
        if (checkedDeckles().length) sqDeckleError.textContent = "";
      });
    });
  }

  window.openChooseDeckleDialog = function (groupId) {
    const group = rowsData.find((r) => String(r._id) === String(groupId) && r.isGroup);
    if (!group) return;
    currentGroup = group;

    const rmLabel = group.runningMeters != null ? `${fmtMtrs(group.runningMeters)} mtrs` : "no running meters set";
    const layoutLabel = (group.layoutCuts || []).length ? ` · layout ${layoutLabelOf(group.layoutCuts)}` : "";
    document.getElementById("sq-dialog-subtitle").textContent =
      `${group.productCode || "—"} · ${group.size || "—"}mm · ${rmLabel}${layoutLabel}`
      + ` · ${group.deckleCount} Deckle${group.deckleCount === 1 ? "" : "s"}`;

    renderDeckleList(group);

    // Say plainly that these webs are not this job's alone, and what the
    // default tick means, so the list is not read as reserved stock.
    const pooled = (group._children || []).length;
    const ticked = (group._children || []).filter((d) => d.allocateHref && d.forThisLayout !== false).length;
    const note = [];
    if (group.poolShared) {
      note.push(`These ${pooled} free Deckle${pooled === 1 ? "" : "s"} of ${group.productCode} at ${group.size}mm`
        + " are shared with the other cut jobs of this width.");
    }
    if (pooled && ticked !== pooled) {
      note.push(`${ticked} of them ticked — what this job still needs.`);
    }
    document.getElementById("sq-pool-note").textContent = note.join(" ");

    sqDeckleError.textContent = "";

    chooseDeckleDialog.classList.add("show");
    chooseDeckleDialog.setAttribute("aria-hidden", "false");
  };

  // Picking Deckles is all this dialog does -- Continue opens the Allocate
  // page (routes/system/slitting.js GET "/slitting/allocate/:pendingId")
  // with one ?deckle= per ticked Deckle, where it lists one row per Deckle
  // and Machine, Operator, Helper and the A..L knife layout are entered once
  // for all of them.
  sqDialogForm.addEventListener("submit", (e) => {
    e.preventDefault();
    sqDeckleError.textContent = "";

    const picked = checkedDeckles();
    if (!picked.length) {
      sqDeckleError.textContent = "Tick at least one Deckle to allocate.";
      return;
    }
    if (picked.some((d) => !(d.order && d.order._id))) {
      sqDeckleError.textContent = "One of the ticked Deckles isn't linked to any pending order.";
      return;
    }

    // The Allocate page is scoped to one order (:pendingId), and it is THIS
    // ROW's cut job -- the order that planned the layout -- not whichever
    // order a given web happened to be laminated for. Free webs are pooled by
    // Product Code + width, so a job routinely cuts one from an earlier run;
    // allocating against the planning order is what seeds this row's layout
    // and books the finished rolls to the order that actually wants them.
    // Only when the row has no cut job of its own (plain stock no config
    // claims) do the ticked Deckles have to agree on one order themselves.
    const pendingIds = [...new Set(picked.map((d) => d.order._id))];
    const targetPendingId = currentGroup.pendingId || pendingIds[0];
    if (!currentGroup.pendingId && pendingIds.length > 1) {
      sqDeckleError.textContent =
        `These Deckles belong to ${pendingIds.length} different orders — untick until only one order's Deckles are left.`;
      return;
    }

    const params = new URLSearchParams();
    picked.forEach((d) => params.append("deckle", d._id));
    // This row IS one cut job, so name its layout -- the Allocate page seeds
    // that pattern's rows alone instead of every layout the batch holds.
    if (currentGroup.layoutSig) params.append("layout", currentGroup.layoutSig);
    window.location.href = `/app/slitting/allocate/${targetPendingId}?${params.toString()}`;
  });

  // Numbers are grouped for reading in these cells ("1,000 mtrs", "210 + 210"),
  // so a planner typing "1000" or "210+210" would match nothing against the
  // literal text. Compare with the separators taken out of both sides.
  const loose = (v) => String(v ?? "").toLowerCase().replace(/[\s,]/g, "");
  const numLikeFilter = (term, value) => !term || loose(value).includes(loose(term));

  // Every column carries the same per-column "Search" box as the Slitting Logs
  // list (slittingJobCardView.ejs), which is this page's shell -- set on each
  // column below rather than through a wrapper, since these columns are whole
  // objects with their own formatters.
  const table = new Tabulator("#master-table", {
    data: rowsData,
    height: "100%",
    placeholder: "No Deckle stock left to slit",
    // Not "_id": a Deckle is listed under every cut job that can use it, so
    // the tree needs a key unique per ROW (routes/system/slitting.js sets it).
    // The dialog still works off `_id`, the Deckle's own stock id.
    index: "_rowId",
    dataTree: true,
    // Filter the GROUP rows only -- a group is one cut job, so a search should
    // return whole jobs and keep every Deckle clubbed into them. (Tabulator
    // filters child rows too by default, which would hide Deckles from a group
    // that matched.) Searching a Deckle ID still finds its group: the Product
    // Code column's filter looks through the children as well, below.
    dataTreeFilter: false,
    dataTreeStartExpanded: false,
    dataTreeChildField: "_children",
    // The expand/collapse caret gets its own slim column rather than riding
    // inside "Product Code / Deckle ID" -- Tabulator only ever puts the
    // control on a row that actually has _children (empty/undefined draws
    // none), so a "Waiting" group with nothing produced yet shows no caret.
    dataTreeElementColumn: "_tree",
    rowFormatter: (row) => {
      const d = row.getData();
      if (!d.isGroup) row.getElement().setAttribute("data-sq-child", "true");
    },
    columns: [
      {
        field: "_tree", title: "", headerSort: false, headerFilter: false,
        width: 34, minWidth: 34, hozAlign: "center", formatter: () => "",
      },
      {
        // Group = the deckle config / its clubbed Deckles. Child = one physical
        // Deckle, named by its Deckle ID, with its own metres, location, lot
        // and curing state alongside -- the detail that used to need a column
        // each, now that the group rows are down to the four facts that
        // identify a job.
        title: "Product Code / Deckle ID", field: "item", headerSort: false, widthGrow: 3,
        minWidth: 240,
        headerFilter: "input", headerFilterPlaceholder: "Search code / Deckle ID",
        // The group row shows only the family's base code and hides the Deckle
        // IDs until it is expanded, so the search has to look wider than the
        // cell: the base code, every full variant code clubbed under it
        // ("C003FG-I"), and every Deckle ID inside. Otherwise typing any of
        // those -- all of them things the planner actually has in hand -- would
        // find nothing.
        headerFilterFunc: (term, value, row) => {
          const needle = String(term || "").toLowerCase();
          if (!needle) return true;
          const hay = [value, ...(row.variantCodes || []), ...(row._children || []).map((c) => c.rollId)];
          return hay.some((h) => String(h || "").toLowerCase().includes(needle));
        },
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (row.isGroup) {
            // The variant family's base code. When the Deckles under it were
            // laminated under more than one brand variant (C001WB-A, C001WB-B)
            // the row names them, so clubbing them never hides which raw
            // material each web actually carries -- each child row spells its
            // own out in full in its Deckle ID anyway.
            const variants = (row.variantCodes || []).filter((c) => c && c !== row.productCode);
            const tail = variants.length
              ? `<span style="color:#94a3b8;font-weight:600;"> &nbsp;·&nbsp; ${esc(variants.join(", "))}</span>`
              : "";
            return `<span style="font-weight:800;color:#044a78;">${esc(row.productCode)}</span>${tail}`;
          }
          const bits = [`${fmtMtrs(row.mtrs)} mtrs`, esc(row.location)];
          if (row.lotNo) bits.push(`lot ${esc(row.lotNo)}`);
          const cure = row.curingLabel === "Hot melt"
            ? '<span style="color:#15803d;font-weight:700;"><i class="fa-solid fa-fire"></i> hot melt</span>'
            : row.curing
              ? `<span style="color:#b45309;font-weight:700;"><i class="fa-solid fa-hourglass-half"></i> ${esc(row.curingLabel)}</span>`
              : '<span style="color:#64748b;font-weight:600;"><i class="fa-solid fa-check"></i> cured</span>';
          return `<span style="font-weight:700;color:#044a78;">↳ ${esc(row.rollId)}</span>`
            + `<span style="color:#94a3b8;font-weight:600;"> &nbsp;·&nbsp; ${bits.join(" &nbsp;·&nbsp; ")} &nbsp;·&nbsp; </span>${cure}`;
        },
      },
      {
        title: "Deckle Size", field: "sizeText", hozAlign: "center", width: 130, headerSort: false,
        headerFilter: "input", headerFilterPlaceholder: "Search",
        headerFilterFunc: numLikeFilter,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return row.isGroup ? `<span style="font-weight:700;color:#044a78;">${esc(row.size)}mm</span>` : "";
        },
      },
      {
        title: "Running Mtrs", field: "rmText", hozAlign: "center", width: 140, headerSort: false,
        headerFilter: "input", headerFilterPlaceholder: "Search",
        headerFilterFunc: numLikeFilter,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isGroup) return "";
          return row.runningMeters != null ? `${fmtMtrs(row.runningMeters)} mtrs` : "—";
        },
      },
      {
        // The knife pattern this row's webs are queued to be cut to -- what
        // makes a row unique alongside the Product Code, since one width can
        // be planned with several patterns and those are different jobs.
        // Blank on the child rows: every Deckle under a group shares its
        // layout, which is why they are clubbed there in the first place.
        title: "Layout", field: "layoutLabel", hozAlign: "left",
        widthGrow: 3, minWidth: 220, headerSort: false,
        headerFilter: "input", headerFilterPlaceholder: "Search a roll width",
        headerFilterFunc: numLikeFilter,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isGroup) return "";
          if (!(row.layoutCuts || []).length) {
            return '<span class="sq-cut-none" title="No deckle layout was planned for this stock">—</span>';
          }
          return layoutWebHtml(row);
        },
      },
      {
        // Deckles of this width actually made and still free to slit, against
        // what the config calls for. 0 of N = set, not yet run.
        title: "Stock", field: "stockText", hozAlign: "center", width: 120, headerSort: false,
        headerFilter: "input", headerFilterPlaceholder: "Search",
        headerFilterFunc: numLikeFilter,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isGroup) return "";
          const of = row.expected ? `<span style="color:#94a3b8;font-weight:600;"> of ${row.expected}</span>` : "";
          // Free webs of this Product Code + width are one pool, so the same
          // Deckles count for every cut job of that width -- these numbers do
          // not add up across those rows, and the row says so rather than
          // letting them be read as separate stock.
          const shared = row.poolShared
            ? ` <i class="fa-solid fa-link" style="color:#94a3b8;font-size:9px;"></i>`
            : "";
          const why = row.poolShared
            ? `${row.deckleCount} free Deckle(s) of ${row.productCode} at ${row.size}mm — shared with the other cut jobs of this width`
            : `${row.deckleCount} free Deckle(s) of ${row.productCode} at ${row.size}mm`;
          if (!row.deckleCount) {
            return `<span title="${esc(why)}"><span style="color:#b45309;font-weight:800;">0</span>${of}${shared}</span>`;
          }
          return `<span title="${esc(why)}"><span style="color:#15803d;font-weight:800;">${row.deckleCount}</span>${of}${shared}</span>`;
        },
      },
      {
        title: "Status", field: "statusText", hozAlign: "center", width: 130, headerSort: false,
        headerFilter: "input", headerFilterPlaceholder: "Search",
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isGroup) {
            if (row.curingLabel === "Hot melt") return '<span style="color:#15803d;font-weight:700;">Ready</span>';
            return row.curing
              ? '<span style="color:#b45309;font-weight:700;">Curing</span>'
              : '<span style="color:#15803d;font-weight:700;">Ready</span>';
          }
          const status = groupStatus(row);
          if (status === "waiting") return '<span style="color:#94a3b8;font-weight:800;"><i class="fa-solid fa-hourglass-half"></i> Waiting</span>';
          if (status === "curing") return '<span style="color:#b45309;font-weight:800;"><i class="fa-solid fa-hourglass-half"></i> Curing</span>';
          return '<span style="color:#15803d;font-weight:800;"><i class="fa-solid fa-check"></i> Ready</span>';
        },
      },
      {
        // Group: when the deckle was set (or its first Deckle made, for stock
        // no config claims any more). Child: when that Deckle was laminated.
        title: "Date", field: "dateText", hozAlign: "center", width: 110, headerSort: false,
        headerFilter: "input", headerFilterPlaceholder: "Search",
        formatter: (cell) => fmtDate(cell.getRow().getData().createdAt),
      },
      {
        title: "Time", field: "timeText", hozAlign: "center", width: 110, headerSort: false,
        headerFilter: "input", headerFilterPlaceholder: "Search",
        formatter: (cell) => fmtTime(cell.getRow().getData().createdAt),
      },
      {
        title: "Actions", hozAlign: "center", headerSort: false, headerFilter: false, width: 110,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isGroup) return "";
          // Only a group with a Deckle that is out of curing can be cut --
          // .is-disabled also kills pointer events, so the dialog can't open.
          const status = groupStatus(row);
          const why = status === "waiting"
            ? "No Deckle of this width has been produced yet"
            : "Every Deckle here is still curing";
          if (status !== "ready") {
            return `<button class="sq-act is-disabled" disabled title="${why}"><i class="fa-solid fa-scissors"></i> Slit</button>`;
          }
          return `<button onclick="openChooseDeckleDialog('${row._id}')" class="sq-act" title="Allocate one or more Deckles from this group"><i class="fa-solid fa-scissors"></i> Slit</button>`;
        },
      },
    ],
  });

  document.getElementById("download-xlsx").addEventListener("click", () =>
    table.download("xlsx", "sachiko-deckle-slitting.xlsx", { sheetName: "Deckle Slitting" }));
</script>

<% if (notification && notification.length) { %>
<script>
  const sqFlash = <%- safeJson(notification[0]) %>;
  const sqFlashType = /failed|not found|error|no deckle|invalid|no longer/i.test(String(sqFlash)) ? "error" : "success";
  const showSqFlash = () => {
    if (typeof hideStaticToast === "function") hideStaticToast();
    if (typeof showToast === "function") showToast(sqFlash, sqFlashType);
  };
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", showSqFlash, { once: true })
    : showSqFlash();
</script>
<% } %>
