<% layout('/layout/boilerplate') -%>

<!-- The slitting entry point: one row per Deckle web still carrying metres.
     "Allocate" opens the Slitting Job Card for that Deckle's order
     (routes/system/slitting.js) with the Deckle pre-filled as the first row.
     Same shell as the Slitting Records list (slittingJobCardView.ejs). -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #master-table { width: 100%; flex: 1 1 auto; min-height: 0; }
    .header-action-btn {
      background-color: #f0f0f0; color: #044a78;
      padding: 2px 14px; font-size: 14px; font-weight: 500;
      border: none; cursor: pointer; border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,.1);
      transition: all 0.2s ease-in-out;
      display: flex; align-items: center; justify-content: center;
    }
    .header-action-btn:hover { background-color: #e4e4e4; }
    .sq-act {
      display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 6px;
      font-size: 12px; text-decoration: none;
      background: #10b981; color: #fff;
    }
    .sq-act:hover { opacity: 0.88; color: #fff; }
    .sq-act.is-open { background: #044a78; }
    .sq-act.is-disabled { background: #e2e8f0; color: #94a3b8; pointer-events: none; }
  </style>

  <div class="indi-head">
    <h1>Slitting Queue</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <a href="/sachiko/slitting/jobcard/view" class="header-action-btn" style="text-decoration:none;">
        <i class="fa-solid fa-clipboard-check"></i>&nbsp; Slitting Records
      </a>
      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span><i class="fa-solid fa-file-arrow-down"></i> Download</span>
          <i class="fas fa-chevron-down"></i>
        </button>
        <div class="download-selector__menu">
          <div class="download-selector__option" id="download-xlsx"><i class="fas fa-file-excel"></i> Excel</div>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table"></div>
</div>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script id="sq-data" type="application/json"><%- safeJson(rows) %></script>
<script>
  const downloadSelector = document.getElementById("downloadSelector");
  downloadSelector.querySelector(".download-selector__trigger")
    .addEventListener("click", (e) => { e.stopPropagation(); downloadSelector.classList.toggle("download-selector--active"); });
  document.addEventListener("click", () => downloadSelector.classList.remove("download-selector--active"));

  const esc = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const raw = JSON.parse(document.getElementById("sq-data").textContent);

  const tableData = raw.map((r) => ({
    rollId: r.rollId || "-",
    productCode: r.productCode || "-",
    mtrs: Number(r.mtrs) || 0,
    size: r.size || "-",
    location: r.location || "-",
    lotNo: r.order ? (r.order.lotNo || "-") : "-",
    clientName: r.order ? (r.order.clientName || "-") : "-",
    clientOrderNo: r.order ? (r.order.clientOrderNo || "-") : "-",
    status: r.card ? (r.card.run ? "Slit" : "On card") : "Free",
    cardInfo: r.card
      ? (r.card.run
          ? r.card.slittingJobCardId
          : `${r.card.slittingJobCardId} · ${r.card.machineName}`)
      : "-",
    allocateHref: r.allocateHref || "",
    hasCard: !!r.card,
    cardRun: !!(r.card && r.card.run),
    // Curing: allocation is allowed now, running is not until this clears.
    curing: !!r.curing,
    curingLabel: r.hotMelt ? "Hot melt" : (r.curing ? (r.curingUntilLabel ? `Curing · ${r.curingUntilLabel}` : "Curing") : "Cured"),
  }));

  const withTextFilter = (col) => ({ headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, ...col });

  const statusFormatter = (cell) => {
    const v = cell.getValue();
    if (v === "Slit") return '<span style="color:#64748b;font-weight:700;"><i class="fa-solid fa-check"></i> Slit</span>';
    if (v === "On card") return '<span style="color:#1d4ed8;font-weight:700;"><i class="fa-solid fa-scissors"></i> On card</span>';
    return '<span style="color:#15803d;font-weight:700;"><i class="fa-solid fa-circle-check"></i> Free</span>';
  };

  const actionFormatter = (cell) => {
    const d = cell.getData();
    if (!d.allocateHref) {
      return '<span class="sq-act is-disabled" title="This Deckle isn\'t linked to any pending order"><i class="fa-solid fa-ban"></i></span>';
    }
    if (d.hasCard && !d.cardRun) {
      return `<a class="sq-act is-open" href="${esc(d.allocateHref)}" title="Open the Slitting Job Card this Deckle is on"><i class="fa-solid fa-pen"></i></a>`;
    }
    return `<a class="sq-act" href="${esc(d.allocateHref)}" title="Allocate machine, operator and roll widths for this Deckle"><i class="fa-solid fa-scissors"></i></a>`;
  };

  const table = new Tabulator("#master-table", {
    data: tableData,
    height: "100%",
    placeholder: "No Deckle stock left to slit",
    columns: [
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      { title: "Action", field: "_action", width: 80, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: actionFormatter },
      withTextFilter({ title: "Deckle", field: "rollId", minWidth: 230, formatter: (cell) => `<span style="font-weight:700;color:#044a78;">${esc(cell.getValue())}</span>` }),
      withTextFilter({ title: "Product Code", field: "productCode", minWidth: 130, formatter: (cell) => `<span style="font-weight:600;color:#03365a;">${esc(cell.getValue())}</span>` }),
      withTextFilter({ title: "Mtrs", field: "mtrs", width: 110, hozAlign: "right", headerHozAlign: "right", sorter: "number",
        formatter: (cell) => (Number(cell.getValue()) || 0).toLocaleString("en-IN") }),
      withTextFilter({ title: "Size", field: "size", width: 100 }),
      withTextFilter({ title: "Location", field: "location", minWidth: 120 }),
      withTextFilter({ title: "Lot No", field: "lotNo", minWidth: 120 }),
      withTextFilter({ title: "Client", field: "clientName", minWidth: 150 }),
      withTextFilter({ title: "Client Order No", field: "clientOrderNo", minWidth: 130 }),
      withTextFilter({ title: "Status", field: "status", width: 120, formatter: statusFormatter }),
      withTextFilter({ title: "Curing", field: "curingLabel", width: 150, formatter: (cell) => {
        const d = cell.getData();
        if (d.curingLabel === "Hot melt") return '<span style="color:#15803d;font-weight:700;"><i class="fa-solid fa-fire"></i> Hot melt</span>';
        if (d.curing) return `<span style="color:#b45309;font-weight:700;"><i class="fa-solid fa-hourglass-half"></i> ${esc(cell.getValue())}</span>`;
        return '<span style="color:#64748b;font-weight:600;"><i class="fa-solid fa-check"></i> Cured</span>';
      } }),
      withTextFilter({ title: "Slitting Card", field: "cardInfo", minWidth: 220 }),
    ],
  });

  // "renderComplete" is what keeps Sr. No. sequential after a sort or a filter.
  table.on("renderComplete", () => {
    document.querySelectorAll("#master-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  document.getElementById("download-xlsx").addEventListener("click", () =>
    table.download("xlsx", "sachiko-slitting-queue.xlsx", { sheetName: "Slitting Queue" }));
</script>

<% if (notification && notification.length) { %>
<script>
  const sqFlash = <%- safeJson(notification[0]) %>;
  const sqFlashType = /failed|not found|error|no deckle|invalid|no longer/i.test(String(sqFlash)) ? "error" : "success";
  const showSqFlash = () => {
    if (typeof hideStaticToast === "function") hideStaticToast();
    if (typeof showToast === "function") showToast(sqFlash, sqFlashType);
  };
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", showSqFlash, { once: true })
    : showSqFlash();
</script>
<% } %>
