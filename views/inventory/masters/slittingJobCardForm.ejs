<% layout('/layout/boilerplate') %>

<%
  // Stage 2 of slitting, and the only place it moves stock. The planner has
  // already fixed everything (machine, operator, helper, Deckles, roll widths,
  // planned metres) on /sachiko/slitting/allocate/:pendingId -- so nothing
  // here is a picker. The operator scans a Deckle to confirm the physical
  // reel, punches Start, punches Stop, and confirms the metres that actually
  // ran; that Stop inwards the row's finished rolls and draws the metres off
  // the Deckle.
  const isEmpty = (v) => v === undefined || v === null || (typeof v === "string" && v.trim() === "");
  const dash = (v) => (isEmpty(v) ? "—" : v);
  const fmtN = (v) => (Number.isFinite(Number(v)) && !isEmpty(v) ? Number(v).toLocaleString("en-IN") : "—");
  const cardDate = card.date ? new Date(card.date).toLocaleDateString("en-GB") : "—";
  const pendingCount = (card.rows || []).filter((r) => r.status !== "done").length;
%>

<style>
  .span-full { padding: 0 !important; }
  .span-full.form-heading, .span-full.form-subheading { padding: 10px !important; }
  .sl-panel { align-self: stretch; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .sl-head-chip {
    background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.3); color: #fff;
    font-size: 12.5px; font-weight: 700; padding: 3px 11px; border-radius: 999px; white-space: nowrap;
  }
  .sl-mini-btn {
    display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.55);
    background: transparent; color: #fff; border-radius: 6px; padding: 5px 11px;
    font-size: 12.5px; font-weight: 600; cursor: pointer; white-space: nowrap;
  }
  .sl-mini-btn:hover { background: rgba(255,255,255,0.14); }

  .sl-job-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; background: #e2e8f0; }
  .sl-job-cell { background: #f8fafc; padding: 11px 14px; display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .sl-job-label {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #7c8ba1; white-space: nowrap;
  }
  .sl-job-value { font-size: 15px; font-weight: 800; color: #1f2a44; line-height: 1.3; overflow-wrap: anywhere; }

  /* ---- Scan strip ------------------------------------------------------ */
  .sl-scan-wrap {
    align-self: stretch; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 14px;
  }
  .sl-scan-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #7c8ba1;
  }
  .sl-scan-field { flex: 1 1 260px; display: flex; align-items: center; gap: 8px; min-width: 0; }
  .sl-scan-field input.form-control {
    flex: 1 1 auto; min-width: 0; height: 40px !important; font-size: 14px !important;
    padding: 6px 12px !important; border-radius: 8px !important; border: 1px solid #cbd5e1 !important;
  }
  .sl-scan-field input.form-control:focus { outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .sl-scan-btn {
    flex: 0 0 auto; height: 40px; width: 44px; border: 1px solid #044a78; background: #044a78; color: #fff;
    border-radius: 8px; font-size: 15px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  }
  .sl-scan-btn:hover { background: #03365a; }
  .sl-scan-msg { flex: 1 1 100%; font-size: 12.5px; font-weight: 600; color: #64748b; }
  .sl-scan-msg.sl-bad { color: #b91c1c; }
  .sl-scan-msg.sl-ok { color: #15803d; }

  /* ---- One Deckle ------------------------------------------------------ */
  .sl-deckles { align-self: stretch; display: flex; flex-direction: column; gap: 10px; }
  .sl-deckle {
    background: #fff; border: 1px solid #e2e8f0; border-left: 4px solid #cbd5e1;
    border-radius: 10px; padding: 12px 14px; display: flex; flex-direction: column; gap: 10px;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .sl-deckle.is-armed { border-left-color: #044a78; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.12); }
  .sl-deckle.is-running { border-left-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.14); }
  .sl-deckle.is-curing { border-left-color: #d97706; background: #fffbf3; }
  .sl-deckle.is-done { border-left-color: #16a34a; background: #f8fdfa; }

  .sl-deckle-top { display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .sl-deckle-no {
    flex: 0 0 auto; width: 26px; height: 26px; border-radius: 50%; background: #044a78; color: #fff;
    font-size: 12px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center;
  }
  .sl-deckle-id { font-size: 15.5px; font-weight: 800; color: #03365a; overflow-wrap: anywhere; }
  .sl-deckle-meta { font-size: 12px; font-weight: 600; color: #64748b; margin-top: 3px; line-height: 1.5; }
  .sl-deckle-meta .sl-bad, .sl-deckle-meta.sl-bad { color: #b91c1c; }
  .sl-badge {
    margin-left: auto; flex: 0 0 auto; font-size: 10.5px; font-weight: 800; letter-spacing: 0.06em;
    text-transform: uppercase; padding: 4px 11px; border-radius: 999px; white-space: nowrap;
  }
  .sl-badge.is-pending { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
  .sl-badge.is-curing { background: #fff7ed; color: #b45309; border: 1px solid #fed7aa; }
  .sl-badge.is-armed { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
  .sl-badge.is-running { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
  .sl-badge.is-done { background: #ecfdf5; color: #15803d; border: 1px solid #a7f3d0; }

  /* Web view: the allocated roll widths drawn to scale across the reel. */
  /* The drawing is a proportional diagram, not a data grid: stretched to the
     full width its segments are far wider than they need to be to read, so it
     is capped and centred, caption included. */
  .sl-web-caption {
    display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;
    max-width: 560px; margin: 0 auto 5px;
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #7c8ba1;
  }
  .sl-web-flag { text-transform: none; letter-spacing: 0; font-size: 11px; font-weight: 700; color: #15803d; }
  .sl-web {
    display: flex; align-items: stretch; height: 34px; width: 100%; max-width: 560px; margin: 0 auto;
    border: 1px solid #cbd5e1; border-radius: 7px; overflow: hidden; background: #fff;
  }
  .sl-web-seg {
    flex-basis: 0; min-width: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 1px;
    border-right: 1px solid #fff; overflow: hidden; white-space: nowrap;
    background: #2f7fb8; color: #fff;
  }
  .sl-web-seg:nth-child(even) { background: #256a9c; }
  .sl-web-seg:last-child { border-right: none; }
  .sl-web-seg .sl-seg-slot { font-size: 9px; font-weight: 700; opacity: 0.8; letter-spacing: 0.06em; }
  .sl-web-seg .sl-seg-w { font-size: 12px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .sl-web-seg.sl-web-trim {
    background: repeating-linear-gradient(45deg, #e2e8f0, #e2e8f0 5px, #eef2f7 5px, #eef2f7 10px); color: #64748b;
  }

  .sl-deckle-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sl-punch {
    flex: 0 0 auto; min-width: 118px; height: 40px; border: none; border-radius: 8px;
    font-size: 14px; font-weight: 700; letter-spacing: 0.02em; color: #fff; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    transition: opacity 0.15s;
  }
  .sl-punch:hover:not(:disabled) { opacity: 0.88; }
  .sl-punch.sl-start { background: #10b981; }
  .sl-punch.sl-stop { background: #dc2626; }
  .sl-punch:disabled { background: #cbd5e1; cursor: not-allowed; }
  .sl-times { font-size: 12px; font-weight: 700; color: #64748b; font-variant-numeric: tabular-nums; }
  .sl-rolls-out {
    flex: 1 1 100%; font-size: 12px; font-weight: 700; color: #15803d; line-height: 1.6; overflow-wrap: anywhere;
  }

  /* ---- Requirement (read-only) ----------------------------------------- */
  .sl-req-table { width: 100%; border-collapse: separate; border-spacing: 0; }
  .sl-req-table th {
    background: #044a78; color: #fff; font-size: 11.5px; font-weight: 600; padding: 7px 10px;
    text-align: left; border-right: 1px solid rgba(255,255,255,0.22); white-space: nowrap;
  }
  .sl-req-table th:last-child { border-right: none; }
  .sl-req-table td {
    padding: 7px 10px; border-bottom: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;
    font-size: 12.5px; font-weight: 700; color: #1f2a44; font-variant-numeric: tabular-nums;
  }
  .sl-req-table td:last-child { border-right: none; }
  .sl-req-table tbody tr:last-child td { border-bottom: none; }

  .sl-summary {
    align-self: stretch; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px; background: #e2e8f0; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden;
  }
  .sl-sum-cell { background: #fff; padding: 11px 14px; display: flex; flex-direction: column; gap: 4px; }
  .sl-sum-label { font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #7c8ba1; }
  .sl-sum-value { font-size: 19px; font-weight: 800; color: #044a78; font-variant-numeric: tabular-nums; }

  .sl-done-note {
    align-self: stretch; background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46;
    border-radius: 10px; padding: 14px 16px; font-size: 13.5px; font-weight: 700; line-height: 1.6;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .sl-done-note a { color: #065f46; font-weight: 800; }

  /* ---- Stop dialog ------------------------------------------------------ */
  .dialog-header {
    background: #044a78; padding: 16px 20px; display: flex; align-items: center;
    justify-content: space-between; border-radius: 14px 14px 0 0;
  }
  .dialog-header h2 { margin: 0; font-size: 1rem; font-weight: 700; color: #fff; }
  .dialog-close-btn {
    background: none; border: none; color: #fff; font-size: 26px; cursor: pointer;
    line-height: 1; width: 38px; height: 38px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 8px; opacity: 0.85; transition: opacity 0.15s, background 0.15s;
  }
  .dialog-close-btn:hover { opacity: 1; background: rgba(255, 255, 255, 0.18); }
  .dialog-body { padding: 18px 20px; background: #fff; border-radius: 0 0 14px 14px; }
  .sl-dlg-label {
    display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.05em;
    text-transform: uppercase; color: #7c8ba1; margin-bottom: 6px;
  }
  .sl-dlg-plan {
    background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px;
    font-size: 12.5px; font-weight: 700; color: #1f2a44; line-height: 1.6; margin-bottom: 14px;
  }
  .sl-dlg-field { margin-bottom: 12px; }
  .sl-dlg-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .dialog-body input.form-control {
    width: 100%; height: 40px !important; font-size: 14px !important; padding: 6px 12px !important;
    border-radius: 8px !important; border: 1px solid #cbd5e1 !important; font-variant-numeric: tabular-nums;
  }
  .dialog-body input.form-control:focus { outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .sl-dlg-err { display: none; color: #b91c1c; font-size: 12.5px; font-weight: 700; margin-top: 4px; }
  .sl-dlg-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
  .sl-dlg-btn {
    border-radius: 8px; padding: 10px 18px; font-size: 13.5px; font-weight: 700; cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .sl-dlg-btn.is-ghost { background: #fff; border: 1px solid #cbd5e1; color: #64748b; }
  .sl-dlg-btn.is-primary { background: #044a78; border: 1px solid #044a78; color: #fff; }
  .sl-dlg-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  #scanVideo { width: 100%; border-radius: 10px; background: #000; aspect-ratio: 4 / 3; object-fit: cover; }
  .sl-scan-status { margin-top: 10px; font-size: 12.5px; font-weight: 600; color: #64748b; text-align: center; }
  .sl-scan-status.sl-bad { color: #b91c1c; }

  @media screen and (max-width: 768px) {
    .sl-job-grid { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
    .sl-punch { flex: 1 1 auto; }
    .sl-dlg-row { grid-template-columns: 1fr; }
  }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px">
  <div class="span-full form-heading" style="display:flex; flex-direction:row; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
    <h1>Slitting Job Card</h1>
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <span class="sl-head-chip"><%= card.slittingJobCardId %></span>
      <span class="sl-head-chip"><%= dash(card.machineName) %></span>
    </div>
  </div>

  <!-- Everything here was fixed at allocation. Nothing on this page is a
       picker -- the operator only confirms the reel and punches the clock. -->
  <div class="span-full" style="border:none !important;">
    <div class="sl-panel">
      <div class="sl-job-grid">
        <div class="sl-job-cell">
          <span class="sl-job-label">Date</span>
          <span class="sl-job-value"><%= cardDate %></span>
        </div>
        <div class="sl-job-cell">
          <span class="sl-job-label">Client Order No</span>
          <span class="sl-job-value"><%= dash(card.clientOrderNo) %></span>
        </div>
        <div class="sl-job-cell">
          <span class="sl-job-label">Product Code</span>
          <span class="sl-job-value"><%= dash(card.productCode) %></span>
        </div>
        <div class="sl-job-cell">
          <span class="sl-job-label">Lot No</span>
          <span class="sl-job-value"><%= dash(card.lotNo) %></span>
        </div>
        <div class="sl-job-cell">
          <span class="sl-job-label">Client</span>
          <span class="sl-job-value"><%= dash(card.clientName) %></span>
        </div>
        <div class="sl-job-cell">
          <span class="sl-job-label">Operator</span>
          <span class="sl-job-value"><%= dash(card.operatorName) %></span>
        </div>
        <div class="sl-job-cell">
          <span class="sl-job-label">Helper</span>
          <span class="sl-job-value"><%= dash(card.helperName) %></span>
        </div>
      </div>
    </div>
  </div>


  <!-- Scanning the reel is what arms its row: Start stays locked until the
       Deckle in the machine has been confirmed. Typing the id works too, so a
       dead camera never stops the floor. -->
  <div class="span-full form-subheading" style="margin-top:10px;"><h1>Scan Deckle</h1></div>
  <div class="span-full" style="border:none !important;">
    <div class="sl-scan-wrap">
      <span class="sl-scan-label">Deckle ID</span>
      <div class="sl-scan-field">
        <input type="text" id="slScanInput" class="form-control" placeholder="Scan or type the Deckle ID" autocomplete="off" />
        <button type="button" id="slScanBtn" class="sl-scan-btn" title="Scan the QR code on the reel">
          <i class="fa-solid fa-camera"></i>
        </button>
      </div>
      <span class="sl-scan-msg" id="slScanMsg">Scan the Deckle you are about to run.</span>
    </div>
  </div>

  <div class="span-full form-subheading" style="margin-top:10px;">
    <h1>Deckles &nbsp;<span style="font-size:13px; font-weight:600; opacity:0.85;" id="slProgress"></span></h1>
  </div>
  <div class="span-full" style="border:none !important;">
    <div class="sl-deckles" id="slDeckles"></div>
  </div>

  <div class="span-full" style="border:none !important;">
    <div class="sl-summary">
      <div class="sl-sum-cell">
        <span class="sl-sum-label">Deckles Done</span>
        <span class="sl-sum-value" id="slSumDone">0</span>
      </div>
      <div class="sl-sum-cell">
        <span class="sl-sum-label">Mtrs Off Deckles</span>
        <span class="sl-sum-value" id="slSumMeter">0</span>
      </div>
      <div class="sl-sum-cell">
        <span class="sl-sum-label">Rolls Inwarded</span>
        <span class="sl-sum-value" id="slSumRolls">0</span>
      </div>
      <div class="sl-sum-cell">
        <span class="sl-sum-label">Finished Mtrs</span>
        <span class="sl-sum-value" id="slSumFinished">0</span>
      </div>
    </div>
  </div>

  <div class="span-full" style="border:none !important; display:none;" id="slDoneWrap">
    <div class="sl-done-note">
      <i class="fa-solid fa-circle-check"></i>
      <span>Every Deckle on this card has been run — the card is finished.</span>
      <a href="/sachiko/slitting/jobcard/view" style="margin-left:auto;">Slitting Records →</a>
    </div>
  </div>
</div>

<!-- ============ STOP: confirm what actually ran ============ -->
<div class="logout-modal" id="stopDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="stopDialogTitle"
    style="width: min(480px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="stopDialogTitle">Move rolls to Finished Stock?</h2>
      <button type="button" class="dialog-close-btn" onclick="closeStopDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <div class="sl-dlg-plan" id="stopPlan"></div>
      <div class="sl-dlg-row">
        <div class="sl-dlg-field">
          <label class="sl-dlg-label" for="stopMeter">Metres actually run</label>
          <input type="number" step="any" min="0" inputmode="decimal" id="stopMeter" class="form-control" />
        </div>
        <div class="sl-dlg-field">
          <label class="sl-dlg-label" for="stopRunningMeter">R. Meter per roll</label>
          <input type="number" step="any" min="0" inputmode="decimal" id="stopRunningMeter" class="form-control" />
        </div>
      </div>
      <div class="sl-dlg-row">
        <div class="sl-dlg-field">
          <label class="sl-dlg-label" for="stopJoint">Joint (optional)</label>
          <input type="text" id="stopJoint" class="form-control" placeholder="—" />
        </div>
        <div class="sl-dlg-field">
          <label class="sl-dlg-label" for="stopJointMtr">Joint at (mtrs)</label>
          <input type="number" step="any" min="0" inputmode="decimal" id="stopJointMtr" class="form-control" placeholder="—" />
        </div>
      </div>
      <div class="sl-dlg-err" id="stopErr"></div>
      <div class="sl-dlg-actions">
        <button type="button" class="sl-dlg-btn is-ghost" onclick="closeStopDialog()">Cancel</button>
        <button type="button" class="sl-dlg-btn is-primary" id="stopConfirmBtn">
          <i class="fa-solid fa-check"></i> Confirm &amp; Move
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ============ CAMERA SCAN ============ -->
<div class="logout-modal" id="scanDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="scanDialogTitle"
    style="width: min(420px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="scanDialogTitle">Scan the Deckle label</h2>
      <button type="button" class="dialog-close-btn" onclick="closeScanDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <video id="scanVideo" playsinline muted autoplay></video>
      <div class="sl-scan-status" id="scanStatus">Point the camera at the QR code on the reel.</div>
    </div>
  </div>
</div>

<script src="/js/jsQR.min.js" defer></script>
<script id="sl-card-data" type="application/json"><%- safeJson(card) %></script>

<script>
  const CARD = JSON.parse(document.getElementById("sl-card-data").textContent);
  const ROWS = CARD.rows;

  const esc = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const round2 = (n) => Math.round(Number(n) * 100) / 100;
  const fmt = (n) => (Number.isFinite(Number(n)) && n !== null && n !== "" ? round2(n).toLocaleString("en-IN") : "—");
  const norm = (v) => String(v ?? "").trim().replace(/\s+/g, "").toUpperCase();
  const nowHHMM = () => {
    const d = new Date();
    return `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
  };
  const toast = (msg, type) => { if (typeof showToast === "function") showToast(msg, type); };

  // Curing gate: a Deckle can't be run until its adhesive has cured (6 h after
  // lamination). The server sends `cured`; re-check the clock here too so a
  // card left open unlocks on its own when the time passes. Hot-melt builds
  // carry no curedAt and are never gated.
  function curedNow(row) {
    const c = row.curing;
    if (!c || c.hotMelt || c.cured) return true;
    if (c.curedAt) return Date.now() >= Date.parse(c.curedAt);
    return false;
  }

  // Which row the scan has confirmed. Only that row's Start is live -- a
  // Deckle has to be identified before it can be run.
  let armedIndex = null;

  // A printed label's QR payload ENDS with the Roll ID (the older format
  // STARTS with it) and a typed entry is the id itself, so matching against
  // this card's own allocated ids covers every case without re-implementing
  // the full Roll ID grammar. Longest match wins, so one id that is a suffix
  // of another can't shadow it.
  function matchDeckle(raw) {
    const compact = norm(raw);
    if (!compact) return null;
    const hits = ROWS
      .map((r, i) => ({ i, id: norm(r.deckleId) }))
      .filter((x) => x.id && (compact === x.id || compact.endsWith(x.id) || compact.startsWith(x.id)))
      .sort((a, b) => b.id.length - a.id.length);
    return hits.length ? hits[0].i : null;
  }

  function webHtml(row) {
    const cuts = (row.cuts || []).filter((c) => Number(c.width) > 0);
    if (!cuts.length) return "";
    const total = round2(cuts.reduce((n, c) => n + Number(c.width), 0));
    const trimW = row.width != null ? round2(Number(row.width) - total) : 0;
    const segs = cuts.map((c) => `
      <div class="sl-web-seg" style="flex-grow:${Number(c.width)}" title="${esc(c.slot)} — ${esc(fmt(c.width))} mm">
        <span class="sl-seg-slot">${esc(c.slot)}</span><span class="sl-seg-w">${esc(fmt(c.width))}</span>
      </div>`);
    if (trimW > 0) {
      segs.push(`
        <div class="sl-web-seg sl-web-trim" style="flex-grow:${trimW}" title="Edge trim — ${esc(fmt(trimW))} mm">
          <span class="sl-seg-slot">TRIM</span><span class="sl-seg-w">${esc(fmt(trimW))}</span>
        </div>`);
    }
    const flag = row.width != null
      ? `${cuts.length} roll${cuts.length === 1 ? "" : "s"} · ${fmt(total)} of ${fmt(row.width)} mm · ${fmt(trimW)} mm trim`
      : `${cuts.length} roll${cuts.length === 1 ? "" : "s"} · ${fmt(total)} mm`;
    return `
      <div>
        <div class="sl-web-caption"><span>Web View</span><span class="sl-web-flag">${esc(flag)}</span></div>
        <div class="sl-web">${segs.join("")}</div>
      </div>`;
  }

  function render() {
    const wrap = document.getElementById("slDeckles");
    wrap.innerHTML = ROWS.map((row, i) => {
      const done = row.status === "done";
      const running = !done && Boolean(row.startTime);
      const curing = !done && !running && !curedNow(row);
      const armed = !done && !running && !curing && armedIndex === i;
      const state = done ? "done" : running ? "running" : curing ? "curing" : armed ? "armed" : "pending";
      const label = done ? "Done" : running ? "Running" : curing ? "Curing" : armed ? "Ready" : "Pending";
      const cureMsg = curing
        ? `Adhesive still curing${row.curing && row.curing.curedAtLabel ? ` — ready at ${esc(row.curing.curedAtLabel)}` : ""} (6 h after lamination)`
        : "";

      const rolls = (row.cuts || []).length;
      const meta = done
        ? `${fmt(row.meter)} mtrs run · ${fmt(row.runningMeter)} mtrs per roll · ${rolls} roll${rolls === 1 ? "" : "s"}`
        : `${fmt(row.width)} mm web · ${fmt(row.plannedMeter)} mtrs planned · ${fmt(row.plannedRunningMeter)} mtrs per roll · ${rolls} roll${rolls === 1 ? "" : "s"}`;
      const short = !done && row.reelMtrs != null && Number(row.plannedMeter) > Number(row.reelMtrs);
      const stock = row.reelMtrs == null
        ? ""
        : `<div class="sl-deckle-meta${short ? " sl-bad" : ""}">${short ? "⚠ " : ""}${esc(fmt(row.reelMtrs))} mtrs left on this reel${short ? ` — less than the ${esc(fmt(row.plannedMeter))} planned` : ""}</div>`;

      const producedIds = (row.cuts || []).map((c) => c.rollId).filter(Boolean);
      const times = [row.startTime ? `Start ${esc(row.startTime)}` : "", row.endTime ? `End ${esc(row.endTime)}` : ""]
        .filter(Boolean).join(" · ");

      return `
        <div class="sl-deckle is-${state}" data-index="${i}">
          <div class="sl-deckle-top">
            <span class="sl-deckle-no">${i + 1}</span>
            <div style="min-width:0; flex:1 1 240px;">
              <div class="sl-deckle-id">${esc(row.deckleId || "—")}</div>
              <div class="sl-deckle-meta">${esc(meta)}</div>
              ${stock}
              ${cureMsg ? `<div class="sl-deckle-meta sl-bad">⏳ ${cureMsg}</div>` : ""}
            </div>
            <span class="sl-badge is-${state}">${label}</span>
          </div>
          ${webHtml(row)}
          <div class="sl-deckle-actions">
            <button type="button" class="sl-punch sl-start" data-act="start" data-index="${i}"
              ${done || running || curing || !armed ? "disabled" : ""}
              title="${done ? "Already run" : running ? "Already started" : curing ? cureMsg : armed ? "" : "Scan this Deckle first"}">
              <i class="fa-solid fa-play"></i> Start
            </button>
            <button type="button" class="sl-punch sl-stop" data-act="stop" data-index="${i}"
              ${running ? "" : "disabled"}
              title="${running ? "" : curing ? cureMsg : "Punch Start first"}">
              <i class="fa-solid fa-stop"></i> Stop
            </button>
            ${times ? `<span class="sl-times">${times}</span>` : ""}
            ${producedIds.length ? `<span class="sl-rolls-out"><i class="fa-solid fa-box"></i> ${esc(producedIds.join(", "))}</span>` : ""}
          </div>
        </div>`;
    }).join("");

    wrap.querySelectorAll("[data-act]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const i = Number(btn.dataset.index);
        if (btn.dataset.act === "start") punchStart(i);
        else openStopDialog(i);
      });
    });

    const done = ROWS.filter((r) => r.status === "done");
    document.getElementById("slSumDone").textContent = `${done.length} / ${ROWS.length}`;
    document.getElementById("slSumMeter").textContent = fmt(done.reduce((n, r) => n + (Number(r.meter) || 0), 0));
    document.getElementById("slSumRolls").textContent = String(
      done.reduce((n, r) => n + (r.cuts || []).filter((c) => c.rollId).length, 0));
    document.getElementById("slSumFinished").textContent = fmt(
      done.reduce((n, r) => n + (Number(r.runningMeter) || 0) * (r.cuts || []).length, 0));
    document.getElementById("slProgress").textContent = `${done.length} of ${ROWS.length} done`;
    document.getElementById("slDoneWrap").style.display = done.length === ROWS.length ? "" : "none";
  }

  function setScanMsg(msg, kind) {
    const el = document.getElementById("slScanMsg");
    el.textContent = msg;
    el.className = "sl-scan-msg" + (kind ? ` sl-${kind}` : "");
  }

  // Arm the row a scanned/typed id identifies, and scroll it into view.
  function armFrom(raw) {
    const i = matchDeckle(raw);
    if (i === null) {
      armedIndex = null;
      render();
      setScanMsg("That Deckle is not on this card.", "bad");
      return false;
    }
    if (ROWS[i].status === "done") {
      armedIndex = null;
      render();
      setScanMsg(`${ROWS[i].deckleId} has already been run on this card.`, "bad");
      return false;
    }
    if (!curedNow(ROWS[i])) {
      armedIndex = null;
      render();
      const lbl = ROWS[i].curing && ROWS[i].curing.curedAtLabel ? ` — ready at ${ROWS[i].curing.curedAtLabel}` : "";
      setScanMsg(`${ROWS[i].deckleId} is still curing (6 h after lamination)${lbl}. It can't be run yet.`, "bad");
      return false;
    }
    armedIndex = i;
    render();
    setScanMsg(`${ROWS[i].deckleId} confirmed — punch Start when the machine runs.`, "ok");
    document.querySelector(`.sl-deckle[data-index="${i}"]`)?.scrollIntoView({ behavior: "smooth", block: "center" });
    return true;
  }

  const scanInput = document.getElementById("slScanInput");
  scanInput.addEventListener("keydown", (e) => {
    if (e.key !== "Enter") return;
    e.preventDefault();
    armFrom(scanInput.value);
  });
  scanInput.addEventListener("change", () => { if (scanInput.value.trim()) armFrom(scanInput.value); });

  async function punchStart(i) {
    const row = ROWS[i];
    if (!row || row.status === "done" || row.startTime) return;
    if (!curedNow(row)) return toast("That Deckle is still curing — it can't be run yet.", "error");
    const startTime = nowHHMM();
    try {
      const res = await fetch("/sachiko/slitting/jobcard/row/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cardId: CARD._id, index: i, startTime }),
      });
      const data = await res.json();
      if (!data.success) return toast(data.message || "Couldn't record the start.", "error");
      row.startTime = data.startTime || startTime;
      render();
      toast(`Started ${row.deckleId} at ${row.startTime}`, "success");
    } catch {
      toast("Server error — the start was not recorded.", "error");
    }
  }

  // ---- Stop ------------------------------------------------------------
  let stopIndex = null;

  function openModal(id) {
    const m = document.getElementById(id);
    m.classList.add("show");
    m.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const m = document.getElementById(id);
    m.classList.remove("show");
    m.setAttribute("aria-hidden", "true");
  }

  function openStopDialog(i) {
    const row = ROWS[i];
    if (!row || row.status === "done" || !row.startTime) return;
    if (!curedNow(row)) return toast("That Deckle is still curing — it can't be run yet.", "error");
    stopIndex = i;
    const rolls = (row.cuts || []).length;
    document.getElementById("stopPlan").innerHTML =
      `<div>${esc(row.deckleId)}</div>`
      + `<div style="color:#64748b;font-weight:600;">Planned ${esc(fmt(row.plannedMeter))} mtrs off the reel · `
      + `${esc(fmt(row.plannedRunningMeter))} mtrs on each of ${rolls} roll${rolls === 1 ? "" : "s"}`
      + (row.reelMtrs != null ? ` · ${esc(fmt(row.reelMtrs))} mtrs on the reel` : "") + `</div>`;
    document.getElementById("stopMeter").value = row.plannedMeter ?? "";
    document.getElementById("stopRunningMeter").value = row.plannedRunningMeter ?? "";
    document.getElementById("stopJoint").value = "";
    document.getElementById("stopJointMtr").value = "";
    document.getElementById("stopErr").style.display = "none";
    openModal("stopDialog");
    document.getElementById("stopMeter").focus();
  }
  window.closeStopDialog = () => { closeModal("stopDialog"); stopIndex = null; };

  document.getElementById("stopConfirmBtn").addEventListener("click", async () => {
    if (stopIndex === null) return;
    const row = ROWS[stopIndex];
    const errEl = document.getElementById("stopErr");
    const showErr = (m) => { errEl.textContent = m; errEl.style.display = "block"; };

    const meter = Number(document.getElementById("stopMeter").value);
    const runningMeter = Number(document.getElementById("stopRunningMeter").value);
    if (!(meter > 0)) return showErr("Enter the metres that actually ran.");
    if (!(runningMeter > 0)) return showErr("Enter the R. Meter wound on each roll.");
    if (row.reelMtrs != null && meter > Number(row.reelMtrs)) {
      return showErr(`Only ${fmt(row.reelMtrs)} mtrs are left on this reel.`);
    }
    errEl.style.display = "none";

    const btn = document.getElementById("stopConfirmBtn");
    btn.disabled = true;
    const endTime = nowHHMM();
    try {
      const res = await fetch("/sachiko/slitting/jobcard/row/produce", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          cardId: CARD._id,
          index: stopIndex,
          meter,
          runningMeter,
          joint: document.getElementById("stopJoint").value,
          jointMtr: document.getElementById("stopJointMtr").value,
          endTime,
        }),
      });
      const data = await res.json();
      if (!data.success) { btn.disabled = false; return showErr(data.message || "Failed to move the rolls."); }

      row.status = "done";
      row.meter = data.meter;
      row.runningMeter = data.runningMeter;
      row.endTime = data.endTime || endTime;
      (data.rollIds || []).forEach((id, n) => { if (row.cuts[n]) row.cuts[n].rollId = id; });
      if (row.reelMtrs != null) row.reelMtrs = round2(Number(row.reelMtrs) - Number(data.meter || 0));
      armedIndex = null;
      scanInput.value = "";
      closeStopDialog();
      render();
      setScanMsg("Scan the next Deckle.", "");
      toast(`${(data.rollIds || []).length} roll(s) inwarded from ${row.deckleId}.`, "success");
    } catch {
      showErr("Server error. Please try again.");
    }
    btn.disabled = false;
  });

  // ---- Camera scan -----------------------------------------------------
  let scanStream = null;
  let scanRafId = null;
  const scanVideo = document.getElementById("scanVideo");
  const scanCanvas = document.createElement("canvas");

  function setScanStatus(msg, bad) {
    const el = document.getElementById("scanStatus");
    el.textContent = msg;
    el.className = "sl-scan-status" + (bad ? " sl-bad" : "");
  }

  function stopScanCamera() {
    if (scanRafId) cancelAnimationFrame(scanRafId);
    scanRafId = null;
    if (scanStream) {
      scanStream.getTracks().forEach((t) => t.stop());
      scanStream = null;
    }
    scanVideo.srcObject = null;
  }
  window.closeScanDialog = () => { closeModal("scanDialog"); stopScanCamera(); };

  function scanFrame() {
    if (!scanStream) return;
    if (scanVideo.readyState === scanVideo.HAVE_ENOUGH_DATA) {
      const vw = scanVideo.videoWidth;
      const vh = scanVideo.videoHeight;
      if (vw && vh) {
        const scale = Math.min(1, 640 / Math.max(vw, vh));
        scanCanvas.width = Math.round(vw * scale);
        scanCanvas.height = Math.round(vh * scale);
        const ctx = scanCanvas.getContext("2d");
        ctx.drawImage(scanVideo, 0, 0, scanCanvas.width, scanCanvas.height);
        const frame = ctx.getImageData(0, 0, scanCanvas.width, scanCanvas.height);
        const code = window.jsQR
          ? window.jsQR(frame.data, frame.width, frame.height, { inversionAttempts: "dontInvert" })
          : null;
        if (code && code.data) {
          closeScanDialog();
          scanInput.value = code.data;
          armFrom(code.data);
          return;
        }
      }
    }
    scanRafId = requestAnimationFrame(scanFrame);
  }

  document.getElementById("slScanBtn").addEventListener("click", async () => {
    setScanStatus("Point the camera at the QR code on the reel.");
    openModal("scanDialog");
    if (!navigator.mediaDevices?.getUserMedia) {
      return setScanStatus("Camera scanning needs a secure (https) connection here. Please type the ID instead.", true);
    }
    if (typeof window.jsQR !== "function") {
      return setScanStatus("Scanner failed to load. Please type the ID instead.", true);
    }
    try {
      scanStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: "environment" } }, audio: false });
      scanVideo.srcObject = scanStream;
      await scanVideo.play();
      scanRafId = requestAnimationFrame(scanFrame);
    } catch {
      setScanStatus("Couldn't open the camera. Please allow camera access, or type the ID instead.", true);
    }
  });

  document.getElementById("scanDialog").addEventListener("click", (e) => {
    if (e.target === e.currentTarget) closeScanDialog();
  });
  document.getElementById("stopDialog").addEventListener("click", (e) => {
    if (e.target === e.currentTarget) closeStopDialog();
  });
  document.addEventListener("visibilitychange", () => { if (document.hidden) closeScanDialog(); });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (document.getElementById("scanDialog").classList.contains("show")) closeScanDialog();
    if (document.getElementById("stopDialog").classList.contains("show")) closeStopDialog();
  });

  render();

  // A card left open across a Deckle's curing deadline should unlock itself.
  // Only re-render while something is actually curing, and never while the
  // Stop dialog is open (it would rebuild the list under the operator).
  if (ROWS.some((r) => r.status !== "done" && !curedNow(r))) {
    setInterval(() => {
      if (document.getElementById("stopDialog").classList.contains("show")) return;
      if (ROWS.some((r) => r.status !== "done" && !curedNow(r))) render();
    }, 60000);
  }
</script>
