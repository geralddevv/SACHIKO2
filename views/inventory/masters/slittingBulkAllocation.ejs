<% layout('/layout/boilerplate') %>

<%
  // Bulk allocation, step 2 of the Slitting Queue's "Choose Deckle" flow: one
  // machine, operator, helper and one A..G knife layout entered once here,
  // applied to every Deckle ticked in that dialog. Submitting posts to
  // routes/system/slitting.js POST "/slitting/bulk-allocate", which creates
  // (or updates) one SlittingJobCard per Deckle, each running its own full
  // remaining metres -- same end result as opening the single-Deckle
  // Allocate page for each of them in turn.
  const isEmpty = (v) => v === undefined || v === null || (typeof v === "string" && v.trim() === "");
  const dash = (v) => (isEmpty(v) ? "—" : v);
%>

<style>
  .span-full { padding: 0 !important; }
  .span-full.form-heading, .span-full.form-subheading { padding: 10px !important; }
  .sl-panel { align-self: stretch; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .sl-sec-head { display: flex; flex-direction: row; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 10px; }
  .sl-sec-head h1 { margin: 0; }
  .sl-head-chip {
    background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.3); color: #fff;
    font-size: 12.5px; font-weight: 700; padding: 3px 11px; border-radius: 999px; white-space: nowrap;
  }

  .sl-job-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1px; background: #e2e8f0; }
  .sl-job-cell { background: #f8fafc; padding: 11px 14px; display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .sl-job-cell.is-input { background: #fff; }
  .sl-job-label {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #7c8ba1; white-space: nowrap;
  }
  .sl-job-label .req { color: #dc2626; }
  .sl-job-cell select.form-control, .sl-job-cell input.form-control {
    height: 34px !important; font-size: 13px !important; width: 100%;
    padding: 4px 24px 4px 8px !important; border-radius: 6px !important; border: 1px solid #cbd5e1 !important;
    background-position: right 7px center; background-size: 10px 7px;
  }
  .sl-job-cell input.form-control { padding: 4px 8px !important; }
  .sl-job-cell select.form-control:focus, .sl-job-cell input.form-control:focus {
    outline: none; border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4,74,120,0.12);
  }

  .sb-deckle-list { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px; }
  .sb-deckle-row {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px; padding: 9px 12px;
    border: 1.5px solid #e6eaf2; border-radius: 8px; font-size: 12.5px;
  }
  .sb-deckle-top { font-weight: 700; color: #1f2a44; min-width: 150px; }
  .sb-deckle-sub { color: #64748b; }
  .sb-deckle-curing {
    margin-left: auto; font-size: 10.5px; font-weight: 700; color: #b45309; background: #fffaf0;
    border: 1px solid #fde8c9; border-radius: 999px; padding: 2px 9px;
  }

  .sl-warn-note {
    align-self: stretch; background: #fff8e1; border: 1px solid #f0c36d; color: #7a5b00;
    border-radius: 8px; padding: 10px 14px; font-size: 12.5px; font-weight: 600; line-height: 1.5;
  }
  .sl-save-wrap { display: flex; flex-direction: column; align-items: center; gap: 7px; width: 100%; }
  #sbSubmitBtn:disabled { opacity: 0.55; cursor: not-allowed; }

  @media screen and (max-width: 768px) {
    .sl-job-grid { grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); }
  }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px">
  <form id="sbForm" autocomplete="off" novalidate>
    <div class="span-full form-heading" style="display:flex; flex-direction:row; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
      <h1>Bulk Slitting Allocation</h1>
      <span class="sl-head-chip"><%= deckles.length %> Deckle<%= deckles.length === 1 ? "" : "s" %></span>
    </div>

    <!-- The Deckles this submit will allocate -- fixed, picked on the
         Slitting Queue's "Choose Deckle" dialog; not editable from here. -->
    <div class="span-full" style="border:none !important;">
      <div class="sl-panel">
        <div class="sb-deckle-list">
          <% deckles.forEach((d) => { %>
            <div class="sb-deckle-row">
              <span class="sb-deckle-top"><%= dash(d.rollId) %></span>
              <span class="sb-deckle-sub"><%= dash(d.reelMtrs) %> mtrs &middot; <%= dash(d.size) %>mm &middot; <%= dash(d.location) %> &middot; lot <%= dash(d.lotNo) %></span>
              <% if (d.curing) { %>
                <span class="sb-deckle-curing"><i class="fa-solid fa-hourglass-half"></i> curing<%= d.curingUntilLabel ? ` &middot; ready ${d.curingUntilLabel}` : "" %></span>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- One machine, operator and helper, applied to every Deckle above. -->
    <div class="span-full" style="border:none !important;">
      <div class="sl-panel">
        <div class="sl-job-grid">
          <div class="sl-job-cell is-input">
            <span class="sl-job-label">Machine <span class="req">*</span></span>
            <select id="sbMachine" class="form-control">
              <option value="" disabled selected hidden><%= machines.length ? "Select machine" : "No slitting machine set up" %></option>
              <% machines.forEach((m) => { %>
                <option value="<%= m._id %>"><%= m.machineName %><%= m.locationName ? " · " + m.locationName : "" %></option>
              <% }) %>
            </select>
          </div>
          <div class="sl-job-cell is-input">
            <span class="sl-job-label">Operator <span class="req">*</span></span>
            <select id="sbOperator" class="form-control">
              <option value="" disabled selected hidden>Select operator</option>
              <% operators.forEach((e) => { %>
                <option value="<%= e._id %>"><%= e.empName %></option>
              <% }) %>
            </select>
          </div>
          <div class="sl-job-cell is-input">
            <span class="sl-job-label">Helper</span>
            <select id="sbHelper" class="form-control">
              <option value="">— none —</option>
              <% helpers.forEach((e) => { %>
                <option value="<%= e._id %>"><%= e.empName %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>
    </div>

    <% if (!machines.length) { %>
    <div class="span-full" style="border:none !important;">
      <div class="sl-warn-note">
        <i class="fa-solid fa-triangle-exclamation"></i>
        No machine is set up as a slitter yet. Add one on the Machine Master with its
        Machine Type set to SLITTING, then come back — this job cannot be allocated without one.
      </div>
    </div>
    <% } %>

    <!-- One A..G knife layout, cut off every Deckle above the same way. -->
    <div class="span-full form-subheading sl-sec-head">
      <h1>Knife Layout</h1>
    </div>
    <div class="span-full" style="border:none !important;">
      <div class="sl-panel">
        <div class="sl-job-grid">
          <% cutSlots.forEach((slot) => { %>
            <div class="sl-job-cell is-input">
              <span class="sl-job-label"><%= slot %> (mm)</span>
              <input type="number" step="any" min="0" inputmode="decimal" class="form-control sb-cut" data-slot="<%= slot %>" placeholder="—" />
            </div>
          <% }) %>
          <div class="sl-job-cell is-input">
            <span class="sl-job-label">R. Meter / roll <span class="req">*</span></span>
            <input type="number" step="any" min="0" inputmode="decimal" id="sbRm" class="form-control" placeholder="Mtrs" />
          </div>
        </div>
      </div>
    </div>

    <div class="span-full btn-grp" style="margin-top: 10px;">
      <div class="sl-save-wrap">
        <button type="submit" id="sbSubmitBtn" class="submit-btn">Allocate to Machine</button>
      </div>
    </div>
  </form>
</div>

<script id="sb-deckles-data" type="application/json"><%- safeJson(deckles) %></script>
<script>
  const DECKLES = JSON.parse(document.getElementById("sb-deckles-data").textContent);

  function showError(msg) {
    if (msg && typeof showToast === "function") showToast(msg, "error");
  }

  document.getElementById("sbForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = document.getElementById("sbSubmitBtn");
    const label = btn.textContent;

    const machineId = document.getElementById("sbMachine").value;
    const operatorId = document.getElementById("sbOperator").value;
    const helperId = document.getElementById("sbHelper").value;
    if (!machineId) return showError("Select a slitting machine.");
    if (!operatorId) return showError("Select an operator.");

    const cuts = {};
    document.querySelectorAll(".sb-cut").forEach((el) => {
      const v = el.value.trim();
      if (v !== "") cuts[el.dataset.slot] = Number(v);
    });
    if (!Object.keys(cuts).length) return showError("Enter at least one roll width (A–G).");
    if (Object.values(cuts).some((v) => !(v > 0))) return showError("Roll widths must be greater than zero.");

    const plannedRunningMeter = Number(document.getElementById("sbRm").value);
    if (!(plannedRunningMeter > 0)) return showError("Enter the R. Meter for each finished roll.");

    const items = DECKLES.map((d) => ({ deckleStockId: d.deckleStockId, pendingId: d.pendingId }));

    btn.disabled = true;
    btn.textContent = "Allocating…";
    try {
      const res = await fetch("/sachiko/slitting/bulk-allocate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ machineId, operatorId, helperId, plannedRunningMeter, cuts, items }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/sachiko/slitting/queue";
        return;
      }
      showError(data.message || "Failed to save the allocation.");
    } catch {
      showError("Server error. Please try again.");
    }
    btn.disabled = false;
    btn.textContent = label;
  });
</script>

<% if (notification && notification.length) { %>
<script>
  const sbFlash = <%- safeJson(notification[0]) %>;
  const sbFlashType = /failed|not found|error|no deckle|invalid|no longer|choose at least/i.test(String(sbFlash)) ? "error" : "success";
  const showSbFlash = () => {
    if (typeof hideStaticToast === "function") hideStaticToast();
    if (typeof showToast === "function") showToast(sbFlash, sbFlashType);
  };
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", showSbFlash, { once: true })
    : showSbFlash();
</script>
<% } %>
