    window.submitMaterialUsage = function submitMaterialUsage() {
      const errorEl = document.getElementById("materialUsedError");
      errorEl.textContent = "";

      const rows = [];
      for (let i = 0; i < activeUsageList.length; i++) {
        const item = activeUsageList[i];
        const fields = POOL_FIELDS[item.pool] || POOL_FIELDS.facestock;
        const input = document.getElementById(`materialRemainingAmount-${i}`);
        const raw = input ? input.value.trim() : "";
        if (input) input.classList.remove("jc-material-used-over");
        if (!raw && raw !== "0") continue;

        const remaining = Number(raw);
        if (!Number.isFinite(remaining) || remaining < 0) {
          errorEl.textContent = `Enter a valid non-negative kg amount for ${item.rollId || "all items"}.`;
          if (input) input.focus();
          return;
        }
        const current = Number(item.reelMtrs) || 0;
        if (remaining > current) {
          if (input) input.classList.add("jc-material-used-over");
          errorEl.textContent = `${item.rollId || "Item"} remaining kg cannot exceed current stock (${fmtMtrs(current)} kg).`;
          if (input) input.focus();
          return;
        }
        const used = Math.max(0, round2(current - remaining));
        rows.push({ fields, stockId: item._id, remainingKg: remaining, usedKg: used });
      }
      if (!rows.length) {
        errorEl.textContent = `Enter remaining kg for at least one used raw material.`;
        document.getElementById("materialRemainingAmount-0")?.focus();
        return;
      }

      rows.forEach(({ fields, stockId, remainingKg, usedKg }) => {
        const sidInput = document.createElement("input");
        sidInput.type = "hidden"; sidInput.name = fields.stockId; sidInput.value = stockId;
        const usedInput = document.createElement("input");
        usedInput.type = "hidden"; usedInput.name = fields.used; usedInput.value = usedKg;
        const remInput = document.createElement("input");
        remInput.type = "hidden"; remInput.name = fields.remaining; remInput.value = remainingKg;
        jcForm.appendChild(sidInput);
        jcForm.appendChild(usedInput);
        jcForm.appendChild(remInput);
      });

      materialUsedCleared = true;
      closeMaterialUsedDialog();
      jcForm.requestSubmit ? jcForm.requestSubmit() : jcForm.submit();
    };

    const scanDialog = document.getElementById("scanDialog");
    const scanVideo = document.getElementById("scanVideo");
    const scanStatus = document.getElementById("scanStatus");
    const scanCanvas = document.createElement("canvas");

    let scanStream = null;
    let scanRafId = null;
    let scanTargetInput = null;

    function setScanStatus(text, isError) {
      if (!scanStatus) return;
      scanStatus.textContent = text;
      scanStatus.classList.toggle("error", Boolean(isError));
    }

    function stopScanCamera() {
      if (scanRafId) cancelAnimationFrame(scanRafId);
      scanRafId = null;
      if (scanStream) {
        scanStream.getTracks().forEach((track) => track.stop());
        scanStream = null;
      }
      if (scanVideo) scanVideo.srcObject = null;
    }

    window.closeScanDialog = function closeScanDialog() {
      closeModal("scanDialog");
      stopScanCamera();
      scanTargetInput = null;
    };

    function scanFrame() {
      if (!scanStream) return;
      if (scanVideo.readyState === scanVideo.HAVE_ENOUGH_DATA) {
        const vw = scanVideo.videoWidth;
        const vh = scanVideo.videoHeight;
        if (vw && vh) {
          const scale = Math.min(1, 640 / Math.max(vw, vh));
          scanCanvas.width = Math.round(vw * scale);
          scanCanvas.height = Math.round(vh * scale);
          const ctx = scanCanvas.getContext("2d");
          ctx.drawImage(scanVideo, 0, 0, scanCanvas.width, scanCanvas.height);
          const frame = ctx.getImageData(0, 0, scanCanvas.width, scanCanvas.height);
          const code = window.jsQR
            ? window.jsQR(frame.data, frame.width, frame.height, { inversionAttempts: "dontInvert" })
            : null;
          if (code && code.data) {
            handleScanSuccess(code.data);
            return;
          }
        }
      }
      scanRafId = requestAnimationFrame(scanFrame);
    }

    function handleScanSuccess(rawText) {
      const input = scanTargetInput;
      closeScanDialog();
      if (!input) return;

      const cleanId = extractScannedRollId(rawText);
      if (!cleanId) {
        if (typeof showToast === "function") showToast("That QR code isn't a valid label.", "error");
        return;
      }

      input.value = cleanId;
      input.dispatchEvent(new Event("input", { bubbles: true }));

      const row = input.closest("tr");
      if (row) {
        if (input.classList.contains("js-fs-roll-id")) row.querySelector(".js-ad-roll-id")?.focus();
        else if (input.classList.contains("js-ad-roll-id")) row.querySelector(".js-rl-roll-id")?.focus();
        else if (input.classList.contains("js-rl-roll-id")) row.querySelector(".js-mtrs1")?.focus();
        else if (input.classList.contains("log-fs-roll-id")) row.querySelector(".log-ad-roll-id")?.focus();
        else if (input.classList.contains("log-ad-roll-id")) row.querySelector(".log-rl-roll-id")?.focus();
        else if (input.classList.contains("log-rl-roll-id")) (row.querySelector(".log-deckle-id") || row.querySelector(".log-meters"))?.focus();
      }
      if (typeof showToast === "function") showToast(`Scanned ID: ${cleanId}`, "success");
    }

    async function openScanDialog(input, title) {
      scanTargetInput = input;
      setScanStatus(`Point the camera at the QR code on the ${title || "material"} label.`);
      openModal("scanDialog");

      if (!navigator.mediaDevices?.getUserMedia) {
        setScanStatus("Camera scanning needs a secure (https) connection here. Please type the ID instead.", true);
        return;
      }
      if (typeof window.jsQR !== "function") {
        setScanStatus("Scanner failed to load. Please type the ID instead.", true);
        return;
      }

      try {
        scanStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: "environment" } },
          audio: false,
        });
        scanVideo.srcObject = scanStream;
        await scanVideo.play();
        scanRafId = requestAnimationFrame(scanFrame);
      } catch (err) {
        setScanStatus("Couldn't open the camera. Please allow camera access, or type the ID instead.", true);
      }
    }

