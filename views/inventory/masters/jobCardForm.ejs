<% layout('/layout/boilerplate') %>

<%
  const jc = prefill || {};
  const ref = jc.materialReference || {};
  const isEmpty = (v) => v === undefined || v === null || (typeof v === "string" && v.trim() === "") || v === "—";
  const dash = (v) => (isEmpty(v) ? "—" : v);
  const fmtQty = (v) => (Number.isFinite(Number(v)) && v !== "" && v != null)
    ? Number(v).toLocaleString("en-IN")
    : dash(v);
  const today = new Date();
  const dateDay = String(today.getDate()).padStart(2, "0");
  const dateMonth = String(today.getMonth() + 1).padStart(2, "0");
  const dateYear = today.getFullYear();
  const dateInputValue = `${dateYear}-${dateMonth}-${dateDay}`;
%>

<style>
  .jc-info-wrap {
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(4,74,120,0.08);
  }
  .span-full {
    padding: 0 !important;
  }
  .span-full.form-heading,
  .span-full.form-subheading {
    padding: 10px !important;
  }
  /* Same stacked label-over-value summary as Assign Production's Material
     Details card (assignProduction.ejs's .material-id-row) -- kept in step
     with that page's field list (Label Stock Code / Size / Running Mtrs /
     Qty / Roll Type / Deckle Size) so both stops in the production flow
     show the same at-a-glance details. */
  .material-id-row {
    /* .jc-info-wrap (its parent) is a column-direction flex box with
       align-items:flex-start -- on the cross axis (width, for a column
       flex container) that means a child sizes to its own content and
       hugs the left edge instead of filling the row. align-self:stretch
       overrides just this child, without touching the shared parent class
       (other .jc-info-wrap rows may rely on the default). */
    display: flex; align-self: stretch; flex-wrap: wrap; gap: 30px; padding: 14px 18px;
    border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc;
  }
  .material-id-row .mid-item { display: flex; flex-direction: column; gap: 4px; }
  .material-id-row .mid-label { font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #7c8ba1; }
  .material-id-row .mid-value { font-size: 19px; font-weight: 800; color: #1f2a44; }

  .jc-log-table {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
  }
  .jc-log-table th {
    background: #044a78;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 6px;
    text-align: center;
    letter-spacing: 0.01em;
    border-right: 1px solid rgba(255,255,255,0.25);
  }
  .jc-log-table th:last-child {
    border-right: none;
  }
  .jc-log-table th.group-head {
    border-bottom: 1px solid rgba(255,255,255,0.3);
  }
  .jc-log-table th.sub-head {
    background: #055690;
    font-size: 11.5px;
    font-weight: 500;
    padding: 5px 6px;
  }

  .jc-hidden { display: none !important; }

  .jc-log-table td {
    padding: 5px 6px;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    vertical-align: middle;
  }
  .jc-log-table td:last-child {
    border-right: none;
  }
  .jc-log-table tr:last-child td {
    border-bottom: none;
  }
  .jc-log-table input.form-control,
  .jc-log-table select.form-control {
    padding: 4px 6px !important;
    font-size: 12.5px !important;
    height: 30px !important;
    min-width: 0;
  }

  .jc-log-table .js-start-display,
  .jc-log-table .js-stop-display,
  .jc-log-table .log-start-display,
  .jc-log-table .log-end-display {
    display: inline-block;
    min-width: 50px;
    font-size: 11.5px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* Production Log rows once moved into the "already entered" table above
     the single entry row -- read as plain text until Edit is punched. */
  .jc-row-readonly td {
    background: #f8fafc;
  }
  .jc-row-readonly input.form-control,
  .jc-row-readonly select.form-control {
    background: transparent !important;
    border-color: transparent !important;
    color: #1f2a44;
    pointer-events: none;
  }
  .jc-row-status-cell {
    width: 170px;
    vertical-align: middle;
  }
  .jc-row-status-cell .log-deckle-note:empty::before {
    content: "—";
    color: #94a3b8;
    font-weight: 600;
  }
  .jc-row-edit-cell {
    text-align: center;
    width: 44px;
  }
  .jc-row-edit-btn {
    width: 28px;
    height: 26px;
    padding: 0;
    border: 1px solid #044A78;
    background: #ffffff;
    color: #044A78;
    border-radius: 4px;
    font-size: 11px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .jc-row-edit-btn:hover {
    background: #044A78;
    color: #ffffff;
  }
  .jc-row-edit-btn.editing {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
  }

  .jc-roll-table {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
    table-layout: fixed;
  }
  .jc-roll-table th {
    background: #f0f7ff;
    color: #03365a;
    font-size: 12px;
    font-weight: 700;
    text-align: left;
    padding: 7px 12px;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    white-space: nowrap;
  }
  .jc-roll-table td {
    color: #1f2a44;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 12px;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    word-break: break-word;
  }
  .jc-roll-table th:last-child,
  .jc-roll-table td:last-child { border-right: none; }
  .jc-roll-table tr:last-child td { border-bottom: none; }
  .jc-allocation-wrap {
    width: 100%;
    align-self: stretch;
    padding: 0;
  }
  /* Collapsible "Material Allocation" header -- click to shrink the table
     away when you don't need it on screen. */
  .jc-collapsible-header:hover { filter: brightness(1.08); }
  .jc-collapse-icon {
    font-size: 14px;
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }
  .jc-collapse-icon.collapsed { transform: rotate(-90deg); }
  .jc-allocation-scroll {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
  }
  .jc-roll-table.jc-allocation-table {
    min-width: 1330px;
    table-layout: auto;
  }
  .jc-roll-table.jc-allocation-table td {
    white-space: nowrap;
    word-break: normal;
    vertical-align: middle;
  }
  /* "Currently Mounted" -- the one column of the merged allocation table
     that isn't a flat fact but a live scan control (input + running history
     of what's already been drawn on), so unlike every other cell here it
     needs to wrap and grow instead of staying a single nowrap line. */
  .jc-roll-table.jc-allocation-table td.jc-mounted-cell {
    white-space: normal;
    vertical-align: top;
    min-width: 260px;
    padding: 8px !important;
  }
  .jc-no-rolls {
    padding: 10px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #92400e;
    background: #fffbeb;
  }

  .jc-readonly {
    background: #f0f7ff !important;
    color: #044a78 !important;
    font-weight: 700 !important;
    cursor: default !important;
  }

  .roll-note {
    display: block;
    margin-top: 2px;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.25;
  }
  .roll-note:empty { display: none; }
  .roll-note.ok { color: #047857; }
  .roll-note.warn { color: #b45309; }

  .roll-id-field { display: flex; align-items: center; gap: 4px; width: 100%; min-width: 80px; }
  .roll-scan-btn {
    display: inline-flex;
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 4px;
    background: #044a78;
    color: #fff;
    font-size: 11px;
    cursor: pointer;
  }
  .roll-scan-btn:hover { opacity: 0.88; }

  /* Materials-in-use -- one column per material (Facestock / Adhesive /
     Release), Jumbo FS / Drum / Jumbo REL id are scanned ONCE here and
     carried into every Job Setting row and the single Production Log entry
     row automatically, instead of being re-scanned on every line. Each
     column stacks every roll already scanned this job (oldest first) as a
     running feed, with the active scan field always at the bottom -- so
     what's mounted right now is always the last thing in the column. Add
     swaps in a new roll once the current one runs out. */
  /* One .jc-material-slot per pool, now embedded as the last cell of that
     pool's row in the merged allocation table (jc-mounted-cell) instead of
     living in its own separate grid/section. */
  .jc-material-slot {
    min-width: 220px;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #dbe4f0;
    border-radius: 8px;
    padding: 10px;
  }
  .jc-material-col-head {
    font-size: 12px;
    font-weight: 800;
    color: #ffffff;
    background: #044a78;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-align: center;
    padding: 5px 8px;
    border-radius: 5px;
    margin-bottom: 8px;
  }
  .jc-material-scanned-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 8px;
    max-height: 220px;
    overflow-y: auto;
  }
  .jc-material-scanned-row {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    background: #f7fafd;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 5px 8px;
  }
  .jc-material-scanned-row .idx {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #044a78;
    color: #ffffff;
    font-size: 9.5px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .jc-material-scanned-row .body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .jc-material-scanned-row .roll {
    font-size: 12px;
    font-weight: 700;
    color: #03365a;
    word-break: break-word;
  }
  .jc-material-scanned-row .meta {
    font-size: 10.5px;
    color: #5a6586;
    font-weight: 600;
  }
  .jc-material-scanned-row .empty-tag {
    color: #b91c1c;
    font-weight: 700;
  }
  .jc-material-slot-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .jc-material-slot-row .roll-id-field { flex: 1 1 auto; }
  .jc-material-slot input.form-control {
    padding: 6px 8px !important;
    font-size: 13px !important;
    height: 32px !important;
  }
  .jc-material-slot input.form-control[readonly] {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #03365a;
    font-weight: 700;
  }
  .jc-material-add-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 32px;
    padding: 0 10px;
    border: 1px solid #044A78;
    background: #ffffff;
    color: #044A78;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }
  .jc-material-add-btn:hover { background: #044A78; color: #ffffff; }

  /* "How much is left?" swap dialog */
  .jc-swap-current {
    background: #f0f7ff;
    border: 1px solid #d7e6f5;
    border-radius: 8px;
    padding: 10px 12px;
  }
  .jc-swap-current-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    font-size: 12.5px;
  }
  .jc-swap-current-row + .jc-swap-current-row { margin-top: 6px; }
  .jc-swap-current-label { color: #5a6586; font-weight: 600; }
  .jc-swap-current-row strong { color: #03365a; font-size: 13.5px; }

  .dialog-header {
    background: #044a78; padding: 18px 22px;
    display: flex; align-items: center; justify-content: space-between;
    border-radius: 14px 14px 0 0;
  }
  .dialog-header h2 { margin: 0; font-size: 1.05rem; font-weight: 700; color: #fff; }
  .dialog-close-btn {
    background: none; border: none; color: #fff; font-size: 20px;
    cursor: pointer; line-height: 1; padding: 0 2px; opacity: 0.8;
  }
  .dialog-close-btn:hover { opacity: 1; }
  .dialog-body { padding: 18px 20px; background: #fff; border-radius: 0 0 14px 14px; }
  .dialog-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 14px; }
  .btn-cancel {
    border-radius: 8px; padding: 9px 18px; font-size: 13.5px; font-weight: 600;
    cursor: pointer; border: none; background: #f1f5f9; color: #44506b;
  }

  .jc-material-used-hint { margin: 0 0 14px; font-size: 12.5px; color: #5a6586; }
  .jc-material-used-scroll {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    /* Caps the row list so a recipe with many layers/reels scrolls inside
       the dialog instead of growing the dialog past the viewport -- the
       hint text above and Confirm/Cancel below stay reachable without
       having to scroll the page itself. */
    max-height: min(50vh, 420px);
    overflow-y: auto;
  }
  .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }
  .custom-scrollbar { scrollbar-width: thin; scrollbar-color: #044A78 #f1f5f9; }
  .jc-roll-table.jc-material-used-table {
    min-width: 1160px;
    table-layout: auto;
  }
  .jc-roll-table.jc-material-used-table th,
  .jc-roll-table.jc-material-used-table td {
    white-space: nowrap;
    word-break: normal;
    vertical-align: middle;
  }
  .jc-material-used-status {
    color: #16a34a;
    font-weight: 700;
  }
  .jc-material-used-status.status-not-used {
    color: #b91c1c;
    background: #fee2e2;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid #fca5a5;
    font-size: 11px;
    font-weight: 700;
    display: inline-block;
  }
  .jc-material-used-status.status-used {
    color: #15803d;
    background: #dcfce7;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid #bbf7d0;
    font-size: 11px;
    font-weight: 700;
    display: inline-block;
  }
  .jc-material-used-status.status-newly-used {
    color: #0369a1;
    background: #e0f2fe;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid #bae6fd;
    font-size: 11px;
    font-weight: 700;
    display: inline-block;
  }
  .jc-material-row-not-used {
    background-color: #fef2f2 !important;
  }
  .jc-material-row-not-used td {
    background-color: #fef2f2 !important;
    color: #991b1b !important;
  }
  .jc-material-row-not-used strong {
    color: #b91c1c !important;
  }
  .jc-material-row-not-used .jc-material-used-amount {
    border-color: #fca5a5;
    background-color: #ffffff;
  }
  .jc-material-used-amount {
    width: 100px; flex: 0 0 auto; padding: 8px 10px; font-size: 13.5px;
    border: 1.5px solid #d7deea; border-radius: 8px; text-align: right;
  }
  .jc-material-used-amount:focus { outline: none; border-color: #044a78; box-shadow: 0 0 0 3px rgba(4,74,120,0.12); }
  .jc-material-used-amount.jc-material-used-over { border-color: #dc2626; }
  .jc-material-used-error { color: #dc2626; font-size: 12px; margin-top: 10px; min-height: 16px; }
  .jc-material-confirm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 9px 18px;
    border: 0;
    border-radius: 8px;
    background: #044a78 !important;
    box-shadow: 0 3px 9px rgba(4, 74, 120, 0.28);
    color: #fff;
    font-size: 13.5px;
    font-weight: 700;
  }
  .jc-material-confirm:focus-visible {
    outline: 3px solid rgba(4, 74, 120, 0.32);
    outline-offset: 2px;
  }

  .jc-save-wrap {
    display: flex;
    justify-content: center;
    padding: 14px;
    border: 0;
    background: #eff8ff;
    box-shadow: 0 4px 16px rgba(4, 74, 120, 0.13);
  }
  .jc-save-wrap .jc-save-action {
    width: min(100%, 360px);
    min-height: 48px;
    padding: 12px 22px;
    border: 0;
    border-radius: 9px;
    background: #044a78;
    box-shadow: 0 4px 10px rgba(4, 74, 120, 0.28);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .jc-save-wrap .jc-save-action:focus-visible {
    outline: 3px solid rgba(8, 112, 174, 0.35);
    outline-offset: 3px;
  }
  .jc-save-wrap .jc-save-action:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
    box-shadow: none;
  }

  /* Submit button -- light/outlined at rest, inverts to solid dark navy on
     hover (no scale/glow, just the background+text swap). Scoped by id so
     it wins over the site-wide .btn-grp button:hover glow (common.css)
     without touching that global rule or the Start Production Log button,
     which still uses the default .jc-save-action look. */
  #saveEntryBtn {
    background: #eaf2fc;
    color: #044a78;
    border: 1px solid #044a78;
    box-shadow: none;
  }
  #saveEntryBtn:hover {
    background: #044a78;
    color: #ffffff;
    box-shadow: none;
    transform: none;
    cursor: pointer;
  }
  #saveEntryBtn:active {
    background: #03365a;
    color: #ffffff;
    box-shadow: none;
    transform: none;
    cursor: pointer;
  }

  .scan-video-wrap {
    position: relative; width: 100%; aspect-ratio: 4 / 3;
    background: #0b1220; border-radius: 10px; overflow: hidden;
  }
  .scan-video-wrap video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .scan-frame {
    position: absolute; inset: 12% 18%;
    border: 3px solid rgba(255, 255, 255, 0.85);
    border-radius: 12px;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }
  .scan-status { margin-top: 10px; font-size: 12.5px; color: #5a6586; text-align: center; min-height: 18px; }
  .scan-status.error { color: #b91c1c; font-weight: 600; }

  @media screen and (max-width: 768px) {
    .jc-roll-table { table-layout: auto; }
    .jc-roll-table thead { display: none; }
    .jc-roll-table tbody,
    .jc-roll-table tr,
    .jc-roll-table td { display: block; width: 100%; }
    .jc-roll-table tbody tr { border-bottom: 2px solid #044a78; }
    .jc-roll-table tbody tr:last-child { border-bottom: none; }
    .jc-roll-table td {
      display: flex; align-items: center; gap: 10px;
      padding: 6px 10px; border-right: none; font-size: 12.5px;
      text-align: left !important;
    }
    .jc-roll-table td::before {
      content: attr(data-label);
      flex: 0 0 34%; color: #5a6586; font-weight: 700; font-size: 12px;
    }
    .jc-roll-table td:first-child { background: #f0f7ff; color: #03365a; font-weight: 700; }

    .jc-roll-table.jc-allocation-table { min-width: 1330px; table-layout: auto; }
    .jc-roll-table.jc-allocation-table thead { display: table-header-group; }
    .jc-roll-table.jc-allocation-table tbody { display: table-row-group; }
    .jc-roll-table.jc-allocation-table tr { display: table-row; border-bottom: none; }
    .jc-roll-table.jc-allocation-table td {
      display: table-cell; width: auto; padding: 7px 12px; border-right: 1px solid #e2e8f0;
      white-space: nowrap; word-break: normal; font-size: 12.5px;
    }
    .jc-roll-table.jc-allocation-table td.jc-mounted-cell { white-space: normal; vertical-align: top; }
    .jc-roll-table.jc-allocation-table td::before { display: none; }
    .jc-roll-table.jc-allocation-table td:first-child { background: #f0f7ff; color: #03365a; font-weight: 700; }

    .jc-roll-table.jc-material-used-table { min-width: 1160px; table-layout: auto; }
    .jc-roll-table.jc-material-used-table thead { display: table-header-group; }
    .jc-roll-table.jc-material-used-table tbody { display: table-row-group; }
    .jc-roll-table.jc-material-used-table tr { display: table-row; border-bottom: none; }
    .jc-roll-table.jc-material-used-table td {
      display: table-cell; width: auto; padding: 7px 12px; border-right: 1px solid #e2e8f0;
      white-space: nowrap; word-break: normal; font-size: 12.5px;
    }
    .jc-roll-table.jc-material-used-table td::before { display: none; }
    .jc-roll-table.jc-material-used-table td:first-child { background: #f0f7ff; color: #03365a; font-weight: 700; }

    .jc-log-table thead { display: none; }
    .jc-log-table tbody,
    .jc-log-table tfoot,
    .jc-log-table tr,
    .jc-log-table td { display: block; width: 100%; }
    .jc-log-table tbody tr {
      display: flex; flex-wrap: wrap; width: auto;
      border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; margin-bottom: 10px;
    }
    .jc-log-table tbody tr:last-child { margin-bottom: 0; }
    .jc-log-table tbody td { flex: 1 1 100%; }
    .jc-log-table tbody td[data-label="Row"] {
      flex: 0 0 44px; justify-content: center;
      border-right: 1px solid #cbd5e1;
      border-radius: 7px 0 0 0;
    }
    .jc-log-table tbody td[data-label="Row"] { border-bottom: 1px solid #cbd5e1; }
    .jc-log-table tbody td[data-label="Row"]::before { content: none; }

    .jc-log-table tbody td[data-label="Mtrs"],
    .jc-log-table tbody td[data-label="Start"],
    .jc-log-table tbody td[data-label="Stop"] { flex: 1 1 40%; flex-wrap: wrap; }
    .jc-log-table tbody td[data-label="Mtrs"] { border-right: 1px solid #cbd5e1; }
    .jc-log-table tbody td[data-label="Mtrs"]::before { flex: 0 0 auto; }
    .jc-log-table tbody td[data-label="Start"]::before,
    .jc-log-table tbody td[data-label="Stop"]::before { content: none; }

    .jc-log-table tbody td[data-label="Face Joint"],
    .jc-log-table tbody td[data-label="Face Mtrs"],
    .jc-log-table tbody td[data-label="Rel. Joint"],
    .jc-log-table tbody td[data-label="Rel. Mtrs"] { flex: 1 1 50%; }
    .jc-log-table tbody td[data-label="Face Joint"],
    .jc-log-table tbody td[data-label="Rel. Joint"] { border-right: 1px solid #cbd5e1; }
    .jc-log-table tbody td[data-label="Face Joint"],
    .jc-log-table tbody td[data-label="Face Mtrs"] { border-bottom: 1px solid #cbd5e1; }
    .jc-log-table td {
      display: flex; align-items: center; gap: 10px;
      padding: 7px 10px; border-right: none; min-width: 0 !important;
      white-space: normal !important; text-align: left !important;
    }
    .jc-log-table td::before {
      content: attr(data-label);
      flex: 0 0 34%; color: #5a6586; font-weight: 700; font-size: 12px;
    }
    .jc-log-table td:not([data-label])::before { content: none; }
    .jc-log-table tbody td:first-child { background: #f0f7ff; }
    .jc-log-table tbody td:last-child { border-bottom: none; }
    .jc-log-table input.form-control,
    .jc-log-table select.form-control { width: 100% !important; flex: 1 1 auto; min-width: 0 !important; }
    .roll-scan-btn { display: inline-flex; width: 36px; height: 36px; font-size: 14px; }
    .jc-log-table .js-start-btn,
    .jc-log-table .js-stop-btn,
    .jc-log-table .log-start-btn,
    .jc-log-table .log-stop-btn {
      flex: 1 1 auto;
      width: auto !important;
      height: 36px !important;
      font-size: 14px !important;
    }
    .jc-log-table .js-start-display,
    .jc-log-table .js-stop-display,
    .jc-log-table .log-start-display,
    .jc-log-table .log-end-display { flex: 0 0 auto; margin-right: 0 !important; min-width: 0; }

    .jc-log-table .jc-total-row {
      display: flex; flex-wrap: wrap; width: auto;
      border-radius: 8px; overflow: hidden; margin-top: 10px;
    }
    .jc-log-table .jc-total-row .jc-total-label {
      flex: 1 1 100%; width: auto; text-align: left !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    }
    .jc-log-table .jc-total-row td {
      flex: 1 1 0; width: auto; min-width: 0;
      flex-direction: column; align-items: stretch; gap: 4px;
    }
    .jc-log-table .jc-total-row td::before { color: #ffffff; flex: 0 0 auto; }

    .form-subheading { flex-wrap: wrap; }
  }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px">
  <form
    id="jcForm"
    action="/sachiko/machine/jobcard/form"
    method="POST"
    autocomplete="off"
    novalidate
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="submissionToken" value="<%= typeof submissionToken !== 'undefined' ? submissionToken : '' %>" />
    <input type="hidden" name="pendingId" value="<%= pendingId %>" />
    <input type="hidden" name="machineId" value="<%= machine ? machine._id : '' %>" />
    <input type="hidden" name="date" value="<%= dateInputValue %>" />
    <input type="hidden" name="machineNo" value="<%= machine ? machine.machineName : '' %>" />
    <input type="hidden" name="lotNo" value="<%= isEmpty(jc.lotNo) ? '' : jc.lotNo %>" />
    <input type="hidden" name="quantity" value="<%= isEmpty(jc.quantity) ? '' : jc.quantity %>" />
    <input type="hidden" name="productCode" value="<%= isEmpty(jc.productCode) ? '' : jc.productCode %>" />
    <input type="hidden" name="rolls" value="<%= isEmpty(jc.rolls) ? '' : jc.rolls %>" />
    <input type="hidden" name="paperSize" value="<%= isEmpty(ref.paperSize || jc.paperSize) ? '' : (ref.paperSize || jc.paperSize) %>" />
    <input type="hidden" name="operatorName" value="<%= isEmpty(jc.operatorName) ? '' : jc.operatorName %>" />
    <input type="hidden" name="helperName" value="<%= isEmpty(jc.helperName) ? '' : jc.helperName %>" />

    <div class="span-full form-heading">
      <h1>Production Entry</h1>
    </div>

    <div class="span-full jc-info-wrap">
      <div class="material-id-row">
        <div class="mid-item"><span class="mid-label">Label Stock Code</span><span class="mid-value"><%= dash(jc.productCode) %></span></div>
        <div class="mid-item"><span class="mid-label">Size</span><span class="mid-value"><%= dash(jc.paperSize) %></span></div>
        <div class="mid-item"><span class="mid-label">Running Mtrs</span><span class="mid-value"><%= fmtQty(jc.runningMeters) %></span></div>
        <div class="mid-item"><span class="mid-label">Qty</span><span class="mid-value"><%= fmtQty(jc.quantity) %></span></div>
        <div class="mid-item"><span class="mid-label">Roll Type</span><span class="mid-value"><%= dash(jc.rollType) %></span></div>
        <div class="mid-item"><span class="mid-label">Deckle Size</span><span class="mid-value"><%= dash(jc.deckleSize) %></span></div>
      </div>
    </div>

    <!-- Material Allocation & Usage -- one row per raw-material pool
         (always exactly 3: Facestock / Adhesive / Release, never per-layer,
         so a DOUBLE FACESTOCK/DOUBLE RELEASE recipe's extra layer folds into
         its own pool's row instead of adding a 4th/5th line) merging what
         used to be two separate sections: the read-only allotment summary,
         and the live "scan what's mounted" control. Each row's last column
         IS that pool's scan control -- see jc-mounted-cell below -- so
         switching to a reel other than the one already allotted is done
         right where the allotment itself is shown, not in a disconnected
         panel further down the page. -->
    <% const allocLayers = jc.layerAllotments || []; %>
    <%
      const usageItems = allocLayers.flatMap((l) =>
        (l.reels || []).map((r) => ({ ...r, pool: l.pool, unit: l.unit, layerLabel: l.label }))
      );
      const POOL_META = {
        facestock: { label: "Facestock", code: "fs", datalist: "allottedFsRollList", placeholder: "Scan FS", scanName: "Jumbo FS", unitFallback: "Roll" },
        adhesive: { label: "Adhesive", code: "ad", datalist: "allottedAdRollList", placeholder: "Scan Drum", scanName: "Drum", unitFallback: "Drum" },
        release: { label: "Release Liner", code: "rl", datalist: "allottedRlRollList", placeholder: "Scan REL", scanName: "Jumbo REL", unitFallback: "Roll" },
      };
      // Status reflects what's actually happening RIGHT NOW, not just the
      // paper reservation: running (this pool has a reel live -- Start's
      // already been punched with it scanned in, see PendingProduction.
      // liveMaterialInUse) outranks used (fully resolved via a Materials in
      // Use "Add", see materialSwapLog) which outranks a plain reservation,
      // which itself splits full/partial for a DOUBLE recipe's 2-layer pool
      // (facestock+facestock2, etc.) rather than flattening straight to
      // Allotted the moment either one has a reel.
      const liveByPool = (typeof liveMaterialInUse !== 'undefined' && liveMaterialInUse) ? liveMaterialInUse : {};
      const swapLogEntries = (typeof materialSwapLog !== 'undefined' && materialSwapLog) ? materialSwapLog : [];
      const poolRows = Object.keys(POOL_META).map((pool) => {
        const layers = allocLayers.filter((l) => l.pool === pool);
        const allocatedCount = layers.filter((l) => l.allocated).length;
        const isLive = Array.isArray(liveByPool[pool]) && liveByPool[pool].length > 0;
        const isUsed = swapLogEntries.some((s) => s.pool === pool);
        const status = allocatedCount === 0
          ? "none"
          : isLive
          ? "running"
          : isUsed
          ? "used"
          : allocatedCount === layers.length
          ? "full"
          : "partial";
        return {
          pool,
          meta: POOL_META[pool],
          unit: layers[0]?.unit || POOL_META[pool].unitFallback,
          status,
          reels: layers.filter((l) => l.allocated).flatMap((l) => l.reels || []),
        };
      });
    %>
    <div class="span-full form-subheading jc-collapsible-header" id="allocationHeader"
         style="display:flex; align-items:center; justify-content:space-between; cursor:pointer;"
         role="button" tabindex="0" aria-expanded="true" aria-controls="allocationWrap">
      <h1>Material Allocation &amp; Usage</h1>
      <i class="fa-solid fa-chevron-down jc-collapse-icon" id="allocationChevron" aria-hidden="true"></i>
    </div>

    <div class="span-full jc-info-wrap jc-allocation-wrap" id="allocationWrap">
      <% if (allocLayers.length) { %>
        <div class="jc-allocation-scroll">
        <table class="jc-roll-table jc-allocation-table" id="curMaterialsPanel">
          <thead>
            <tr>
              <th style="width:150px;">Layer</th>
              <th style="width:120px;">Status</th>
              <th>Qty</th>
              <th>Roll / Drum ID</th>
              <th>Code</th>
              <th>GSM</th>
              <th>Size</th>
              <th>Make</th>
              <th>Location</th>
              <th style="min-width:260px;">Currently Mounted</th>
            </tr>
          </thead>
          <tbody>
            <% poolRows.forEach((pr) => { %>
              <tr>
                <td data-label="Layer"><%= pr.meta.label %></td>
                <td data-label="Status">
                  <% if (pr.status === "running") { %>
                    <span style="color:#047857; font-weight:700;"><i class="fa-solid fa-circle-play" aria-hidden="true"></i> In Use</span>
                  <% } else if (pr.status === "used") { %>
                    <span style="color:#5a6586; font-weight:700;">Used</span>
                  <% } else if (pr.status === "full") { %>
                    <span style="color:#16a34a; font-weight:700;">Allotted</span>
                  <% } else if (pr.status === "partial") { %>
                    <span style="color:#b45309; font-weight:700;">Partly Allotted</span>
                  <% } else { %>
                    <span style="color:#dc2626; font-weight:700;">Not Allotted</span>
                  <% } %>
                </td>
                <%
                  const reels = pr.reels;
                  const totalKg = reels.reduce((sum, r) => sum + (Number(r.reelMtrs) || 0), 0);
                  const reelIds = reels.map((r) => r.rollId).filter(Boolean);
                  const reelLocations = [...new Set(reels.map((r) => r.location).filter(Boolean))];
                  const reelCodes = reels.map((r) => r.code).filter(Boolean);
                  const reelGsms = reels.map((r) => r.gsm).filter((v) => v !== undefined && v !== null && v !== "");
                  const reelSizes = reels.map((r) => r.size).filter(Boolean);
                  const reelMakes = reels.map((r) => r.make).filter(Boolean);
                %>
                <td data-label="Qty"><%= reels.length ? `${reels.length} ${pr.unit}${reels.length === 1 ? "" : "s"}${totalKg ? ` (${fmtQty(totalKg)} kg)` : ""}` : "—" %></td>
                <td data-label="Roll / Drum ID"><%= reelIds.length ? reelIds.join(", ") : "—" %></td>
                <td data-label="Code"><%= reelCodes.length ? reelCodes.join(", ") : "—" %></td>
                <td data-label="GSM"><%= reelGsms.length ? reelGsms.map((gsm) => `${fmtQty(gsm)} GSM`).join(", ") : "—" %></td>
                <td data-label="Size"><%= reelSizes.length ? reelSizes.join(", ") : "—" %></td>
                <td data-label="Make"><%= reelMakes.length ? reelMakes.join(", ") : "—" %></td>
                <td data-label="Location"><%= reelLocations.length ? reelLocations.join(", ") : "—" %></td>
                <td data-label="Currently Mounted" class="jc-mounted-cell">
                  <div class="jc-material-slot" data-pool="<%= pr.meta.code %>">
                    <div class="jc-material-scanned-list" id="materialScannedList-<%= pr.meta.code %>"></div>
                    <div class="jc-material-slot-row">
                      <div class="roll-id-field">
                        <input type="text" class="form-control jc-cur-roll-input" data-pool="<%= pr.meta.code %>" list="<%= pr.meta.datalist %>"
                               placeholder="<%= pr.meta.placeholder %>" autocomplete="off" />
                        <button type="button" class="roll-scan-btn jc-cur-scan-btn" data-pool="<%= pr.meta.code %>" aria-label="Scan <%= pr.meta.scanName %> ID with camera" title="Scan QR with camera">
                          <i class="fa-solid fa-camera"></i>
                        </button>
                      </div>
                      <button type="button" class="jc-material-add-btn" data-pool="<%= pr.meta.code %>" style="display:none;" title="This <%= pr.meta.scanName.toLowerCase() %> is finished — scan the next one">
                        <i class="fa-solid fa-plus"></i> Add
                      </button>
                    </div>
                    <span class="roll-note"></span>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      <% } else { %>
        <div class="jc-no-rolls">
          This SKU has no raw-material recipe to allocate.
        </div>
      <% } %>
    </div>

    <%
      const eligibleFs = (typeof eligibleRawStock !== 'undefined' && eligibleRawStock.facestock) ? eligibleRawStock.facestock : (allocLayers.filter(l => l.pool === 'facestock').flatMap(l => l.reels || []));
      const eligibleAd = (typeof eligibleRawStock !== 'undefined' && eligibleRawStock.adhesive) ? eligibleRawStock.adhesive : (allocLayers.filter(l => l.pool === 'adhesive').flatMap(l => l.reels || []));
      const eligibleRl = (typeof eligibleRawStock !== 'undefined' && eligibleRawStock.release) ? eligibleRawStock.release : (allocLayers.filter(l => l.pool === 'release').flatMap(l => l.reels || []));

      const sortedFs = [...eligibleFs].sort((a, b) => (b.allotted ? 1 : 0) - (a.allotted ? 1 : 0));
      const sortedAd = [...eligibleAd].sort((a, b) => (b.allotted ? 1 : 0) - (a.allotted ? 1 : 0));
      const sortedRl = [...eligibleRl].sort((a, b) => (b.allotted ? 1 : 0) - (a.allotted ? 1 : 0));
    %>

    <datalist id="allottedFsRollList">
      <% sortedFs.forEach((r) => { %>
        <% if (r.rollId) { %><option value="<%= r.rollId %>"><%= r.allotted ? "[Allotted] " : "[Stock] " %><%= fmtQty(r.reelMtrs) %> kg<%= r.location ? " · " + r.location : "" %><%= r.family ? " · " + r.family : "" %><%= r.gsm ? " · " + r.gsm + " GSM" : (r.micron ? " · " + r.micron + " mic" : "") %><%= r.type ? " · " + r.type : "" %><%= r.size ? " · " + r.size : "" %></option><% } %>
      <% }) %>
    </datalist>
    <datalist id="allottedAdRollList">
      <% sortedAd.forEach((r) => { %>
        <% if (r.rollId) { %><option value="<%= r.rollId %>"><%= r.allotted ? "[Allotted] " : "[Stock] " %><%= fmtQty(r.reelMtrs) %> kg<%= r.location ? " · " + r.location : "" %><%= r.make ? " · " + r.make : "" %><%= r.code ? " · " + r.code : (r.type ? " · " + r.type : "") %></option><% } %>
      <% }) %>
    </datalist>
    <datalist id="allottedRlRollList">
      <% sortedRl.forEach((r) => { %>
        <% if (r.rollId) { %><option value="<%= r.rollId %>"><%= r.allotted ? "[Allotted] " : "[Stock] " %><%= fmtQty(r.reelMtrs) %> kg<%= r.location ? " · " + r.location : "" %><%= r.sensing ? " · " + r.sensing : "" %><%= r.type ? " · " + r.type : "" %><%= r.size ? " · " + r.size : "" %></option><% } %>
      <% }) %>
    </datalist>
    <script id="allotted-rolls-data" type="application/json"><%- safeJson(jc.allottedRollDetails || []) %></script>
    <script id="allotted-fs-rolls-data" type="application/json"><%- safeJson(eligibleFs) %></script>
    <script id="allotted-ad-rolls-data" type="application/json"><%- safeJson(eligibleAd) %></script>
    <script id="allotted-rl-rolls-data" type="application/json"><%- safeJson(eligibleRl) %></script>
    <script id="material-usage-data" type="application/json"><%- safeJson(usageItems) %></script>
    <script id="material-swap-log-data" type="application/json"><%- safeJson(typeof materialSwapLog !== 'undefined' ? materialSwapLog : []) %></script>

    <!-- Job Setting -->
    <div class="span-full form-subheading" style="display: flex; align-items: center; gap: 12px; margin-top: 10px;">
      <h1>Job Setting</h1>
      <div style="display: inline-flex; align-items: center; gap: 6px; margin-left: 10px;">
        <button type="button" id="jsMinus" style="width: 28px; height: 28px; border: 1px solid #044A78; background: white; color: #044A78; border-radius: 4px; font-size: 16px; line-height: 1; cursor: pointer;">-</button>
        <input type="text" id="jsCount" style="width: 48px; height: 28px; text-align: center; border: 1px solid #044A78; border-radius: 4px; font-size: 13px;" class="form-control" value="1" readonly />
        <button type="button" id="jsPlus" style="width: 28px; height: 28px; border: 1px solid #044A78; background: white; color: #044A78; border-radius: 4px; font-size: 16px; line-height: 1; cursor: pointer;">+</button>
      </div>
    </div>

    <div class="span-full" style="overflow-x: auto;">
      <table class="jc-log-table">
        <thead>
          <tr>
            <th style="width:60px; text-align:center;">#</th>
            <th>Mtrs</th>
            <th style="text-align:center; white-space:nowrap;">Start</th>
            <th>Mtrs</th>
            <th style="text-align:center; white-space:nowrap;">Stop</th>
          </tr>
        </thead>
        <tbody id="jsTableBody">
        </tbody>
      </table>
    </div>

    <!-- Shown once every Job Setting row is punched (both its Start and Stop
         readings taken) -- clicking it is what reveals Production Log below,
         so setup and actual production are entered as two distinct steps. -->
    <div class="btn-grp jc-save-wrap span-full jc-hidden" id="startProdLogWrap" style="margin-top: 10px;">
      <button type="button" id="startProdLogBtn" class="jc-save-action">
        <i class="fa-solid fa-play" aria-hidden="true"></i> Start Production Log
      </button>
    </div>

    <!-- Production Log -->
    <div class="span-full form-subheading jc-hidden" id="prodLogHead" style="display: flex; align-items: center; gap: 12px; margin-top: 10px;">
      <h1>Production Log</h1>
    </div>

    <!-- Already-entered Production Log rows -- a running record of every roll
         punched so far this job. Read/edit here; the single row below is
         only ever for the next roll being entered. Hidden until the first
         row is punched Stop and moved up into it. -->
    <div class="span-full jc-hidden" id="prodLogDoneWrap" style="overflow-x: auto;">
      <table class="jc-log-table">
        <thead>
          <tr>
            <th rowspan="2" style="vertical-align: middle; width:32px; text-align:center;">#</th>
            <th colspan="4" class="group-head">Start / Stop</th>
            <th rowspan="2" style="vertical-align: middle; width:75px;">Mtrs</th>
            <th colspan="2" class="group-head">Face</th>
            <th colspan="2" class="group-head">Release</th>
            <th rowspan="2" style="vertical-align: middle; width:170px;">Status</th>
            <th rowspan="2" style="vertical-align: middle; width:44px; text-align:center;">Edit</th>
          </tr>
          <tr>
            <th class="sub-head" style="width:70px;">Mtrs</th>
            <th class="sub-head" style="width:92px;">Start</th>
            <th class="sub-head" style="width:70px;">Mtrs</th>
            <th class="sub-head" style="width:92px;">Stop</th>
            <th class="sub-head" style="width:80px;">Joint</th>
            <th class="sub-head" style="width:65px;">Mtrs</th>
            <th class="sub-head" style="width:80px;">Joint</th>
            <th class="sub-head" style="width:65px;">Mtrs</th>
          </tr>
        </thead>
        <tbody id="logDoneTableBody">
        </tbody>
        <tfoot>
          <tr class="jc-total-row" style="background: #044a78;">
            <td class="jc-total-label" style="text-align:center; font-size:12px; font-weight:700; color:#ffffff; white-space:nowrap; padding: 6px 8px;">Total</td>
            <td colspan="5" style="padding: 6px 8px" data-label="Total Mtrs">
              <input type="text" name="totalMeter" class="form-control jc-readonly" readonly
                     placeholder="Total Mtrs" style="padding:4px 6px !important; font-size:12.5px !important; height:30px !important;" />
            </td>
            <td colspan="4" style="padding: 6px 8px" data-label="SQ Mtrs">
              <input type="text" name="sqMtr" class="form-control jc-readonly" readonly
                     placeholder="SQ Mtrs" style="padding:4px 6px !important; font-size:12.5px !important; height:30px !important;" />
            </td>
            <td style="padding: 6px 8px"></td>
            <td style="padding: 6px 8px"></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- The one row used to enter the next Production Log line. On Stop it
         moves up into the table above and this resets blank. -->
    <div class="span-full jc-hidden" id="prodLogBody" style="overflow-x: auto; margin-top: 10px;">
      <table class="jc-log-table">
        <thead>
          <tr>
            <th rowspan="2" style="vertical-align: middle; width:32px; text-align:center;">#</th>
            <th colspan="4" class="group-head">Start / Stop</th>
            <th rowspan="2" style="vertical-align: middle; width:75px;">Mtrs</th>
            <th colspan="2" class="group-head">Face</th>
            <th colspan="2" class="group-head">Release</th>
          </tr>
          <tr>
            <th class="sub-head" style="width:70px;">Mtrs</th>
            <th class="sub-head" style="width:92px;">Start</th>
            <th class="sub-head" style="width:70px;">Mtrs</th>
            <th class="sub-head" style="width:92px;">Stop</th>
            <th class="sub-head" style="width:80px;">Joint</th>
            <th class="sub-head" style="width:65px;">Mtrs</th>
            <th class="sub-head" style="width:80px;">Joint</th>
            <th class="sub-head" style="width:65px;">Mtrs</th>
          </tr>
        </thead>
        <tbody id="logTableBody">
        </tbody>
      </table>
    </div>

    <div class="btn-grp jc-save-wrap span-full" id="saveBtnWrap" style="margin-top: 10px; display: none;">
      <button type="submit" id="saveEntryBtn" class="jc-save-action" disabled><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Submit Entry</button>
    </div>
  </form>
</div>

<div class="logout-modal" id="scanDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="scanDialogTitle"
    style="width: min(420px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="scanDialogTitle">Scan QR / Barcode</h2>
      <button class="dialog-close-btn" type="button" onclick="closeScanDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <div class="scan-video-wrap">
        <video id="scanVideo" playsinline muted autoplay></video>
        <div class="scan-frame"></div>
      </div>
      <div class="scan-status" id="scanStatus">Point the camera at the QR code on the roll/drum label.</div>
      <div class="dialog-actions">
        <button type="button" class="btn-cancel" onclick="closeScanDialog()">Cancel</button>
      </div>
    </div>
  </div>
</div>

<div class="logout-modal" id="materialUsedDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="materialUsedDialogTitle"
    style="width: min(1280px, 96vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="materialUsedDialogTitle">Material Remaining Stock (kg)</h2>
      <button class="dialog-close-btn" type="button" onclick="closeMaterialUsedDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <p class="jc-material-used-hint">
        Enter the remaining weight (kg) left for each used material reel/drum. The stock balance
        in inventory will be updated directly to this remaining value, and the consumed quantity will be deducted.
      </p>
      <div id="materialUsedRows"></div>
      <div class="jc-material-used-error" id="materialUsedError"></div>
      <div class="dialog-actions">
        <button type="button" class="btn-cancel" onclick="closeMaterialUsedDialog()">Cancel</button>
        <button type="button" class="btn-primary jc-material-confirm" id="materialUsedConfirmBtn" onclick="submitMaterialUsage()"><i class="fa-solid fa-check" aria-hidden="true"></i> Confirm &amp; Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Shown the moment Add is clicked on a Materials in Use slot -- the roll
     being swapped out has to be reconciled (how much was actually left on
     it) before the slot opens up for the next one, same "enter what's left,
     0 means finished" idea as the end-of-job Material Used dialog above,
     just for one reel and updating stock immediately instead of waiting. -->
<div class="logout-modal" id="materialSwapDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="materialSwapDialogTitle"
    style="width: min(460px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="materialSwapDialogTitle">How much is left?</h2>
      <button class="dialog-close-btn" type="button" onclick="closeMaterialSwapDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <p class="jc-material-used-hint" id="materialSwapHint">
        Enter the weight (kg) left on this reel before scanning the next one in. Stock updates immediately.
      </p>
      <div class="jc-swap-current">
        <div class="jc-swap-current-row">
          <span class="jc-swap-current-label">Roll / Drum ID</span>
          <strong id="materialSwapRollId">—</strong>
        </div>
        <div class="jc-swap-current-row">
          <span class="jc-swap-current-label">Current Stock</span>
          <strong id="materialSwapCurrentStock">—</strong>
        </div>
      </div>
      <div class="remaining-input-wrap" style="display:flex; flex-direction:column; gap:4px; margin-top:10px;">
        <input type="number" class="jc-material-used-amount jc-material-remaining-amount" id="materialSwapRemainingInput"
               min="0" step="0.01" placeholder="Kg left (0 if finished)" inputmode="decimal"
               style="width:100%;" oninput="onMaterialSwapRemainingInput(this)" />
        <span class="jc-remaining-calc-note" id="materialSwapCalcNote" style="font-size:11px; font-weight:600; min-height:15px;"></span>
      </div>
      <div class="jc-material-used-error" id="materialSwapError"></div>
      <div class="dialog-actions">
        <button type="button" class="btn-cancel" onclick="closeMaterialSwapDialog()">Cancel</button>
        <button type="button" class="btn-primary jc-material-confirm" id="materialSwapConfirmBtn" onclick="confirmMaterialSwap()"><i class="fa-solid fa-check" aria-hidden="true"></i> Confirm &amp; Continue</button>
      </div>
    </div>
  </div>
</div>

<!-- Shown when the roll/drum typed or scanned into a Currently Mounted field
     is a real, matching-spec reel but NOT the one this order already has
     reserved -- e.g. the reserved reel is missing, damaged, or was simply
     the wrong pick at Assign Production. Confirming re-points this order's
     own allotment at the new reel, which frees the old one straight back to
     available stock (see POST /machine/jobcard/material/reallocate) so
     another order can pick it up. Nothing here has been drawn on yet, so
     unlike the "How much is left?" dialog above, no stock is deducted. -->
<div class="logout-modal" id="materialReallocateDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="materialReallocateDialogTitle"
    style="width: min(460px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header">
      <h2 id="materialReallocateDialogTitle">Change Allocation?</h2>
      <button class="dialog-close-btn" type="button" onclick="closeMaterialReallocateDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body">
      <p class="jc-material-used-hint" id="materialReallocateHint">
        This isn't the reel reserved for this order. Continuing will unallocate the reel below
        (freeing it for any other job) and reserve the newly scanned one for this order instead.
      </p>
      <div class="jc-swap-current">
        <div class="jc-swap-current-row">
          <span class="jc-swap-current-label">Unallocate (freed)</span>
          <strong id="reallocateOldRollId">—</strong>
        </div>
        <div class="jc-swap-current-row">
          <span class="jc-swap-current-label">Allocate instead</span>
          <strong id="reallocateNewRollId">—</strong>
        </div>
      </div>
      <div class="jc-material-used-error" id="materialReallocateError"></div>
      <div class="dialog-actions">
        <button type="button" class="btn-cancel" onclick="closeMaterialReallocateDialog()">Cancel</button>
        <button type="button" class="btn-primary jc-material-confirm" id="materialReallocateConfirmBtn" onclick="confirmMaterialReallocate()"><i class="fa-solid fa-right-left" aria-hidden="true"></i> Unallocate &amp; Swap</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/jsQR.min.js" defer></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const ALLOTTED_ROLLS = JSON.parse(document.getElementById("allotted-rolls-data")?.textContent || "[]");
    const ALLOTTED_FS_ROLLS = JSON.parse(document.getElementById("allotted-fs-rolls-data")?.textContent || "[]");
    const ALLOTTED_AD_ROLLS = JSON.parse(document.getElementById("allotted-ad-rolls-data")?.textContent || "[]");
    const ALLOTTED_RL_ROLLS = JSON.parse(document.getElementById("allotted-rl-rolls-data")?.textContent || "[]");

    const normRollId = (v) => String(v ?? "").trim().replace(/\s+/g, "").toUpperCase();
    const extractScannedRollId = (v) => normRollId(String(v ?? "").trim().split(/\s+/)[0] || "");
    const fmtKg = (v) => Number(v || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 });
    const fmtMtrs = fmtKg;

    const pendingId = document.querySelector('input[name="pendingId"]')?.value || "";

    // Fires the instant Start is punched on a Job Setting/Production Log
    // row, for whichever of Jumbo FS id/Drum id/Jumbo REL id that row
    // already has scanned in -- see POST /sachiko/machine/jobcard/mark-
    // in-use's own comment for why this exists separately from the real
    // consumption only recorded at Save Production Entry time. Best-effort:
    // a failed/racing call never blocks the operator, it only feeds the
    // "which stock is actually running" visibility on the raw-material
    // stock pages.
    function markRowMaterialsInUse(row, prefix) {
      if (!pendingId || !row) return;
      [
        ["facestock", `.${prefix}-fs-roll-id`],
        ["adhesive", `.${prefix}-ad-roll-id`],
        ["release", `.${prefix}-rl-roll-id`],
      ].forEach(([pool, sel]) => {
        const rollId = row.querySelector(sel)?.value?.trim();
        if (!rollId) return;
        fetch("/sachiko/machine/jobcard/mark-in-use", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ pendingId, pool, rollId }),
        }).catch(() => {});
      });
    }

    const fsRollById = new Map(ALLOTTED_FS_ROLLS.filter((r) => r.rollId).map((r) => [normRollId(r.rollId), r]));
    const adRollById = new Map(ALLOTTED_AD_ROLLS.filter((r) => r.rollId).map((r) => [normRollId(r.rollId), r]));
    const rlRollById = new Map(ALLOTTED_RL_ROLLS.filter((r) => r.rollId).map((r) => [normRollId(r.rollId), r]));
    const rollById = new Map(ALLOTTED_ROLLS.filter((r) => r.rollId).map((r) => [normRollId(r.rollId), r]));

    function getRollPoolInfo(pool) {
      if (pool === "fs") return { map: fsRollById, unit: "kg", name: "Jumbo FS" };
      if (pool === "ad") return { map: adRollById, unit: "kg", name: "Drum" };
      if (pool === "rl") return { map: rlRollById, unit: "kg", name: "Jumbo REL" };
      return { map: rollById, unit: "kg", name: "Roll" };
    }

    function checkMaterialInput(input, pool) {
      if (!input) return;
      const note = input.closest(".jc-material-slot")?.querySelector(".roll-note");
      if (!note) return;
      const key = extractScannedRollId(input.value);
      if (!key) {
        note.textContent = "";
        note.className = "roll-note";
        return;
      }
      const info = getRollPoolInfo(pool);
      const reel = info.map.get(key) || rollById.get(key);
      if (reel) {
        const tag = reel.allotted ? " · Allotted" : " · In Stock (Matching Spec)";
        note.textContent = `${fmtMtrs(reel.reelMtrs)} ${info.unit} left${reel.location ? " · " + reel.location : ""}${tag}`;
        note.className = "roll-note ok";
      } else {
        note.textContent = `Invalid / Not matching recipe — verify ${info.name}.`;
        note.className = "roll-note warn";
      }
    }

    // fsRollById/adRollById/rlRollById hold the SAME reel objects the page
    // was rendered with (reelMtrs = stock as of page load) -- after "How much
    // is left?" updates a reel's real stock server-side, that object has to
    // be patched in place too, or re-scanning the same roll later in this job
    // (another slot, or back into the same one) would keep showing the
    // stale, pre-swap figure in the roll-note until a full page reload.
    function updateRollRemainingStock(pool, rollId, remainingKg) {
      const key = normRollId(rollId);
      const info = getRollPoolInfo(pool);
      const reel = info.map.get(key) || rollById.get(key);
      if (reel) reel.reelMtrs = remainingKg;
      rebuildRollDatalist(pool);
    }

    const ROLL_DATALIST_ID = { fs: "allottedFsRollList", ad: "allottedAdRollList", rl: "allottedRlRollList" };
    const ROLL_DATALIST_SOURCE = { fs: ALLOTTED_FS_ROLLS, ad: ALLOTTED_AD_ROLLS, rl: ALLOTTED_RL_ROLLS };

    // The <datalist> options themselves were only ever rendered once, at
    // page load -- patching the reel object (above) keeps the roll-note
    // right the next time this roll is looked up, but the dropdown list an
    // operator actually picks from would otherwise keep showing the old kg
    // figure for the rest of this page's life. Regenerated from the same
    // (now-patched) array, in the same allotted-first order the server used.
    function rebuildRollDatalist(pool) {
      const datalist = document.getElementById(ROLL_DATALIST_ID[pool]);
      const source = ROLL_DATALIST_SOURCE[pool];
      if (!datalist || !source) return;
      const sorted = [...source].sort((a, b) => (b.allotted ? 1 : 0) - (a.allotted ? 1 : 0));
      datalist.innerHTML = sorted
        .filter((r) => r.rollId)
        .map((r) => {
          const bits = [`${fmtMtrs(r.reelMtrs)} kg`];
          if (r.location) bits.push(r.location);
          if (pool === "fs") {
            if (r.family) bits.push(r.family);
            if (r.gsm) bits.push(`${r.gsm} GSM`); else if (r.micron) bits.push(`${r.micron} mic`);
            if (r.type) bits.push(r.type);
            if (r.size) bits.push(r.size);
          } else if (pool === "ad") {
            if (r.make) bits.push(r.make);
            if (r.code) bits.push(r.code); else if (r.type) bits.push(r.type);
          } else {
            if (r.sensing) bits.push(r.sensing);
            if (r.type) bits.push(r.type);
            if (r.size) bits.push(r.size);
          }
          return `<option value="${escAdhesiveKey(r.rollId)}">${r.allotted ? "[Allotted] " : "[Stock] "}${bits.join(" · ")}</option>`;
        })
        .join("");
    }

    // Materials in Use -- Jumbo FS / Drum / Jumbo REL id are scanned ONCE
    // here instead of on every Job Setting / Production Log row. Every row
    // still carries its own hidden fsRollId/adRollId/rlRollId (unchanged
    // server contract), it's just filled in from here instead of scanned
    // per line -- see applyCurrentMaterialsToRow / syncCurrentMaterialsToOpenRows.
    const curMaterialsPanel = document.getElementById("curMaterialsPanel");
    const currentMaterials = { fs: "", ad: "", rl: "" };
    const MATERIAL_POOL_ORDER = ["fs", "ad", "rl"];

    function materialSlot(pool) {
      return curMaterialsPanel.querySelector(`.jc-material-slot[data-pool="${pool}"]`);
    }

    // Copies whatever's currently mounted into one row's hidden roll-id
    // fields (prefix is "js" for Job Setting, "log" for Production Log).
    function applyCurrentMaterialsToRow(row, prefix) {
      if (!row) return;
      const fsInput = row.querySelector(`.${prefix}-fs-roll-id`);
      const adInput = row.querySelector(`.${prefix}-ad-roll-id`);
      const rlInput = row.querySelector(`.${prefix}-rl-roll-id`);
      if (fsInput) fsInput.value = currentMaterials.fs;
      if (adInput) adInput.value = currentMaterials.ad;
      if (rlInput) rlInput.value = currentMaterials.rl;
    }

    // Keeps every still-open row in sync whenever the mounted roll changes --
    // every Job Setting row (none of them are "final" until the whole card
    // is saved) and the single live Production Log entry row (completed rows
    // already deducted against whatever was current when they were punched,
    // so they're left alone).
    function syncCurrentMaterialsToOpenRows() {
      Array.from(jsBody.rows).forEach((row) => applyCurrentMaterialsToRow(row, "js"));
      if (logBody.rows.length) applyCurrentMaterialsToRow(logBody.rows[0], "log");
    }

    function lockMaterialSlot(pool) {
      const slot = materialSlot(pool);
      if (!slot) return;
      slot.querySelector(".jc-cur-roll-input").readOnly = true;
      slot.querySelector(".jc-cur-scan-btn").style.display = "none";
      slot.querySelector(".jc-material-add-btn").style.display = "";
    }

    function unlockMaterialSlot(pool) {
      const slot = materialSlot(pool);
      if (!slot) return;
      const input = slot.querySelector(".jc-cur-roll-input");
      input.value = "";
      input.readOnly = false;
      slot.querySelector(".jc-cur-scan-btn").style.display = "";
      slot.querySelector(".jc-material-add-btn").style.display = "none";
      currentMaterials[pool] = "";
      checkMaterialInput(input, pool);
      syncCurrentMaterialsToOpenRows();
      if (typeof scheduleSave === "function") scheduleSave();
      input.focus();
    }

    // Locks in a scanned/typed roll as the currently mounted one for `pool`
    // and pushes it out to every open row. A blank/invalid value just
    // updates the note (via checkMaterialInput) without locking the slot.
    // A value that resolves to a real, matching-spec reel this order does
    // NOT already have reserved (reel.allotted === false) is a request to
    // change the allocation, not just record what's mounted -- routed to
    // the confirm dialog below instead of locking straight in, so a
    // reserved-but-unused reel is never silently orphaned.
    function setCurrentMaterial(pool, rawValue) {
      const slot = materialSlot(pool);
      if (!slot) return;
      const input = slot.querySelector(".jc-cur-roll-input");
      const cleanId = extractScannedRollId(rawValue);
      input.value = cleanId || rawValue;
      checkMaterialInput(input, pool);
      if (!cleanId) return;

      if (pendingId) {
        const info = getRollPoolInfo(pool);
        const reel = info.map.get(normRollId(cleanId));
        if (reel && reel._id && reel.allotted === false) {
          openMaterialReallocateDialog(pool, reel, cleanId);
          return;
        }
      }

      currentMaterials[pool] = cleanId;
      lockMaterialSlot(pool);
      syncCurrentMaterialsToOpenRows();
      if (typeof scheduleSave === "function") scheduleSave();
    }

    // Server pool name each client-side pool code maps to -- consumePoolUsage
    // / POST /machine/jobcard/material/set-remaining use the long form.
    const POOL_CODE_TO_SERVER = { fs: "facestock", ad: "adhesive", rl: "release" };
    const SERVER_POOL_TO_CODE = { facestock: "fs", adhesive: "ad", release: "rl" };

    const MATERIAL_SWAP_LOG = JSON.parse(document.getElementById("material-swap-log-data")?.textContent || "[]");

    // Every reel already resolved live via Add (this session, or a past one
    // -- materialSwapLog is persisted server-side) -- excluded from the
    // end-of-job Material Used dialog so it's never asked about twice, and
    // shown per-slot as a short "previously used" history.
    const resolvedMaterialStockIds = new Set();
    const materialHistoryByPool = { fs: [], ad: [], rl: [] };
    MATERIAL_SWAP_LOG.forEach((entry) => {
      const pool = SERVER_POOL_TO_CODE[entry.pool];
      if (!pool) return;
      if (entry.stockId) resolvedMaterialStockIds.add(String(entry.stockId));
      materialHistoryByPool[pool].push(entry);
    });

    function fmtSwapTime(iso) {
      const d = iso ? new Date(iso) : null;
      if (!d || Number.isNaN(d.getTime())) return "";
      return d.toLocaleString("en-IN", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" });
    }

    // Every roll already scanned & swapped out this job, shown as a running
    // feed above the active scan field -- scanned1, scanned2, ... in scan
    // order, oldest first, so the field right underneath is always "next".
    function renderMaterialHistory(pool) {
      const list = document.getElementById(`materialScannedList-${pool}`);
      if (!list) return;
      const entries = materialHistoryByPool[pool] || [];
      list.innerHTML = entries
        .map((e, i) => `
          <div class="jc-material-scanned-row">
            <span class="idx">${i + 1}</span>
            <span class="body">
              <span class="roll">${escAdhesiveKey(e.rollId || "—")}</span>
              <span class="meta">Used ${fmtMtrs(e.usedKg || 0)} kg &middot; ${e.emptied ? '<span class="empty-tag">Emptied</span>' : `${fmtMtrs(e.remainingKg || 0)} kg left`} &middot; ${escAdhesiveKey(fmtSwapTime(e.swappedAt))}</span>
            </span>
          </div>
        `)
        .join("");
    }

    MATERIAL_POOL_ORDER.forEach((pool) => renderMaterialHistory(pool));

    // Add on a locked slot doesn't unlock it outright -- it first asks how
    // much is left on the OUTGOING reel (0 = finished), same idea as the
    // end-of-job Material Used dialog but for one reel, resolved and
    // deducted immediately instead of waiting for Save.
    let pendingSwap = null;

    function openMaterialSwapDialog(pool) {
      const pendingIdVal = document.querySelector('input[name="pendingId"]')?.value || "";
      const rollId = currentMaterials[pool];
      // No production order to deduct against, or nothing recognizable to
      // look up (typed free text that matches no known reel) -- nothing to
      // reconcile, so just let them move on to the next roll.
      if (!pendingIdVal || !rollId) { unlockMaterialSlot(pool); return; }

      const info = getRollPoolInfo(pool);
      const key = normRollId(rollId);
      const reel = info.map.get(key) || rollById.get(key);
      if (!reel || !reel._id) {
        if (typeof showToast === "function") {
          showToast("Couldn't find that reel in stock — nothing to update, scanning the next one.", "error");
        }
        unlockMaterialSlot(pool);
        return;
      }

      pendingSwap = { pool, stockId: reel._id, rollId: reel.rollId || rollId, currentStock: Math.max(0, Number(reel.reelMtrs) || 0), reel };

      document.getElementById("materialSwapDialogTitle").textContent = `How much ${info.name} is left?`;
      document.getElementById("materialSwapHint").textContent =
        `Enter the weight (kg) left on this ${info.name.toLowerCase()} before scanning the next one in. Stock updates immediately.`;
      document.getElementById("materialSwapRollId").textContent = pendingSwap.rollId;
      document.getElementById("materialSwapCurrentStock").textContent = `${fmtMtrs(pendingSwap.currentStock)} kg`;
      const input = document.getElementById("materialSwapRemainingInput");
      input.value = "";
      input.max = pendingSwap.currentStock;
      input.classList.remove("jc-material-used-over");
      document.getElementById("materialSwapCalcNote").textContent = "";
      document.getElementById("materialSwapError").textContent = "";

      openModal("materialSwapDialog");
      input.focus();
    }

    window.onMaterialSwapRemainingInput = function onMaterialSwapRemainingInput(input) {
      const note = document.getElementById("materialSwapCalcNote");
      if (!note || !pendingSwap) return;
      const val = input.value.trim();
      if (!val && val !== "0") {
        note.textContent = "";
        input.classList.remove("jc-material-used-over");
        return;
      }
      const remaining = Number(val);
      if (!Number.isFinite(remaining) || remaining < 0) {
        note.textContent = "Invalid amount";
        note.style.color = "#dc2626";
        input.classList.add("jc-material-used-over");
        return;
      }
      if (remaining > pendingSwap.currentStock) {
        note.textContent = `Exceeds stock of ${fmtMtrs(pendingSwap.currentStock)} kg`;
        note.style.color = "#dc2626";
        input.classList.add("jc-material-used-over");
        return;
      }
      input.classList.remove("jc-material-used-over");
      const used = Math.max(0, Number(round2(pendingSwap.currentStock - remaining)));
      if (remaining === 0) {
        note.textContent = `Used: ${fmtMtrs(used)} kg (Emptied)`;
        note.style.color = "#b45309";
      } else if (used === 0) {
        note.textContent = "Used: 0 kg (Full)";
        note.style.color = "#64748b";
      } else {
        note.textContent = `Used: ${fmtMtrs(used)} kg`;
        note.style.color = "#047857";
      }
    };

    window.closeMaterialSwapDialog = function closeMaterialSwapDialog() {
      closeModal("materialSwapDialog");
      pendingSwap = null;
    };

    window.confirmMaterialSwap = async function confirmMaterialSwap() {
      const errorEl = document.getElementById("materialSwapError");
      errorEl.textContent = "";
      if (!pendingSwap) { closeMaterialSwapDialog(); return; }

      const input = document.getElementById("materialSwapRemainingInput");
      const raw = input.value.trim();
      if (!raw && raw !== "0") {
        errorEl.textContent = "Enter the kg left on this reel (0 if it's finished).";
        input.focus();
        return;
      }
      const remaining = Number(raw);
      if (!Number.isFinite(remaining) || remaining < 0) {
        errorEl.textContent = "Enter a valid non-negative kg amount.";
        input.focus();
        return;
      }
      if (remaining > pendingSwap.currentStock) {
        errorEl.textContent = `Cannot exceed current stock (${fmtMtrs(pendingSwap.currentStock)} kg).`;
        input.classList.add("jc-material-used-over");
        input.focus();
        return;
      }

      const confirmBtn = document.getElementById("materialSwapConfirmBtn");
      confirmBtn.disabled = true;
      const pendingIdVal = document.querySelector('input[name="pendingId"]')?.value || "";
      const { pool, stockId, rollId } = pendingSwap;

      try {
        const res = await fetch("/sachiko/machine/jobcard/material/set-remaining", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ pendingId: pendingIdVal, pool: POOL_CODE_TO_SERVER[pool], stockId, remainingKg: remaining }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          errorEl.textContent = data.message || "Couldn't update stock. Try again.";
          confirmBtn.disabled = false;
          return;
        }
        resolvedMaterialStockIds.add(String(stockId));
        materialHistoryByPool[pool].push(data.swap);
        renderMaterialHistory(pool);
        updateRollRemainingStock(pool, rollId, remaining);
        closeMaterialSwapDialog();
        unlockMaterialSlot(pool);
        if (typeof showToast === "function") {
          showToast(`Stock updated — ${fmtMtrs(remaining)} kg left on ${rollId}.`, "success");
        }
      } catch (err) {
        errorEl.textContent = "Network error — try again.";
      } finally {
        confirmBtn.disabled = false;
      }
    };

    // Fires from setCurrentMaterial above the instant a scanned/typed roll
    // resolves to a real reel that ISN'T the one already reserved for this
    // order/pool -- asks for confirmation before touching the allotment,
    // since freeing the currently-reserved reel can't be silently undone
    // (another order's Assign Production could claim it the moment it's
    // free). Cancelling reverts the input back to whatever was locked in
    // before, so an accidental scan never leaves the field pointed at a
    // reel this order doesn't actually have.
    let pendingReallocate = null;

    function openMaterialReallocateDialog(pool, reel, rawValue) {
      const info = getRollPoolInfo(pool);
      const source = ROLL_DATALIST_SOURCE[pool] || [];
      const oldRollIds = source.filter((r) => r.allotted).map((r) => r.rollId).filter(Boolean);

      pendingReallocate = { pool, reel, rawValue };

      document.getElementById("materialReallocateDialogTitle").textContent = `Change ${info.name}?`;
      document.getElementById("reallocateOldRollId").textContent = oldRollIds.length ? oldRollIds.join(", ") : "Nothing currently allotted";
      document.getElementById("reallocateNewRollId").textContent = reel.rollId || rawValue;
      document.getElementById("materialReallocateError").textContent = "";
      document.getElementById("materialReallocateConfirmBtn").disabled = false;

      openModal("materialReallocateDialog");
    }

    window.closeMaterialReallocateDialog = function closeMaterialReallocateDialog() {
      closeModal("materialReallocateDialog");
      if (pendingReallocate) {
        const { pool } = pendingReallocate;
        const slot = materialSlot(pool);
        const input = slot?.querySelector(".jc-cur-roll-input");
        if (input) {
          input.value = currentMaterials[pool] || "";
          checkMaterialInput(input, pool);
        }
      }
      pendingReallocate = null;
    };

    window.confirmMaterialReallocate = async function confirmMaterialReallocate() {
      if (!pendingReallocate) { closeMaterialReallocateDialog(); return; }
      const errorEl = document.getElementById("materialReallocateError");
      errorEl.textContent = "";
      const confirmBtn = document.getElementById("materialReallocateConfirmBtn");
      confirmBtn.disabled = true;

      const { pool, reel, rawValue } = pendingReallocate;
      const pendingIdVal = document.querySelector('input[name="pendingId"]')?.value || "";

      try {
        const res = await fetch("/sachiko/machine/jobcard/material/reallocate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ pendingId: pendingIdVal, pool: POOL_CODE_TO_SERVER[pool], newStockId: reel._id }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          errorEl.textContent = data.message || "Couldn't update the allocation. Try again.";
          confirmBtn.disabled = false;
          return;
        }
        // The allotment, eligible-reel lists and allocation table are all
        // re-derived server-side from the freshly saved PendingProduction
        // doc -- rather than hand-patch every one of those client-side
        // (datalists, roll-notes, the allocation table's own row, the OTHER
        // pool's "already allotted" markers), the currently mounted pick is
        // saved to the draft and the page is reloaded, which restores it via
        // restoreDraft() against the now-current server data.
        currentMaterials[pool] = extractScannedRollId(reel.rollId || rawValue);
        if (typeof saveDraft === "function") saveDraft();
        if (typeof showToast === "function") {
          showToast(`Allocation updated — ${reel.rollId || rawValue} is now reserved for this order.`, "success");
        }
        closeModal("materialReallocateDialog");
        pendingReallocate = null;
        location.reload();
      } catch (err) {
        errorEl.textContent = "Network error — try again.";
        confirmBtn.disabled = false;
      }
    };

    curMaterialsPanel.addEventListener("input", (e) => {
      if (!e.target.classList.contains("jc-cur-roll-input")) return;
      checkMaterialInput(e.target, e.target.dataset.pool);
    });

    curMaterialsPanel.addEventListener("keydown", (e) => {
      if (e.key !== "Enter") return;
      const input = e.target.closest(".jc-cur-roll-input");
      if (!input) return;
      e.preventDefault();
      const pool = input.dataset.pool;
      setCurrentMaterial(pool, input.value);
      const next = MATERIAL_POOL_ORDER[MATERIAL_POOL_ORDER.indexOf(pool) + 1];
      if (next) materialSlot(next)?.querySelector(".jc-cur-roll-input")?.focus();
    });

    // An operator who types/scans a roll id and then just clicks or tabs
    // away (instead of pressing Enter) still needs it locked in -- otherwise
    // the Add button never appears and there's no way to swap it later.
    // focusout (unlike blur) bubbles, so this can sit on the panel.
    curMaterialsPanel.addEventListener("focusout", (e) => {
      const input = e.target.closest(".jc-cur-roll-input");
      if (!input || input.readOnly) return;
      if (!input.value.trim()) return;
      setCurrentMaterial(input.dataset.pool, input.value);
    });

    curMaterialsPanel.addEventListener("click", (e) => {
      const scanBtn = e.target.closest(".jc-cur-scan-btn");
      if (scanBtn) {
        const pool = scanBtn.dataset.pool;
        openScanDialog(materialSlot(pool)?.querySelector(".jc-cur-roll-input"), getRollPoolInfo(pool).name);
        return;
      }
      const addBtn = e.target.closest(".jc-material-add-btn");
      if (addBtn) openMaterialSwapDialog(addBtn.dataset.pool);
    });

    function openModal(id)  { const d = document.getElementById(id); if (!d) return; d.classList.add("show");    d.setAttribute("aria-hidden", "false"); }
    function closeModal(id) { const d = document.getElementById(id); if (!d) return; d.classList.remove("show"); d.setAttribute("aria-hidden", "true");  }

    // "Material Allocation" header -- click (or Enter/Space) to shrink the
    // table out of the way, click again to bring it back.
    const allocationHeader = document.getElementById("allocationHeader");
    const allocationWrap = document.getElementById("allocationWrap");
    const allocationChevron = document.getElementById("allocationChevron");
    if (allocationHeader && allocationWrap) {
      const toggleAllocation = () => {
        const collapsed = allocationWrap.classList.toggle("jc-hidden");
        allocationChevron?.classList.toggle("collapsed", collapsed);
        allocationHeader.setAttribute("aria-expanded", collapsed ? "false" : "true");
      };
      allocationHeader.addEventListener("click", toggleAllocation);
      allocationHeader.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== " ") return;
        e.preventDefault();
        toggleAllocation();
      });
    }

    const USAGE_ITEMS = JSON.parse(document.getElementById("material-usage-data").textContent || "[]");
    let materialUsedCleared = false;

    const POOL_FIELDS = {
      facestock: { stockId: "facestockStockId", used: "facestockMtrsUsed", remaining: "facestockRemainingKg", unit: "kg" },
      adhesive: { stockId: "adhesiveStockId", used: "adhesiveKgUsed", remaining: "adhesiveRemainingKg", unit: "kg" },
      release: { stockId: "releaseStockId", used: "releaseMtrsUsed", remaining: "releaseRemainingKg", unit: "kg" },
    };
    const MATERIAL_DIALOG_UNIT = "kg";

    function escAdhesiveKey(v) {
      return String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function fmtMaterialCell(v) {
      const text = String(v ?? "").trim();
      return (text && text !== "-" && text !== "—") ? escAdhesiveKey(text) : "—";
    }

    function fmtMaterialGsm(v) {
      if (v === undefined || v === null || String(v).trim() === "" || String(v).trim() === "-" || String(v).trim() === "—") {
        return "—";
      }
      const num = Number(v);
      if (Number.isFinite(num) && num > 0) {
        return `${escAdhesiveKey(fmtMtrs(num))} GSM`;
      }
      return escAdhesiveKey(String(v));
    }

    let activeUsageList = [];

    function getUsedRollIdsFromForm() {
      const usedKeys = new Set();
      document.querySelectorAll(".js-fs-roll-id, .js-ad-roll-id, .js-rl-roll-id, .log-fs-roll-id, .log-ad-roll-id, .log-rl-roll-id").forEach((input) => {
        const key = extractScannedRollId(input.value);
        if (key) usedKeys.add(key);
      });
      return usedKeys;
    }

    function getActiveUsageItems() {
      const seenIds = new Set();
      const items = [];
      const usedFormKeys = getUsedRollIdsFromForm();

      USAGE_ITEMS.forEach((item) => {
        if (item._id && !seenIds.has(String(item._id))) {
          seenIds.add(String(item._id));
          const isUsed = usedFormKeys.has(normRollId(item.rollId));
          items.push({
            ...item,
            isUsedInProduction: isUsed,
            status: isUsed ? "Allotted" : "Not Used",
          });
        }
      });

      const checkAndAdd = (input, pool) => {
        if (!input) return;
        const key = extractScannedRollId(input.value);
        if (!key) return;
        const info = getRollPoolInfo(pool);
        const reel = info.map.get(key) || rollById.get(key);
        if (reel && reel._id && !seenIds.has(String(reel._id))) {
          seenIds.add(String(reel._id));
          items.push({
            _id: String(reel._id),
            rollId: reel.rollId || key,
            reelMtrs: Number(reel.reelMtrs) || 0,
            pool: reel.pool || (pool === "fs" ? "facestock" : pool === "ad" ? "adhesive" : "release"),
            layerKey: reel.layerKey || (pool === "fs" ? "facestock" : pool === "ad" ? "adhesive" : "releaseLiner"),
            layerLabel: reel.layerLabel || (pool === "fs" ? "Facestock" : pool === "ad" ? "Adhesive" : "Release Liner"),
            unit: reel.unit || (pool === "ad" ? "Drum" : "Roll"),
            code: reel.code || reel.vendorSkuCode || "",
            gsm: reel.gsm,
            size: reel.size || "",
            make: reel.make || "",
            location: reel.location || "",
            isUsedInProduction: true,
            status: reel.allotted ? "Allotted" : "Newly Used",
          });
        }
      };

      document.querySelectorAll(".js-fs-roll-id, .log-fs-roll-id").forEach((el) => checkAndAdd(el, "fs"));
      document.querySelectorAll(".js-ad-roll-id, .log-ad-roll-id").forEach((el) => checkAndAdd(el, "ad"));
      document.querySelectorAll(".js-rl-roll-id, .log-rl-roll-id").forEach((el) => checkAndAdd(el, "rl"));

      // Already resolved live via a Materials in Use "Add" swap -- stock for
      // it was updated the moment that was confirmed, so it's not asked
      // about again here.
      return items.filter((item) => !resolvedMaterialStockIds.has(String(item._id)));
    }

    window.onRemainingKgInput = function onRemainingKgInput(input, index, currentStock) {
      const note = document.getElementById(`remainingCalcNote-${index}`);
      if (!note) return;
      const val = input.value.trim();
      if (!val && val !== "0") {
        note.textContent = "";
        note.className = "jc-remaining-calc-note";
        input.classList.remove("jc-material-used-over");
        return;
      }
      const remaining = Number(val);
      if (!Number.isFinite(remaining) || remaining < 0) {
        note.textContent = "Invalid amount";
        note.style.color = "#dc2626";
        input.classList.add("jc-material-used-over");
        return;
      }
      if (remaining > currentStock) {
        note.textContent = `Exceeds stock of ${fmtMtrs(currentStock)} kg`;
        note.style.color = "#dc2626";
        input.classList.add("jc-material-used-over");
        return;
      }
      input.classList.remove("jc-material-used-over");
      const used = Math.max(0, round2(currentStock - remaining));
      if (remaining === 0) {
        note.textContent = `Used: ${fmtMtrs(used)} kg (Emptied)`;
        note.style.color = "#b45309";
      } else if (used === 0) {
        note.textContent = `Used: 0 kg (Full)`;
        note.style.color = "#64748b";
      } else {
        note.textContent = `Used: ${fmtMtrs(used)} kg`;
        note.style.color = "#047857";
      }
    };

    function renderMaterialUsedRows() {
      const wrap = document.getElementById("materialUsedRows");
      activeUsageList = getActiveUsageItems();
      const rows = activeUsageList.map((d, i) => {
        const itemUnit = d.unit || (d.pool === "adhesive" ? "Drum" : "Roll");
        const currentStock = Number(d.reelMtrs) || 0;
        const qty = `1 ${itemUnit} (${fmtMtrs(currentStock)} kg)`;
        
        let statusBadge = "";
        let rowClass = "";
        let rowStyle = "";

        if (!d.isUsedInProduction) {
          rowClass = "jc-material-row-not-used";
          rowStyle = "background-color: #fef2f2; color: #991b1b;";
          statusBadge = `<span class="jc-material-used-status status-not-used">Not Used</span>`;
        } else if (d.status === "Newly Used") {
          statusBadge = `<span class="jc-material-used-status status-newly-used">Newly Used</span>`;
        } else {
          statusBadge = `<span class="jc-material-used-status status-used">Allotted</span>`;
        }

        return `
        <tr class="${rowClass}" style="${rowStyle}">
          <td data-label="Layer">${fmtMaterialCell(d.layerLabel)}</td>
          <td data-label="Status">${statusBadge}</td>
          <td data-label="Current Stock"><strong>${escAdhesiveKey(qty)}</strong></td>
          <td data-label="Roll / Drum ID"><strong>${fmtMaterialCell(d.rollId)}</strong></td>
          <td data-label="Code">${fmtMaterialCell(d.code)}</td>
          <td data-label="GSM">${fmtMaterialGsm(d.gsm)}</td>
          <td data-label="Size">${fmtMaterialCell(d.size)}</td>
          <td data-label="Make">${fmtMaterialCell(d.make)}</td>
          <td data-label="Location">${fmtMaterialCell(d.location)}</td>
          <td data-label="Remaining (kg)">
            <div class="remaining-input-wrap" style="display:flex; flex-direction:column; gap:2px;">
              <input type="number" class="jc-material-used-amount jc-material-remaining-amount" id="materialRemainingAmount-${i}"
                     data-index="${i}" data-current="${escAdhesiveKey(currentStock)}"
                     min="0" step="0.01" max="${escAdhesiveKey(currentStock)}" placeholder="kg left"
                     aria-label="${escAdhesiveKey(d.layerLabel || "Material")} ${escAdhesiveKey(d.rollId || "")} remaining kg left"
                     inputmode="decimal" oninput="onRemainingKgInput(this, ${i}, ${currentStock})" />
              <span class="jc-remaining-calc-note" id="remainingCalcNote-${i}" style="font-size:10.5px; font-weight:600; min-height:14px;"></span>
            </div>
          </td>
        </tr>
      `;
      }).join("");
      wrap.innerHTML = `
        <div class="jc-material-used-scroll custom-scrollbar">
          <table class="jc-roll-table jc-material-used-table">
            <thead>
              <tr>
                <th style="width:140px;">Layer</th>
                <th style="width:110px;">Status</th>
                <th>Current Stock</th>
                <th>Roll / Drum ID</th>
                <th>Code</th>
                <th>GSM</th>
                <th>Size</th>
                <th>Make</th>
                <th>Location</th>
                <th style="width:130px;">Remaining (kg)</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
      `;
    }

    function openMaterialUsedDialog() {
      renderMaterialUsedRows();
      document.getElementById("materialUsedError").textContent = "";
      openModal("materialUsedDialog");
      document.getElementById("materialRemainingAmount-0")?.focus();
    }
    window.closeMaterialUsedDialog = function closeMaterialUsedDialog() { closeModal("materialUsedDialog"); };

    window.submitMaterialUsage = function submitMaterialUsage() {
      const errorEl = document.getElementById("materialUsedError");
      errorEl.textContent = "";

      const rows = [];
      for (let i = 0; i < activeUsageList.length; i++) {
        const item = activeUsageList[i];
        const fields = POOL_FIELDS[item.pool] || POOL_FIELDS.facestock;
        const input = document.getElementById(`materialRemainingAmount-${i}`);
        const raw = input ? input.value.trim() : "";
        if (input) input.classList.remove("jc-material-used-over");
        if (!raw && raw !== "0") continue;

        const remaining = Number(raw);
        if (!Number.isFinite(remaining) || remaining < 0) {
          errorEl.textContent = `Enter a valid non-negative kg amount for ${item.rollId || "all items"}.`;
          if (input) input.focus();
          return;
        }
        const current = Number(item.reelMtrs) || 0;
        if (remaining > current) {
          if (input) input.classList.add("jc-material-used-over");
          errorEl.textContent = `${item.rollId || "Item"} remaining kg cannot exceed current stock (${fmtMtrs(current)} kg).`;
          if (input) input.focus();
          return;
        }
        const used = Math.max(0, round2(current - remaining));
        rows.push({ fields, stockId: item._id, remainingKg: remaining, usedKg: used });
      }
      if (!rows.length) {
        errorEl.textContent = `Enter remaining kg for at least one used raw material.`;
        document.getElementById("materialRemainingAmount-0")?.focus();
        return;
      }

      rows.forEach(({ fields, stockId, remainingKg, usedKg }) => {
        const sidInput = document.createElement("input");
        sidInput.type = "hidden"; sidInput.name = fields.stockId; sidInput.value = stockId;
        const usedInput = document.createElement("input");
        usedInput.type = "hidden"; usedInput.name = fields.used; usedInput.value = usedKg;
        const remInput = document.createElement("input");
        remInput.type = "hidden"; remInput.name = fields.remaining; remInput.value = remainingKg;
        jcForm.appendChild(sidInput);
        jcForm.appendChild(usedInput);
        jcForm.appendChild(remInput);
      });

      materialUsedCleared = true;
      closeMaterialUsedDialog();
      jcForm.requestSubmit ? jcForm.requestSubmit() : jcForm.submit();
    };

    const scanDialog = document.getElementById("scanDialog");
    const scanVideo = document.getElementById("scanVideo");
    const scanStatus = document.getElementById("scanStatus");
    const scanCanvas = document.createElement("canvas");

    let scanStream = null;
    let scanRafId = null;
    let scanTargetInput = null;

    function setScanStatus(text, isError) {
      if (!scanStatus) return;
      scanStatus.textContent = text;
      scanStatus.classList.toggle("error", Boolean(isError));
    }

    function stopScanCamera() {
      if (scanRafId) cancelAnimationFrame(scanRafId);
      scanRafId = null;
      if (scanStream) {
        scanStream.getTracks().forEach((track) => track.stop());
        scanStream = null;
      }
      if (scanVideo) scanVideo.srcObject = null;
    }

    window.closeScanDialog = function closeScanDialog() {
      closeModal("scanDialog");
      stopScanCamera();
      scanTargetInput = null;
    };

    function scanFrame() {
      if (!scanStream) return;
      if (scanVideo.readyState === scanVideo.HAVE_ENOUGH_DATA) {
        const vw = scanVideo.videoWidth;
        const vh = scanVideo.videoHeight;
        if (vw && vh) {
          const scale = Math.min(1, 640 / Math.max(vw, vh));
          scanCanvas.width = Math.round(vw * scale);
          scanCanvas.height = Math.round(vh * scale);
          const ctx = scanCanvas.getContext("2d");
          ctx.drawImage(scanVideo, 0, 0, scanCanvas.width, scanCanvas.height);
          const frame = ctx.getImageData(0, 0, scanCanvas.width, scanCanvas.height);
          const code = window.jsQR
            ? window.jsQR(frame.data, frame.width, frame.height, { inversionAttempts: "dontInvert" })
            : null;
          if (code && code.data) {
            handleScanSuccess(code.data);
            return;
          }
        }
      }
      scanRafId = requestAnimationFrame(scanFrame);
    }

    function handleScanSuccess(rawText) {
      const input = scanTargetInput;
      closeScanDialog();
      if (!input) return;

      const cleanId = extractScannedRollId(rawText);
      if (!cleanId) {
        if (typeof showToast === "function") showToast("That QR code isn't a valid label.", "error");
        return;
      }

      if (input.classList.contains("jc-cur-roll-input")) {
        const pool = input.dataset.pool;
        setCurrentMaterial(pool, cleanId);
        const next = MATERIAL_POOL_ORDER[MATERIAL_POOL_ORDER.indexOf(pool) + 1];
        if (next) materialSlot(next)?.querySelector(".jc-cur-roll-input")?.focus();
      }
      if (typeof showToast === "function") showToast(`Scanned ID: ${cleanId}`, "success");
    }

    async function openScanDialog(input, title) {
      scanTargetInput = input;
      setScanStatus(`Point the camera at the QR code on the ${title || "material"} label.`);
      openModal("scanDialog");

      if (!navigator.mediaDevices?.getUserMedia) {
        setScanStatus("Camera scanning needs a secure (https) connection here. Please type the ID instead.", true);
        return;
      }
      if (typeof window.jsQR !== "function") {
        setScanStatus("Scanner failed to load. Please type the ID instead.", true);
        return;
      }

      try {
        scanStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: "environment" } },
          audio: false,
        });
        scanVideo.srcObject = scanStream;
        await scanVideo.play();
        scanRafId = requestAnimationFrame(scanFrame);
      } catch (err) {
        setScanStatus("Couldn't open the camera. Please allow camera access, or type the ID instead.", true);
      }
    }

    scanDialog.addEventListener("click", (e) => { if (e.target === scanDialog) closeScanDialog(); });
    document.addEventListener("visibilitychange", () => { if (document.hidden) closeScanDialog(); });

    const hasValue = (row, sel) => String(row?.querySelector(sel)?.value ?? "").trim() !== "";

    // A punched time only means something next to the counter reading it was
    // taken at, so in both tables each button stays locked until its own metre
    // box is filled in. Once punched the button is done -- never re-opened by
    // a later edit.
    function setPunchBtnReady(btn, ready, lockedTitle) {
      if (!btn || btn.dataset.punched === "1") return;
      btn.disabled = !ready;
      btn.style.background = ready ? (btn.dataset.color || "#10b981") : "#cbd5e1";
      btn.style.cursor = ready ? "pointer" : "not-allowed";
      btn.title = ready ? "" : lockedTitle;
    }

    function syncJsRowButtons(row) {
      if (!row) return;
      setPunchBtnReady(row.querySelector(".js-start-btn"), hasValue(row, ".js-mtrs1"), "Enter the start mtrs first");
      setPunchBtnReady(row.querySelector(".js-stop-btn"), hasValue(row, ".js-mtrs2"), "Enter the stop mtrs first");
    }

    function syncLogRowButtons(row) {
      if (!row) return;
      setPunchBtnReady(row.querySelector(".log-start-btn"), hasValue(row, ".log-start-mtrs"), "Enter the start mtrs first");
      setPunchBtnReady(row.querySelector(".log-stop-btn"), hasValue(row, ".log-stop-mtrs"), "Enter the stop mtrs first");
    }

    const jsBody  = document.getElementById("jsTableBody");
    const jsCount = document.getElementById("jsCount");
    const jsPlus  = document.getElementById("jsPlus");
    const jsMinus = document.getElementById("jsMinus");

    function jsRenumber() {
      Array.from(jsBody.rows).forEach((row, i) => { row.cells[0].textContent = i + 1; });
      jsCount.value = jsBody.rows.length;
    }

    // Production Log starts hidden behind this button -- setup (Job Setting)
    // and actual production are entered as two distinct steps, not one long
    // form. `prodLogStarted` sticks once true (see markPunched-style buttons
    // above: nothing here un-punches a row), so a later edit that makes a row
    // look "unfinished" again can't yank the log section back out from under
    // an operator already filling it in.
    const startProdLogWrap = document.getElementById("startProdLogWrap");
    const startProdLogBtn = document.getElementById("startProdLogBtn");
    const prodLogHead = document.getElementById("prodLogHead");
    const prodLogBodyEl = document.getElementById("prodLogBody");
    let prodLogStarted = false;

    function jsAllRowsPunched() {
      const rows = Array.from(jsBody.rows);
      if (!rows.length) return false;
      return rows.every((row) =>
        row.querySelector(".js-start-btn")?.dataset.punched === "1" &&
        row.querySelector(".js-stop-btn")?.dataset.punched === "1");
    }

    function updateStartProdLogButton() {
      if (prodLogStarted) return;
      startProdLogWrap.classList.toggle("jc-hidden", !jsAllRowsPunched());
    }

    function revealProdLogSection() {
      prodLogStarted = true;
      startProdLogWrap.classList.add("jc-hidden");
      prodLogHead.classList.remove("jc-hidden");
      prodLogBodyEl.classList.remove("jc-hidden");
    }

    startProdLogBtn.addEventListener("click", revealProdLogSection);

    function createJsRow() {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td style="text-align:center; font-weight:600; color:#03365a; background:#f0f7ff;" data-label="Row"></td>
        <td style="display:none;">
          <input type="hidden" name="jsFsRollId" class="js-fs-roll-id" />
          <input type="hidden" name="jsAdRollId" class="js-ad-roll-id" />
          <input type="hidden" name="jsRlRollId" class="js-rl-roll-id" />
        </td>
        <td data-label="Mtrs"><input type="number" name="jsMtrs1" class="form-control js-mtrs1" placeholder="Mtrs" min="0" step="any" /></td>
        <td style="text-align:center; white-space:nowrap;" data-label="Start">
          <span class="js-start-display" style="font-size:11.5px; font-weight:700; color:#03365a; margin-right:3px;">—</span>
          <input type="hidden" name="jsStart" class="js-start-input" />
          <button type="button" class="js-start-btn" data-color="#10b981" disabled title="Enter the start mtrs first"
            style="width:26px; height:24px; padding:0; font-size:11px; border:none; border-radius:4px; cursor:not-allowed; background:#cbd5e1; color:white; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;">
            <i class="fa-solid fa-play"></i>
          </button>
        </td>
        <td data-label="Mtrs"><input type="number" name="jsMtrs2" class="form-control js-mtrs2" placeholder="Mtrs" min="0" step="any" /></td>
        <td style="text-align:center; white-space:nowrap;" data-label="Stop">
          <span class="js-stop-display" style="font-size:11.5px; font-weight:700; color:#dc2626; margin-right:3px;">—</span>
          <input type="hidden" name="jsStop" class="js-stop-input" />
          <button type="button" class="js-stop-btn" data-color="#ef4444" disabled title="Enter the stop mtrs first"
            style="width:26px; height:24px; padding:0; font-size:11px; border:none; border-radius:4px; cursor:not-allowed; background:#cbd5e1; color:white; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;">
            <i class="fa-solid fa-stop"></i>
          </button>
        </td>`;
      return tr;
    }

    jsBody.addEventListener("input", (e) => {
      if (e.target.classList.contains("js-mtrs1") || e.target.classList.contains("js-mtrs2")) {
        syncJsRowButtons(e.target.closest("tr"));
      }
    });

    jsBody.addEventListener("click", (e) => {
      const startBtn = e.target.closest(".js-start-btn");
      if (startBtn) {
        if (startBtn.disabled) return;
        const row = startBtn.closest("tr");
        if (!hasValue(row, ".js-mtrs1")) {
          if (typeof showToast === "function") showToast("Enter the start mtrs first.", "error");
          row.querySelector(".js-mtrs1")?.focus();
          return;
        }
        const time = nowHHMM();
        row.querySelector(".js-start-input").value = time;
        row.querySelector(".js-start-display").textContent = time;
        startBtn.dataset.punched = "1";
        startBtn.disabled = true;
        startBtn.title = "";
        startBtn.innerHTML = '<i class="fa-solid fa-check"></i>';
        startBtn.style.background = "#6b7280";
        startBtn.style.cursor = "default";
        markRowMaterialsInUse(row, "js");
        updateStartProdLogButton();
        return;
      }
      const stopBtn = e.target.closest(".js-stop-btn");
      if (stopBtn) {
        if (stopBtn.disabled) return;
        const row = stopBtn.closest("tr");
        if (!hasValue(row, ".js-mtrs2")) {
          if (typeof showToast === "function") showToast("Enter the stop mtrs first.", "error");
          row.querySelector(".js-mtrs2")?.focus();
          return;
        }
        const time = nowHHMM();
        row.querySelector(".js-stop-input").value = time;
        row.querySelector(".js-stop-display").textContent = time;
        stopBtn.dataset.punched = "1";
        stopBtn.disabled = true;
        stopBtn.title = "";
        stopBtn.innerHTML = '<i class="fa-solid fa-check"></i>';
        stopBtn.style.background = "#6b7280";
        stopBtn.style.cursor = "default";
        updateStartProdLogButton();
      }
    });

    jsPlus.addEventListener("click", () => {
      const row = createJsRow();
      jsBody.appendChild(row);
      applyCurrentMaterialsToRow(row, "js");
      jsRenumber();
      updateStartProdLogButton();
    });
    jsMinus.addEventListener("click", () => { if (jsBody.rows.length > 1) { jsBody.removeChild(jsBody.lastElementChild); jsRenumber(); updateStartProdLogButton(); } });
    jsBody.appendChild(createJsRow());
    applyCurrentMaterialsToRow(jsBody.rows[0], "js");
    jsRenumber();

    const logBody       = document.getElementById("logTableBody");
    const logDoneBody   = document.getElementById("logDoneTableBody");
    const prodLogDoneWrap = document.getElementById("prodLogDoneWrap");

    function renumber() {
      let n = 0;
      Array.from(logDoneBody.rows).forEach((row) => { row.cells[0].textContent = ++n; });
      Array.from(logBody.rows).forEach((row) => { row.cells[0].textContent = ++n; });
    }

    // Fields a completed Deckle has locked for good -- editing the produced
    // Mtrs after Semi Finished Stock has already been credited off it would
    // desync real stock (see lockProducedRow below), so the Edit button
    // never reopens that one field once instantProduced is set, even though
    // the rest of the row does -- including Start/Stop Mtrs, which stay
    // editable so a mis-punched reading can still be corrected (autoFillMeters
    // is guarded separately so doing that never overwrites the locked Mtrs).
    // (Roll ids aren't in this list -- they're hidden, mirrored from
    // Materials in Use, never directly edited on the row itself.)
    const PRODUCTION_LOCKED_SELECTORS = [".log-meters"];

    // Its own column next to Edit -- previously a tiny caption tucked under
    // the Stop button, easy to miss. Moves the existing .log-deckle-note
    // span itself (appendChild relocates a node rather than copying it), so
    // whatever text/color setLogDeckleNote already put on it -- or sets on
    // it later, from the async produce call -- carries straight over and
    // keeps updating in its new home.
    function addRowStatusCell(row) {
      if (row.querySelector(".jc-row-status-cell")) return;
      const note = row.querySelector(".log-deckle-note");
      const td = document.createElement("td");
      td.className = "jc-row-status-cell";
      td.setAttribute("data-label", "Status");
      if (note) td.appendChild(note);
      row.appendChild(td);
    }

    function addRowEditCell(row) {
      if (row.querySelector(".jc-row-edit-cell")) return;
      const td = document.createElement("td");
      td.className = "jc-row-edit-cell";
      td.innerHTML = '<button type="button" class="jc-row-edit-btn" title="Edit this entry"><i class="fa-solid fa-pen"></i></button>';
      row.appendChild(td);
    }

    // readOnly true -> plain-text display; false -> editable, except any
    // field a completed Deckle already locked for good (see
    // PRODUCTION_LOCKED_SELECTORS).
    function setRowReadOnly(row, readOnly) {
      const produced = row.querySelector(".log-instant-produced-input")?.value === "1";
      row.classList.toggle("jc-row-readonly", readOnly);

      row.querySelectorAll("input.form-control").forEach((el) => {
        const productionLocked = produced && PRODUCTION_LOCKED_SELECTORS.some((sel) => el.matches(sel));
        el.readOnly = readOnly || productionLocked;
      });
      row.querySelectorAll("select.form-control").forEach((el) => {
        el.style.pointerEvents = readOnly ? "none" : "";
        el.tabIndex = readOnly ? -1 : 0;
      });

      const editBtn = row.querySelector(".jc-row-edit-btn");
      if (editBtn) {
        editBtn.classList.toggle("editing", !readOnly);
        editBtn.innerHTML = readOnly ? '<i class="fa-solid fa-pen"></i>' : '<i class="fa-solid fa-check"></i>';
        editBtn.title = readOnly ? "Edit this entry" : "Done editing";
      }
    }

    function finalizeDoneRow(row) {
      addRowStatusCell(row);
      addRowEditCell(row);
      setRowReadOnly(row, true);
    }

    // Punching Stop moves a row out of the single entry table and into the
    // running record above it -- revealed the first time there's something
    // to show, since an empty "already entered" table with just headers
    // reads as broken. It lands there as a plain read-only line with an
    // Edit button, not another live input row.
    function moveRowToDoneTable(row) {
      finalizeDoneRow(row);
      logDoneBody.appendChild(row);
      prodLogDoneWrap.classList.remove("jc-hidden");
    }

    const jointOptionHtml = `
      <option value="" selected>—</option>
      <option value="Joint">Joint</option>
      <option value="Wrinkle">Wrinkle</option>`;

    function createLogRow() {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td style="text-align:center; font-weight:600; color:#03365a; background:#f0f7ff;" data-label="Row"></td>
        <td style="display:none;">
          <input type="hidden" name="fsRollId" class="log-fs-roll-id" />
          <input type="hidden" name="adRollId" class="log-ad-roll-id" />
          <input type="hidden" name="rlRollId" class="log-rl-roll-id" />
        </td>
        <td data-label="Mtrs"><input type="number" name="logStartMtrs" class="form-control log-start-mtrs" placeholder="Mtrs" min="0" step="any" /></td>
        <td style="text-align:center; white-space:nowrap;" data-label="Start">
          <span class="log-start-display" style="font-size:11.5px; font-weight:700; color:#03365a; margin-right:3px;">—</span>
          <input type="hidden" name="logStart" class="log-start-input" />
          <button type="button" class="log-start-btn" data-color="#10b981" disabled title="Enter the start mtrs first"
            style="width:26px; height:24px; padding:0; font-size:11px; border:none; border-radius:4px; cursor:not-allowed; background:#cbd5e1; color:white; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;">
            <i class="fa-solid fa-play"></i>
          </button>
        </td>
        <td data-label="Mtrs"><input type="number" name="logStopMtrs" class="form-control log-stop-mtrs" placeholder="Mtrs" min="0" step="any" /></td>
        <td style="text-align:center; white-space:nowrap;" data-label="Stop">
          <span class="log-end-display" style="font-size:11.5px; font-weight:700; color:#dc2626; margin-right:3px;">—</span>
          <input type="hidden" name="logEnd" class="log-end-input" />
          <input type="hidden" name="deckleId" class="log-deckle-id-input" />
          <input type="hidden" name="logInstantProduced" class="log-instant-produced-input" />
          <button type="button" class="log-stop-btn" data-color="#ef4444" disabled title="Enter the stop mtrs first"
            style="width:26px; height:24px; padding:0; font-size:11px; border:none; border-radius:4px; cursor:not-allowed; background:#cbd5e1; color:white; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;">
            <i class="fa-solid fa-stop"></i>
          </button>
          <span class="log-deckle-note" style="display:block; font-size:11px; font-weight:700; white-space:normal; line-height:1.3;"></span>
        </td>
        <td data-label="Mtrs"><input type="number" name="logMeters" class="form-control log-meters" placeholder="Mtrs" min="0" step="any" /></td>
        <td data-label="Face Joint"><select name="faceJoint" class="form-control log-face-joint" style="min-width:0;">${jointOptionHtml}</select></td>
        <td data-label="Face Mtrs"><input type="number" name="faceMtr" class="form-control log-face-mtr" placeholder="Mtrs" min="0" step="any" /></td>
        <td data-label="Rel. Joint"><select name="releaseJoint" class="form-control log-release-joint" style="min-width:0;">${jointOptionHtml}</select></td>
        <td data-label="Rel. Mtrs"><input type="number" name="releaseMtr" class="form-control log-release-mtr" placeholder="Mtrs" min="0" step="any" /></td>`;
      return tr;
    }

    function nowHHMM() {
      const d = new Date();
      let h = d.getHours();
      const m = String(d.getMinutes()).padStart(2,"0");
      const ampm = h >= 12 ? "PM" : "AM";
      h = h % 12 || 12;
      return `${h}:${m} ${ampm}`;
    }

    const totalMeterInput = document.querySelector('input[name="totalMeter"]');
    const sqMtrInput = document.querySelector('input[name="sqMtr"]');
    const paperSizeVal = Number(document.querySelector('input[name="paperSize"]')?.value) || 0;
    const round2 = (n) => String(Math.round(n * 100) / 100);

    function recalcLogTotals() {
      let runningMtrs = 0;
      Array.from(logDoneBody.rows).concat(Array.from(logBody.rows)).forEach((row) => {
        const made = parseFloat(row.querySelector(".log-meters")?.value);
        if (Number.isFinite(made) && made > 0) runningMtrs += made;
      });

      if (totalMeterInput) totalMeterInput.value = runningMtrs ? round2(runningMtrs) : "";
      if (sqMtrInput) sqMtrInput.value = runningMtrs ? round2(paperSizeVal * (runningMtrs / 100)) : "";
    }

    const logRowVal = (row, sel) => row.querySelector(sel)?.value || "";

    // Meters is derived from Start/Stop mtrs until the operator types into it
    // directly -- once they do (log-meters gets .dataset.userEdited), further
    // Start/Stop changes stop overwriting their own entry. Also skipped once
    // log-meters is readOnly (a produced row -- see PRODUCTION_LOCKED_SELECTORS
    // below): Start/Stop stay editable there for correcting the record, but
    // the Mtrs already credited to Semi Finished Stock must not silently
    // change underneath it.
    function autoFillMeters(row) {
      const metersInput = row.querySelector(".log-meters");
      if (!metersInput || metersInput.readOnly || metersInput.dataset.userEdited === "1") return;
      const start = parseFloat(row.querySelector(".log-start-mtrs")?.value);
      const stop = parseFloat(row.querySelector(".log-stop-mtrs")?.value);
      metersInput.value =
        Number.isFinite(start) && Number.isFinite(stop) && stop > start ? round2(stop - start) : "";
    }

    // Once a row's Deckle is actually inwarded, its material/meters can't
    // change without desyncing the stock that's already been created for it.
    function lockProducedRow(row) {
      PRODUCTION_LOCKED_SELECTORS.forEach((sel) => { const el = row.querySelector(sel); if (el) el.readOnly = true; });
    }

    function setLogDeckleNote(row, text, color) {
      const note = row.querySelector(".log-deckle-note");
      if (!note) return;
      note.textContent = text;
      note.style.color = color;
    }

    // Fires the instant a row's Stop is punched (see the .log-stop-btn
    // handler below) -- POSTs just this one row to
    // /machine/jobcard/log/produce so its Deckle is created and inwarded to
    // Semi Finished Stock right away, rather than waiting for the whole Job
    // Card to be saved. A row with no pendingId (a blank/new entry, not tied
    // to any production order) has nothing to attach a Deckle to, so it's
    // left for the final save as before. A failed call also falls back to
    // the final save -- the row's hidden deckleId/logInstantProduced stay
    // empty, so produceDecklesFromLog there still produces it.
    async function produceRowDeckleInstantly(row) {
      const pendingId = document.querySelector('input[name="pendingId"]')?.value || "";
      if (!pendingId) return;

      setLogDeckleNote(row, "Moving to Semi Finished Stock…", "#64748b");
      try {
        const res = await fetch("/sachiko/machine/jobcard/log/produce", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            pendingId,
            fsRollId: logRowVal(row, ".log-fs-roll-id"),
            adRollId: logRowVal(row, ".log-ad-roll-id"),
            rlRollId: logRowVal(row, ".log-rl-roll-id"),
            startMtrs: logRowVal(row, ".log-start-mtrs"),
            stopMtrs: logRowVal(row, ".log-stop-mtrs"),
            meters: logRowVal(row, ".log-meters"),
            faceJoint: logRowVal(row, ".log-face-joint"),
            faceMtr: logRowVal(row, ".log-face-mtr"),
            releaseJoint: logRowVal(row, ".log-release-joint"),
            releaseMtr: logRowVal(row, ".log-release-mtr"),
            startTime: logRowVal(row, ".log-start-input"),
            endTime: logRowVal(row, ".log-end-input"),
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          setLogDeckleNote(row, "Not moved yet — will be created on Save.", "#b45309");
          if (typeof showToast === "function") {
            showToast(data.message || "Couldn't move this Deckle to Semi Finished Stock yet — it will be created when you Save.", "error");
          }
          return;
        }
        row.querySelector(".log-deckle-id-input").value = data.deckleId;
        row.querySelector(".log-instant-produced-input").value = "1";
        setLogDeckleNote(row, `✓ ${data.deckleId} — in Semi Finished Stock`, "#059669");
        lockProducedRow(row);
        if (typeof showToast === "function") showToast(`${data.deckleId} moved to Semi Finished Stock.`, "success");
      } catch (err) {
        setLogDeckleNote(row, "Not moved yet — will be created on Save.", "#b45309");
      } finally {
        if (typeof scheduleSave === "function") scheduleSave();
      }
    }

    function onLogBodyInput(e) {
      if (e.target.classList.contains("log-start-mtrs") || e.target.classList.contains("log-stop-mtrs")) {
        const row = e.target.closest("tr");
        syncLogRowButtons(row);
        autoFillMeters(row);
      } else if (e.target.classList.contains("log-meters")) {
        e.target.dataset.userEdited = "1";
      }
      recalcLogTotals();
    }

    function onLogBodyClick(e) {
      const editBtn = e.target.closest(".jc-row-edit-btn");
      if (editBtn) {
        const row = editBtn.closest("tr");
        setRowReadOnly(row, !row.classList.contains("jc-row-readonly"));
        return;
      }

      const startBtn = e.target.closest(".log-start-btn");
      if (startBtn) {
        if (startBtn.disabled) return;
        const row = startBtn.closest("tr");
        if (!hasValue(row, ".log-start-mtrs")) {
          if (typeof showToast === "function") showToast("Enter the start mtrs first.", "error");
          row.querySelector(".log-start-mtrs")?.focus();
          return;
        }
        const time = nowHHMM();
        row.querySelector(".log-start-input").value = time;
        row.querySelector(".log-start-display").textContent = time;
        startBtn.dataset.punched = "1";
        startBtn.disabled = true;
        startBtn.title = "";
        startBtn.innerHTML = '<i class="fa-solid fa-check"></i>';
        startBtn.style.background = "#6b7280";
        startBtn.style.cursor = "default";
        markRowMaterialsInUse(row, "log");
        return;
      }
      const stopBtn = e.target.closest(".log-stop-btn");
      if (stopBtn) {
        if (stopBtn.disabled) return;
        const row = stopBtn.closest("tr");
        if (!hasValue(row, ".log-stop-mtrs")) {
          if (typeof showToast === "function") showToast("Enter the stop mtrs first.", "error");
          row.querySelector(".log-stop-mtrs")?.focus();
          return;
        }
        // Every Production Log row is one Deckle -- Stop is what moves it to
        // Semi Finished Stock, so its produced length has to be on the row
        // before that can happen.
        if (!hasValue(row, ".log-meters")) {
          if (typeof showToast === "function") showToast("Enter the produced mtrs first.", "error");
          row.querySelector(".log-meters")?.focus();
          return;
        }
        const time = nowHHMM();
        row.querySelector(".log-end-input").value = time;
        row.querySelector(".log-end-display").textContent = time;
        stopBtn.dataset.punched = "1";
        stopBtn.disabled = true;
        stopBtn.title = "";
        stopBtn.innerHTML = '<i class="fa-solid fa-check"></i>';
        stopBtn.style.background = "#6b7280";
        stopBtn.style.cursor = "default";
        // This row is done -- move it up into the running record and give
        // the operator a fresh blank row to punch the next roll into.
        moveRowToDoneTable(row);
        const freshRow = createLogRow();
        logBody.appendChild(freshRow);
        applyCurrentMaterialsToRow(freshRow, "log");
        renumber();
        recalcLogTotals();
        produceRowDeckleInstantly(row);
      }
    }

    // Rows migrate from logBody into logDoneBody once punched, so both
    // tbodies need the same delegated handlers to keep working there.
    [logBody, logDoneBody].forEach((body) => {
      body.addEventListener("input", onLogBodyInput);
      body.addEventListener("click", onLogBodyClick);
    });

    logBody.appendChild(createLogRow());
    applyCurrentMaterialsToRow(logBody.rows[0], "log");
    renumber();
    recalcLogTotals();

    const DRAFT_KEY = `jc-draft:${document.querySelector('input[name="pendingId"]')?.value || "new"}`;

    function readDraft() {
      try { return JSON.parse(localStorage.getItem(DRAFT_KEY) || "null"); } catch (e) { return null; }
    }
    function writeDraft(draft) {
      try { localStorage.setItem(DRAFT_KEY, JSON.stringify(draft)); } catch (e) { /* ignore */ }
    }
    function dropDraft() {
      try { localStorage.removeItem(DRAFT_KEY); } catch (e) { /* ignore */ }
    }

    const val = (row, sel) => row.querySelector(sel)?.value || "";

    const readJsRows = () => Array.from(jsBody.rows).map((row) => ({
      fsRollId: val(row, ".js-fs-roll-id"),
      adRollId: val(row, ".js-ad-roll-id"),
      rlRollId: val(row, ".js-rl-roll-id"),
      rollId: val(row, ".js-fs-roll-id") || val(row, ".js-roll-id"),
      mtrs1: val(row, ".js-mtrs1"),
      start: val(row, ".js-start-input"),
      mtrs2: val(row, ".js-mtrs2"),
      stop: val(row, ".js-stop-input"),
    }));

    const readLogRows = () => Array.from(logDoneBody.rows).concat(Array.from(logBody.rows)).map((row) => ({
      fsRollId: val(row, ".log-fs-roll-id"),
      adRollId: val(row, ".log-ad-roll-id"),
      rlRollId: val(row, ".log-rl-roll-id"),
      rollId: val(row, ".log-fs-roll-id") || val(row, ".log-roll-id"),
      startMtrs: val(row, ".log-start-mtrs"),
      start: val(row, ".log-start-input"),
      stopMtrs: val(row, ".log-stop-mtrs"),
      end: val(row, ".log-end-input"),
      meters: val(row, ".log-meters"),
      faceJoint: val(row, ".log-face-joint"),
      faceMtr: val(row, ".log-face-mtr"),
      releaseJoint: val(row, ".log-release-joint"),
      releaseMtr: val(row, ".log-release-mtr"),
      deckleId: val(row, ".log-deckle-id-input"),
      instantProduced: val(row, ".log-instant-produced-input"),
    }));

    const anyEntry = (rows) =>
      rows.some((r) => Object.values(r).some((v) => String(v ?? "").trim() !== ""));

    // Hidden until at least one Production Log row has something in it --
    // every Production Log row is a Deckle, so a Job Setting entry alone
    // (setup wastage, no deckle) has nothing yet worth saving.
    const saveEntryBtn = document.getElementById("saveEntryBtn");
    const saveBtnWrap = document.getElementById("saveBtnWrap");
    function updateSaveButtonState() {
      if (!saveEntryBtn || saveEntryBtn.dataset.submitting === "1") return;
      const ready = anyEntry(readLogRows());
      if (saveBtnWrap) saveBtnWrap.style.display = ready ? "" : "none";
      saveEntryBtn.disabled = !ready;
      saveEntryBtn.title = ready ? "" : "Enter at least one Production Log value first.";
    }

    function saveDraft() {
      const draft = {
        jsRows: readJsRows(),
        logRows: readLogRows(),
        currentMaterials: { ...currentMaterials },
        prodLogStarted,
        savedAt: Date.now(),
      };
      const anyMaterial = currentMaterials.fs || currentMaterials.ad || currentMaterials.rl;
      if (!anyEntry(draft.jsRows) && !anyEntry(draft.logRows) && !prodLogStarted && !anyMaterial) { dropDraft(); return; }
      writeDraft(draft);
    }

    let draftTimer = null;
    function scheduleSave() { clearTimeout(draftTimer); draftTimer = setTimeout(saveDraft, 400); }

    function markPunched(btn, display, input, time) {
      if (!btn || !input || !time) return;
      input.value = time;
      if (display) display.textContent = time;
      btn.dataset.punched = "1";
      btn.disabled = true;
      btn.title = "";
      btn.innerHTML = '<i class="fa-solid fa-check"></i>';
      btn.style.background = "#6b7280";
      btn.style.cursor = "default";
    }

    const putValue = (row, sel, value) => {
      const el = row.querySelector(sel);
      if (!el) return;
      el.value = value ?? "";
    };

    function applyJsRows(rows) {
      while (jsBody.rows.length < rows.length) jsBody.appendChild(createJsRow());
      while (jsBody.rows.length > rows.length && jsBody.rows.length > 1) jsBody.removeChild(jsBody.lastElementChild);
      rows.forEach((data, i) => {
        const row = jsBody.rows[i];
        if (!row) return;
        putValue(row, ".js-fs-roll-id", data.fsRollId || data.rollId);
        putValue(row, ".js-ad-roll-id", data.adRollId);
        putValue(row, ".js-rl-roll-id", data.rlRollId);
        putValue(row, ".js-mtrs1", data.mtrs1);
        putValue(row, ".js-mtrs2", data.mtrs2);
        markPunched(
          row.querySelector(".js-start-btn"),
          row.querySelector(".js-start-display"),
          row.querySelector(".js-start-input"),
          data.start,
        );
        markPunched(
          row.querySelector(".js-stop-btn"),
          row.querySelector(".js-stop-display"),
          row.querySelector(".js-stop-input"),
          data.stop,
        );
        syncJsRowButtons(row);
      });
      jsRenumber();
      updateStartProdLogButton();
    }

    function fillLogRow(row, data) {
      markPunched(
        row.querySelector(".log-start-btn"),
        row.querySelector(".log-start-display"),
        row.querySelector(".log-start-input"),
        data.start,
      );
      markPunched(
        row.querySelector(".log-stop-btn"),
        row.querySelector(".log-end-display"),
        row.querySelector(".log-end-input"),
        data.end,
      );
      putValue(row, ".log-fs-roll-id", data.fsRollId || data.rollId);
      putValue(row, ".log-ad-roll-id", data.adRollId);
      putValue(row, ".log-rl-roll-id", data.rlRollId);
      putValue(row, ".log-start-mtrs", data.startMtrs);
      putValue(row, ".log-stop-mtrs", data.stopMtrs);
      putValue(row, ".log-meters", data.meters);
      putValue(row, ".log-face-joint", data.faceJoint);
      putValue(row, ".log-face-mtr", data.faceMtr);
      putValue(row, ".log-release-joint", data.releaseJoint);
      putValue(row, ".log-release-mtr", data.releaseMtr);
      putValue(row, ".log-deckle-id-input", data.deckleId);
      putValue(row, ".log-instant-produced-input", data.instantProduced);
      if (data.deckleId && data.instantProduced === "1") {
        setLogDeckleNote(row, `✓ ${data.deckleId} — in Semi Finished Stock`, "#059669");
        lockProducedRow(row);
      }
      syncLogRowButtons(row);
    }

    // Restoring a draft: every row goes into the done table except a
    // trailing one that was never punched Stop -- that one becomes the
    // active entry row. (A draft saved before this change could have several
    // unfinished rows; only the very last is treated as "still being typed
    // in", the rest are shown as done so nothing is silently dropped.)
    function applyLogRows(rows) {
      logDoneBody.innerHTML = "";
      while (logBody.rows.length > 1) logBody.removeChild(logBody.lastElementChild);
      if (!logBody.rows.length) logBody.appendChild(createLogRow());

      const list = rows.slice();
      const activeData = list.length && !list[list.length - 1].end ? list.pop() : null;

      list.forEach((data) => {
        const row = createLogRow();
        fillLogRow(row, data);
        finalizeDoneRow(row);
        logDoneBody.appendChild(row);
      });
      if (logDoneBody.rows.length) prodLogDoneWrap.classList.remove("jc-hidden");

      if (activeData) fillLogRow(logBody.rows[0], activeData);

      renumber();
    }

    function restoreDraft() {
      const draft = readDraft();
      if (!draft) return;

      if (draft.currentMaterials) {
        MATERIAL_POOL_ORDER.forEach((pool) => {
          const rollId = draft.currentMaterials[pool];
          if (!rollId) return;
          currentMaterials[pool] = rollId;
          const input = materialSlot(pool)?.querySelector(".jc-cur-roll-input");
          if (input) input.value = rollId;
          lockMaterialSlot(pool);
          checkMaterialInput(input, pool);
        });
      }
      if (Array.isArray(draft.jsRows) && draft.jsRows.length) applyJsRows(draft.jsRows);
      if (Array.isArray(draft.logRows) && draft.logRows.length) applyLogRows(draft.logRows);
      syncCurrentMaterialsToOpenRows();
      if (draft.prodLogStarted) revealProdLogSection();
      recalcLogTotals();
      if (typeof showToast === "function") showToast("Restored your unsaved entry", "success");
    }

    const jcForm = document.getElementById("jcForm");
    if (jcForm) {
      ["input", "change", "click"].forEach((evt) => jcForm.addEventListener(evt, scheduleSave));
      ["input", "change", "click"].forEach((evt) => jcForm.addEventListener(evt, updateSaveButtonState));
      let jcSubmitting = false;
      jcForm.addEventListener("submit", (e) => {
        if (jcSubmitting) { e.preventDefault(); return; }
        if ((USAGE_ITEMS.length || (typeof getActiveUsageItems === "function" && getActiveUsageItems().length)) && !materialUsedCleared) {
          e.preventDefault();
          openMaterialUsedDialog();
          return;
        }
        jcSubmitting = true;
        clearTimeout(draftTimer);
        saveDraft();
        const saveBtn = jcForm.querySelector('button[type="submit"]');
        if (saveBtn) {
          saveBtn.dataset.submitting = "1";
          saveBtn.disabled = true;
          saveBtn.textContent = "Saving…";
        }
      });
    }
    window.addEventListener("pagehide", () => { clearTimeout(draftTimer); saveDraft(); });

    restoreDraft();
    updateSaveButtonState();
  });
</script>

<% if (notification && notification.length) { %>
<script>
  const jcFlash = <%- safeJson(notification[0]) %>;
  const jcFlashType = /failed|not found|error/i.test(String(jcFlash)) ? "error" : "success";
  const showJcFlash = () => {
    if (typeof hideStaticToast === "function") hideStaticToast();
    if (typeof showToast === "function") showToast(jcFlash, jcFlashType);
  };
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", showJcFlash, { once: true })
    : showJcFlash();
</script>
<% } %>
