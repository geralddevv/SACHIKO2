<% layout('/layout/boilerplate') %>

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }

    /* The card is the whole page here, so the scroll lives on this wrapper --
       .contain is a fixed-height flex column and would otherwise clip the
       form on short viewports. */
    .company-page {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      padding: 6px 4px 24px;
    }
    .company-card {
      background: #fff;
      border: 1px solid rgba(4, 74, 120, 0.14);
      border-radius: 14px;
      box-shadow: 0 12px 34px rgba(4, 74, 120, 0.09);
      width: min(940px, 100%);
      margin: 0 auto;
      overflow: hidden;
    }

    .company-card-head {
      background: linear-gradient(135deg, #044a78 0%, #03365a 100%);
      color: #fff;
      padding: 18px 24px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .company-card-head .head-icon {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    .company-card-head h2 {
      margin: 0;
      font-size: 1.08rem;
      font-weight: 700;
      letter-spacing: 0.2px;
    }
    .company-card-head p {
      margin: 3px 0 0;
      font-size: 12px;
      opacity: 0.82;
    }
    .head-text {
      min-width: 0;
    }
    .head-actions {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .status-pill {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      padding: 5px 11px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.3);
      white-space: nowrap;
    }

    .company-card-body {
      padding: 8px 24px 0;
    }

    /* Address block and contact block read as two different things -- a light
       rule keeps them apart without boxing the form into panels. */
    .form-section {
      padding: 20px 0;
      border-bottom: 1px solid #eceff3;
    }
    .form-section:last-of-type {
      border-bottom: none;
    }
    .section-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.1px;
      text-transform: uppercase;
      color: #7d8ea0;
      margin: 0 0 16px;
    }
    .section-title i {
      font-size: 12px;
      color: #044a78;
    }

    .field-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 16px 18px;
    }
    .fg-4 { grid-column: span 4; }
    .fg-6 { grid-column: span 6; }
    .fg-12 { grid-column: span 12; }
    @media (max-width: 760px) {
      .fg-4, .fg-6 { grid-column: span 12; }
    }

    .field-label {
      display: block;
      font-size: 12.5px;
      font-weight: 600;
      color: #44566b;
      margin-bottom: 7px;
    }
    .field-label .req {
      color: #e8483f;
      margin-left: 3px;
    }

    .field-grid input,
    .field-grid textarea {
      width: 100%;
      height: 42px;
      border: 1px solid #d4dde6;
      border-radius: 8px;
      padding: 0 12px;
      font-size: 14px;
      color: #1d2b3a;
      /* tableDisp.css (loaded for .indi-head) styles every `input` globally
         with `background-color: #f8f9fa !important`, so an editable field and
         a locked one would otherwise paint identically. Same reason
         .premium-input in boilerplate.ejs marks its own properties important. */
      background-color: #fff !important;
      transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }
    .field-grid textarea {
      height: auto;
      padding: 10px 12px;
      resize: none;
      line-height: 1.5;
    }
    .field-grid input::placeholder,
    .field-grid textarea::placeholder {
      color: #a7b4c2;
    }
    .field-grid input:focus,
    .field-grid textarea:focus {
      outline: none;
      border-color: #044a78;
      box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.13);
    }
    /* Saved-and-not-editing: the same fields, locked, so the page reads as a
       record rather than an always-open form. */
    .field-grid input:disabled,
    .field-grid textarea:disabled {
      background-color: #eef2f7 !important;
      border-color: #dfe7ee;
      color: #1d2b3a;
      cursor: default;
      -webkit-text-fill-color: #1d2b3a; /* Safari/iOS grey out disabled text otherwise */
      opacity: 1;
    }

    .form-error {
      display: none;
      align-items: center;
      gap: 8px;
      margin: 0 0 4px;
      padding: 11px 14px;
      border-radius: 8px;
      background: #fdeceb;
      border: 1px solid #f6c9c6;
      color: #b42318;
      font-size: 13px;
      font-weight: 500;
    }
    .form-error.show {
      display: flex;
    }

    .form-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      padding: 16px 24px;
      background: #fafbfc;
      border-top: 1px solid #eceff3;
    }
    .form-footer .hint {
      margin-right: auto;
      font-size: 12px;
      color: #8b98a6;
    }
    .co-btn {
      border-radius: 8px;
      padding: 9px 20px;
      font-size: 14px;
      font-weight: 600;
      border: 1px solid #d4dde6;
      background: #fff;
      color: #44566b;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .co-btn:hover {
      background: #f1f4f7;
    }
    .co-btn.primary {
      background: #044a78;
      border-color: #044a78;
      color: #fff;
      box-shadow: 0 2px 8px rgba(4, 74, 120, 0.25);
    }
    .co-btn.primary:hover {
      background: #03365a;
    }
    .co-btn:disabled {
      opacity: 0.65;
      cursor: default;
    }

    .logo-control {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .logo-box {
      width: 72px;
      height: 72px;
      flex: 0 0 72px;
      border-radius: 16px;
      background: #044a78;
      border: 1px solid rgba(4, 74, 120, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      color: #fff;
      font-size: 30px;
      font-weight: 700;
      user-select: none;
    }
    .logo-box img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .logo-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .logo-hint { margin: 8px 0 0; font-size: 12px; color: #8b98a6; }
  </style>

  <div class="indi-head">
    <h1>Company Registration</h1>
  </div>

  <div class="company-page">
    <div class="company-card">
      <div class="company-card-head">
        <div class="head-icon"><i class="fa-solid fa-building"></i></div>
        <div class="head-text">
          <h2 id="cardTitle"><%= company ? "Company Details" : "Register Company" %></h2>
          <p id="cardSubtitle">
            <%= company ? "Use Edit to change these details." : "Fill in the details below to register your company." %>
          </p>
        </div>
        <div class="head-actions">
          <span class="status-pill" id="statusPill"><%= company ? "Registered" : "Not registered" %></span>
          <button class="header-action-btn" type="button" id="editBtn" onclick="startEdit()"
            style="<%= company ? '' : 'display: none;' %>">
            <i class="fa-solid fa-pen-to-square" style="margin-right: 6px"></i> Edit
          </button>
        </div>
      </div>

      <div class="company-card-body">
        <div class="form-section">
          <p class="section-title"><i class="fa-solid fa-location-dot"></i> Company &amp; Address</p>
          <div class="field-grid">
            <div class="fg-12 logo-row">
              <label class="field-label">Logo <span style="font-weight:500;color:#8b98a6;">(optional)</span></label>
              <div class="logo-control">
                <div class="logo-box" id="logoBox">
                  <img id="logoImg" alt="Company logo"
                       src="<%= (company && company.logo && company.logo.filename) ? ('/company/favicon?v=' + encodeURIComponent(company.logo.filename)) : '' %>"
                       <%= (company && company.logo && company.logo.filename) ? '' : 'hidden' %> />
                  <span id="logoLetter"><%= company && company.companyName ? company.companyName.trim().charAt(0).toUpperCase() : '' %></span>
                </div>
                <div class="logo-actions" id="logoActions" <%= company ? '' : 'hidden' %>>
                  <button type="button" class="co-btn" id="logoPickBtn">
                    <i class="fa-solid fa-arrow-up-from-bracket" style="margin-right:6px;"></i>
                    <span id="logoPickLabel"><%= (company && company.logo) ? 'Replace logo' : 'Upload logo' %></span>
                  </button>
                  <button type="button" class="co-btn" id="logoRemoveBtn"
                          <%= (company && company.logo) ? '' : 'hidden' %>>Remove</button>
                  <input type="file" id="logoFile" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
                </div>
              </div>
              <p class="logo-hint" id="logoHint">
                <%= company ? 'PNG or JPG. If no logo is set, the first letter of the company name is used.' : 'You can add a logo after registering the company.' %>
              </p>
            </div>

            <div class="fg-12">
              <label class="field-label" for="companyName">Company Name<span class="req">*</span></label>
              <input type="text" id="companyName" autocomplete="off" maxlength="150"
                placeholder="Enter company name" value="<%= company ? company.companyName : '' %>" />
            </div>

            <div class="fg-12">
              <label class="field-label" for="address">Address<span class="req">*</span></label>
              <textarea id="address" rows="3" maxlength="400"
                placeholder="Building, street, area"><%= company ? company.address : '' %></textarea>
            </div>

            <div class="fg-4">
              <label class="field-label" for="state">State<span class="req">*</span></label>
              <input type="text" id="state" autocomplete="off" maxlength="80"
                placeholder="Enter state" value="<%= company ? company.state : '' %>" />
            </div>

            <div class="fg-4">
              <label class="field-label" for="country">Country<span class="req">*</span></label>
              <input type="text" id="country" autocomplete="off" maxlength="80"
                placeholder="Enter country" value="<%= company ? company.country : '' %>" />
            </div>

            <div class="fg-4">
              <label class="field-label" for="pincode">Pincode<span class="req">*</span></label>
              <input type="text" id="pincode" autocomplete="off" maxlength="12" inputmode="numeric"
                placeholder="Enter pincode" value="<%= company ? company.pincode : '' %>" />
            </div>
          </div>
        </div>

        <div class="form-section">
          <p class="section-title"><i class="fa-solid fa-address-book"></i> Contact</p>
          <div class="field-grid">
            <div class="fg-6">
              <label class="field-label" for="mobile">Mobile<span class="req">*</span></label>
              <input type="tel" id="mobile" autocomplete="off" maxlength="30"
                placeholder="Enter mobile number" value="<%= company ? company.mobile : '' %>" />
            </div>

            <div class="fg-6">
              <label class="field-label" for="telephone">Telephone</label>
              <input type="tel" id="telephone" autocomplete="off" maxlength="30"
                placeholder="Enter telephone number" value="<%= company ? company.telephone : '' %>" />
            </div>

            <%# type="email"/type="url" rather than type="text" on purpose --
                common.js force-uppercases every text input on input, which
                would mangle an address or a URL. %>
            <div class="fg-6">
              <label class="field-label" for="email">E-mail</label>
              <input type="email" id="email" autocomplete="off" maxlength="120"
                placeholder="name@company.com" value="<%= company ? company.email : '' %>" />
            </div>

            <div class="fg-6">
              <label class="field-label" for="website">Website</label>
              <input type="url" id="website" autocomplete="off" maxlength="150"
                placeholder="https://www.company.com" value="<%= company ? company.website : '' %>" />
            </div>

          </div>
        </div>

        <div class="form-section">
          <p class="section-title"><i class="fa-solid fa-file-invoice"></i> Statutory &amp; Registration</p>
          <div class="field-grid">
            <div class="fg-6">
              <label class="field-label" for="gst">GST</label>
              <input type="text" id="gst" autocomplete="off" maxlength="15"
                placeholder="Enter GST number" value="<%= company ? (company.gst || '') : '' %>" />
            </div>

            <div class="fg-6">
              <label class="field-label" for="pan">PAN</label>
              <input type="text" id="pan" autocomplete="off" maxlength="10"
                placeholder="Enter PAN number" value="<%= company ? (company.pan || '') : '' %>" />
            </div>

            <div class="fg-6">
              <label class="field-label" for="msme">MSME</label>
              <input type="text" id="msme" autocomplete="off" maxlength="20"
                placeholder="Enter MSME number" value="<%= company ? (company.msme || '') : '' %>" />
            </div>

            <div class="fg-6">
              <label class="field-label" for="gumasta">Gumasta</label>
              <input type="text" id="gumasta" autocomplete="off" maxlength="30"
                placeholder="Enter Gumasta number" value="<%= company ? (company.gumasta || '') : '' %>" />
            </div>
          </div>
        </div>

        <div class="form-section">
          <p class="section-title"><i class="fa-solid fa-building-columns"></i> Bank Details</p>
          <div class="field-grid">
            <div class="fg-6">
              <label class="field-label" for="bankName">Bank Name</label>
              <input type="text" id="bankName" autocomplete="off" maxlength="120"
                placeholder="Enter bank name" value="<%= company && company.bankDetails ? (company.bankDetails.bankName || '') : '' %>" />
            </div>

            <div class="fg-6">
              <label class="field-label" for="accountHolderName">Account Holder Name</label>
              <input type="text" id="accountHolderName" autocomplete="off" maxlength="150"
                placeholder="Enter account holder name" value="<%= company && company.bankDetails ? (company.bankDetails.accountHolderName || '') : '' %>" />
            </div>

            <div class="fg-6">
              <label class="field-label" for="accountNumber">Account Number</label>
              <input type="text" id="accountNumber" autocomplete="off" maxlength="30" inputmode="numeric"
                placeholder="Enter account number" value="<%= company && company.bankDetails ? (company.bankDetails.accountNumber || '') : '' %>" />
            </div>

            <div class="fg-6">
              <label class="field-label" for="ifsc">IFSC Code</label>
              <input type="text" id="ifsc" autocomplete="off" maxlength="11"
                placeholder="Enter IFSC code" value="<%= company && company.bankDetails ? (company.bankDetails.ifsc || '') : '' %>" />
            </div>

            <div class="fg-12">
              <label class="field-label" for="branch">Branch</label>
              <input type="text" id="branch" autocomplete="off" maxlength="120"
                placeholder="Enter branch name" value="<%= company && company.bankDetails ? (company.bankDetails.branch || '') : '' %>" />
            </div>

            <div class="fg-12">
              <div id="formError" class="form-error">
                <i class="fa-solid fa-circle-exclamation"></i><span id="formErrorText"></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="form-footer" id="formActions" style="<%= company ? 'display: none;' : '' %>">
        <span class="hint"><span class="req" style="color: #e8483f">*</span> Required fields</span>
        <button class="co-btn" type="button" id="cancelBtn" onclick="cancelEdit()"
          style="<%= company ? '' : 'display: none;' %>">Cancel</button>
        <button class="co-btn primary" type="button" id="saveBtn" onclick="submitForm()">
          <%= company ? "Update Company" : "Save Company" %>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Rename confirmation -- uses the app's .logout-modal / .logout-dialog styles
     (boilerplate.ejs), NOT window.confirm(). -->
<div class="logout-modal" id="switchModal" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="switchTitle">
    <h2 class="logout-title" id="switchTitle">Change the company?</h2>
    <p class="logout-text" id="switchText"></p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" id="switchCancel">Cancel</button>
      <button class="logout-btn primary" type="button" id="switchConfirm">Change &amp; switch</button>
    </div>
  </div>
</div>

<script id="company-data" type="application/json"><%- safeJson(company || null) %></script>
<script>
  // safeJson() serialises null as "{}" (utils/security.js) and {} is truthy,
  // so "did the server send a company?" has to be a test for a real record --
  // otherwise a fresh install renders every field disabled with no Edit
  // button to unlock them, and the company can never be registered.
  const companyRaw = JSON.parse(document.getElementById("company-data").textContent);
  const company = companyRaw && companyRaw._id ? companyRaw : null;

  const FIELDS = [
    "companyName", "address", "state", "country", "pincode",
    "telephone", "mobile", "email", "website",
    "gst", "msme", "gumasta", "pan",
  ];
  const BANK_FIELDS = ["bankName", "accountHolderName", "accountNumber", "ifsc", "branch"];
  const ALL_FIELDS = FIELDS.concat(BANK_FIELDS);
  const REQUIRED = {
    companyName: "Company name",
    address: "Address",
    state: "State",
    country: "Country",
    pincode: "Pincode",
    mobile: "Mobile",
  };

  const el = (id) => document.getElementById(id);

  function setDisabled(disabled) {
    ALL_FIELDS.forEach((f) => { el(f).disabled = disabled; });
  }

  function showError(msg) {
    el("formErrorText").textContent = msg;
    el("formError").classList.add("show");
  }
  function hideError() {
    el("formError").classList.remove("show");
  }
  function setLoading(loading) {
    const btn = el("saveBtn");
    btn.disabled = loading;
    btn.textContent = loading ? "Saving..." : (company ? "Update Company" : "Save Company");
  }

  // A saved company starts locked; a fresh page starts as an open form.
  if (company) setDisabled(true);

  // ---- Logo -----------------------------------------------------------------
  let hasLogo = !!(company && company.logo && company.logo.filename);

  function paintLogo() {
    const img = el("logoImg");
    const letter = el("logoLetter");
    const nameForLetter = (company ? company.companyName : el("companyName").value) || "";
    letter.textContent = (nameForLetter.trim().charAt(0) || "").toUpperCase();
    if (hasLogo) {
      img.hidden = false;
      letter.style.display = "none";
    } else {
      img.hidden = true;
      img.removeAttribute("src");
      letter.style.display = "";
    }
    if (company) {
      el("logoRemoveBtn").hidden = !hasLogo;
      el("logoPickLabel").textContent = hasLogo ? "Replace logo" : "Upload logo";
    }
  }

  // Keep the placeholder letter in sync while typing the name (registration).
  el("companyName").addEventListener("input", () => { if (!hasLogo) paintLogo(); });

  function bustFavicon() {
    document.querySelectorAll('link[rel~="icon"]').forEach((lnk) => {
      lnk.href = "/company/favicon?v=" + Date.now();
    });
  }

  if (company) {
    el("logoPickBtn").addEventListener("click", () => el("logoFile").click());

    el("logoFile").addEventListener("change", async () => {
      const file = el("logoFile").files[0];
      if (!file) return;
      if (!/^image\//.test(file.type)) { showError("Please choose an image file."); return; }
      if (file.size > 5 * 1024 * 1024) { showError("Image is too large (max 5MB)."); return; }
      hideError();
      const pick = el("logoPickBtn");
      pick.disabled = true;
      el("logoRemoveBtn").disabled = true;
      try {
        const fd = new FormData();
        fd.append("logo", file);
        const res = await fetch("/acme/api/company/" + company._id + "/logo", { method: "POST", body: fd });
        const data = await res.json();
        if (data.success) {
          hasLogo = true;
          const img = el("logoImg");
          img.src = "/company/favicon?v=" + Date.now();
          paintLogo();
          bustFavicon();
        } else {
          showError(data.message || "Could not save the logo.");
        }
      } catch {
        showError("Server error while uploading the logo.");
      } finally {
        pick.disabled = false;
        el("logoRemoveBtn").disabled = false;
        el("logoFile").value = "";
      }
    });

    el("logoRemoveBtn").addEventListener("click", async () => {
      hideError();
      const rm = el("logoRemoveBtn");
      rm.disabled = true;
      el("logoPickBtn").disabled = true;
      try {
        const res = await fetch("/acme/api/company/" + company._id + "/logo", { method: "DELETE" });
        const data = await res.json();
        if (data.success) {
          hasLogo = false;
          paintLogo();
          bustFavicon();
        } else {
          showError(data.message || "Could not remove the logo.");
        }
      } catch {
        showError("Server error while removing the logo.");
      } finally {
        rm.disabled = false;
        el("logoPickBtn").disabled = false;
      }
    });
  }

  paintLogo();

  function startEdit() {
    setDisabled(false);
    el("editBtn").style.display = "none";
    el("formActions").style.display = "flex";
    hideError();
    el("companyName").focus();
  }

  function cancelEdit() {
    // Restore whatever was saved, rather than keeping half-typed edits around.
    FIELDS.forEach((f) => { el(f).value = (company && company[f]) || ""; });
    const bank = (company && company.bankDetails) || {};
    BANK_FIELDS.forEach((f) => { el(f).value = bank[f] || ""; });
    setDisabled(true);
    hideError();
    el("formActions").style.display = "none";
    el("editBtn").style.display = "flex";
  }

  function collect() {
    const payload = {};
    FIELDS.forEach((f) => { payload[f] = el(f).value.trim(); });
    payload.bankDetails = {};
    BANK_FIELDS.forEach((f) => { payload.bankDetails[f] = el(f).value.trim(); });
    return payload;
  }

  // Must match slugifyCompany() in utils/companyBrand.js -- first word, lowered,
  // letters/digits only. When this changes, the app moves to /<slug>/ and onto
  // that company's database.
  function slugOf(name) {
    const first = String(name || "").trim().split(/\s+/)[0] || "";
    return first.toLowerCase().replace(/[^a-z0-9]/g, "");
  }

  // In-app confirmation (not window.confirm). Resolves true / false.
  function confirmSwitch(name, slug) {
    return new Promise((resolve) => {
      const modal = el("switchModal");
      el("switchText").innerHTML =
        'Saving this name moves the app to <strong>/' + slug + '/…</strong> and onto ' +
        'the <strong>' + slug + '</strong> database — a new empty one is created if it ' +
        "doesn't exist yet, otherwise its existing data is used. Everyone is signed out. " +
        "The data in the current database is left untouched.";
      let done = false;
      const finish = (val) => {
        if (done) return;
        done = true;
        modal.classList.remove("show");
        modal.setAttribute("aria-hidden", "true");
        el("switchConfirm").removeEventListener("click", onYes);
        el("switchCancel").removeEventListener("click", onNo);
        modal.removeEventListener("click", onBackdrop);
        document.removeEventListener("keydown", onKey);
        resolve(val);
      };
      const onYes = () => finish(true);
      const onNo = () => finish(false);
      const onBackdrop = (e) => { if (e.target === modal) finish(false); };
      const onKey = (e) => { if (e.key === "Escape") finish(false); };
      el("switchConfirm").addEventListener("click", onYes);
      el("switchCancel").addEventListener("click", onNo);
      modal.addEventListener("click", onBackdrop);
      document.addEventListener("keydown", onKey);
      modal.classList.add("show");
      modal.setAttribute("aria-hidden", "false");
      el("switchConfirm").focus();
    });
  }

  function showReloadOverlay(redirect) {
    const o = document.createElement("div");
    o.style.cssText =
      "position:fixed;inset:0;z-index:100000;background:rgba(4,74,120,0.96);color:#fff;" +
      "display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;" +
      "font-size:15px;text-align:center;padding:24px;";
    o.innerHTML =
      '<i class="fa-solid fa-circle-notch fa-spin" style="font-size:30px"></i>' +
      "<div>Switched to the company database.</div>" +
      '<div style="font-size:12.5px;opacity:.8">Taking you to the sign-in page…</div>';
    document.body.appendChild(o);
    setTimeout(() => { window.location.href = redirect; }, 1500);
  }

  async function submitForm() {
    const payload = collect();

    for (const [field, label] of Object.entries(REQUIRED)) {
      if (!payload[field]) {
        showError(label + " is required.");
        el(field).focus();
        return;
      }
    }

    // Renaming to a different first word moves the app to another URL + database.
    // Confirm in-app before doing something that big.
    const newSlug = slugOf(payload.companyName);
    const slugChanges = newSlug && newSlug !== slugOf(company ? company.companyName : "");
    if (slugChanges && company) {
      const ok = await confirmSwitch(payload.companyName, newSlug);
      if (!ok) return;
    }

    hideError();
    setLoading(true);

    try {
      const res = company
        ? await fetch("/acme/api/company/" + company._id, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          })
        : await fetch("/acme/form/company", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
      const data = await res.json();
      if (data.success) {
        if (data.reload) {
          showReloadOverlay(data.redirect || "/");
        } else {
          window.location.href = data.redirect || "/acme/form/company";
        }
      } else {
        showError(data.message || "Failed to save company.");
      }
    } catch {
      showError("Server error. Please try again.");
    } finally {
      setLoading(false);
    }
  }
</script>
