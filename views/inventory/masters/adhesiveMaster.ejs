      <div id="editAdhesiveError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeEditDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="editSubmitBtn" onclick="submitEdit()">Update Adhesive</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ VIEW ADHESIVE DIALOG ============ -->
<div class="logout-modal" id="viewDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="viewDialogTitle"
    style="width: min(640px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="viewDialogTitle">Adhesive Details</h2>
      <button class="dialog-close-btn" type="button" onclick="closeViewDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div id="viewBody"></div>
    </div>
  </div>
</div>

<!-- ============ DELETE CONFIRMATION DIALOG ============ -->
<div class="logout-modal" id="deleteDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteDialogTitle"
    style="width: min(400px, 95vw);">
    <h2 class="logout-title" id="deleteDialogTitle">
      <i class="fa-solid fa-triangle-exclamation" style="color: #ef4444; margin-right: 8px;"></i>Delete Adhesive?
    </h2>
    <p class="logout-text">
      Are you sure you want to delete <strong id="deleteSkuId"></strong>? This action cannot be undone.
    </p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" onclick="closeDeleteDialog()">Cancel</button>
      <button
        class="logout-btn"
        type="button"
        id="deleteConfirmBtn"
        onclick="submitDelete()"
        style="background: #ef4444; color: #fff; border-color: #ef4444;">
        Yes, Delete
      </button>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.20/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script id="adhesives-data" type="application/json"><%- safeJson(adhesives) %></script>
<script id="preview-skuid-data" type="application/json"><%- safeJson(previewSkuId) %></script>
<script>
  const adhesivesData = JSON.parse(document.getElementById("adhesives-data").textContent);
  let previewSkuId = JSON.parse(document.getElementById("preview-skuid-data").textContent);

  let addTypeChoices = null;
  let editTypeChoices = null;
  let addVendorChoices = null;
  let editVendorChoices = null;

  // ---- Table ----
  const table = new Tabulator("#adhesive-master-table", {
    data: adhesivesData,
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No adhesive masters added yet.",
    columns: [
      // getPosition(true) is the row's rank among currently sorted/filtered
      // rows, re-evaluated on every redraw -- stays correct after sorting or
      // filtering instead of a static index frozen at load time.
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      {
        title: "Actions",
        width: 140,
        hozAlign: "center",
        headerSort: false,
        formatter: function (cell) {
          const row = cell.getRow().getData();
          const wrap = document.createElement("div");
          wrap.style.cssText = "display:flex; gap:5px; justify-content:center;";

          const viewBtn = document.createElement("button");
          viewBtn.className = "loc-btn";
          viewBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#044a78;";
          viewBtn.title = "View Adhesive";
          viewBtn.innerHTML = '<i class="fa-solid fa-eye"></i>';
          viewBtn.addEventListener("click", () => openViewDialog(row));

          const editBtn = document.createElement("button");
          editBtn.className = "loc-btn";
          editBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#e67e22;";
          editBtn.title = "Edit Adhesive";
          editBtn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
          editBtn.addEventListener("click", () => openEditDialog(row));

          const deleteBtn = document.createElement("button");
          deleteBtn.className = "loc-btn";
          deleteBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#d9534f;";
          deleteBtn.title = "Delete Adhesive";
          deleteBtn.innerHTML = '<i class="fa-solid fa-trash"></i>';
          deleteBtn.addEventListener("click", () => openDeleteDialog(row._id, row.skuId));

          wrap.appendChild(viewBtn);
          wrap.appendChild(editBtn);
          wrap.appendChild(deleteBtn);
          return wrap;
        },
      },
      { title: "SKU ID", field: "skuId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 160 },
      { title: "Vendor Name", field: "vendorName", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150 },
      { title: "Type", field: "type", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110 },
      { title: "Make", field: "make", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130, formatter: (cell) => cell.getValue() || "—" },
      { title: "Vendor SKU Code", field: "vendorSkuCode", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150 },
      { title: "MSQ", field: "msq", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Viscosity", field: "viscosity", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Cohesion", field: "cohesion", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Shear", field: "shear", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Density", field: "density", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever's actually on
  // screen, top to bottom, is renumbered 1..n every time the table redraws.
  table.on("renderComplete", function () {
    document.querySelectorAll("#adhesive-master-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  // ---- Download dropdown ----
  const downloadSelector = document.getElementById("downloadSelector");
  const downloadTrigger = downloadSelector.querySelector(".download-selector__trigger");
  downloadTrigger.addEventListener("click", (e) => {
    e.stopPropagation();
    downloadSelector.classList.toggle("download-selector--active");
  });
  document.addEventListener("click", () => downloadSelector.classList.remove("download-selector--active"));
  downloadSelector.querySelector(".download-selector__menu").addEventListener("click", (e) => e.stopPropagation());

  document.getElementById("download-pdf").addEventListener("click", () => {
    table.download("pdf", "adhesive-master.pdf", { orientation: "landscape", title: "Adhesive Master" });
    downloadSelector.classList.remove("download-selector--active");
  });
  document.getElementById("download-xlsx").addEventListener("click", () => {
    table.download("xlsx", "adhesive-master.xlsx", { sheetName: "Adhesive Master" });
    downloadSelector.classList.remove("download-selector--active");
  });

  // ---- Helpers ----
  function openModal(id) {
    const d = document.getElementById(id);
    d.classList.add("show");
    d.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const d = document.getElementById(id);
    d.classList.remove("show");
    d.setAttribute("aria-hidden", "true");
  }
  function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.style.display = "block";
  }
  function hideError(elId) {
    document.getElementById(elId).style.display = "none";
  }
  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.disabled = loading;
    btn.style.opacity = loading ? "0.7" : "";
  }

  function detailRow(label, value) {
    return `
      <div style="display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid #f1f5f9;">
        <span style="color:#64748b; font-size:13px;">${label}</span>
        <span style="color:#0f172a; font-weight:600; font-size:13px;">${value}</span>
      </div>
    `;
  }

  // ---- VIEW ----
  function openViewDialog(row) {
    document.getElementById("viewBody").innerHTML = [
      detailRow("SKU ID", row.skuId),
      detailRow("Vendor Name", row.vendorName || "—"),
      detailRow("Type", row.type || "—"),
      detailRow("Make", row.make || "—"),
      detailRow("Vendor SKU Code", row.vendorSkuCode || "—"),
      detailRow("Viscosity", row.viscosity ?? "—"),
      detailRow("Cohesion", row.cohesion ?? "—"),
      detailRow("Shear", row.shear ?? "—"),
      detailRow("Density", row.density ?? "—"),
      detailRow("MSQ", row.msq ?? "—"),
    ].join("");
    openModal("viewDialog");
  }
  function closeViewDialog() {
    closeModal("viewDialog");
  }

  ["addDialog", "editDialog", "viewDialog", "deleteDialog"].forEach(id => {
    document.getElementById(id).addEventListener("click", function (e) {
      if (e.target === this) closeModal(id);
    });
  });

  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    ["addDialog", "editDialog", "viewDialog", "deleteDialog"].forEach(id => {
      if (document.getElementById(id).classList.contains("show")) closeModal(id);
    });
  });

  // ---- ADD ----
  function openAddDialog() {
    document.getElementById("addSkuIdPreview").value = previewSkuId;
    document.getElementById("addMakeInput").value = "";
    document.getElementById("addVendorSkuCodeInput").value = "";
    document.getElementById("addViscosityInput").value = "";
    document.getElementById("addCohesionInput").value = "";
    document.getElementById("addShearInput").value = "";
    document.getElementById("addDensityInput").value = "";
    document.getElementById("addMsqInput").value = "";

    if (addTypeChoices) { addTypeChoices.destroy(); addTypeChoices = null; }
    document.getElementById("addTypeSelect").value = "";
    addTypeChoices = new Choices("#addTypeSelect", { searchEnabled: false, shouldSort: false, itemSelectText: "" });

    if (addVendorChoices) { addVendorChoices.destroy(); addVendorChoices = null; }
    document.getElementById("addVendorSelect").value = "";
    addVendorChoices = new Choices("#addVendorSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    hideError("addAdhesiveError");
    openModal("addDialog");
  }
  function closeAddDialog() {
    closeModal("addDialog");
  }

  async function submitAdd() {
    const vendorId = document.getElementById("addVendorSelect").value;
    const type = document.getElementById("addTypeSelect").value;
    const vendorSkuCode = document.getElementById("addVendorSkuCodeInput").value.trim();
    if (!vendorId) return showError("addAdhesiveError", "Vendor Name is required.");
    if (!type) return showError("addAdhesiveError", "Type is required.");
    if (!vendorSkuCode) return showError("addAdhesiveError", "Vendor SKU Code is required.");

    hideError("addAdhesiveError");
    setLoading("addSubmitBtn", true);
    try {
      const res = await fetch("/sachiko/form/adhesive", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          vendorId,
          type,
          make: document.getElementById("addMakeInput").value.trim(),
          vendorSkuCode,
          viscosity: document.getElementById("addViscosityInput").value,
          cohesion: document.getElementById("addCohesionInput").value,
          shear: document.getElementById("addShearInput").value,
          density: document.getElementById("addDensityInput").value,
          msq: document.getElementById("addMsqInput").value,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/sachiko/form/adhesive";
      } else {
        showError("addAdhesiveError", data.message || "Failed to add adhesive.");
      }
    } catch {
      showError("addAdhesiveError", "Server error. Please try again.");
    } finally {
      setLoading("addSubmitBtn", false);
    }
  }

  // ---- EDIT ----
  let editId = null;

  function openEditDialog(row) {
    editId = row._id;
    document.getElementById("editSkuIdDisplay").value = row.skuId;
    document.getElementById("editMakeInput").value = row.make || "";
    document.getElementById("editVendorSkuCodeInput").value = row.vendorSkuCode || "";
    document.getElementById("editViscosityInput").value = row.viscosity ?? "";
    document.getElementById("editCohesionInput").value = row.cohesion ?? "";
    document.getElementById("editShearInput").value = row.shear ?? "";
    document.getElementById("editDensityInput").value = row.density ?? "";
    document.getElementById("editMsqInput").value = row.msq ?? "";

    if (editTypeChoices) { editTypeChoices.destroy(); editTypeChoices = null; }
    document.getElementById("editTypeSelect").value = row.type || "";
    editTypeChoices = new Choices("#editTypeSelect", { searchEnabled: false, shouldSort: false, itemSelectText: "" });

    if (editVendorChoices) { editVendorChoices.destroy(); editVendorChoices = null; }
    document.getElementById("editVendorSelect").value = row.vendorId || "";
    editVendorChoices = new Choices("#editVendorSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    hideError("editAdhesiveError");
    openModal("editDialog");
  }
  function closeEditDialog() {
    closeModal("editDialog");
    editId = null;
  }

  async function submitEdit() {
    const vendorId = document.getElementById("editVendorSelect").value;
    const type = document.getElementById("editTypeSelect").value;
    const vendorSkuCode = document.getElementById("editVendorSkuCodeInput").value.trim();
    if (!vendorId) return showError("editAdhesiveError", "Vendor Name is required.");
    if (!type) return showError("editAdhesiveError", "Type is required.");
    if (!vendorSkuCode) return showError("editAdhesiveError", "Vendor SKU Code is required.");
    if (!editId) return;

    hideError("editAdhesiveError");
    setLoading("editSubmitBtn", true);
    try {
      const res = await fetch(`/sachiko/api/adhesive/${editId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          vendorId,
          type,
          make: document.getElementById("editMakeInput").value.trim(),
          vendorSkuCode,
          viscosity: document.getElementById("editViscosityInput").value,
          cohesion: document.getElementById("editCohesionInput").value,
          shear: document.getElementById("editShearInput").value,
          density: document.getElementById("editDensityInput").value,
          msq: document.getElementById("editMsqInput").value,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showError("editAdhesiveError", data.message || "Failed to update adhesive.");
      }
    } catch {
      showError("editAdhesiveError", "Server error. Please try again.");
    } finally {
      setLoading("editSubmitBtn", false);
    }
  }

  // ---- DELETE ----
  let deleteId = null;

  function openDeleteDialog(id, skuId) {
    deleteId = id;
    document.getElementById("deleteSkuId").textContent = skuId;
    openModal("deleteDialog");
  }
  function closeDeleteDialog() {
    closeModal("deleteDialog");
    deleteId = null;
  }

  async function submitDelete() {
    if (!deleteId) return;
    setLoading("deleteConfirmBtn", true);
    try {
      const res = await fetch(`/sachiko/api/adhesive/${deleteId}`, { method: "DELETE" });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        closeDeleteDialog();
        alert(data.message || "Failed to delete adhesive.");
      }
    } catch {
      closeDeleteDialog();
      alert("Error deleting adhesive.");
    } finally {
      setLoading("deleteConfirmBtn", false);
    }
  }
</script>
