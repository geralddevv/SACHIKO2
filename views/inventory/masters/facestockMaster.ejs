<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }
    #facestock-master-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    .dialog-header {
      background: #044A78;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .dialog-header h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }
    .dialog-close-btn {
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      padding: 0 2px;
      opacity: 0.8;
      transition: opacity 0.15s;
    }
    .dialog-close-btn:hover {
      opacity: 1;
    }
    .dialog-body {
      padding: 24px;
    }
    .dialog-field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 8px;
    }
    .dialog-error {
      color: #ef4444;
      font-size: 12px;
      margin-top: 5px;
      display: none;
    }
    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }
    .dialog-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 16px;
    }

    /* Match Choices.js selects to the .premium-input look used by the rest
       of this dialog's fields. */
    .dialog-body .choices__inner {
      padding: 11px 14px !important;
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      background-color: #f8fafc !important;
      font-size: 14px !important;
      min-height: 0 !important;
      transition: all 0.2s ease !important;
    }
    .dialog-body .choices__list--single {
      padding: 0 !important;
    }
    .dialog-body .choices.is-focused .choices__inner,
    .dialog-body .choices.is-open .choices__inner {
      border-color: #044a78 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 4px rgba(4, 74, 120, 0.1) !important;
    }
    .dialog-body .choices[data-type*="select-one"]::after {
      display: block !important;
      content: "" !important;
      width: 12px !important;
      height: 8px !important;
      border-style: none !important;
      border-width: 0 !important;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
      background-repeat: no-repeat !important;
      background-size: contain !important;
      position: absolute !important;
      right: 14px !important;
      top: 50% !important;
      margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    .dialog-body .choices[data-type*="select-one"].is-open::after {
      transform: translateY(-50%) rotate(180deg) !important;
    }
    /* Dropdown list must render above the dialog overlay (see CLAUDE.md
       "Dialog / modal pattern" -- Choices.js in dialogs). */
    .dialog-body .choices__list--dropdown {
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      z-index: 99999 !important;
    }
    /* A long value (e.g. Vendor Name) shouldn't overflow its field or push
       against the dropdown arrow -- truncate with an ellipsis instead, both
       for the selected value shown in the closed field and for each option
       in the open dropdown list. Applies to every Choices.js select in this
       dialog, not just Vendor Name. */
    .dialog-body .choices__list--single .choices__item {
      display: block !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
      max-width: 100% !important;
      padding-right: 18px !important;
    }
    .dialog-body .choices__list--dropdown .choices__item {
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
    }
    /* Vendor Name otherwise stretches to the dialog's full width -- a fixed
       width keeps it visually consistent regardless of how long the
       selected vendor's name is (the ellipsis rule above handles the
       overflow within it). Caps at 100% so it still shrinks to fit on
       narrow/mobile viewports. */
    .vendor-field-fixed {
      max-width: 320px;
    }

    /* GSM/Micron measure input: a value field with a segmented unit toggle
       built in, so "pick one" reads as a single control (like a unit switch
       on a modern spec sheet) instead of a separate value + a separate
       picker. Only one unit can ever be active. */
    .measure-input-group {
      display: flex;
      align-items: stretch;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      background-color: #f8fafc;
      overflow: hidden;
      transition: all 0.2s ease;
    }
    .measure-input-group:focus-within {
      border-color: #044a78;
      background-color: #ffffff;
      box-shadow: 0 0 0 4px rgba(4, 74, 120, 0.1);
    }
    .measure-value-input.premium-input {
      flex: 1 1 auto;
      min-width: 0;
      border: none !important;
      background: transparent !important;
      box-shadow: none !important;
    }
    .measure-toggle {
      display: flex;
      align-items: center;
      gap: 2px;
      padding: 4px;
      flex: 0 0 auto;
    }
    .measure-toggle-btn {
      border: none;
      background: transparent;
      color: #64748b;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.02em;
      padding: 6px 12px;
      border-radius: 7px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .measure-toggle-btn:hover {
      background: #e2e8f0;
      color: #044a78;
    }
    .measure-toggle-btn.active {
      background: #044a78;
      color: #fff;
    }
  </style>

  <div class="indi-head">
    <h1>Facestock Master</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <button class="header-action-btn" onclick="openAddDialog()">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> Facestock
      </button>

      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span>
            <i class="fa-solid fa-file-arrow-down"></i>
            <span class="download-typo">Download</span>
          </span>
          <i class="fas fa-chevron-down download-selector__trigger-icon"></i>
        </button>
        <div class="download-selector__menu" id="downloads">
          <span class="download-selector__option" id="download-pdf">
            <i class="fas fa-file-pdf download-selector__option-icon"></i>
            <span>PDF</span>
          </span>
          <span class="download-selector__option" id="download-xlsx">
            <i class="fas fa-file-excel download-selector__option-icon"></i>
            <span>Excel</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="facestock-master-table" class="tabulator tabulator-modern"></div>
</div>

<!-- ============ ADD FACESTOCK DIALOG ============ -->
<div class="logout-modal" id="addDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="addDialogTitle"
    style="width: min(600px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="addDialogTitle">Add Facestock</h2>
      <button class="dialog-close-btn" type="button" onclick="closeAddDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="addSkuIdPreview">SKU ID</label>
          <input type="text" id="addSkuIdPreview" class="form-control premium-input" readonly style="background: #f1f5f9;" />
        </div>
        <div>
          <label class="dialog-field-label" for="addFamilySelect">Family</label>
          <select id="addFamilySelect">
            <option value="" disabled selected hidden>Select family</option>
            <option value="CHROMO">CHROMO</option>
            <option value="CHROMO (D. R)">CHROMO (D. R)</option>
            <option value="CLEAR PP">CLEAR PP</option>
            <option value="DOUBLE RELEASE">DOUBLE RELEASE</option>
            <option value="DT">DT</option>
            <option value="DT. PP">DT. PP</option>
            <option value="GLOSSY PP">GLOSSY PP</option>
            <option value="GLOSSY PP PARTIAL">GLOSSY PP PARTIAL</option>
            <option value="INKJET MATT FILM">INKJET MATT FILM</option>
            <option value="MAPLITO">MAPLITO</option>
            <option value="MATT PP">MATT PP</option>
            <option value="MATT PP (HT)">MATT PP (HT)</option>
            <option value="MATT PP PARTIAL">MATT PP PARTIAL</option>
            <option value="PP">PP</option>
            <option value="REMOVABLE">REMOVABLE</option>
            <option value="SILVER VOID">SILVER VOID</option>
            <option value="SUPER HOTMELT">SUPER HOTMELT</option>
          </select>
        </div>
      </div>

      <label class="dialog-field-label" for="addMakeInput">Make</label>
      <input type="text" id="addMakeInput" class="form-control premium-input" placeholder="Enter make" style="margin-bottom: 16px;" />

      <label class="dialog-field-label" for="addVendorSelect">Vendor Name</label>
      <select id="addVendorSelect" style="margin-bottom: 16px;">
        <option value="" disabled selected hidden>Select vendor</option>
        <% vendors?.forEach(v => { %>
          <option value="<%= v._id %>"><%= v.vendorName %></option>
        <% }) %>
      </select>

      <div class="dialog-field-row" style="grid-template-columns: 1fr 1fr 1fr;">
        <div>
          <label class="dialog-field-label" for="addVendorSkuCodeInput">Vendor SKU Code</label>
          <input type="text" id="addVendorSkuCodeInput" class="form-control premium-input" placeholder="Enter vendor SKU code" />
        </div>
        <div>
          <label class="dialog-field-label" for="addSizeInput">Size</label>
          <input type="text" id="addSizeInput" class="form-control premium-input" placeholder="Enter size" />
        </div>
        <div>
          <label class="dialog-field-label" for="addTypeSelect">Type</label>
          <select id="addTypeSelect">
            <option value="" disabled selected hidden>Select type</option>
            <option value="CLEAR">CLEAR</option>
            <option value="GLOSSY">GLOSSY</option>
            <option value="MATT">MATT</option>
            <option value="SEMI GLOSSY">SEMI GLOSSY</option>
          </select>
        </div>
      </div>

      <!-- GSM and micron are mutually exclusive ways of specifying thickness
           (see models/inventory/facestockMaster.js) -- a segmented unit toggle
           built into the value field, so "pick one" is a single control
           rather than a separate value + a separate picker. -->
      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label">Thickness</label>
          <div class="measure-input-group" id="addMeasureGroup">
            <input type="number" id="addMeasureValueInput" class="form-control premium-input measure-value-input" placeholder="Enter value" min="0" step="any" />
            <div class="measure-toggle" role="group" aria-label="Measure unit">
              <button type="button" class="measure-toggle-btn active" data-unit="gsm">GSM</button>
              <button type="button" class="measure-toggle-btn" data-unit="micron">Micron</button>
            </div>
          </div>
        </div>
        <div>
          <label class="dialog-field-label" for="addMsqInput">MSQ</label>
          <input type="number" id="addMsqInput" class="form-control premium-input" placeholder="Enter MSQ" min="0" step="any" />
        </div>
      </div>

      <div id="addFacestockError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeAddDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="addSubmitBtn" onclick="submitAdd()">Save Facestock</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ EDIT FACESTOCK DIALOG ============ -->
