<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .jc-page { display: flex; flex-direction: column; gap: 10px; min-height: 0; flex: 1 1 auto; overflow-y: auto; padding-right: 2px; }

    /* toolbar: one quiet line */
    .jc-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; font-size: 13px; color: #475569; padding: 2px 2px 4px; }
    .jc-bar b { color: #0f172a; }
    .jc-tools { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .jc-jump { display: inline-flex; align-items: center; gap: 6px; }
    .jc-jump input { height: 32px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0 8px; font-size: 13px; color: #0f172a; background: #fff !important; }
    .jc-jump input:focus { outline: none; border-color: #044a78; }
    .jc-link { background: none; border: none; color: #044a78; font-weight: 600; font-size: 13px; cursor: pointer; padding: 4px 6px; }
    .jc-link:hover { text-decoration: underline; }

    /* one flat card per day, folded until opened */
    .day-card { background: #fff; border: 1px solid #dbe4ee; border-radius: 10px; overflow: hidden; }
    .day-card.is-open { border-color: #044a78; }
    .day-head { display: flex; align-items: center; gap: 14px; padding: 11px 14px; cursor: pointer; user-select: none; }
    .day-head:hover { background: #f8fafc; }
    .day-head:focus-visible { outline: 2px solid #044a78; outline-offset: -2px; }
    .day-title { font-weight: 700; font-size: 14.5px; color: #0f172a; }
    .day-rel { font-size: 12px; color: #64748b; }
    .day-meta { margin-left: auto; font-size: 13px; color: #475569; font-variant-numeric: tabular-nums; }
    .day-xl { background: none; border: none; color: #166534; font-size: 12.5px; font-weight: 600; cursor: pointer; padding: 2px 4px; }
    .day-xl:hover { text-decoration: underline; }
    .day-chev { color: #94a3b8; font-size: 12px; width: 14px; text-align: center; transition: transform .15s; }
    .day-card.is-open .day-chev { transform: rotate(180deg); color: #044a78; }
    .day-body { border-top: 1px solid #e2e8f0; padding: 10px 12px 12px; }
    .day-body[hidden] { display: none; }
    .day-search { display: block; width: 260px; max-width: 100%; height: 32px; margin: 0 0 8px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0 10px; font-size: 13px; background: #fff !important; }
    .day-search:focus { outline: none; border-color: #044a78; }
    .day-msg, .jc-empty { padding: 16px; text-align: center; color: #64748b; font-size: 13.5px; }
    .jc-more { align-self: center; }
    @media (max-width: 760px) { .day-head { flex-wrap: wrap; gap: 6px 12px; } .day-meta { margin-left: 0; width: 100%; } }

    /* day tables: the app's tables are heavy blue with a border round every cell; inside a day keep it plain */
    .day-table.tabulator { border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; }
    .day-table .tabulator-header { background: #f8fafc !important; border-bottom: 1px solid #e2e8f0 !important; }
    .day-table .tabulator-header .tabulator-col,
    .day-table .tabulator-header .tabulator-col-content { background: #f8fafc !important; color: #64748b !important; font-size: 12px !important; font-weight: 600 !important; padding: 3px 8px !important; }
    .day-table .tabulator-tableholder, .day-table .tabulator-table { background: #fff !important; }
    .day-table .tabulator-row { background: #fff; border-bottom: 1px solid #f1f5f9; min-height: 36px; }
    .day-table .tabulator-row:hover { background: #f5f9fd !important; }
    .day-table .tabulator-cell { color: #1e293b !important; font-size: 13px !important; font-weight: 400; padding: 6px 8px !important; outline: none !important; border: none !important; }
    .day-table .tabulator-cell:hover { border: none !important; }
    .jc-strong { font-weight: 600; }

    /* The app's blue scrollbar: the page, the deckle popup and every day table. */
    .custom-scrollbar, .day-table .tabulator-tableholder { scrollbar-width: thin; scrollbar-color: #044A78 #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar, .day-table .tabulator-tableholder::-webkit-scrollbar { width: 10px; height: 10px; }
    .custom-scrollbar::-webkit-scrollbar-track, .day-table .tabulator-tableholder::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb, .day-table .tabulator-tableholder::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover, .day-table .tabulator-tableholder::-webkit-scrollbar-thumb:hover { background: #03365a; }
    .custom-scrollbar::-webkit-scrollbar-corner, .day-table .tabulator-tableholder::-webkit-scrollbar-corner { background: #f1f5f9; }

    /* ---- Deckle Detail dialog: variant meta + per-reel table
           (mirrors the view dialog on /sachiko/semifinishedstock) ---- */
    .dialog-field-label {
      display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 8px;
    }
    .ddx-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 16px; }
    .ddx-chip-code {
      background: #f0f7ff; border: 1px solid #d7e6f5; color: #03365a;
      font-weight: 700; font-size: 13px; padding: 4px 10px; border-radius: 7px;
    }
    .ddx-chip-muted { color: #64748b; font-size: 12.5px; font-weight: 600; }
    .ddx-table-wrap { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
    .ddx-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .ddx-table th {
      text-align: left; background: #f8fafc; color: #64748b; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.3px; font-size: 10.5px;
      padding: 7px 10px; border-bottom: 1px solid #e2e8f0;
    }
    .ddx-table td { padding: 8px 10px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .ddx-table tr:last-child td { border-bottom: none; }
    .ddx-table tr.ddx-group-start td { border-top: 2px solid #e6edf5; }
    .ddx-layer { color: #475569; font-weight: 600; white-space: nowrap; }
    .ddx-layer.is-cont { color: #cbd5e1; }
    .ddx-reel { font-weight: 700; color: #03365a; }
    .ddx-seq { color: #94a3b8; font-weight: 600; margin-left: 6px; font-size: 11px; }
    .ddx-tag {
      display: inline-block; font-size: 10px; font-weight: 700;
      padding: 2px 8px; border-radius: 999px; letter-spacing: 0.2px;
    }
    .ddx-tag-swap { background: #fef3c7; border: 1px solid #fde68a; color: #92400e; }
    .ddx-tag-final { background: #dcfce7; border: 1px solid #bbf7d0; color: #166534; }
    .ddx-muted-dash { color: #cbd5e1; }
    /* The app's blue scrollbar (same as the tables): the page itself, the deckle
       popup and every day table. Firefox gets the standard properties. */
    .custom-scrollbar, .day-table .tabulator-tableholder { scrollbar-width: thin; scrollbar-color: #044A78 #f1f5f9; }
  </style>

  <div class="indi-head">
    <h1>Deckle Logs</h1>
  </div>

  <div class="jc-page custom-scrollbar" id="jcPage">
    <div class="jc-bar">
      <span id="jcSummary">Loading…</span>
      <div class="jc-tools">
        <label class="jc-jump">Jump to <input type="date" id="jcJump" /></label>
        <button type="button" class="jc-link" id="jcCollapseAll" hidden>Collapse all</button>
      </div>
    </div>
    <div id="jcDays" aria-live="polite">
      <div class="day-msg">Loading…</div>
    </div>
    <button type="button" class="jc-link jc-more" id="jcMore" hidden></button>
  </div>

  <!-- Per-deckle breakdown for one Production Record: the Product Code /
       variant each deckle was produced as, and every raw-material reel that
       fed it (a facestock reel swapped mid-run leaves two). -->
  <div class="logout-modal" id="deckleDetailModal" aria-hidden="true">
    <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deckleDetailTitle"
      style="width: min(1000px, 96vw); padding: 0; border-radius: 14px; border: none;">
      <div class="dialog-header" style="background:#044a78; padding:16px 20px; display:flex; align-items:center; justify-content:space-between; border-radius:14px 14px 0 0;">
        <h2 id="deckleDetailTitle" style="margin:0; font-size:1rem; font-weight:700; color:#fff;">Deckles Produced</h2>
        <button type="button" onclick="closeDeckleDetail()" aria-label="Close"
          style="background:none; border:none; color:#fff; font-size:20px; cursor:pointer; line-height:1;">×</button>
      </div>
      <div class="dialog-body custom-scrollbar" style="padding:16px 20px; max-height:70vh; overflow:auto; border-radius:0 0 14px 14px;">
        <div id="deckleDetailBody"></div>
      </div>
    </div>
  </div>

  <script>
    // Landing here with ?saved=<pendingId> is the only proof a production entry
    // actually reached the server, so it's where the entry form's local draft
    // is dropped (see the autosave block in jobCardForm.ejs). Clearing it on
    // submit instead would throw the entry away on exactly the failures the
    // draft exists for -- a dead network, an expired session.
    (() => {
      const savedFor = new URLSearchParams(window.location.search).get("saved");
      if (!savedFor) return;
      try { localStorage.removeItem(`jc-draft:${savedFor}`); } catch (e) { /* ignore */ }
      // Keep the address bar clean so a refresh doesn't repeat the cleanup.
      window.history.replaceState({}, "", window.location.pathname);
    })();
  </script>
</div>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script>
  /* Deckle Logs: nothing is loaded up front but the list of days. A day's
     deckles are fetched the first time it is opened (and kept for the rest of
     the visit), so the page costs one small query until you actually look. */
  const TZ = new Date().getTimezoneOffset(); // sent so the server cuts days in YOUR timezone
  const PAGE_SIZE = 30;                       // days shown before "Show older days"
  const BASE = "/app/machine/jobcard";

  const esc = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const fmtNum = (n) => Number(n || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 });
  const plural = (n, one, many) => `${fmtNum(n)} ${Number(n) === 1 ? one : many}`;
  const keyToDate = (key) => { const [y, m, d] = key.split("-").map(Number); return new Date(y, m - 1, d); };
  const timeOf = (d) => d.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: true }).toUpperCase();
  const dayKeyOf = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  const relativeDay = (key) => {
    const diff = Math.round((keyToDate(dayKeyOf(new Date())) - keyToDate(key)) / 86400000);
    return diff === 0 ? "Today" : diff === 1 ? "Yesterday" : diff > 1 && diff < 31 ? `${diff} days ago` : "";
  };

  window.closeDeckleDetail = () => {
    const m = document.getElementById("deckleDetailModal");
    m.classList.remove("show"); m.setAttribute("aria-hidden", "true");
  };
  // `row` is one table row from /machine/jobcard/day/:key; row.detail carries the
  // reel breakdown the server resolved for it.
  function openDeckleDetail(row) {
    if (!row || !row.detail) return;
    const rows = [row.detail];
    document.getElementById("deckleDetailTitle").textContent = row.detail.deckleId
      ? `Deckle ${row.detail.deckleId} — ${row.jobCardId}`
      : `Production Log — ${row.jobCardId}`;
    const body = document.getElementById("deckleDetailBody");
    if (!rows.length) { body.innerHTML = `<p style="color:#64748b;font-weight:600;">No deckles recorded for this entry.</p>`; return; }

    const POOL_LABEL = { facestock: "Facestock", adhesive: "Adhesive", release: "Release Liner" };
    body.innerHTML = rows.map((r, i) => {
      const code = (r.productCode || "—");
      // Server (routes/system/machine.js) resolves each reel's Spec, Kg Used
      // and swap Remark and hands them over on r.reelDetails, already falling
      // back to the row's single-reel-per-pool fields when materialsUsed is
      // empty -- same shape as /sachiko/semifinishedstock's view dialog.
      const details = Array.isArray(r.reelDetails) ? r.reelDetails : [];
      const byPool = { facestock: [], adhesive: [], release: [] };
      details.forEach((d) => { if (byPool[d.pool]) byPool[d.pool].push(d); });

      // Group source reels by pool, keeping mount order. Within a pool the
      // LAST reel ran the web to the finish; any earlier one was swapped out
      // mid-run -- so that tag belongs on the earlier reels, not the final.
      const reelBodyRows = [];
      Object.keys(POOL_LABEL).forEach((p) => {
        const reels = byPool[p];
        if (!reels.length) return;
        const multi = reels.length > 1;
        reels.forEach((d, idx) => {
          const isFirst = idx === 0;
          const isFinal = idx === reels.length - 1;
          let statusCell = '<span class="ddx-muted-dash">—</span>';
          if (multi && !isFinal) statusCell = '<span class="ddx-tag ddx-tag-swap">Swapped mid-run</span>';
          else if (multi && isFinal) statusCell = '<span class="ddx-tag ddx-tag-final">Ran to finish</span>';
          reelBodyRows.push(`
            <tr${isFirst && reelBodyRows.length ? ' class="ddx-group-start"' : ""}>
              <td><span class="ddx-layer${isFirst ? "" : " is-cont"}">${isFirst ? esc(POOL_LABEL[p]) : "&#8942;"}</span></td>
              <td>
                <span class="ddx-reel">${esc(d.rollId || "—")}</span>
                ${multi ? `<span class="ddx-seq">reel ${idx + 1} of ${reels.length}</span>` : ""}
              </td>
              <td>${d.spec ? esc(d.spec) : '<span class="ddx-muted-dash">—</span>'}</td>
              <td style="text-align:right;white-space:nowrap;">${d.kgUsed != null ? esc(Number(d.kgUsed).toLocaleString("en-IN", { maximumFractionDigits: 2 })) + " kg" : '<span class="ddx-muted-dash">—</span>'}</td>
              <td>${statusCell}</td>
              <td>${d.remark ? esc(d.remark) : '<span class="ddx-muted-dash">—</span>'}</td>
            </tr>
          `);
        });
      });

      const reelTable = reelBodyRows.length
        ? `<div class="ddx-table-wrap">
            <table class="ddx-table">
              <thead><tr><th>Layer</th><th>Reel ID</th><th>Spec</th><th style="text-align:right;">Kg Used</th><th>Status</th><th>Remark</th></tr></thead>
              <tbody>${reelBodyRows.join("")}</tbody>
            </table>
          </div>`
        : '<div style="color:#94a3b8;font-size:12.5px;padding:5px 0;">No reels recorded for this Deckle.</div>';

      const joints = [
        r.face && r.face.joint ? `Face: ${esc(r.face.joint)}${r.face.mtr != null ? ` · ${esc(r.face.mtr)} mtrs` : ""}` : "",
        r.release && r.release.joint ? `Release: ${esc(r.release.joint)}${r.release.mtr != null ? ` · ${esc(r.release.mtr)} mtrs` : ""}` : "",
      ].filter(Boolean).join(" &nbsp;|&nbsp; ");

      return `<div style="margin-bottom:18px;">
        <div class="ddx-meta">
          <strong style="color:#15803d;font-size:13px;">${esc(r.deckleId || `Deckle ${i + 1}`)}</strong>
          <span class="ddx-chip-code">${esc(code)}</span>
          ${Number(r.meters) > 0 ? `<span class="ddx-chip-muted">${esc(r.meters)} mtrs</span>` : ""}
        </div>
        <div class="dialog-field-label" style="margin-bottom:8px;">Raw materials used</div>
        ${reelTable}
        ${joints ? `<div style="margin-top:12px;color:#64748b;font-size:12.5px;"><strong>Joints:</strong> ${joints}</div>` : ""}
      </div>`;
    }).join("");

    const m = document.getElementById("deckleDetailModal");
    m.classList.add("show"); m.setAttribute("aria-hidden", "false");
  }


  /* ---------- one day: header + lazily built table ---------- */
  const state = { days: [], shown: 0 };
  const loaded = new Map();   // day key -> { table, rows } once opened

  const daysEl = document.getElementById("jcDays");
  const moreBtn = document.getElementById("jcMore");
  const collapseBtn = document.getElementById("jcCollapseAll");

  function dayCardHtml(day) {
    const key = day.key || "none";
    const dt = day.key ? keyToDate(day.key) : null;
    const rel = day.key ? relativeDay(day.key) : "";
    const title = dt ? dt.toLocaleDateString("en-GB", { weekday: "long", day: "2-digit", month: "short", year: "numeric" }) : "No date";
    return `
      <section class="day-card" data-key="${esc(key)}">
        <div class="day-head" role="button" tabindex="0" aria-expanded="false">
          <span class="day-title">${esc(title)}</span>${rel ? `<span class="day-rel">${rel}</span>` : ""}
          <span class="day-meta">${plural(day.deckles, "deckle", "deckles")} &middot; ${plural(day.cards, "entry", "entries")} &middot; ${fmtNum(day.meters)} mtrs</span>
          <button type="button" class="day-xl" title="Download this day as Excel">Excel</button>
          <i class="fa-solid fa-chevron-down day-chev" aria-hidden="true"></i>
        </div>
        <div class="day-body" hidden></div>
      </section>`;
  }

  function renderDays() {
    const slice = state.days.slice(0, state.shown);
    daysEl.innerHTML = slice.length
      ? slice.map(dayCardHtml).join("")
      : `<div class="jc-empty">No deckles recorded yet.</div>`;
    const rest = state.days.length - state.shown;
    moreBtn.hidden = rest <= 0;
    if (rest > 0) moreBtn.textContent = `Show older days (${rest} more)`;
    const totals = state.days.reduce((t, d) => ({ deckles: t.deckles + d.deckles, meters: t.meters + d.meters }), { deckles: 0, meters: 0 });
    document.getElementById("jcSummary").innerHTML = state.days.length
      ? `<b>${fmtNum(state.days.length)}</b> ${state.days.length === 1 ? "day" : "days"} &middot; <b>${fmtNum(totals.deckles)}</b> deckles &middot; <b>${fmtNum(totals.meters)}</b> mtrs`
      : "No deckles yet";
  }

  function rowToTableData(r, key) {
    const made = r.madeAt ? new Date(r.madeAt) : null;
    const valid = made && !Number.isNaN(made.getTime());
    const fallbackDate = key !== "none" ? keyToDate(key).toLocaleDateString("en-GB") : "-";
    return {
      ...r,
      date: valid ? made.toLocaleDateString("en-GB") : fallbackDate,
      time: valid ? timeOf(made) : (r.endTime || "-"),
      deckleId: r.deckleId || "-",
      machineName: r.machineName || "-",
      productCode: r.productCode || "-",
      lotNo: r.lotNo || "-",
      deckleSize: r.deckleSize ?? "-",
      meters: r.meters != null && r.meters !== "" ? r.meters : "-",
      startTime: r.startTime || "-",
      endTime: r.endTime || "-",
      rollIdUsed: r.rollIdUsed || "-",
      operatorName: r.operatorName || "-",
      helperName: r.helperName || "-",
    };
  }

  const withTextFilter = (col) => ({ minWidth: 100, ...col }); // plain columns -- one search box per day instead of a filter under every heading

  function buildTable(el, data) {
    return new Tabulator(el, {
      data,
      maxHeight: "560px",
      columnDefaults: { vertAlign: "middle" },
      placeholder: "No deckles for this day",
      columns: [
        { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
          formatter: (cell) => cell.getRow().getPosition(true) },
        withTextFilter({ title: "Date",          field: "date",         width: 110 }),
        withTextFilter({ title: "Time",          field: "time",         width: 105, formatter: (cell) => `<span class="jc-strong">${esc(cell.getValue())}</span>` }),
        withTextFilter({ title: "Deckle ID",     field: "deckleId",     minWidth: 230,
          formatter: (cell) => cell.getValue() === "-" ? "-"
            : `<span style="font-weight:700;color:#15803d;text-decoration:underline;cursor:pointer;" title="Show this deckle's variant &amp; reels">${esc(cell.getValue())}</span>`,
          cellClick: (e, cell) => openDeckleDetail(cell.getData()) }),
        withTextFilter({ title: "Production ID", field: "jobCardId",    width: 160, formatter: (cell) => esc(cell.getValue()) }),
        withTextFilter({ title: "Machine",       field: "machineName",  minWidth: 110,
          formatter: (cell) => esc(cell.getValue()) }),
        withTextFilter({ title: "Product Code",  field: "productCode",  minWidth: 140, formatter: (cell) => esc(cell.getValue()) }),
        withTextFilter({ title: "Lot No",        field: "lotNo",        minWidth: 110 }),
        withTextFilter({ title: "Deckle Size",   field: "deckleSize",   minWidth: 110 }),
        withTextFilter({ title: "Meters",        field: "meters",       width: 100, hozAlign: "right", headerHozAlign: "right",
          formatter: (cell) => { const n = Number(cell.getValue()); return Number.isFinite(n) && cell.getValue() !== "-" ? `<span class="jc-strong">${fmtNum(n)}</span>` : "-"; } }),
        withTextFilter({ title: "Start",         field: "startTime",    width: 100 }),
        withTextFilter({ title: "End",           field: "endTime",      width: 100 }),
        withTextFilter({ title: "Roll ID Used",  field: "rollIdUsed",   minWidth: 150 }),
        withTextFilter({ title: "Operator",      field: "operatorName", minWidth: 120 }),
        withTextFilter({ title: "Helper",        field: "helperName",   minWidth: 120 }),
      ],
    });
  }

  // Draws a day's table into its card from rows already in hand.
  const SEARCH_FIELDS = ["date", "time", "deckleId", "jobCardId", "machineName", "productCode", "lotNo", "deckleSize", "meters", "startTime", "endTime", "rollIdUsed", "operatorName", "helperName"];

  function mountDay(card, rows) {
    const key = card.dataset.key;
    const body = card.querySelector(".day-body");
    body.innerHTML = `<input type="search" class="day-search" placeholder="Search this day…" aria-label="Search this day" /><div class="day-table"></div>`;
    const table = buildTable(body.querySelector(".day-table"), rows.map((r) => rowToTableData(r, key)));
    table.on("renderComplete", () => {
      body.querySelectorAll(".tabulator-row").forEach((rowEl, i) => {
        const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
        if (cell) cell.textContent = i + 1;
      });
    });
    // One box searches every column of this day (instead of a filter under each heading).
    const input = body.querySelector(".day-search");
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { table.clearFilter(); return; }
      table.setFilter((d) => SEARCH_FIELDS.some((f) => String(d[f] ?? "").toLowerCase().includes(q)));
    });
    return table;
  }

  // Fetches a day the first time it is opened; after that the rows are kept for
  // the visit (re-mounted if the list was re-rendered), so re-opening is instant.
  async function ensureDay(card) {
    const key = card.dataset.key;
    const body = card.querySelector(".day-body");
    const cached = loaded.get(key);
    if (cached) {
      if (!body.querySelector(".day-table")) cached.table = mountDay(card, cached.rows);
      return cached;
    }
    body.innerHTML = `<div class="day-msg">Loading…</div>`;
    try {
      const res = await fetch(`${BASE}/day/${encodeURIComponent(key)}?tz=${TZ}`, { headers: { Accept: "application/json" } });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.success) throw new Error(data?.message || "Could not load this day.");
      const entry = { rows: data.rows, table: null };
      entry.table = mountDay(card, data.rows);
      loaded.set(key, entry);
      return entry;
    } catch (err) {
      body.innerHTML = `<div class="day-msg">${esc(err.message || "Could not load this day.")} <button type="button" class="jc-link" data-retry>Try again</button></div>`;
      return null;
    }
  }

  async function setOpen(card, open) {
    const head = card.querySelector(".day-head");
    const body = card.querySelector(".day-body");
    card.classList.toggle("is-open", open);
    head.setAttribute("aria-expanded", open ? "true" : "false");
    body.hidden = !open;
    if (!open) return;
    const entry = await ensureDay(card);
    if (entry) entry.table.redraw(true); // it was built while the panel was sized by its content
    updateCollapseAll();
  }

  function updateCollapseAll() { collapseBtn.hidden = !daysEl.querySelector(".day-card.is-open"); }

  daysEl.addEventListener("click", (e) => {
    const retry = e.target.closest("[data-retry]");
    const card = e.target.closest(".day-card");
    if (!card) return;
    if (retry) { loaded.delete(card.dataset.key); setOpen(card, true); return; }
    const xl = e.target.closest(".day-xl");
    if (xl) { e.stopPropagation(); downloadDay(card); return; }
    if (e.target.closest(".day-head")) setOpen(card, !card.classList.contains("is-open"));
  });
  daysEl.addEventListener("keydown", (e) => {
    if ((e.key === "Enter" || e.key === " ") && e.target.classList.contains("day-head")) {
      e.preventDefault();
      const card = e.target.closest(".day-card");
      setOpen(card, !card.classList.contains("is-open"));
    }
  });

  async function downloadDay(card) {
    const key = card.dataset.key;
    const entry = loaded.get(key) || await (async () => { await setOpen(card, true); return loaded.get(key); })();
    if (!entry) return;
    entry.table.download("xlsx", `sachiko-deckle-logs-${key}.xlsx`, { sheetName: key === "none" ? "Undated" : key });
  }

  collapseBtn.addEventListener("click", () => {
    daysEl.querySelectorAll(".day-card.is-open").forEach((c) => setOpen(c, false));
    collapseBtn.hidden = true;
  });

  moreBtn.addEventListener("click", () => {
    state.shown = Math.min(state.days.length, state.shown + PAGE_SIZE);
    const openKeys = [...daysEl.querySelectorAll(".day-card.is-open")].map((c) => c.dataset.key);
    renderDays();
    // Re-attach already-loaded days so their tables aren't thrown away.
    openKeys.forEach((k) => { const c = daysEl.querySelector(`.day-card[data-key="${CSS.escape(k)}"]`); if (c) setOpen(c, true); });
  });

  // Jump to a date: opens that day (revealing older pages if needed).
  document.getElementById("jcJump").addEventListener("change", (e) => {
    const key = e.target.value;
    if (!key) return;
    const idx = state.days.findIndex((d) => d.key === key);
    if (idx < 0) {
      if (typeof showToast === "function") showToast("No deckles were recorded on that day.", "error");
      return;
    }
    if (idx >= state.shown) { state.shown = Math.min(state.days.length, Math.ceil((idx + 1) / PAGE_SIZE) * PAGE_SIZE); renderDays(); }
    const card = daysEl.querySelector(`.day-card[data-key="${CSS.escape(key)}"]`);
    if (!card) return;
    setOpen(card, true);
    card.scrollIntoView({ behavior: "smooth", block: "start" });
    card.classList.remove("is-flash"); void card.offsetWidth; card.classList.add("is-flash");
  });

  async function init() {
    try {
      const res = await fetch(`${BASE}/days?tz=${TZ}`, { headers: { Accept: "application/json" } });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.success) throw new Error(data?.message || "Could not load the deckle logs.");
      state.days = data.days;
      state.shown = Math.min(state.days.length, PAGE_SIZE);
      renderDays();
    } catch (err) {
      daysEl.innerHTML = `<div class="jc-empty">${esc(err.message)} <button type="button" class="jc-link" onclick="location.reload()">Reload</button></div>`;
      document.getElementById("jcSummary").textContent = "";
    }
  }
  init();
</script>

<% if (notification && notification.length) { %>
<script>
  const jcFlash = <%- safeJson(notification[0]) %>;
  const jcFlashType = /failed|not found|error/i.test(String(jcFlash)) ? "error" : "success";
  const showJcFlash = () => {
    if (typeof hideStaticToast === "function") hideStaticToast();
    if (typeof showToast === "function") showToast(jcFlash, jcFlashType);
  };
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", showJcFlash, { once: true })
    : showJcFlash();
</script>
<% } %>
