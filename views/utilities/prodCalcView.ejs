<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #master-table { width: 100%; flex: 1 1 auto; min-height: 0; }
    .header-action-btn {
      background-color: #f0f0f0; color: #044a78;
      padding: 2px 14px; font-size: 14px; font-weight: 500;
      border: none; cursor: pointer; border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,.1);
      transition: all 0.2s ease-in-out;
      display: flex; align-items: center; justify-content: center;
      text-decoration: none;
    }
    .header-action-btn:hover { background-color: #e4e4e4; }
    .btn-action {
      height: 24px; padding: 2px 10px; color: white; border: none; border-radius: 4px; cursor: pointer;
      font-size: 11px; transition: opacity 0.2s; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
    }
    .btn-action:hover { opacity: 0.85; }
  </style>

  <div class="indi-head">
    <h1>Production Binding View</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <a href="/sachiko/form/prodcalc" class="header-action-btn">
        <i class="fa-solid fa-plus" style="margin-right: 6px"></i> New Prod Binding
      </a>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table" class="tabulator tabulator-modern"></div>
</div>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script>
  const raw = <%- safeJson(jsonData) %>;

  const tableData = raw.map((e) => ({
    _id: e._id,
    createdAt: e.createdAt ? new Date(e.createdAt).toLocaleDateString("en-GB") : "-",
    companyName: e.companyName || "-",
    userName: e.userName || "-",
    jobName: e.jobName || "-",
    labelWidth: e.labelWidth ?? "-",
    labelHeight: e.labelHeight ?? "-",
    paperType: e.paperType || "-",
    orderQuantity: e.orderQuantity ?? "-",
    productionRate: e.productionRate ?? "-",
  }));

  const withTextFilter = (col) => ({ headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, ...col });

  const table = new Tabulator("#master-table", {
    data: tableData,
    height: "100%",
    initialSort: [{ column: "createdAt", dir: "desc" }],
    placeholder: "No production bindings found",
    columns: [
      {
        title: "Actions",
        width: 90,
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const id = cell.getRow().getData()._id;
          return `<a href="/sachiko/prodcalc/details/${id}" class="btn-action" style="background:#111827;" title="View Details"><i class="fa-solid fa-eye"></i></a>`;
        },
      },
      withTextFilter({ title: "Date", field: "createdAt", width: 110 }),
      withTextFilter({ title: "Company", field: "companyName", minWidth: 160, formatter: (cell) => `<span style="font-weight:600;color:#044a78;">${cell.getValue()}</span>` }),
      withTextFilter({ title: "User", field: "userName", minWidth: 140 }),
      withTextFilter({ title: "Job Name", field: "jobName", minWidth: 140 }),
      withTextFilter({ title: "Width", field: "labelWidth", width: 90 }),
      withTextFilter({ title: "Height", field: "labelHeight", width: 90 }),
      withTextFilter({ title: "Paper Type", field: "paperType", minWidth: 120 }),
      withTextFilter({ title: "Order Qty", field: "orderQuantity", width: 110 }),
      withTextFilter({ title: "Production Rate", field: "productionRate", minWidth: 130 }),
    ],
  });
</script>

<% if (notification && notification.length) { %>
<script>
  const pcFlash = <%- safeJson(notification[0]) %>;
  const pcFlashType = /failed|not found|error/i.test(String(pcFlash)) ? "error" : "success";
  const showPcFlash = () => {
    if (typeof hideStaticToast === "function") hideStaticToast();
    if (typeof showToast === "function") showToast(pcFlash, pcFlashType);
  };
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", showPcFlash, { once: true })
    : showPcFlash();
</script>
<% } %>
