<%# Verified tick for form pages: include("../partials/verifiedCheckbox", { doc }) -- doc optional on create. See VERIFICATION.md. %>
<% const _doc = typeof doc !== "undefined" && doc ? doc : null; %>
<div class="span-full" style="display:flex;flex-direction:column;gap:4px;">
  <label style="display:flex;align-items:center;gap:8px;margin:0;font-weight:700;cursor:pointer;">
    <input type="checkbox" name="verified" value="on" style="width:17px;height:17px;cursor:pointer;" <%= _doc && _doc.verified ? "checked" : "" %> />
    Verified &mdash; data checked and approved
  </label>
  <% if (_doc && _doc.verified) { %>
    <span style="display:inline-flex;align-items:center;gap:6px;margin-left:25px;color:#64748b;font-size:12.5px;">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#0095f6" d="M22.5 12.5c0-1.58-.88-2.95-2.18-3.66.55-1.4.36-3.04-.7-4.2-1.06-1.17-2.65-1.58-4.07-1.18C14.9 2.2 13.55 1.3 12 1.3s-2.9.9-3.55 2.16c-1.42-.4-3.01.01-4.07 1.18-1.06 1.16-1.25 2.8-.7 4.2C2.38 9.55 1.5 10.92 1.5 12.5s.88 2.95 2.18 3.66c-.55 1.4-.36 3.04.7 4.2 1.06 1.17 2.65 1.58 4.07 1.18C9.1 22.8 10.45 23.7 12 23.7s2.9-.9 3.55-2.16c1.42.4 3.01-.01 4.07-1.18 1.06-1.16 1.25-2.8.7-4.2 1.3-.71 2.18-2.08 2.18-3.66z"/><path fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M7.6 12.6l3.1 3.1 5.7-6.3"/></svg>
      Approved by <%= _doc.verifiedBy || "—" %><%= _doc.verifiedAt ? " on " + new Date(_doc.verifiedAt).toLocaleString("en-IN") : "" %>
    </span>
  <% } %>
</div>
