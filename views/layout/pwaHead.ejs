<%# PWA bits shared by every full-page layout: manifest, theme colour, iOS
    home-screen tags, and the "desktop site" viewport. Installed (standalone)
    the app lays out at a 1280px-wide desktop viewport and scales to fit the
    phone (pinch to zoom), instead of using the narrow mobile layout. A normal
    browser tab keeps the responsive layout. -%>
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#044a78" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<link rel="apple-touch-icon" href="/company/pwa-icon/180.png" />
<script>
  (function () {
    try {
      var standalone =
        (window.matchMedia && window.matchMedia("(display-mode: standalone)").matches) ||
        window.navigator.standalone === true;
      if (!standalone) return;
      // The installed app's title bar already shows the app name (manifest name,
      // "Sachiko Packaging"), so the page title's own "Sachiko - " prefix would
      // read "Sachiko Packaging - Sachiko - Welcome". Drop the prefix there only;
      // browser tabs keep it.
      var prefix = <%- JSON.stringify((typeof brandShort !== 'undefined' && brandShort ? brandShort : 'Sachiko') + ' - ').replace(/</g, '\\u003c') %>;
      var stripPrefix = function () {
        if (document.title.indexOf(prefix) === 0) document.title = document.title.slice(prefix.length);
      };
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", stripPrefix);
      else stripPrefix();
      if (localStorage.getItem("pwaLayout") === "mobile") return; // user chose the responsive layout
      var vp = document.querySelector('meta[name="viewport"]');
      if (vp) vp.setAttribute("content", "width=1280, minimum-scale=0.1, user-scalable=yes");
    } catch (e) {}
  })();
</script>
