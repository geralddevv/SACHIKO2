<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #semi-finished-stock-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
      transition: background-color 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
    }
    .header-action-btn:hover { background-color: #e4e4e4; }
    .add-note {
      margin: 0 0 18px;
      padding: 10px 12px;
      font-size: 12.5px;
      line-height: 1.5;
      color: #0c4a6e;
      background: #f0f9ff;
      border: 1px solid #bae6fd;
      border-radius: 8px;
    }
    .add-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px; }
    @media (max-width: 520px) { .add-grid { grid-template-columns: 1fr; } }
    .add-rows-box {
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      background: #f8fafc;
      padding: 10px;
    }
    .add-row { display: flex; gap: 8px; align-items: center; }
    .add-row-no {
      flex: 0 0 26px; height: 26px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 700; color: #044a78; background: #e0f2fe;
    }
    .add-row-del {
      flex: 0 0 auto; width: 34px; height: 34px; padding: 0 !important;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 18px !important; line-height: 1; color: #b91c1c !important;
    }
    .add-footer-row { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; gap: 10px; flex-wrap: wrap; }
    .add-summary {
      font-size: 12.5px; font-weight: 700; color: #044a78;
      background: #e0f2fe; padding: 5px 12px; border-radius: 999px;
    }
    .dialog-header {
      background: #044A78;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .dialog-header h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }
    .dialog-close-btn {
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      padding: 0 2px;
      opacity: 0.8;
      transition: opacity 0.15s;
    }
    .dialog-close-btn:hover {
      opacity: 1;
    }
    .dialog-body {
      padding: 24px;
    }
    .dialog-field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 8px;
    }
    .dialog-error {
      color: #ef4444;
      font-size: 12px;
      margin-top: 5px;
      display: none;
    }
    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }
    .dialog-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 12px;
    }
    .dialog-body .choices__inner {
      padding: 11px 14px !important;
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      background-color: #f8fafc !important;
      font-size: 14px !important;
      min-height: 0 !important;
      transition: all 0.2s ease !important;
    }
    .dialog-body .choices__list--single {
      padding: 0 !important;
    }
    .dialog-body .choices.is-focused .choices__inner,
    .dialog-body .choices.is-open .choices__inner {
      border-color: #044a78 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 4px rgba(4, 74, 120, 0.1) !important;
    }
    .dialog-body .choices__list--dropdown {
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      z-index: 99999 !important;
    }
    /* Exactly the physical sticker, so the preview is honestly "actual
       size". The dashed edge is an outline, not a border: a border would be
       inside the iframe's box and steal millimetres from the label, pushing
       every value off its pre-printed box. */
    .label-preview-frame {
      width: <%= labelSizeMm.width %>mm;
      height: <%= labelSizeMm.height %>mm;
      max-width: 100%;
      margin: 0 auto;
      background: #fff;
      outline: 1px dashed #94a3b8;
      box-shadow: 0 6px 20px rgba(15, 23, 42, 0.18);
    }
    #labelFrame {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .label-preview-caption {
      margin-top: 14px;
      text-align: center;
      font-size: 12px;
      font-weight: 600;
      color: #64748b;
    }

    /* ---- Deckle Detail dialog: variant meta + per-reel table ---- */
    .ddx-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 16px; }
    .ddx-chip-code {
      background: #f0f7ff; border: 1px solid #d7e6f5; color: #03365a;
      font-weight: 700; font-size: 13px; padding: 4px 10px; border-radius: 7px;
    }
    .ddx-chip-muted { color: #64748b; font-size: 12.5px; font-weight: 600; }
    .ddx-table-wrap { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
    .ddx-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .ddx-table th {
      text-align: left; background: #f8fafc; color: #64748b; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.3px; font-size: 10.5px;
      padding: 7px 10px; border-bottom: 1px solid #e2e8f0;
    }
    .ddx-table td { padding: 8px 10px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .ddx-table tr:last-child td { border-bottom: none; }
    .ddx-table tr.ddx-group-start td { border-top: 2px solid #e6edf5; }
    .ddx-layer { color: #475569; font-weight: 600; white-space: nowrap; }
    .ddx-layer.is-cont { color: #cbd5e1; }
    .ddx-reel { font-weight: 700; color: #03365a; }
    .ddx-seq { color: #94a3b8; font-weight: 600; margin-left: 6px; font-size: 11px; }
    .ddx-tag {
      display: inline-block; font-size: 10px; font-weight: 700;
      padding: 2px 8px; border-radius: 999px; letter-spacing: 0.2px;
    }
    .ddx-tag-swap { background: #fef3c7; border: 1px solid #fde68a; color: #92400e; }
    .ddx-tag-final { background: #dcfce7; border: 1px solid #bbf7d0; color: #166534; }
    .ddx-muted-dash { color: #cbd5e1; }
  </style>

  <div class="indi-head">
    <h1>Semi Finished Goods Stock</h1>
    <div style="display: flex; gap: 12px; align-items: center;">
      <button class="header-action-btn" type="button" onclick="openAddDialog()">
        <i class="fa-solid fa-plus" style="margin-right: 6px;"></i>Add Deckle
      </button>
      <div id="tab-container" style="display: flex; gap: 6px; align-items: center; background: #f0f4f8; padding: 2px; border-radius: 10px;">
        <button id="tab-all-stock" class="tab-btn tab-btn-active" style="padding: 8px 14px; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; background-color: #044a78; color: #fff; transition: all 0.3s ease; box-shadow: 0 2px 6px rgba(4, 74, 120, 0.2); font-size: 13px;">
          <i class="fa-solid fa-boxes-stacked" style="margin-right: 6px;"></i>All Stock
        </button>
        <button id="tab-empty-stock" class="tab-btn" style="padding: 8px 14px; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; background-color: transparent; color: #64748b; transition: all 0.3s ease; font-size: 13px;">
          <i class="fa-solid fa-trash-can" style="margin-right: 6px;"></i>Empty Stock (0 Mtrs)
        </button>
      </div>
    </div>
  </div>

  <div class="table-spinner" id="table-spinner"><div class="spinner-circle"></div></div>
  <div id="semi-finished-stock-table" class="tabulator tabulator-modern"></div>
</div>

<!-- ============ ADD DECKLE (MANUAL INWARD) DIALOG ============ -->
<div class="logout-modal" id="addDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="addDialogTitle"
    style="width: min(560px, 95vw); padding: 0; border-radius: 14px; border: none;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="addDialogTitle">Add Deckle (Inward)</h2>
      <button class="dialog-close-btn" type="button" onclick="closeAddDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <p class="add-note">
        Adds Deckle reels that are already on the shelf. Nothing is laminated and no raw material is deducted.
        Each reel gets its own Deckle ID.
      </p>

      <label class="dialog-field-label" for="addProductSelect">Product Code</label>
      <select id="addProductSelect" style="margin-bottom: 16px;"></select>

      <div class="add-grid">
        <div>
          <label class="dialog-field-label" for="addSizeInput">Deckle Size (mm)</label>
          <input type="number" id="addSizeInput" class="form-control premium-input" placeholder="e.g. 660" min="0" step="any" />
        </div>
        <div>
          <label class="dialog-field-label" for="addLotInput">Lot No</label>
          <input type="text" id="addLotInput" class="form-control premium-input" placeholder="e.g. SP | LOT | 0012" />
        </div>
      </div>

      <label class="dialog-field-label" for="addLocationSelect">Location</label>
      <select id="addLocationSelect" style="margin-bottom: 16px;"></select>

      <div class="add-grid">
        <div>
          <label class="dialog-field-label" for="addRateInput">Rate (optional)</label>
          <input type="number" id="addRateInput" class="form-control premium-input" placeholder="Enter rate" min="0" step="any" />
        </div>
        <div>
          <label class="dialog-field-label" for="addRemarksInput">Remarks (optional)</label>
          <input type="text" id="addRemarksInput" class="form-control premium-input" placeholder="Optional remarks" />
        </div>
      </div>

      <label class="dialog-field-label">Deckle reels (mtrs each)</label>
      <div class="add-rows-box">
        <div id="addRows" style="display: flex; flex-direction: column; gap: 8px; max-height: 220px; overflow-y: auto;"></div>
      </div>
      <div class="add-footer-row">
        <button class="logout-btn" type="button" onclick="addDeckleRow()"><i class="fa-solid fa-plus" style="margin-right: 6px;"></i>Add reel</button>
        <span id="addSummary" class="add-summary"></span>
      </div>

      <div id="addSemiFinishedError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeAddDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="addSubmitBtn" onclick="submitAdd()">Add Deckle</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ EDIT DECKLE DIALOG ============ -->
<div class="logout-modal" id="editDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="editDialogTitle"
    style="width: min(500px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="editDialogTitle">Edit Deckle Reel</h2>
      <button class="dialog-close-btn" type="button" onclick="closeEditDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <label class="dialog-field-label" for="editRollIdDisplay">Deckle ID</label>
      <input type="text" id="editRollIdDisplay" class="form-control premium-input" readonly style="margin-bottom: 16px; background: #f1f5f9;" />

      <label class="dialog-field-label" for="editReelMtrsInput">Available Mtrs</label>
      <input type="number" id="editReelMtrsInput" class="form-control premium-input" placeholder="Enter available mtrs" min="0" step="0.01" style="margin-bottom: 16px;" />

      <label class="dialog-field-label" for="editLocationSelect">Location</label>
      <select id="editLocationSelect" style="margin-bottom: 16px;"></select>

      <label class="dialog-field-label" for="editRateInput">Rate</label>
      <input type="number" id="editRateInput" class="form-control premium-input" placeholder="Enter rate" min="0" step="any" style="margin-bottom: 16px;" />

      <label class="dialog-field-label" for="editRemarksInput">Remarks</label>
      <input type="text" id="editRemarksInput" class="form-control premium-input" placeholder="Optional remarks" />

      <div id="editSemiFinishedError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeEditDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="editSubmitBtn" onclick="submitEdit()">Update Reel</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ DELETE CONFIRMATION DIALOG ============ -->
<div class="logout-modal" id="deleteDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteDialogTitle"
    style="width: min(400px, 95vw);">
    <h2 class="logout-title" id="deleteDialogTitle">
      <i class="fa-solid fa-triangle-exclamation" style="color: #ef4444; margin-right: 8px;"></i>Delete Reel?
    </h2>
    <p class="logout-text">
      Are you sure you want to delete <strong id="deleteRollId"></strong>? This action cannot be undone.
    </p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" onclick="closeDeleteDialog()">Cancel</button>
      <button
        class="logout-btn"
        type="button"
        id="deleteConfirmBtn"
        onclick="submitDelete()"
        style="background: #ef4444; color: #fff; border-color: #ef4444;">
        Yes, Delete
      </button>
    </div>
  </div>
</div>

<!-- ============ PRINT ROLL LABEL DIALOG ============ -->
<!-- The sticker itself is an iframe onto /label/:stockId (views/stock/
     materialStockRollLabel.ejs), not markup repeated here. That page is the
     print target, so previewing the very same document is what makes "what
     you see is what prints" true rather than merely intended -- and printing
     an iframe prints only its own document, at its own @page size, so the
     surrounding app never reaches the paper. It detects being framed and
     drops its standalone toolbar; the controls below drive it instead. -->
<div class="logout-modal" id="labelDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="labelDialogTitle"
    style="width: min(520px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="labelDialogTitle">Deckle Label</h2>
      <button class="dialog-close-btn" type="button" onclick="closeLabelDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div class="label-preview-frame">
        <iframe id="labelFrame" title="Deckle label preview"></iframe>
      </div>
      <div class="label-preview-caption" id="labelLoading" style="display: none;">Loading label…</div>
      <div class="label-preview-caption">Size — <%= labelSizeMm.width %> × <%= labelSizeMm.height %> mm</div>

      <div class="dialog-actions">
        <button class="logout-btn" type="button" id="labelRotateBtn" onclick="toggleLabelRotation()">Rotate 180°</button>
        <button class="logout-btn" type="button" onclick="closeLabelDialog()">Close</button>
        <button class="logout-btn primary" type="button" id="labelPrintBtn" onclick="printLabel()">Print</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ DECKLE DETAIL DIALOG ============ -->
<!-- What this Deckle was produced as (Product Code / variant) and the raw-
     material reels that fed it -- mirrors the per-deckle breakdown on
     /sachiko/machine/jobcard/view. -->
<div class="logout-modal" id="deckleDetailDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deckleDetailTitle"
    style="width: min(1000px, 96vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="deckleDetailTitle">Deckle Detail</h2>
      <button class="dialog-close-btn" type="button" onclick="closeModal('deckleDetailDialog')" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div id="deckleDetailBody"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeModal('deckleDetailDialog')">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="stock-data" type="application/json"><%- safeJson(stock) %></script>
<script id="locations-data" type="application/json"><%- safeJson(locations) %></script>
<script id="labelstocks-data" type="application/json"><%- safeJson(labelStocks) %></script>
<script>
  const stockData = JSON.parse(document.getElementById("stock-data").textContent);
  const locationsData = JSON.parse(document.getElementById("locations-data").textContent);
  const labelStocksData = JSON.parse(document.getElementById("labelstocks-data").textContent);

  // Separate stock into active and empty
  const activeStock = stockData.filter(s => (s.reelMtrs != null && Number(s.reelMtrs) > 0));
  const emptyStock = stockData.filter(s => (s.reelMtrs == null || Number(s.reelMtrs) === 0));

  let currentTab = 'all'; // Default tab

  function locationOptionsHtml(selectedName) {
    return locationsData
      .map((l) => `<option value="${l.locationName}" ${l.locationName === selectedName ? "selected" : ""}>${l.locationName}</option>`)
      .join("");
  }

  function stockDateText(v) {
    const d = v ? new Date(v) : null;
    return d && !Number.isNaN(d.getTime())
      ? d.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" })
      : "—";
  }

  const table = new Tabulator("#semi-finished-stock-table", {
    data: activeStock,
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No semi finished goods (Deckle) stock yet.",
    columns: [
      // getPosition(true) is the row's rank among currently sorted/filtered
      // rows, re-evaluated on every redraw -- stays correct after sorting or
      // filtering instead of a static index frozen at load time.
      { title: "Sr. No.", field: "_srNo", width: 70, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => cell.getRow().getPosition(true) },
      { title: "Date", field: "createdAt", minWidth: 120, headerFilter: "input", headerFilterPlaceholder: "Search",
        headerFilterFunc: (term, val) => stockDateText(val).toLowerCase().includes(String(term || "").toLowerCase()),
        formatter: (cell) => stockDateText(cell.getValue()) },
      { title: "Deckle ID", field: "rollId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 170 },
      { title: "Product Code", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 140, formatter: (cell) => cell.getValue() || "—" },
      { title: "Family", field: "family", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 140, formatter: (cell) => cell.getValue() || "—" },
      { title: "Size", field: "size", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110, formatter: (cell) => cell.getValue() || "—" },
      { title: "Mtrs", field: "reelMtrs", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100 },
      { title: "Rate", field: "rate", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Value", field: "value", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 115, hozAlign: "right", formatter: (cell) => {
        const value = cell.getValue();
        return value == null ? "—" : `₹${Number(value).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      } },
      { title: "Location", field: "location", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130 },
      { title: "Remarks", field: "remarks", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 160, formatter: (cell) => cell.getValue() || "—" },
      {
        title: "Actions",
        width: 190,
        hozAlign: "center",
        headerSort: false,
        formatter: function (cell) {
          const row = cell.getRow().getData();
          const wrap = document.createElement("div");
          wrap.style.cssText = "display:flex; gap:5px; justify-content:center;";

          const viewBtn = document.createElement("button");
          viewBtn.className = "loc-btn";
          viewBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#044a78;";
          viewBtn.title = "View variant & materials used";
          viewBtn.innerHTML = '<i class="fa-solid fa-eye"></i>';
          viewBtn.addEventListener("click", () => openDeckleDetailDialog(row));

          const printBtn = document.createElement("button");
          printBtn.className = "loc-btn";
          printBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#475569;";
          printBtn.title = "Print this reel's label";
          printBtn.innerHTML = '<i class="fa-solid fa-print"></i>';
          printBtn.addEventListener("click", () => openLabelDialog(row));

          const editBtn = document.createElement("button");
          editBtn.className = "loc-btn";
          editBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#e67e22;";
          editBtn.title = "Edit Reel";
          editBtn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
          editBtn.addEventListener("click", () => openEditDialog(row));

          wrap.appendChild(viewBtn);
          wrap.appendChild(printBtn);
          wrap.appendChild(editBtn);
          return wrap;
        },
      },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever's actually on
  // screen, top to bottom, is renumbered 1..n every time the table redraws.
  table.on("renderComplete", function () {
    document.querySelectorAll("#semi-finished-stock-table .tabulator-row").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  function openModal(id) {
    const d = document.getElementById(id);
    d.classList.add("show");
    d.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const d = document.getElementById(id);
    d.classList.remove("show");
    d.setAttribute("aria-hidden", "true");
  }
  function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.style.display = "block";
  }
  function hideError(elId) {
    document.getElementById(elId).style.display = "none";
  }
  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.disabled = loading;
    btn.style.opacity = loading ? "0.7" : "";
  }

  ["editDialog", "deleteDialog", "labelDialog", "deckleDetailDialog"].forEach(id => {
    document.getElementById(id).addEventListener("click", function (e) {
      if (e.target === this) closeModal(id);
    });
  });

  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    ["editDialog", "deleteDialog", "labelDialog", "deckleDetailDialog"].forEach(id => {
      if (document.getElementById(id).classList.contains("show")) closeModal(id);
    });
  });

  // ---- DECKLE DETAIL (variant + reels used) ----
  const escHtml = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const POOL_LABEL = { facestock: "Facestock", adhesive: "Adhesive", release: "Release Liner" };

  function openDeckleDetailDialog(row) {
    document.getElementById("deckleDetailTitle").textContent = `Deckle Detail — ${row.rollId || ""}`;

    // Group the source reels by pool, keeping the order they were mounted in.
    // Within a pool the LAST reel is the one that ran the web to the finish;
    // any earlier reel there was swapped out mid-run (it ran short / was
    // changed) -- so the "swapped mid-run" tag belongs on those earlier
    // reels, not on the whole pool line and not on the final reel.
    const byPool = { facestock: [], adhesive: [], release: [] };
    (row.sourceReels || []).forEach((r) => { if (byPool[r.pool]) byPool[r.pool].push(r); });

    const bodyRows = [];
    Object.keys(POOL_LABEL).forEach((p) => {
      const reels = byPool[p];
      if (!reels.length) return;
      const multi = reels.length > 1;
      reels.forEach((reel, i) => {
        const isFirst = i === 0;
        const isFinal = i === reels.length - 1;
        const swappedOut = multi && !isFinal;
        let statusCell = '<span class="ddx-muted-dash">—</span>';
        if (swappedOut) statusCell = '<span class="ddx-tag ddx-tag-swap">Swapped mid-run</span>';
        else if (multi && isFinal) statusCell = '<span class="ddx-tag ddx-tag-final">Ran to finish</span>';
        bodyRows.push(`
          <tr${isFirst && bodyRows.length ? ' class="ddx-group-start"' : ""}>
            <td><span class="ddx-layer${isFirst ? "" : " is-cont"}">${isFirst ? escHtml(POOL_LABEL[p]) : "&#8942;"}</span></td>
            <td>
              <span class="ddx-reel">${escHtml(reel.rollId || "—")}</span>
              ${multi ? `<span class="ddx-seq">reel ${i + 1} of ${reels.length}</span>` : ""}
            </td>
            <td>${reel.spec ? escHtml(reel.spec) : '<span class="ddx-muted-dash">—</span>'}</td>
            <td style="text-align:right;white-space:nowrap;">${reel.kgUsed != null ? escHtml(Number(reel.kgUsed).toLocaleString("en-IN", { maximumFractionDigits: 2 })) + " kg" : '<span class="ddx-muted-dash">—</span>'}</td>
            <td>${statusCell}</td>
            <td>${reel.remark ? escHtml(reel.remark) : '<span class="ddx-muted-dash">—</span>'}</td>
          </tr>
        `);
      });
    });

    const reelTable = bodyRows.length
      ? `<div class="ddx-table-wrap">
          <table class="ddx-table">
            <thead><tr><th>Layer</th><th>Reel ID</th><th>Spec</th><th style="text-align:right;">Kg Used</th><th>Status</th><th>Remark</th></tr></thead>
            <tbody>${bodyRows.join("")}</tbody>
          </table>
        </div>`
      : '<div style="color:#94a3b8;font-size:12.5px;padding:5px 0;">No reel detail recorded for this Deckle.</div>';

    document.getElementById("deckleDetailBody").innerHTML = `
      <div class="ddx-meta">
        <span class="ddx-chip-code">${escHtml(row.productCode || "—")}</span>
        ${row.reelMtrs != null ? `<span class="ddx-chip-muted">${escHtml(row.reelMtrs)} mtrs</span>` : ""}
        ${row.lotNo ? `<span class="ddx-chip-muted">Lot ${escHtml(row.lotNo)}</span>` : ""}
      </div>
      <div class="dialog-field-label" style="margin-bottom:8px;">Raw materials used</div>
      ${reelTable}
      ${row.joints ? `<div style="margin-top:12px;color:#64748b;font-size:12.5px;"><strong>Joints:</strong> ${escHtml(row.joints)}</div>` : ""}
    `;
    openModal("deckleDetailDialog");
  }

  // ---- Print Roll Label dialog ----
  // Nothing about the label is built here: the iframe loads
  // /label/:stockId, which is the print target itself, and everything --
  // values, positions, the fit-to-box pass, the rotation state -- lives in
  // that page (views/stock/materialStockRollLabel.ejs) behind
  // window.labelApi. This only opens it, forwards the two buttons, and
  // tears it down.
  function labelWindow() {
    const frame = document.getElementById("labelFrame");
    // try/catch, not just a null check: if the frame ends up on a document
    // the browser treats as another origin -- which is what a blocked or
    // errored frame becomes -- then merely READING .labelApi throws a
    // SecurityError. Returning null instead lets the caller report "couldn't
    // load" rather than the dialog dying with an uncaught exception.
    try {
      return frame.contentWindow && frame.contentWindow.labelApi ? frame.contentWindow : null;
    } catch (e) {
      return null;
    }
  }

  function syncLabelRotateBtn() {
    const win = labelWindow();
    const btn = document.getElementById("labelRotateBtn");
    const flipped = Boolean(win && win.labelApi.isFlipped());
    btn.textContent = flipped ? "Rotated 180°" : "Rotate 180°";
  }

  // Both controls drive the framed document, so neither can do anything
  // until it has loaded. Disabled rather than left clickable-but-inert:
  // a button that silently does nothing reads as broken.
  function setLabelControlsReady(ready) {
    ["labelPrintBtn", "labelRotateBtn"].forEach((id) => {
      const btn = document.getElementById(id);
      btn.disabled = !ready;
      btn.style.opacity = ready ? "" : "0.6";
      btn.style.cursor = ready ? "" : "not-allowed";
    });
    document.getElementById("labelLoading").style.display = ready ? "none" : "block";
  }

  function labelMessage(text) {
    document.getElementById("labelLoading").textContent = text;
  }

  // Fetched and written in as srcdoc rather than pointed at with frame.src --
  // see openLabelDialog in views/stock/facestockStock.ejs for why (a frame
  // navigated straight to the URL dies on an expired session's redirect,
  // since the app sends X-Frame-Options: DENY on every page including the
  // login screen it would land on).
  async function openLabelDialog(row) {
    document.getElementById("labelDialogTitle").textContent = `Deckle Label — ${row.rollId || ""}`;
    setLabelControlsReady(false);
    labelMessage("Loading label…");
    const frame = document.getElementById("labelFrame");
    frame.removeAttribute("srcdoc");
    openModal("labelDialog");

    let res;
    try {
      res = await fetch(`/app/semifinishedstock/label/${row._id}`, { credentials: "same-origin" });
    } catch (e) {
      return labelMessage("Couldn't reach the server to build this label.");
    }
    // A redirect here is the app bouncing us to the login page -- the
    // request went out without a valid session.
    if (res.redirected || !res.ok) {
      if (res.redirected) {
        return labelMessage("Your session has ended. Reload this page and sign in again to print.");
      }
      // The route answers failures as a small HTML document (it normally
      // renders into this frame), so strip the markup to get the sentence.
      const detail = (await res.text()).replace(/<[^>]*>/g, " ").trim();
      return labelMessage(`Couldn't load the label (${res.status}). ${detail}`);
    }

    frame.onload = () => {
      if (!labelWindow()) return labelMessage("The label loaded but couldn't be read.");
      setLabelControlsReady(true);
      syncLabelRotateBtn();
    };
    // Always re-fetched rather than reused: Mfg Date is generated per
    // request, so a stale document would print the wrong reel.
    frame.srcdoc = await res.text();
  }

  function closeLabelDialog() {
    const frame = document.getElementById("labelFrame");
    frame.onload = null;
    // Dropped so the next open can't flash the previous reel's label.
    frame.removeAttribute("srcdoc");
    closeModal("labelDialog");
  }

  function printLabel() {
    const win = labelWindow();
    if (!win) return; // controls are disabled until the frame is ready
    win.labelApi.print();
  }

  function toggleLabelRotation() {
    const win = labelWindow();
    if (!win) return;
    win.labelApi.toggleFlip();
    syncLabelRotateBtn();
  }

  // ---- ADD (manual inward) ----
  let addProductChoices = null;
  let addLocationChoices = null;
  const escAttr = (v) => String(v ?? "").replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");

  function addDeckleRow(value = "") {
    const rows = document.getElementById("addRows");
    const wrap = document.createElement("div");
    wrap.className = "add-row";
    wrap.innerHTML = `
      <span class="add-row-no"></span>
      <input type="number" class="form-control premium-input add-row-mtrs" placeholder="Mtrs" min="0" step="0.01" value="${escAttr(value)}" style="flex: 1;" />
      <button type="button" class="logout-btn add-row-del" aria-label="Remove reel" title="Remove reel">×</button>`;
    wrap.querySelector(".add-row-del").addEventListener("click", () => {
      if (rows.children.length > 1) wrap.remove();
      renumberAddRows();
    });
    wrap.querySelector(".add-row-mtrs").addEventListener("input", renumberAddRows);
    rows.appendChild(wrap);
    renumberAddRows();
  }
  function renumberAddRows() {
    const rows = [...document.querySelectorAll("#addRows > div")];
    let total = 0;
    rows.forEach((r, i) => {
      r.querySelector(".add-row-no").textContent = i + 1;
      total += Number(r.querySelector(".add-row-mtrs").value) || 0;
    });
    document.getElementById("addSummary").textContent =
      `${rows.length} reel${rows.length === 1 ? "" : "s"} · ${total.toLocaleString("en-IN", { maximumFractionDigits: 2 })} mtrs`;
  }

  function openAddDialog() {
    if (addProductChoices) { addProductChoices.destroy(); addProductChoices = null; }
    if (addLocationChoices) { addLocationChoices.destroy(); addLocationChoices = null; }

    const prodSel = document.getElementById("addProductSelect");
    prodSel.innerHTML = `<option value="">Select Product Code</option>` + labelStocksData
      .map((l) => `<option value="${escAttr(l._id)}">${escAttr(l.productCode)}${l.family ? " — " + escAttr(l.family) : ""}</option>`)
      .join("");
    addProductChoices = new Choices(prodSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    const locSel = document.getElementById("addLocationSelect");
    locSel.innerHTML = locationOptionsHtml("");
    addLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    for (const id of ["addSizeInput", "addLotInput", "addRateInput", "addRemarksInput"]) document.getElementById(id).value = "";
    document.getElementById("addRows").innerHTML = "";
    addDeckleRow();

    hideError("addSemiFinishedError");
    openModal("addDialog");
  }
  function closeAddDialog() {
    closeModal("addDialog");
  }

  async function submitAdd() {
    const materialId = document.getElementById("addProductSelect").value;
    const location = document.getElementById("addLocationSelect").value;
    const size = document.getElementById("addSizeInput").value;
    const lotNo = document.getElementById("addLotInput").value.trim();
    const mtrs = [...document.querySelectorAll("#addRows .add-row-mtrs")].map((i) => i.value);

    if (!materialId) return showError("addSemiFinishedError", "Select a Product Code.");
    if (!(Number(size) > 0)) return showError("addSemiFinishedError", "Deckle Size (mm) must be a number above 0.");
    if (!/\d$/.test(lotNo)) return showError("addSemiFinishedError", "Lot No is required and must end in a number (e.g. SP | LOT | 0012).");
    if (!location) return showError("addSemiFinishedError", "Location is required.");
    const bad = mtrs.findIndex((m) => !(Number(m) > 0));
    if (bad !== -1) return showError("addSemiFinishedError", `Mtrs must be above 0 for reel ${bad + 1}.`);

    hideError("addSemiFinishedError");
    setLoading("addSubmitBtn", true);
    try {
      const res = await fetch("/app/semifinishedstock/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          materialId, location, size, lotNo,
          rate: document.getElementById("addRateInput").value,
          remarks: document.getElementById("addRemarksInput").value,
          deckles: mtrs.map((m) => ({ mtrs: m })),
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showError("addSemiFinishedError", data.message || "Failed to add Deckle reels.");
      }
    } catch {
      showError("addSemiFinishedError", "Server error. Please try again.");
    } finally {
      setLoading("addSubmitBtn", false);
    }
  }

  // ---- EDIT ----
  let editId = null;
  let editLocationChoices = null;

  function openEditDialog(row) {
    editId = row._id;
    document.getElementById("editRollIdDisplay").value = row.rollId;
    document.getElementById("editReelMtrsInput").value = row.reelMtrs ?? "";
    document.getElementById("editRateInput").value = row.rate ?? "";
    document.getElementById("editRemarksInput").value = row.remarks || "";

    if (editLocationChoices) { editLocationChoices.destroy(); editLocationChoices = null; }
    const locSel = document.getElementById("editLocationSelect");
    locSel.innerHTML = locationOptionsHtml(row.location || "");
    editLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    hideError("editSemiFinishedError");
    openModal("editDialog");
  }
  function closeEditDialog() {
    closeModal("editDialog");
    editId = null;
  }

  async function submitEdit() {
    const location = document.getElementById("editLocationSelect").value;
    if (!location) return showError("editSemiFinishedError", "Location is required.");
    const reelMtrs = document.getElementById("editReelMtrsInput").value;
    if (reelMtrs === "" || Number(reelMtrs) < 0 || !Number.isFinite(Number(reelMtrs))) {
      return showError("editSemiFinishedError", "Available mtrs must be a number, 0 or more.");
    }
    if (!editId) return;

    hideError("editSemiFinishedError");
    setLoading("editSubmitBtn", true);
    try {
      const res = await fetch(`/app/semifinishedstock/${editId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          reelMtrs,
          location,
          rate: document.getElementById("editRateInput").value,
          remarks: document.getElementById("editRemarksInput").value,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showError("editSemiFinishedError", data.message || "Failed to update Deckle reel.");
      }
    } catch {
      showError("editSemiFinishedError", "Server error. Please try again.");
    } finally {
      setLoading("editSubmitBtn", false);
    }
  }

  // ---- DELETE ----
  let deleteId = null;

  function openDeleteDialog(id, rollId) {
    deleteId = id;
    document.getElementById("deleteRollId").textContent = rollId;
    openModal("deleteDialog");
  }
  function closeDeleteDialog() {
    closeModal("deleteDialog");
    deleteId = null;
  }

  async function submitDelete() {
    if (!deleteId) return;
    setLoading("deleteConfirmBtn", true);
    try {
      const res = await fetch(`/app/semifinishedstock/${deleteId}`, { method: "DELETE" });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        closeDeleteDialog();
        alert(data.message || "Failed to delete reel.");
      }
    } catch {
      closeDeleteDialog();
      alert("Error deleting reel.");
    } finally {
      setLoading("deleteConfirmBtn", false);
    }
  }

  // ---- Tab Switching ----
  function updateTabButtons() {
    const allBtn = document.getElementById("tab-all-stock");
    const emptyBtn = document.getElementById("tab-empty-stock");

    if (currentTab === 'all') {
      allBtn.style.backgroundColor = "#044a78";
      allBtn.style.color = "#fff";
      allBtn.style.boxShadow = "0 2px 6px rgba(4, 74, 120, 0.2)";
      emptyBtn.style.backgroundColor = "transparent";
      emptyBtn.style.color = "#64748b";
      emptyBtn.style.boxShadow = "none";
    } else {
      allBtn.style.backgroundColor = "transparent";
      allBtn.style.color = "#64748b";
      allBtn.style.boxShadow = "none";
      emptyBtn.style.backgroundColor = "#ef4444";
      emptyBtn.style.color = "#fff";
      emptyBtn.style.boxShadow = "0 2px 6px rgba(239, 68, 68, 0.2)";
    }
  }

  document.getElementById("tab-all-stock").addEventListener("click", () => {
    currentTab = 'all';
    updateTabButtons();
    table.setData(activeStock);
  });

  document.getElementById("tab-empty-stock").addEventListener("click", () => {
    currentTab = 'empty';
    updateTabButtons();
    table.setData(emptyStock);
  });
</script>
