<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #facestock-used-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    .fsu-status-badge {
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      white-space: nowrap;
      display: inline-block;
    }
  </style>

  <!-- Common to all three raw-material pools (Facestock/Adhesive/Release
       Liner), not facestock-only -- the Item column below filters down to
       one. One row per reel currently live on a still-open job (Start
       already punched, PendingProduction.liveMaterialInUse) -- see
       routes/stock/wipStock.js's loadWipRows. Deliberately excludes reels
       already fully drawn off via a job card's Material Used dialog: this
       is a live "what's on the floor right now" view, not a usage history. -->
  <div class="indi-head">
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 14px;">
      <div style="display: flex; align-items: center; gap: 10px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.3); padding: 8px 16px; border-radius: 10px;">
        <i class="fa-solid fa-industry" style="font-size: 1.1rem; opacity: 0.9;"></i>
        <h1 style="margin: 0; letter-spacing: 0.02em;">WIP Stock</h1>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="facestock-used-table" class="tabulator tabulator-modern"></div>
</div>

<script id="facestock-used-data" type="application/json"><%- safeJson(rows) %></script>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script>
  const usedRows = JSON.parse(document.getElementById("facestock-used-data").textContent || "[]");

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[c]);
  }

  function ellipsisFormatter(cell) {
    const value = cell.getValue();
    if (!value) return "—";
    cell.getElement().style.cssText += "overflow:hidden;text-overflow:ellipsis;white-space:nowrap;";
    cell.getElement().title = value;
    return value;
  }

  function formatRowDate(value) {
    if (!value) return "—";
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? "—" : d.toLocaleString("en-IN", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });
  }

  const table = new Tabulator("#facestock-used-table", {
    data: usedRows,
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No raw material is currently in use.",
    initialSort: [{ column: "date", dir: "desc" }],
    columns: [
      {
        title: "Item", field: "item", width: 140, hozAlign: "center", headerHozAlign: "center",
        headerFilter: "list",
        headerFilterParams: { values: { "": "All", "Facestock": "Facestock", "Adhesive": "Adhesive", "Release Liner": "Release Liner" } },
        headerFilterFunc: "=",
        formatter: (cell) => `<b>${escapeHtml(cell.getValue() || "—")}</b>`,
      },
      {
        title: "Status", field: "status", width: 150, hozAlign: "center", headerHozAlign: "center",
        formatter: () => `<span class="fsu-status-badge" style="background:#ccfbf1;color:#0f766e;" title="Scanned and Start was just punched on a job card -- Kg used isn't reported until Save Production Entry.">IN USE NOW</span>`,
      },
      { title: "Roll/Drum ID", field: "rollId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 170,
        formatter: (cell) => `<b>${escapeHtml(cell.getValue() || "—")}</b>` },
      { title: "Type", field: "type", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110, formatter: (cell) => cell.getValue() || "—" },
      { title: "Make", field: "make", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110, formatter: (cell) => cell.getValue() || "—" },
      { title: "Vendor Name", field: "vendorName", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150, maxWidth: 220, formatter: ellipsisFormatter },
      { title: "Vendor SKU Code", field: "vendorSkuCode", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130, formatter: (cell) => cell.getValue() || "—" },
      { title: "Location", field: "location", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 120, formatter: (cell) => cell.getValue() || "—" },
      { title: "Lot No", field: "lotNo", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 140, formatter: (cell) => cell.getValue() || "—" },
      { title: "Product Code", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130, formatter: (cell) => cell.getValue() || "—" },
      { title: "When", field: "date", hozAlign: "center", minWidth: 170, formatter: (cell) => formatRowDate(cell.getValue()) },
    ],
  });

  document.querySelector(".table-spinner")?.remove();
</script>
