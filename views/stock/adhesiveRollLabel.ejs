<%
  /* Deliberately NO `layout('/layout/boilerplate')` call -- ejs-mate renders
     a view standalone when one is absent, which is what this page needs: the
     boilerplate's nav, Bootstrap and common.css would all land inside the
     printed page. This is a print target, not an app screen.

     Note the layout data is named `mm`, not `layout` -- `layout` is
     ejs-mate's own helper function and shadowing it breaks rendering. */

  /* One reel or a whole batch: `labels` is always an array, and the page is
     the same document either way -- one sticker per page. A single-label
     render is byte-for-byte the page it always was; `sheet` only turns on
     the page-break and stacking rules below. See routes/stock/
     adhesiveStock.js's /label/:stockId (one) and /labels?ids= (many). */
  const isSheet = labels.length > 1;
%>
<!DOCTYPE html>
<html lang="en"<%- isSheet ? ' class="sheet"' : "" %>>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= isSheet ? labels.length + " Labels" : "Label — " + labels[0].rollId %></title>
  <script>
    /* This page serves two callers: the Print dialog on the stock page,
       which embeds it in an iframe and drives it through window.labelApi
       below, and direct navigation to the URL, which gets its own toolbar
       and prints itself. Embedded, the page is nothing but the sticker.

       Set here in <head>, before the body is painted, so the embedded rules
       are already in force on first paint rather than flashing the
       standalone layout first. */
    if (window.self !== window.top) document.documentElement.classList.add("embedded");
  </script>
  <style>
    /* The sheet IS the label: one 101.5 x 75.1 mm sticker, zero margins, so
       Chrome maps the page 1:1 onto the label stock. Without this the browser
       defaults to A4 and scales everything down. */
    @page {
      size: <%= mm.labelWidth %>mm <%= mm.labelHeight %>mm;
      margin: 0;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: #eef2f7;
      font-family: Arial, Helvetica, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      padding: 24px 16px 40px;
    }

    /* Exact physical size. Its single child is the design SVG, stretched to
       fill -- all placement lives in that SVG's viewBox coordinates (see the
       .label-svg rules below), not here. */
    .label {
      position: relative;
      width: <%= mm.labelWidth %>mm;
      height: <%= mm.labelHeight %>mm;
      background: #fff;
      overflow: hidden;
    }

    /* Screen-only sticker outline, so the operator can see the label's real
       edges against the page. Must never print -- it isn't on the blank. */
    .label-frame {
      box-shadow: 0 6px 20px rgba(15, 23, 42, 0.18);
      outline: 1px dashed #94a3b8;
    }

    /* ---- many labels in one print ---- */
    /* The @page above IS one sticker, so a page break before every label
       after the first is what keeps two of them off the same sheet. The
       break goes BEFORE each label rather than after, so the last one
       doesn't feed a blank label out of the printer. */
    .sheet .label + .label {
      page-break-before: always;
      break-before: page;
    }

    /* A safe margin inside the sheet: the design is drawn in the area left
       after this inset, so nothing reaches the physical edge where thermal
       feed drift or die-cut tolerance would clip it. */
    .label-inner {
      position: absolute;
      inset: 2.5mm;
    }

    /* Set when the pre-printed stock feeds the other way round -- see the
       Rotate 180 control below. */
    .label-inner.flipped {
      transform: rotate(180deg);
    }

    /* The whole sticker is one SVG (Sample inward design.svg) stretched to
       the label's exact mm size -- boxes, unit captions and values all drawn
       here, since this label stock is NOT pre-printed. preserveAspectRatio
       ="none" on the element lets the design's 277.38 x 202.54 viewBox map
       onto 101.5 x 75.1 mm without letterboxing; the ~1% anamorphism is
       below what the eye or a scanner notices. */
    .label-svg {
      display: block;
      width: 100%;
      height: 100%;
    }
    .label-svg rect.ln {
      fill: none;
      stroke: #000;
      stroke-width: 1;
    }
    .label-svg text {
      fill: #000;
      font-family: Arial, Helvetica, sans-serif;
    }
    .label-svg .t-big { font-size: 24px; }
    .label-svg .t-fam { font-size: 20px; }
    .label-svg .t-id { font-weight: 700; }
    .label-svg image {
      /* Keep the QR modules crisp rather than blurred together at print
         resolution -- a smoothed QR scans worse. */
      image-rendering: pixelated;
    }

    /* ---- screen furniture (never printed) ---- */
    .toolbar {
      width: min(760px, 100%);
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.12);
      padding: 16px 18px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
    }
    .toolbar h1 {
      margin: 0;
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      flex: 1 1 auto;
    }
    .toolbar h1 small {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #64748b;
      margin-top: 3px;
    }
    .tb-btn {
      border: none;
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      color: #fff;
      background: #475569;
    }
    .tb-btn:hover { background: #334155; }
    .tb-btn.primary { background: #044a78; }
    .tb-btn.primary:hover { background: #03365a; }
    .tb-btn.ghost {
      background: #e2e8f0;
      color: #0f172a;
    }
    .tb-btn.ghost:hover { background: #cbd5e1; }
    .tb-btn.on {
      background: #15803d;
    }
    .hint {
      width: min(760px, 100%);
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 12.5px;
      line-height: 1.6;
      color: #78350f;
    }
    .hint b { color: #92400e; }
    .caption {
      font-size: 12px;
      color: #64748b;
      font-weight: 600;
    }

    /* ---- embedded in the stock page's Print dialog ---- */
    /* The iframe is sized to the label exactly, so the document collapses to
       just the sticker: no page padding, no backdrop, and none of the screen
       furniture, which the dialog supplies instead. The dashed edge comes
       from the dialog too -- drawn around the iframe rather than inside it,
       where a border would eat into the label's own 101.5 mm and shift every
       value out of its pre-printed box. */
    .embedded body {
      display: block;
      width: <%= mm.labelWidth %>mm;
      height: <%= mm.labelHeight %>mm;
      padding: 0;
      background: #fff;
      overflow: hidden;
    }
    .embedded .screen-only { display: none !important; }
    .embedded .label-frame {
      box-shadow: none;
      outline: none;
    }
    /* Embedded as a batch, the frame is a preview of the whole run rather
       than of one sticker, so the labels stack and the dialog scrolls them.
       Each keeps its dashed edge here -- with several in a column, where one
       label ends and the next begins is the thing the preview has to show. */
    .embedded.sheet body {
      /* Width comes from the frame rather than being pinned to one sticker:
         a stack needs a scrollbar, and pinning the body to 101.5 mm pushed
         the labels under it. They centre in whatever room is left. */
      width: auto;
      height: auto;
      overflow: visible;
      background: #eef2f7;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 10px 0;
    }
    .embedded.sheet .label-frame { outline: 1px dashed #94a3b8; }
    /* The app's own scrollbar (common.css's .ap-table-wrap tokens), since a
       stack of labels scrolls inside the dialog's preview and the browser
       default reads as a foreign element there. This document doesn't load
       the app's stylesheets -- it is a print target -- so the tokens are
       repeated rather than shared. Screen only: scrollbars never print.

       On the ROOT element, not on body: what scrolls here is the document
       itself, and a viewport scrollbar is taken from the root -- `body`
       rules are simply ignored for it, which is why this looked untouched
       and stayed the browser's own 15px grey. Both classes sit on <html>,
       so `.embedded.sheet` IS the root. */
    .embedded.sheet::-webkit-scrollbar { width: 10px; height: 10px; }
    .embedded.sheet::-webkit-scrollbar-track { background: #f0f2f5; }
    .embedded.sheet::-webkit-scrollbar-thumb { background: #044a78; border-radius: 6px; }
    .embedded.sheet::-webkit-scrollbar-corner { background: #f0f2f5; }
    .embedded.sheet { scrollbar-width: thin; scrollbar-color: #044a78 #f0f2f5; }

    @media print {
      /* Collapse the page down to nothing but the sticker. */
      body {
        background: #fff;
        padding: 0;
        gap: 0;
        display: block;
        width: <%= mm.labelWidth %>mm;
        height: <%= mm.labelHeight %>mm;
      }
      /* A batch is as many pages as it has labels, so the sheet's height is
         whatever they add up to -- only a single label can pin the body to
         exactly one sticker. */
      .sheet body { height: auto; }
      .screen-only { display: none !important; }
      .label-frame {
        box-shadow: none;
        outline: none;
      }
      /* Chrome drops backgrounds and lightens greys by default; the QR must
         come out solid black or it will not scan. */
      * {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</head>
<body>

  <div class="toolbar screen-only">
    <h1>
      <%= isSheet ? "Drum Labels — " + labels.length + " drums" : "Drum Label — " + labels[0].rollId %>
      <small>Pick the label printer in the print dialog. Set <b>Scale: 100%</b> (or Default) and <b>Margins: None</b>.</small>
    </h1>
    <button type="button" class="tb-btn primary" id="printBtn">Print</button>
    <button type="button" class="tb-btn" id="rotateBtn">Rotate 180°</button>
    <button type="button" class="tb-btn ghost" id="closeBtn">Close</button>
  </div>

  <% labels.forEach(function (label) { %>
  <div class="label label-frame">
    <div class="label-inner">
      <svg class="label-svg" viewBox="0 0 277.38 202.54" preserveAspectRatio="none"
           xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
        <rect class="ln" x="0.5" y="0.5" width="117.83" height="201.54" />
        <rect class="ln" x="118.33" y="0.5" width="158.55" height="201.54" />
        <image x="7.92" y="34" width="103" height="103" preserveAspectRatio="none"
               href="<%= label.qrDataUrl %>" xlink:href="<%= label.qrDataUrl %>" />
        <text class="t-fam fit" text-anchor="middle" dominant-baseline="central" data-maxw="107" x="59.42" y="166"><%= label.fields.family %></text>
        <text class="t-big t-id fit" text-anchor="middle" dominant-baseline="central" data-maxw="150" x="197.6" y="46"><%= label.fields.id %></text>
        <text class="t-big fit" text-anchor="middle" dominant-baseline="central" data-maxw="150" x="197.6" y="83"><%= label.fields.width %></text>
        <text class="t-big fit" text-anchor="middle" dominant-baseline="central" data-maxw="150" x="197.6" y="120"><%= label.fields.weight %></text>
        <text class="t-big fit" text-anchor="middle" dominant-baseline="central" data-maxw="150" x="197.6" y="157"><%= label.fields.date %></text>
      </svg>
    </div>
  </div>
  <% }); %>

  <span class="caption screen-only">
    <%= isSheet ? labels.length + " labels · one per page · actual size — " : "Actual size — " %><%= mm.labelWidth %> × <%= mm.labelHeight %> mm
  </span>

  <%
    /* `locals.missingCount` would never fire: ejs-mate replaces `locals`
       with its own object (blocks/layout/partial), so the render data is
       only reachable by name -- hence the typeof guard, which is what the
       rest of the views use for an optional value. */
  %>
  <% if (typeof missingCount !== "undefined" && missingCount > 0) { %>
  <div class="hint screen-only" style="background:#fef2f2; border-color:#fecaca; color:#991b1b;">
    <b><%= missingCount %></b> of the drums picked <%= missingCount === 1 ? "is" : "are" %> no longer in stock and
    <%= missingCount === 1 ? "has" : "have" %> been left out — <%= labels.length %>
    <%= labels.length === 1 ? "label" : "labels" %> will print.
  </div>
  <% } %>

  <div class="hint screen-only">
    The dashed outline and this text are on screen only and never print. The whole label —
    boxes, captions and values — prints onto blank stock.
    <br />
    If the first test comes out upside down relative to how the roll feeds, hit
    <b>Rotate 180°</b> and print again. That choice is remembered on this PC for every label from
    then on, so it only needs setting once.
  </div>

  <script>
    // Whether this PC's label stock feeds the other way round. The .prn
    // rotates its output 180 because of the printer's own feed direction;
    // going through the Windows driver instead, the driver decides that, and
    // which way it lands depends on how the roll is loaded. Rather than
    // guess, this is a one-time per-machine setting -- hence localStorage,
    // not a server-side field: it is a property of the printer in front of
    // the operator, not of the drum being printed. Its own key (distinct
    // from Facestock/Release Liner's) so the remembered orientation doesn't
    // cross-apply between pools.
    var FLIP_KEY = "adhesiveLabelFlip180";
    var embedded = document.documentElement.classList.contains("embedded");
    // Every label on the page, since one print run can hold a whole batch of
    // them -- the feed direction is a property of the printer, so it applies
    // to all of them at once or to none.
    var inners = document.querySelectorAll(".label-inner");
    var rotateBtn = document.getElementById("rotateBtn");

    function isFlipped() {
      return inners.length > 0 && inners[0].classList.contains("flipped");
    }

    function applyFlip(flipped) {
      Array.prototype.forEach.call(inners, function (el) { el.classList.toggle("flipped", flipped); });
      // The toolbar only exists when this page stands alone; embedded, the
      // dialog owns the button and reads the state back through labelApi.
      if (rotateBtn) {
        rotateBtn.classList.toggle("on", flipped);
        rotateBtn.textContent = flipped ? "Rotated 180°" : "Rotate 180°";
      }
    }

    function toggleFlip() {
      var flipped = !isFlipped();
      localStorage.setItem(FLIP_KEY, flipped ? "1" : "0");
      applyFlip(flipped);
      return flipped;
    }

    applyFlip(localStorage.getItem(FLIP_KEY) === "1");

    if (rotateBtn) rotateBtn.addEventListener("click", toggleFlip);
    if (!embedded) {
      document.getElementById("printBtn").addEventListener("click", function () {
        window.print();
      });
      document.getElementById("closeBtn").addEventListener("click", function () {
        window.close();
      });
    }

    // What the stock page's Print dialog drives this label through. Same
    // origin, so the parent can call straight in -- no postMessage handshake
    // needed. print() lives here rather than the parent calling
    // frame.contentWindow.print() directly so that the fit pass is
    // guaranteed to have run against THIS document first.
    window.labelApi = {
      print: function () {
        window.focus();
        window.print();
      },
      toggleFlip: toggleFlip,
      isFlipped: isFlipped,
    };

    // Shrink any value too long for its box until it fits.
    //
    // The design was drawn for short sample values ("$ID", "$FAMILY") and
    // ours are longer -- a Roll ID is "RELEASE/26-27/007", a Type can be any
    // length. `data-maxw` on each text element is the room it has in the SVG's
    // own user units; getComputedTextLength() is the browser's real measure
    // of the rendered text, tspans included. Only ever shrinks: a value that
    // already fits keeps the design's font size.
    var MIN_UNIT = 8;
    function fitSvgText(el) {
      var maxw = parseFloat(el.getAttribute("data-maxw"));
      if (!maxw) return;
      var size = parseFloat(window.getComputedStyle(el).fontSize);
      while (el.getComputedTextLength() > maxw && size > MIN_UNIT) {
        size -= 0.5;
        el.style.fontSize = size + "px";
      }
    }

    window.addEventListener("load", function () {
      Array.prototype.forEach.call(document.querySelectorAll(".label-svg .fit"), fitSvgText);
      // Fitting first is load-bearing, not just tidy: print() blocks, so
      // anything resized after it would only affect the NEXT print.
      //
      // Embedded, the dialog decides when to print -- firing the dialog
      // automatically would ambush someone who only opened it to check the
      // label reads right.
      if (!embedded) window.print();
    });
  </script>
</body>
</html>
