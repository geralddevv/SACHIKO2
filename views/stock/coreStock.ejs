<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }
    #core-masters-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    .po-action-btn {
      padding: 4px 12px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      background: #044a78;
    }
    .po-action-btn:hover {
      background: #03365a;
    }
    .add-stock-btn {
      padding: 4px 12px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      background: #15803d;
    }
    .add-stock-btn:hover {
      background: #116531;
    }
    .po-pending-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      background: #fef3c7;
      color: #92400e;
    }
    .dialog-header {
      background: #044A78;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .dialog-header h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }
    .dialog-close-btn {
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      padding: 0 2px;
      opacity: 0.8;
      transition: opacity 0.15s;
    }
    .dialog-close-btn:hover {
      opacity: 1;
    }
    .dialog-body {
      padding: 24px;
    }
    .dialog-field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 8px;
    }
    .dialog-error {
      color: #ef4444;
      font-size: 12px;
      margin-top: 5px;
      display: none;
    }
    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }
    .dialog-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 12px;
    }

    /* Match Choices.js selects to the .premium-input look used by the rest
       of this dialog's fields. */
    .dialog-body .choices__inner {
      padding: 11px 14px !important;
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      background-color: #f8fafc !important;
      font-size: 14px !important;
      min-height: 0 !important;
      transition: all 0.2s ease !important;
    }
    .dialog-body .choices__list--single {
      padding: 0 !important;
    }
    .dialog-body .choices.is-focused .choices__inner,
    .dialog-body .choices.is-open .choices__inner {
      border-color: #044a78 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 4px rgba(4, 74, 120, 0.1) !important;
    }
    .dialog-body .choices[data-type*="select-one"]::after {
      display: block !important;
      content: "" !important;
      width: 12px !important;
      height: 8px !important;
      border-style: none !important;
      border-width: 0 !important;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
      background-repeat: no-repeat !important;
      background-size: contain !important;
      position: absolute !important;
      right: 14px !important;
      top: 50% !important;
      margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    .dialog-body .choices[data-type*="select-one"].is-open::after {
      transform: translateY(-50%) rotate(180deg) !important;
    }
    /* Dropdown list must render above the dialog overlay (see CLAUDE.md
       "Dialog / modal pattern" -- Choices.js in dialogs). */
    .dialog-body .choices__list--dropdown {
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      z-index: 99999 !important;
    }
    /* A long value (e.g. Vendor Name) shouldn't overflow its field or push
       against the dropdown arrow -- truncate with an ellipsis instead, both
       for the selected value shown in the closed field and for each option
       in the open dropdown list. Applies to every Choices.js select in this
       dialog, not just Vendor Name. */
    .dialog-body .choices__list--single .choices__item {
      display: block !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
      max-width: 100% !important;
      padding-right: 18px !important;
    }
    .dialog-body .choices__list--dropdown .choices__item {
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
    }

    .dialog-section-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.03em;
      color: #044a78;
      text-transform: uppercase;
      margin: 0 0 10px;
      flex: 0 0 auto;
    }
    .roll-row {
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px 14px;
      background: #f8fafc;
    }
    .roll-row-title {
      font-size: 12px;
      font-weight: 700;
      color: #044a78;
      margin-bottom: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

    /* Lots dropdown -- Tabulator's dataTree module, same pattern as
       FAIRTECH's Paper Re-Order page (views/inventory/orders/paperReorder.ejs):
       each master row expands via its own tree toggle into one child row per
       individual CoreStock lot behind that master's stock count. */
    .tabulator-data-tree-control {
      width: 20px !important;
      height: 20px !important;
      border: none !important;
      border-radius: 4px !important;
      background: rgba(4, 74, 120, 0.1) !important;
      box-shadow: none !important;
      outline: none !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      transition: background-color 0.15s ease !important;
    }
    .tabulator-data-tree-control:hover {
      background: rgba(4, 74, 120, 0.18) !important;
    }
    .tabulator-data-tree-control:focus,
    .tabulator-data-tree-control:focus-visible {
      outline: none !important;
      box-shadow: none !important;
    }
    .tabulator-data-tree-control-expand,
    .tabulator-data-tree-control-collapse {
      width: auto !important;
      height: auto !important;
      background: none !important;
      border: none !important;
    }
    .tabulator-data-tree-control-expand::before,
    .tabulator-data-tree-control-collapse::before {
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      content: "\f054"; /* chevron-right, one glyph for both states */
      font-size: 11px;
      line-height: 1;
      color: #044a78;
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .tabulator-data-tree-control-collapse::before {
      transform: rotate(90deg);
    }
    .tabulator-data-tree-control-expand::after,
    .tabulator-data-tree-control-collapse::after {
      content: none !important;
      display: none !important;
    }
    #core-masters-table .tabulator-row.roll-detail-row {
      transition: background-color 0.15s ease;
    }
    #core-masters-table .tabulator-row.roll-detail-row:hover {
      background-color: #eef2f7 !important;
      border-top: 1px solid #e6eaf2 !important;
      border-right-style: none !important;
      border-bottom-style: none !important;
      border-left-style: none !important;
    }
    #core-masters-table .tabulator-row.roll-detail-row > .tabulator-cell,
    #core-masters-table .tabulator-row.roll-detail-row > .tabulator-col-resize-handle {
      display: none !important;
    }
  </style>

  <!-- Core Master rows are the only table here: current stock (total pieces
       still in non-empty lots, matched by the same fields Core Master's own
       duplicate-check signature hashes) sits right on the spec it's stock
       of, alongside MSQ/shortage and the Inward/Create PO actions -- see
       routes/stock/coreStock.js's loadMastersWithStock. Every master is
       listed here even with zero lots. Unlike Facestock/Adhesive/Release
       Liner, there's no Allotted/Available pair here -- Core isn't a Label
       Stock production recipe layer, so there's no PendingProduction demand
       to net against stock (see loadMastersWithStock's comment). -->
  <div class="indi-head">
    <h1>Core Stock</h1>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="core-masters-table" class="tabulator tabulator-modern"></div>
</div>

<!-- ============ CREATE PURCHASE ORDER DIALOG ============ -->
<div class="logout-modal" id="poDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="poDialogTitle"
    style="width: min(480px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="poDialogTitle">Create Purchase Order</h2>
      <button class="dialog-close-btn" type="button" onclick="closePoDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="poSkuDisplay">SKU ID</label>
          <input type="text" id="poSkuDisplay" class="form-control premium-input" readonly style="background: #f1f5f9;" />
        </div>
        <div>
          <label class="dialog-field-label" for="poVendorDisplay">Vendor</label>
          <input type="text" id="poVendorDisplay" class="form-control premium-input" readonly style="background: #f1f5f9;" />
        </div>
      </div>

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="poQtyInput">Quantity (Pcs)</label>
          <input type="number" id="poQtyInput" class="form-control premium-input" min="1" step="1" placeholder="Enter pieces" />
        </div>
        <div>
          <label class="dialog-field-label" for="poNumberInput">PO Number</label>
          <input type="text" id="poNumberInput" class="form-control premium-input" placeholder="Enter PO number" />
        </div>
      </div>

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="poLocationSelect">Delivery Location</label>
          <select id="poLocationSelect"></select>
        </div>
        <div>
          <label class="dialog-field-label" for="poDateInput">Estimated Date</label>
          <input type="date" id="poDateInput" class="form-control premium-input" />
        </div>
      </div>

      <label class="dialog-field-label" for="poRemarksInput">Remarks</label>
      <input type="text" id="poRemarksInput" class="form-control premium-input" placeholder="Optional remarks" />

      <div id="poError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closePoDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="poSubmitBtn" onclick="submitPo()">Create PO</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ ADD CORE DIALOG (batch inward, landscape) ============ -->
<div class="logout-modal" id="addDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="addDialogTitle"
    style="width: min(1180px, 94vw); height: min(680px, 85vh); padding: 0; border-radius: 14px; display: flex; flex-direction: column;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0; flex: 0 0 auto;">
      <div style="display: flex; align-items: center; gap: 20px;">
        <h2 id="addDialogTitle">Add Core Lots</h2>
        <div style="display: flex; align-items: center; gap: 16px; font-size: 13px; color: rgba(255, 255, 255, 0.8);">
          <span>Lots: <strong id="summaryLotCount" style="color: #fff; font-size: 15px;">1</strong></span>
          <span>Total Pcs: <strong id="summaryTotalPcs" style="color: #fff; font-size: 15px;">0</strong></span>
        </div>
      </div>
      <button class="dialog-close-btn" type="button" onclick="closeAddDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; padding: 24px;">
      <div style="display: flex; gap: 28px; flex: 1 1 auto; min-height: 0;">

        <!-- ---- Left: shared spec for this batch ---- -->
        <!-- Type/Vendor/Make/Print Type/Thickness/Width -- every field Core
             Master itself carries -- are smart-filtered against it (see GET
             /sachiko/corestock/filter-specs): picking one narrows the others
             to combinations that actually exist in the master catalog, same
             "narrow as you pick" pattern as Tape Stock inward and Facestock
             Stock inward. -->
        <div class="custom-scrollbar" style="flex: 1 1 400px; min-width: 400px; padding-right: 6px; overflow-y: auto;">
          <!-- ---- Master Table (read-only reference) ---- -->
          <div style="margin-bottom: 20px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; overflow: hidden;">
            <table id="coreMastersRef" style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 13px; font-weight: 600;">
              <colgroup>
                <col style="width: 16%;" />
                <col style="width: 20%;" />
                <col style="width: 18%;" />
                <col style="width: 16%;" />
                <col style="width: 14%;" />
                <col style="width: 14%;" />
              </colgroup>
              <tbody style="color: #0f172a;">
                <tr><td colspan="6" style="padding: 12px; text-align: center; color: #64748b;">Select a master to inward</td></tr>
              </tbody>
            </table>
          </div>

          <h3 style="margin: 0 0 16px 0; font-size: 0.9rem; font-weight: 600; color: #044a78; text-transform: uppercase; letter-spacing: 0.03em;">Inward Details</h3>

          <div class="dialog-field-row" style="grid-template-columns: 1fr 1fr 1fr 1fr;">
            <div>
              <label class="dialog-field-label" for="addInvoiceNoInput">Invoice No</label>
              <input type="text" id="addInvoiceNoInput" class="form-control premium-input" placeholder="Enter invoice no" />
            </div>
            <div>
              <label class="dialog-field-label" for="addLocationSelect">Location</label>
              <select id="addLocationSelect"></select>
            </div>
            <div>
              <label class="dialog-field-label" for="addRateInput">Rate</label>
              <input type="number" id="addRateInput" class="form-control premium-input" placeholder="Enter rate" min="0" step="any" />
            </div>
            <div>
              <label class="dialog-field-label" for="addLotCountInput">No of Lots</label>
              <input type="number" id="addLotCountInput" class="form-control premium-input" min="1" max="100" step="1" value="1" />
            </div>
          </div>

          <label class="dialog-field-label" for="addRemarksInput">Remarks</label>
          <input type="text" id="addRemarksInput" class="form-control premium-input" placeholder="Optional remarks" />
        </div>

        <!-- ---- Right: one card per inward lot ---- -->
        <div style="flex: 1 1 auto; min-width: 0; max-width: 500px; display: flex; flex-direction: column;">
          <div class="dialog-section-label"><span>Lots</span></div>
          <div id="addLotsContainer" class="custom-scrollbar" style="flex: 1 1 auto; min-height: 0; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); align-content: start; gap: 14px; padding-right: 6px;"></div>
        </div>
      </div>

      <div id="addCoreError" class="dialog-error"></div>
      <div class="dialog-actions" style="flex: 0 0 auto;">
        <button class="logout-btn" type="button" onclick="closeAddDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="addSubmitBtn" onclick="submitAdd()">Save Lots</button>
      </div>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="locations-data" type="application/json"><%- safeJson(locations) %></script>
<script id="core-specs-data" type="application/json"><%- safeJson({ types, vendors, makes, printTypes, thicknesses, ods, lengths }) %></script>
<script id="core-masters-data" type="application/json"><%- safeJson(masters) %></script>
<script>
  const locationsData = JSON.parse(document.getElementById("locations-data").textContent);
  const coreSpecsData = JSON.parse(document.getElementById("core-specs-data").textContent);
  const mastersData = JSON.parse(document.getElementById("core-masters-data").textContent);

  function locationOptionsHtml(selectedName) {
    return locationsData
      .map((l) => `<option value="${l.locationName}" ${l.locationName === selectedName ? "selected" : ""}>${l.locationName}</option>`)
      .join("");
  }

  // Rebuilds a smart-filtered select's full (unfiltered) option list -- used
  // to reset the Add dialog's Type/Make/Print Type/Thickness/OD/Length pickers
  // back to every Core Master value each time the dialog is (re)opened,
  // since filterAddSpecs narrows them in place while it's open.
  function specOptionsHtml(values, noneLabel, noneDisabled) {
    const noneOption = `<option value="" ${noneDisabled ? "disabled selected hidden" : ""}>${noneLabel}</option>`;
    return noneOption + values.map((v) => `<option value="${v}">${v}</option>`).join("");
  }

  // Same, for the Vendor Name picker -- its options are {vendorId, vendorName}
  // pairs, not plain scalars, so it needs its own value/label mapping.
  function vendorOptionsHtml(vendors) {
    return `<option value="">— None —</option>` + vendors.map((v) => `<option value="${v.vendorId}">${v.vendorName}</option>`).join("");
  }

  let addTypeChoices = null, addVendorChoices = null, addMakeChoices = null;
  let addPrintTypeChoices = null, addThicknessChoices = null, addOdChoices = null, addLengthChoices = null, addLocationChoices = null;

  // ---- Add (inward) dialog: smart filter for Type/Vendor/Make/Print Type/
  // Thickness/OD/Length ---- Narrows each field's options to combinations that
  // actually exist in Core Master as the other fields are picked -- same
  // pattern as Tape Stock inward and Facestock Stock inward.
  const addSpecFields = ["addTypeSelect", "addVendorSelect", "addMakeSelect", "addPrintTypeSelect", "addThicknessSelect", "addOdSelect", "addLengthSelect"];
  const addSpecFieldToKey = {
    addTypeSelect: "type",
    addVendorSelect: "vendorId",
    addMakeSelect: "make",
    addPrintTypeSelect: "printType",
    addThicknessSelect: "thickness",
    addOdSelect: "od",
    addLengthSelect: "length",
  };
  const addSpecFieldToDataKey = {
    addTypeSelect: "types",
    addVendorSelect: "vendors",
    addMakeSelect: "makes",
    addPrintTypeSelect: "printTypes",
    addThicknessSelect: "thicknesses",
    addOdSelect: "ods",
    addLengthSelect: "lengths",
  };
  // Vendor's options are {vendorId, vendorName} pairs; every other field's
  // are plain scalars -- this is the one place that difference matters.
  const addSpecFieldToChoice = {
    addVendorSelect: (v) => ({ value: v.vendorId, label: v.vendorName }),
  };
  function toChoiceOption(fieldId, value, currentValue) {
    const mapper = addSpecFieldToChoice[fieldId] || ((v) => ({ value: String(v), label: String(v) }));
    const { value: val, label } = mapper(value);
    return { value: val, label, selected: val === currentValue };
  }
  // Vendor/Make/Print Type/Thickness/OD/Length are all optional on a stock lot,
  // so their reset choice is a real selectable "— None —"; Type is required,
  // so it stays a disabled placeholder like the rest of this dialog's
  // required selects.
  const addSpecFieldPlaceholder = {
    addTypeSelect: { label: "Select type", disabled: true },
    addVendorSelect: { label: "— None —", disabled: false },
    addMakeSelect: { label: "— None —", disabled: false },
    addPrintTypeSelect: { label: "— None —", disabled: false },
    addThicknessSelect: { label: "— None —", disabled: false },
    addOdSelect: { label: "— None —", disabled: false },
    addLengthSelect: { label: "— None —", disabled: false },
  };
  function addSpecChoicesInstance(id) {
    if (id === "addTypeSelect") return addTypeChoices;
    if (id === "addVendorSelect") return addVendorChoices;
    if (id === "addMakeSelect") return addMakeChoices;
    if (id === "addPrintTypeSelect") return addPrintTypeChoices;
    if (id === "addThicknessSelect") return addThicknessChoices;
    if (id === "addOdSelect") return addOdChoices;
    if (id === "addLengthSelect") return addLengthChoices;
    return null;
  }

  async function filterAddSpecs(changedFieldId) {
    const params = new URLSearchParams();
    addSpecFields.forEach((id) => {
      const el = document.getElementById(id);
      if (el && el.value) params.set(addSpecFieldToKey[id], el.value);
    });

    try {
      const res = await fetch(`/sachiko/corestock/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];

      addSpecFields.forEach((id) => {
        if (id === changedFieldId) return;
        const choicesInstance = addSpecChoicesInstance(id);
        if (!choicesInstance) return;

        const filteredValues = data[addSpecFieldToDataKey[id]] || [];
        const currentValue = document.getElementById(id)?.value || "";

        const newChoices = filteredValues.map((v) => toChoiceOption(id, v, currentValue));

        if (filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        const ph = addSpecFieldPlaceholder[id];
        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: ph.label, disabled: ph.disabled, selected: !newChoices.some((c) => c.selected) }, ...newChoices],
          "value", "label", true
        );
      });

      if (autoSelected.length > 0) await filterAddSpecs(autoSelected[0]);
    } catch (err) {
      console.error("Core filter specs error:", err);
    }
  }

  addSpecFields.forEach((id) => {
    document.getElementById(id)?.addEventListener("change", () => filterAddSpecs(id));
  });

  // Truncates a long cell value with an ellipsis (title attribute carries
  // the full text as a hover tooltip) -- used for free-text fields like
  // Vendor Name that can run longer than the column is wide.
  function ellipsisFormatter(cell) {
    const value = cell.getValue();
    if (!value) return "—";
    cell.getElement().style.cssText += "overflow:hidden;text-overflow:ellipsis;white-space:nowrap;";
    cell.getElement().title = value;
    return value;
  }

  // ---- Helpers ----
  function openModal(id) {
    const d = document.getElementById(id);
    d.classList.add("show");
    d.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const d = document.getElementById(id);
    d.classList.remove("show");
    d.setAttribute("aria-hidden", "true");
  }
  function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.style.display = "block";
  }
  function hideError(elId) {
    document.getElementById(elId).style.display = "none";
  }
  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.disabled = loading;
    btn.style.opacity = loading ? "0.7" : "";
  }

  ["addDialog", "poDialog"].forEach(id => {
    document.getElementById(id).addEventListener("click", function (e) {
      if (e.target === this) closeModal(id);
    });
  });

  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    ["addDialog", "poDialog"].forEach(id => {
      if (document.getElementById(id).classList.contains("show")) closeModal(id);
    });
  });

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[c]);
  }

  function formatRollDate(value) {
    if (!value) return "—";
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? "—" : d.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
  }

  const fmt = (n) => (n === null || n === undefined ? "—" : Number(n).toLocaleString("en-IN"));

  // Flattens each master into Tabulator's dataTree shape: one row per Core
  // Master, with the individual CoreStock lots behind its stock count (see
  // routes/stock/coreStock.js's loadMastersWithStock) as _children rows --
  // same "Rolls" dropdown pattern as FAIRTECH's Paper Re-Order page
  // (paperReorder.ejs). A master with no lots still gets a one-line
  // placeholder child so its tree toggle has something to open onto
  // (Tabulator draws the toggle for any array, regardless of length).
  function buildMastersTreeData(masters) {
    return masters.map((m) => {
      const rolls = Array.isArray(m.rolls) ? m.rolls : [];
      return {
        ...m,
        isParent: true,
        _children: rolls.length ? rolls.map((r) => ({ ...r, isParent: false })) : [{ isParent: false, noRolls: true }],
      };
    });
  }

  // ---- Masters & Reorder table ----
  const mastersTable = new Tabulator("#core-masters-table", {
    data: buildMastersTreeData(mastersData),
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No core masters added yet.",
    dataTree: true,
    dataTreeStartExpanded: false,
    dataTreeChildField: "_children",
    dataTreeFilter: false,
    dataTreeElementColumn: "_toggle",
    // Lot rows carry free-text identity (Core ID, Vendor Batch No, Remarks...)
    // that doesn't fit a fixed column width -- hide every per-column cell on
    // those rows and replace them with one spanning detail bar instead,
    // exactly like paperReorder.ejs's order rows.
    rowFormatter: (row) => {
      const data = row.getData();
      if (data.isParent) return;
      const el = row.getElement();
      if (el.querySelector(".roll-detail-span")) return;
      el.style.backgroundColor = "#f8fafc";
      el.style.borderTop = "1px solid #e6eaf2";
      el.classList.add("roll-detail-row");
      const bar = document.createElement("div");
      bar.className = "roll-detail-span";
      bar.style.cssText = "flex:1; display:flex; align-items:center; flex-wrap:wrap; gap:8px; padding:6px 12px; color:#4b5563; font-size:13px;";
      if (data.noRolls) {
        bar.innerHTML = `<span style="color:#94a3b8; font-style:italic;">No lots in stock for this spec.</span>`;
      } else {
        const parts = [
          `↳ <b style="color:#1f2a44;">${escapeHtml(data.rollId || "—")}</b>`,
          data.vendorRollId ? `Vendor Batch No: ${escapeHtml(data.vendorRollId)}` : "",
          `Pcs ${fmt(data.quantity)}`,
          data.location ? escapeHtml(data.location) : "",
          data.rate != null ? `Rate ₹${fmt(data.rate)}` : "",
          data.invoiceNo ? `Invoice ${escapeHtml(data.invoiceNo)}` : "",
          `Added ${formatRollDate(data.createdAt)}`,
          data.remarks ? escapeHtml(data.remarks) : "",
        ].filter(Boolean);
        bar.innerHTML = parts.map((p, i) => (i === 0 ? p : `<span>${p}</span>`)).join('<span style="color:#334155; font-size:16px; font-weight:700; line-height:1;">&middot;</span>');
      }
      el.appendChild(bar);
    },
    columns: [
      { title: "", field: "_toggle", width: 40, hozAlign: "center", headerSort: false },
      // getPosition(true) is the row's rank among currently sorted/filtered
      // rows, re-evaluated on every redraw -- stays correct after sorting or
      // filtering instead of a static index frozen at load time. Lot (child)
      // rows don't get their own number, same as every other column here.
      { title: "Sr. No.", field: "_srNo", width: 60, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => (cell.getRow().getData().isParent ? cell.getRow().getPosition(true) : "") },
      {
        title: "Inward",
        width: 110,
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isParent) return "";
          const btn = document.createElement("button");
          btn.className = "add-stock-btn";
          btn.title = "Add stock lots for this spec";
          btn.innerHTML = '<i class="fa-solid fa-plus"></i> Add';
          btn.addEventListener("click", () => openAddDialog(row));
          return btn;
        },
      },
      { title: "SKU ID", field: "skuId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150 },
      { title: "Vendor Name", field: "vendorName", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150, maxWidth: 220, formatter: ellipsisFormatter },
      { title: "Type", field: "type", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110 },
      { title: "Make", field: "make", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 120, formatter: (cell) => cell.getValue() || "—" },
      { title: "Print Type", field: "printType", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110 },
      { title: "Thickness", field: "thickness", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "OD", field: "od", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 80, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Length", field: "length", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 80, formatter: (cell) => cell.getValue() ?? "—" },
      {
        title: "Stock (Pcs)",
        field: "currentStock",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 110,
        formatter: (cell) => (cell.getRow().getData().isParent ? (cell.getValue() || 0) : ""),
      },
      {
        title: "Stock (Lots)",
        field: "rollCount",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 110,
        formatter: (cell) => (cell.getRow().getData().isParent ? (cell.getValue() || 0) : ""),
      },
      {
        title: "Shortage",
        field: "shortage",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 110,
        formatter: (cell) => (cell.getRow().getData().isParent ? `<span style="font-weight:800; color:#dc2626;">${cell.getValue() || 0}</span>` : ""),
      },
      { title: "MSQ", field: "msq", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      {
        title: "Purchase Order",
        width: 150,
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isParent) return "";
          if (row.hasActivePO) return `<span class="po-pending-badge">PO Pending</span>`;
          const btn = document.createElement("button");
          btn.className = "po-action-btn";
          btn.textContent = "Create PO";
          btn.addEventListener("click", () => openPoDialog(row));
          return btn;
        },
      },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever master rows
  // are actually on screen, top to bottom, get renumbered 1..n every time
  // the table redraws. Lot (child) rows are marked ".roll-detail-row" by
  // rowFormatter above and skipped, same as every other master-only column.
  mastersTable.on("renderComplete", function () {
    document.querySelectorAll("#core-masters-table .tabulator-row:not(.roll-detail-row)").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  // ---- Create Purchase Order dialog ----
  let poLocationChoices = null;
  let poMasterId = null;

  function openPoDialog(row) {
    poMasterId = row._id;
    document.getElementById("poSkuDisplay").value = row.skuId;
    document.getElementById("poVendorDisplay").value = row.vendorName || "—";
    document.getElementById("poQtyInput").value = row.shortage || "";
    document.getElementById("poNumberInput").value = "";
    document.getElementById("poRemarksInput").value = "";

    const inSevenDays = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
    document.getElementById("poDateInput").value = inSevenDays.toISOString().slice(0, 10);

    if (poLocationChoices) { poLocationChoices.destroy(); poLocationChoices = null; }
    const locSel = document.getElementById("poLocationSelect");
    locSel.innerHTML = locationOptionsHtml("");
    poLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    hideError("poError");
    openModal("poDialog");
  }
  function closePoDialog() {
    closeModal("poDialog");
    poMasterId = null;
  }

  async function submitPo() {
    const quantity = document.getElementById("poQtyInput").value;
    const poNumber = document.getElementById("poNumberInput").value.trim();
    const userLocation = document.getElementById("poLocationSelect").value;
    const estimatedDate = document.getElementById("poDateInput").value;
    if (!quantity || Number(quantity) <= 0) return showError("poError", "Quantity is required.");
    if (!poNumber) return showError("poError", "PO Number is required.");
    if (!userLocation) return showError("poError", "Delivery location is required.");
    if (!poMasterId) return;

    hideError("poError");
    setLoading("poSubmitBtn", true);
    try {
      const res = await fetch("/sachiko/corestock/purchase-order", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          masterId: poMasterId,
          quantity,
          poNumber,
          estimatedDate,
          userLocation,
          remarks: document.getElementById("poRemarksInput").value.trim(),
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/sachiko/purchase/pending";
      } else {
        showError("poError", data.message || "Failed to create Purchase Order.");
      }
    } catch {
      showError("poError", "Server error. Please try again.");
    } finally {
      setLoading("poSubmitBtn", false);
    }
  }

  // ---- ADD (batch inward) ----

  // Row group markup for one inward lot of the batch's shared spec -- Core
  // ID is filled in after the fact by refreshRollIdPreviews(), never typed.
  function lotRowHtml(index, prev) {
    return `
      <div class="roll-row" data-index="${index}">
        <div class="roll-row-title">Lot ${index + 1}</div>
        <label class="dialog-field-label">Core ID</label>
        <input type="text" class="form-control premium-input roll-id-preview" readonly style="margin-bottom: 10px; background: #f1f5f9;" />
        <label class="dialog-field-label">Vendor Batch No</label>
        <input type="text" class="form-control premium-input roll-vendor-id" placeholder="Vendor's own batch no" value="${prev.vendorRollId || ""}" style="margin-bottom: 10px;" />
        <label class="dialog-field-label">Pieces</label>
        <input type="number" class="form-control premium-input roll-mtrs" min="0" step="1" placeholder="Enter pieces" value="${prev.mtrs || ""}" />
      </div>`;
  }

  // Rebuilds the lot rows for the given count, keeping whatever the user
  // already typed into rows that are still present -- only rows past the
  // new count are dropped, and new rows are always appended at the end so an
  // existing row's index never shifts while it's on screen.
  function renderLotRows(count, preserveValues) {
    const container = document.getElementById("addLotsContainer");
    const existing = preserveValues
      ? Array.from(container.querySelectorAll(".roll-row")).map((row) => ({
          vendorRollId: row.querySelector(".roll-vendor-id").value,
          mtrs: row.querySelector(".roll-mtrs").value,
        }))
      : [];
    container.innerHTML = Array.from({ length: count }, (_, i) => lotRowHtml(i, existing[i] || {})).join("");
    refreshRollIdPreviews();
    updateBatchSummary();
  }

  // Live lot count / total pieces shown in the dialog header as rows are
  // added/removed and Pieces values are typed.
  function updateBatchSummary() {
    const rows = document.querySelectorAll("#addLotsContainer .roll-row");
    const totalPcs = Array.from(rows).reduce((sum, row) => sum + (Number(row.querySelector(".roll-mtrs").value) || 0), 0);
    document.getElementById("summaryLotCount").textContent = rows.length;
    document.getElementById("summaryTotalPcs").textContent = totalPcs;
  }
  document.getElementById("addLotsContainer").addEventListener("input", (e) => {
    if (e.target.classList.contains("roll-mtrs")) updateBatchSummary();
  });

  async function refreshRollIdPreviews() {
    const rows = document.querySelectorAll("#addLotsContainer .roll-row");
    if (!rows.length) return;
    try {
      const res = await fetch(`/sachiko/corestock/preview-roll-ids?count=${rows.length}`);
      const data = await res.json();
      const ids = data.rollIds || [];
      rows.forEach((row, i) => {
        row.querySelector(".roll-id-preview").value = ids[i] || "";
      });
    } catch {
      // Preview is cosmetic only -- the server assigns the real id on save.
    }
  }

  document.getElementById("addLotCountInput").addEventListener("change", function () {
    const count = Math.min(Math.max(parseInt(this.value, 10) || 1, 1), 100);
    this.value = count;
    renderLotRows(count, true);
  });

  // masterPrefill (optional): a row from the Masters & Reorder panel below --
  // when given, every spec field is pre-set to that master's own spec
  // instead of left blank, so "Add Stock" on a master row jumps straight to
  // entering lot rows rather than re-picking a spec the smart filters would
  // narrow down to anyway.
  let selectedCoreMaster = {};

  function openAddDialog(masterPrefill) {
    selectedCoreMaster = masterPrefill || {};

    // Populate masters table with selected master only - show ALL master data
    const tbody = document.getElementById("coreMastersRef").querySelector("tbody");
    if (selectedCoreMaster && selectedCoreMaster.type) {
      tbody.innerHTML = `
        <tr style="border-bottom: 1px solid #e2e8f0;">
          <td style="padding: 10px; font-weight: 700; color: #044a78; border-right: 1px solid #e2e8f0;">Vendor</td>
          <td style="padding: 10px; color: #0f172a;" colspan="5">${selectedCoreMaster.vendorName || "—"}</td>
        </tr>
        <tr style="border-bottom: 1px solid #e2e8f0;">
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Type</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Make</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Print Type</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Thickness</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">OD</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px;">Length</td>
        </tr>
        <tr>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedCoreMaster.type || ""}">${selectedCoreMaster.type || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedCoreMaster.make || ""}">${selectedCoreMaster.make || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedCoreMaster.printType || ""}">${selectedCoreMaster.printType || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedCoreMaster.thickness || ""}">${selectedCoreMaster.thickness || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedCoreMaster.od || ""}">${selectedCoreMaster.od || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedCoreMaster.length || ""}">${selectedCoreMaster.length || "—"}</td>
        </tr>
      `;
    } else {
      tbody.innerHTML = '<tr><td colspan="6" style="padding: 12px; text-align: center; color: #64748b;">Select a master to inward</td></tr>';
    }

    document.getElementById("addRateInput").value = "";
    document.getElementById("addInvoiceNoInput").value = "";
    document.getElementById("addRemarksInput").value = "";
    document.getElementById("addLotCountInput").value = "1";

    if (addLocationChoices) { addLocationChoices.destroy(); addLocationChoices = null; }
    const locSel = document.getElementById("addLocationSelect");
    locSel.innerHTML = locationOptionsHtml("");
    addLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    renderLotRows(1, false);

    hideError("addCoreError");
    openModal("addDialog");
  }
  function closeAddDialog() {
    closeModal("addDialog");
  }

  async function submitAdd() {
    if (!selectedCoreMaster || !selectedCoreMaster._id) return showError("addCoreError", "Please select a master to inward.");

    const location = document.getElementById("addLocationSelect").value;
    if (!location) return showError("addCoreError", "Location is required.");

    const lotRows = Array.from(document.querySelectorAll("#addLotsContainer .roll-row"));
    const rolls = lotRows.map((row) => ({
      quantity: row.querySelector(".roll-mtrs").value,
      vendorRollId: row.querySelector(".roll-vendor-id").value,
    }));
    const emptyIndex = rolls.findIndex((r) => !r.quantity || Number(r.quantity) <= 0);
    if (emptyIndex !== -1) return showError("addCoreError", `Pieces is required for lot ${emptyIndex + 1}.`);

    hideError("addCoreError");
    setLoading("addSubmitBtn", true);
    try {
      const res = await fetch("/sachiko/corestock/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          type: selectedCoreMaster.type,
          vendorId: selectedCoreMaster.vendorId,
          make: selectedCoreMaster.make,
          printType: selectedCoreMaster.printType,
          thickness: selectedCoreMaster.thickness,
          od: selectedCoreMaster.od,
          length: selectedCoreMaster.length,
          rate: document.getElementById("addRateInput").value,
          location,
          invoiceNo: document.getElementById("addInvoiceNoInput").value,
          remarks: document.getElementById("addRemarksInput").value,
          rolls,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/sachiko/corestock";
      } else {
        showError("addCoreError", data.message || "Failed to add core stock.");
      }
    } catch {
      showError("addCoreError", "Server error. Please try again.");
    } finally {
      setLoading("addSubmitBtn", false);
    }
  }

</script>
