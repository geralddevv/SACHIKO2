<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }
    #facestock-masters-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    .po-action-btn {
      padding: 4px 12px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      background: #044a78;
    }
    .po-action-btn:hover {
      background: #03365a;
    }
    .add-stock-btn {
      padding: 4px 12px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      background: #15803d;
    }
    .add-stock-btn:hover {
      background: #116531;
    }
    .po-pending-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      background: #fef3c7;
      color: #92400e;
    }
    .dialog-header {
      background: #044A78;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .dialog-header h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }
    .dialog-close-btn {
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      padding: 0 2px;
      opacity: 0.8;
      transition: opacity 0.15s;
    }
    .dialog-close-btn:hover {
      opacity: 1;
    }
    .dialog-body {
      padding: 24px;
    }
    .dialog-field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 8px;
    }
    .dialog-error {
      color: #ef4444;
      font-size: 12px;
      margin-top: 5px;
      display: none;
    }
    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }
    .dialog-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 12px;
    }

    /* Match Choices.js selects to the .premium-input look used by the rest
       of this dialog's fields. */
    .dialog-body .choices__inner {
      padding: 11px 14px !important;
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      background-color: #f8fafc !important;
      font-size: 14px !important;
      min-height: 0 !important;
      transition: all 0.2s ease !important;
    }
    .dialog-body .choices__list--single {
      padding: 0 !important;
    }
    .dialog-body .choices.is-focused .choices__inner,
    .dialog-body .choices.is-open .choices__inner {
      border-color: #044a78 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 4px rgba(4, 74, 120, 0.1) !important;
    }
    .dialog-body .choices[data-type*="select-one"]::after {
      display: block !important;
      content: "" !important;
      width: 12px !important;
      height: 8px !important;
      border-style: none !important;
      border-width: 0 !important;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
      background-repeat: no-repeat !important;
      background-size: contain !important;
      position: absolute !important;
      right: 14px !important;
      top: 50% !important;
      margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    .dialog-body .choices[data-type*="select-one"].is-open::after {
      transform: translateY(-50%) rotate(180deg) !important;
    }
    /* Dropdown list must render above the dialog overlay (see CLAUDE.md
       "Dialog / modal pattern" -- Choices.js in dialogs). */
    .dialog-body .choices__list--dropdown {
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      z-index: 99999 !important;
    }
    /* A long value (e.g. Vendor Name) shouldn't overflow its field or push
       against the dropdown arrow -- truncate with an ellipsis instead, both
       for the selected value shown in the closed field and for each option
       in the open dropdown list. Applies to every Choices.js select in this
       dialog, not just Vendor Name. */
    .dialog-body .choices__list--single .choices__item {
      display: block !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
      max-width: 100% !important;
      padding-right: 18px !important;
    }
    .dialog-body .choices__list--dropdown .choices__item {
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
    }

    .dialog-section-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.03em;
      color: #044a78;
      text-transform: uppercase;
      margin: 0 0 10px;
      flex: 0 0 auto;
    }
    .roll-row {
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px 14px;
      background: #f8fafc;
    }
    .roll-row-title {
      font-size: 12px;
      font-weight: 700;
      color: #044a78;
      margin-bottom: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

    /* Rolls dropdown -- Tabulator's dataTree module, same pattern as
       FAIRTECH's Paper Re-Order page (views/inventory/orders/paperReorder.ejs):
       each master row expands via its own tree toggle into one child row per
       individual FacestockStock reel behind that master's stock count. */
    .tabulator-data-tree-control {
      width: 20px !important;
      height: 20px !important;
      border: none !important;
      border-radius: 4px !important;
      background: rgba(4, 74, 120, 0.1) !important;
      box-shadow: none !important;
      outline: none !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      transition: background-color 0.15s ease !important;
    }
    .tabulator-data-tree-control:hover {
      background: rgba(4, 74, 120, 0.18) !important;
    }
    .tabulator-data-tree-control:focus,
    .tabulator-data-tree-control:focus-visible {
      outline: none !important;
      box-shadow: none !important;
    }
    .tabulator-data-tree-control-expand,
    .tabulator-data-tree-control-collapse {
      width: auto !important;
      height: auto !important;
      background: none !important;
      border: none !important;
    }
    .tabulator-data-tree-control-expand::before,
    .tabulator-data-tree-control-collapse::before {
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      content: "\f054"; /* chevron-right, one glyph for both states */
      font-size: 11px;
      line-height: 1;
      color: #044a78;
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .tabulator-data-tree-control-collapse::before {
      transform: rotate(90deg);
    }
    .tabulator-data-tree-control-expand::after,
    .tabulator-data-tree-control-collapse::after {
      content: none !important;
      display: none !important;
    }
    #facestock-masters-table .tabulator-row.roll-detail-row {
      transition: background-color 0.15s ease;
    }
    #facestock-masters-table .tabulator-row.roll-detail-row:hover {
      background-color: #eef2f7 !important;
      border-top: 1px solid #e6eaf2 !important;
      border-right-style: none !important;
      border-bottom-style: none !important;
      border-left-style: none !important;
    }
    #facestock-masters-table .tabulator-row.roll-detail-row > .tabulator-cell,
    #facestock-masters-table .tabulator-row.roll-detail-row > .tabulator-col-resize-handle {
      display: none !important;
    }
    /* Invoice No is the one inward field that's still optional (see the Add
       dialog) -- a reel saved without one is flagged red here so it stands
       out for follow-up, with an Edit button (appended by rowFormatter)
       to fix it. */
    #facestock-masters-table .tabulator-row.roll-detail-row.roll-missing-invoice:hover {
      background-color: #fee2e2 !important;
    }
    .roll-edit-btn {
      padding: 3px 10px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 11.5px;
      font-weight: 700;
      color: #fff;
      background: #dc2626;
    }
    .roll-edit-btn:hover {
      background: #b91c1c;
    }
    /* Reel already has its Invoice No -- blue instead of the red "needs
       attention" color used for reels still missing one. */
    .roll-edit-btn.has-invoice {
      background: #044a78;
    }
    .roll-edit-btn.has-invoice:hover {
      background: #03365a;
    }
  </style>

  <!-- Facestock Master rows are the only table here: current stock (total
       mtrs still on non-empty reels, matched by the same fields Facestock
       Master's own duplicate-check signature hashes) sits right on the spec
       it's stock of, alongside MSQ/shortage and the Inward/Create PO
       actions -- see routes/stock/facestockStock.js's loadMastersWithStock.
       Every master is listed here even with zero reels. -->
  <div class="indi-head">
    <div style="display: flex; align-items: center; gap: 14px;">
      <h1>Facestock Stock</h1>
      <span style="font-size: 13px; font-weight: 700; color: #044a78; background: #eef2f7; padding: 6px 12px; border-radius: 8px;">
        Facestock Value: <span style="color: #15803d;">₹<%= Number(facestockValue || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 }) %></span>
      </span>
      <span style="font-size: 13px; font-weight: 700; color: #044a78; background: #eef2f7; padding: 6px 12px; border-radius: 8px;">
        Release Liner Value: <span style="color: #15803d;">₹<%= Number(releaseValue || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 }) %></span>
      </span>
      <span style="font-size: 13px; font-weight: 700; color: #044a78; background: #eef2f7; padding: 6px 12px; border-radius: 8px;">
        Adhesive Value: <span style="color: #15803d;">₹<%= Number(adhesiveValue || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 }) %></span>
      </span>
    </div>
    <span style="font-size: 14px; font-weight: 800; color: #fff; background: #044a78; padding: 6px 14px; border-radius: 8px;">
      Total Value: ₹<%= Number(totalStockValue || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 }) %>
    </span>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="facestock-masters-table" class="tabulator tabulator-modern"></div>
</div>

<!-- ============ CREATE PURCHASE ORDER DIALOG ============ -->
<div class="logout-modal" id="poDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="poDialogTitle"
    style="width: min(480px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="poDialogTitle">Create Purchase Order</h2>
      <button class="dialog-close-btn" type="button" onclick="closePoDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="poSkuDisplay">SKU ID</label>
          <input type="text" id="poSkuDisplay" class="form-control premium-input" readonly style="background: #f1f5f9;" />
        </div>
        <div>
          <label class="dialog-field-label" for="poVendorDisplay">Vendor</label>
          <input type="text" id="poVendorDisplay" class="form-control premium-input" readonly style="background: #f1f5f9;" />
        </div>
      </div>

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="poQtyInput">Quantity (Kg)</label>
          <input type="number" id="poQtyInput" class="form-control premium-input" min="1" step="any" placeholder="Enter mtrs" />
        </div>
        <div>
          <label class="dialog-field-label" for="poNumberInput">PO Number</label>
          <input type="text" id="poNumberInput" class="form-control premium-input" placeholder="Enter PO number" />
        </div>
      </div>

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="poLocationSelect">Delivery Location</label>
          <select id="poLocationSelect"></select>
        </div>
        <div>
          <label class="dialog-field-label" for="poDateInput">Estimated Date</label>
          <input type="date" id="poDateInput" class="form-control premium-input" />
        </div>
      </div>

      <label class="dialog-field-label" for="poRemarksInput">Remarks</label>
      <input type="text" id="poRemarksInput" class="form-control premium-input" placeholder="Optional remarks" />

      <div id="poError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closePoDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="poSubmitBtn" onclick="submitPo()">Create PO</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ ADD FACESTOCK DIALOG (batch inward, landscape) ============ -->
<div class="logout-modal" id="addDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="addDialogTitle"
    style="width: min(1180px, 94vw); height: min(680px, 85vh); padding: 0; border-radius: 14px; display: flex; flex-direction: column;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0; flex: 0 0 auto;">
      <div style="display: flex; align-items: center; gap: 20px;">
        <h2 id="addDialogTitle">Add Facestock Reels</h2>
        <div style="display: flex; align-items: center; gap: 16px; font-size: 13px; color: rgba(255, 255, 255, 0.8);">
          <span>Rolls: <strong id="summaryRollCount" style="color: #fff; font-size: 15px;">1</strong></span>
          <span>Total Kg: <strong id="summaryTotalMtrs" style="color: #fff; font-size: 15px;">0</strong></span>
        </div>
      </div>
      <button class="dialog-close-btn" type="button" onclick="closeAddDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; padding: 24px;">
      <div style="display: flex; gap: 28px; flex: 1 1 auto; min-height: 0;">

        <!-- ---- Left: shared spec for this batch ---- -->
        <!-- overflow-y: auto is a safety net only (see updateBatchSummary --
             this column's content is sized to fit without scrolling in the
             normal case); Choices.js dropdowns for Family/Type/Location open
             downward from fields that always have room below them here, so
             clipping in practice shouldn't come up (CLAUDE.md "Dialog /
             modal pattern"). -->
        <div class="custom-scrollbar" style="flex: 1 1 400px; min-width: 400px; padding-right: 6px; overflow-y: auto;">
          <!-- ---- Master Table (read-only reference) ---- -->
          <div style="margin-bottom: 20px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc; overflow: hidden;">
            <table id="facestockMastersRef" style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 13px; font-weight: 600;">
              <colgroup>
                <col style="width: 15%;" />
                <col style="width: 15%;" />
                <col style="width: 15%;" />
                <col style="width: 18%;" />
                <col style="width: 12%;" />
                <col style="width: 18%;" />
              </colgroup>
              <tbody style="color: #0f172a;">
                <tr><td colspan="6" style="padding: 12px; text-align: center; color: #64748b;">Select a master to inward</td></tr>
              </tbody>
            </table>
          </div>

          <!-- Family/Type/GSM/Micron/Vendor/Make/Vendor SKU Code -- every
               field Facestock Master itself carries -- are smart-filtered
               against it (see GET /sachiko/facestockstock/filter-specs):
               picking one narrows the others to combinations that actually
               exist in the master catalog, same "narrow as you pick" pattern
               as Tape Stock inward and the Label Stock Binding spec pickers. -->
          <h3 style="margin: 0 0 16px 0; font-size: 0.9rem; font-weight: 600; color: #044a78; text-transform: uppercase; letter-spacing: 0.03em;">Inward Details</h3>

          <div class="dialog-field-row" style="grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr; gap: 10px; margin-bottom: 16px;">
            <div>
              <label class="dialog-field-label" for="addLocationSelect">Location</label>
              <select id="addLocationSelect"></select>
            </div>
            <div>
              <label class="dialog-field-label" for="addDateInput">Date</label>
              <input type="date" id="addDateInput" class="form-control premium-input" />
            </div>
            <div>
              <label class="dialog-field-label" for="addInvoiceNoInput">Invoice No</label>
              <input type="text" id="addInvoiceNoInput" class="form-control premium-input" placeholder="Invoice no" />
            </div>
            <div>
              <label class="dialog-field-label" for="addRateInput">Rate/Kg</label>
              <input type="number" id="addRateInput" class="form-control premium-input" placeholder="Rate" min="0" step="any" />
            </div>
            <div>
              <label class="dialog-field-label" for="addTotalKgInput">Total Kg</label>
              <input type="number" id="addTotalKgInput" class="form-control premium-input" placeholder="Total kg" min="0" step="any" />
            </div>
            <div>
              <label class="dialog-field-label" for="addRollCountInput">No of Rolls</label>
              <input type="number" id="addRollCountInput" class="form-control premium-input" min="1" max="100" step="1" value="1" />
            </div>
          </div>

          <label class="dialog-field-label" for="addRemarksInput">Remarks</label>
          <input type="text" id="addRemarksInput" class="form-control premium-input" placeholder="Optional remarks" />
        </div>

        <!-- ---- Right: one card per physical reel ---- -->
        <div style="flex: 1 1 auto; min-width: 0; max-width: 350px; display: flex; flex-direction: column;">
          <div class="dialog-section-label"><span>Rolls</span></div>
          <div id="addRollsContainer" class="custom-scrollbar" style="flex: 1 1 auto; min-height: 0; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); align-content: start; gap: 14px; padding-right: 6px;"></div>
        </div>
      </div>

      <div id="addFacestockError" class="dialog-error"></div>
      <div class="dialog-actions" style="flex: 0 0 auto;">
        <button class="logout-btn" type="button" onclick="closeAddDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="addSubmitBtn" onclick="submitAdd()">Save Reels</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ EDIT FACESTOCK REEL DIALOG (fix a reel missing its Invoice No, or any other field) ============ -->
<div class="logout-modal" id="editRollDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="editRollDialogTitle"
    style="width: min(520px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="editRollDialogTitle">Edit Facestock Reel</h2>
      <button class="dialog-close-btn" type="button" onclick="closeEditRollDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <div style="margin-bottom: 16px; padding: 10px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 13px; font-weight: 600; color: #044a78;" id="editRollSpecSummary"></div>

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="editLocationSelect">Location</label>
          <select id="editLocationSelect"></select>
        </div>
        <div>
          <label class="dialog-field-label" for="editDateInput">Date</label>
          <input type="date" id="editDateInput" class="form-control premium-input" />
        </div>
      </div>

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="editInvoiceNoInput">Invoice No</label>
          <input type="text" id="editInvoiceNoInput" class="form-control premium-input" placeholder="Enter invoice no" />
        </div>
        <div>
          <label class="dialog-field-label" for="editRateInput">Rate/Kg</label>
          <input type="number" id="editRateInput" class="form-control premium-input" placeholder="Enter rate" min="0" step="any" />
        </div>
      </div>

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="editVendorRollIdInput">Vendor Roll ID</label>
          <input type="text" id="editVendorRollIdInput" class="form-control premium-input" placeholder="Vendor's own roll no" />
        </div>
        <div>
          <label class="dialog-field-label" for="editKgInput">Kg</label>
          <input type="number" id="editKgInput" class="form-control premium-input" placeholder="Enter Kg" min="0" step="any" />
        </div>
      </div>

      <label class="dialog-field-label" for="editRemarksInput">Remarks</label>
      <input type="text" id="editRemarksInput" class="form-control premium-input" placeholder="Optional remarks" />

      <div id="editRollError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeEditRollDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="editRollSubmitBtn" onclick="submitEditRoll()">Save Changes</button>
      </div>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="locations-data" type="application/json"><%- safeJson(locations) %></script>
<script id="facestock-specs-data" type="application/json"><%- safeJson({ families, types, sizes, gsms, microns, vendors, makes, vendorSkuCodes }) %></script>
<script id="facestock-masters-data" type="application/json"><%- safeJson(masters) %></script>
<script>
  const locationsData = JSON.parse(document.getElementById("locations-data").textContent);
  const facestockSpecsData = JSON.parse(document.getElementById("facestock-specs-data").textContent);
  const mastersData = JSON.parse(document.getElementById("facestock-masters-data").textContent);

  function locationOptionsHtml(selectedName) {
    return locationsData
      .map((l) => `<option value="${l.locationName}" ${l.locationName === selectedName ? "selected" : ""}>${l.locationName}</option>`)
      .join("");
  }

  // Rebuilds a smart-filtered select's full (unfiltered) option list -- used
  // to reset the Add dialog's Family/Type/GSM/Micron/Make/Vendor SKU Code
  // pickers back to every Facestock Master value each time the dialog is
  // (re)opened, since filterAddSpecs narrows them in place while it's open.
  function specOptionsHtml(values, noneLabel, noneDisabled) {
    const noneOption = `<option value="" ${noneDisabled ? "disabled selected hidden" : ""}>${noneLabel}</option>`;
    return noneOption + values.map((v) => `<option value="${v}">${v}</option>`).join("");
  }

  // Same, for the Vendor Name picker -- its options are {vendorId, vendorName}
  // pairs, not plain scalars, so it needs its own value/label mapping.
  function vendorOptionsHtml(vendors) {
    return `<option value="">— None —</option>` + vendors.map((v) => `<option value="${v.vendorId}">${v.vendorName}</option>`).join("");
  }

  let addFamilyChoices = null, addTypeChoices = null, addSizeChoices = null, addGsmChoices = null, addMicronChoices = null;
  let addVendorChoices = null, addMakeChoices = null, addVendorSkuCodeChoices = null, addLocationChoices = null;

  // ---- Add (inward) dialog: smart filter for Family/Type/GSM/Micron/
  // Vendor/Make/Vendor SKU Code ---- Narrows each field's options to
  // combinations that actually exist in Facestock Master as the other
  // fields are picked -- same pattern as Tape Stock inward
  // (routes/stock/tapeStock.js) and the Label Stock Binding spec pickers
  // (routes/sachiko/labelStockBinding.js).
  const addSpecFields = [
    "addFamilySelect", "addTypeSelect", "addSizeSelect", "addGsmSelect", "addMicronSelect",
    "addVendorSelect", "addMakeSelect", "addVendorSkuCodeSelect",
  ];
  const addSpecFieldToKey = {
    addFamilySelect: "family",
    addTypeSelect: "type",
    addSizeSelect: "size",
    addGsmSelect: "gsm",
    addMicronSelect: "micron",
    addVendorSelect: "vendorId",
    addMakeSelect: "make",
    addVendorSkuCodeSelect: "vendorSkuCode",
  };
  const addSpecFieldToDataKey = {
    addFamilySelect: "families",
    addTypeSelect: "types",
    addSizeSelect: "sizes",
    addGsmSelect: "gsms",
    addMicronSelect: "microns",
    addVendorSelect: "vendors",
    addMakeSelect: "makes",
    addVendorSkuCodeSelect: "vendorSkuCodes",
  };
  // Vendor's options are {vendorId, vendorName} pairs; every other field's
  // are plain scalars -- this is the one place that difference matters.
  const addSpecFieldToChoice = {
    addVendorSelect: (v) => ({ value: v.vendorId, label: v.vendorName }),
  };
  function toChoiceOption(fieldId, value, currentValue) {
    const mapper = addSpecFieldToChoice[fieldId] || ((v) => ({ value: String(v), label: String(v) }));
    const { value: val, label } = mapper(value);
    return { value: val, label, selected: val === currentValue };
  }
  // Family/GSM/Micron/Vendor/Make/Vendor SKU Code are all optional on a
  // stock reel, so their reset choice is a real selectable "— None —";
  // Type is required, so it stays a disabled placeholder like the rest of
  // this dialog's required selects.
  const addSpecFieldPlaceholder = {
    addFamilySelect: { label: "— None —", disabled: false },
    addTypeSelect: { label: "Select type", disabled: true },
    addSizeSelect: { label: "— None —", disabled: false },
    addGsmSelect: { label: "— None —", disabled: false },
    addMicronSelect: { label: "— None —", disabled: false },
    addVendorSelect: { label: "— None —", disabled: false },
    addMakeSelect: { label: "— None —", disabled: false },
    addVendorSkuCodeSelect: { label: "— None —", disabled: false },
  };
  function addSpecChoicesInstance(id) {
    if (id === "addFamilySelect") return addFamilyChoices;
    if (id === "addTypeSelect") return addTypeChoices;
    if (id === "addSizeSelect") return addSizeChoices;
    if (id === "addGsmSelect") return addGsmChoices;
    if (id === "addMicronSelect") return addMicronChoices;
    if (id === "addVendorSelect") return addVendorChoices;
    if (id === "addMakeSelect") return addMakeChoices;
    if (id === "addVendorSkuCodeSelect") return addVendorSkuCodeChoices;
    return null;
  }

  async function filterAddSpecs(changedFieldId) {
    const params = new URLSearchParams();
    addSpecFields.forEach((id) => {
      const el = document.getElementById(id);
      if (el && el.value) params.set(addSpecFieldToKey[id], el.value);
    });

    try {
      const res = await fetch(`/sachiko/facestockstock/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];

      addSpecFields.forEach((id) => {
        if (id === changedFieldId) return;
        const choicesInstance = addSpecChoicesInstance(id);
        if (!choicesInstance) return;

        const filteredValues = data[addSpecFieldToDataKey[id]] || [];
        const currentValue = document.getElementById(id)?.value || "";

        const newChoices = filteredValues.map((v) => toChoiceOption(id, v, currentValue));

        if (filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        const ph = addSpecFieldPlaceholder[id];
        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: ph.label, disabled: ph.disabled, selected: !newChoices.some((c) => c.selected) }, ...newChoices],
          "value", "label", true
        );
      });

      if (autoSelected.length > 0) await filterAddSpecs(autoSelected[0]);
    } catch (err) {
      console.error("Facestock filter specs error:", err);
    }
  }

  addSpecFields.forEach((id) => {
    document.getElementById(id)?.addEventListener("change", () => filterAddSpecs(id));
  });

  // Truncates a long cell value with an ellipsis (title attribute carries
  // the full text as a hover tooltip) -- used for free-text fields like
  // Vendor Name that can run longer than the column is wide.
  function ellipsisFormatter(cell) {
    const value = cell.getValue();
    if (!value) return "—";
    cell.getElement().style.cssText += "overflow:hidden;text-overflow:ellipsis;white-space:nowrap;";
    cell.getElement().title = value;
    return value;
  }

  // ---- Helpers ----
  function openModal(id) {
    const d = document.getElementById(id);
    d.classList.add("show");
    d.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const d = document.getElementById(id);
    d.classList.remove("show");
    d.setAttribute("aria-hidden", "true");
  }
  function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.style.display = "block";
  }
  function hideError(elId) {
    document.getElementById(elId).style.display = "none";
  }
  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.disabled = loading;
    btn.style.opacity = loading ? "0.7" : "";
  }

  ["addDialog", "poDialog", "editRollDialog"].forEach(id => {
    document.getElementById(id).addEventListener("click", function (e) {
      if (e.target === this) closeModal(id);
    });
  });

  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    ["addDialog", "poDialog", "editRollDialog"].forEach(id => {
      if (document.getElementById(id).classList.contains("show")) closeModal(id);
    });
  });

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[c]);
  }

  function formatRollDate(value) {
    if (!value) return "—";
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? "—" : d.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
  }

  const fmt = (n) => (n === null || n === undefined ? "—" : Number(n).toLocaleString("en-IN"));

  // Looks a reel's own Facestock Master back up by scanning mastersData's own
  // rolls arrays, instead of Tabulator's row.getTreeParent() -- more direct
  // for finding the spec (family/vendor/etc) a reel's Edit dialog summary
  // needs, and avoids depending on the tree row's parent link still being
  // intact after the row's own re-renders.
  function findMasterForRoll(rollId) {
    return mastersData.find((m) => (m.rolls || []).some((r) => r._id === rollId)) || {};
  }

  // Flattens each master into Tabulator's dataTree shape: one row per
  // Facestock Master, with the individual FacestockStock reels behind its
  // stock count (see routes/stock/facestockStock.js's loadMastersWithStock)
  // as _children rows -- same "Rolls" dropdown pattern as FAIRTECH's Paper
  // Re-Order page (paperReorder.ejs). A master with no reels still gets a
  // one-line placeholder child so its tree toggle has something to open onto
  // (Tabulator draws the toggle for any array, regardless of length).
  function buildMastersTreeData(masters) {
    return masters.map((m) => {
      const rolls = Array.isArray(m.rolls) ? m.rolls : [];
      return {
        ...m,
        isParent: true,
        _children: rolls.length ? rolls.map((r) => ({ ...r, isParent: false })) : [{ isParent: false, noRolls: true }],
      };
    });
  }

  // ---- Masters & Reorder table ----
  const mastersTable = new Tabulator("#facestock-masters-table", {
    data: buildMastersTreeData(mastersData),
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No facestock masters added yet.",
    dataTree: true,
    dataTreeStartExpanded: false,
    dataTreeChildField: "_children",
    // Child (reel) rows don't carry a master's own values -- scope header
    // filtering to parent rows only, same reasoning as paperReorder.ejs, so a
    // matching parent's reels still display in full under an active filter.
    dataTreeFilter: false,
    dataTreeElementColumn: "_toggle",
    // Reel rows carry free-text identity (Roll ID, Vendor Roll ID, Remarks...)
    // that doesn't fit a fixed column width -- hide every per-column cell on
    // those rows and replace them with one spanning detail bar instead,
    // exactly like paperReorder.ejs's order rows.
    rowFormatter: (row) => {
      const data = row.getData();
      if (data.isParent) return;
      const el = row.getElement();
      if (el.querySelector(".roll-detail-span")) return;
      const missingInvoice = !data.noRolls && !data.invoiceNo;
      el.style.backgroundColor = missingInvoice ? "#fef2f2" : "#f8fafc";
      el.style.borderTop = missingInvoice ? "1px solid #fecaca" : "1px solid #e6eaf2";
      el.classList.add("roll-detail-row");
      if (missingInvoice) el.classList.add("roll-missing-invoice");
      const bar = document.createElement("div");
      bar.className = "roll-detail-span";
      bar.style.cssText = "flex:1; display:flex; align-items:center; flex-wrap:wrap; gap:8px; padding:6px 12px; color:#4b5563; font-size:13px;";
      if (data.noRolls) {
        bar.innerHTML = `<span style="color:#94a3b8; font-style:italic;">No reels in stock for this spec.</span>`;
      } else {
        const parts = [
          `↳ <b style="color:#1f2a44;">${escapeHtml(data.rollId || "—")}</b>`,
          data.vendorRollId ? `Vendor Roll ID: ${escapeHtml(data.vendorRollId)}` : "",
          `Kg ${fmt(data.reelMtrs)}`,
          data.location ? escapeHtml(data.location) : "",
          data.rate != null ? `Rate ₹${fmt(data.rate)}` : "",
          data.invoiceNo ? `Invoice ${escapeHtml(data.invoiceNo)}` : `<span style="color:#dc2626; font-weight:700;">No Invoice</span>`,
          `Date ${formatRollDate(data.inwardDate || data.createdAt)}`,
          data.remarks ? escapeHtml(data.remarks) : "",
        ].filter(Boolean);
        bar.innerHTML = parts.map((p, i) => (i === 0 ? p : `<span>${p}</span>`)).join('<span style="color:#334155; font-size:16px; font-weight:700; line-height:1;">&middot;</span>');
        const editBtn = document.createElement("button");
        editBtn.type = "button";
        editBtn.className = data.invoiceNo ? "roll-edit-btn has-invoice" : "roll-edit-btn";
        editBtn.innerHTML = '<i class="fa-solid fa-pen"></i> Edit';
        editBtn.addEventListener("click", () => openEditRollDialog(data, findMasterForRoll(data._id)));
        bar.insertBefore(editBtn, bar.firstChild);
      }
      el.appendChild(bar);
    },
    columns: [
      { title: "", field: "_toggle", width: 40, hozAlign: "center", headerSort: false },
      // getPosition(true) is the row's rank among currently sorted/filtered
      // rows, re-evaluated on every redraw -- stays correct after sorting or
      // filtering instead of a static index frozen at load time. Reel (child)
      // rows don't get their own number, same as every other column here.
      { title: "Sr. No.", field: "_srNo", width: 60, hozAlign: "center", headerHozAlign: "center", headerSort: false, headerFilter: false,
        formatter: (cell) => (cell.getRow().getData().isParent ? cell.getRow().getPosition(true) : "") },
      {
        title: "Inward",
        width: 110,
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isParent) return "";
          const btn = document.createElement("button");
          btn.className = "add-stock-btn";
          btn.title = "Add stock reels for this spec";
          btn.innerHTML = '<i class="fa-solid fa-plus"></i> Add';
          btn.addEventListener("click", () => openAddDialog(row));
          return btn;
        },
      },
      { title: "SKU ID", field: "skuId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150 },
      { title: "Vendor Name", field: "vendorName", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150, maxWidth: 220, formatter: ellipsisFormatter },
      { title: "Vendor SKU Code", field: "vendorSkuCode", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130, formatter: (cell) => cell.getValue() || "—" },
      { title: "Family", field: "family", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130, formatter: (cell) => cell.getValue() || "—" },
      { title: "Type", field: "type", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110 },
      { title: "Make", field: "make", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 120, formatter: (cell) => cell.getValue() || "—" },
      { title: "Size", field: "size", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, formatter: (cell) => cell.getValue() || "—" },
      { title: "GSM", field: "gsm", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 80, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Micron", field: "micron", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 80, formatter: (cell) => cell.getValue() ?? "—" },
      {
        title: "Stock (Kg)",
        field: "currentStock",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 150,
        formatter: (cell) => String(cell.getValue() || 0),
      },
      {
        title: "Stock (Rolls)",
        field: "rollCount",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 130,
        formatter: (cell) => (cell.getRow().getData().isParent ? (cell.getValue() || 0) : ""),
      },
      {
        title: "Allotted (Kg)",
        field: "allotted",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 130,
        headerTooltip: "Kg committed to WIP (assigned to a machine, not-yet-produced) Label Stock orders needing this spec -- including material already laminated into a Deckle, which has left Stock.",
        formatter: (cell) => {
          if (!cell.getRow().getData().isParent) return "";
          const value = cell.getValue() || 0;
          if (!value) return "—";
          // Reads as the shopfloor says it: "1000 kg, 1 roll allotted".
          const rolls = cell.getRow().getData().allottedRolls || 0;
          const rollPart = rolls
            ? ` <span style="font-size:11px; font-weight:600; color:#b45309;">(${rolls} roll${rolls === 1 ? "" : "s"})</span>`
            : "";
          return `<span style="font-weight:700; color:#92400e;">${value}</span>${rollPart}`;
        },
      },
      {
        title: "Available (Kg)",
        field: "available",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 130,
        headerTooltip: "What's actually free to commit: Stock (Kg) minus the Allotted kg still waiting to be drawn. Material already laminated into a Deckle has left Stock, so it isn't subtracted a second time.",
        formatter: (cell) => {
          if (!cell.getRow().getData().isParent) return "";
          const value = cell.getValue() || 0;
          const color = value < 0 ? "#dc2626" : "#15803d";
          return `<span style="font-weight:800; color:${color};">${value}</span>`;
        },
      },
      {
        title: "Shortage",
        field: "shortage",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        hozAlign: "center",
        minWidth: 110,
        formatter: (cell) => (cell.getRow().getData().isParent ? `<span style="font-weight:800; color:#dc2626;">${cell.getValue() || 0}</span>` : ""),
      },
      { title: "MSQ", field: "msq", headerFilter: "input", headerFilterPlaceholder: "Search", hozAlign: "center", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      {
        title: "Purchase Order",
        width: 150,
        hozAlign: "center",
        headerSort: false,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (!row.isParent) return "";
          if (row.hasActivePO) return `<span class="po-pending-badge">PO Pending</span>`;
          const btn = document.createElement("button");
          btn.className = "po-action-btn";
          btn.textContent = "Create PO";
          btn.addEventListener("click", () => openPoDialog(row));
          return btn;
        },
      },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs). Subscribing via .on() is
  // the only way it actually fires. Reads straight off the rendered DOM
  // rather than Tabulator's row APIs (getRow().getPosition()/getRows("active")
  // were both observed to go stale after a sort) -- whatever master rows
  // are actually on screen, top to bottom, get renumbered 1..n every time
  // the table redraws. Reel (child) rows are marked ".roll-detail-row" by
  // rowFormatter above and skipped, same as every other master-only column.
  mastersTable.on("renderComplete", function () {
    document.querySelectorAll("#facestock-masters-table .tabulator-row:not(.roll-detail-row)").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  // ---- Create Purchase Order dialog ----
  let poLocationChoices = null;
  let poMasterId = null;

  function openPoDialog(row) {
    poMasterId = row._id;
    document.getElementById("poSkuDisplay").value = row.skuId;
    document.getElementById("poVendorDisplay").value = row.vendorName || "—";
    document.getElementById("poQtyInput").value = row.shortage || "";
    document.getElementById("poNumberInput").value = "";
    document.getElementById("poRemarksInput").value = "";

    const inSevenDays = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
    document.getElementById("poDateInput").value = inSevenDays.toISOString().slice(0, 10);

    if (poLocationChoices) { poLocationChoices.destroy(); poLocationChoices = null; }
    const locSel = document.getElementById("poLocationSelect");
    locSel.innerHTML = locationOptionsHtml("");
    poLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    hideError("poError");
    openModal("poDialog");
  }
  function closePoDialog() {
    closeModal("poDialog");
    poMasterId = null;
  }

  async function submitPo() {
    const quantity = document.getElementById("poQtyInput").value;
    const poNumber = document.getElementById("poNumberInput").value.trim();
    const userLocation = document.getElementById("poLocationSelect").value;
    const estimatedDate = document.getElementById("poDateInput").value;
    if (!quantity || Number(quantity) <= 0) return showError("poError", "Quantity is required.");
    if (!poNumber) return showError("poError", "PO Number is required.");
    if (!userLocation) return showError("poError", "Delivery location is required.");
    if (!poMasterId) return;

    hideError("poError");
    setLoading("poSubmitBtn", true);
    try {
      const res = await fetch("/sachiko/facestockstock/purchase-order", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          masterId: poMasterId,
          quantity,
          poNumber,
          estimatedDate,
          userLocation,
          remarks: document.getElementById("poRemarksInput").value.trim(),
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/sachiko/purchase/pending";
      } else {
        showError("poError", data.message || "Failed to create Purchase Order.");
      }
    } catch {
      showError("poError", "Server error. Please try again.");
    } finally {
      setLoading("poSubmitBtn", false);
    }
  }

  // ---- ADD (batch inward) ----

  // Row group markup for one physical reel of the batch's shared spec --
  // Roll ID is filled in after the fact by refreshRollIdPreviews(), never typed.
  function rollRowHtml(index, prev) {
    return `
      <div class="roll-row" data-index="${index}">
        <div class="roll-row-title">Roll ${index + 1}</div>
        <label class="dialog-field-label">Roll ID</label>
        <input type="text" class="form-control premium-input roll-id-preview" readonly style="margin-bottom: 10px; background: #f1f5f9;" />
        <label class="dialog-field-label">Vendor Roll ID</label>
        <input type="text" class="form-control premium-input roll-vendor-id" placeholder="Vendor's own roll no" value="${prev.vendorRollId || ""}" style="margin-bottom: 10px;" />
        <label class="dialog-field-label">Kg</label>
        <input type="number" class="form-control premium-input roll-mtrs" min="0" step="any" placeholder="Enter Kg" value="${prev.mtrs || ""}" />
      </div>`;
  }

  // Rebuilds the roll rows for the given count, keeping whatever the user
  // already typed into rows that are still present -- only rows past the
  // new count are dropped, and new rows are always appended at the end so an
  // existing row's index never shifts while it's on screen.
  function renderRollRows(count, preserveValues) {
    const container = document.getElementById("addRollsContainer");
    const existing = preserveValues
      ? Array.from(container.querySelectorAll(".roll-row")).map((row) => ({
          vendorRollId: row.querySelector(".roll-vendor-id").value,
          mtrs: row.querySelector(".roll-mtrs").value,
        }))
      : [];
    container.innerHTML = Array.from({ length: count }, (_, i) => rollRowHtml(i, existing[i] || {})).join("");
    refreshRollIdPreviews();
    updateBatchSummary();
  }

  // Live roll count / total mtrs shown in the dialog header as rows are
  // added/removed and Mtrs values are typed.
  function updateBatchSummary() {
    const rows = document.querySelectorAll("#addRollsContainer .roll-row");
    const totalMtrs = Array.from(rows).reduce((sum, row) => sum + (Number(row.querySelector(".roll-mtrs").value) || 0), 0);
    document.getElementById("summaryRollCount").textContent = rows.length;
    document.getElementById("summaryTotalMtrs").textContent = Number.isInteger(totalMtrs) ? totalMtrs : totalMtrs.toFixed(1);
  }
  document.getElementById("addRollsContainer").addEventListener("input", (e) => {
    if (e.target.classList.contains("roll-mtrs")) updateBatchSummary();
  });

  async function refreshRollIdPreviews() {
    const rows = document.querySelectorAll("#addRollsContainer .roll-row");
    if (!rows.length) return;
    try {
      const res = await fetch(`/sachiko/facestockstock/preview-roll-ids?count=${rows.length}`);
      const data = await res.json();
      const ids = data.rollIds || [];
      rows.forEach((row, i) => {
        row.querySelector(".roll-id-preview").value = ids[i] || "";
      });
    } catch {
      // Preview is cosmetic only -- the server assigns the real id on save.
    }
  }

  document.getElementById("addRollCountInput").addEventListener("change", function () {
    const count = Math.min(Math.max(parseInt(this.value, 10) || 1, 1), 100);
    this.value = count;
    renderRollRows(count, true);
  });

  // masterPrefill (optional): a row from the Masters & Reorder panel below --
  // when given, every spec field is pre-set to that master's own spec
  // instead of left blank, so "Add Stock" on a master row jumps straight to
  // entering roll rows rather than re-picking a spec the smart filters would
  // narrow down to anyway.
  let selectedFacestockMaster = null;

  function openAddDialog(masterPrefill) {
    selectedFacestockMaster = masterPrefill || {};

    // Populate masters table with selected master only - show ALL master data
    const tbody = document.getElementById("facestockMastersRef").querySelector("tbody");
    if (selectedFacestockMaster && selectedFacestockMaster.family) {
      const gsmMicron = selectedFacestockMaster.gsm != null ? `${selectedFacestockMaster.gsm} GSM` :
                        selectedFacestockMaster.micron != null ? `${selectedFacestockMaster.micron} Micron` : "—";
      tbody.innerHTML = `
        <tr style="border-bottom: 1px solid #e2e8f0;">
          <td style="padding: 10px; font-weight: 700; color: #044a78; border-right: 1px solid #e2e8f0;">Vendor</td>
          <td style="padding: 10px; color: #0f172a;" colspan="5">${selectedFacestockMaster.vendorName || "—"}</td>
        </tr>
        <tr style="border-bottom: 1px solid #e2e8f0;">
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Family</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Type</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Make</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">SKU</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px; border-right: 1px solid #e2e8f0;">Size</td>
          <td style="padding: 8px 10px; font-weight: 700; color: #044a78; font-size: 14px;">GSM/Micron</td>
        </tr>
        <tr>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedFacestockMaster.family || ""}">${selectedFacestockMaster.family || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedFacestockMaster.type || ""}">${selectedFacestockMaster.type || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedFacestockMaster.make || ""}">${selectedFacestockMaster.make || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedFacestockMaster.vendorSkuCode || ""}">${selectedFacestockMaster.vendorSkuCode || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; border-right: 1px solid #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${selectedFacestockMaster.size || ""}">${selectedFacestockMaster.size || "—"}</td>
          <td style="padding: 8px 10px; color: #0f172a; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${gsmMicron}">${gsmMicron}</td>
        </tr>
      `;
    } else {
      tbody.innerHTML = '<tr><td colspan="2" style="padding: 12px; text-align: center; color: #64748b;">Select a master to inward</td></tr>';
    }

    document.getElementById("addDateInput").value = new Date().toISOString().slice(0, 10);
    document.getElementById("addInvoiceNoInput").value = "";
    document.getElementById("addTotalKgInput").value = "";
    document.getElementById("addRateInput").value = "";
    document.getElementById("addRollCountInput").value = "1";
    document.getElementById("addRemarksInput").value = "";

    if (addLocationChoices) { addLocationChoices.destroy(); addLocationChoices = null; }
    const locSel = document.getElementById("addLocationSelect");
    locSel.innerHTML = locationOptionsHtml("");
    addLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    renderRollRows(1, false);

    hideError("addFacestockError");
    openModal("addDialog");
  }
  function closeAddDialog() {
    closeModal("addDialog");
  }

  async function submitAdd() {
    if (!selectedFacestockMaster || !selectedFacestockMaster._id) return showError("addFacestockError", "Please select a master to inward.");

    const location = document.getElementById("addLocationSelect").value;
    if (!location) return showError("addFacestockError", "Location is required.");

    const inwardDate = document.getElementById("addDateInput").value;
    if (!inwardDate) return showError("addFacestockError", "Date is required.");

    const totalKg = document.getElementById("addTotalKgInput").value;
    if (!totalKg || Number(totalKg) <= 0) return showError("addFacestockError", "Total Kg is required.");

    const rate = document.getElementById("addRateInput").value;
    if (!rate || Number(rate) <= 0) return showError("addFacestockError", "Rate is required.");

    const rollRows = Array.from(document.querySelectorAll("#addRollsContainer .roll-row"));
    const rolls = rollRows.map((row) => ({
      reelMtrs: row.querySelector(".roll-mtrs").value,
      vendorRollId: row.querySelector(".roll-vendor-id").value.trim(),
    }));
    const emptyIndex = rolls.findIndex((r) => !r.reelMtrs || Number(r.reelMtrs) <= 0);
    if (emptyIndex !== -1) return showError("addFacestockError", `Kg is required for roll ${emptyIndex + 1}.`);
    const emptyVendorRollIdIndex = rolls.findIndex((r) => !r.vendorRollId);
    if (emptyVendorRollIdIndex !== -1) return showError("addFacestockError", `Vendor Roll ID is required for roll ${emptyVendorRollIdIndex + 1}.`);

    hideError("addFacestockError");
    setLoading("addSubmitBtn", true);
    try {
      const res = await fetch("/sachiko/facestockstock/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          family: selectedFacestockMaster.family,
          type: selectedFacestockMaster.type,
          size: selectedFacestockMaster.size,
          gsm: selectedFacestockMaster.gsm,
          micron: selectedFacestockMaster.micron,
          vendorId: selectedFacestockMaster.vendorId,
          make: selectedFacestockMaster.make,
          vendorSkuCode: selectedFacestockMaster.vendorSkuCode,
          rate: document.getElementById("addRateInput").value,
          location,
          inwardDate,
          invoiceNo: document.getElementById("addInvoiceNoInput").value,
          remarks: document.getElementById("addRemarksInput").value,
          rolls,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/sachiko/facestockstock";
      } else {
        showError("addFacestockError", data.message || "Failed to add facestock stock.");
      }
    } catch {
      showError("addFacestockError", "Server error. Please try again.");
    } finally {
      setLoading("addSubmitBtn", false);
    }
  }

  // ---- EDIT (fix a single existing reel -- e.g. one missing its Invoice No,
  // flagged red by rowFormatter above) ----
  let editLocationChoices = null;
  let editingRollId = null;
  // The reel's parent master row (family/type/make/vendor/vendor SKU code/
  // size/gsm/micron) -- every reel under a master shares its spec exactly
  // (that's how it got grouped there; see facestockSpecKey in
  // routes/stock/facestockStock.js), so it's safe to source these straight
  // from the master and resubmit them unchanged rather than re-picking a
  // spec here, same as openAddDialog's masterPrefill.
  let editingRollSpec = null;

  function openEditRollDialog(reel, masterSpec) {
    editingRollId = reel._id;
    editingRollSpec = masterSpec || {};

    const specBits = [
      editingRollSpec.family, editingRollSpec.type, editingRollSpec.make,
      editingRollSpec.vendorName, editingRollSpec.vendorSkuCode,
      editingRollSpec.gsm != null ? `${editingRollSpec.gsm} GSM` : (editingRollSpec.micron != null ? `${editingRollSpec.micron} MIC` : null),
    ].filter(Boolean);
    document.getElementById("editRollSpecSummary").textContent = `${reel.rollId || ""} — ${specBits.join(" · ") || "—"}`;

    if (editLocationChoices) { editLocationChoices.destroy(); editLocationChoices = null; }
    const locSel = document.getElementById("editLocationSelect");
    locSel.innerHTML = locationOptionsHtml(reel.location || "");
    editLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    document.getElementById("editDateInput").value = reel.inwardDate ? new Date(reel.inwardDate).toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10);
    document.getElementById("editInvoiceNoInput").value = reel.invoiceNo || "";
    document.getElementById("editRateInput").value = reel.rate != null ? reel.rate : "";
    document.getElementById("editVendorRollIdInput").value = reel.vendorRollId || "";
    document.getElementById("editKgInput").value = reel.reelMtrs != null ? reel.reelMtrs : "";
    document.getElementById("editRemarksInput").value = reel.remarks || "";

    hideError("editRollError");
    openModal("editRollDialog");
  }
  function closeEditRollDialog() {
    closeModal("editRollDialog");
    editingRollId = null;
  }

  async function submitEditRoll() {
    if (!editingRollId) return;

    const location = document.getElementById("editLocationSelect").value;
    if (!location) return showError("editRollError", "Location is required.");

    const inwardDate = document.getElementById("editDateInput").value;
    if (!inwardDate) return showError("editRollError", "Date is required.");

    const rate = document.getElementById("editRateInput").value;
    if (!rate || Number(rate) <= 0) return showError("editRollError", "Rate is required.");

    const vendorRollId = document.getElementById("editVendorRollIdInput").value.trim();
    if (!vendorRollId) return showError("editRollError", "Vendor Roll ID is required.");

    const reelMtrs = document.getElementById("editKgInput").value;
    if (!reelMtrs || Number(reelMtrs) <= 0) return showError("editRollError", "Kg is required.");

    hideError("editRollError");
    setLoading("editRollSubmitBtn", true);
    try {
      const res = await fetch(`/sachiko/facestockstock/${editingRollId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          family: editingRollSpec.family,
          type: editingRollSpec.type,
          size: editingRollSpec.size,
          gsm: editingRollSpec.gsm,
          micron: editingRollSpec.micron,
          vendorId: editingRollSpec.vendorId,
          make: editingRollSpec.make,
          vendorSkuCode: editingRollSpec.vendorSkuCode,
          location,
          inwardDate,
          rate,
          invoiceNo: document.getElementById("editInvoiceNoInput").value,
          remarks: document.getElementById("editRemarksInput").value,
          reelMtrs,
          vendorRollId,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showError("editRollError", data.message || "Failed to update facestock reel.");
      }
    } catch {
      showError("editRollError", "Server error. Please try again.");
    } finally {
      setLoading("editRollSubmitBtn", false);
    }
  }
</script>
