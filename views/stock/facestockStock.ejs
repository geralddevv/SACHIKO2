<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    .header-action-btn {
      background-color: #f0f0f0;
      color: #044a78;
      padding: 2px 14px;
      font-size: 14px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: all 0.2s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .header-action-btn:hover {
      background-color: #e4e4e4;
    }
    #facestock-stock-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    .dialog-header {
      background: #044A78;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .dialog-header h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }
    .dialog-close-btn {
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      padding: 0 2px;
      opacity: 0.8;
      transition: opacity 0.15s;
    }
    .dialog-close-btn:hover {
      opacity: 1;
    }
    .dialog-body {
      padding: 24px;
    }
    .dialog-field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 8px;
    }
    .dialog-error {
      color: #ef4444;
      font-size: 12px;
      margin-top: 5px;
      display: none;
    }
    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }
    .dialog-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 12px;
    }

    /* Match Choices.js selects to the .premium-input look used by the rest
       of this dialog's fields. */
    .dialog-body .choices__inner {
      padding: 11px 14px !important;
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      background-color: #f8fafc !important;
      font-size: 14px !important;
      min-height: 0 !important;
      transition: all 0.2s ease !important;
    }
    .dialog-body .choices__list--single {
      padding: 0 !important;
    }
    .dialog-body .choices.is-focused .choices__inner,
    .dialog-body .choices.is-open .choices__inner {
      border-color: #044a78 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 4px rgba(4, 74, 120, 0.1) !important;
    }
    .dialog-body .choices[data-type*="select-one"]::after {
      display: block !important;
      content: "" !important;
      width: 12px !important;
      height: 8px !important;
      border-style: none !important;
      border-width: 0 !important;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
      background-repeat: no-repeat !important;
      background-size: contain !important;
      position: absolute !important;
      right: 14px !important;
      top: 50% !important;
      margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    .dialog-body .choices[data-type*="select-one"].is-open::after {
      transform: translateY(-50%) rotate(180deg) !important;
    }
    /* Dropdown list must render above the dialog overlay (see CLAUDE.md
       "Dialog / modal pattern" -- Choices.js in dialogs). */
    .dialog-body .choices__list--dropdown {
      border-radius: 10px !important;
      border: 1.5px solid #e2e8f0 !important;
      z-index: 99999 !important;
    }

    .dialog-section-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.03em;
      color: #044a78;
      text-transform: uppercase;
      margin: 0 0 10px;
      flex: 0 0 auto;
    }
    .roll-row {
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px 14px;
      background: #f8fafc;
    }
    .roll-row-title {
      font-size: 12px;
      font-weight: 700;
      color: #044a78;
      margin-bottom: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }
  </style>

  <div class="indi-head">
    <h1>Facestock Stock</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <button class="header-action-btn" onclick="openAddDialog()">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> Facestock Reel
      </button>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="facestock-stock-table" class="tabulator tabulator-modern"></div>
</div>

<!-- ============ ADD FACESTOCK DIALOG (batch inward, landscape) ============ -->
<div class="logout-modal" id="addDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="addDialogTitle"
    style="width: min(1180px, 94vw); height: min(680px, 85vh); padding: 0; border-radius: 14px; display: flex; flex-direction: column;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0; flex: 0 0 auto;">
      <div style="display: flex; align-items: center; gap: 20px;">
        <h2 id="addDialogTitle">Add Facestock Reels</h2>
        <div style="display: flex; align-items: center; gap: 16px; font-size: 13px; color: rgba(255, 255, 255, 0.8);">
          <span>Rolls: <strong id="summaryRollCount" style="color: #fff; font-size: 15px;">1</strong></span>
          <span>Total Mtrs: <strong id="summaryTotalMtrs" style="color: #fff; font-size: 15px;">0</strong></span>
        </div>
      </div>
      <button class="dialog-close-btn" type="button" onclick="closeAddDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; padding: 24px;">
      <div style="display: flex; gap: 28px; flex: 1 1 auto; min-height: 0;">

        <!-- ---- Left: shared spec for this batch ---- -->
        <!-- overflow-y: auto is a safety net only (see updateBatchSummary --
             this column's content is sized to fit without scrolling in the
             normal case); Choices.js dropdowns for Family/Type/Location open
             downward from fields that always have room below them here, so
             clipping in practice shouldn't come up (CLAUDE.md "Dialog /
             modal pattern"). -->
        <div class="custom-scrollbar" style="flex: 1 1 400px; min-width: 400px; padding-right: 6px; overflow-y: auto;">
          <!-- Family/Type/GSM/Micron/Vendor/Make/Vendor SKU Code -- every
               field Facestock Master itself carries -- are smart-filtered
               against it (see GET /sachiko/facestockstock/filter-specs):
               picking one narrows the others to combinations that actually
               exist in the master catalog, same "narrow as you pick" pattern
               as Tape Stock inward and the Label Stock Binding spec pickers. -->
          <div class="dialog-field-row">
            <div>
              <label class="dialog-field-label" for="addFamilySelect">Family</label>
              <select id="addFamilySelect">
                <option value="">— None —</option>
                <% families?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="dialog-field-label" for="addTypeSelect">Type</label>
              <select id="addTypeSelect">
                <option value="" disabled selected hidden>Select type</option>
                <% types?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="dialog-field-row" style="grid-template-columns: 1fr 1fr 1fr;">
            <div>
              <label class="dialog-field-label" for="addSizeSelect">Size</label>
              <select id="addSizeSelect">
                <option value="">— None —</option>
                <% sizes?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="dialog-field-label" for="addGsmSelect">GSM</label>
              <select id="addGsmSelect">
                <option value="">— None —</option>
                <% gsms?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="dialog-field-label" for="addMicronSelect">Micron</label>
              <select id="addMicronSelect">
                <option value="">— None —</option>
                <% microns?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="dialog-field-row">
            <div>
              <label class="dialog-field-label" for="addVendorSelect">Vendor Name</label>
              <select id="addVendorSelect">
                <option value="">— None —</option>
                <% vendors?.forEach(v => { %>
                <option value="<%= v.vendorId %>"><%= v.vendorName %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="dialog-field-label" for="addMakeSelect">Make</label>
              <select id="addMakeSelect">
                <option value="">— None —</option>
                <% makes?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="dialog-field-row">
            <div>
              <label class="dialog-field-label" for="addVendorSkuCodeSelect">Vendor SKU Code</label>
              <select id="addVendorSkuCodeSelect">
                <option value="">— None —</option>
                <% vendorSkuCodes?.forEach(v => { %>
                <option value="<%= v %>"><%= v %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="dialog-field-label" for="addRateInput">Rate</label>
              <input type="number" id="addRateInput" class="form-control premium-input" placeholder="Enter rate" min="0" step="any" />
            </div>
          </div>

          <div class="dialog-field-row">
            <div>
              <label class="dialog-field-label" for="addLocationSelect">Location</label>
              <select id="addLocationSelect"></select>
            </div>
            <div>
              <label class="dialog-field-label" for="addInvoiceNoInput">Invoice No</label>
              <input type="text" id="addInvoiceNoInput" class="form-control premium-input" placeholder="Enter invoice no" />
            </div>
          </div>

          <div class="dialog-field-row">
            <div>
              <label class="dialog-field-label" for="addRollCountInput">No of Rolls</label>
              <input type="number" id="addRollCountInput" class="form-control premium-input" min="1" max="100" step="1" value="1" />
            </div>
            <div></div>
          </div>

          <label class="dialog-field-label" for="addRemarksInput">Remarks</label>
          <input type="text" id="addRemarksInput" class="form-control premium-input" placeholder="Optional remarks" />
        </div>

        <!-- ---- Right: one card per physical reel ---- -->
        <div style="flex: 1 1 auto; min-width: 0; max-width: 600px; display: flex; flex-direction: column;">
          <div class="dialog-section-label"><span>Rolls</span></div>
          <div id="addRollsContainer" class="custom-scrollbar" style="flex: 1 1 auto; min-height: 0; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); align-content: start; gap: 14px; padding-right: 6px;"></div>
        </div>
      </div>

      <div id="addFacestockError" class="dialog-error"></div>
      <div class="dialog-actions" style="flex: 0 0 auto;">
        <button class="logout-btn" type="button" onclick="closeAddDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="addSubmitBtn" onclick="submitAdd()">Save Reels</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ EDIT FACESTOCK DIALOG ============ -->
<div class="logout-modal" id="editDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="editDialogTitle"
    style="width: min(600px, 95vw); padding: 0; border-radius: 14px;">
    <div class="dialog-header" style="border-radius: 14px 14px 0 0;">
      <h2 id="editDialogTitle">Edit Facestock Reel</h2>
      <button class="dialog-close-btn" type="button" onclick="closeEditDialog()" aria-label="Close">×</button>
    </div>
    <div class="dialog-body" style="border-radius: 0 0 14px 14px;">
      <label class="dialog-field-label" for="editRollIdDisplay">Roll ID</label>
      <input type="text" id="editRollIdDisplay" class="form-control premium-input" readonly style="margin-bottom: 16px; background: #f1f5f9;" />

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="editFamilySelect">Family</label>
          <select id="editFamilySelect">
            <option value="">— None —</option>
            <option value="CHROMO">CHROMO</option>
            <option value="CHROMO (D. R)">CHROMO (D. R)</option>
            <option value="CLEAR PP">CLEAR PP</option>
            <option value="DOUBLE RELEASE">DOUBLE RELEASE</option>
            <option value="DT">DT</option>
            <option value="DT. PP">DT. PP</option>
            <option value="GLOSSY PP">GLOSSY PP</option>
            <option value="GLOSSY PP PARTIAL">GLOSSY PP PARTIAL</option>
            <option value="INKJET MATT FILM">INKJET MATT FILM</option>
            <option value="MAPLITO">MAPLITO</option>
            <option value="MATT PP">MATT PP</option>
            <option value="MATT PP (HT)">MATT PP (HT)</option>
            <option value="MATT PP PARTIAL">MATT PP PARTIAL</option>
            <option value="PP">PP</option>
            <option value="REMOVABLE">REMOVABLE</option>
            <option value="SILVER VOID">SILVER VOID</option>
            <option value="SUPER HOTMELT">SUPER HOTMELT</option>
          </select>
        </div>
        <div>
          <label class="dialog-field-label" for="editTypeSelect">Type</label>
          <select id="editTypeSelect">
            <option value="" disabled hidden>Select type</option>
            <option value="CLEAR">CLEAR</option>
            <option value="GLOSSY">GLOSSY</option>
            <option value="MATT">MATT</option>
            <option value="SEMI GLOSSY">SEMI GLOSSY</option>
          </select>
        </div>
      </div>

      <div class="dialog-field-row" style="grid-template-columns: 1fr 1fr 1fr;">
        <div>
          <label class="dialog-field-label" for="editSizeInput">Size</label>
          <input type="text" id="editSizeInput" class="form-control premium-input" placeholder="Enter size" />
        </div>
        <div>
          <label class="dialog-field-label" for="editGsmInput">GSM</label>
          <input type="number" id="editGsmInput" class="form-control premium-input" placeholder="Enter GSM" min="0" step="any" />
        </div>
        <div>
          <label class="dialog-field-label" for="editMicronInput">Micron</label>
          <input type="number" id="editMicronInput" class="form-control premium-input" placeholder="Enter Micron" min="0" step="any" />
        </div>
      </div>

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="editVendorSelect">Vendor Name</label>
          <select id="editVendorSelect"></select>
        </div>
        <div>
          <label class="dialog-field-label" for="editMakeInput">Make</label>
          <input type="text" id="editMakeInput" class="form-control premium-input" placeholder="Enter make" />
        </div>
      </div>

      <label class="dialog-field-label" for="editVendorSkuCodeInput">Vendor SKU Code</label>
      <input type="text" id="editVendorSkuCodeInput" class="form-control premium-input" placeholder="Enter vendor SKU code" style="margin-bottom: 16px;" />

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="editMtrsInput">Mtrs</label>
          <input type="number" id="editMtrsInput" class="form-control premium-input" placeholder="Enter Mtrs" min="0" step="any" />
        </div>
        <div>
          <label class="dialog-field-label" for="editRateInput">Rate</label>
          <input type="number" id="editRateInput" class="form-control premium-input" placeholder="Enter rate" min="0" step="any" />
        </div>
      </div>

      <label class="dialog-field-label" for="editLocationSelect">Location</label>
      <select id="editLocationSelect" style="margin-bottom: 16px;"></select>

      <div class="dialog-field-row">
        <div>
          <label class="dialog-field-label" for="editVendorRollIdInput">Vendor Roll ID</label>
          <input type="text" id="editVendorRollIdInput" class="form-control premium-input" placeholder="Vendor's own roll no" />
        </div>
        <div>
          <label class="dialog-field-label" for="editInvoiceNoInput">Invoice No</label>
          <input type="text" id="editInvoiceNoInput" class="form-control premium-input" placeholder="Enter invoice no" />
        </div>
      </div>

      <label class="dialog-field-label" for="editRemarksInput">Remarks</label>
      <input type="text" id="editRemarksInput" class="form-control premium-input" placeholder="Optional remarks" />

      <div id="editFacestockError" class="dialog-error"></div>
      <div class="dialog-actions">
        <button class="logout-btn" type="button" onclick="closeEditDialog()">Cancel</button>
        <button class="logout-btn primary" type="button" id="editSubmitBtn" onclick="submitEdit()">Update Reel</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ DELETE CONFIRMATION DIALOG ============ -->
<div class="logout-modal" id="deleteDialog" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteDialogTitle"
    style="width: min(400px, 95vw);">
    <h2 class="logout-title" id="deleteDialogTitle">
      <i class="fa-solid fa-triangle-exclamation" style="color: #ef4444; margin-right: 8px;"></i>Delete Reel?
    </h2>
    <p class="logout-text">
      Are you sure you want to delete <strong id="deleteRollId"></strong>? This action cannot be undone.
    </p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" onclick="closeDeleteDialog()">Cancel</button>
      <button
        class="logout-btn"
        type="button"
        id="deleteConfirmBtn"
        onclick="submitDelete()"
        style="background: #ef4444; color: #fff; border-color: #ef4444;">
        Yes, Delete
      </button>
    </div>
  </div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<script id="stock-data" type="application/json"><%- safeJson(stock) %></script>
<script id="locations-data" type="application/json"><%- safeJson(locations) %></script>
<script id="facestock-specs-data" type="application/json"><%- safeJson({ families, types, sizes, gsms, microns, vendors, makes, vendorSkuCodes }) %></script>
<script>
  const stockData = JSON.parse(document.getElementById("stock-data").textContent);
  const locationsData = JSON.parse(document.getElementById("locations-data").textContent);
  const facestockSpecsData = JSON.parse(document.getElementById("facestock-specs-data").textContent);

  function locationOptionsHtml(selectedName) {
    return locationsData
      .map((l) => `<option value="${l.locationName}" ${l.locationName === selectedName ? "selected" : ""}>${l.locationName}</option>`)
      .join("");
  }

  // Rebuilds a smart-filtered select's full (unfiltered) option list -- used
  // to reset the Add dialog's Family/Type/GSM/Micron/Make/Vendor SKU Code
  // pickers back to every Facestock Master value each time the dialog is
  // (re)opened, since filterAddSpecs narrows them in place while it's open.
  function specOptionsHtml(values, noneLabel, noneDisabled) {
    const noneOption = `<option value="" ${noneDisabled ? "disabled selected hidden" : ""}>${noneLabel}</option>`;
    return noneOption + values.map((v) => `<option value="${v}">${v}</option>`).join("");
  }

  // Same, for the Vendor Name picker -- its options are {vendorId, vendorName}
  // pairs, not plain scalars, so it needs its own value/label mapping.
  function vendorOptionsHtml(vendors) {
    return `<option value="">— None —</option>` + vendors.map((v) => `<option value="${v.vendorId}">${v.vendorName}</option>`).join("");
  }

  let addFamilyChoices = null, addTypeChoices = null, addSizeChoices = null, addGsmChoices = null, addMicronChoices = null;
  let addVendorChoices = null, addMakeChoices = null, addVendorSkuCodeChoices = null, addLocationChoices = null;
  let editFamilyChoices = null, editTypeChoices = null, editVendorChoices = null, editLocationChoices = null;

  // Auto-calculate Micron from GSM (micron = gsm / density), same formula as
  // the Label Stock Form's facestock fields. Edit dialog only -- the Add
  // (inward) dialog's GSM/Micron are smart-filtered selects sourced from
  // Facestock Master instead (see filterAddSpecs below).
  const FACESTOCK_DENSITY = 0.92;
  function wireGsmMicron(gsmId, micronId) {
    const gsmInput = document.getElementById(gsmId);
    const micronInput = document.getElementById(micronId);
    gsmInput.addEventListener("input", () => {
      const gsm = Number(gsmInput.value);
      micronInput.value = gsmInput.value !== "" && Number.isFinite(gsm) ? (gsm / FACESTOCK_DENSITY).toFixed(1) : "";
    });
  }
  wireGsmMicron("editGsmInput", "editMicronInput");

  // ---- Add (inward) dialog: smart filter for Family/Type/GSM/Micron/
  // Vendor/Make/Vendor SKU Code ---- Narrows each field's options to
  // combinations that actually exist in Facestock Master as the other
  // fields are picked -- same pattern as Tape Stock inward
  // (routes/stock/tapeStock.js) and the Label Stock Binding spec pickers
  // (routes/sachiko/labelStockBinding.js).
  const addSpecFields = [
    "addFamilySelect", "addTypeSelect", "addSizeSelect", "addGsmSelect", "addMicronSelect",
    "addVendorSelect", "addMakeSelect", "addVendorSkuCodeSelect",
  ];
  const addSpecFieldToKey = {
    addFamilySelect: "family",
    addTypeSelect: "type",
    addSizeSelect: "size",
    addGsmSelect: "gsm",
    addMicronSelect: "micron",
    addVendorSelect: "vendorId",
    addMakeSelect: "make",
    addVendorSkuCodeSelect: "vendorSkuCode",
  };
  const addSpecFieldToDataKey = {
    addFamilySelect: "families",
    addTypeSelect: "types",
    addSizeSelect: "sizes",
    addGsmSelect: "gsms",
    addMicronSelect: "microns",
    addVendorSelect: "vendors",
    addMakeSelect: "makes",
    addVendorSkuCodeSelect: "vendorSkuCodes",
  };
  // Vendor's options are {vendorId, vendorName} pairs; every other field's
  // are plain scalars -- this is the one place that difference matters.
  const addSpecFieldToChoice = {
    addVendorSelect: (v) => ({ value: v.vendorId, label: v.vendorName }),
  };
  function toChoiceOption(fieldId, value, currentValue) {
    const mapper = addSpecFieldToChoice[fieldId] || ((v) => ({ value: String(v), label: String(v) }));
    const { value: val, label } = mapper(value);
    return { value: val, label, selected: val === currentValue };
  }
  // Family/GSM/Micron/Vendor/Make/Vendor SKU Code are all optional on a
  // stock reel, so their reset choice is a real selectable "— None —";
  // Type is required, so it stays a disabled placeholder like the rest of
  // this dialog's required selects.
  const addSpecFieldPlaceholder = {
    addFamilySelect: { label: "— None —", disabled: false },
    addTypeSelect: { label: "Select type", disabled: true },
    addSizeSelect: { label: "— None —", disabled: false },
    addGsmSelect: { label: "— None —", disabled: false },
    addMicronSelect: { label: "— None —", disabled: false },
    addVendorSelect: { label: "— None —", disabled: false },
    addMakeSelect: { label: "— None —", disabled: false },
    addVendorSkuCodeSelect: { label: "— None —", disabled: false },
  };
  function addSpecChoicesInstance(id) {
    if (id === "addFamilySelect") return addFamilyChoices;
    if (id === "addTypeSelect") return addTypeChoices;
    if (id === "addSizeSelect") return addSizeChoices;
    if (id === "addGsmSelect") return addGsmChoices;
    if (id === "addMicronSelect") return addMicronChoices;
    if (id === "addVendorSelect") return addVendorChoices;
    if (id === "addMakeSelect") return addMakeChoices;
    if (id === "addVendorSkuCodeSelect") return addVendorSkuCodeChoices;
    return null;
  }

  async function filterAddSpecs(changedFieldId) {
    const params = new URLSearchParams();
    addSpecFields.forEach((id) => {
      const el = document.getElementById(id);
      if (el && el.value) params.set(addSpecFieldToKey[id], el.value);
    });

    try {
      const res = await fetch(`/sachiko/facestockstock/filter-specs?${params}`);
      const data = await res.json();
      if (!data) return;

      const autoSelected = [];

      addSpecFields.forEach((id) => {
        if (id === changedFieldId) return;
        const choicesInstance = addSpecChoicesInstance(id);
        if (!choicesInstance) return;

        const filteredValues = data[addSpecFieldToDataKey[id]] || [];
        const currentValue = document.getElementById(id)?.value || "";

        const newChoices = filteredValues.map((v) => toChoiceOption(id, v, currentValue));

        if (filteredValues.length === 1 && !currentValue) {
          newChoices[0].selected = true;
          autoSelected.push(id);
        }

        const ph = addSpecFieldPlaceholder[id];
        choicesInstance.clearStore();
        choicesInstance.setChoices(
          [{ value: "", label: ph.label, disabled: ph.disabled, selected: !newChoices.some((c) => c.selected) }, ...newChoices],
          "value", "label", true
        );
      });

      if (autoSelected.length > 0) await filterAddSpecs(autoSelected[0]);
    } catch (err) {
      console.error("Facestock filter specs error:", err);
    }
  }

  addSpecFields.forEach((id) => {
    document.getElementById(id)?.addEventListener("change", () => filterAddSpecs(id));
  });

  // Truncates a long cell value with an ellipsis (title attribute carries
  // the full text as a hover tooltip) -- used for free-text fields like
  // Vendor Name that can run longer than the column is wide.
  function ellipsisFormatter(cell) {
    const value = cell.getValue();
    if (!value) return "—";
    cell.getElement().style.cssText += "overflow:hidden;text-overflow:ellipsis;white-space:nowrap;";
    cell.getElement().title = value;
    return value;
  }

  // ---- Table ----
  const table = new Tabulator("#facestock-stock-table", {
    data: stockData,
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No facestock stock added yet.",
    columns: [
      { title: "Roll ID", field: "rollId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150 },
      { title: "Family", field: "family", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 140, formatter: (cell) => cell.getValue() || "—" },
      { title: "Type", field: "type", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 120 },
      { title: "Size", field: "size", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110, formatter: (cell) => cell.getValue() || "—" },
      { title: "GSM", field: "gsm", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Micron", field: "micron", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Vendor Name", field: "vendorName", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150, maxWidth: 220, formatter: ellipsisFormatter },
      { title: "Make", field: "make", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 120, formatter: (cell) => cell.getValue() || "—" },
      { title: "Vendor SKU Code", field: "vendorSkuCode", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150, formatter: (cell) => cell.getValue() || "—" },
      { title: "Mtrs", field: "reelMtrs", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100 },
      { title: "Rate", field: "rate", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 90, formatter: (cell) => cell.getValue() ?? "—" },
      { title: "Location", field: "location", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130 },
      { title: "Vendor Roll ID", field: "vendorRollId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 140, formatter: (cell) => cell.getValue() || "—" },
      {
        title: "Actions",
        width: 110,
        hozAlign: "center",
        headerSort: false,
        formatter: function (cell) {
          const row = cell.getRow().getData();
          const wrap = document.createElement("div");
          wrap.style.cssText = "display:flex; gap:5px; justify-content:center;";

          const editBtn = document.createElement("button");
          editBtn.className = "loc-btn";
          editBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#e67e22;";
          editBtn.title = "Edit Reel";
          editBtn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
          editBtn.addEventListener("click", () => openEditDialog(row));

          const deleteBtn = document.createElement("button");
          deleteBtn.className = "loc-btn";
          deleteBtn.style.cssText = "padding:3px 8px;border:none;border-radius:4px;cursor:pointer;font-size:12px;color:#fff;background:#d9534f;";
          deleteBtn.title = "Delete Reel";
          deleteBtn.innerHTML = '<i class="fa-solid fa-trash"></i>';
          deleteBtn.addEventListener("click", () => openDeleteDialog(row._id, row.rollId));

          wrap.appendChild(editBtn);
          wrap.appendChild(deleteBtn);
          return wrap;
        },
      },
    ],
  });

  // ---- Helpers ----
  function openModal(id) {
    const d = document.getElementById(id);
    d.classList.add("show");
    d.setAttribute("aria-hidden", "false");
  }
  function closeModal(id) {
    const d = document.getElementById(id);
    d.classList.remove("show");
    d.setAttribute("aria-hidden", "true");
  }
  function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.style.display = "block";
  }
  function hideError(elId) {
    document.getElementById(elId).style.display = "none";
  }
  function setLoading(btnId, loading) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.disabled = loading;
    btn.style.opacity = loading ? "0.7" : "";
  }

  ["addDialog", "editDialog", "deleteDialog"].forEach(id => {
    document.getElementById(id).addEventListener("click", function (e) {
      if (e.target === this) closeModal(id);
    });
  });

  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    ["addDialog", "editDialog", "deleteDialog"].forEach(id => {
      if (document.getElementById(id).classList.contains("show")) closeModal(id);
    });
  });

  // ---- ADD (batch inward) ----

  // Row group markup for one physical reel of the batch's shared spec --
  // Roll ID is filled in after the fact by refreshRollIdPreviews(), never typed.
  function rollRowHtml(index, prev) {
    return `
      <div class="roll-row" data-index="${index}">
        <div class="roll-row-title">Roll ${index + 1}</div>
        <label class="dialog-field-label">Roll ID</label>
        <input type="text" class="form-control premium-input roll-id-preview" readonly style="margin-bottom: 10px; background: #f1f5f9;" />
        <label class="dialog-field-label">Vendor Roll ID</label>
        <input type="text" class="form-control premium-input roll-vendor-id" placeholder="Vendor's own roll no" value="${prev.vendorRollId || ""}" style="margin-bottom: 10px;" />
        <label class="dialog-field-label">Mtrs</label>
        <input type="number" class="form-control premium-input roll-mtrs" min="0" step="any" placeholder="Enter Mtrs" value="${prev.mtrs || ""}" />
      </div>`;
  }

  // Rebuilds the roll rows for the given count, keeping whatever the user
  // already typed into rows that are still present -- only rows past the
  // new count are dropped, and new rows are always appended at the end so an
  // existing row's index never shifts while it's on screen.
  function renderRollRows(count, preserveValues) {
    const container = document.getElementById("addRollsContainer");
    const existing = preserveValues
      ? Array.from(container.querySelectorAll(".roll-row")).map((row) => ({
          vendorRollId: row.querySelector(".roll-vendor-id").value,
          mtrs: row.querySelector(".roll-mtrs").value,
        }))
      : [];
    container.innerHTML = Array.from({ length: count }, (_, i) => rollRowHtml(i, existing[i] || {})).join("");
    refreshRollIdPreviews();
    updateBatchSummary();
  }

  // Live roll count / total mtrs shown in the dialog header as rows are
  // added/removed and Mtrs values are typed.
  function updateBatchSummary() {
    const rows = document.querySelectorAll("#addRollsContainer .roll-row");
    const totalMtrs = Array.from(rows).reduce((sum, row) => sum + (Number(row.querySelector(".roll-mtrs").value) || 0), 0);
    document.getElementById("summaryRollCount").textContent = rows.length;
    document.getElementById("summaryTotalMtrs").textContent = Number.isInteger(totalMtrs) ? totalMtrs : totalMtrs.toFixed(1);
  }
  document.getElementById("addRollsContainer").addEventListener("input", (e) => {
    if (e.target.classList.contains("roll-mtrs")) updateBatchSummary();
  });

  async function refreshRollIdPreviews() {
    const rows = document.querySelectorAll("#addRollsContainer .roll-row");
    if (!rows.length) return;
    try {
      const res = await fetch(`/sachiko/facestockstock/preview-roll-ids?count=${rows.length}`);
      const data = await res.json();
      const ids = data.rollIds || [];
      rows.forEach((row, i) => {
        row.querySelector(".roll-id-preview").value = ids[i] || "";
      });
    } catch {
      // Preview is cosmetic only -- the server assigns the real id on save.
    }
  }

  document.getElementById("addRollCountInput").addEventListener("change", function () {
    const count = Math.min(Math.max(parseInt(this.value, 10) || 1, 1), 100);
    this.value = count;
    renderRollRows(count, true);
  });

  function openAddDialog() {
    document.getElementById("addRateInput").value = "";
    document.getElementById("addInvoiceNoInput").value = "";
    document.getElementById("addRemarksInput").value = "";
    document.getElementById("addRollCountInput").value = "1";

    if (addFamilyChoices) { addFamilyChoices.destroy(); addFamilyChoices = null; }
    document.getElementById("addFamilySelect").innerHTML = specOptionsHtml(facestockSpecsData.families, "— None —", false);
    addFamilyChoices = new Choices("#addFamilySelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    if (addTypeChoices) { addTypeChoices.destroy(); addTypeChoices = null; }
    document.getElementById("addTypeSelect").innerHTML = specOptionsHtml(facestockSpecsData.types, "Select type", true);
    addTypeChoices = new Choices("#addTypeSelect", { searchEnabled: false, shouldSort: false, itemSelectText: "" });

    if (addSizeChoices) { addSizeChoices.destroy(); addSizeChoices = null; }
    document.getElementById("addSizeSelect").innerHTML = specOptionsHtml(facestockSpecsData.sizes, "— None —", false);
    addSizeChoices = new Choices("#addSizeSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    if (addGsmChoices) { addGsmChoices.destroy(); addGsmChoices = null; }
    document.getElementById("addGsmSelect").innerHTML = specOptionsHtml(facestockSpecsData.gsms, "— None —", false);
    addGsmChoices = new Choices("#addGsmSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    if (addMicronChoices) { addMicronChoices.destroy(); addMicronChoices = null; }
    document.getElementById("addMicronSelect").innerHTML = specOptionsHtml(facestockSpecsData.microns, "— None —", false);
    addMicronChoices = new Choices("#addMicronSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    if (addVendorChoices) { addVendorChoices.destroy(); addVendorChoices = null; }
    document.getElementById("addVendorSelect").innerHTML = vendorOptionsHtml(facestockSpecsData.vendors);
    addVendorChoices = new Choices("#addVendorSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    if (addMakeChoices) { addMakeChoices.destroy(); addMakeChoices = null; }
    document.getElementById("addMakeSelect").innerHTML = specOptionsHtml(facestockSpecsData.makes, "— None —", false);
    addMakeChoices = new Choices("#addMakeSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    if (addVendorSkuCodeChoices) { addVendorSkuCodeChoices.destroy(); addVendorSkuCodeChoices = null; }
    document.getElementById("addVendorSkuCodeSelect").innerHTML = specOptionsHtml(facestockSpecsData.vendorSkuCodes, "— None —", false);
    addVendorSkuCodeChoices = new Choices("#addVendorSkuCodeSelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    if (addLocationChoices) { addLocationChoices.destroy(); addLocationChoices = null; }
    const locSel = document.getElementById("addLocationSelect");
    locSel.innerHTML = locationOptionsHtml("");
    addLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    renderRollRows(1, false);

    hideError("addFacestockError");
    openModal("addDialog");
  }
  function closeAddDialog() {
    closeModal("addDialog");
  }

  async function submitAdd() {
    const type = document.getElementById("addTypeSelect").value;
    const location = document.getElementById("addLocationSelect").value;
    if (!type) return showError("addFacestockError", "Type is required.");
    if (!location) return showError("addFacestockError", "Location is required.");

    const rollRows = Array.from(document.querySelectorAll("#addRollsContainer .roll-row"));
    const rolls = rollRows.map((row) => ({
      reelMtrs: row.querySelector(".roll-mtrs").value,
      vendorRollId: row.querySelector(".roll-vendor-id").value,
    }));
    const emptyIndex = rolls.findIndex((r) => !r.reelMtrs || Number(r.reelMtrs) <= 0);
    if (emptyIndex !== -1) return showError("addFacestockError", `Mtrs is required for roll ${emptyIndex + 1}.`);

    hideError("addFacestockError");
    setLoading("addSubmitBtn", true);
    try {
      const res = await fetch("/sachiko/facestockstock/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          family: document.getElementById("addFamilySelect").value,
          type,
          size: document.getElementById("addSizeSelect").value,
          gsm: document.getElementById("addGsmSelect").value,
          micron: document.getElementById("addMicronSelect").value,
          vendorId: document.getElementById("addVendorSelect").value,
          make: document.getElementById("addMakeSelect").value,
          vendorSkuCode: document.getElementById("addVendorSkuCodeSelect").value,
          rate: document.getElementById("addRateInput").value,
          location,
          invoiceNo: document.getElementById("addInvoiceNoInput").value,
          remarks: document.getElementById("addRemarksInput").value,
          rolls,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || "/sachiko/facestockstock";
      } else {
        showError("addFacestockError", data.message || "Failed to add facestock stock.");
      }
    } catch {
      showError("addFacestockError", "Server error. Please try again.");
    } finally {
      setLoading("addSubmitBtn", false);
    }
  }

  // ---- EDIT ----
  let editId = null;

  function openEditDialog(row) {
    editId = row._id;
    document.getElementById("editRollIdDisplay").value = row.rollId;
    document.getElementById("editGsmInput").value = row.gsm ?? "";
    document.getElementById("editMicronInput").value = row.micron ?? "";
    document.getElementById("editMtrsInput").value = row.reelMtrs ?? "";
    document.getElementById("editRateInput").value = row.rate ?? "";
    document.getElementById("editVendorRollIdInput").value = row.vendorRollId || "";
    document.getElementById("editInvoiceNoInput").value = row.invoiceNo || "";
    document.getElementById("editRemarksInput").value = row.remarks || "";
    document.getElementById("editMakeInput").value = row.make || "";
    document.getElementById("editVendorSkuCodeInput").value = row.vendorSkuCode || "";
    document.getElementById("editSizeInput").value = row.size || "";

    if (editFamilyChoices) { editFamilyChoices.destroy(); editFamilyChoices = null; }
    document.getElementById("editFamilySelect").value = row.family || "";
    editFamilyChoices = new Choices("#editFamilySelect", { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    if (editTypeChoices) { editTypeChoices.destroy(); editTypeChoices = null; }
    document.getElementById("editTypeSelect").value = row.type || "";
    editTypeChoices = new Choices("#editTypeSelect", { searchEnabled: false, shouldSort: false, itemSelectText: "" });

    if (editVendorChoices) { editVendorChoices.destroy(); editVendorChoices = null; }
    const editVendorSel = document.getElementById("editVendorSelect");
    // A reel's saved vendor might not be in the current Facestock Master
    // vendor list (e.g. that master entry was since edited/removed) -- add
    // it as an extra option so editing this reel never silently drops it.
    const knownVendors = facestockSpecsData.vendors.some((v) => v.vendorId === row.vendorId)
      ? facestockSpecsData.vendors
      : row.vendorId
        ? [...facestockSpecsData.vendors, { vendorId: row.vendorId, vendorName: row.vendorName || row.vendorId }]
        : facestockSpecsData.vendors;
    editVendorSel.innerHTML = vendorOptionsHtml(knownVendors);
    editVendorSel.value = row.vendorId || "";
    editVendorChoices = new Choices(editVendorSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    if (editLocationChoices) { editLocationChoices.destroy(); editLocationChoices = null; }
    const locSel = document.getElementById("editLocationSelect");
    locSel.innerHTML = locationOptionsHtml(row.location || "");
    editLocationChoices = new Choices(locSel, { searchEnabled: true, shouldSort: false, itemSelectText: "" });

    hideError("editFacestockError");
    openModal("editDialog");
  }
  function closeEditDialog() {
    closeModal("editDialog");
    editId = null;
  }

  async function submitEdit() {
    const type = document.getElementById("editTypeSelect").value;
    const location = document.getElementById("editLocationSelect").value;
    const reelMtrs = document.getElementById("editMtrsInput").value;
    if (!type) return showError("editFacestockError", "Type is required.");
    if (!location) return showError("editFacestockError", "Location is required.");
    if (!reelMtrs || Number(reelMtrs) <= 0) return showError("editFacestockError", "Mtrs is required.");
    if (!editId) return;

    hideError("editFacestockError");
    setLoading("editSubmitBtn", true);
    try {
      const res = await fetch(`/sachiko/facestockstock/${editId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          family: document.getElementById("editFamilySelect").value,
          type,
          size: document.getElementById("editSizeInput").value,
          gsm: document.getElementById("editGsmInput").value,
          micron: document.getElementById("editMicronInput").value,
          vendorId: document.getElementById("editVendorSelect").value,
          make: document.getElementById("editMakeInput").value,
          vendorSkuCode: document.getElementById("editVendorSkuCodeInput").value,
          reelMtrs,
          rate: document.getElementById("editRateInput").value,
          location,
          vendorRollId: document.getElementById("editVendorRollIdInput").value,
          invoiceNo: document.getElementById("editInvoiceNoInput").value,
          remarks: document.getElementById("editRemarksInput").value,
        }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showError("editFacestockError", data.message || "Failed to update facestock stock.");
      }
    } catch {
      showError("editFacestockError", "Server error. Please try again.");
    } finally {
      setLoading("editSubmitBtn", false);
    }
  }

  // ---- DELETE ----
  let deleteId = null;

  function openDeleteDialog(id, rollId) {
    deleteId = id;
    document.getElementById("deleteRollId").textContent = rollId;
    openModal("deleteDialog");
  }
  function closeDeleteDialog() {
    closeModal("deleteDialog");
    deleteId = null;
  }

  async function submitDelete() {
    if (!deleteId) return;
    setLoading("deleteConfirmBtn", true);
    try {
      const res = await fetch(`/sachiko/facestockstock/${deleteId}`, { method: "DELETE" });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        closeDeleteDialog();
        alert(data.message || "Failed to delete reel.");
      }
    } catch {
      closeDeleteDialog();
      alert("Error deleting reel.");
    } finally {
      setLoading("deleteConfirmBtn", false);
    }
  }
</script>
