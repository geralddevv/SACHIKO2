<% layout('/layout/boilerplate') %>

<!-- Tabulator CSS -->
<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #facestock-used-table {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }
    .fsu-status-badge {
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      white-space: nowrap;
      display: inline-block;
    }
  </style>

  <!-- Common to all three raw-material pools (Facestock/Adhesive/Release
       Liner), not facestock-only -- the Item column below filters down to
       one. One row per usage event (a reel drawn on by two different jobs
       over time shows up as two rows) -- see routes/stock/facestockStock.js's
       loadFacestockUsageRows for how USED (permanent, from a job card's
       Material Used dialog) vs LIVE (Start already punched on a still-open
       job, no Kg yet) are derived. Both are the same signal each pool's own
       stock page already carries at the reel level -- this just lists every
       one of them flat, across all three pools, without needing any
       dropdown opened first. -->
  <div class="indi-head">
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 14px;">
      <div style="display: flex; align-items: center; gap: 10px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.3); padding: 8px 16px; border-radius: 10px;">
        <i class="fa-solid fa-industry" style="font-size: 1.1rem; opacity: 0.9;"></i>
        <h1 style="margin: 0; letter-spacing: 0.02em;">Used Stock</h1>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="facestock-used-table" class="tabulator tabulator-modern"></div>
</div>

<script id="facestock-used-data" type="application/json"><%- safeJson(rows) %></script>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script>
  const usedRows = JSON.parse(document.getElementById("facestock-used-data").textContent || "[]");

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[c]);
  }

  function ellipsisFormatter(cell) {
    const value = cell.getValue();
    if (!value) return "—";
    cell.getElement().style.cssText += "overflow:hidden;text-overflow:ellipsis;white-space:nowrap;";
    cell.getElement().title = value;
    return value;
  }

  const fmtKg = (n) => {
    if (n === null || n === undefined) return "—";
    const value = Math.round(((Number(n) || 0) + Number.EPSILON) * 100) / 100;
    return value.toLocaleString("en-IN", { maximumFractionDigits: 2 });
  };

  function formatRowDate(value) {
    if (!value) return "—";
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? "—" : d.toLocaleString("en-IN", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });
  }

  const table = new Tabulator("#facestock-used-table", {
    data: usedRows,
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No raw material has been used or is currently in use.",
    initialSort: [{ column: "date", dir: "desc" }],
    columns: [
      {
        title: "Item", field: "item", width: 140, hozAlign: "center", headerHozAlign: "center",
        headerFilter: "list",
        headerFilterParams: { values: { "": "All", "Facestock": "Facestock", "Adhesive": "Adhesive", "Release Liner": "Release Liner" } },
        headerFilterFunc: "=",
        formatter: (cell) => `<b>${escapeHtml(cell.getValue() || "—")}</b>`,
      },
      {
        title: "Status", field: "status", width: 150, hozAlign: "center", headerHozAlign: "center",
        headerFilter: "list", headerFilterParams: { values: { "": "All", "USED": "USED", "LIVE": "LIVE" } },
        headerFilterFunc: "=",
        // A plain "USED" badge reads as "this reel is spent" -- misleading
        // for a row whose Kg Remaining is still above 0 (this job only drew
        // part of it; the rest is still on the shelf, usable elsewhere). Split
        // the badge on that instead of leaving it to Kg Remaining alone to
        // notice. LIVE rows have no remainingKg yet (nothing reported until
        // Save Production Entry), so they're never called partial.
        formatter: (cell) => {
          const row = cell.getRow().getData();
          if (row.status === "LIVE") return `<span class="fsu-status-badge" style="background:#ccfbf1;color:#0f766e;" title="Scanned and Start was just punched on a job card -- Kg used isn't reported until Save Production Entry.">IN USE NOW</span>`;
          if (row.remainingKg != null && row.remainingKg > 0) {
            return `<span class="fsu-status-badge" style="background:#fef3c7;color:#92400e;" title="This reel still has stock left -- only part of it was drawn for this job, the rest is still usable.">PARTIALLY USED</span>`;
          }
          return `<span class="fsu-status-badge" style="background:#e0f2fe;color:#075985;" title="Kg actually drawn off this reel via a job card's Material Used dialog -- fully consumed, nothing left on it.">USED</span>`;
        },
      },
      { title: "Roll/Drum ID", field: "rollId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 170,
        formatter: (cell) => `<b>${escapeHtml(cell.getValue() || "—")}</b>` },
      { title: "Type", field: "type", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110, formatter: (cell) => cell.getValue() || "—" },
      { title: "Make", field: "make", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 110, formatter: (cell) => cell.getValue() || "—" },
      { title: "Vendor Name", field: "vendorName", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150, maxWidth: 220, formatter: ellipsisFormatter },
      { title: "Vendor SKU Code", field: "vendorSkuCode", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130, formatter: (cell) => cell.getValue() || "—" },
      { title: "Location", field: "location", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 120, formatter: (cell) => cell.getValue() || "—" },
      {
        title: "Kg Used", field: "kgUsed", hozAlign: "center", minWidth: 110,
        formatter: (cell) => {
          const v = cell.getValue();
          return v === null || v === undefined ? `<span style="color:#94a3b8;">—</span>` : `<span style="font-weight:700;color:#075985;">${fmtKg(v)}</span>`;
        },
      },
      { title: "Kg Remaining", field: "remainingKg", hozAlign: "center", minWidth: 120, formatter: (cell) => fmtKg(cell.getValue()) },
      { title: "Lot No", field: "lotNo", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 140, formatter: (cell) => cell.getValue() || "—" },
      { title: "Product Code", field: "productCode", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 130, formatter: (cell) => cell.getValue() || "—" },
      { title: "Job Card ID", field: "jobCardId", headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 150, formatter: (cell) => cell.getValue() || "—" },
      { title: "When", field: "date", hozAlign: "center", minWidth: 170, formatter: (cell) => formatRowDate(cell.getValue()) },
    ],
  });

  document.querySelector(".table-spinner")?.remove();
</script>
