<!-- Link to boilerplate.ejs -->
<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #master-table { width: 100%; flex: 1 1 auto; min-height: 0; }
    @keyframes slPopIn {
      from { transform: scale(0.95); opacity: 0; }
      to   { transform: scale(1);    opacity: 1; }
    }
  </style>

  <div class="indi-head">
    <h1>SL Bindings</h1>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table" class="tabulator tabulator-modern"></div>
</div>

<!-- Tabulator JS -->
<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>

<form id="deleteBindingForm" method="POST" style="display:none;"></form>
<div class="logout-modal" id="deleteBindingModal" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteBindingTitle">
    <h2 class="logout-title" id="deleteBindingTitle">Remove binding?</h2>
    <p class="logout-text">This will permanently remove this SL binding.</p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" id="deleteBindingCancel">Cancel</button>
      <button class="logout-btn primary" type="button" id="deleteBindingConfirm">Remove</button>
    </div>
  </div>
</div>

<div class="logout-modal" id="statusBindingModal" aria-hidden="true">
  <div class="logout-dialog" role="dialog" aria-modal="true" aria-labelledby="statusBindingTitle">
    <h2 class="logout-title" id="statusBindingTitle">Change binding status?</h2>
    <p class="logout-text" id="statusBindingText">This will change the binding status.</p>
    <div class="logout-actions">
      <button class="logout-btn" type="button" id="statusBindingCancel">Cancel</button>
      <button class="logout-btn primary" type="button" id="statusBindingConfirm">OK</button>
    </div>
  </div>
</div>

<!-- View Modal -->
<div id="sl-view-modal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:10000;justify-content:center;align-items:center;padding:24px;backdrop-filter:blur(4px);">
  <div id="sl-view-body" style="background:#fff;border-radius:14px;overflow:hidden;width:min(480px,95vw);box-shadow:0 20px 50px rgba(4,74,120,0.2);animation:slPopIn 0.2s ease-out;"></div>
</div>

<script>
  const raw = <%- safeJson(jsonData) %>;

  const tableData = raw.map(binding => {
    const sl = binding.sl || {};
    const fsType   = sl.facestock?.facestockType    || "";
    const fsMicron = sl.facestock?.facestockMicron != null ? sl.facestock.facestockMicron + " MIC" : "";
    const adType   = sl.adhesive?.adhesiveType      || "";
    const rlType   = sl.releaseLiner?.releaseLinerType || "";
    const product  = [fsType, fsMicron, adType, rlType].filter(Boolean).join(" / ");

    return {
      _id: String(binding._id),
      productCode: sl.productCode || "",
      skuCode: sl.skuCode || "",
      product,
      fsFamily: sl.facestock?.facestockFamily || "",
      fsType: sl.facestock?.facestockType || "",
      fsGsm: sl.facestock?.facestockGsm ?? "",
      fsMicron: sl.facestock?.facestockMicron ?? "",
      adType: sl.adhesive?.adhesiveType || "",
      adGsm: sl.adhesive?.adhesiveGsm ?? "",
      rlType: sl.releaseLiner?.releaseLinerType || "",
      rlColor: sl.releaseLiner?.releaseLinerColor || "",
      rlGsm: sl.releaseLiner?.releaseLinerGsm ?? "",
      location: binding.location || "",
      status: binding.status || "ACTIVE",
    };
  });

  const withTextFilter = (col) => ({ headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, ...col });

  const table = new Tabulator("#master-table", {
    data: tableData,
    height: "100%",
    responsiveLayout: false,
    movableColumns: true,
    placeholder: "No SL bindings for this client",
    columns: [
      {
        title: "Actions",
        hozAlign: "center",
        headerHozAlign: "center",
        width: 132,
        minWidth: 132,
        widthGrow: 0,
        widthShrink: 0,
        formatter: function (cell) {
          const row = cell.getRow().getData();
          if (!row._id) return '';
          return `
            <div style="display:flex;align-items:center;justify-content:center;gap:6px;">
              <button
                onclick="viewSlBinding('${row._id}')"
                style="padding:2px 7px;background:#044A78;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                title="View Binding">
                <i class="fa-solid fa-eye"></i>
              </button>
              <button
                onclick="window.location.href='/sachiko/sl-binding/edit/${row._id}'"
                style="padding:2px 7px;background:#e67e22;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                title="Edit Binding">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              <button
                onclick="promptToggleStatus('${row._id}', '${row.status || 'ACTIVE'}')"
                style="padding:2px 7px;background:${(row.status || 'ACTIVE') === 'ACTIVE' ? '#28a745' : '#6c757d'};color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                title="${(row.status || 'ACTIVE') === 'ACTIVE' ? 'Set Inactive' : 'Set Active'}">
                <i class="fa-solid ${(row.status || 'ACTIVE') === 'ACTIVE' ? 'fa-toggle-on' : 'fa-toggle-off'}"></i>
              </button>
              <button
                onclick="promptDeleteBinding('${row._id}')"
                style="padding:2px 7px;background:#d9534f;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;"
                title="Remove Binding">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          `;
        },
      },
      {
        title: "Status",
        field: "status",
        hozAlign: "center",
        headerFilter: "input",
        headerFilterPlaceholder: "Search",
        minWidth: 100,
        formatter: (cell) => {
          const val = cell.getValue() || "ACTIVE";
          const bg = val === "ACTIVE" ? "#28a745" : "#dc3545";
          return `<span style="background:${bg};color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;">${val}</span>`;
        },
      },
      withTextFilter({ title: "SKU", field: "skuCode", minWidth: 170 }),
      withTextFilter({ title: "Product Code", field: "productCode", width: 140, formatter: (cell) => `<span style="font-weight:700;color:#044a78;">${cell.getValue()}</span>` }),
      withTextFilter({ title: "Product", field: "product", minWidth: 220 }),
      withTextFilter({ title: "FS Family", field: "fsFamily", minWidth: 110 }),
      withTextFilter({ title: "FS GSM", field: "fsGsm", minWidth: 100 }),
      withTextFilter({ title: "AD GSM", field: "adGsm", minWidth: 100 }),
      withTextFilter({ title: "RL Color", field: "rlColor", minWidth: 100 }),
      withTextFilter({ title: "RL GSM", field: "rlGsm", minWidth: 100 }),
      withTextFilter({ title: "Location", field: "location", minWidth: 140 }),
    ],
  });

  /* ── View Modal ── */
  function esc(v) {
    return String(v ?? "—").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  window.viewSlBinding = function (id) {
    const row = tableData.find(r => r._id === id);
    if (!row) return;
    const modal = document.getElementById("sl-view-modal");
    document.getElementById("sl-view-body").innerHTML = `
      <div style="background:linear-gradient(135deg,#044a78 0%,#03365a 100%);padding:22px 24px 20px;color:#fff;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
        <div>
          <h2 style="margin:0;font-size:20px;font-weight:700;">${esc(row.productCode)}</h2>
          <p style="margin:6px 0 0;font-size:13px;opacity:0.85;">${esc(row.skuCode)}</p>
        </div>
        <button onclick="document.getElementById('sl-view-modal').style.display='none'"
          style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);color:#fff;border-radius:999px;padding:5px 12px;cursor:pointer;font-size:13px;font-weight:700;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div style="padding:20px 24px;display:flex;flex-direction:column;gap:16px;overflow-y:auto;max-height:calc(90vh - 120px);">
        ${[
          { label: "Facestock Family", value: row.fsFamily },
          { label: "Facestock Type", value: row.fsType },
          { label: "Facestock GSM", value: row.fsGsm !== "" ? row.fsGsm + " GSM" : null },
          { label: "Facestock Micron", value: row.fsMicron !== "" ? row.fsMicron + " MIC" : null },
          { label: "Adhesive Type", value: row.adType },
          { label: "Adhesive GSM", value: row.adGsm !== "" ? row.adGsm + " GSM" : null },
          { label: "Release Liner Type", value: row.rlType },
          { label: "Release Liner Color", value: row.rlColor },
          { label: "Release Liner GSM", value: row.rlGsm !== "" ? row.rlGsm + " GSM" : null },
          { label: "Location", value: row.location },
          { label: "Status", value: row.status },
        ].map(r => `
          <div style="display:flex;justify-content:space-between;border-bottom:1px solid #f1f5f9;padding-bottom:10px;">
            <span style="font-size:13px;color:#64748b;font-weight:600;">${r.label}</span>
            <span style="font-size:13px;color:#03365a;font-weight:700;">${esc(r.value)}</span>
          </div>`).join("")}
      </div>`;
    modal.style.display = "flex";
  };

  document.getElementById("sl-view-modal").addEventListener("click", function (e) {
    if (e.target === this) this.style.display = "none";
  });

  /* ── Delete ── */
  let bindingToDelete = "";
  const deleteModal = document.getElementById("deleteBindingModal");
  const deleteForm = document.getElementById("deleteBindingForm");
  const deleteConfirmBtn = document.getElementById("deleteBindingConfirm");
  const deleteCancelBtn = document.getElementById("deleteBindingCancel");
  const getCsrfToken = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || "";

  window.promptDeleteBinding = function (bindingId) {
    bindingToDelete = String(bindingId || "");
    deleteModal.classList.add("show");
    deleteModal.setAttribute("aria-hidden", "false");
  };

  function closeDeleteModal() {
    deleteModal.classList.remove("show");
    deleteModal.setAttribute("aria-hidden", "true");
    bindingToDelete = "";
  }

  deleteCancelBtn.addEventListener("click", closeDeleteModal);
  deleteModal.addEventListener("click", (e) => {
    if (e.target === deleteModal) closeDeleteModal();
  });
  deleteConfirmBtn.addEventListener("click", () => {
    if (!bindingToDelete) return closeDeleteModal();
    let csrfInput = deleteForm.querySelector('input[name="_csrf"]');
    if (!csrfInput) {
      csrfInput = document.createElement("input");
      csrfInput.type = "hidden";
      csrfInput.name = "_csrf";
      deleteForm.appendChild(csrfInput);
    }
    csrfInput.value = getCsrfToken();
    deleteForm.action = `/sachiko/sl-binding/delete/${bindingToDelete}`;
    deleteForm.submit();
  });

  /* ── Toggle Status ── */
  let statusBindingId = "";
  let statusTarget = "INACTIVE";
  const statusModal = document.getElementById("statusBindingModal");
  const statusText = document.getElementById("statusBindingText");
  const statusConfirmBtn = document.getElementById("statusBindingConfirm");
  const statusCancelBtn = document.getElementById("statusBindingCancel");

  window.promptToggleStatus = function (bindingId, currentStatus) {
    statusBindingId = String(bindingId || "");
    const current = (currentStatus || "ACTIVE") === "INACTIVE" ? "INACTIVE" : "ACTIVE";
    statusTarget = current === "ACTIVE" ? "INACTIVE" : "ACTIVE";
    statusText.textContent = `This will mark the binding as ${statusTarget}.`;
    statusModal.classList.add("show");
    statusModal.setAttribute("aria-hidden", "false");
  };

  function closeStatusModal() {
    statusModal.classList.remove("show");
    statusModal.setAttribute("aria-hidden", "true");
    statusBindingId = "";
  }

  statusCancelBtn.addEventListener("click", closeStatusModal);
  statusModal.addEventListener("click", (e) => {
    if (e.target === statusModal) closeStatusModal();
  });

  statusConfirmBtn.addEventListener("click", async () => {
    if (!statusBindingId) return closeStatusModal();
    statusConfirmBtn.disabled = true;
    const endpoint = statusTarget === "ACTIVE" ? "set-active" : "set-inactive";
    try {
      const res = await fetch(`/sachiko/sl-binding/${endpoint}/${statusBindingId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-csrf-token": getCsrfToken() },
      });
      if (res.ok) {
        closeStatusModal();
        window.location.reload();
      }
    } finally {
      statusConfirmBtn.disabled = false;
    }
  });
</script>
