<% layout('/layout/boilerplate') %>

<style>
  .choices[data-type*="select-one"]::after {
    display: block !important;
    content: "" !important;
    width: 12px !important;
    height: 8px !important;
    border-style: none !important;
    border-width: 0 !important;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
    background-repeat: no-repeat !important;
    background-size: contain !important;
    position: absolute !important;
    right: 11.5px !important;
    top: 50% !important;
    margin-top: 0 !important;
    transform: translateY(-50%) !important;
  }
  .choices[data-type*="select-one"].is-open::after {
    transform: translateY(-50%) rotate(180deg) !important;
  }

  .jc-table {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(4,74,120,0.08);
  }
  .jc-table th {
    background: #044a78;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 14px;
    text-align: left;
    letter-spacing: 0.02em;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
  }
  .jc-table th:last-child {
    border-right: none;
  }
  .jc-table td {
    padding: 8px 10px;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #e2e8f0;
    vertical-align: middle;
  }
  .jc-table td:last-child {
    border-right: none;
  }
  .jc-table tr:last-child td {
    border-bottom: none;
  }
  .jc-table input.form-control {
    padding: 8px 10px !important;
    font-size: 13px !important;
    height: auto !important;
    background: #f0f7ff !important;
    color: #044a78 !important;
    font-weight: 600 !important;
  }
  .jc-table.deckle-free-mode tbody tr:first-child td {
    border-bottom: none;
  }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px">
  <form
    action="/sachiko/sales/order"
    method="POST"
    class="needs-validation"
    autocomplete="off"
    novalidate
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="span-full form-heading">
      <h1>Sales Order</h1>
    </div>

    <!-- Row 1: Sales Order ID | Client Name | Client User -->
    <div class="span-five">
      <label for="salesOrderId">Sales Order ID</label>
      <input
        type="text"
        id="salesOrderId"
        name="salesOrderId"
        class="form-control"
        value="<%= previewSalesOrderId %>"
        readonly
        style="background:#f0f7ff; color:#044a78; font-weight:700; cursor:default;"
      />
    </div>

    <div class="span-eight">
      <label for="clientName">Client Name</label>
      <select id="clientName" name="clientName" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select client</option>
        <% clients.forEach(c => { %>
        <option value="<%= c.clientName %>" data-client-id="<%= c.clientId %>"><%= c.clientName %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-seven">
      <label for="clientUserName">Client User</label>
      <select id="clientUserName" name="clientUserName" class="form-control select-tag">
        <option value="">Select user</option>
      </select>
    </div>

    <!-- Row 2: Select Product | Deckle -->
    <div class="span-seven">
      <label for="productCode">Select Product</label>
      <select id="productCode" name="productCode" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select product</option>
        <% labelStocks.forEach(labelStock => { %>
        <option
          value="<%= labelStock.productCode %>"
          data-fs-type="<%= labelStock.facestock?.facestockType || '' %>"
          data-fs-gsm="<%= labelStock.facestock?.facestockGsm != null ? labelStock.facestock.facestockGsm + ' GSM' : '' %>"
          data-fs-mic="<%= labelStock.facestock?.facestockMicron != null ? labelStock.facestock.facestockMicron + ' MIC' : '' %>"
          data-ad-type="<%= labelStock.adhesive?.adhesiveType || '' %>"
          data-ad-gsm="<%= labelStock.adhesive?.adhesiveGsm != null ? labelStock.adhesive.adhesiveGsm + ' GSM' : '' %>"
          data-rl-type="<%= labelStock.releaseLiner?.releaseLinerType || '' %>"
          data-rl-gsm="<%= labelStock.releaseLiner?.releaseLinerGsm != null ? labelStock.releaseLiner.releaseLinerGsm + ' GSM' : '' %>"
        ><%= labelStock.productCode %></option>
        <% }) %>
      </select>
    </div>

    <div class="span-five">
      <label for="deckleType">Deckle</label>
      <select id="deckleType" name="deckleType" class="form-control select-tag" required>
        <option value="" disabled selected hidden>Select type</option>
        <option value="Deckle Set">Deckle Set</option>
        <option value="Deckle Free">Deckle Free</option>
      </select>
    </div>

    <div id="sku-layer-preview" class="span-full" style="display:none;">
      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:16px 18px;max-width:600px;margin:0 auto;">
        <p style="margin:0 0 10px;font-size:11px;font-weight:700;color:#94a3b8;letter-spacing:0.05em;text-align:center;">LAYER STACK (TOP &rarr; BOTTOM)</p>
        <div id="sku-layer-stack" style="display:flex;flex-direction:column;gap:2px;"></div>
      </div>
    </div>

    <!-- Materials Table -->
    <div class="span-full">
      <table class="jc-table deckle-free-mode" style="table-layout:fixed;">
        <colgroup>
          <col style="width:16.66%;" />
          <col style="width:16.66%;" />
          <col style="width:16.66%;" />
          <col style="width:16.66%;" />
          <col style="width:16.66%;" />
          <col style="width:16.66%;" />
        </colgroup>
        <thead>
          <tr>
            <th>FS Code</th>
            <th>FS GSM / MIC</th>
            <th>Ad Code</th>
            <th>Ad GSM / MIC</th>
            <th>RL Code</th>
            <th>RL GSM / MIC</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><input type="text" name="fsCode" id="fsCode" class="form-control" placeholder="Code" /></td>
            <td><input type="text" name="fsGsmMic" id="fsGsmMic" class="form-control" placeholder="GSM / MIC" /></td>
            <td><input type="text" name="adCode" id="adCode" class="form-control" placeholder="Code" readonly /></td>
            <td><input type="text" name="adGsmMic" id="adGsmMic" class="form-control" placeholder="GSM / MIC" readonly style="background:#f0f7ff;color:#044a78;font-weight:600;cursor:default;" /></td>
            <td><input type="text" name="rlCode" id="rlCode" class="form-control" placeholder="Code" /></td>
            <td><input type="text" name="rlGsmMic" id="rlGsmMic" class="form-control" placeholder="GSM / MIC" /></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="span-full form-subheading">
      <h1>Order Info</h1>
    </div>

    <!-- Row: PO Date | PO Number | Est Delivery Date | Remarks -- four span-eight
         blocks span 8+8+8+8 = 32, filling the grid row exactly. -->
    <div class="span-eight">
      <label for="poDate">PO Date</label>
      <input type="date" id="poDate" name="poDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" />
    </div>

    <div class="span-eight">
      <label for="poNumber">PO Number</label>
      <input type="text" id="poNumber" name="poNumber" class="form-control" placeholder="Enter PO number" required />
    </div>

    <div class="span-eight">
      <label for="estimatedDate">Est Delivery Date</label>
      <input type="date" id="estimatedDate" name="estimatedDate" class="form-control" placeholder="dd/mm/yyyy" />
    </div>

    <div class="span-eight">
      <label for="remarks">Remarks (Optional)</label>
      <input type="text" id="remarks" name="remarks" class="form-control" placeholder="Remarks (Optional)" />
    </div>

    <div class="btn-grp span-full">
      <button type="submit">Save Sales Order</button>
    </div>
  </form>
</div>

<script>
  const allClientUsers = <%- JSON.stringify(clientUsers) %>;
  const labelStocksData = <%- safeJson(labelStocks || []) %>;

  function escSku(v) {
    return String(v ?? "—").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  /* ── Physical layer stack builder (same layer order/styling used on the Label Stock View page) ── */
  const SKU_LAYER_STYLE = {
    facestock: { bg: "#ffffff", border: "#93c5fd", text: "#000000", label: "FACESTOCK" },
    adhesive:  { bg: "#fffbeb", border: "#fcd34d", text: "#b45309", label: "ADHESIVE" },
    release:   { bg: "#eff6ff", border: "#93c5fd", text: "#1d4ed8", label: "RELEASE LINER" },
  };

  function skuLayerBlock(kind, title, parts) {
    const s = SKU_LAYER_STYLE[kind];
    const detail = parts.filter(Boolean).join(" · ");
    return `
      <div style="background:${s.bg};border:1.5px solid ${s.border};border-radius:6px;padding:8px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px;">
        <span style="font-size:11px;font-weight:800;letter-spacing:0.04em;color:${s.text};">${s.label}</span>
        <span style="font-size:12px;font-weight:600;color:#334155;text-align:right;">${detail ? escSku(detail) : "—"}${title ? ` <span style="color:${s.text};font-weight:700;">(${escSku(title)})</span>` : ""}</span>
      </div>`;
  }

  function renderSkuLayerStack(ds) {
    const rollType = ds.rollType || "NORMAL";
    let layers = [
      skuLayerBlock("facestock", null, [ds.facestock?.facestockFamily, ds.facestock?.facestockType, ds.facestock?.facestockGsm != null ? ds.facestock.facestockGsm + " GSM" : null, ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC" : null]),
      skuLayerBlock("adhesive", null, [ds.adhesive?.adhesiveType, ds.adhesive?.adhesiveGsm != null ? ds.adhesive.adhesiveGsm + " GSM" : null]),
    ];
    if (rollType === "DOUBLE FACESTOCK") {
      layers.push(
        skuLayerBlock("facestock", "Layer 2", [ds.facestock2?.facestockFamily, ds.facestock2?.facestockType, ds.facestock2?.facestockGsm != null ? ds.facestock2.facestockGsm + " GSM" : null, ds.facestock2?.facestockMicron != null ? ds.facestock2.facestockMicron + " MIC" : null]),
        skuLayerBlock("adhesive", "Layer 2", [ds.adhesive2?.adhesiveType, ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null]),
        skuLayerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
      );
    } else if (rollType === "DOUBLE RELEASE") {
      layers.push(
        skuLayerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
        skuLayerBlock("adhesive", "Layer 2", [ds.adhesive2?.adhesiveType, ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null]),
        skuLayerBlock("release", "Layer 2", [ds.releaseLiner2?.releaseLinerType, ds.releaseLiner2?.releaseLinerColor, ds.releaseLiner2?.releaseLinerGsm != null ? ds.releaseLiner2.releaseLinerGsm + " GSM" : null]),
      );
    } else {
      layers.push(
        skuLayerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
      );
    }

    return `
      <div style="display:flex;flex-direction:column;gap:2px;">
        ${layers.join(`
        <div style="display:flex;justify-content:center;margin:-2px 0;"><i class="fa-solid fa-caret-down" style="color:#cbd5e1;font-size:11px;"></i></div>
        `)}
      </div>`;
  }

  document.addEventListener("DOMContentLoaded", () => {
    const productSelect    = document.getElementById("productCode");
    const clientNameSelect = document.getElementById("clientName");

    new Choices(document.getElementById("deckleType"), {
      searchEnabled: false,
      shouldSort: false,
      itemSelectText: "",
    });

    const clientNameChoices = new Choices(clientNameSelect, {
      searchEnabled: true,
      shouldSort: false,
      itemSelectText: "",
      searchPlaceholderValue: "Search client…",
    });

    const clientUserChoices = new Choices(document.getElementById("clientUserName"), {
      searchEnabled: true,
      shouldSort: false,
      itemSelectText: "",
      searchPlaceholderValue: "Search user…",
    });

    new Choices(productSelect, {
      searchEnabled: true,
      shouldSort: false,
      itemSelectText: "",
      searchPlaceholderValue: "Search product…",
    });

    clientNameSelect.addEventListener("change", () => {
      const sel = clientNameSelect.options[clientNameSelect.selectedIndex];
      const clientId = sel?.dataset?.clientId || "";
      const users = allClientUsers.filter(u => u.clientId === clientId);
      clientUserChoices.clearChoices();
      clientUserChoices.setChoices(
        [{ value: "", label: "Select user", placeholder: true }].concat(
          users.map(u => ({ value: u.userName, label: u.userName }))
        ),
        "value", "label", true
      );
      if (users.length === 1) {
        clientUserChoices.setChoiceByValue(users[0].userName);
      }
    });

    const skuLayerPreview = document.getElementById("sku-layer-preview");
    const skuLayerStack = document.getElementById("sku-layer-stack");

    function autofillFromSelection() {
      const sel = productSelect.options[productSelect.selectedIndex];
      if (!sel || !sel.value) return;

      const fsType   = sel.dataset.fsType  || "";
      const fsMic    = sel.dataset.fsMic   || "";
      const fsGsmVal = sel.dataset.fsGsm   || "";
      const adType   = sel.dataset.adType  || "";
      const adGsmVal = sel.dataset.adGsm   || "";
      const rlType   = sel.dataset.rlType  || "";
      const rlGsmVal = sel.dataset.rlGsm   || "";

      document.getElementById("fsCode").value   = fsType;
      document.getElementById("fsGsmMic").value = fsMic || fsGsmVal;
      document.getElementById("adCode").value   = adType;
      document.getElementById("adGsmMic").value = adGsmVal;
      document.getElementById("rlCode").value   = rlType;
      document.getElementById("rlGsmMic").value = rlGsmVal;

      const ds = labelStocksData.find(d => d.productCode === sel.value);
      if (ds) {
        skuLayerStack.innerHTML = renderSkuLayerStack(ds);
        skuLayerPreview.style.display = "block";
      } else {
        skuLayerPreview.style.display = "none";
      }
    }

    productSelect.addEventListener("change", autofillFromSelection);

    const deckleSelect = document.getElementById("deckleType");
    const materialsTable = document.querySelector(".jc-table");

    function toggleDeckleFields() {
      const val = deckleSelect.value;
      if (val === "Deckle Set") {
        materialsTable.classList.remove("deckle-free-mode");
      } else {
        materialsTable.classList.add("deckle-free-mode");
      }
    }

    deckleSelect.addEventListener("change", toggleDeckleFields);
    // Initialize state
    toggleDeckleFields();

    // Est Delivery Date can't precede PO Date -- keep the picker's `min` in step.
    const poDateInput = document.getElementById("poDate");
    const estimatedDateInput = document.getElementById("estimatedDate");
    function syncEstDeliveryMin() {
      if (poDateInput && estimatedDateInput) estimatedDateInput.min = (poDateInput.value || "").trim();
    }
    if (poDateInput) poDateInput.addEventListener("change", syncEstDeliveryMin);
    syncEstDeliveryMin();
  });
</script>
