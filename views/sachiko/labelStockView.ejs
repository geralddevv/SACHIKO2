          </div>
          <div class="layer-field">
            <label for="lsFacestockType2">Type</label>
            <select id="lsFacestockType2" name="facestockType2" class="form-control select-tag" data-required-when-visible>
              <option value="" disabled selected hidden>Select type</option>
              <option value="CLEAR">CLEAR</option>
              <option value="GLOSSY">GLOSSY</option>
              <option value="MATT">MATT</option>
              <option value="SEMI GLOSSY">SEMI GLOSSY</option>
            </select>
          </div>
          <div class="layer-field">
            <label for="lsFacestockGsm2">GSM</label>
            <input type="number" id="lsFacestockGsm2" name="facestockGsm2" class="form-control" placeholder="Enter GSM" min="0" step="any" />
