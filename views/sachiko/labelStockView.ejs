<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #master-table { width: 100%; flex: 1 1 auto; min-height: 0; }
    .tabulator-edit-list { scrollbar-width: none !important; -ms-overflow-style: none !important; }
    .tabulator-edit-list::-webkit-scrollbar { display: none !important; }
    .header-action-btn {
      background-color: #f0f0f0; color: #044a78;
      padding: 2px 14px; font-size: 14px; font-weight: 500;
      border: none; cursor: pointer; border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,.1);
      transition: all 0.2s ease-in-out;
      display: flex; align-items: center; justify-content: center;
    }
    .header-action-btn:hover { background-color: #e4e4e4; }

    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

    /* ── Create Label Stock dialog ── */
    .dialog-field-label {
      display: block; font-size: 12px; font-weight: 700; letter-spacing: 0.02em;
      color: #64748b; text-transform: uppercase; margin-bottom: 6px;
    }
    .dialog-field { display: flex; flex-direction: column; gap: 6px; }
    #ls-create-form .choices[data-type*="select-one"]::after {
      display: block !important; content: "" !important; width: 12px !important; height: 8px !important;
      border-style: none !important; border-width: 0 !important;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
      background-repeat: no-repeat !important; background-size: contain !important;
      position: absolute !important; right: 11.5px !important; top: 50% !important; margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    #ls-create-form .choices[data-type*="select-one"].is-open::after { transform: translateY(-50%) rotate(180deg) !important; }
    /* Dropdown list must render above the dialog overlay. */
    #ls-create-form .choices__list--dropdown { z-index: 99999 !important; }

    /* Every select becomes a Choices.js widget once the dialog opens, which
       replaces the plain <select> with its own `.choices__inner` box -- so
       that's the element that actually needs to match the plain inputs'
       look (global .choices__inner otherwise renders a 1px black border
       with no fixed height, which is what read as "inconsistent"). */
    #ls-create-form .choices__inner {
      min-height: 2.3rem !important; height: 2.3rem !important; display: flex !important; align-items: center;
      padding: 0.3rem 0.7rem !important; border: 1.6px solid #cbd5e1 !important; border-radius: 8px !important;
      background: #ffffff !important; font-size: 0.95rem !important;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    #ls-create-form .choices__list--single { padding: 0 !important; }
    #ls-create-form .choices__list--single .choices__item { font-size: 0.95rem; font-weight: 600; color: #1e293b; }
    #ls-create-form .choices:hover .choices__inner { border-color: #94a3b8 !important; }
    #ls-create-form .choices.is-focused .choices__inner,
    #ls-create-form .choices.is-open .choices__inner {
      border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.12) !important;
    }
    .layer-card--adhesive .choices__inner { border-color: #fbbf24 !important; }

    /* Every field in the dialog -- the top Product row as well as the layer
       cards below -- shares this one look, so nothing reads as a different
       control halfway down the form. */
    #ls-create-form input.form-control,
    #ls-create-form select.form-control,
    #ls-create-form .dialog-field select {
      width: 100%; height: 2.3rem; padding: 0.3rem 0.7rem; border: 1.6px solid #cbd5e1; border-radius: 8px;
      background: #ffffff; font-size: 0.95rem; font-weight: 600; color: #1e293b;
      transition: border-color 0.15s ease, box-shadow 0.15s ease; box-sizing: border-box;
    }
    #ls-create-form input.form-control::placeholder { color: #94a3b8; font-weight: 500; }
    #ls-create-form input.form-control:hover,
    #ls-create-form select.form-control:hover,
    #ls-create-form .dialog-field select:hover { border-color: #94a3b8; }
    #ls-create-form input.form-control:focus,
    #ls-create-form select.form-control:focus,
    #ls-create-form .dialog-field select:focus {
      outline: none; border-color: #044a78; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.12);
    }
    #ls-create-form input.form-control[readonly] {
      background: #eef1f5; color: #64748b; cursor: not-allowed;
    }
    /* File inputs can't take height/padding the same way -- match border/radius only. */
    #ls-create-form input[type="file"].form-control {
      height: auto; padding: 0.45rem 0.7rem; border: 1.6px solid #cbd5e1; border-radius: 8px;
      background: #ffffff; font-size: 0.85rem; font-weight: 500; color: #475569; box-sizing: border-box;
    }

    .layer-card { border-radius: 10px; border: 1.5px solid; padding: 14px 18px 18px; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06); }
    .layer-card__label { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; margin-bottom: 14px; }
    .layer-card__label::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; flex: 0 0 auto; }
    .layer-card__fields { display: grid; gap: 14px; }
    .layer-field { display: flex; flex-direction: column; gap: 6px; }
    .layer-field label { font-size: 12px; font-weight: 700; letter-spacing: 0.02em; color: #64748b; text-transform: uppercase; }
    .layer-card--facestock { background: #ffffff; border-color: #93c5fd; }
    .layer-card--facestock .layer-card__label { color: #000000; }
    .layer-card--adhesive { background: #fffbeb; border-color: #fcd34d; }
    .layer-card--adhesive .layer-card__label { color: #b45309; }
    .layer-card--adhesive .layer-field input.form-control,
    .layer-card--adhesive .layer-field select.form-control { border-color: #fbbf24; }
    .layer-card--release { background: #eff6ff; border-color: #93c5fd; }
    .layer-card--release .layer-card__label { color: #1d4ed8; }

    .layer-arrow { display: flex; justify-content: center; margin: -6px 0; }
    .layer-arrow i { color: #cbd5e1; font-size: 16px; }

    @media (max-width: 768px) {
      .layer-card__fields { grid-template-columns: 1fr !important; }
    }
  </style>

  <div class="indi-head">
    <h1>Label Stock View</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <button class="header-action-btn" onclick="openCreateLabelStockDialog()">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> New
      </button>
      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span><i class="fa-solid fa-file-arrow-down"></i> Download</span>
          <i class="fas fa-chevron-down"></i>
        </button>
        <div class="download-selector__menu">
          <div class="download-selector__option" id="download-pdf"><i class="fas fa-file-pdf"></i> PDF</div>
          <div class="download-selector__option" id="download-xlsx"><i class="fas fa-file-excel"></i> Excel</div>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table"></div>
</div>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script>
  /* ── Download dropdown ── */
  const downloadSelector = document.getElementById("downloadSelector");
  const triggerBtn = downloadSelector.querySelector(".download-selector__trigger");
  triggerBtn.addEventListener("click", (e) => { e.stopPropagation(); downloadSelector.classList.toggle("download-selector--active"); });
  document.addEventListener("click", () => downloadSelector.classList.remove("download-selector--active"));

  /* ── Flatten nested Label Stock docs for Tabulator ── */
  const raw = <%- safeJson(jsonData) %>;

  const tableData = raw.map(ds => {
    const fsGsm    = ds.facestock?.facestockGsm    != null ? ds.facestock.facestockGsm    + " GSM ± 5%" : "-";
    const fsMicron = ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC ± 5%" : "-";
    const adGsm    = ds.adhesive?.adhesiveGsm      != null ? ds.adhesive.adhesiveGsm      + " GSM ± 5%" : "-";
    const rlGsm    = ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM ± 5%" : "-";

    const fsFamily = ds.facestock?.facestockFamily  || "";
    const fsType   = ds.facestock?.facestockType    || "";
    const adType   = ds.adhesive?.adhesiveType      || "";
    const rlType   = ds.releaseLiner?.releaseLinerType  || "";
    const rlColor  = ds.releaseLiner?.releaseLinerColor || "";
    const wordFile = ds.wordFile || "";

    const micPart = ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC" : "";
    const product = [fsType, micPart, adType, rlType].filter(Boolean).join(" / ");

    return {
      _id: String(ds._id),
      labelStockId: ds.labelStockId || "",
      skuCode: ds.skuCode || "",
      productCode: ds.productCode,
      rollType: ds.rollType || "NORMAL",
      wordFileOriginalName: ds.wordFileOriginalName || "",
      product,
      fsFamily,
      fsType,
      fsGsm,
      fsMicron,
      adType,
      adGsm,
      rlType,
      rlColor,
      rlGsm,
      wordFile,
    };
  });

  const withTextFilter = (col) => ({ headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, hozAlign: "center", headerHozAlign: "center", ...col });
  const withSelectFilter = (col, values) => ({ headerFilter: "list", headerFilterParams: { values, clearable: true }, hozAlign: "center", headerHozAlign: "center", ...col });

  const table = new Tabulator("#master-table", {
    data: tableData,
    height: "100%",
    initialSort: [{ column: "skuCode", dir: "asc" }],
    placeholder: "No Label Stocks found",
    columns: [
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        width: 110,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `
            <div style="display:flex;gap:5px;justify-content:center;align-items:center;white-space:nowrap;">
              <button onclick="viewLabelStock('${row._id}')"
                style="height:24px;padding:2px 9px;background:#111827;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px;display:inline-flex;align-items:center;gap:3px;font-weight:600;"
                onmouseover="this.style.background='#374151'" onmouseout="this.style.background='#111827'"
                title="View">
                <i class="fa-solid fa-eye"></i>
              </button>
              <a href="/sachiko/label-stock/edit/${row._id}"
                style="height:24px;padding:2px 9px;background:#3b82f6;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px;display:inline-flex;align-items:center;gap:3px;font-weight:600;text-decoration:none;"
                onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'"
                title="Edit">
                <i class="fa-solid fa-pencil"></i>
              </a>
              <button onclick="deleteLabelStock('${row._id}','${row.productCode}')"
                style="height:24px;padding:2px 9px;background:#ef4444;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px;display:inline-flex;align-items:center;gap:3px;font-weight:600;"
                onmouseover="this.style.background='#dc2626'" onmouseout="this.style.background='#ef4444'"
                title="Delete">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>`;
        },
      },
      withTextFilter({ title: "SKU", field: "skuCode", minWidth: 180 }),
      withTextFilter({ title: "Product Code", field: "productCode", width: 150, formatter: (cell) => `<span style="font-weight:700;color:#044a78;">${cell.getValue()}</span>` }),
      withTextFilter({ title: "Product",      field: "product",     minWidth: 220, formatter: (cell) => `<span style="font-weight:600;color:#03365a;">${cell.getValue()}</span>` }),
      withSelectFilter({ title: "Roll Type",  field: "rollType",  minWidth: 140,
        formatter: (cell) => {
          const v = cell.getValue() || "NORMAL";
          const color = v === "NORMAL" ? "#475569" : "#b45309";
          return `<span style="font-weight:600;color:${color};">${v}</span>`;
        } },
        { "": "All", "NORMAL": "NORMAL", "DOUBLE RELEASE": "DOUBLE RELEASE", "DOUBLE FACESTOCK": "DOUBLE FACESTOCK" }),
      withSelectFilter({ title: "FS Family",  field: "fsFamily",  minWidth: 120 },
        (() => { const d = [...new Set(tableData.map(r => r.fsFamily))].filter(Boolean).sort(); const o = {"":"All"}; d.forEach(v => o[v]=v); return o; })()),
      withSelectFilter({ title: "FS Type",    field: "fsType",    minWidth: 120 },
        (() => { const d = [...new Set(tableData.map(r => r.fsType))].filter(Boolean).sort(); const o = {"":"All"}; d.forEach(v => o[v]=v); return o; })()),
      withTextFilter({ title: "FS GSM",       field: "fsGsm",     minWidth: 130 }),
      withTextFilter({ title: "FS Micron",    field: "fsMicron",  minWidth: 130 }),
      withSelectFilter({ title: "AD Type",    field: "adType",    minWidth: 130 },
        (() => { const d = [...new Set(tableData.map(r => r.adType))].filter(Boolean).sort(); const o = {"":"All"}; d.forEach(v => o[v]=v); return o; })()),
      withTextFilter({ title: "AD GSM",       field: "adGsm",     minWidth: 130 }),
      withSelectFilter({ title: "RL Type",    field: "rlType",    minWidth: 120 },
        (() => { const d = [...new Set(tableData.map(r => r.rlType))].filter(Boolean).sort(); const o = {"":"All"}; d.forEach(v => o[v]=v); return o; })()),
      withSelectFilter({ title: "RL Color",   field: "rlColor",   minWidth: 110 },
        (() => { const d = [...new Set(tableData.map(r => r.rlColor))].filter(Boolean).sort(); const o = {"":"All"}; d.forEach(v => o[v]=v); return o; })()),
      withTextFilter({ title: "RL GSM",       field: "rlGsm",     minWidth: 130 }),
      { title: "Word File", field: "wordFile", minWidth: 110, headerFilter: false, hozAlign: "center", headerHozAlign: "center",
        formatter: (cell) => {
          const v = cell.getValue();
          return v ? `<a href="/sachiko/label-stock/file/${v}" style="color:#044a78;font-weight:600;text-decoration:none;" title="Download file"><i class="fa-solid fa-file-word" style="margin-right:4px;"></i>Download</a>` : `<span style="color:#aaa;">—</span>`;
        }
      },
    ],
  });

  document.getElementById("download-pdf").addEventListener("click", () =>
    table.download("pdf", "sachiko-label-stock.pdf", { orientation: "landscape", title: "Sachiko Label Stocks", autoTable: { styles: { fillColor: [4, 74, 120] } } }));
  document.getElementById("download-xlsx").addEventListener("click", () =>
    table.download("xlsx", "sachiko-label-stock.xlsx", { sheetName: "Label Stocks" }));

  /* ── View Modal ── */
  function esc(v) {
    return String(v ?? "—").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  window.viewLabelStock = function(id) {
    const ds = raw.find(d => String(d._id) === id);
    if (!ds) return;
    const modal = document.getElementById("ds-view-modal");

    const rollType = ds.rollType || "NORMAL";
    const baseRows = [
      { label: "Roll Type",         value: rollType },
      { label: "Facestock Family",  value: ds.facestock?.facestockFamily },
      { label: "Facestock Type",    value: ds.facestock?.facestockType },
      { label: "Facestock GSM",     value: ds.facestock?.facestockGsm    != null ? ds.facestock.facestockGsm + " GSM" : null },
      { label: "Facestock Micron",  value: ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC" : null },
      { label: "Adhesive Type",     value: ds.adhesive?.adhesiveType },
      { label: "Adhesive GSM",      value: ds.adhesive?.adhesiveGsm      != null ? ds.adhesive.adhesiveGsm + " GSM" : null },
    ];
    const facestock2Rows = [
      { label: "Facestock Family (Layer 2)", value: ds.facestock2?.facestockFamily },
      { label: "Facestock Type (Layer 2)",   value: ds.facestock2?.facestockType },
      { label: "Facestock GSM (Layer 2)",    value: ds.facestock2?.facestockGsm    != null ? ds.facestock2.facestockGsm + " GSM" : null },
      { label: "Facestock Micron (Layer 2)", value: ds.facestock2?.facestockMicron != null ? ds.facestock2.facestockMicron + " MIC" : null },
    ];
    const adhesive2Rows = [
      { label: "Adhesive Type (Layer 2)", value: ds.adhesive2?.adhesiveType },
      { label: "Adhesive GSM (Layer 2)",  value: ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null },
    ];
    const release1Rows = [
      { label: "Release Liner Type",  value: ds.releaseLiner?.releaseLinerType },
      { label: "Release Liner Color", value: ds.releaseLiner?.releaseLinerColor },
      { label: "Release Liner GSM",   value: ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null },
    ];
    const release2Rows = [
      { label: "Release Liner Type (Layer 2)",  value: ds.releaseLiner2?.releaseLinerType },
      { label: "Release Liner Color (Layer 2)", value: ds.releaseLiner2?.releaseLinerColor },
      { label: "Release Liner GSM (Layer 2)",   value: ds.releaseLiner2?.releaseLinerGsm != null ? ds.releaseLiner2.releaseLinerGsm + " GSM" : null },
    ];

    // Mirrors the create/edit form's block order for each roll type.
    let rows;
    if (rollType === "DOUBLE FACESTOCK") {
      rows = [...baseRows, ...facestock2Rows, ...adhesive2Rows, ...release1Rows];
    } else if (rollType === "DOUBLE RELEASE") {
      rows = [...baseRows, ...release1Rows, ...adhesive2Rows, ...release2Rows];
    } else {
      rows = [...baseRows, ...release1Rows];
    }

    /* ── Physical layer stack (top-to-bottom, same order as `rows`) ── */
    const LAYER_STYLE = {
      facestock: { bg: "#ffffff", border: "#93c5fd", text: "#000000", label: "FACESTOCK" },
      adhesive:  { bg: "#fffbeb", border: "#fcd34d", text: "#b45309", label: "ADHESIVE" },
      release:   { bg: "#eff6ff", border: "#93c5fd", text: "#1d4ed8", label: "RELEASE LINER" },
    };

    function layerBlock(kind, title, parts) {
      const s = LAYER_STYLE[kind];
      const detail = parts.filter(Boolean).join(" · ");
      return `
        <div style="background:${s.bg};border:1.5px solid ${s.border};border-radius:6px;padding:8px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px;">
          <span style="font-size:11px;font-weight:800;letter-spacing:0.04em;color:${s.text};">${s.label}</span>
          <span style="font-size:12px;font-weight:600;color:#334155;text-align:right;">${detail ? esc(detail) : "—"}${title ? ` <span style="color:${s.text};font-weight:700;">(${esc(title)})</span>` : ""}</span>
        </div>`;
    }

    let layers = [
      layerBlock("facestock", null, [ds.facestock?.facestockFamily, ds.facestock?.facestockType, ds.facestock?.facestockGsm != null ? ds.facestock.facestockGsm + " GSM" : null, ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC" : null]),
      layerBlock("adhesive", null, [ds.adhesive?.adhesiveType, ds.adhesive?.adhesiveGsm != null ? ds.adhesive.adhesiveGsm + " GSM" : null]),
    ];
    if (rollType === "DOUBLE FACESTOCK") {
      layers.push(
        layerBlock("facestock", "Layer 2", [ds.facestock2?.facestockFamily, ds.facestock2?.facestockType, ds.facestock2?.facestockGsm != null ? ds.facestock2.facestockGsm + " GSM" : null, ds.facestock2?.facestockMicron != null ? ds.facestock2.facestockMicron + " MIC" : null]),
        layerBlock("adhesive", "Layer 2", [ds.adhesive2?.adhesiveType, ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null]),
        layerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
      );
    } else if (rollType === "DOUBLE RELEASE") {
      layers.push(
        layerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
        layerBlock("adhesive", "Layer 2", [ds.adhesive2?.adhesiveType, ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null]),
        layerBlock("release", "Layer 2", [ds.releaseLiner2?.releaseLinerType, ds.releaseLiner2?.releaseLinerColor, ds.releaseLiner2?.releaseLinerGsm != null ? ds.releaseLiner2.releaseLinerGsm + " GSM" : null]),
      );
    } else {
      layers.push(
        layerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
      );
    }

    const layerStackHtml = `
      <div style="display:flex;flex-direction:column;gap:2px;">
        ${layers.join(`
        <div style="display:flex;justify-content:center;margin:-2px 0;"><i class="fa-solid fa-caret-down" style="color:#cbd5e1;font-size:11px;"></i></div>
        `)}
      </div>`;

    document.getElementById("ds-view-body").innerHTML = `
      <div style="background:linear-gradient(135deg,#044a78 0%,#03365a 100%);padding:22px 24px 20px;color:#fff;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
        <div>
          <h2 style="margin:0;font-size:20px;font-weight:700;">${esc(ds.productCode)}</h2>
          <p style="margin:6px 0 0;font-size:13px;opacity:0.85;">${esc(ds.labelStockId)}</p>
        </div>
        <button onclick="document.getElementById('ds-view-modal').style.display='none'"
          style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);color:#fff;border-radius:999px;padding:5px 12px;cursor:pointer;font-size:13px;font-weight:700;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="custom-scrollbar" style="padding:20px 24px;display:flex;flex-direction:column;gap:16px;overflow-y:auto;max-height:calc(90vh - 120px);">
        <div>
          <p style="margin:0 0 8px;font-size:11px;font-weight:700;color:#94a3b8;letter-spacing:0.05em;">LAYER STACK (TOP &rarr; BOTTOM)</p>
          ${layerStackHtml}
        </div>
        ${rows.map(r => `
          <div style="display:flex;justify-content:space-between;border-bottom:1px solid #f1f5f9;padding-bottom:10px;">
            <span style="font-size:13px;color:#64748b;font-weight:600;">${r.label}</span>
            <span style="font-size:13px;color:#03365a;font-weight:700;">${esc(r.value)}</span>
          </div>`).join("")}
        ${ds.wordFile ? `
          <a href="/sachiko/label-stock/file/${esc(ds.wordFile)}"
            style="display:inline-flex;align-items:center;gap:6px;margin-top:4px;color:#044a78;font-weight:600;text-decoration:none;font-size:13px;">
            <i class="fa-solid fa-file-word"></i> ${esc(ds.wordFileOriginalName || ds.wordFile)}
          </a>` : ""}
      </div>`;
    modal.style.display = "flex";
  };

  // Deferred to DOMContentLoaded: the dialog markup below is later in the
  // document than this script tag, so it doesn't exist yet at this point.
  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("ds-view-modal").addEventListener("click", function(e) {
      if (e.target === this) this.style.display = "none";
    });
  });

  /* ── Delete ── */
  window.deleteLabelStock = function(id, code) {
    const dialog = document.getElementById("ds-delete-dialog");
    document.getElementById("ds-delete-msg").textContent = `Delete Label Stock "${code}"? This cannot be undone.`;
    dialog.style.display = "flex";
    document.getElementById("ds-delete-confirm").onclick = async () => {
      dialog.style.display = "none";
      try {
        const resp = await fetch(`/sachiko/label-stock/${id}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
        });
        const data = await resp.json();
        if (data.success) {
          table.deleteRow(table.getRows().find(r => r.getData()._id === id));
          if (typeof showToast === "function") showToast("Label Stock deleted", "success");
        } else {
          if (typeof showToast === "function") showToast(data.message || "Delete failed", "error");
        }
      } catch {
        if (typeof showToast === "function") showToast("Delete failed", "error");
      }
    };
    document.getElementById("ds-delete-cancel").onclick = () => { dialog.style.display = "none"; };
  };

  /* ── Create Label Stock Dialog ──
     Deferred to DOMContentLoaded: the dialog markup lives later in the
     document than this script tag, so it doesn't exist yet at this point. */
  document.addEventListener("DOMContentLoaded", () => {
    const lsPreviewSkuCode = <%- safeJson(previewSkuCode) %>;

    const LS_ROLL_TYPE_ORDER = {
      "NORMAL": ["facestock1", "adhesive1", "release1"],
      "DOUBLE RELEASE": ["facestock1", "adhesive1", "release1", "adhesive2", "release2"],
      "DOUBLE FACESTOCK": ["facestock1", "adhesive1", "facestock2", "adhesive2", "release1"],
    };

    const lsForm = document.getElementById("ls-create-form");
    const lsFieldsEnd = document.getElementById("ls-fields-end");
    const lsBlocks = {};
    lsForm.querySelectorAll(".ls-block").forEach((el) => { lsBlocks[el.dataset.block] = el; });
    const lsArrows = {};
    lsForm.querySelectorAll(".layer-arrow[data-arrow-after]").forEach((el) => { lsArrows[el.dataset.arrowAfter] = el; });

    function lsApplyRollType(rollType) {
      const order = LS_ROLL_TYPE_ORDER[rollType] || LS_ROLL_TYPE_ORDER.NORMAL;

      Object.keys(lsBlocks).forEach((key) => {
        const el = lsBlocks[key];
        const visible = order.includes(key);
        el.style.display = visible ? "" : "none";
        el.querySelectorAll("[data-required-when-visible]").forEach((field) => { field.required = visible; });
      });

      Object.keys(lsArrows).forEach((key) => {
        const idx = order.indexOf(key);
        lsArrows[key].style.display = idx !== -1 && idx < order.length - 1 ? "flex" : "none";
      });

      order.forEach((key) => {
        const el = lsBlocks[key];
        if (el) lsForm.insertBefore(el, lsFieldsEnd);
        const arrow = lsArrows[key];
        if (arrow) lsForm.insertBefore(arrow, lsFieldsEnd);
      });
    }

    // Auto-calculate Facestock Micron from GSM (micron = gsm / density) for both layers.
    const LS_FACESTOCK_DENSITY = 0.92;
    [["lsFacestockGsm", "lsFacestockMicron"], ["lsFacestockGsm2", "lsFacestockMicron2"]].forEach(([gsmId, micronId]) => {
      const gsmInput = document.getElementById(gsmId);
      const micronInput = document.getElementById(micronId);
      gsmInput?.addEventListener("input", () => {
        const gsm = Number(gsmInput.value);
        micronInput.value = gsmInput.value !== "" && Number.isFinite(gsm)
          ? (gsm / LS_FACESTOCK_DENSITY).toFixed(1)
          : "";
      });
    });

    const lsRollTypeSelect = document.getElementById("lsRollType");
    lsRollTypeSelect.addEventListener("change", () => lsApplyRollType(lsRollTypeSelect.value));

    // Choices.js instances -- destroyed and rebuilt every time the dialog opens
    // (CLAUDE.md dialog pattern: destroy/reinit rather than reuse across opens).
    let lsChoices = {};
    function lsInitChoices(id, opts) {
      if (lsChoices[id]) { lsChoices[id].destroy(); delete lsChoices[id]; }
      const el = document.getElementById(id);
      if (el) lsChoices[id] = new Choices(el, opts || { searchEnabled: false, shouldSort: false, itemSelectText: "" });
    }

    function showLsError(msg) {
      document.getElementById("ls-create-error").textContent = msg;
    }
    function hideLsError() {
      document.getElementById("ls-create-error").textContent = "";
    }

    window.openCreateLabelStockDialog = function () {
      lsForm.reset();
      document.getElementById("lsSkuCode").value = lsPreviewSkuCode;
      hideLsError();

      ["lsRollType", "lsFacestockFamily", "lsFacestockType", "lsAdhesiveType", "lsReleaseLinerType", "lsReleaseLinerColor",
        "lsFacestockFamily2", "lsFacestockType2", "lsAdhesiveType2", "lsReleaseLinerType2", "lsReleaseLinerColor2",
      ].forEach((id) => lsInitChoices(id));

      lsApplyRollType("NORMAL");
      document.getElementById("ls-create-modal").style.display = "flex";
    };

    window.closeCreateLabelStockDialog = function () {
      document.getElementById("ls-create-modal").style.display = "none";
    };

    document.getElementById("ls-create-modal").addEventListener("click", function (e) {
      if (e.target === this) closeCreateLabelStockDialog();
    });

    window.submitCreateLabelStock = async function () {
      if (!lsForm.reportValidity()) return;

      const btn = document.getElementById("ls-create-submit-btn");
      btn.disabled = true;
      hideLsError();
      try {
        const res = await fetch("/sachiko/label-stock/form", { method: "POST", body: new FormData(lsForm) });
        const data = await res.json().catch(() => null);
        if (data?.success) {
          window.location.href = data.redirect || "/sachiko/label-stock/view";
        } else {
          showLsError(data?.message || "Failed to create Label Stock.");
        }
      } catch {
        showLsError("Server error. Please try again.");
      } finally {
        btn.disabled = false;
      }
    };
  });
</script>

