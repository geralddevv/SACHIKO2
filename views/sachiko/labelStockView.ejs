  /* ── Delete ── */
  window.deleteLabelStock = function(id, code) {
    const dialog = document.getElementById("ds-delete-dialog");
    document.getElementById("ds-delete-msg").textContent = `Delete Label Stock "${code}"? This cannot be undone.`;
    dialog.style.display = "flex";
    document.getElementById("ds-delete-confirm").onclick = async () => {
      dialog.style.display = "none";
      try {
        const resp = await fetch(`/sachiko/label-stock/${id}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
        });
        const data = await resp.json();
        if (data.success) {
          // A deleted row might be a variant nested under another Product
          // Code's dropdown (or the base row a dropdown hangs off of), so
          // rebuild the whole tree from the trimmed `raw` array rather than
          // trying to locate and remove a single (possibly nested) Tabulator
          // row -- table.getRows() alone only sees top-level rows.
          const idx = raw.findIndex(d => String(d._id) === id);
          if (idx !== -1) raw.splice(idx, 1);
          table.setData(buildLabelStockTreeData(buildLabelStockTableData(raw)));
          if (typeof showToast === "function") showToast("Label Stock deleted", "success");
        } else {
          if (typeof showToast === "function") showToast(data.message || "Delete failed", "error");
        }
      } catch {
        if (typeof showToast === "function") showToast("Delete failed", "error");
      }
    };
    document.getElementById("ds-delete-cancel").onclick = () => { dialog.style.display = "none"; };
  };

  /* ── Create Label Stock Dialog ──
     Deferred to DOMContentLoaded: the dialog markup lives later in the
     document than this script tag, so it doesn't exist yet at this point. */
  document.addEventListener("DOMContentLoaded", () => {
    const lsPreviewSkuCode = <%- safeJson(previewSkuCode) %>;
    const lsFacestockMasters = <%- safeJson(facestockMasters) %>;
    const lsAdhesiveMasters = <%- safeJson(adhesiveMasters) %>;
    const lsReleaseMasters = <%- safeJson(releaseMasters) %>;

    const LS_ROLL_TYPE_ORDER = {
      "NORMAL": ["facestock1", "adhesive1", "release1"],
      "DOUBLE RELEASE": ["facestock1", "adhesive1", "release1", "adhesive2", "release2"],
      "DOUBLE FACESTOCK": ["facestock1", "adhesive1", "facestock2", "adhesive2", "release1"],
    };

    // null while the dialog is in "New" mode; set to a Label Stock _id while
    // editing that record, so submitCreateLabelStock knows which endpoint to
    // POST to and openCreateLabelStockDialog knows to reset back to "New".
    let lsEditId = null;

    const lsForm = document.getElementById("ls-create-form");
    const lsFieldsEnd = document.getElementById("ls-fields-end");
    const lsBlocks = {};
    lsForm.querySelectorAll(".ls-block").forEach((el) => { lsBlocks[el.dataset.block] = el; });
    const lsArrows = {};
    lsForm.querySelectorAll(".layer-arrow[data-arrow-after]").forEach((el) => { lsArrows[el.dataset.arrowAfter] = el; });

    function lsApplyRollType(rollType) {
      const order = LS_ROLL_TYPE_ORDER[rollType] || LS_ROLL_TYPE_ORDER.NORMAL;

      Object.keys(lsBlocks).forEach((key) => {
        const el = lsBlocks[key];
        const visible = order.includes(key);
        el.style.display = visible ? "" : "none";
        el.querySelectorAll("[data-required-when-visible]").forEach((field) => { field.required = visible; });
      });

      Object.keys(lsArrows).forEach((key) => {
        const idx = order.indexOf(key);
        lsArrows[key].style.display = idx !== -1 && idx < order.length - 1 ? "flex" : "none";
      });

      order.forEach((key) => {
        const el = lsBlocks[key];
        if (el) lsForm.insertBefore(el, lsFieldsEnd);
        const arrow = lsArrows[key];
        if (arrow) lsForm.insertBefore(arrow, lsFieldsEnd);
      });
    }

    const lsRollTypeSelect = document.getElementById("lsRollType");
    lsRollTypeSelect.addEventListener("change", () => lsApplyRollType(lsRollTypeSelect.value));

    // Choices.js instances -- destroyed and rebuilt every time the dialog opens
    // (CLAUDE.md dialog pattern: destroy/reinit rather than reuse across opens).
    let lsChoices = {};
    function lsInitChoices(id, opts) {
      if (lsChoices[id]) { lsChoices[id].destroy(); delete lsChoices[id]; }
      const el = document.getElementById(id);
      if (el) lsChoices[id] = new Choices(el, opts || { searchEnabled: false, shouldSort: false, itemSelectText: "" });
    }

    // Roll Type/Family/Roll-Sheet/Laser-Ink keep a static, hardcoded
    // <option> list in the HTML (unlike the cascade fields, which rebuild
    // their own markup via fsSetSelectOptions) -- setting the <select>'s
    // `.value` property doesn't move the `selected` ATTRIBUTE onto the
    // right <option>, and per CLAUDE.md's Choices.js convention that
    // attribute (not the live `.value`) is what `new Choices()` actually
    // reads when it's constructed right after this, so the widget kept
    // showing whichever option was hardcoded `selected` in the template
    // instead of the record's real saved value.
    function lsSelectStaticOption(select, value) {
      const options = Array.from(select.options);
      const match = value ? options.find((o) => o.value === value) : null;
      options.forEach((o) => o.removeAttribute("selected"));
      (match || options.find((o) => o.value === ""))?.setAttribute("selected", "");
    }

    function showLsError(msg) {
      document.getElementById("ls-create-error").textContent = msg;
    }
    function hideLsError() {
      document.getElementById("ls-create-error").textContent = "";
    }

    // Prefixes a field's own label with which layer card it belongs to
    // (facestock1/2, adhesive1/2, release1/2) -- "Type" alone is ambiguous
    // with two facestock cards on screen, "Facestock 2 Type" isn't.
    const LS_BLOCK_LABELS = {
      facestock1: "Facestock", facestock2: "Facestock 2",
      adhesive1: "Adhesive", adhesive2: "Adhesive 2",
      release1: "Release Liner", release2: "Release Liner 2",
    };
    function lsFieldLabel(field) {
      const ownLabel = field.closest(".dialog-field, .layer-field")?.querySelector("label")?.textContent?.trim() || field.name || field.id;
      const blockLabel = LS_BLOCK_LABELS[field.closest(".layer-card")?.dataset.block];
      return blockLabel ? `${blockLabel} ${ownLabel}` : ownLabel;
    }

    // Every currently-required field that's actually empty/invalid, in one
    // pass -- required-when-visible fields (layer cards hidden for the
    // current roll type, Laser/Ink hidden outside Sheet+Digital) already
    // have their `required` attribute cleared while hidden (see
    // lsApplyRollType / lsUpdateDigitalPrintTypeVisibility), so they're
    // naturally skipped here without extra visibility checks.
    function lsFindMissingFields() {
      const fields = [];
      lsForm.querySelectorAll("[required]").forEach((field) => {
        if (!field.checkValidity()) fields.push(field);
      });
      return { labels: fields.map(lsFieldLabel), firstField: fields[0] || null };
    }

    // Smart filter, any order (mirrors /sachiko/form/tape-binding's Paper
    // Code/Type/GSM/... fields): every field in a layer card is fillable
    // from the start, none disabled waiting on an earlier pick. Picking any
    // one field re-filters every OTHER field in its group down to the
    // combinations that actually occur together in the master data given
    // what's picked so far -- it never lets you land on a spec that isn't
    // there. If that narrows another field to exactly one option, it fills
    // itself in, which re-filters the rest the same way, cascading until
    // nothing more can be narrowed.
    const FS_NONE = "__FS_NONE__";

    function fsFieldOptions(pool, field) {
      const seen = new Map();
      let hasEmpty = false;
      pool.forEach((r) => {
        const raw = r[field];
        const val = (raw === undefined || raw === null || String(raw).trim() === "") ? "" : String(raw).trim();
        if (val === "") { hasEmpty = true; return; }
        if (!seen.has(val)) seen.set(val, val);
      });
      const opts = [...seen.keys()]
        .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
        .map((v) => ({ value: v, label: v }));
      if (hasEmpty) opts.push({ value: FS_NONE, label: "— None —" });
      return opts;
    }

    function fsVendorOptions(pool) {
      const seen = new Map();
      pool.forEach((r) => {
        if (!r.vendorId) return;
        const id = String(r.vendorId);
        if (!seen.has(id)) seen.set(id, r.vendorName || id);
      });
      return [...seen.entries()]
        .sort((a, b) => a[1].localeCompare(b[1]))
        .map(([value, label]) => ({ value, label }));
    }

    function fsMatch(recordVal, selected) {
      if (selected === FS_NONE) return recordVal === undefined || recordVal === null || String(recordVal).trim() === "";
      return String(recordVal ?? "").trim() === selected;
    }

    // `undefined` means the key is missing from the saved sub-document
    // entirely -- only possible on a record saved before this field existed
    // on the form (every current save writes it as at least "", via the
    // server's trim() helper, never omits the key) -- so it's unconstrained,
    // same as an unset vendorId a few lines below, rather than forced to
    // FS_NONE. Conflating the two used to hard-filter the seed pool down to
    // master rows that are ALSO blank on that field, which for a field every
    // real master row actually fills in (e.g. Vendor SKU Code) resolved to
    // zero rows and blanked out the whole card, including fields that DID
    // have a saved value. An explicit "" (the user picked "— None —" and it
    // got saved) still means FS_NONE -- that's a real, deliberate value.
    function fsDesiredValue(raw) {
      if (raw === undefined) return "";
      return (raw === null || String(raw).trim() === "") ? FS_NONE : String(raw).trim();
    }

    // CLAUDE.md's Choices.js convention: pre-selecting a value has to be
    // baked into the `<option>` markup as a `selected` attribute before
    // `new Choices()` runs (see reinit(els[key].id) right after this is
    // called in fsRebuildGroup below) -- setting the plain <select>'s
    // `.value` property afterward, as this used to do, doesn't reliably
    // carry into the widget Choices builds from that markup, so every
    // cascade field silently failed to show its prefilled value on Edit.
    function fsSetSelectOptions(select, placeholder, options, keepValue) {
      const hasKeep = !!keepValue && options.some((o) => o.value === keepValue);
      select.innerHTML = [`<option value="" disabled${hasKeep ? "" : " selected"} hidden>${placeholder}</option>`]
        .concat(options.map((o) => `<option value="${o.value}"${hasKeep && o.value === keepValue ? " selected" : ""}>${o.label}</option>`))
        .join("");
      select.disabled = options.length === 0;
    }

    // Field key order per group -- drives both "what filters what" (every
    // field is filtered by every OTHER field currently set, regardless of
    // position) and the skuBadge's "all resolved" check. GSM has no Adhesive
    // Master equivalent, so it's excluded there and stays a plain typed
    // number.
    // Size (Facestock/Release Liner) and Shelf Life (Adhesive) are
    // deliberately excluded from all three -- removed from the form
    // entirely (see their layer-field markup below, or lack of it), not
    // just left out of narrowing: several real Master rows can share every
    // other identity field and differ only in Size, or in Shelf Life having
    // drifted stale, either of which used to turn an otherwise-clean match
    // into "no match"/"ambiguous" for every other field in the same card.
    const FS_ORDER = ["family", "type", "make", "vendorId", "vendorSkuCode", "gsm", "micron"];
    const AD_ORDER = ["type", "make", "vendorId", "vendorSkuCode", "viscosity", "cohesion", "shear", "density"];
    const RL_ORDER = ["type", "make", "vendorId", "vendorSkuCode", "color", "gsm"];

    function fsFieldMatches(key, record, value) {
      if (key === "vendorId") return String(record.vendorId ?? "") === value;
      return fsMatch(record[key], value);
    }

    // `desired` (only passed for the Edit page's first render) seeds every
    // field from the saved record instead of reading the live <select>
    // values -- a plain <select> can't have its .value set to something
    // that isn't yet one of its <option>s, so the seed pass has to supply
    // the target values explicitly as the options are built. Because every
    // desired value is known up front, seeding doesn't need an order either
    // -- each field is just filtered by every other field's desired value.
    function fsCurrentValue(key, els, desired) {
      if (desired) return key === "vendorId" ? (desired.vendorId ? String(desired.vendorId) : "") : fsDesiredValue(desired[key]);
      return els[key].value;
    }

    function fsOptionsForField(key, pool) {
      return key === "vendorId" ? fsVendorOptions(pool) : fsFieldOptions(pool, key);
    }

    function fsKeyByElId(order, els) {
      const map = {};
      order.forEach((key) => { if (els[key]) map[els[key].id] = key; });
      return map;
    }

    // `skip` leaves the field the user just picked untouched -- rebuilding
    // it from its own new pool would be pointless (its value is what
    // produced that pool) and would risk fighting the user's own click.
    function fsRebuildGroup(order, masters, els, reinit, opts) {
      opts = opts || {};
      const desired = opts.desired || null;
      const skip = opts.skip || null;

      const current = {};
      order.forEach((key) => { current[key] = fsCurrentValue(key, els, desired); });

      const autoFilled = [];
      order.forEach((key) => {
        if (key === skip || !els[key]) return;
        const pool = masters.filter((r) => order.every((k) => {
          if (k === key) return true;
          const v = current[k];
          return !v || fsFieldMatches(k, r, v);
        }));
        const fieldOptions = fsOptionsForField(key, pool);
        const priorValue = current[key];
        let want = priorValue && fieldOptions.some((o) => o.value === priorValue) ? priorValue : "";
        // Auto-fill only ever cascades from an actual user pick (`skip` set,
        // meaning this call was triggered by a real field change) or a prior
        // auto-fill within that same cascade -- never on the initial open or
        // a reset, so the dialog never shows up pre-filled just because some
        // column happens to have a single value across the whole master.
        if (!want && skip && fieldOptions.length === 1) want = fieldOptions[0].value;
        fsSetSelectOptions(els[key], "Search", fieldOptions, want);
        reinit(els[key].id);
        current[key] = els[key].value;
        if (skip && current[key] && current[key] !== priorValue) autoFilled.push(key);
      });

      // Once every field in the group has a value AND that combination
      // matches at least one master row, show a plain "OK" status badge next
      // to the card's heading (not the master's own SKU id -- that's an
      // internal catalog reference, not something the label stock form needs
      // to surface). An unselected field is "no constraint" for narrowing
      // OTHER fields' options, but here it must NOT be treated that way --
      // otherwise, with nothing picked yet, the whole unfiltered master pool
      // counts, and if that master happens to hold only one row total the
      // badge would show before any real selection.
      //
      // Not "exactly one row" -- Size (Facestock/Release Liner) and Shelf
      // Life (Adhesive) are deliberately excluded from `order` now (see the
      // comment where FS_ORDER/AD_ORDER/RL_ORDER are declared), and several
      // real Master catalogs have more than one row that's identical on
      // every field still checked here, differing only in one of those two.
      // Once that's the only thing left disagreeing, it's not a real
      // ambiguity anymore -- requiring a single row would mean this badge
      // could never show for those recipes again.
      const allSet = order.every((k) => !!current[k]);
      const finalPool = allSet ? masters.filter((r) => order.every((k) => fsFieldMatches(k, r, current[k]))) : [];
      if (els.skuBadge) {
        if (finalPool.length > 0) {
          els.skuBadge.textContent = "OK";
          els.skuBadge.style.display = "";
        } else {
          els.skuBadge.textContent = "";
          els.skuBadge.style.display = "none";
        }
      }

      // A field that just auto-filled may have narrowed the rest further --
      // re-run (skipping only that field) until nothing more narrows. Not
      // needed while seeding: every field's target value is already known.
      if (!desired && autoFilled.length > 0) fsRebuildGroup(order, masters, els, reinit, { skip: autoFilled[0] });
    }

    function fsRebuildCascade(masters, els, reinit, opts) { fsRebuildGroup(FS_ORDER, masters, els, reinit, opts); }
    function adRebuildCascade(masters, els, reinit, opts) { fsRebuildGroup(AD_ORDER, masters, els, reinit, opts); }
    function rlRebuildCascade(masters, els, reinit, opts) { fsRebuildGroup(RL_ORDER, masters, els, reinit, opts); }

    // The cascade above reads `desired.family`/`.type`/`.make`/`.vendorId`/
    // `.vendorSkuCode`/`.gsm`/`.micron` etc. -- short generic keys shared
    // across all three layer types, matching FS_ORDER/AD_ORDER/RL_ORDER and
    // the master documents' own field names. A saved Label Stock's
    // facestock/adhesive/releaseLiner instead store them prefixed
    // ("facestockFamily", "adhesiveType", "releaseLinerColor", ...), so
    // they're remapped here before being handed to openEditLabelStockDialog
    // below -- passing them through as-is would leave every `desired[key]`
    // lookup undefined and silently fail to prefill anything.
    function lsRemapFsLayer(layer) {
      if (!layer) return null;
      return {
        family: layer.facestockFamily, type: layer.facestockType, make: layer.facestockMake,
        vendorId: layer.facestockVendorId, vendorName: layer.facestockVendorName,
        vendorSkuCode: layer.facestockVendorSkuCode,
        gsm: layer.facestockGsm, micron: layer.facestockMicron,
      };
    }
    function lsRemapAdLayer(layer) {
      if (!layer) return null;
      return {
        type: layer.adhesiveType, make: layer.adhesiveMake, vendorId: layer.adhesiveVendorId,
        vendorName: layer.adhesiveVendorName,
        vendorSkuCode: layer.adhesiveVendorSkuCode,
        viscosity: layer.adhesiveViscosity, cohesion: layer.adhesiveCohesion,
        shear: layer.adhesiveShear, density: layer.adhesiveDensity,
      };
    }
    function lsRemapRlLayer(layer) {
      if (!layer) return null;
      return {
        type: layer.releaseLinerType, make: layer.releaseLinerMake, vendorId: layer.releaseLinerVendorId,
        vendorName: layer.releaseLinerVendorName, vendorSkuCode: layer.releaseLinerVendorSkuCode,
        color: layer.releaseLinerColor, gsm: layer.releaseLinerGsm,
      };
    }

    function fsFieldSet(suffix) {
      return {
        family: document.getElementById("lsFacestockFamily" + suffix),
        type: document.getElementById("lsFacestockType" + suffix),
        make: document.getElementById("lsFacestockMake" + suffix),
        vendorId: document.getElementById("lsFacestockVendorId" + suffix),
        vendorSkuCode: document.getElementById("lsFacestockVendorSkuCode" + suffix),
        skuBadge: document.getElementById("lsFacestockSkuId" + suffix),
        gsm: document.getElementById("lsFacestockGsm" + suffix),
        micron: document.getElementById("lsFacestockMicron" + suffix),
      };
    }
    const lsFsEls1 = fsFieldSet("");
    const lsFsEls2 = fsFieldSet("2");
    const lsFsKeyById1 = fsKeyByElId(FS_ORDER, lsFsEls1);
    const lsFsKeyById2 = fsKeyByElId(FS_ORDER, lsFsEls2);
    const lsFsIds1 = new Set(Object.keys(lsFsKeyById1));
    const lsFsIds2 = new Set(Object.keys(lsFsKeyById2));

    function adFieldSet(suffix) {
      return {
        type: document.getElementById("lsAdhesiveType" + suffix),
        make: document.getElementById("lsAdhesiveMake" + suffix),
        vendorId: document.getElementById("lsAdhesiveVendorId" + suffix),
        vendorSkuCode: document.getElementById("lsAdhesiveVendorSkuCode" + suffix),
        viscosity: document.getElementById("lsAdhesiveViscosity" + suffix),
        cohesion: document.getElementById("lsAdhesiveCohesion" + suffix),
        shear: document.getElementById("lsAdhesiveShear" + suffix),
        density: document.getElementById("lsAdhesiveDensity" + suffix),
        skuBadge: document.getElementById("lsAdhesiveSkuId" + suffix),
      };
    }
    const lsAdEls1 = adFieldSet("");
    const lsAdEls2 = adFieldSet("2");
    const lsAdKeyById1 = fsKeyByElId(AD_ORDER, lsAdEls1);
    const lsAdKeyById2 = fsKeyByElId(AD_ORDER, lsAdEls2);
    const lsAdIds1 = new Set(Object.keys(lsAdKeyById1));
    const lsAdIds2 = new Set(Object.keys(lsAdKeyById2));

    function rlFieldSet(suffix) {
      return {
        type: document.getElementById("lsReleaseLinerType" + suffix),
        make: document.getElementById("lsReleaseLinerMake" + suffix),
        vendorId: document.getElementById("lsReleaseLinerVendorId" + suffix),
        vendorSkuCode: document.getElementById("lsReleaseLinerVendorSkuCode" + suffix),
        color: document.getElementById("lsReleaseLinerColor" + suffix),
        gsm: document.getElementById("lsReleaseLinerGsm" + suffix),
        skuBadge: document.getElementById("lsReleaseLinerSkuId" + suffix),
      };
    }
    const lsRlEls1 = rlFieldSet("");
    const lsRlEls2 = rlFieldSet("2");
    const lsRlKeyById1 = fsKeyByElId(RL_ORDER, lsRlEls1);
    const lsRlKeyById2 = fsKeyByElId(RL_ORDER, lsRlEls2);
    const lsRlIds1 = new Set(Object.keys(lsRlKeyById1));
    const lsRlIds2 = new Set(Object.keys(lsRlKeyById2));

    // One Reset button per layer card (see the .layer-card__reset-btn markup
    // on each FACESTOCK/ADHESIVE/RELEASE LINER card above) -- the smart-filter
    // cascade only ever narrows a group's options forward as fields get
    // picked (fsRebuildGroup), so once a card is fully (or even partly)
    // filled in, there's no way back to a wider set without clearing fields
    // by hand one at a time, fighting the very auto-fill that just narrowed
    // them. This clears one card's own fields and rebuilds it against the
    // full, unconstrained master pool -- the same call shape lsResetForm()
    // below already uses to blank every group when a fresh dialog opens,
    // just scoped to a single card instead of all six. adhesiveGsm is a
    // plain typed number outside the cascade (see adFieldSet -- Adhesive
    // Master has no GSM field of its own), so it's cleared separately.
    const LS_LAYER_RESET_GROUPS = {
      facestock1: { masters: lsFacestockMasters, els: lsFsEls1, rebuild: fsRebuildCascade },
      facestock2: { masters: lsFacestockMasters, els: lsFsEls2, rebuild: fsRebuildCascade },
      adhesive1: { masters: lsAdhesiveMasters, els: lsAdEls1, rebuild: adRebuildCascade, extraInputIds: ["lsAdhesiveGsm"] },
      adhesive2: { masters: lsAdhesiveMasters, els: lsAdEls2, rebuild: adRebuildCascade, extraInputIds: ["lsAdhesiveGsm2"] },
      release1: { masters: lsReleaseMasters, els: lsRlEls1, rebuild: rlRebuildCascade },
      release2: { masters: lsReleaseMasters, els: lsRlEls2, rebuild: rlRebuildCascade },
    };
    window.lsResetLayerGroup = function (blockKey) {
      const group = LS_LAYER_RESET_GROUPS[blockKey];
      if (!group) return;
      Object.values(group.els).forEach((el) => { if (el && el.tagName === "SELECT") el.value = ""; });
      (group.extraInputIds || []).forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.value = "";
      });
      group.rebuild(group.masters, group.els, lsInitChoices);
    };

    // Roll/Sheet -> Printing Technology options: SHEET opens Digital/Offset,
    // ROLL opens Flexographic/Gravure/Letter Press. Digital (Sheet-only) opens
    // a further Laser/Ink field.
    const LS_PRINTING_TECH_OPTIONS = {
      SHEET: ["DIGITAL", "OFFSET"],
      ROLL: ["FLEXOGRAPHIC", "GRAVURE", "LETTER PRESS"],
    };

    function lsRebuildPrintingTechnology(rollOrSheet, selectedValue) {
      const select = document.getElementById("lsPrintingTechnology");
      const options = LS_PRINTING_TECH_OPTIONS[rollOrSheet] || [];
      select.innerHTML = options.length
        ? '<option value="" disabled hidden>Select printing technology</option>' +
          options.map((o) => `<option value="${o}" ${o === selectedValue ? "selected" : ""}>${o}</option>`).join("")
        : '<option value="" disabled selected hidden>Select roll / sheet first</option>';
      if (!options.includes(selectedValue)) select.value = "";
      lsInitChoices("lsPrintingTechnology");
    }

    function lsUpdateDigitalPrintTypeVisibility(rollOrSheet, printingTechnology, selectedValue) {
      const wrap = document.getElementById("lsDigitalPrintTypeWrap");
      const select = document.getElementById("lsDigitalPrintType");
      const show = rollOrSheet === "SHEET" && printingTechnology === "DIGITAL";
      wrap.style.display = show ? "" : "none";
      select.required = show;
      lsSelectStaticOption(select, show ? selectedValue : "");
      lsInitChoices("lsDigitalPrintType");
      // Family/Roll-Sheet/Printing Technology stretch to fill the row when
      // Laser/Ink isn't shown, instead of leaving its column blank.
      document.getElementById("lsFamilyRow").style.gridTemplateColumns = show ? "1fr 1fr 1fr 1fr" : "1fr 1fr 1fr";
    }

    lsForm.addEventListener("change", function (e) {
      if (e.target.id === "lsRollOrSheet") {
        lsRebuildPrintingTechnology(e.target.value, "");
        lsUpdateDigitalPrintTypeVisibility(e.target.value, "", "");
      } else if (e.target.id === "lsPrintingTechnology") {
        const rollOrSheet = document.getElementById("lsRollOrSheet").value;
        lsUpdateDigitalPrintTypeVisibility(rollOrSheet, e.target.value, "");
      } else if (lsFsIds1.has(e.target.id)) {
        fsRebuildCascade(lsFacestockMasters, lsFsEls1, lsInitChoices, { skip: lsFsKeyById1[e.target.id] });
      } else if (lsFsIds2.has(e.target.id)) {
        fsRebuildCascade(lsFacestockMasters, lsFsEls2, lsInitChoices, { skip: lsFsKeyById2[e.target.id] });
      } else if (lsAdIds1.has(e.target.id)) {
        adRebuildCascade(lsAdhesiveMasters, lsAdEls1, lsInitChoices, { skip: lsAdKeyById1[e.target.id] });
      } else if (lsAdIds2.has(e.target.id)) {
        adRebuildCascade(lsAdhesiveMasters, lsAdEls2, lsInitChoices, { skip: lsAdKeyById2[e.target.id] });
      } else if (lsRlIds1.has(e.target.id)) {
        rlRebuildCascade(lsReleaseMasters, lsRlEls1, lsInitChoices, { skip: lsRlKeyById1[e.target.id] });
      } else if (lsRlIds2.has(e.target.id)) {
        rlRebuildCascade(lsReleaseMasters, lsRlEls2, lsInitChoices, { skip: lsRlKeyById2[e.target.id] });
      }
    });

    // Choices.js decides whether to flip a dropdown above its field by
    // comparing the dropdown's position against the browser *viewport*
    // height -- it has no idea #ls-create-form itself scrolls with a much
    // smaller visible height than the viewport. A field can sit nowhere
    // near the bottom of the window yet still be at the bottom of this
    // scrolling form (the Release Liner cards especially, being last in the
    // layer stack), so Choices never flips and the dropdown renders past
    // the form's own overflow-y: auto edge -- clipped away, not just
    // stacked behind something (z-index alone can't fix a clip). Forcing
    // the dropdown to `position: fixed`, placed from the field's own
    // (always viewport-relative) bounding box, makes it escape that clip
    // entirely and render in the viewport like a native popover.
    let lsOpenDropdownSelect = null;
    function lsPositionDropdown(select) {
      const wrap = select.closest(".choices");
      const list = wrap?.querySelector(".choices__list--dropdown");
      if (!wrap || !list) return;
      const rect = wrap.getBoundingClientRect();
      const spaceBelow = window.innerHeight - rect.bottom;
      const spaceAbove = rect.top;
      const openAbove = spaceBelow < 160 && spaceAbove > spaceBelow;

      list.style.position = "fixed";
      list.style.left = `${rect.left}px`;
      list.style.width = `${rect.width}px`;
      list.style.margin = "0";
      if (openAbove) {
        list.style.top = "auto";
        list.style.bottom = `${window.innerHeight - rect.top}px`;
        list.style.maxHeight = `${Math.max(spaceAbove - 8, 100)}px`;
      } else {
        list.style.top = `${rect.bottom}px`;
        list.style.bottom = "auto";
        list.style.maxHeight = `${Math.max(spaceBelow - 8, 100)}px`;
      }
    }
    function lsResetDropdownPosition(select) {
      const list = select.closest(".choices")?.querySelector(".choices__list--dropdown");
      if (!list) return;
      list.style.position = list.style.left = list.style.top = list.style.bottom = list.style.width = list.style.margin = list.style.maxHeight = "";
    }
    lsForm.addEventListener("showDropdown", (e) => {
      lsOpenDropdownSelect = e.target;
      lsPositionDropdown(e.target);
    });
    lsForm.addEventListener("hideDropdown", (e) => {
      lsResetDropdownPosition(e.target);
      if (lsOpenDropdownSelect === e.target) lsOpenDropdownSelect = null;
    });
    // Scrolling the form (or resizing the window) moves the field out from
    // under a dropdown positioned in fixed viewport coordinates -- keep it
    // glued to its field, same as a native <select> would behave.
    lsForm.addEventListener("scroll", () => { if (lsOpenDropdownSelect) lsPositionDropdown(lsOpenDropdownSelect); }, true);
    window.addEventListener("resize", () => { if (lsOpenDropdownSelect) lsPositionDropdown(lsOpenDropdownSelect); });

    // Shared by opening a fresh "New" dialog and closing the dialog (either
    // way) -- resets the form back to a blank slate, including the layer
    // cascades and roll-type layout, so nothing typed lingers into the next
    // open. Kept as one function so those two call sites can't drift apart.
    function lsResetForm() {
      lsForm.reset();
      lsEditId = null;
      document.getElementById("lsCurrentFileLink").style.display = "none";
      hideLsError();

      ["lsRollType", "lsFamily", "lsRollOrSheet"].forEach((id) => lsInitChoices(id));

      fsRebuildCascade(lsFacestockMasters, lsFsEls1, lsInitChoices);
      fsRebuildCascade(lsFacestockMasters, lsFsEls2, lsInitChoices);
      adRebuildCascade(lsAdhesiveMasters, lsAdEls1, lsInitChoices);
      adRebuildCascade(lsAdhesiveMasters, lsAdEls2, lsInitChoices);
      rlRebuildCascade(lsReleaseMasters, lsRlEls1, lsInitChoices);
      rlRebuildCascade(lsReleaseMasters, lsRlEls2, lsInitChoices);

      lsRebuildPrintingTechnology("", "");
      lsUpdateDigitalPrintTypeVisibility("", "", "");

      lsApplyRollType("NORMAL");
    }

    window.openCreateLabelStockDialog = function () {
      lsResetForm();
      document.getElementById("ls-dialog-title").textContent = "New Label Stock";
      document.getElementById("ls-create-submit-btn").textContent = "Save Label Stock";
      document.getElementById("lsSkuCode").value = lsPreviewSkuCode;
      document.getElementById("ls-create-modal").style.display = "flex";
    };

    // Edit uses the exact same dialog/form as Create (CLAUDE.md dialog
    // pattern) -- every field just gets seeded from the saved record first.
    // `raw` (the full jsonData the page already loaded for the table/View
    // modal) already carries everything needed, so no extra fetch is made.
    window.openEditLabelStockDialog = function (id) {
      const ds = raw.find((d) => String(d._id) === id);
      if (!ds) return;

      lsForm.reset();
      lsEditId = id;
      document.getElementById("ls-dialog-title").textContent = "Edit Label Stock";
      document.getElementById("ls-create-submit-btn").textContent = "Update Label Stock";
      hideLsError();

      document.getElementById("lsSkuCode").value = ds.skuCode || "";
      document.getElementById("lsProductCode").value = ds.productCode || "";

      const fileLink = document.getElementById("lsCurrentFileLink");
      if (ds.wordFile) {
        fileLink.href = `/sachiko/label-stock/file/${ds.wordFile}`;
        fileLink.title = ds.wordFileOriginalName || ds.wordFile;
        fileLink.style.display = "inline-flex";
      } else {
        fileLink.style.display = "none";
      }

      const rollType = ds.rollType || "NORMAL";
      lsSelectStaticOption(document.getElementById("lsRollType"), rollType);
      lsSelectStaticOption(document.getElementById("lsFamily"), ds.family || "");
      lsSelectStaticOption(document.getElementById("lsRollOrSheet"), ds.rollOrSheet || "");
      ["lsRollType", "lsFamily", "lsRollOrSheet"].forEach((id) => lsInitChoices(id));

      lsRebuildPrintingTechnology(ds.rollOrSheet || "", ds.printingTechnology || "");
      lsUpdateDigitalPrintTypeVisibility(ds.rollOrSheet || "", ds.printingTechnology || "", ds.digitalPrintType || "");

      fsRebuildCascade(lsFacestockMasters, lsFsEls1, lsInitChoices, { desired: lsRemapFsLayer(ds.facestock) });
      fsRebuildCascade(lsFacestockMasters, lsFsEls2, lsInitChoices, { desired: lsRemapFsLayer(ds.facestock2) });
      adRebuildCascade(lsAdhesiveMasters, lsAdEls1, lsInitChoices, { desired: lsRemapAdLayer(ds.adhesive) });
      adRebuildCascade(lsAdhesiveMasters, lsAdEls2, lsInitChoices, { desired: lsRemapAdLayer(ds.adhesive2) });
      rlRebuildCascade(lsReleaseMasters, lsRlEls1, lsInitChoices, { desired: lsRemapRlLayer(ds.releaseLiner) });
      rlRebuildCascade(lsReleaseMasters, lsRlEls2, lsInitChoices, { desired: lsRemapRlLayer(ds.releaseLiner2) });

      // GSM has no Adhesive Master equivalent (AD_ORDER excludes it), so it's
      // a plain typed number seeded directly rather than through the cascade.
      document.getElementById("lsAdhesiveGsm").value = ds.adhesive?.adhesiveGsm != null ? ds.adhesive.adhesiveGsm : "";
      document.getElementById("lsAdhesiveGsm2").value = ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm : "";

      lsApplyRollType(rollType);
      document.getElementById("ls-create-modal").style.display = "flex";
    };

    // Deliberately no backdrop-click-to-close here -- this form is long
    // enough that an accidental outside click shouldn't discard everything
    // typed. Closing only happens via the explicit Cancel/× controls, both
    // wired to closeCreateLabelStockDialog below.
    window.closeCreateLabelStockDialog = function () {
      document.getElementById("ls-create-modal").style.display = "none";
      lsResetForm();
    };

    window.submitCreateLabelStock = async function () {
      const { labels: missing, firstField } = lsFindMissingFields();
      if (missing.length > 0) {
        if (typeof showToast === "function") {
          showToast(`Please fill in: ${missing.join(", ")}`, "error");
        }
        if (firstField) {
          firstField.scrollIntoView({ behavior: "smooth", block: "center" });
          firstField.focus({ preventScroll: true });
        } else {
          lsForm.reportValidity();
        }
        return;
      }

      const btn = document.getElementById("ls-create-submit-btn");
      btn.disabled = true;
      hideLsError();
      try {
        const url = lsEditId ? `/sachiko/label-stock/edit/${lsEditId}` : "/sachiko/label-stock/form";
        const res = await fetch(url, { method: "POST", body: new FormData(lsForm) });
        const data = await res.json().catch(() => null);
        if (data?.success) {
          window.location.href = data.redirect || "/sachiko/label-stock/view";
        } else {
          showLsError(data?.message || `Failed to ${lsEditId ? "update" : "create"} Label Stock.`);
        }
      } catch {
        showLsError("Server error. Please try again.");
      } finally {
        btn.disabled = false;
      }
    };
  });
</script>

<!-- View Modal -->
<div id="ds-view-modal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:10000;justify-content:center;align-items:center;padding:24px;backdrop-filter:blur(4px);">
  <div id="ds-view-body" style="background:#fff;border-radius:14px;overflow:hidden;width:min(1200px,96vw);max-height:92vh;box-shadow:0 20px 50px rgba(4,74,120,0.2);animation:dsPopIn 0.2s ease-out;"></div>
</div>

<!-- Delete Confirm Dialog -->
<div id="ds-delete-dialog" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:10001;justify-content:center;align-items:center;">
