<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #master-table { width: 100%; flex: 1 1 auto; min-height: 0; }
    .tabulator-edit-list { scrollbar-width: none !important; -ms-overflow-style: none !important; }
    .tabulator-edit-list::-webkit-scrollbar { display: none !important; }
    .header-action-btn {
      background-color: #f0f0f0; color: #044a78;
      padding: 2px 14px; font-size: 14px; font-weight: 500;
      border: none; cursor: pointer; border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,.1);
      transition: all 0.2s ease-in-out;
      display: flex; align-items: center; justify-content: center;
    }
    .header-action-btn:hover { background-color: #e4e4e4; }

    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

    /* ── Create Label Stock dialog ── */
    .dialog-field-label {
      display: block; font-size: 13px; font-weight: 800; letter-spacing: 0.02em;
      color: #334155; text-transform: uppercase;
    }
    .dialog-field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
    #ls-create-form .choices[data-type*="select-one"]::after {
      display: block !important; content: "" !important; width: 13px !important; height: 9px !important;
      border-style: none !important; border-width: 0 !important;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
      background-repeat: no-repeat !important; background-size: contain !important;
      position: absolute !important; right: 13px !important; top: 50% !important; margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    #ls-create-form .choices[data-type*="select-one"].is-open::after { transform: translateY(-50%) rotate(180deg) !important; }
    /* Dropdown list must render above the dialog overlay. */
    #ls-create-form .choices__list--dropdown { z-index: 99999 !important; }

    /* Every select becomes a Choices.js widget once the dialog opens, which
       replaces the plain <select> with its own `.choices__inner` box -- so
       that's the element that actually needs to match the plain inputs'
       look (global .choices__inner otherwise renders a 1px black border
       with no fixed height, which is what read as "inconsistent"). */
    #ls-create-form .choices__inner {
      min-height: 2.65rem !important; height: 2.65rem !important; display: flex !important; align-items: center;
      padding: 0.45rem 0.85rem !important; border: 2px solid #94a3b8 !important; border-radius: 8px !important;
      background: #ffffff !important; font-size: 1.02rem !important;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    #ls-create-form .choices__list--single { padding: 0 !important; }
    /* Overflowing selected text (long vendor names, "GLOSSY PP PARTIAL", etc.)
       truncates with an ellipsis instead of overflowing the field. */
    #ls-create-form .choices__list--single .choices__item {
      font-size: 1.02rem; font-weight: 700; color: #0f172a;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; max-width: 100%;
    }
    #ls-create-form .choices__list--dropdown .choices__item {
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    #ls-create-form .choices:hover .choices__inner { border-color: #64748b !important; }
    #ls-create-form .choices.is-focused .choices__inner,
    #ls-create-form .choices.is-open .choices__inner {
      border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.18) !important;
    }
    .layer-card--adhesive .choices__inner { border-color: #d97706 !important; }

    /* Every field in the dialog -- the top Product row as well as the layer
       cards below -- shares this one look, so nothing reads as a different
       control halfway down the form. */
    #ls-create-form input.form-control,
    #ls-create-form select.form-control,
    #ls-create-form .dialog-field select {
      width: 100%; height: 2.65rem; padding: 0.45rem 0.85rem; border: 2px solid #94a3b8; border-radius: 8px;
      background: #ffffff; font-size: 1.02rem; font-weight: 700; color: #0f172a;
      transition: border-color 0.15s ease, box-shadow 0.15s ease; box-sizing: border-box;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    #ls-create-form input.form-control::placeholder { color: #64748b; font-weight: 500; }
    #ls-create-form input.form-control:hover,
    #ls-create-form select.form-control:hover,
    #ls-create-form .dialog-field select:hover { border-color: #64748b; }
    #ls-create-form input.form-control:focus,
    #ls-create-form select.form-control:focus,
    #ls-create-form .dialog-field select:focus {
      outline: none; border-color: #044a78; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.18);
    }
    #ls-create-form input.form-control[readonly] {
      background: #eef1f5; color: #334155; cursor: not-allowed;
    }
    /* File inputs can't take height/padding the same way -- match border/radius only. */
    #ls-create-form input[type="file"].form-control {
      height: auto; padding: 0.55rem 0.85rem; border: 2px solid #94a3b8; border-radius: 8px;
      background: #ffffff; font-size: 0.92rem; font-weight: 600; color: #334155; box-sizing: border-box;
    }

    .layer-card { border-radius: 10px; border: 2px solid; padding: 18px 20px 22px; box-shadow: 0 2px 5px rgba(15, 23, 42, 0.1); }
    .layer-card__label { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 900; letter-spacing: 0.06em; margin-bottom: 16px; }
    .layer-card__label::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: currentColor; flex: 0 0 auto; }
    /* Shown once every field in a layer card resolves to exactly one master
       row -- that row's own skuId, so the operator can see which master
       spec was picked. Plain text, not a pill/capsule. */
    .layer-card__sku-badge {
      font-family: monospace; font-size: 11px; font-weight: 600; letter-spacing: normal;
      text-transform: none; margin-left: 6px; opacity: 0.75;
    }
    .layer-card__fields { display: grid; gap: 16px; }
    .layer-field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
    .layer-field label { font-size: 13px; font-weight: 800; letter-spacing: 0.02em; color: #334155; text-transform: uppercase; }
    .layer-card--facestock { background: #ffffff; border-color: #60a5fa; }
    .layer-card--facestock .layer-card__label { color: #000000; }
    .layer-card--adhesive { background: #fffbeb; border-color: #f59e0b; }
    .layer-card--adhesive .layer-card__label { color: #92400e; }
    .layer-card--adhesive .layer-field input.form-control,
    .layer-card--adhesive .layer-field select.form-control { border-color: #d97706; }
    .layer-card--release { background: #eff6ff; border-color: #60a5fa; }
    .layer-card--release .layer-card__label { color: #1d4ed8; }

    .layer-arrow { display: flex; justify-content: center; margin: -5px 0; }
    .layer-arrow i { color: #94a3b8; font-size: 18px; }

    @media (max-width: 768px) {
      .layer-card__fields { grid-template-columns: 1fr !important; }
    }
  </style>

  <div class="indi-head">
    <h1>Label Stock View</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <button class="header-action-btn" onclick="openCreateLabelStockDialog()">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> New
      </button>
      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span><i class="fa-solid fa-file-arrow-down"></i> Download</span>
          <i class="fas fa-chevron-down"></i>
        </button>
        <div class="download-selector__menu">
          <div class="download-selector__option" id="download-pdf"><i class="fas fa-file-pdf"></i> PDF</div>
          <div class="download-selector__option" id="download-xlsx"><i class="fas fa-file-excel"></i> Excel</div>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table"></div>
</div>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script>
  /* ── Download dropdown ── */
  const downloadSelector = document.getElementById("downloadSelector");
  const triggerBtn = downloadSelector.querySelector(".download-selector__trigger");
  triggerBtn.addEventListener("click", (e) => { e.stopPropagation(); downloadSelector.classList.toggle("download-selector--active"); });
  document.addEventListener("click", () => downloadSelector.classList.remove("download-selector--active"));

  /* ── Flatten nested Label Stock docs for Tabulator ── */
  const raw = <%- safeJson(jsonData) %>;

  // Table stays to bare identity columns -- the full spec (Family, Roll/Sheet,
  // Printing Technology, every FS/AD/RL Family/Type/Make/Vendor/GSM/Micron/
  // Color/Shelf-Life field) lives in the View button's modal (viewLabelStock
  // below, reading straight from `raw`) instead of being duplicated here.
  const tableData = raw.map(ds => {
    const fsType = ds.facestock?.facestockType || "";
    const adType = ds.adhesive?.adhesiveType   || "";
    const rlType = ds.releaseLiner?.releaseLinerType || "";
    const micPart = ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC" : "";
    const product = [fsType, micPart, adType, rlType].filter(Boolean).join(" / ");

    return {
      _id: String(ds._id),
      skuCode: ds.skuCode || "",
      productCode: ds.productCode,
      rollType: ds.rollType || "NORMAL",
      product,
      wordFile: ds.wordFile || "",
    };
  });

  const withTextFilter = (col) => ({ headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, hozAlign: "center", headerHozAlign: "center", ...col });
  const withSelectFilter = (col, values) => ({ headerFilter: "list", headerFilterParams: { values, clearable: true }, hozAlign: "center", headerHozAlign: "center", ...col });

  const table = new Tabulator("#master-table", {
    data: tableData,
    height: "100%",
    initialSort: [{ column: "skuCode", dir: "asc" }],
    placeholder: "No Label Stocks found",
    columns: [
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        width: 110,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `
            <div style="display:flex;gap:5px;justify-content:center;align-items:center;white-space:nowrap;">
              <button onclick="viewLabelStock('${row._id}')"
                style="height:24px;padding:2px 9px;background:#111827;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px;display:inline-flex;align-items:center;gap:3px;font-weight:600;"
                onmouseover="this.style.background='#374151'" onmouseout="this.style.background='#111827'"
                title="View">
                <i class="fa-solid fa-eye"></i>
              </button>
              <a href="/sachiko/label-stock/edit/${row._id}"
                style="height:24px;padding:2px 9px;background:#3b82f6;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px;display:inline-flex;align-items:center;gap:3px;font-weight:600;text-decoration:none;"
                onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'"
                title="Edit">
                <i class="fa-solid fa-pencil"></i>
              </a>
              <button onclick="deleteLabelStock('${row._id}','${row.productCode}')"
                style="height:24px;padding:2px 9px;background:#ef4444;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px;display:inline-flex;align-items:center;gap:3px;font-weight:600;"
                onmouseover="this.style.background='#dc2626'" onmouseout="this.style.background='#ef4444'"
                title="Delete">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>`;
        },
      },
      withTextFilter({ title: "SKU", field: "skuCode", minWidth: 180 }),
      withTextFilter({ title: "Product Code", field: "productCode", width: 150, formatter: (cell) => `<span style="font-weight:700;color:#044a78;">${cell.getValue()}</span>` }),
      withTextFilter({ title: "Product",      field: "product",     minWidth: 220, formatter: (cell) => `<span style="font-weight:600;color:#03365a;">${cell.getValue()}</span>` }),
      withSelectFilter({ title: "Roll Type",  field: "rollType",  minWidth: 140,
        formatter: (cell) => {
          const v = cell.getValue() || "NORMAL";
          const label = v === "NORMAL" ? "STANDARD" : v;
          const color = v === "NORMAL" ? "#475569" : "#b45309";
          return `<span style="font-weight:600;color:${color};">${label}</span>`;
        } },
        { "": "All", "NORMAL": "STANDARD", "DOUBLE RELEASE": "DOUBLE RELEASE", "DOUBLE FACESTOCK": "DOUBLE FACESTOCK" }),
      { title: "Word File", field: "wordFile", minWidth: 110, headerFilter: false, hozAlign: "center", headerHozAlign: "center",
        formatter: (cell) => {
          const v = cell.getValue();
          return v ? `<a href="/sachiko/label-stock/file/${v}" style="color:#044a78;font-weight:600;text-decoration:none;" title="Download file"><i class="fa-solid fa-file-word" style="margin-right:4px;"></i>Download</a>` : `<span style="color:#aaa;">—</span>`;
        }
      },
    ],
  });

  document.getElementById("download-pdf").addEventListener("click", () =>
    table.download("pdf", "sachiko-label-stock.pdf", { orientation: "landscape", title: "Sachiko Label Stocks", autoTable: { styles: { fillColor: [4, 74, 120] } } }));
  document.getElementById("download-xlsx").addEventListener("click", () =>
    table.download("xlsx", "sachiko-label-stock.xlsx", { sheetName: "Label Stocks" }));

  /* ── View Modal ── */
  function esc(v) {
    return String(v ?? "—").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  window.viewLabelStock = function(id) {
    const ds = raw.find(d => String(d._id) === id);
    if (!ds) return;
    const modal = document.getElementById("ds-view-modal");

    const rollType = ds.rollType || "NORMAL";
    const baseRows = [
      { label: "Roll Type",         value: rollType === "NORMAL" ? "STANDARD" : rollType },
      { label: "Family",            value: ds.family },
      { label: "Roll / Sheet",      value: ds.rollOrSheet },
      { label: "Printing Technology", value: ds.printingTechnology },
      { label: "Laser / Ink",       value: ds.digitalPrintType },
      { label: "Facestock Family",  value: ds.facestock?.facestockFamily },
      { label: "Facestock Type",    value: ds.facestock?.facestockType },
      { label: "Facestock Make",         value: ds.facestock?.facestockMake },
      { label: "Facestock Vendor Name",  value: ds.facestock?.facestockVendorName },
      { label: "Facestock Vendor SKU Code", value: ds.facestock?.facestockVendorSkuCode },
      { label: "Facestock GSM",     value: ds.facestock?.facestockGsm    != null ? ds.facestock.facestockGsm + " GSM" : null },
      { label: "Facestock Micron",  value: ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC" : null },
      { label: "Adhesive Type",     value: ds.adhesive?.adhesiveType },
      { label: "Adhesive Make",         value: ds.adhesive?.adhesiveMake },
      { label: "Adhesive Vendor Name",  value: ds.adhesive?.adhesiveVendorName },
      { label: "Adhesive Vendor SKU Code", value: ds.adhesive?.adhesiveVendorSkuCode },
      { label: "Adhesive Shelf Life",   value: ds.adhesive?.adhesiveShelfLife },
      { label: "Adhesive GSM",      value: ds.adhesive?.adhesiveGsm      != null ? ds.adhesive.adhesiveGsm + " GSM" : null },
    ];
    const facestock2Rows = [
      { label: "Facestock Family (Layer 2)", value: ds.facestock2?.facestockFamily },
      { label: "Facestock Type (Layer 2)",   value: ds.facestock2?.facestockType },
      { label: "Facestock Make (Layer 2)",         value: ds.facestock2?.facestockMake },
      { label: "Facestock Vendor Name (Layer 2)",  value: ds.facestock2?.facestockVendorName },
      { label: "Facestock Vendor SKU Code (Layer 2)", value: ds.facestock2?.facestockVendorSkuCode },
      { label: "Facestock GSM (Layer 2)",    value: ds.facestock2?.facestockGsm    != null ? ds.facestock2.facestockGsm + " GSM" : null },
      { label: "Facestock Micron (Layer 2)", value: ds.facestock2?.facestockMicron != null ? ds.facestock2.facestockMicron + " MIC" : null },
    ];
    const adhesive2Rows = [
      { label: "Adhesive Type (Layer 2)", value: ds.adhesive2?.adhesiveType },
      { label: "Adhesive Make (Layer 2)",         value: ds.adhesive2?.adhesiveMake },
      { label: "Adhesive Vendor Name (Layer 2)",  value: ds.adhesive2?.adhesiveVendorName },
      { label: "Adhesive Vendor SKU Code (Layer 2)", value: ds.adhesive2?.adhesiveVendorSkuCode },
      { label: "Adhesive Shelf Life (Layer 2)",   value: ds.adhesive2?.adhesiveShelfLife },
      { label: "Adhesive GSM (Layer 2)",  value: ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null },
    ];
    const release1Rows = [
      { label: "Release Liner Type",  value: ds.releaseLiner?.releaseLinerType },
      { label: "Release Liner Make",        value: ds.releaseLiner?.releaseLinerMake },
      { label: "Release Liner Vendor Name", value: ds.releaseLiner?.releaseLinerVendorName },
      { label: "Release Liner Color", value: ds.releaseLiner?.releaseLinerColor },
      { label: "Release Liner GSM",   value: ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null },
    ];
    const release2Rows = [
      { label: "Release Liner Type (Layer 2)",  value: ds.releaseLiner2?.releaseLinerType },
      { label: "Release Liner Make (Layer 2)",        value: ds.releaseLiner2?.releaseLinerMake },
      { label: "Release Liner Vendor Name (Layer 2)", value: ds.releaseLiner2?.releaseLinerVendorName },
      { label: "Release Liner Color (Layer 2)", value: ds.releaseLiner2?.releaseLinerColor },
      { label: "Release Liner GSM (Layer 2)",   value: ds.releaseLiner2?.releaseLinerGsm != null ? ds.releaseLiner2.releaseLinerGsm + " GSM" : null },
    ];

    // Mirrors the create/edit form's block order for each roll type.
    let rows;
    if (rollType === "DOUBLE FACESTOCK") {
      rows = [...baseRows, ...facestock2Rows, ...adhesive2Rows, ...release1Rows];
    } else if (rollType === "DOUBLE RELEASE") {
      rows = [...baseRows, ...release1Rows, ...adhesive2Rows, ...release2Rows];
    } else {
      rows = [...baseRows, ...release1Rows];
    }

    /* ── Physical layer stack (top-to-bottom, same order as `rows`) ── */
    const LAYER_STYLE = {
      facestock: { bg: "#ffffff", border: "#93c5fd", text: "#000000", label: "FACESTOCK" },
      adhesive:  { bg: "#fffbeb", border: "#fcd34d", text: "#b45309", label: "ADHESIVE" },
      release:   { bg: "#eff6ff", border: "#93c5fd", text: "#1d4ed8", label: "RELEASE LINER" },
    };

    function layerBlock(kind, title, parts) {
      const s = LAYER_STYLE[kind];
      const detail = parts.filter(Boolean).join(" · ");
      return `
        <div style="background:${s.bg};border:1.5px solid ${s.border};border-radius:8px;padding:11px 16px;display:flex;justify-content:space-between;align-items:center;gap:12px;">
          <span style="font-size:12.5px;font-weight:800;letter-spacing:0.04em;color:${s.text};white-space:nowrap;">${s.label}</span>
          <span style="font-size:13.5px;font-weight:600;color:#334155;text-align:right;">${detail ? esc(detail) : "—"}${title ? ` <span style="color:${s.text};font-weight:700;">(${esc(title)})</span>` : ""}</span>
        </div>`;
    }

    let layers = [
      layerBlock("facestock", null, [ds.facestock?.facestockFamily, ds.facestock?.facestockType, ds.facestock?.facestockGsm != null ? ds.facestock.facestockGsm + " GSM" : null, ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC" : null]),
      layerBlock("adhesive", null, [ds.adhesive?.adhesiveType, ds.adhesive?.adhesiveGsm != null ? ds.adhesive.adhesiveGsm + " GSM" : null]),
    ];
    if (rollType === "DOUBLE FACESTOCK") {
      layers.push(
        layerBlock("facestock", "Layer 2", [ds.facestock2?.facestockFamily, ds.facestock2?.facestockType, ds.facestock2?.facestockGsm != null ? ds.facestock2.facestockGsm + " GSM" : null, ds.facestock2?.facestockMicron != null ? ds.facestock2.facestockMicron + " MIC" : null]),
        layerBlock("adhesive", "Layer 2", [ds.adhesive2?.adhesiveType, ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null]),
        layerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
      );
    } else if (rollType === "DOUBLE RELEASE") {
      layers.push(
        layerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
        layerBlock("adhesive", "Layer 2", [ds.adhesive2?.adhesiveType, ds.adhesive2?.adhesiveGsm != null ? ds.adhesive2.adhesiveGsm + " GSM" : null]),
        layerBlock("release", "Layer 2", [ds.releaseLiner2?.releaseLinerType, ds.releaseLiner2?.releaseLinerColor, ds.releaseLiner2?.releaseLinerGsm != null ? ds.releaseLiner2.releaseLinerGsm + " GSM" : null]),
      );
    } else {
      layers.push(
        layerBlock("release", null, [ds.releaseLiner?.releaseLinerType, ds.releaseLiner?.releaseLinerColor, ds.releaseLiner?.releaseLinerGsm != null ? ds.releaseLiner.releaseLinerGsm + " GSM" : null]),
      );
    }

    const layerStackHtml = `
      <div style="display:flex;flex-direction:column;gap:4px;">
        ${layers.join(`
        <div style="display:flex;justify-content:center;margin:-4px 0;"><i class="fa-solid fa-caret-down" style="color:#cbd5e1;font-size:14px;"></i></div>
        `)}
      </div>`;

    document.getElementById("ds-view-body").innerHTML = `
      <div style="background:linear-gradient(135deg,#044a78 0%,#03365a 100%);padding:26px 28px 24px;color:#fff;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
        <div>
          <h2 style="margin:0;font-size:23px;font-weight:700;">${esc(ds.productCode)}</h2>
          <p style="margin:8px 0 0;font-size:14px;opacity:0.85;">${esc(ds.labelStockId)}</p>
        </div>
        <button onclick="document.getElementById('ds-view-modal').style.display='none'"
          style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);color:#fff;border-radius:999px;padding:7px 15px;cursor:pointer;font-size:15px;font-weight:700;flex-shrink:0;"
          onmouseover="this.style.background='rgba(255,255,255,0.28)'" onmouseout="this.style.background='rgba(255,255,255,0.15)'">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="custom-scrollbar" style="padding:26px 28px;display:flex;flex-direction:column;gap:20px;overflow-y:auto;max-height:calc(90vh - 132px);">
        <div>
          <p style="margin:0 0 10px;font-size:12.5px;font-weight:700;color:#94a3b8;letter-spacing:0.05em;">LAYER STACK (TOP &rarr; BOTTOM)</p>
          ${layerStackHtml}
        </div>
        ${rows.map(r => `
          <div style="display:grid;grid-template-columns:190px 1fr;gap:14px;align-items:baseline;border-bottom:1px solid #f1f5f9;padding-bottom:12px;">
            <span style="font-size:14px;color:#64748b;font-weight:600;">${r.label}</span>
            <span style="font-size:14.5px;color:#03365a;font-weight:700;text-align:right;">${esc(r.value)}</span>
          </div>`).join("")}
        ${ds.wordFile ? `
          <a href="/sachiko/label-stock/file/${esc(ds.wordFile)}"
            style="display:inline-flex;align-items:center;gap:8px;margin-top:6px;color:#044a78;font-weight:600;text-decoration:none;font-size:14px;">
            <i class="fa-solid fa-file-word"></i> ${esc(ds.wordFileOriginalName || ds.wordFile)}
          </a>` : ""}
      </div>`;
    modal.style.display = "flex";
  };

  // Deferred to DOMContentLoaded: the dialog markup below is later in the
  // document than this script tag, so it doesn't exist yet at this point.
  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("ds-view-modal").addEventListener("click", function(e) {
      if (e.target === this) this.style.display = "none";
    });
  });

  /* ── Delete ── */
  window.deleteLabelStock = function(id, code) {
    const dialog = document.getElementById("ds-delete-dialog");
    document.getElementById("ds-delete-msg").textContent = `Delete Label Stock "${code}"? This cannot be undone.`;
    dialog.style.display = "flex";
    document.getElementById("ds-delete-confirm").onclick = async () => {
      dialog.style.display = "none";
      try {
        const resp = await fetch(`/sachiko/label-stock/${id}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
        });
        const data = await resp.json();
        if (data.success) {
          table.deleteRow(table.getRows().find(r => r.getData()._id === id));
          if (typeof showToast === "function") showToast("Label Stock deleted", "success");
        } else {
          if (typeof showToast === "function") showToast(data.message || "Delete failed", "error");
        }
      } catch {
        if (typeof showToast === "function") showToast("Delete failed", "error");
      }
    };
    document.getElementById("ds-delete-cancel").onclick = () => { dialog.style.display = "none"; };
  };

  /* ── Create Label Stock Dialog ──
     Deferred to DOMContentLoaded: the dialog markup lives later in the
     document than this script tag, so it doesn't exist yet at this point. */
  document.addEventListener("DOMContentLoaded", () => {
    const lsPreviewSkuCode = <%- safeJson(previewSkuCode) %>;
    const lsFacestockMasters = <%- safeJson(facestockMasters) %>;
    const lsAdhesiveMasters = <%- safeJson(adhesiveMasters) %>;
    const lsReleaseMasters = <%- safeJson(releaseMasters) %>;

    const LS_ROLL_TYPE_ORDER = {
      "NORMAL": ["facestock1", "adhesive1", "release1"],
      "DOUBLE RELEASE": ["facestock1", "adhesive1", "release1", "adhesive2", "release2"],
      "DOUBLE FACESTOCK": ["facestock1", "adhesive1", "facestock2", "adhesive2", "release1"],
    };

    const lsForm = document.getElementById("ls-create-form");
    const lsFieldsEnd = document.getElementById("ls-fields-end");
    const lsBlocks = {};
    lsForm.querySelectorAll(".ls-block").forEach((el) => { lsBlocks[el.dataset.block] = el; });
    const lsArrows = {};
    lsForm.querySelectorAll(".layer-arrow[data-arrow-after]").forEach((el) => { lsArrows[el.dataset.arrowAfter] = el; });

    function lsApplyRollType(rollType) {
      const order = LS_ROLL_TYPE_ORDER[rollType] || LS_ROLL_TYPE_ORDER.NORMAL;

      Object.keys(lsBlocks).forEach((key) => {
        const el = lsBlocks[key];
        const visible = order.includes(key);
        el.style.display = visible ? "" : "none";
        el.querySelectorAll("[data-required-when-visible]").forEach((field) => { field.required = visible; });
      });

      Object.keys(lsArrows).forEach((key) => {
        const idx = order.indexOf(key);
        lsArrows[key].style.display = idx !== -1 && idx < order.length - 1 ? "flex" : "none";
      });

      order.forEach((key) => {
        const el = lsBlocks[key];
        if (el) lsForm.insertBefore(el, lsFieldsEnd);
        const arrow = lsArrows[key];
        if (arrow) lsForm.insertBefore(arrow, lsFieldsEnd);
      });
    }

    const lsRollTypeSelect = document.getElementById("lsRollType");
    lsRollTypeSelect.addEventListener("change", () => lsApplyRollType(lsRollTypeSelect.value));

    // Choices.js instances -- destroyed and rebuilt every time the dialog opens
    // (CLAUDE.md dialog pattern: destroy/reinit rather than reuse across opens).
    let lsChoices = {};
    function lsInitChoices(id, opts) {
      if (lsChoices[id]) { lsChoices[id].destroy(); delete lsChoices[id]; }
      const el = document.getElementById(id);
      if (el) lsChoices[id] = new Choices(el, opts || { searchEnabled: false, shouldSort: false, itemSelectText: "" });
    }

    function showLsError(msg) {
      document.getElementById("ls-create-error").textContent = msg;
    }
    function hideLsError() {
      document.getElementById("ls-create-error").textContent = "";
    }

    // Smart filter, any order (mirrors /sachiko/form/tape-binding's Paper
    // Code/Type/GSM/... fields): every field in a layer card is fillable
    // from the start, none disabled waiting on an earlier pick. Picking any
    // one field re-filters every OTHER field in its group down to the
    // combinations that actually occur together in the master data given
    // what's picked so far -- it never lets you land on a spec that isn't
    // there. If that narrows another field to exactly one option, it fills
    // itself in, which re-filters the rest the same way, cascading until
    // nothing more can be narrowed.
    const FS_NONE = "__FS_NONE__";

    function fsFieldOptions(pool, field) {
      const seen = new Map();
      let hasEmpty = false;
      pool.forEach((r) => {
        const raw = r[field];
        const val = (raw === undefined || raw === null || String(raw).trim() === "") ? "" : String(raw).trim();
        if (val === "") { hasEmpty = true; return; }
        if (!seen.has(val)) seen.set(val, val);
      });
      const opts = [...seen.keys()]
        .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
        .map((v) => ({ value: v, label: v }));
      if (hasEmpty) opts.push({ value: FS_NONE, label: "— None —" });
      return opts;
    }

    function fsVendorOptions(pool) {
      const seen = new Map();
      pool.forEach((r) => {
        if (!r.vendorId) return;
        const id = String(r.vendorId);
        if (!seen.has(id)) seen.set(id, r.vendorName || id);
      });
      return [...seen.entries()]
        .sort((a, b) => a[1].localeCompare(b[1]))
        .map(([value, label]) => ({ value, label }));
    }

    function fsMatch(recordVal, selected) {
      if (selected === FS_NONE) return recordVal === undefined || recordVal === null || String(recordVal).trim() === "";
      return String(recordVal ?? "").trim() === selected;
    }

    function fsDesiredValue(raw) {
      return (raw === undefined || raw === null || String(raw).trim() === "") ? FS_NONE : String(raw).trim();
    }

    function fsSetSelectOptions(select, placeholder, options, keepValue) {
      select.innerHTML = ['<option value="" disabled selected hidden>' + placeholder + '</option>']
        .concat(options.map((o) => `<option value="${o.value}">${o.label}</option>`))
        .join("");
      select.value = keepValue && options.some((o) => o.value === keepValue) ? keepValue : "";
      select.disabled = options.length === 0;
    }

    // Field key order per group -- drives both "what filters what" (every
    // field is filtered by every OTHER field currently set, regardless of
    // position) and the skuBadge's "all resolved" check. GSM has no Adhesive
    // Master equivalent, so it's excluded there and stays a plain typed
    // number.
    const FS_ORDER = ["family", "type", "make", "vendorId", "vendorSkuCode", "gsm", "micron"];
    const AD_ORDER = ["type", "make", "vendorId", "vendorSkuCode", "shelfLife"];
    const RL_ORDER = ["type", "make", "vendorId", "color", "gsm"];

    function fsFieldMatches(key, record, value) {
      if (key === "vendorId") return String(record.vendorId ?? "") === value;
      return fsMatch(record[key], value);
    }

    // `desired` (only passed for the Edit page's first render) seeds every
    // field from the saved record instead of reading the live <select>
    // values -- a plain <select> can't have its .value set to something
    // that isn't yet one of its <option>s, so the seed pass has to supply
    // the target values explicitly as the options are built. Because every
    // desired value is known up front, seeding doesn't need an order either
    // -- each field is just filtered by every other field's desired value.
    function fsCurrentValue(key, els, desired) {
      if (desired) return key === "vendorId" ? (desired.vendorId ? String(desired.vendorId) : "") : fsDesiredValue(desired[key]);
      return els[key].value;
    }

    function fsOptionsForField(key, pool) {
      return key === "vendorId" ? fsVendorOptions(pool) : fsFieldOptions(pool, key);
    }

    function fsKeyByElId(order, els) {
      const map = {};
      order.forEach((key) => { if (els[key]) map[els[key].id] = key; });
      return map;
    }

    // `skip` leaves the field the user just picked untouched -- rebuilding
    // it from its own new pool would be pointless (its value is what
    // produced that pool) and would risk fighting the user's own click.
    function fsRebuildGroup(order, masters, els, reinit, opts) {
      opts = opts || {};
      const desired = opts.desired || null;
      const skip = opts.skip || null;

      const current = {};
      order.forEach((key) => { current[key] = fsCurrentValue(key, els, desired); });

      const autoFilled = [];
      order.forEach((key) => {
        if (key === skip || !els[key]) return;
        const pool = masters.filter((r) => order.every((k) => {
          if (k === key) return true;
          const v = current[k];
          return !v || fsFieldMatches(k, r, v);
        }));
        const fieldOptions = fsOptionsForField(key, pool);
        const priorValue = current[key];
        let want = priorValue && fieldOptions.some((o) => o.value === priorValue) ? priorValue : "";
        // Auto-fill only ever cascades from an actual user pick (`skip` set,
        // meaning this call was triggered by a real field change) or a prior
        // auto-fill within that same cascade -- never on the initial open or
        // a reset, so the dialog never shows up pre-filled just because some
        // column happens to have a single value across the whole master.
        if (!want && skip && fieldOptions.length === 1) want = fieldOptions[0].value;
        fsSetSelectOptions(els[key], "Search", fieldOptions, want);
        reinit(els[key].id);
        current[key] = els[key].value;
        if (skip && current[key] && current[key] !== priorValue) autoFilled.push(key);
      });

      // Once every field in the group has a value AND that combination
      // resolves to exactly one master row, show that row's own skuId next
      // to the card's heading. An unselected field is "no constraint" for
      // narrowing OTHER fields' options, but here it must NOT be treated
      // that way -- otherwise, with nothing picked yet, the whole unfiltered
      // master pool counts, and if that master happens to hold only one row
      // total the badge would show before any real selection.
      const allSet = order.every((k) => !!current[k]);
      const finalPool = allSet ? masters.filter((r) => order.every((k) => fsFieldMatches(k, r, current[k]))) : [];
      if (els.skuBadge) {
        if (finalPool.length === 1 && finalPool[0].skuId) {
          els.skuBadge.textContent = finalPool[0].skuId;
          els.skuBadge.style.display = "";
        } else {
          els.skuBadge.textContent = "";
          els.skuBadge.style.display = "none";
        }
      }

      // A field that just auto-filled may have narrowed the rest further --
      // re-run (skipping only that field) until nothing more narrows. Not
      // needed while seeding: every field's target value is already known.
      if (!desired && autoFilled.length > 0) fsRebuildGroup(order, masters, els, reinit, { skip: autoFilled[0] });
    }

    function fsRebuildCascade(masters, els, reinit, opts) { fsRebuildGroup(FS_ORDER, masters, els, reinit, opts); }
    function adRebuildCascade(masters, els, reinit, opts) { fsRebuildGroup(AD_ORDER, masters, els, reinit, opts); }
    function rlRebuildCascade(masters, els, reinit, opts) { fsRebuildGroup(RL_ORDER, masters, els, reinit, opts); }

    function fsFieldSet(suffix) {
      return {
        family: document.getElementById("lsFacestockFamily" + suffix),
        type: document.getElementById("lsFacestockType" + suffix),
        make: document.getElementById("lsFacestockMake" + suffix),
        vendorId: document.getElementById("lsFacestockVendorId" + suffix),
        vendorSkuCode: document.getElementById("lsFacestockVendorSkuCode" + suffix),
        skuBadge: document.getElementById("lsFacestockSkuId" + suffix),
        gsm: document.getElementById("lsFacestockGsm" + suffix),
        micron: document.getElementById("lsFacestockMicron" + suffix),
      };
    }
    const lsFsEls1 = fsFieldSet("");
    const lsFsEls2 = fsFieldSet("2");
    const lsFsKeyById1 = fsKeyByElId(FS_ORDER, lsFsEls1);
    const lsFsKeyById2 = fsKeyByElId(FS_ORDER, lsFsEls2);
    const lsFsIds1 = new Set(Object.keys(lsFsKeyById1));
    const lsFsIds2 = new Set(Object.keys(lsFsKeyById2));

    function adFieldSet(suffix) {
      return {
        type: document.getElementById("lsAdhesiveType" + suffix),
        make: document.getElementById("lsAdhesiveMake" + suffix),
        vendorId: document.getElementById("lsAdhesiveVendorId" + suffix),
        vendorSkuCode: document.getElementById("lsAdhesiveVendorSkuCode" + suffix),
        shelfLife: document.getElementById("lsAdhesiveShelfLife" + suffix),
        skuBadge: document.getElementById("lsAdhesiveSkuId" + suffix),
      };
    }
    const lsAdEls1 = adFieldSet("");
    const lsAdEls2 = adFieldSet("2");
    const lsAdKeyById1 = fsKeyByElId(AD_ORDER, lsAdEls1);
    const lsAdKeyById2 = fsKeyByElId(AD_ORDER, lsAdEls2);
    const lsAdIds1 = new Set(Object.keys(lsAdKeyById1));
    const lsAdIds2 = new Set(Object.keys(lsAdKeyById2));

    function rlFieldSet(suffix) {
      return {
        type: document.getElementById("lsReleaseLinerType" + suffix),
        make: document.getElementById("lsReleaseLinerMake" + suffix),
        vendorId: document.getElementById("lsReleaseLinerVendorId" + suffix),
        color: document.getElementById("lsReleaseLinerColor" + suffix),
        gsm: document.getElementById("lsReleaseLinerGsm" + suffix),
        skuBadge: document.getElementById("lsReleaseLinerSkuId" + suffix),
      };
    }
    const lsRlEls1 = rlFieldSet("");
    const lsRlEls2 = rlFieldSet("2");
    const lsRlKeyById1 = fsKeyByElId(RL_ORDER, lsRlEls1);
    const lsRlKeyById2 = fsKeyByElId(RL_ORDER, lsRlEls2);
    const lsRlIds1 = new Set(Object.keys(lsRlKeyById1));
    const lsRlIds2 = new Set(Object.keys(lsRlKeyById2));

    // Roll/Sheet -> Printing Technology options: SHEET opens Digital/Offset,
    // ROLL opens Flexographic/Gravure/Letter Press. Digital (Sheet-only) opens
    // a further Laser/Ink field.
    const LS_PRINTING_TECH_OPTIONS = {
      SHEET: ["DIGITAL", "OFFSET"],
      ROLL: ["FLEXOGRAPHIC", "GRAVURE", "LETTER PRESS"],
    };

    function lsRebuildPrintingTechnology(rollOrSheet, selectedValue) {
      const select = document.getElementById("lsPrintingTechnology");
      const options = LS_PRINTING_TECH_OPTIONS[rollOrSheet] || [];
      select.innerHTML = options.length
        ? '<option value="" disabled hidden>Select printing technology</option>' +
          options.map((o) => `<option value="${o}" ${o === selectedValue ? "selected" : ""}>${o}</option>`).join("")
        : '<option value="" disabled selected hidden>Select roll / sheet first</option>';
      if (!options.includes(selectedValue)) select.value = "";
      lsInitChoices("lsPrintingTechnology");
    }

    function lsUpdateDigitalPrintTypeVisibility(rollOrSheet, printingTechnology, selectedValue) {
      const wrap = document.getElementById("lsDigitalPrintTypeWrap");
      const select = document.getElementById("lsDigitalPrintType");
      const show = rollOrSheet === "SHEET" && printingTechnology === "DIGITAL";
      wrap.style.display = show ? "" : "none";
      select.required = show;
      select.value = show && selectedValue ? selectedValue : "";
      lsInitChoices("lsDigitalPrintType");
      // Family/Roll-Sheet/Printing Technology stretch to fill the row when
      // Laser/Ink isn't shown, instead of leaving its column blank.
      document.getElementById("lsFamilyRow").style.gridTemplateColumns = show ? "1fr 1fr 1fr 1fr" : "1fr 1fr 1fr";
    }

    lsForm.addEventListener("change", function (e) {
      if (e.target.id === "lsRollOrSheet") {
        lsRebuildPrintingTechnology(e.target.value, "");
        lsUpdateDigitalPrintTypeVisibility(e.target.value, "", "");
      } else if (e.target.id === "lsPrintingTechnology") {
        const rollOrSheet = document.getElementById("lsRollOrSheet").value;
        lsUpdateDigitalPrintTypeVisibility(rollOrSheet, e.target.value, "");
      } else if (lsFsIds1.has(e.target.id)) {
        fsRebuildCascade(lsFacestockMasters, lsFsEls1, lsInitChoices, { skip: lsFsKeyById1[e.target.id] });
      } else if (lsFsIds2.has(e.target.id)) {
        fsRebuildCascade(lsFacestockMasters, lsFsEls2, lsInitChoices, { skip: lsFsKeyById2[e.target.id] });
      } else if (lsAdIds1.has(e.target.id)) {
        adRebuildCascade(lsAdhesiveMasters, lsAdEls1, lsInitChoices, { skip: lsAdKeyById1[e.target.id] });
      } else if (lsAdIds2.has(e.target.id)) {
        adRebuildCascade(lsAdhesiveMasters, lsAdEls2, lsInitChoices, { skip: lsAdKeyById2[e.target.id] });
      } else if (lsRlIds1.has(e.target.id)) {
        rlRebuildCascade(lsReleaseMasters, lsRlEls1, lsInitChoices, { skip: lsRlKeyById1[e.target.id] });
      } else if (lsRlIds2.has(e.target.id)) {
        rlRebuildCascade(lsReleaseMasters, lsRlEls2, lsInitChoices, { skip: lsRlKeyById2[e.target.id] });
      }
    });

    window.openCreateLabelStockDialog = function () {
      lsForm.reset();
      document.getElementById("lsSkuCode").value = lsPreviewSkuCode;
      hideLsError();

      ["lsRollType", "lsFamily", "lsRollOrSheet"].forEach((id) => lsInitChoices(id));

      fsRebuildCascade(lsFacestockMasters, lsFsEls1, lsInitChoices);
      fsRebuildCascade(lsFacestockMasters, lsFsEls2, lsInitChoices);
      adRebuildCascade(lsAdhesiveMasters, lsAdEls1, lsInitChoices);
      adRebuildCascade(lsAdhesiveMasters, lsAdEls2, lsInitChoices);
      rlRebuildCascade(lsReleaseMasters, lsRlEls1, lsInitChoices);
      rlRebuildCascade(lsReleaseMasters, lsRlEls2, lsInitChoices);

      lsRebuildPrintingTechnology("", "");
      lsUpdateDigitalPrintTypeVisibility("", "", "");

      lsApplyRollType("NORMAL");
      document.getElementById("ls-create-modal").style.display = "flex";
    };

    window.closeCreateLabelStockDialog = function () {
      document.getElementById("ls-create-modal").style.display = "none";
    };

    document.getElementById("ls-create-modal").addEventListener("click", function (e) {
      if (e.target === this) closeCreateLabelStockDialog();
    });

    window.submitCreateLabelStock = async function () {
      if (!lsForm.reportValidity()) return;

      const btn = document.getElementById("ls-create-submit-btn");
      btn.disabled = true;
      hideLsError();
      try {
        const res = await fetch("/sachiko/label-stock/form", { method: "POST", body: new FormData(lsForm) });
        const data = await res.json().catch(() => null);
        if (data?.success) {
          window.location.href = data.redirect || "/sachiko/label-stock/view";
        } else {
          showLsError(data?.message || "Failed to create Label Stock.");
        }
      } catch {
        showLsError("Server error. Please try again.");
      } finally {
        btn.disabled = false;
      }
    };
  });
</script>

<!-- View Modal -->
<div id="ds-view-modal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:10000;justify-content:center;align-items:center;padding:24px;backdrop-filter:blur(4px);">
  <div id="ds-view-body" style="background:#fff;border-radius:14px;overflow:hidden;width:min(720px,95vw);max-height:90vh;box-shadow:0 20px 50px rgba(4,74,120,0.2);animation:dsPopIn 0.2s ease-out;"></div>
</div>

<!-- Delete Confirm Dialog -->
<div id="ds-delete-dialog" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:10001;justify-content:center;align-items:center;">
  <div style="background:#fff;border-radius:10px;width:min(420px,92vw);overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,0.2);animation:dsPopIn 0.18s ease-out;">
    <div style="padding:22px 20px;">
      <p id="ds-delete-msg" style="margin:0;font-size:15px;color:#1e293b;line-height:1.5;"></p>
    </div>
    <div style="padding:12px 20px 16px;display:flex;justify-content:flex-end;gap:8px;border-top:1px solid #f1f5f9;">
      <button id="ds-delete-cancel" style="padding:8px 16px;border:1px solid #d1d5db;background:#fff;color:#374151;border-radius:6px;cursor:pointer;font-weight:500;">Cancel</button>
      <button id="ds-delete-confirm" style="padding:8px 16px;border:none;background:#ef4444;color:#fff;border-radius:6px;cursor:pointer;font-weight:600;">Delete</button>
    </div>
  </div>
</div>

<!-- Create Label Stock Dialog -->
<div id="ls-create-modal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:10000;justify-content:center;align-items:center;padding:24px;backdrop-filter:blur(4px);">
  <div style="background:#fff;border-radius:14px;overflow:hidden;width:min(1520px,96vw);max-height:92vh;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(4,74,120,0.2);animation:dsPopIn 0.2s ease-out;">
    <div style="background:linear-gradient(135deg,#044a78 0%,#03365a 100%);padding:12px 24px;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:12px;flex:0 0 auto;">
      <h2 style="margin:0;font-size:19px;font-weight:700;">New Label Stock</h2>
      <button type="button" onclick="closeCreateLabelStockDialog()"
        style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);color:#fff;border-radius:999px;padding:5px 12px;cursor:pointer;font-size:13px;font-weight:700;">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form id="ls-create-form" class="custom-scrollbar" style="padding:22px 24px;overflow-y:auto;flex:1 1 auto;display:flex;flex-direction:column;gap:16px;border-top:none;border-top-left-radius:0;border-top-right-radius:0;" novalidate>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px;">
        <div class="dialog-field">
          <label class="dialog-field-label" for="lsSkuCode">SKU Code</label>
          <input type="text" id="lsSkuCode" class="form-control" readonly />
        </div>
        <div class="dialog-field">
          <label class="dialog-field-label" for="lsProductCode">Product Code</label>
          <input type="text" id="lsProductCode" name="productCode" class="form-control" placeholder="Enter product code" required />
        </div>
        <div class="dialog-field">
          <label class="dialog-field-label" for="lsWordFile">Attach Word File</label>
          <input type="file" id="lsWordFile" name="wordFile" class="form-control" accept=".doc,.docx" />
