          <div class="layer-field">
            <label for="lsFacestockMicron2">Micron</label>
            <input type="number" id="lsFacestockMicron2" name="facestockMicron2" class="form-control" placeholder="Enter Micron" min="0" step="any" />
          </div>
        </div>
      </div>

      <div class="layer-arrow" data-arrow-after="facestock2" style="display:none"><i class="fa-solid fa-caret-down"></i></div>

      <!-- Adhesive (Layer 2) -- for DOUBLE FACESTOCK and DOUBLE RELEASE -->
      <div class="ls-block layer-card layer-card--adhesive" data-block="adhesive2" style="display:none">
        <span class="layer-card__label">ADHESIVE <span style="opacity:0.7;">(Layer 2)</span></span>
