<% layout('/layout/boilerplate') -%>

<link href="https://unpkg.com/tabulator-tables@5.5.2/dist/css/tabulator.min.css" rel="stylesheet" />

<div class="contain" style="flex-direction: column; padding: 10px; gap: 10px">
  <style>
    #master-table { width: 100%; flex: 1 1 auto; min-height: 0; }

    /* Product Code variant dropdown -- "C011" grouping its "C011-A"/"C011-B"/...
       siblings (same base code, different recipe -- see utils/labelStockVariant.js)
       under one expandable parent row, same Tabulator dataTree "Rolls" toggle
       pattern as views/stock/facestockStock.ejs. */
    .tabulator-data-tree-control {
      width: 20px !important;
      height: 20px !important;
      border: none !important;
      border-radius: 4px !important;
      background: rgba(4, 74, 120, 0.1) !important;
      box-shadow: none !important;
      outline: none !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      transition: background-color 0.15s ease !important;
    }
    .tabulator-data-tree-control:hover {
      background: rgba(4, 74, 120, 0.18) !important;
    }
    .tabulator-data-tree-control:focus,
    .tabulator-data-tree-control:focus-visible {
      outline: none !important;
      box-shadow: none !important;
    }
    .tabulator-data-tree-control-expand,
    .tabulator-data-tree-control-collapse {
      width: auto !important;
      height: auto !important;
      background: none !important;
      border: none !important;
    }
    .tabulator-data-tree-control-expand::before,
    .tabulator-data-tree-control-collapse::before {
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      content: "\f054"; /* chevron-right, one glyph for both states */
      font-size: 11px;
      line-height: 1;
      color: #044a78;
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .tabulator-data-tree-control-collapse::before {
      transform: rotate(90deg);
    }
    .tabulator-data-tree-control-expand::after,
    .tabulator-data-tree-control-collapse::after {
      content: none !important;
      display: none !important;
    }
    #master-table .tabulator-row[data-variant-child="true"] {
      background-color: #f8fafc;
    }
    /* Tabulator's own dataTree "branch" connector -- an "L"-shaped guide line
       (border-left + border-bottom) it draws next to every child row -- would
       otherwise show up alongside our own "↳" marker (see the "_toggle"
       column formatter below) in the same cell. Keep just the "↳". */
    #master-table .tabulator-data-tree-branch,
    #master-table .tabulator-data-tree-branch-empty {
      display: none !important;
    }
    .tabulator-edit-list { scrollbar-width: none !important; -ms-overflow-style: none !important; }
    .tabulator-edit-list::-webkit-scrollbar { display: none !important; }
    .header-action-btn {
      background-color: #f0f0f0; color: #044a78;
      padding: 2px 14px; font-size: 14px; font-weight: 500;
      border: none; cursor: pointer; border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,.1);
      transition: all 0.2s ease-in-out;
      display: flex; align-items: center; justify-content: center;
    }
    .header-action-btn:hover { background-color: #e4e4e4; }

    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar { width: 10px; height: 10px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #044A78; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #03365a; }

    /* ── Create Label Stock dialog ── */
    .dialog-field-label {
      display: block; font-size: 13px; font-weight: 800; letter-spacing: 0.02em;
      color: #334155; text-transform: uppercase;
    }
    .dialog-field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
    #ls-create-form .choices[data-type*="select-one"]::after {
      display: block !important; content: "" !important; width: 13px !important; height: 9px !important;
      border-style: none !important; border-width: 0 !important;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
      background-repeat: no-repeat !important; background-size: contain !important;
      position: absolute !important; right: 13px !important; top: 50% !important; margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    #ls-create-form .choices[data-type*="select-one"].is-open::after { transform: translateY(-50%) rotate(180deg) !important; }
    /* Dropdown list must render above the dialog overlay. */
    #ls-create-form .choices__list--dropdown { z-index: 99999 !important; }

    /* Every select becomes a Choices.js widget once the dialog opens, which
       replaces the plain <select> with its own `.choices__inner` box -- so
       that's the element that actually needs to match the plain inputs'
       look (global .choices__inner otherwise renders a 1px black border
       with no fixed height, which is what read as "inconsistent"). */
    #ls-create-form .choices__inner {
      min-height: 2.65rem !important; height: 2.65rem !important; display: flex !important; align-items: center;
      padding: 0.45rem 0.85rem !important; border: 2px solid #94a3b8 !important; border-radius: 8px !important;
      background: #ffffff !important; font-size: 1.02rem !important;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    #ls-create-form .choices__list--single { padding: 0 !important; }
    /* Overflowing selected text (long vendor names, "GLOSSY PP PARTIAL", etc.)
       truncates with an ellipsis instead of overflowing the field. */
    #ls-create-form .choices__list--single .choices__item {
      font-size: 1.02rem; font-weight: 700; color: #0f172a;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; max-width: 100%;
    }
    #ls-create-form .choices__list--dropdown .choices__item {
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    #ls-create-form .choices:hover .choices__inner { border-color: #64748b !important; }
    #ls-create-form .choices.is-focused .choices__inner,
    #ls-create-form .choices.is-open .choices__inner {
      border-color: #044a78 !important; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.18) !important;
    }
    .layer-card--adhesive .choices__inner { border-color: #d97706 !important; }

    /* Every field in the dialog -- the top Product row as well as the layer
       cards below -- shares this one look, so nothing reads as a different
       control halfway down the form. */
    #ls-create-form input.form-control,
    #ls-create-form select.form-control,
    #ls-create-form .dialog-field select {
      width: 100%; height: 2.65rem; padding: 0.45rem 0.85rem; border: 2px solid #94a3b8; border-radius: 8px;
      background: #ffffff; font-size: 1.02rem; font-weight: 700; color: #0f172a;
      transition: border-color 0.15s ease, box-shadow 0.15s ease; box-sizing: border-box;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    #ls-create-form input.form-control::placeholder { color: #64748b; font-weight: 500; }
    #ls-create-form input.form-control:hover,
    #ls-create-form select.form-control:hover,
    #ls-create-form .dialog-field select:hover { border-color: #64748b; }
    #ls-create-form input.form-control:focus,
    #ls-create-form select.form-control:focus,
    #ls-create-form .dialog-field select:focus {
      outline: none; border-color: #044a78; box-shadow: 0 0 0 3px rgba(4, 74, 120, 0.18);
    }
    #ls-create-form input.form-control[readonly] {
      background: #eef1f5; color: #334155; cursor: not-allowed;
    }
    /* File inputs can't take height/padding the same way -- match border/radius only. */
    #ls-create-form input[type="file"].form-control {
      height: auto; padding: 0.55rem 0.85rem; border: 2px solid #94a3b8; border-radius: 8px;
      background: #ffffff; font-size: 0.92rem; font-weight: 600; color: #334155; box-sizing: border-box;
    }

    .layer-card { border-radius: 10px; border: 2px solid; padding: 18px 20px 22px; box-shadow: 0 2px 5px rgba(15, 23, 42, 0.1); }
    .layer-card__label { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 900; letter-spacing: 0.06em; margin-bottom: 16px; }
    .layer-card__label::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: currentColor; flex: 0 0 auto; }
    /* Shown once every field in a layer card resolves to exactly one master
       row -- just an "OK" status pill confirming the card matches a real
       catalog spec, not the master's own internal skuId (not something the
       label stock form needs to surface). */
    .layer-card__sku-badge {
      font-family: inherit; font-size: 10px; font-weight: 800; letter-spacing: 0.04em;
      text-transform: uppercase; margin-left: 6px; color: #15803d; background: #dcfce7;
      border-radius: 999px; padding: 2px 8px;
    }
    /* Pushed to the far right of the card header by margin-left: auto --
       .layer-card__label is itself the flex row, so this doesn't need its
       own wrapper. Clears just this one card's group (see
       lsResetLayerGroup), not the whole form. */
    .layer-card__reset-btn {
      margin-left: auto; flex: 0 0 auto;
      font-size: 11px; font-weight: 700; letter-spacing: 0.03em; text-transform: none;
      color: inherit; background: rgba(15, 23, 42, 0.06); border: 1px solid rgba(15, 23, 42, 0.15);
      border-radius: 6px; padding: 3px 10px; cursor: pointer; transition: background 0.15s ease;
    }
    .layer-card__reset-btn:hover { background: rgba(15, 23, 42, 0.12); }
    .layer-card__fields { display: grid; gap: 16px; }
    .layer-field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
    .layer-field label { font-size: 13px; font-weight: 800; letter-spacing: 0.02em; color: #334155; text-transform: uppercase; }
    .layer-card--facestock { background: #ffffff; border-color: #60a5fa; }
    .layer-card--facestock .layer-card__label { color: #000000; }
    .layer-card--adhesive { background: #fffbeb; border-color: #f59e0b; }
    .layer-card--adhesive .layer-card__label { color: #92400e; }
    .layer-card--adhesive .layer-field input.form-control,
    .layer-card--adhesive .layer-field select.form-control { border-color: #d97706; }
    .layer-card--release { background: #eff6ff; border-color: #60a5fa; }
    .layer-card--release .layer-card__label { color: #1d4ed8; }

    .layer-arrow { display: flex; justify-content: center; margin: -5px 0; }
    .layer-arrow i { color: #94a3b8; font-size: 18px; }

    @media (max-width: 768px) {
      .layer-card__fields { grid-template-columns: 1fr !important; }
    }
  </style>

  <div class="indi-head">
    <h1>Label Stock View</h1>
    <div style="display: flex; gap: 10px; align-items: center">
      <button class="header-action-btn" onclick="openCreateLabelStockDialog()">
        <i class="fa-solid fa-plus" style="margin-right: 4px"></i> New
      </button>
      <div class="download-selector" id="downloadSelector">
        <button class="download-selector__trigger">
          <span><i class="fa-solid fa-file-arrow-down"></i> Download</span>
          <i class="fas fa-chevron-down"></i>
        </button>
        <div class="download-selector__menu">
          <div class="download-selector__option" id="download-pdf"><i class="fas fa-file-pdf"></i> PDF</div>
          <div class="download-selector__option" id="download-xlsx"><i class="fas fa-file-excel"></i> Excel</div>
        </div>
      </div>
    </div>
  </div>

  <div class="table-spinner"><div class="spinner-circle"></div></div>
  <div id="master-table"></div>
</div>

<script src="https://unpkg.com/tabulator-tables@5.5.2/dist/js/tabulator.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<script>
  /* ── Download dropdown ── */
  const downloadSelector = document.getElementById("downloadSelector");
  const triggerBtn = downloadSelector.querySelector(".download-selector__trigger");
  triggerBtn.addEventListener("click", (e) => { e.stopPropagation(); downloadSelector.classList.toggle("download-selector--active"); });
  document.addEventListener("click", () => downloadSelector.classList.remove("download-selector--active"));

  /* ── Flatten nested Label Stock docs for Tabulator ── */
  const raw = <%- safeJson(jsonData) %>;

  // Table stays to bare identity columns -- the full spec (Family, Roll/Sheet,
  // Printing Technology, every FS/AD/RL Family/Type/Make/Vendor/GSM/Micron/
  // Color/Shelf-Life field) lives in the View button's modal (viewLabelStock
  // below, reading straight from `raw`) instead of being duplicated here.
  // Factored into a function (not a one-off const) so a delete can rebuild
  // both the flat row list and the variant tree below from the trimmed
  // `raw` array, instead of hand-patching Tabulator's dataTree structure.
  function buildLabelStockTableData(rawArr) {
    return rawArr.map(ds => {
      const fsType = ds.facestock?.facestockType || "";
      const fsGsm = ds.facestock?.facestockGsm || "";
      const fsMicron = ds.facestock?.facestockMicron || "";
      const adType = ds.adhesive?.adhesiveType   || "";
      const adGsm = ds.adhesive?.adhesiveGsm || "";
      const rlType = ds.releaseLiner?.releaseLinerType || "";
      const micPart = ds.facestock?.facestockMicron != null ? ds.facestock.facestockMicron + " MIC" : "";
      const product = [fsType, micPart, adType, rlType].filter(Boolean).join(" / ");

      return {
        _id: String(ds._id),
        skuCode: ds.skuCode || "",
        productCode: ds.productCode,
        family: ds.family || "",
        rollType: ds.rollType || "NORMAL",
        facestockType: fsType,
        facestockGsm: fsGsm,
        facestockMicron: fsMicron,
        adhesiveType: adType,
        adhesiveGsm: adGsm,
        releaseLinerType: rlType,
        product,
        wordFile: ds.wordFile || "",
      };
    });
  }
  const tableData = buildLabelStockTableData(raw);

  // Product Code "C011" / "C011-A" / "C011-B" variants (same base code, a
  // different recipe -- see utils/labelStockVariant.js's resolveLabelStockProductCode)
  // are the same underlying spec family, so they're grouped in the table
  // exactly like Facestock Stock groups its reels under a master: the plain
  // base code becomes the parent row, its "-A"/"-B"/... siblings become the
  // dataTree children revealed by the same toggle dropdown. A code with no
  // variants stays a plain flat row -- no toggle drawn.
  function lsBaseProductCode(code) {
    const m = String(code || "").match(/^(.*)-[A-Z]+$/);
    return m ? m[1] : String(code || "");
  }

  function buildLabelStockTreeData(rows) {
    const groups = new Map();
    rows.forEach((row) => {
      const base = lsBaseProductCode(row.productCode);
      if (!groups.has(base)) groups.set(base, []);
      groups.get(base).push(row);
    });

    const tree = [];
    groups.forEach((members, base) => {
      if (members.length === 1) {
        tree.push(members[0]);
        return;
      }
      const parent = members.find((r) => r.productCode === base);
      if (!parent) {
        // No plain base-code row to hang the dropdown off -- list flat
        // rather than fabricate a parent with no real record behind it.
        members.forEach((r) => tree.push(r));
        return;
      }
      const children = members
        .filter((r) => r !== parent)
        .sort((a, b) => a.productCode.localeCompare(b.productCode, undefined, { numeric: true }));
      tree.push({ ...parent, _children: children });
    });
    return tree;
  }

  const treeData = buildLabelStockTreeData(tableData);

  const withTextFilter = (col) => ({ headerFilter: "input", headerFilterPlaceholder: "Search", minWidth: 100, hozAlign: "center", headerHozAlign: "center", ...col });
  const withSelectFilter = (col, values) => ({ headerFilter: "list", headerFilterParams: { values, clearable: true }, hozAlign: "center", headerHozAlign: "center", ...col });

  const table = new Tabulator("#master-table", {
    data: treeData,
    height: "100%",
    initialSort: [{ column: "skuCode", dir: "asc" }],
    placeholder: "No Label Stocks found",
    dataTree: true,
    dataTreeStartExpanded: false,
    dataTreeChildField: "_children",
    dataTreeElementColumn: "_toggle",
    rowFormatter: (row) => {
      // Tags a variant child row so it can be shaded differently from its
      // parent (see the #master-table .tabulator-row[data-variant-child] CSS
      // above) -- purely cosmetic, doesn't affect the row's own data/actions.
      if (row.getTreeParent && row.getTreeParent()) {
        row.getElement().setAttribute("data-variant-child", "true");
      }
    },
    columns: [
      { title: "", field: "_toggle", width: 40, hozAlign: "center", headerSort: false,
        // Leaf rows (a variant nested under its base Product Code) get no
        // expand/collapse control of their own from Tabulator's dataTree --
        // show the same "↳" marker facestockStock.ejs uses there instead, so
        // it lands in the toggle column itself rather than the data column.
        formatter: (cell) => (cell.getRow().getTreeParent && cell.getRow().getTreeParent() ? "↳" : "") },
      {
        // getPosition(true) reads the row's position among only the currently
        // active (sorted + filtered) rows, re-evaluated on every redraw --
        // so this stays correct after sorting any column or typing into any
        // header filter, unlike a static index baked into the row data at
        // load time. Variant children (nested under a Product Code's dataTree)
        // aren't top-level rows, so they don't get their own number here --
        // matches the "↳" toggle column's own parent/child distinction above.
        title: "Sr. No.",
        field: "_srNo",
        width: 70,
        hozAlign: "center",
        headerHozAlign: "center",
        headerSort: false,
        headerFilter: false,
        formatter: (cell) => (cell.getRow().getTreeParent && cell.getRow().getTreeParent() ? "" : cell.getRow().getPosition(true)),
      },
      {
        title: "Actions",
        hozAlign: "center",
        headerSort: false,
        width: 110,
        formatter: (cell) => {
          const row = cell.getRow().getData();
          return `
            <div style="display:flex;gap:5px;justify-content:center;align-items:center;white-space:nowrap;">
              <button onclick="viewLabelStock('${row._id}')"
                style="height:24px;padding:2px 9px;background:#111827;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px;display:inline-flex;align-items:center;gap:3px;font-weight:600;"
                onmouseover="this.style.background='#374151'" onmouseout="this.style.background='#111827'"
                title="View">
                <i class="fa-solid fa-eye"></i>
              </button>
              <button onclick="openEditLabelStockDialog('${row._id}')"
                style="height:24px;padding:2px 9px;background:#3b82f6;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px;display:inline-flex;align-items:center;gap:3px;font-weight:600;"
                onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'"
                title="Edit">
                <i class="fa-solid fa-pencil"></i>
              </button>
              <button onclick="deleteLabelStock('${row._id}','${row.productCode}')"
                style="height:24px;padding:2px 9px;background:#ef4444;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px;display:inline-flex;align-items:center;gap:3px;font-weight:600;"
                onmouseover="this.style.background='#dc2626'" onmouseout="this.style.background='#ef4444'"
                title="Delete">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>`;
        },
      },
      withTextFilter({ title: "SKU", field: "skuCode", minWidth: 180 }),
      withTextFilter({ title: "Product Code", field: "productCode", width: 150, formatter: (cell) => {
        const children = cell.getRow().getData()._children;
        const countBadge = children && children.length
          ? ` <span style="font-size:10.5px;font-weight:700;color:#b45309;background:#fef3c7;border-radius:999px;padding:1px 7px;">${children.length} variant${children.length === 1 ? "" : "s"}</span>`
          : "";
        return `<span style="font-weight:700;color:#044a78;">${cell.getValue()}</span>${countBadge}`;
      } }),
      withTextFilter({ title: "Family", field: "family", minWidth: 140, formatter: (cell) => cell.getValue() || "—" }),
      withTextFilter({ title: "FS Type", field: "facestockType", minWidth: 140, formatter: (cell) => cell.getValue() || "—" }),
      withTextFilter({ title: "FS GSM", field: "facestockGsm", minWidth: 120, formatter: (cell) => cell.getValue() ? cell.getValue() + " GSM" : "—" }),
      withTextFilter({ title: "FS Micron", field: "facestockMicron", minWidth: 140, formatter: (cell) => cell.getValue() ? cell.getValue() + " MIC" : "—" }),
      withTextFilter({ title: "ADH Type", field: "adhesiveType", minWidth: 140, formatter: (cell) => cell.getValue() || "—" }),
      withTextFilter({ title: "ADH GSM", field: "adhesiveGsm", minWidth: 120, formatter: (cell) => cell.getValue() ? cell.getValue() + " GSM" : "—" }),
      withTextFilter({ title: "REL Type", field: "releaseLinerType", minWidth: 160, formatter: (cell) => cell.getValue() || "—" }),
      withSelectFilter({ title: "Roll Type",  field: "rollType",  minWidth: 140,
        formatter: (cell) => {
          const v = cell.getValue() || "NORMAL";
          const label = v === "NORMAL" ? "STANDARD" : v;
          const color = v === "NORMAL" ? "#475569" : "#b45309";
          return `<span style="font-weight:600;color:${color};">${label}</span>`;
        } },
        { "": "All", "NORMAL": "STANDARD", "DOUBLE RELEASE": "DOUBLE RELEASE", "DOUBLE FACESTOCK": "DOUBLE FACESTOCK" }),
      { title: "File", field: "wordFile", minWidth: 110, headerFilter: false, hozAlign: "center", headerHozAlign: "center",
        formatter: (cell) => {
          const v = cell.getValue();
          return v ? `<a href="/sachiko/label-stock/file/${v}" target="_blank" style="color:#044a78;font-weight:600;text-decoration:none;" title="View file"><i class="fa-solid fa-file" style="margin-right:4px;"></i>View</a>` : `<span style="color:#aaa;">—</span>`;
        }
      },
    ],
  });

  // "renderComplete" is a Tabulator EVENT, not a constructor option -- a
  // `renderComplete:` key inside the options object above is silently
  // ignored (no error, callback just never runs), which is why the column
  // formatter's stale numbers kept showing after a sort. Subscribing via
  // .on() is the only way it actually fires. Reads straight off the
  // rendered DOM rather than Tabulator's row APIs -- getRow().getPosition()/
  // getRows("active") both count a dataTree's collapsed children as
  // occupying a position even while they're not on screen (e.g. a Product
  // Code with 5 hidden variants pushes the NEXT visible row's number up by
  // 5, so numbering jumped 1, 7 instead of 1, 2). Whatever's actually on
  // screen, top to bottom, is renumbered 1..n every redraw; variant
  // children are marked "data-variant-child" by rowFormatter above and
  // skipped, same as the "↳" toggle column's own parent/child distinction.
  table.on("renderComplete", function () {
    document.querySelectorAll("#master-table .tabulator-row:not([data-variant-child])").forEach((rowEl, i) => {
      const cell = rowEl.querySelector('[tabulator-field="_srNo"]');
      if (cell) cell.textContent = i + 1;
    });
  });

  document.getElementById("download-pdf").addEventListener("click", () =>
    table.download("pdf", "sachiko-label-stock.pdf", { orientation: "landscape", title: "Sachiko Label Stocks", autoTable: { styles: { fillColor: [4, 74, 120] } } }));
  document.getElementById("download-xlsx").addEventListener("click", () =>
    table.download("xlsx", "sachiko-label-stock.xlsx", { sheetName: "Label Stocks" }));

  /* ── View Modal ── */
  function esc(v) {
    return String(v ?? "—").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

