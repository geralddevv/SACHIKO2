<% layout('/layout/boilerplate') %>

<style>
  .choices[data-type*="select-one"]::after {
    display: block !important;
    content: "" !important;
    width: 12px !important;
    height: 8px !important;
    border-style: none !important;
    border-width: 0 !important;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%23044a78' stroke-width='2' fill='none'/%3E%3C/svg%3E") !important;
    background-repeat: no-repeat !important;
    background-size: contain !important;
    position: absolute !important;
    right: 11.5px !important;
    top: 50% !important;
    margin-top: 0 !important;
    transform: translateY(-50%) !important;
  }
  .choices[data-type*="select-one"].is-open::after {
    transform: translateY(-50%) rotate(180deg) !important;
  }

  .ls-tabs-wrap {
    grid-column: span 32;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .ls-tab-btn {
    flex: 1 1 160px;
    padding: 0.55rem 1rem;
    font-size: 1.05rem;
    font-weight: 600;
    border: 1.8px solid var(--primary-color);
    background: #fff;
    color: var(--primary-color);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
  }
  .ls-tab-btn.active {
    background-color: var(--primary-color);
    color: #fff;
  }
  .ls-tab-btn:hover {
    opacity: 0.88;
  }
</style>

<div class="main-content" style="padding: 10px; display: flex; flex-direction: column; gap: 10px">
  <form
    action="/sachiko/label-stock/form?_csrf=<%= encodeURIComponent(csrfToken) %>"
    method="POST"
    enctype="multipart/form-data"
    class="needs-validation"
    autocomplete="off"
    novalidate
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="span-full form-heading">
      <h1>Product Label Stock</h1>
    </div>

    <!-- Product Code -->
    <div class="span-full form-subheading">
      <h1>Product</h1>
    </div>
    <div class="span-five">
      <label for="skuCode">SKU Code</label>
      <input
        type="text"
        id="skuCode"
        class="form-control"
        value="<%= previewSkuCode %>"
        readonly
      />
    </div>
    <div class="span-six">
      <label for="productCode">Product Code</label>
      <input
        type="text"
        id="productCode"
        name="productCode"
        class="form-control"
        placeholder="Enter product code"
        required
      />
    </div>
    <div class="span-seven">
      <label for="wordFile">Attach Word File</label>
      <input type="file" id="wordFile" name="wordFile" class="form-control" accept=".doc,.docx" />
    </div>
    <div class="span-five">
      <label for="rollType">Roll Type</label>
      <select id="rollType" name="rollType" class="form-control select-tag">
        <option value="NORMAL" selected>NORMAL</option>
        <option value="DOUBLE RELEASE">DOUBLE RELEASE</option>
        <option value="DOUBLE FACESTOCK">DOUBLE FACESTOCK</option>
      </select>
    </div>

    <!-- Material Tabs -->
    <div class="ls-tabs-wrap">
      <button type="button" class="ls-tab-btn active" data-tab="facestock">Facestock</button>
      <button type="button" class="ls-tab-btn" data-tab="adhesive">Adhesive</button>
      <button type="button" class="ls-tab-btn" data-tab="release">Release Liner</button>
    </div>

    <!-- Facestock -->
    <div class="ls-block" data-block="facestock1" data-tab="facestock" style="display: contents">
      <div class="span-full form-subheading">
        <h1>Facestock</h1>
      </div>
      <div class="span-six">
        <label for="facestockFamily">Family</label>
        <select id="facestockFamily" name="facestockFamily" class="form-control select-tag">
          <option value="" disabled selected hidden>Select family</option>
          <option value="CHROMO">CHROMO</option>
          <option value="CHROMO (D. R)">CHROMO (D. R)</option>
          <option value="CLEAR PP">CLEAR PP</option>
          <option value="DOUBLE RELEASE">DOUBLE RELEASE</option>
          <option value="DT">DT</option>
          <option value="DT. PP">DT. PP</option>
          <option value="GLOSSY PP">GLOSSY PP</option>
          <option value="GLOSSY PP PARTIAL">GLOSSY PP PARTIAL</option>
          <option value="INKJET MATT FILM">INKJET MATT FILM</option>
          <option value="MAPLITO">MAPLITO</option>
          <option value="MAPLTIO">MAPLTIO</option>
          <option value="MATT PP">MATT PP</option>
          <option value="MATT PP (HT)">MATT PP (HT)</option>
          <option value="MATT PP PARTIAL">MATT PP PARTIAL</option>
          <option value="PP">PP</option>
          <option value="REMOVABLE">REMOVABLE</option>
          <option value="SILVER VOID">SILVER VOID</option>
          <option value="SUPER HOTMELT">SUPER HOTMELT</option>
        </select>
      </div>
      <div class="span-six">
        <label for="facestockType">Type</label>
        <select id="facestockType" name="facestockType" class="form-control select-tag" required>
          <option value="" disabled selected hidden>Select type</option>
          <option value="CLEAR">CLEAR</option>
          <option value="GLOSSY">GLOSSY</option>
          <option value="MATT">MATT</option>
          <option value="SEMI GLOSSY">SEMI GLOSSY</option>
        </select>
      </div>
      <div class="span-four">
        <label for="facestockGsm">GSM</label>
        <input type="number" id="facestockGsm" name="facestockGsm" class="form-control" placeholder="Enter GSM" min="0" step="any" />
      </div>
      <div class="span-four">
        <label for="facestockMicron">Micron</label>
        <input type="number" id="facestockMicron" name="facestockMicron" class="form-control" placeholder="Enter Micron" min="0" step="any" />
      </div>
    </div>

    <!-- Adhesive -->
    <div class="ls-block" data-block="adhesive1" data-tab="adhesive" style="display: contents">
      <div class="span-full form-subheading">
        <h1>Adhesive</h1>
      </div>
      <div class="span-seven">
        <label for="adhesiveType">Type</label>
        <select id="adhesiveType" name="adhesiveType" class="form-control select-tag" required>
          <option value="" disabled selected hidden>Select type</option>
          <option value="ACRYLIC">ACRYLIC</option>
          <option value="HOTMELT">HOTMELT</option>
          <option value="HT">HT</option>
          <option value="STAIN FREE">STAIN FREE</option>
          <option value="WATERBASE">WATERBASE</option>
        </select>
      </div>
      <div class="span-four">
        <label for="adhesiveGsm">GSM</label>
        <input type="number" id="adhesiveGsm" name="adhesiveGsm" class="form-control" placeholder="Enter GSM" min="0" step="any" />
      </div>
    </div>

    <!-- Facestock (Layer 2) -- only for DOUBLE FACESTOCK -->
    <div class="ls-block" data-block="facestock2" data-tab="facestock" style="display: none">
      <div class="span-full form-subheading">
        <h1>Facestock <span style="opacity:0.7;">(Layer 2)</span></h1>
      </div>
      <div class="span-six">
        <label for="facestockFamily2">Family</label>
        <select id="facestockFamily2" name="facestockFamily2" class="form-control select-tag">
          <option value="" disabled selected hidden>Select family</option>
          <option value="CHROMO">CHROMO</option>
          <option value="CHROMO (D. R)">CHROMO (D. R)</option>
          <option value="CLEAR PP">CLEAR PP</option>
          <option value="DOUBLE RELEASE">DOUBLE RELEASE</option>
          <option value="DT">DT</option>
          <option value="DT. PP">DT. PP</option>
          <option value="GLOSSY PP">GLOSSY PP</option>
          <option value="GLOSSY PP PARTIAL">GLOSSY PP PARTIAL</option>
          <option value="INKJET MATT FILM">INKJET MATT FILM</option>
          <option value="MAPLITO">MAPLITO</option>
          <option value="MAPLTIO">MAPLTIO</option>
          <option value="MATT PP">MATT PP</option>
          <option value="MATT PP (HT)">MATT PP (HT)</option>
          <option value="MATT PP PARTIAL">MATT PP PARTIAL</option>
          <option value="PP">PP</option>
          <option value="REMOVABLE">REMOVABLE</option>
          <option value="SILVER VOID">SILVER VOID</option>
          <option value="SUPER HOTMELT">SUPER HOTMELT</option>
        </select>
      </div>
      <div class="span-six">
        <label for="facestockType2">Type</label>
        <select id="facestockType2" name="facestockType2" class="form-control select-tag" data-required-when-visible>
          <option value="" disabled selected hidden>Select type</option>
          <option value="CLEAR">CLEAR</option>
          <option value="GLOSSY">GLOSSY</option>
          <option value="MATT">MATT</option>
          <option value="SEMI GLOSSY">SEMI GLOSSY</option>
        </select>
      </div>
      <div class="span-four">
        <label for="facestockGsm2">GSM</label>
        <input type="number" id="facestockGsm2" name="facestockGsm2" class="form-control" placeholder="Enter GSM" min="0" step="any" />
      </div>
      <div class="span-four">
        <label for="facestockMicron2">Micron</label>
        <input type="number" id="facestockMicron2" name="facestockMicron2" class="form-control" placeholder="Enter Micron" min="0" step="any" />
      </div>
    </div>

    <!-- Adhesive (Layer 2) -- for DOUBLE FACESTOCK and DOUBLE RELEASE -->
    <div class="ls-block" data-block="adhesive2" data-tab="adhesive" style="display: none">
      <div class="span-full form-subheading">
        <h1>Adhesive <span style="opacity:0.7;">(Layer 2)</span></h1>
      </div>
      <div class="span-seven">
        <label for="adhesiveType2">Type</label>
        <select id="adhesiveType2" name="adhesiveType2" class="form-control select-tag" data-required-when-visible>
          <option value="" disabled selected hidden>Select type</option>
          <option value="ACRYLIC">ACRYLIC</option>
          <option value="HOTMELT">HOTMELT</option>
          <option value="HT">HT</option>
          <option value="STAIN FREE">STAIN FREE</option>
          <option value="WATERBASE">WATERBASE</option>
        </select>
      </div>
      <div class="span-four">
        <label for="adhesiveGsm2">GSM</label>
        <input type="number" id="adhesiveGsm2" name="adhesiveGsm2" class="form-control" placeholder="Enter GSM" min="0" step="any" />
      </div>
    </div>

    <!-- Release Liner -->
    <div class="ls-block" data-block="release1" data-tab="release" style="display: contents">
      <div class="span-full form-subheading">
        <h1>Release Liner</h1>
      </div>
      <div class="span-seven">
        <label for="releaseLinerType">Type</label>
        <select id="releaseLinerType" name="releaseLinerType" class="form-control select-tag" required>
          <option value="" disabled selected hidden>Select type</option>
          <option value="CCK">CCK</option>
          <option value="GLASSINE">GLASSINE</option>
          <option value="SCK">SCK</option>
        </select>
      </div>
      <div class="span-four">
        <label for="releaseLinerColor">Color</label>
        <select id="releaseLinerColor" name="releaseLinerColor" class="form-control select-tag">
          <option value="WHITE" selected>WHITE</option>
          <option value="YELLOW">YELLOW</option>
        </select>
      </div>
      <div class="span-four">
        <label for="releaseLinerGsm">GSM</label>
        <input type="number" id="releaseLinerGsm" name="releaseLinerGsm" class="form-control" placeholder="Enter GSM" min="0" step="any" />
      </div>
    </div>

    <!-- Release Liner (Layer 2) -- only for DOUBLE RELEASE -->
    <div class="ls-block" data-block="release2" data-tab="release" style="display: none">
      <div class="span-full form-subheading">
        <h1>Release Liner <span style="opacity:0.7;">(Layer 2)</span></h1>
      </div>
      <div class="span-seven">
        <label for="releaseLinerType2">Type</label>
        <select id="releaseLinerType2" name="releaseLinerType2" class="form-control select-tag" data-required-when-visible>
          <option value="" disabled selected hidden>Select type</option>
          <option value="CCK">CCK</option>
          <option value="GLASSINE">GLASSINE</option>
          <option value="SCK">SCK</option>
        </select>
      </div>
      <div class="span-four">
        <label for="releaseLinerColor2">Color</label>
        <select id="releaseLinerColor2" name="releaseLinerColor2" class="form-control select-tag">
          <option value="WHITE" selected>WHITE</option>
          <option value="YELLOW">YELLOW</option>
        </select>
      </div>
      <div class="span-four">
        <label for="releaseLinerGsm2">GSM</label>
        <input type="number" id="releaseLinerGsm2" name="releaseLinerGsm2" class="form-control" placeholder="Enter GSM" min="0" step="any" />
      </div>
    </div>

    <div class="btn-grp span-full">
      <button type="submit">Save Label Stock</button>
    </div>
  </form>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    [
      "rollType",
      "facestockFamily", "facestockType", "adhesiveType", "releaseLinerType", "releaseLinerColor",
      "facestockFamily2", "facestockType2", "adhesiveType2", "releaseLinerType2", "releaseLinerColor2",
    ].forEach((id) => {
      const el = document.getElementById(id);
      if (el) new Choices(el, { searchEnabled: false, shouldSort: false, itemSelectText: "" });
    });

    // Auto-calculate Facestock Micron from GSM (micron = gsm / density) for both layers.
    const FACESTOCK_DENSITY = 0.92;
    [["facestockGsm", "facestockMicron"], ["facestockGsm2", "facestockMicron2"]].forEach(([gsmId, micronId]) => {
      const gsmInput = document.getElementById(gsmId);
      const micronInput = document.getElementById(micronId);
      gsmInput?.addEventListener("input", () => {
        const gsm = Number(gsmInput.value);
        micronInput.value = gsmInput.value !== "" && Number.isFinite(gsm)
          ? (gsm / FACESTOCK_DENSITY).toFixed(1)
          : "";
      });
    });

    // Roll Type controls which blocks show and in what order:
    //   NORMAL           -> facestock, adhesive, release
    //   DOUBLE RELEASE   -> facestock, adhesive, release, adhesive(2), release(2)
    //   DOUBLE FACESTOCK -> facestock, adhesive, facestock(2), adhesive(2), release
    const ROLL_TYPE_ORDER = {
      "NORMAL": ["facestock1", "adhesive1", "release1"],
      "DOUBLE RELEASE": ["facestock1", "adhesive1", "release1", "adhesive2", "release2"],
      "DOUBLE FACESTOCK": ["facestock1", "adhesive1", "facestock2", "adhesive2", "release1"],
    };

    const form = document.querySelector("form.needs-validation");
    const btnGrp = document.querySelector(".btn-grp");
    const blocks = {};
    document.querySelectorAll(".ls-block").forEach((el) => { blocks[el.dataset.block] = el; });

    // Facestock / Adhesive / Release Liner tabs -- each tab holds that
    // material's layer-1 block, plus its layer-2 block when Roll Type calls
    // for one (see ROLL_TYPE_ORDER below).
    const tabBtns = Array.from(document.querySelectorAll(".ls-tab-btn"));
    let activeTab = "facestock";

    function applyState() {
      const rollType = rollTypeSelect.value || "NORMAL";
      const order = ROLL_TYPE_ORDER[rollType] || ROLL_TYPE_ORDER.NORMAL;

      Object.keys(blocks).forEach((key) => {
        const el = blocks[key];
        const enabledByRollType = order.includes(key);
        const visible = enabledByRollType && el.dataset.tab === activeTab;
        el.style.display = visible ? "contents" : "none";
        el.querySelectorAll("[data-required-when-visible]").forEach((field) => {
          field.required = enabledByRollType;
        });
      });

      order.forEach((key) => {
        const el = blocks[key];
        if (el) form.insertBefore(el, btnGrp);
      });

      tabBtns.forEach((btn) => btn.classList.toggle("active", btn.dataset.tab === activeTab));
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeTab = btn.dataset.tab;
        applyState();
      });
    });

    const rollTypeSelect = document.getElementById("rollType");
    rollTypeSelect.addEventListener("change", () => applyState());
    applyState();
  });
</script>
